<?xml version="1.0" encoding="utf-8"?>
<component name="SubtitleOptions" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/source/String.brs" />
  <script type="text/brightscript" uri="pkg:/source/Format.brs" />
  <script type="text/brightscript" uri="pkg:/source/Color.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/TVEpisode/SubtitleOptions/SubtitleOptions.brs" />
  <interface>
    <field id="subtitleStreams" type="array" onChange="onSubtitleStreamsChanged" />
    <field id="selectedSubtitleStreamIndex" type="integer" value="-2" onChange="onSelectedSubtitleStreamIndexChanged" />
    <field id="selectedSubtitle" type="assocarray" alwaysNotify="true" />
    <field id="closeRequested" type="boolean" alwaysNotify="true" />
    <function name="openOptions" />
    <function name="closeOptions" />
  </interface>
  <children>

    <Poster
      id="panel"
      translation="[600,330]"
      width="720"
      height="420"
      uri="pkg:/images/frames/option-panel-border.9.png"
      loadDisplayMode="scaleToFill" />

    <Label
      id="titleLabel"
      translation="[660,390]"
      text="Subtitles"
      width="600"
      height="48"
      color="0xF3F7FBFF"
      font="font:MediumBoldSystemFont" />

    <Label
      id="emptyLabel"
      translation="[660,470]"
      text="No subtitles available."
      width="600"
      height="40"
      color="0xB9C7D6FF"
      font="font:SmallSystemFont" />

    <RadioButtonList
      id="subtitleList"
      translation="[660,462]"
      itemSize="[600,52]"
      numRows="6"
      checkedItem="0"
      vertFocusAnimationStyle="floatingFocus"
      fadeFocusFeedbackWhenAutoScrolling="false"
      focusFootprintBitmapUri="pkg:/images/focus/transparent_focus_footprint.9.png" />
  </children>
</component>
