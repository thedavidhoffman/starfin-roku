<?xml version="1.0" encoding="utf-8"?>
<component name="HomePage" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/source/Format.brs" />
  <script type="text/brightscript" uri="pkg:/source/String.brs" />
  <script type="text/brightscript" uri="pkg:/source/Logger.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/HomePage/HomePage.brs" />
  <interface>
    <field id="loadRequest" type="assocarray" onChange="onLoadRequestChanged" />
    <field id="selectedMovie" type="assocarray" alwaysNotify="true" />
    <field id="selectedSeries" type="assocarray" alwaysNotify="true" />
    <field id="selectedLibrary" type="assocarray" alwaysNotify="true" />
    <field id="selectedCollections" type="assocarray" alwaysNotify="true" />
    <field id="focusExitUp" type="boolean" alwaysNotify="true" />
    <function name="activate" />
  </interface>
  <children>
    <Group id="contentGroup" translation="[96,120]">
      <LabelPrimary
        id="statusLabel"
        translation="[0,72]"
        width="1200"
        numLines="1"
        text="Loading home..." />

      <Group id="shelfViewport" translation="[0,20]" clippingRect="[0,0,1728,816]">
        <Group id="shelvesGroup" translation="[0,0]" />
      </Group>
    </Group>

    <Animation id="shelvesAnimation" duration="0.18" repeat="false" easeFunction="outQuad">
      <Vector2DFieldInterpolator id="shelvesTranslation" key="[0.0,1.0]" fieldToInterp="shelvesGroup.translation" />
    </Animation>

    <HomeLibrariesTask id="librariesTask" />
    <ContinueWatchingTask id="continueWatchingTask" />
    <ContinueListeningTask id="continueListeningTask" />
    <NextUpTask id="nextUpTask" />
    <LatestMediaTask id="latestMediaTask" />
    <LiveTvOnNowTask id="liveTvOnNowTask" />
    <MyListTask id="myListTask" />
    <FavoritesTask id="favoritesTask" />
  </children>
</component>
