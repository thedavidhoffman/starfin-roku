import "pkg:/source/Format.bs"
import "pkg:/source/Encode.bs"
import "pkg:/source/Number.bs"
import "pkg:/source/EpisodeQueueIdentity.bs"
import "pkg:/source/String.bs"
import "pkg:/source/Url.bs"
import "pkg:/source/PlaybackProgress.bs"
import "pkg:/source/Spinner.bs"
import "pkg:/source/Status.bs"
import "pkg:/source/PlaybackMode.bs"
import "pkg:/source/LibraryBrowse.bs"
import "pkg:/source/SubtitleBurnIn.bs"
import "pkg:/source/store/RegistryStore.bs"
import "pkg:/source/store/SettingsStore.bs"
import "pkg:/components/pages/MainScene/Helpers/TVShow.bs"
import "pkg:/components/pages/MainScene/Helpers/TVSeason.bs"
import "pkg:/components/pages/MainScene/Helpers/TVEpisode.bs"
import "pkg:/components/pages/MainScene/Helpers/Collections.bs"
import "pkg:/components/pages/MainScene/Helpers/VideoLibrary.bs"
import "pkg:/components/pages/MainScene/Helpers/HomeMediaLibrary.bs"
import "pkg:/components/pages/MainScene/Helpers/MusicLibrary.bs"
import "pkg:/components/pages/MainScene/Helpers/LiveTV.bs"
import "pkg:/components/pages/MainScene/Helpers/Movie.bs"
import "pkg:/components/pages/MainScene/Helpers/Search.bs"
import "pkg:/components/pages/MainScene/Helpers/Person.bs"
import "pkg:/components/pages/MainScene/Helpers/Filmography.bs"
import "pkg:/components/pages/MainScene/Helpers/Auth.bs"
import "pkg:/components/pages/MainScene/Helpers/Navigation.bs"
import "pkg:/components/pages/MainScene/Helpers/Playback.bs"
import "pkg:/components/pages/MainScene/Helpers/ThemeAudioRouting.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()

    initReferences()
    initValues()
    initHandlers()

end sub

'-------------------------------------------------------------------------------
' startApp
'-------------------------------------------------------------------------------
sub startApp()
    if m.appLifecycle.started then return
    m.appLifecycle.started = true

    authSyncSavedSessionToLogin()
    authRequestResumeSession()
end sub

'-------------------------------------------------------------------------------
' initReferences
'-------------------------------------------------------------------------------
sub initReferences()
    m.authenticatedContent = m.top.findNode("authenticatedContent")
    m.authController = m.top.findNode("authController")
    m.mediaActionsController = m.top.findNode("mediaActionsController")
    m.playbackController = m.top.findNode("playbackController")
    m.header = m.top.findNode("header")
    m.homePage = m.top.findNode("homePage")
    m.login = m.top.findNode("login")
    m.overlayHost = m.top.findNode("overlayHost")
    m.dynamicPageHost = m.top.findNode("dynamicPageHost")
    m.themeAudioController = m.top.findNode("themeAudioController")
    m.statusLabel = m.top.findNode("statusLabel")
    m.loadingSpinner = m.top.findNode("loadingSpinner")
end sub

'-------------------------------------------------------------------------------
' initValues
'-------------------------------------------------------------------------------
sub initValues()
    m.session = invalid
    m.settings = SettingsStore.Load("")
    m.appLifecycle = {
        started: false
    }
    m.homeRefreshState = {
        playbackRowsDirty: false
    }
    m.mediaActionState = {
        activeRequest: invalid
    }
    m.videoLibraryNavigation = {
        parentPage: invalid
        settingsDirty: false
    }
    resetPersonSource()
end sub

'-------------------------------------------------------------------------------
' resetPersonSource
'-------------------------------------------------------------------------------
sub resetPersonSource()
    m.personSource = {
        moviePage: invalid
        tvShowPage: invalid
        tvSeasonPage: invalid
        tvEpisodePage: invalid
        playback: false
    }
end sub

'-------------------------------------------------------------------------------
' initHandlers
'-------------------------------------------------------------------------------
sub initHandlers()

    m.login.observeField("loginRequested", "authHandleLoginRequested")
    m.login.observeField("accountPickerRequested", "authHandleLoginAccountPickerRequested")
    m.login.observeField("serverValue", "authHandleLoginServerChanged")
    m.authController.observeField("authenticatedSession", "authHandleAuthenticatedSession")
    m.authController.observeField("loginFailed", "authHandleLoginFailed")
    m.authController.observeField("loginRequired", "authHandleLoginRequired")
    m.authController.observeField("savedSession", "authHandleSavedSessionChanged")
    m.authController.observeField("sessionExpired", "authHandleSessionExpired")
    m.mediaActionsController.observeField("mediaStateChanged", "navHandleMediaStateChanged")
    m.mediaActionsController.observeField("actionFailed", "navHandleMediaActionFailed")
    m.playbackController.observeField("playerOpened", "playerHandleOpened")
    m.playbackController.observeField("playbackProgressChanged", "playerHandlePlaybackProgressChanged")
    m.playbackController.observeField("upNextRequested", "playerHandleUpNextRequested")
    m.playbackController.observeField("overlayRequested", "playerHandleOverlayRequested")
    m.playbackController.observeField("selectedPerson", "playerHandlePersonSelected")
    m.playbackController.observeField("closed", "playerHandleCloseRequested")
    m.homePage.observeField("selectedMovie", "movieHandleHomeMovieSelected")
    m.homePage.observeField("selectedSeries", "tvShowHandleHomeSeriesSelected")
    m.homePage.observeField("selectedEpisode", "tvEpisodeHandleHomeEpisodeSelected")
    m.homePage.observeField("selectedLibrary", "videoLibraryHandleHomeLibrarySelected")
    m.homePage.observeField("selectedHomeMediaLibrary", "homeMediaLibraryHandleHomeSelected")
    m.homePage.observeField("selectedHomeMediaVideo", "homeMediaLibraryHandleHomeVideoSelected")
    m.homePage.observeField("selectedHomeMediaPhoto", "homeMediaLibraryHandleHomePhotoSelected")
    m.homePage.observeField("selectedMusicLibrary", "musicLibraryHandleHomeLibrarySelected")
    m.homePage.observeField("selectedAlbum", "musicLibraryHandleHomeAlbumSelected")
    m.homePage.observeField("selectedLiveTV", "liveTvHandleHomeSelected")
    m.homePage.observeField("selectedCollections", "collectionsHandleHomeCollectionsSelected")
    m.homePage.observeField("overlayRequested", "navHandleHomeOverlayRequested")
    m.homePage.observeField("focusExitUp", "navHandleHomeFocusExitUp")
    m.homePage.observeField("playbackRowsRefreshCompleted", "homeHandlePlaybackRowsRefreshCompleted")
    m.header.observeField("homeSelected", "navHandleHeaderHomeSelected")
    m.header.observeField("searchSelected", "searchHandleHeaderSelected")
    m.header.observeField("downSelected", "navHandleHeaderDownSelected")
    m.header.observeField("logoutSelected", "authHandleLogoutPressed")
    m.header.observeField("switchAccountSelected", "authHandleSwitchAccountPressed")
    m.header.observeField("overlayRequested", "navHandleHeaderOverlayRequested")
    m.overlayHost.observeField("closed", "navHandleOverlayClosed")
    m.overlayHost.observeField("eventRaised", "navHandleOverlayEventRaised")
    authObserveTaskResponses(m.homePage)

end sub
