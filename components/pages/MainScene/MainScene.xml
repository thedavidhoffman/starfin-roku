<?xml version="1.0" encoding="utf-8"?>
<component name="MainScene" extends="Scene">
  <script type="text/brightscript" uri="pkg:/components/pages/MainScene/MainScene.bs" />
  <interface>
    <field id="closeRequested" type="boolean" />
    <function name="showMessage" />
    <function name="dismissMessage" />
    <function name="startApp" />
    <function name="submitInput" />
  </interface>
  <children>
    <Rectangle id="bg" width="1920" height="1080" color="0x000000FF" />
    <Poster id="gradientBg" uri="pkg:/images/overlays/gradient-bg.png" width="1920" height="1080" loadDisplayMode="scaleToFill" />

    <Login id="login" visible="false" />

    <Group id="authenticatedContent" visible="false">
     
      <HomePage id="homePage" visible="false" />
      <Group id="dynamicPageHost" />
      <ThemeAudioController id="themeAudioController" />
      <Header id="header" visible="false" />
      <PlaybackController id="playbackController" />

    </Group>

    <OverlayHost id="overlayHost" />
    <Spinner id="loadingSpinner" />
    <OverlayHost id="messageOverlayHost" visible="false" />
    <Timer id="messageOpenTimer" duration="0.01" repeat="false" />

    <AuthController id="authController" />
    <MediaActionsController id="mediaActionsController" />
    <DeepLinkController id="deepLinkController" />

  </children>
</component>
