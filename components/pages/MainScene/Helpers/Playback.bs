import "pkg:/source/Format.bs"
import "pkg:/source/String.bs"
'-------------------------------------------------------------------------------
' playerShow
'-------------------------------------------------------------------------------
sub playerShow(selection as object, origin = invalid as dynamic, returnBehavior = PlaybackReturn.Behavior.Page as string)
    if selection = invalid then return
    if selection.itemId = invalid or selection.itemId = "" then return
    if origin <> invalid then capturePlaybackReturn(origin, returnBehavior)
    removeAudioPlayer()
    dismissMessage()

    item = selection.item
    itemType = "media"
    if item <> invalid then itemType = LCase(Strings.ToString(item.Type, "media"))
    title = ActivityLog.ItemTitle(item, itemType)
    if itemType = "episode" then title = ActivityLog.EpisodeTitle(item)
    action = "Starting"
    if PlaybackProgress.GetTicksFromSelection(selection) > 0 then action = "Resuming"
    m.log.activity(action + " " + itemType + " " + title)

    themeAudioStop()
    if m.moviePage <> invalid and m.moviePage.visible = true then m.moviePage.callFunc("deactivate")
    playRequest = {
        server: m.session.server
        token: m.session.token
        userId: m.session.userId
        itemId: selection.itemId
        item: selection.item
        series: selection.series
        season: selection.season
        startPositionTicks: PlaybackProgress.GetTicksFromSelection(selection)
        playbackQueue: selection.playbackQueue
        playbackQueueIndex: selection.playbackQueueIndex
        playbackQueueMode: selection.playbackQueueMode
        playbackQueueScope: selection.playbackQueueScope
        tracksPlaybackProgress: selection.tracksPlaybackProgress
        nextItemPlayback: SettingsStore.GetSettingValue(m.settings, SettingsStore.Key.NextItemPlayback)
        nextEpisodePromptSeconds: SettingsStore.GetSettingValue(m.settings, SettingsStore.Key.NextEpisodePromptSeconds)
        videoMode: SettingsStore.GetSettingValue(m.settings, SettingsStore.Key.VideoStreamingMode)
        subtitleBurnInMode: SettingsStore.GetSettingValue(m.settings, SettingsStore.Key.SubtitleBurnInMode)
    }
    if selection.loadItemDetails = true then playRequest.loadItemDetails = true
    EpisodeQueueIdentity.Apply(playRequest, selection.playbackQueueScope, selection.episodeQueueId)
    ' Movie resume is resolved after loading the selected source; explicit positions retain their meaning.
    if itemType = "movie" and selection.startPositionTicks = invalid then playRequest.Delete("startPositionTicks")
    if selection.nextEpisodePromptSeconds <> invalid then playRequest.nextEpisodePromptSeconds = NextEpisodePromptSeconds.Normalize(selection.nextEpisodePromptSeconds)
    if selection.nextItemPlayback <> invalid then playRequest.nextItemPlayback = NextItemPlayback.Normalize(selection.nextItemPlayback)
    if selection.audioStreamIndex <> invalid then playRequest.AddReplace("audioStreamIndex", selection.audioStreamIndex)
    if selection.mediaSourceId <> invalid then playRequest.mediaSourceId = selection.mediaSourceId
    if selection.movieVersions <> invalid then playRequest.movieVersions = selection.movieVersions
    if selection.subtitleStreamIndex <> invalid then playRequest.AddReplace("subtitleStreamIndex", selection.subtitleStreamIndex)
    if selection.videoMode <> invalid then playRequest.AddReplace("videoMode", selection.videoMode)
    if selection.subtitleBurnInMode <> invalid then playRequest.subtitleBurnInMode = SubtitleBurnIn.Normalize(selection.subtitleBurnInMode)
    m.playbackController.playRequest = playRequest

    if m.moviePage <> invalid then m.moviePage.visible = false
    if m.tvShowPage <> invalid then m.tvShowPage.visible = false
    if m.tvEpisodePage <> invalid then m.tvEpisodePage.visible = false
    if m.tvSeasonPage <> invalid then m.tvSeasonPage.visible = false
    if m.tvEpisodeUpNextAutoPlayPage <> invalid then m.tvEpisodeUpNextAutoPlayPage.visible = false
    if m.liveTvPage <> invalid then m.liveTvPage.visible = false
    if m.homeMediaLibraryPage <> invalid then m.homeMediaLibraryPage.visible = false
    hideHome()
    m.header.visible = false
end sub

'-------------------------------------------------------------------------------
' playerHandleOpened
'-------------------------------------------------------------------------------
sub playerHandleOpened()
    authObserveTaskResponses(m.playbackController)
end sub

'-------------------------------------------------------------------------------
' playerHandleOverlayRequested
'-------------------------------------------------------------------------------
sub playerHandleOverlayRequested()
    request = m.playbackController.overlayRequested
    if request = invalid then return

    m.overlayHost.callFunc("openOverlay", request)
end sub

'-------------------------------------------------------------------------------
' playerHandlePersonSelected
'-------------------------------------------------------------------------------
sub playerHandlePersonSelected()
    selection = m.playbackController.selectedPerson
    if selection = invalid then return
    if selection.itemId = invalid or selection.itemId = "" then return

    m.playbackController.callFunc("suspendForNavigation")
    personShow(selection)
end sub

'-------------------------------------------------------------------------------
' playerHandleUpNextRequested
'-------------------------------------------------------------------------------
sub playerHandleUpNextRequested()
    request = m.playbackController.upNextRequested
    if request = invalid then return

    m.pendingUpNextAutoPlayRequest = request
end sub

'-------------------------------------------------------------------------------
' playerHandlePlaybackProgressChanged
'-------------------------------------------------------------------------------
sub playerHandlePlaybackProgressChanged()
    change = m.playbackController.playbackProgressChanged
    if change = invalid then return

    m.homePage.callFunc("applyPlaybackProgressChange", change)
    markHomePlaybackRowsDirty()

    ' Keep sub-5% progress alive only for this navigation session; Jellyfin
    ' remains authoritative after reload because it discards early resume points.
    routeMoviePlaybackProgress(change)
    routeTVShowPlaybackProgress(change)
    routeTVEpisodePlaybackProgress(change)
    routeTVSeasonPlaybackProgress(change)
    routeVideoLibraryPlaybackProgress(change)
    routeHomeMediaLibraryPlaybackProgress(change)
end sub

'-------------------------------------------------------------------------------
' routeHomeMediaLibraryPlaybackProgress
'-------------------------------------------------------------------------------
sub routeHomeMediaLibraryPlaybackProgress(change as object)
    if m.homeMediaLibraryPage = invalid then return
    m.homeMediaLibraryPage.playbackProgressChange = change
end sub

'-------------------------------------------------------------------------------
' routeVideoLibraryPlaybackProgress
'-------------------------------------------------------------------------------
sub routeVideoLibraryPlaybackProgress(change as object)
    if m.videoLibraryPage = invalid then return

    m.videoLibraryPage.playbackProgressChange = change
end sub

'-------------------------------------------------------------------------------
' routeMoviePlaybackProgress
'-------------------------------------------------------------------------------
sub routeMoviePlaybackProgress(change as object)
    if m.moviePage = invalid then return

    m.moviePage.playbackProgressChange = change
end sub

'-------------------------------------------------------------------------------
' routeTVShowPlaybackProgress
'-------------------------------------------------------------------------------
sub routeTVShowPlaybackProgress(change as object)
    if m.tvShowPage = invalid then return
    if m.tvSeasonPage <> invalid or m.tvEpisodePage <> invalid then return

    m.tvShowPage.playbackProgressChange = change
end sub

'-------------------------------------------------------------------------------
' routeTVEpisodePlaybackProgress
'-------------------------------------------------------------------------------
sub routeTVEpisodePlaybackProgress(change as object)
    if m.tvEpisodePage = invalid then return

    m.tvEpisodePage.playbackProgressChange = change
end sub

'-------------------------------------------------------------------------------
' routeTVSeasonPlaybackProgress
'-------------------------------------------------------------------------------
sub routeTVSeasonPlaybackProgress(change as object)
    if m.tvSeasonPage = invalid then return

    m.tvSeasonPage.playbackProgressChange = change
end sub

'-------------------------------------------------------------------------------
' playerHandleCloseRequested
'-------------------------------------------------------------------------------
sub playerHandleCloseRequested()
    clearStatus()
    closed = m.playbackController.closed
    if closed = invalid then return
    if deepLinkCancelCurrentDestination(DeepLink.DestinationType.Playback) then return

    closedPlayRequest = closed.restorePlayRequest
    failureMessage = Strings.ToString(closed.failureMessage)
    capturePendingUpNextAutoPlayRequest(closed.upNextRequest)

    resetPlaybackVideoMode()
    if failureMessage = "" then
        if showTVEpisodeUpNextAutoPlayPage(closedPlayRequest) then return
    end if
    restorePlaybackReturn(closedPlayRequest)
    ' Restore the page first: navigation cleanup dismisses existing messages.
    if failureMessage <> "" then AppMessage.Show(failureMessage)
end sub

'-------------------------------------------------------------------------------
' isPlaylistPlayRequest
'-------------------------------------------------------------------------------
function isPlaylistPlayRequest(playRequest as dynamic) as boolean
    if playRequest = invalid or playRequest.playbackQueue = invalid then return false

    queue = playRequest.playbackQueue
    queueIndex = Number.ToInteger(playRequest.playbackQueueIndex, -1)
    if queueIndex < 0 or queueIndex >= queue.Count() then return false

    queueItem = queue[queueIndex]
    return queueItem <> invalid and queueItem.hasPlaybackContext = true
end function

'-------------------------------------------------------------------------------
' getPlaylistPlayRequestItemIndex
'-------------------------------------------------------------------------------
function getPlaylistPlayRequestItemIndex(playRequest as dynamic) as integer
    if isPlaylistPlayRequest(playRequest) <> true then return -1

    queueIndex = Number.ToInteger(playRequest.playbackQueueIndex, -1)
    queueItem = playRequest.playbackQueue[queueIndex]
    return Number.ToInteger(queueItem.playlistItemIndex, -1)
end function

'-------------------------------------------------------------------------------
' resetPlaybackVideoMode
'-------------------------------------------------------------------------------
sub resetPlaybackVideoMode()
    if m.moviePage <> invalid then m.moviePage.callFunc("applyPlaybackVideoMode", invalid)
    if m.tvEpisodePage <> invalid then m.tvEpisodePage.callFunc("applyPlaybackVideoMode", invalid)
end sub

'-------------------------------------------------------------------------------
' capturePendingUpNextAutoPlayRequest
'-------------------------------------------------------------------------------
sub capturePendingUpNextAutoPlayRequest(request as dynamic)
    if m.pendingUpNextAutoPlayRequest <> invalid then return
    if request = invalid then return

    m.pendingUpNextAutoPlayRequest = request
end sub

'-------------------------------------------------------------------------------
' showTVEpisodeUpNextAutoPlayPage
'-------------------------------------------------------------------------------
function showTVEpisodeUpNextAutoPlayPage(restorePlayRequest as dynamic) as boolean
    request = m.pendingUpNextAutoPlayRequest
    m.pendingUpNextAutoPlayRequest = invalid
    if request = invalid then return false

    page = CreateObject("roSGNode", "TVEpisodeUpNextAutoPlay")
    page.observeField("playSelected", "tvEpisodeUpNextHandlePlaySelected")
    page.observeField("cancelSelected", "tvEpisodeUpNextHandleCancelSelected")
    page.autoPlayRequest = request

    m.tvEpisodeUpNextAutoPlayPage = page
    m.tvEpisodeUpNextRestorePlayRequest = restorePlayRequest
    authAppendDynamicPage(page)
    hideHome()
    m.header.visible = false
    page.callFunc("openAutoPlay")

    return true
end function

'-------------------------------------------------------------------------------
' tvEpisodeUpNextHandlePlaySelected
'-------------------------------------------------------------------------------
sub tvEpisodeUpNextHandlePlaySelected()
    if m.tvEpisodeUpNextAutoPlayPage = invalid then return

    request = m.tvEpisodeUpNextAutoPlayPage.autoPlayRequest
    restoreRequest = m.tvEpisodeUpNextRestorePlayRequest
    m.tvEpisodeUpNextRestorePlayRequest = invalid
    closeTVEpisodeUpNextAutoPlayPage()
    if request = invalid then
        restorePlaybackReturn(restoreRequest)
        return
    end if

    nextItem = request.nextItem
    if nextItem = invalid or Strings.ToString(nextItem.itemId) = "" then
        restorePlaybackReturn(restoreRequest)
        return
    end if

    selection = {
        itemId: nextItem.itemId
        item: nextItem.item
        series: request.series
        season: request.season
        playbackQueue: request.playbackQueue
        playbackQueueIndex: request.playbackQueueIndex
        playbackQueueMode: request.playbackQueueMode
        playbackQueueScope: request.playbackQueueScope
        tracksPlaybackProgress: request.tracksPlaybackProgress
        nextItemPlayback: request.nextItemPlayback
        nextEpisodePromptSeconds: request.nextEpisodePromptSeconds
        videoMode: request.videoMode
        subtitleBurnInMode: request.subtitleBurnInMode
    }
    EpisodeQueueIdentity.Apply(selection, request.playbackQueueScope, request.episodeQueueId)
    playerShow(selection)
end sub

'-------------------------------------------------------------------------------
' prepareTVEpisodePageForClosedPlayer
'-------------------------------------------------------------------------------
sub prepareTVEpisodePageForClosedPlayer(playRequest as dynamic)
    loadRequest = buildClosedPlayerTVEpisodeLoadRequest(playRequest)
    if loadRequest = invalid then return
    if isCurrentTVEpisodePage(loadRequest.itemId) then return
    if m.tvShowPage <> invalid and m.tvSeasonPage = invalid and m.tvEpisodePage = invalid then return

    if m.tvEpisodePage <> invalid then
        m.dynamicPageHost.removeChild(m.tvEpisodePage)
        m.tvEpisodePage = invalid
    end if

    page = createTVEpisodePage(loadRequest, false)
    m.tvEpisodePage = page
    authAppendDynamicPage(page)
    if m.tvSeasonPage <> invalid then m.tvSeasonPage.visible = false
    if m.personPage <> invalid then m.personPage.visible = false
end sub

'-------------------------------------------------------------------------------
' buildClosedPlayerTVEpisodeLoadRequest
'-------------------------------------------------------------------------------
function buildClosedPlayerTVEpisodeLoadRequest(playRequest as dynamic) as dynamic
    if isTVEpisodePlayRequest(playRequest) <> true then return invalid

    item = playRequest.item
    if item = invalid then return invalid

    itemId = Format.FirstNonEmpty([playRequest.itemId, item.Id], "")
    if itemId = "" then return invalid

    seriesId = Format.FirstNonEmpty([item.SeriesId], "")
    if seriesId = "" and playRequest.series <> invalid then seriesId = Format.FirstNonEmpty([playRequest.series.Id], "")

    seasonId = Format.FirstNonEmpty([item.SeasonId, item.ParentId], "")
    if seasonId = "" and playRequest.season <> invalid then seasonId = Format.FirstNonEmpty([playRequest.season.Id], "")

    loadRequest = {
        server: playRequest.server
        token: playRequest.token
        userId: playRequest.userId
        seriesId: seriesId
        seasonId: seasonId
        itemId: itemId
        item: item
        series: playRequest.series
        season: playRequest.season
        startPositionTicks: PlaybackProgress.GetTicksFromItem(item)
        playbackQueue: playRequest.playbackQueue
        playbackQueueIndex: playRequest.playbackQueueIndex
        playbackQueueMode: playRequest.playbackQueueMode
        playbackQueueScope: playRequest.playbackQueueScope
    }
    if playRequest.subtitleStreamIndex <> invalid then loadRequest.subtitleStreamIndex = playRequest.subtitleStreamIndex
    EpisodeQueueIdentity.Apply(loadRequest, playRequest.playbackQueueScope, playRequest.episodeQueueId)
    return loadRequest
end function

'-------------------------------------------------------------------------------
' isTVEpisodePlayRequest
'-------------------------------------------------------------------------------
function isTVEpisodePlayRequest(playRequest as dynamic) as boolean
    if playRequest = invalid then return false
    if playRequest.series <> invalid then return true

    item = playRequest.item
    if item = invalid then return false

    return LCase(Format.FirstNonEmpty([item.Type], "")) = "episode"
end function

'-------------------------------------------------------------------------------
' isCurrentTVEpisodePage
'-------------------------------------------------------------------------------
function isCurrentTVEpisodePage(itemId as string) as boolean
    if itemId = "" then return false
    if m.tvEpisodePage = invalid then return false

    request = m.tvEpisodePage.loadRequest
    if request = invalid then return false

    return Strings.ToString(request.itemId) = itemId
end function

'-------------------------------------------------------------------------------
' tvEpisodeUpNextHandleCancelSelected
'-------------------------------------------------------------------------------
sub tvEpisodeUpNextHandleCancelSelected()
    restoreRequest = m.tvEpisodeUpNextRestorePlayRequest
    m.tvEpisodeUpNextRestorePlayRequest = invalid
    closeTVEpisodeUpNextAutoPlayPage()
    restorePlaybackReturn(restoreRequest)
end sub

'-------------------------------------------------------------------------------
' closeTVEpisodeUpNextAutoPlayPage
'-------------------------------------------------------------------------------
sub closeTVEpisodeUpNextAutoPlayPage()
    if m.tvEpisodeUpNextAutoPlayPage <> invalid then
        m.dynamicPageHost.removeChild(m.tvEpisodeUpNextAutoPlayPage)
        m.tvEpisodeUpNextAutoPlayPage = invalid
    end if
end sub
