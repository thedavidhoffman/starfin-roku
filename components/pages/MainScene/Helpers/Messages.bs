import "pkg:/source/TimerControl.bs"
import "pkg:/source/String.bs"

'-------------------------------------------------------------------------------
' showMessage
'-------------------------------------------------------------------------------
sub showMessage(message as string, title = "Message" as string)
    if Strings.Trim(message) = "" then return
    previousTitle = m.messageState.title
    title = Strings.Trim(title)
    if title = "" then title = "Message"
    if m.messageState.messages.Count() = 0 then
        m.messageState.title = title
    else if m.messageState.title <> title then
        m.messageState.title = "Message"
    end if
    isDuplicate = false
    for each existing in m.messageState.messages
        if existing = message then
            isDuplicate = true
            exit for
        end if
    end for
    if isDuplicate and previousTitle = m.messageState.title then return
    if m.messageState.messages.Count() = 0 then m.messageState.returnFocus = getMessageReturnFocus()
    if not isDuplicate then m.messageState.messages.Push(message)
    if m.messageState.overlay <> invalid then
        m.messageOverlayHost.callFunc("updateOverlay", { id: "message", title: m.messageState.title, message: Strings.Join(m.messageState.messages, Chr(10) + Chr(10)) })
    else
        m.messageOpenTimer.control = TimerControl.Command.Start
    end if
end sub

'-------------------------------------------------------------------------------
' onMessageOpenTimer
'-------------------------------------------------------------------------------
sub onMessageOpenTimer()
    if m.messageState.messages.Count() = 0 then return
    if m.messageState.overlay <> invalid then
        m.messageState.overlay.callFunc("focusAcknowledgment")
        return
    end if
    m.messageOverlayHost.visible = true
    m.messageState.overlay = m.messageOverlayHost.callFunc("openOverlay", {
        id: "message"
        componentName: "MessageDialog"
        openFunction: "openMessage"
        closeField: "closeRequested"
        title: m.messageState.title
        message: Strings.Join(m.messageState.messages, Chr(10) + Chr(10))
    })
end sub

'-------------------------------------------------------------------------------
' dismissMessage
'-------------------------------------------------------------------------------
sub dismissMessage(restoreFocus = false as boolean)
    m.messageOpenTimer.control = TimerControl.Command.Stop
    target = m.messageState.returnFocus
    m.messageState = { messages: [], title: "Message", returnFocus: invalid, overlay: invalid }
    m.messageOverlayHost.callFunc("closeOverlay")
    m.messageOverlayHost.closed = invalid
    m.messageOverlayHost.visible = false
    if restoreFocus <> true then return
    ' A save may finish or fail while the acknowledgment is open. Respect the
    ' current modal layer before returning to the control captured at opening.
    if m.confirmationOverlayHost.getChildCount() > 0 then
        confirmation = m.confirmationOverlayHost.getChild(0)
        if isMessageReturnFocusAvailable(target, confirmation) then
            target.setFocus(true)
        else
            confirmation.callFunc("focusContent")
        end if
    else if m.loadingSpinner.blockInteraction then
        m.loadingSpinner.setFocus(true)
    else if isMessageReturnFocusAvailable(target) then
        target.setFocus(true)
    else if m.overlayHost.getChildCount() > 0 then
        m.overlayHost.getChild(0).callFunc("focusContent")
    else
        focusActiveSurface()
    end if
end sub

'-------------------------------------------------------------------------------
' onMessageClosed
'-------------------------------------------------------------------------------
sub onMessageClosed()
    if m.messageOverlayHost.closed = invalid then return
    dismissMessage(true)
end sub

'-------------------------------------------------------------------------------
' onMessageFocusChanged
'-------------------------------------------------------------------------------
sub onMessageFocusChanged()
    overlay = m.messageState.overlay
    if overlay = invalid then return
    if overlay.getScene() = invalid then return
    ' Let the competing setFocus finish before restoring the modal focus chain.
    m.messageOpenTimer.control = TimerControl.Command.Start
end sub

'-------------------------------------------------------------------------------
' getMessageReturnFocus
'-------------------------------------------------------------------------------
function getMessageReturnFocus() as dynamic
    node = m.top
    while node.focusedChild <> invalid
        child = node.focusedChild
        if child.isSameNode(node) then exit while
        node = child
    end while
    if node.isSameNode(m.top) or node.isSameNode(m.loadingSpinner) then return invalid
    return node
end function

'-------------------------------------------------------------------------------
' isMessageReturnFocusAvailable
'-------------------------------------------------------------------------------
function isMessageReturnFocusAvailable(node as dynamic, owner = invalid as dynamic) as boolean
    if node = invalid then return false
    scene = node.getScene()
    if scene = invalid then return false
    ' The captured control already accepted focus; existing buttons need not declare focusable.
    belongsToOwner = owner = invalid
    ancestor = node
    while ancestor <> invalid
        if ancestor.visible = false then return false
        if owner <> invalid and ancestor.isSameNode(owner) then belongsToOwner = true
        if ancestor.isSameNode(m.top) then return belongsToOwner
        ancestor = ancestor.getParent()
    end while
    return false
end function
