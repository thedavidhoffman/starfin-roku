import "pkg:/source/SettingsClose.bs"

'-------------------------------------------------------------------------------
' routeSettingsSaveFailure
'-------------------------------------------------------------------------------
sub routeSettingsSaveFailure(request as object)
    if request.kind = SettingsClose.Request.Dismiss then
        if request.requestId = m.settingsConfirmation.requestId then clearSettingsConfirmation()
        return
    end if
    if request.kind <> SettingsClose.Request.Open or m.overlayHost.getChildCount() = 0 then return
    clearSettingsConfirmation()
    m.settingsConfirmation = { owner: m.overlayHost.getChild(0), requestId: request.requestId }
    m.confirmationOverlayHost.callFunc("openOverlay", { id: "settingsSaveFailure", componentName: "SettingsSaveFailureDialog", openFunction: "openFailure", closeField: "closeRequested", message: request.message })
end sub

'-------------------------------------------------------------------------------
' clearSettingsConfirmation
'-------------------------------------------------------------------------------
sub clearSettingsConfirmation()
    m.confirmationOverlayHost.callFunc("closeOverlay", false)
    m.settingsConfirmation = { owner: invalid, requestId: -1 }
end sub

'-------------------------------------------------------------------------------
' onSettingsConfirmationClosed
'-------------------------------------------------------------------------------
sub onSettingsConfirmationClosed()
    closed = m.confirmationOverlayHost.closed
    if closed = invalid or closed.overlay = invalid then return
    owner = m.settingsConfirmation.owner
    requestId = m.settingsConfirmation.requestId
    m.settingsConfirmation = { owner: invalid, requestId: -1 }
    if owner = invalid or m.overlayHost.getChildCount() = 0 then return
    if not owner.isSameNode(m.overlayHost.getChild(0)) then return
    owner.callFunc("resolveSubtitleSaveFailure", { requestId: requestId, decision: closed.overlay.decision })
end sub
