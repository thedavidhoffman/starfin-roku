'-------------------------------------------------------------------------------
' authSyncSavedSessionToLogin
'-------------------------------------------------------------------------------
sub authSyncSavedSessionToLogin()
    m.login.savedSession = m.authController.savedSession
end sub

'-------------------------------------------------------------------------------
' authRequestResumeSession
'-------------------------------------------------------------------------------
sub authRequestResumeSession()
    Spinner.ShowBlocking()
    m.login.visible = false
    m.authenticatedContent.visible = false
    m.authController.resumeRequested = true
end sub

'-------------------------------------------------------------------------------
' authHandleLoginRequested
'-------------------------------------------------------------------------------
sub authHandleLoginRequested()
    Spinner.ShowBlocking()
    m.authController.loginRequest = m.login.loginRequested
end sub

'-------------------------------------------------------------------------------
' authHandleQuickConnectRequested
'-------------------------------------------------------------------------------
sub authHandleQuickConnectRequested()
    request = m.login.quickConnectRequested
    if request = invalid then return
    m.authController.quickConnectRequest = request
end sub

'-------------------------------------------------------------------------------
' authHandleQuickConnectCancelled
'-------------------------------------------------------------------------------
sub authHandleQuickConnectCancelled()
    m.authController.quickConnectCancelRequested = true
end sub

'-------------------------------------------------------------------------------
' authHandleQuickConnectState
'-------------------------------------------------------------------------------
sub authHandleQuickConnectState()
    state = m.authController.quickConnectState
    if state = invalid then return
    m.login.quickConnectState = state
end sub

'-------------------------------------------------------------------------------
' authShowLogin
'-------------------------------------------------------------------------------
sub authShowLogin(message as string)
    m.login.statusMessage = message
    authRefreshLoginSavedAccounts()
    navShowLoginRoute()
end sub

'-------------------------------------------------------------------------------
' authHandleLoginServerChanged
'-------------------------------------------------------------------------------
sub authHandleLoginServerChanged()
    authRefreshLoginSavedAccounts()
end sub

'-------------------------------------------------------------------------------
' authRefreshLoginSavedAccounts
'-------------------------------------------------------------------------------
sub authRefreshLoginSavedAccounts()
    server = Url.NormalizeServer(m.login.serverValue)
    m.login.savedAccounts = m.authController.callFunc("getAccountsForServer", server)
end sub

'-------------------------------------------------------------------------------
' authHandleExpiredSession
'-------------------------------------------------------------------------------
sub authHandleExpiredSession(message as string, clearRuntimeSession = true as boolean)
    if clearRuntimeSession and m.session <> invalid then m.session.token = ""
    m.login.passwordValue = ""
    authShowLogin(message)
end sub

'-------------------------------------------------------------------------------
' authHandleSwitchAccountPressed
'-------------------------------------------------------------------------------
sub authHandleSwitchAccountPressed()
    if m.session = invalid then return
    accounts = m.authController.callFunc("getAccountsForServer", m.session.server)
    openAccountPicker(accounts, "header")
end sub

'-------------------------------------------------------------------------------
' authHandleLoginAccountPickerRequested
'-------------------------------------------------------------------------------
sub authHandleLoginAccountPickerRequested()
    request = m.login.accountPickerRequested
    if request = invalid then return
    openAccountPicker(request.accounts, "login")
end sub

'-------------------------------------------------------------------------------
' openAccountPicker
'-------------------------------------------------------------------------------
sub openAccountPicker(accounts as object, source as string)
    m.overlayHost.callFunc("openOverlay", {
        id: "accountPicker"
        componentName: "AccountPickerDialog"
        openFunction: "openAccountPicker"
        closeField: "closeRequested"
        accounts: accounts
        source: source
    })
end sub

'-------------------------------------------------------------------------------
' authHandleAccountPickerClosed
'-------------------------------------------------------------------------------
sub authHandleAccountPickerClosed(closed as object)
    request = closed.request
    source = "header"
    if request <> invalid then source = Format.SafeString(request.source, source)
    overlay = closed.overlay
    if overlay = invalid then
        restoreAccountPickerFocus(source)
        return
    end if
    if source = "login" and overlay.accountsUpdated = true then authRefreshLoginSavedAccounts()
    if overlay.signInSelected = true then
        server = m.login.serverValue
        if m.session <> invalid then server = Format.SafeString(m.session.server, server)
        m.login.serverValue = server
        m.login.usernameValue = ""
        m.login.passwordValue = ""
        authShowLogin("Sign in with another account.")
        return
    end if

    account = overlay.selectedAccount
    if account = invalid then
        restoreAccountPickerFocus(source)
        return
    end if
    isAuthenticatedActiveAccount = source = "header" and m.authenticatedContent.visible = true and m.session <> invalid
    if isAuthenticatedActiveAccount then isAuthenticatedActiveAccount = Format.SafeString(m.session.token, "") <> ""
    if isAuthenticatedActiveAccount and Format.SafeString(account.accountKey, "") = Format.SafeString(m.session.accountKey, "") then
        restoreAccountPickerFocus(source)
        return
    end if

    Spinner.ShowBlocking()
    themeAudioStop()
    resetDynamicPages()
    AppStatus.SetMessage("Switching account...")
    m.authController.switchAccountRequest = { accountKey: account.accountKey, source: source }
end sub

'-------------------------------------------------------------------------------
' restoreAccountPickerFocus
'-------------------------------------------------------------------------------
sub restoreAccountPickerFocus(source as string)
    if source = "login" then
        m.login.callFunc("focusSavedAccountsButton")
    else
        m.header.callFunc("focusUserMenuButton")
    end if
end sub

'-------------------------------------------------------------------------------
' handleComponentError
'-------------------------------------------------------------------------------
function handleComponentError(response as dynamic, accountKey as string) as boolean
    if response = invalid then return false

    if response.authExpired = true then
        m.authController.expireActiveSessionRequested = {
            message: response.errorMessage
            accountKey: accountKey
        }
        return true
    end if

    return false
end function

'-------------------------------------------------------------------------------
' authAppendDynamicPage
'-------------------------------------------------------------------------------
sub authAppendDynamicPage(page as object)
    m.dynamicPageHost.appendChild(page)
    authObserveTaskOwner(page)
end sub

'-------------------------------------------------------------------------------
' authObserveTaskOwner
'-------------------------------------------------------------------------------
sub authObserveTaskOwner(node as object)
    if node.hasField("taskCreated") and node.hasField("__authTaskOwnerObserved") <> true then
        node.addField("__authTaskOwnerObserved", "boolean", false)
        node.__authTaskOwnerObserved = true
        node.observeField("taskCreated", "authHandleTaskCreated")
    end if

    authObserveTaskResponses(node)
end sub

'-------------------------------------------------------------------------------
' authHandleTaskCreated
'-------------------------------------------------------------------------------
sub authHandleTaskCreated(event as object)
    task = event.getData()
    if task = invalid then return

    authObserveTaskResponses(task)
end sub

'-------------------------------------------------------------------------------
' authObserveTaskResponses
'-------------------------------------------------------------------------------
sub authObserveTaskResponses(node as object)
    if node.isSubtype("Task") and node.hasField("response") then
        if node.hasField("__authResponseObserved") <> true then
            node.addField("__authResponseObserved", "boolean", false)
            node.__authResponseObserved = true
            node.observeField("response", "authHandleTaskResponse")
        end if
    end if

    for each child in node.getChildren(-1, 0)
        authObserveTaskResponses(child)
    end for
end sub

'-------------------------------------------------------------------------------
' authHandleTaskResponse
'-------------------------------------------------------------------------------
sub authHandleTaskResponse(event as object)
    response = event.getData()
    if response = invalid or response.authExpired <> true then return

    task = event.getRoSGNode()
    if task = invalid or task.hasField("request") <> true then return
    accountKey = authResolveRequestAccountKey(task.request)
    if accountKey = "" then return

    handleComponentError(response, accountKey)
end sub

'-------------------------------------------------------------------------------
' authResolveRequestAccountKey
'-------------------------------------------------------------------------------
function authResolveRequestAccountKey(request as dynamic) as string
    if request = invalid then return ""

    accountKey = Format.SafeString(request.accountKey, "")
    if accountKey <> "" then return accountKey
    if m.session = invalid then return ""

    requestToken = Format.SafeString(request.token, "")
    sessionToken = Format.SafeString(m.session.token, "")
    if requestToken = "" or requestToken <> sessionToken then return ""

    return Format.SafeString(m.session.accountKey, "")
end function

'-------------------------------------------------------------------------------
' authHandleLogoutPressed
'-------------------------------------------------------------------------------
sub authHandleLogoutPressed()
    themeAudioStop()
    resetDynamicPages()

    request = {
        server: ""
        token: ""
    }
    if m.session <> invalid then
        if m.session.server <> invalid then request.server = m.session.server
        if m.session.token <> invalid then request.token = m.session.token
        m.session.token = ""
    end if
    if m.authController <> invalid then m.authController.logoutRequest = request

    m.login.passwordValue = ""
end sub

'-------------------------------------------------------------------------------
' authHandleResetStarfinConfirmed
'-------------------------------------------------------------------------------
sub authHandleResetStarfinConfirmed()
    themeAudioStop()
    resetDynamicPages()
    if m.authController <> invalid then m.authController.resetStarfinRequested = true

    m.session = invalid
    m.login.serverValue = ""
    m.login.usernameValue = ""
    m.login.passwordValue = ""
    m.settings = SettingsStore.Load("")
end sub

' authHandleAuthenticatedSession
'-------------------------------------------------------------------------------
sub authHandleAuthenticatedSession()
    Spinner.HideBlocking()
    session = m.authController.authenticatedSession
    if session = invalid then return

    m.session = session
    AppStatus.ClearMessage()
    syncHeaderUserIdentity()
    navShowApp()
end sub

'-------------------------------------------------------------------------------
' authHandleLoginRequired
'-------------------------------------------------------------------------------
sub authHandleLoginRequired()
    Spinner.HideBlocking()
    request = m.authController.loginRequired
    if request = invalid then return

    authShowLogin(request.message)
    server = Format.SafeString(m.authController.savedSession.server, "")
    accounts = m.authController.callFunc("getAccountsForServer", server)
    if request.openSavedAccounts = true and accounts.Count() > 0 then openAccountPicker(accounts, "login")
end sub

'-------------------------------------------------------------------------------
' authHandleLoginFailed
'-------------------------------------------------------------------------------
sub authHandleLoginFailed()
    Spinner.HideBlocking()
    response = m.authController.loginFailed
    if response = invalid then return

    if m.authenticatedContent.visible = true then
        AppStatus.SetMessage(response.message)
        m.homePage.visible = true
        m.homePage.callFunc("activate")
    else
        m.login.statusMessage = response.message
        if Format.SafeString(response.source, "") = "login" then
            m.login.callFunc("focusSavedAccountsButton")
        else
            m.login.callFunc("focusLoginButton")
        end if
    end if
end sub

'-------------------------------------------------------------------------------
' authHandleSavedSessionChanged
'-------------------------------------------------------------------------------
sub authHandleSavedSessionChanged()
    authSyncSavedSessionToLogin()
end sub

'-------------------------------------------------------------------------------
' authHandleSessionExpired
'-------------------------------------------------------------------------------
sub authHandleSessionExpired()
    Spinner.HideBlocking()
    response = m.authController.sessionExpired
    if response = invalid then return

    if Format.SafeString(response.server, "") <> "" then m.login.serverValue = response.server
    if Format.SafeString(response.username, "") <> "" then m.login.usernameValue = response.username
    authHandleExpiredSession(response.message, response.clearRuntimeSession = true)
end sub

'-------------------------------------------------------------------------------
' buildSessionLoadRequest
'-------------------------------------------------------------------------------
function buildSessionLoadRequest() as object
    
    if m.session = invalid then THROW("[MainScene.buildSessionLoadRequest()] session is invalid.")
    if m.session.server = invalid then THROW("[MainScene.buildSessionLoadRequest()] session.server is invalid.")
    if m.session.token = invalid then THROW("[MainScene.buildSessionLoadRequest()] session.token is invalid.")
    
    return {
        server: m.session.server
        token: m.session.token
        userId: m.session.userId
        accountKey: m.session.accountKey
    }

end function
