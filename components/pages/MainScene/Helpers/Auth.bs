import "pkg:/source/AccountPicker.bs"
import "pkg:/source/String.bs"
import "pkg:/source/RequestFailure.bs"

'-------------------------------------------------------------------------------
' authSyncSavedSessionToLogin
'-------------------------------------------------------------------------------
sub authSyncSavedSessionToLogin()
    m.login.savedSession = m.authController.savedSession
end sub

'-------------------------------------------------------------------------------
' authRequestResumeSession
'-------------------------------------------------------------------------------
sub authRequestResumeSession()
    Spinner.ShowBlocking()
    m.login.visible = false
    m.authenticatedContent.visible = false
    m.authController.resumeRequested = true
end sub

'-------------------------------------------------------------------------------
' authHandleLoginRequested
'-------------------------------------------------------------------------------
sub authHandleLoginRequested()
    if m.startupAccount.busy then return
    if m.startupAccount.active then m.startupAccount.busy = true
    Spinner.ShowBlocking()
    m.authController.loginRequest = m.login.loginRequested
end sub

'-------------------------------------------------------------------------------
' authHandleQuickConnectRequested
'-------------------------------------------------------------------------------
sub authHandleQuickConnectRequested()
    request = m.login.quickConnectRequested
    if request = invalid then return
    m.authController.quickConnectRequest = request
end sub

'-------------------------------------------------------------------------------
' authHandleQuickConnectCancelled
'-------------------------------------------------------------------------------
sub authHandleQuickConnectCancelled()
    m.authController.quickConnectCancelRequested = true
end sub

'-------------------------------------------------------------------------------
' authHandleQuickConnectState
'-------------------------------------------------------------------------------
sub authHandleQuickConnectState()
    state = m.authController.quickConnectState
    if state = invalid then return
    m.login.quickConnectState = state
end sub

'-------------------------------------------------------------------------------
' authShowLogin
'-------------------------------------------------------------------------------
sub authShowLogin(message as string)
    if m.startupAccount.page <> invalid then m.startupAccount.page.visible = false
    m.login.statusMessage = message
    authRefreshLoginSavedAccounts()
    navShowLoginRoute()
end sub

'-------------------------------------------------------------------------------
' authRefreshLoginSavedAccounts
'-------------------------------------------------------------------------------
sub authRefreshLoginSavedAccounts()
    m.login.savedAccounts = m.authController.callFunc("getSignedInAccounts")
end sub

'-------------------------------------------------------------------------------
' authHandleExpiredSession
'-------------------------------------------------------------------------------
sub authHandleExpiredSession(message as string, clearRuntimeSession = true as boolean)
    if clearRuntimeSession and m.session <> invalid then m.session.token = ""
    m.login.passwordValue = ""
    authShowLogin(message)
end sub

'-------------------------------------------------------------------------------
' authHandleSwitchAccountPressed
'-------------------------------------------------------------------------------
sub authHandleSwitchAccountPressed()
    if m.session = invalid then return
    accounts = m.authController.callFunc("getSignedInAccounts")
    openAccountPicker(accounts, AccountPicker.Source.Header)
end sub

'-------------------------------------------------------------------------------
' authHandleLoginAccountPickerRequested
'-------------------------------------------------------------------------------
sub authHandleLoginAccountPickerRequested()
    request = m.login.accountPickerRequested
    if request = invalid then return
    openAccountPicker(request.accounts, AccountPicker.Source.Login)
end sub

'-------------------------------------------------------------------------------
' openAccountPicker
'-------------------------------------------------------------------------------
sub openAccountPicker(accounts as object, source as string, initialFocusAccountKey = "" as string)
    m.overlayHost.callFunc("openOverlay", {
        id: "accountPicker"
        initialFocusAccountKey: initialFocusAccountKey
        componentName: "AccountPickerDialog"
        openFunction: "openAccountPicker"
        closeField: "closeRequested"
        accounts: accounts
        source: source
    })
end sub

'-------------------------------------------------------------------------------
' authHandleAccountPickerClosed
'-------------------------------------------------------------------------------
sub authHandleAccountPickerClosed(closed as object)
    if m.accountSwitch.pending <> invalid then return
    request = closed.request
    source = AccountPicker.Source.Header
    if request <> invalid then source = Strings.ToString(request.source, source)
    overlay = closed.overlay
    if overlay = invalid then
        restoreAccountPickerFocus(source)
        return
    end if
    if source = AccountPicker.Source.Login and overlay.accountsUpdated = true then authRefreshLoginSavedAccounts()
    if overlay.signInSelected = true then
        server = m.login.serverValue
        if m.session <> invalid then server = Strings.ToString(m.session.server, server)
        m.login.serverValue = server
        m.login.usernameValue = ""
        m.login.passwordValue = ""
        authShowLogin("Sign in with another account.")
        return
    end if

    account = overlay.selectedAccount
    if account = invalid then
        restoreAccountPickerFocus(source)
        return
    end if
    isAuthenticatedActiveAccount = source = AccountPicker.Source.Header and m.authenticatedContent.visible = true and m.session <> invalid
    if isAuthenticatedActiveAccount then isAuthenticatedActiveAccount = Strings.ToString(m.session.token) <> ""
    if isAuthenticatedActiveAccount and Strings.ToString(account.accountKey) = Strings.ToString(m.session.accountKey) then
        restoreAccountPickerFocus(source)
        return
    end if

    if isAuthenticatedActiveAccount then m.deepLinkController.callFunc("cancel")
    if m.startupAccount.busy then return
    if m.startupAccount.active then m.startupAccount.busy = true
    Spinner.ShowBlocking()
    themeAudioStop()
    resetDynamicPages()
    m.accountSwitch.pending = { accountKey: account.accountKey, source: source }
    m.authController.switchAccountRequest = m.accountSwitch.pending
end sub

'-------------------------------------------------------------------------------
' restoreAccountPickerFocus
'-------------------------------------------------------------------------------
sub restoreAccountPickerFocus(source as string)
    if source = AccountPicker.Source.Login then
        m.login.callFunc("focusSavedAccountsButton")
    else
        m.header.callFunc("focusUserMenuButton")
    end if
end sub

'-------------------------------------------------------------------------------
' handleComponentError
'-------------------------------------------------------------------------------
function handleComponentError(response as dynamic, accountKey as string) as boolean
    if response = invalid then return false

    if response.authExpired = true then
        m.authController.expireActiveSessionRequested = {
            message: RequestFailure.GetDisplayMessage(response, "Your session has expired. Please sign in again.")
            accountKey: accountKey
        }
        return true
    end if

    return false
end function

'-------------------------------------------------------------------------------
' authAppendDynamicPage
'-------------------------------------------------------------------------------
sub authAppendDynamicPage(page as object)
    dismissMessage()
    m.dynamicPageHost.appendChild(page)
    authObserveTaskOwner(page)
end sub

'-------------------------------------------------------------------------------
' authObserveTaskOwner
'-------------------------------------------------------------------------------
sub authObserveTaskOwner(node as object)
    if node.hasField("taskCreated") and node.hasField("__authTaskOwnerObserved") <> true then
        node.addField("__authTaskOwnerObserved", "boolean", false)
        node.__authTaskOwnerObserved = true
        node.observeField("taskCreated", "authHandleTaskCreated")
    end if

    authObserveTaskResponses(node)
end sub

'-------------------------------------------------------------------------------
' authHandleTaskCreated
'-------------------------------------------------------------------------------
sub authHandleTaskCreated(event as object)
    task = event.getData()
    if task = invalid then return

    authObserveTaskResponses(task)
end sub

'-------------------------------------------------------------------------------
' authObserveTaskResponses
'-------------------------------------------------------------------------------
sub authObserveTaskResponses(node as object)
    if node.isSubtype("Task") and node.hasField("response") then
        if node.hasField("__authResponseObserved") <> true then
            node.addField("__authResponseObserved", "boolean", false)
            node.__authResponseObserved = true
            node.observeField("response", "authHandleTaskResponse")
        end if
    end if

    for each child in node.getChildren(-1, 0)
        authObserveTaskResponses(child)
    end for
end sub

'-------------------------------------------------------------------------------
' authHandleTaskResponse
'-------------------------------------------------------------------------------
sub authHandleTaskResponse(event as object)
    response = event.getData()
    if response = invalid or response.authExpired <> true then return

    task = event.getRoSGNode()
    if task = invalid or task.hasField("request") <> true then return
    accountKey = authResolveRequestAccountKey(task.request)
    if accountKey = "" then return

    handleComponentError(response, accountKey)
end sub

'-------------------------------------------------------------------------------
' authResolveRequestAccountKey
'-------------------------------------------------------------------------------
function authResolveRequestAccountKey(request as dynamic) as string
    if request = invalid then return ""

    accountKey = Strings.ToString(request.accountKey)
    if accountKey <> "" then return accountKey
    if m.session = invalid then return ""

    requestToken = Strings.ToString(request.token)
    sessionToken = Strings.ToString(m.session.token)
    if requestToken = "" or requestToken <> sessionToken then return ""

    return Strings.ToString(m.session.accountKey)
end function

'-------------------------------------------------------------------------------
' authHandleLogoutPressed
'-------------------------------------------------------------------------------
sub authHandleLogoutPressed()
    themeAudioStop()
    m.deepLinkController.callFunc("cancel")
    resetDynamicPages()

    request = {
        server: ""
        token: ""
    }
    if m.session <> invalid then
        if m.session.server <> invalid then request.server = m.session.server
        if m.session.token <> invalid then request.token = m.session.token
        m.session.token = ""
    end if
    if m.authController <> invalid then m.authController.logoutRequest = request

    m.login.passwordValue = ""
end sub

'-------------------------------------------------------------------------------
' authHandleResetStarfinConfirmed
'-------------------------------------------------------------------------------
sub authHandleResetStarfinConfirmed()
    themeAudioStop()
    m.deepLinkController.callFunc("cancel")
    resetDynamicPages()
    if m.authController <> invalid then m.authController.resetStarfinRequested = true

    m.session = invalid
    m.login.serverValue = ""
    m.login.usernameValue = ""
    m.login.passwordValue = ""
    m.settings = SettingsStore.Load("")
    syncTheme(m.settings)
    syncWatchedIndicatorStyle(m.settings)
    syncUnwatchedEpisodeCount(m.settings)
end sub

'-------------------------------------------------------------------------------
' authHandleAuthenticatedSession
'-------------------------------------------------------------------------------
sub authHandleAuthenticatedSession()
    Spinner.HideBlocking()
    session = m.authController.authenticatedSession
    if session = invalid then return

    m.accountSwitch.pending = invalid
    m.startupAccount.active = false
    m.startupAccount.busy = false
    if m.startupAccount.page <> invalid then
        m.startupAccountHost.removeChild(m.startupAccount.page)
        m.startupAccount.page = invalid
    end if
    m.session = session
    completePerformanceDialog()
    m.deepLinkController.callFunc("updateSession", buildSessionLoadRequest())
    AppMessage.Dismiss()
    syncHeaderUserIdentity()
    navShowApp()
end sub

'-------------------------------------------------------------------------------
' authHandleLoginRequired
'-------------------------------------------------------------------------------
sub authHandleLoginRequired()
    Spinner.HideBlocking()
    m.startupAccount.busy = false
    m.accountSwitch.pending = invalid
    request = m.authController.loginRequired
    if request = invalid then return

    beginPerformanceDialog()

    authShowLogin(request.message)
    accounts = m.authController.callFunc("getSignedInAccounts")
    if request.openSavedAccounts = true and accounts.Count() > 0 then openAccountPicker(accounts, AccountPicker.Source.Login)
end sub

'-------------------------------------------------------------------------------
' authHandleLoginFailed
'-------------------------------------------------------------------------------
sub authHandleLoginFailed()
    Spinner.HideBlocking()
    m.startupAccount.busy = false
    response = m.authController.loginFailed
    if response = invalid then return

    pending = m.accountSwitch.pending
    m.accountSwitch.pending = invalid
    if pending <> invalid and Strings.ToString(response.accountKey) = pending.accountKey then
        ' Outgoing dynamic pages were removed before authorization; keep a usable
        ' authenticated background if the restored picker is subsequently cancelled.
        if pending.source = AccountPicker.Source.Header then showHome()
        if pending.source = AccountPicker.Source.Login then authRefreshLoginSavedAccounts()
        openAccountPicker(m.authController.callFunc("getSignedInAccounts"), pending.source, pending.accountKey)
        AppMessage.Show(response.message)
        return
    end if
    if m.startupAccount.active and Strings.ToString(response.source) = AccountPicker.Source.Startup then
        authShowStartupPicker()
        AppMessage.Show(response.message)
        return
    end if
    if m.authenticatedContent.visible = true then
        m.homePage.visible = true
        m.homePage.callFunc("activate", true)
        AppMessage.Show(response.message)
    else
        if not m.login.visible then authShowLogin(response.message)
        m.login.statusMessage = response.message
        if Strings.ToString(response.source) = AccountPicker.Source.Login then
            m.login.callFunc("focusSavedAccountsButton")
        else
            m.login.callFunc("focusLoginButton")
        end if
    end if
end sub

'-------------------------------------------------------------------------------
' authHandleSavedSessionChanged
'-------------------------------------------------------------------------------
sub authHandleSavedSessionChanged()
    authSyncSavedSessionToLogin()
end sub

'-------------------------------------------------------------------------------
' authHandleSessionExpired
'-------------------------------------------------------------------------------
sub authHandleSessionExpired()
    Spinner.HideBlocking()
    m.startupAccount.busy = false
    m.accountSwitch.pending = invalid
    response = m.authController.sessionExpired
    if response = invalid then return

    beginPerformanceDialog()
    m.deepLinkController.callFunc("updateSession", invalid)

    if Strings.ToString(response.server) <> "" then m.login.serverValue = response.server
    if Strings.ToString(response.username) <> "" then m.login.usernameValue = response.username
    authHandleExpiredSession(response.message, response.clearRuntimeSession = true)
end sub

'-------------------------------------------------------------------------------
' buildSessionLoadRequest
'-------------------------------------------------------------------------------
function buildSessionLoadRequest() as object
    
    if m.session = invalid then THROW("[MainScene.buildSessionLoadRequest()] session is invalid.")
    if m.session.server = invalid then THROW("[MainScene.buildSessionLoadRequest()] session.server is invalid.")
    if m.session.token = invalid then THROW("[MainScene.buildSessionLoadRequest()] session.token is invalid.")
    
    return {
        server: m.session.server
        token: m.session.token
        userId: m.session.userId
        accountKey: m.session.accountKey
        permissions: m.session.permissions
        homePreferences: m.session.homePreferences
    }

end function

'-------------------------------------------------------------------------------
' authHandleLoginOverlayRequested
'-------------------------------------------------------------------------------
sub authHandleLoginOverlayRequested()
    request = m.login.overlayRequested
    if request = invalid or m.login.visible <> true then return
    m.overlayHost.callFunc("openOverlay", request)
end sub

'-------------------------------------------------------------------------------
' authHandleDiscoveryClosed
'-------------------------------------------------------------------------------
sub authHandleDiscoveryClosed(closed as object)
    if m.login.visible <> true then return
    server = invalid
    if closed.overlay <> invalid then server = closed.overlay.selectedServer
    m.login.callFunc("handleDiscoveryClosed", server)
end sub

'-------------------------------------------------------------------------------
' authStartApp
'-------------------------------------------------------------------------------
sub authStartApp()
    if SettingsStore.LoadGlobal(SettingsStore.Key.SelectAccountAtStartup) <> SettingsStore.Toggle.On then
        authRequestResumeSession()
        return
    end if
    accounts = m.authController.callFunc("getSignedInAccounts")
    if accounts.Count() > 1 then
        m.startupAccount.active = true
        authShowStartupPicker()
    else if accounts.Count() = 1 then
        m.login.serverValue = accounts[0].server
        m.login.usernameValue = accounts[0].username
        Spinner.ShowBlocking()
        m.authController.switchAccountRequest = { accountKey: accounts[0].accountKey, source: AccountPicker.Source.Login }
    else
        beginPerformanceDialog()
        authShowLogin("Enter your Jellyfin server and credentials to begin.")
    end if
end sub

'-------------------------------------------------------------------------------
' authShowStartupPicker
'-------------------------------------------------------------------------------
sub authShowStartupPicker()
    AppMessage.Dismiss()
    Spinner.HideBlocking()
    m.startupAccount.busy = false
    m.login.visible = false
    m.authenticatedContent.visible = false
    m.header.visible = false
    hideHome()
    beginPerformanceDialog()
    if m.startupAccount.page = invalid then
        m.log.write("Creating startup account picker")
        page = CreateObject("roSGNode", "AccountPickerPage")
        page.observeField("accountSelected", "authHandleStartupAccountSelected")
        page.observeField("signInSelected", "authHandleStartupSignInSelected")
        ' XML fixes this host above the background and below Login and overlays.
        m.startupAccountHost.appendChild(page)
        m.startupAccount.page = page
    end if
    m.startupAccount.page.accounts = m.authController.callFunc("getSignedInAccounts")
    m.startupAccount.page.visible = true
    m.startupAccount.page.callFunc("focusAccounts")
    m.log.write("Startup account picker ready accounts=" + m.startupAccount.page.accounts.Count().ToStr() + " focused=" + m.startupAccount.page.isInFocusChain().ToStr())
end sub

'-------------------------------------------------------------------------------
' authHandleStartupAccountSelected
'-------------------------------------------------------------------------------
sub authHandleStartupAccountSelected()
    if not m.startupAccount.active or m.startupAccount.busy then return
    if not m.startupAccount.page.visible then return
    account = m.startupAccount.page.accountSelected
    if account = invalid then return
    m.startupAccount.busy = true
    Spinner.ShowBlocking()
    m.authController.switchAccountRequest = { accountKey: account.accountKey, source: AccountPicker.Source.Startup }
end sub

'-------------------------------------------------------------------------------
' authHandleStartupSignInSelected
'-------------------------------------------------------------------------------
sub authHandleStartupSignInSelected()
    if not m.startupAccount.active or m.startupAccount.busy then return
    if not m.startupAccount.page.visible then return
    m.login.usernameValue = ""
    m.login.passwordValue = ""
    authShowLogin("Sign in with another account.")
end sub
