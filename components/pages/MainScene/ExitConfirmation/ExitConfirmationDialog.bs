'-------------------------------------------------------------------------------
' openConfirmation
'-------------------------------------------------------------------------------
sub openConfirmation()
    m.top.title = "Exit Starfin?"
    m.top.dialogWidth = 720
    m.top.dialogHeight = 380
    m.top.closeOnContentSelected = false
    m.top.contentComponentName = "ExitConfirmationContent"
    m.top.exitConfirmed = false
    content = m.top.callFunc("getContentComponent")
    content.observeField("decision", "onDecision")
    m.top.callFunc("openDialog")
end sub

'-------------------------------------------------------------------------------
' focusContent
'-------------------------------------------------------------------------------
function focusContent() as boolean
    content = m.top.callFunc("getContentComponent")
    content.callFunc("focusExit")
    return true
end function

'-------------------------------------------------------------------------------
' onDecision
'-------------------------------------------------------------------------------
sub onDecision()
    content = m.top.callFunc("getContentComponent")
    m.top.exitConfirmed = content.decision
    m.top.callFunc("closeDialog")
end sub
