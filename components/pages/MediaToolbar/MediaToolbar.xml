<?xml version="1.0" encoding="utf-8"?>
<component name="MediaToolbar" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/components/pages/MediaToolbar/MediaToolbar.brs" />
  <interface>
    <field id="focusExitDown" type="boolean" alwaysNotify="true" />
    <field id="playSelected" type="boolean" alwaysNotify="true" />
    <field id="isWatched" type="boolean" onChange="onWatchedStateChanged" />
    <function name="activate" />
  </interface>
  <children>
    <Group id="toolbarItems">
      <DynamicButton
        id="playButton"
        icon="pkg:/images/icons/media-toolbar/play-light.png"
        focusedIcon="pkg:/images/icons/media-toolbar/play-focused.png"
        text="Play"
        expandedWidth="145" />
      <DynamicButton
        id="markWatchedButton"
        icon="pkg:/images/icons/media-toolbar/mark-as-watched-light.png"
        focusedIcon="pkg:/images/icons/media-toolbar/mark-as-watched-focused.png"
        text="Mark as Watched"
        expandedWidth="315" />
      <DynamicButton
        id="markUnwatchedButton"
        icon="pkg:/images/icons/media-toolbar/mark-as-unwatched-light.png"
        focusedIcon="pkg:/images/icons/media-toolbar/mark-as-unwatched-focused.png"
        text="Mark as Unwatched"
        expandedWidth="345" />
      <DynamicButton
        id="moreButton"
        icon="pkg:/images/icons/media-toolbar/more-light.png"
        focusedIcon="pkg:/images/icons/media-toolbar/more-focused.png"
        text="More"
        expandedWidth="150" />
    </Group>
  </children>
</component>
