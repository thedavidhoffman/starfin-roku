<?xml version="1.0" encoding="utf-8"?>
<component name="MediaToolbar" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/components/pages/MediaToolbar/MediaToolbar.brs" />
  <interface>
    <field id="focusExitDown" type="boolean" alwaysNotify="true" />
    <field id="playSelected" type="boolean" alwaysNotify="true" />
    <field id="markAsWatchedSelected" type="boolean" alwaysNotify="true" />
    <field id="markAsUnwatchedSelected" type="boolean" alwaysNotify="true" />
    <field id="seriesSelected" type="boolean" alwaysNotify="true" />
    <field id="subtitlesSelected" type="boolean" alwaysNotify="true" />
    <field id="audioSelected" type="boolean" alwaysNotify="true" />
    <field id="videoSelected" type="boolean" alwaysNotify="true" />
    <field id="seasonSelected" type="boolean" alwaysNotify="true" />
    <field id="isWatched" type="boolean" onChange="onWatchedStateChanged" />
    <field id="supportsWatchedActions" type="boolean" value="true" onChange="onWatchedStateChanged" />
    <function name="activate" />
    <function name="deactivate" />
    <function name="resetFocus" />
    <function name="focusWatchedAction" />
  </interface>
  <children>
    <Group id="toolbarItems">
      <DynamicButton
        id="playButton"
        icon="pkg:/images/icons/media-toolbar/play-light.png"
        focusedIcon="pkg:/images/icons/media-toolbar/play-focused.png"
        text="Play"
        expandedWidth="145" />
      <DynamicButton
        id="markWatchedButton"
        icon="pkg:/images/icons/media-toolbar/mark-as-watched-light.png"
        focusedIcon="pkg:/images/icons/media-toolbar/mark-as-watched-focused.png"
        text="Mark as Watched"
        expandedWidth="315" />
      <DynamicButton
        id="markUnwatchedButton"
        icon="pkg:/images/icons/media-toolbar/mark-as-unwatched-light.png"
        focusedIcon="pkg:/images/icons/media-toolbar/mark-as-unwatched-focused.png"
        text="Mark as Unwatched"
        expandedWidth="345" />
      <DynamicButton
        id="subtitlesButton"
        icon="pkg:/images/icons/media-toolbar/subtitles-light.png"
        focusedIcon="pkg:/images/icons/media-toolbar/subtitles-focused.png"
        text="Subtitles"
        expandedWidth="207" />
      <DynamicButton
        id="audioButton"
        icon="pkg:/images/icons/media-toolbar/audio-light.png"
        focusedIcon="pkg:/images/icons/media-toolbar/audio-focused.png"
        text="Audio"
        expandedWidth="160" />
      <DynamicButton
        id="videoButton"
        icon="pkg:/images/icons/media-toolbar/video-light.png"
        focusedIcon="pkg:/images/icons/media-toolbar/video-focused.png"
        text="Video"
        expandedWidth="158" />
      <DynamicButton
        id="seriesButton"
        icon="pkg:/images/icons/media-toolbar/series-tv-light.png"
        focusedIcon="pkg:/images/icons/media-toolbar/series-tv-focused.png"
        text="Go to Series"
        expandedWidth="255" />
      <DynamicButton
        id="seasonButton"
        icon="pkg:/images/icons/media-toolbar/season-light.png"
        focusedIcon="pkg:/images/icons/media-toolbar/season-focused.png"
        text="Go to Season"
        expandedWidth="265" />
    </Group>
  </children>
</component>
