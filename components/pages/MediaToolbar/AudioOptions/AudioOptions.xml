<?xml version="1.0" encoding="utf-8"?>
<component name="AudioOptions" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/source/String.brs" />
  <script type="text/brightscript" uri="pkg:/source/Format.brs" />
  <script type="text/brightscript" uri="pkg:/source/Color.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/MediaToolbar/AudioOptions/AudioOptions.brs" />
  <interface>
    <field id="audioStreams" type="array" onChange="onAudioStreamsChanged" />
    <field id="selectedAudioStreamIndex" type="integer" value="-1" onChange="onSelectedAudioStreamIndexChanged" />
    <field id="selectedAudio" type="assocarray" alwaysNotify="true" />
    <field id="closeRequested" type="boolean" alwaysNotify="true" />
    <function name="openOptions" />
    <function name="closeOptions" />
  </interface>
  <children>
    <Dialog id="dialog" width="720" height="420" />

    <Label
      id="titleLabel"
      translation="[660,390]"
      text="Audio"
      width="600"
      height="48"
      color="0xF3F7FBFF"
      font="font:MediumBoldSystemFont" />

    <Label
      id="emptyLabel"
      translation="[660,470]"
      text="No audio tracks available."
      width="600"
      height="40"
      color="0xB9C7D6FF"
      font="font:SmallSystemFont" />

    <RadioButtonList
      id="audioList"
      translation="[660,462]"
      itemSize="[600,52]"
      numRows="6"
      checkedItem="0"
      vertFocusAnimationStyle="floatingFocus"
      fadeFocusFeedbackWhenAutoScrolling="false"
      focusFootprintBitmapUri="pkg:/images/focus/transparent_focus_footprint.9.png" />
  </children>
</component>
