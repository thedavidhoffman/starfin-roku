<?xml version="1.0" encoding="utf-8"?>
<component name="SubtitleOptionsContent" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/source/Format.brs" />
  <script type="text/brightscript" uri="pkg:/source/String.brs" />
  <script type="text/brightscript" uri="pkg:/source/Color.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/MediaToolbar/SubtitleOptions/SubtitleOptionsContent/SubtitleOptionsContent.brs" />
  <interface>
    <field id="subtitleStreams" type="array" onChange="onSubtitleStreamsChanged" />
    <field id="selectedSubtitleStreamIndex" type="integer" value="-2" onChange="onSelectedSubtitleStreamIndexChanged" />
    <field id="visibleRowCount" type="integer" value="1" onChange="onVisibleRowCountChanged" />
    <function name="focusOptions" />
    <function name="getSelectedSubtitle" />
  </interface>
  <children>
    <Label
      id="emptyLabel"
      translation="[0,-30]"
      text="No subtitles available."
      width="600"
      height="40"
      color="0xB9C7D6FF"
      font="font:SmallSystemFont" />

    <RadioButtonList
      id="subtitleList"
      translation="[0,-38]"
      itemSize="[600,52]"
      numRows="6"
      checkedItem="0"
      vertFocusAnimationStyle="floatingFocus"
      fadeFocusFeedbackWhenAutoScrolling="false"
      focusFootprintBitmapUri="pkg:/images/focus/transparent_focus_footprint.9.png" />
  </children>
</component>
