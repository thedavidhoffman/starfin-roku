<?xml version="1.0" encoding="utf-8"?>
<component name="DynamicButton" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/source/Format.brs" />
  <script type="text/brightscript" uri="pkg:/source/String.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/MediaToolbar/DynamicButton/DynamicButton.brs" />
  <interface>
    <field id="icon" type="string" onChange="onIconChanged" />
    <field id="focusedIcon" type="string" onChange="onIconChanged" />
    <field id="text" type="string" onChange="onTextChanged" />
    <field id="expandedWidth" type="integer" onChange="onFocusVisualChanged" />
    <field id="hasFocusVisual" type="boolean" onChange="onFocusVisualChanged" />
    <field id="buttonSelected" type="boolean" alwaysNotify="true" />
  </interface>
  <children>
    <Poster id="background" width="64" height="58" uri="pkg:/images/buttons/media-toolbar-button-unfocused.9.png" loadDisplayMode="scaleToFill" />
    <Poster id="iconPoster" translation="[16,13]" width="32" height="32" loadDisplayMode="scaleToFit" />
    <Label id="textLabel" translation="[60,18]" width="96" height="32" color="0x000B25FF" font="font:SmallerSystemFont" visible="false" />
  </children>
</component>
