'-------------------------------------------------------------------------------
' openConfirmation
'-------------------------------------------------------------------------------
sub openConfirmation()
    m.top.title = "Send Log to Jellyfin?"
    m.top.dialogWidth = 1100
    m.top.dialogHeight = 580
    m.top.closeOnContentSelected = false
    m.top.contentComponentName = "LogUploadConfirmationContent"
    m.top.sendConfirmed = false
    content = m.top.callFunc("getContentComponent")
    content.observeField("decision", "onDecision")
    m.top.callFunc("openDialog")
end sub

'-------------------------------------------------------------------------------
' focusContent
'-------------------------------------------------------------------------------
function focusContent() as boolean
    content = m.top.callFunc("getContentComponent")
    content.callFunc("focusCancel")
    return true
end function

'-------------------------------------------------------------------------------
' onDecision
'-------------------------------------------------------------------------------
sub onDecision()
    content = m.top.callFunc("getContentComponent")
    m.top.sendConfirmed = content.decision
    m.top.callFunc("closeDialog")
end sub
