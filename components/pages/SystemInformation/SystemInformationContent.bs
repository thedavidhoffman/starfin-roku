import "pkg:/source/String.bs"
import "pkg:/source/Char.bs"
import "pkg:/source/Encode.bs"
import "pkg:/source/Number.bs"
import "pkg:/source/Url.bs"
import "pkg:/source/Json.bs"
import "pkg:/source/Array.bs"
import "pkg:/source/store/RegistryStore.bs"
import "pkg:/source/store/AuthStore.bs"
import "pkg:/source/store/SettingsStore.bs"
import "pkg:/source/store/LibraryViewStateStore.bs"


'-------------------------------------------------------------------------------
' focusSystemInformation
'-------------------------------------------------------------------------------
sub focusSystemInformation()
    m.top.setFocus(true)
end sub

'-------------------------------------------------------------------------------
' updateSystemInformation
'-------------------------------------------------------------------------------
sub updateSystemInformation()
    sections = [getAppInfoSection(), getDeviceInfoSection(), getGlobalRegistrySection()]
    accounts = AuthStore.ListAllAccounts(true)
    for each account in accounts
        sections.Push(getAccountRegistrySection(account))
    end for
    m.top.sections = sections
end sub

'-------------------------------------------------------------------------------
' getAppInfoSection
'-------------------------------------------------------------------------------
function getAppInfoSection() as object
    appInfo = CreateObject("roAppInfo")
    return {
        title: "Application Information"
        entries: [
            { key: "title", value: appInfo.GetTitle() }
            { key: "version", value: appInfo.GetVersion() }
        ]
    }
end function

'-------------------------------------------------------------------------------
' getDeviceInfoSection
'-------------------------------------------------------------------------------
function getDeviceInfoSection() as object
    deviceInfo = CreateObject("roDeviceInfo")
    connectionInfo = deviceInfo.GetConnectionInfo()
    osVersion = deviceInfo.GetOSVersion()
    uiResolution = deviceInfo.GetUIResolution()
    return {
        title: "Roku Device Information"
        entries: [
            { key: "model", value: deviceInfo.GetModelDisplayName() + " " + deviceInfo.GetModel() }
            { key: "os version", value: osVersionText(osVersion) }
            { key: "ui resolution", value: uiResolutionText(uiResolution) }
            { key: "display mode", value: deviceInfo.GetDisplayMode() }
            { key: "connection info", value: connectionInfoText(connectionInfo) }
        ]
    }
end function

'-------------------------------------------------------------------------------
' connectionInfoText
'-------------------------------------------------------------------------------
function connectionInfoText(connectionInfo as dynamic) as string
    if connectionInfo = invalid or GetInterface(connectionInfo, "ifAssociativeArray") = invalid then return "(not set)"

    connectionType = Strings.ToString(connectionInfo.type)
    quality = LCase(Strings.ToString(connectionInfo.quality))
    ipAddress = Strings.ToString(connectionInfo.ip)
    text = connectionType
    if quality <> "" then
        if text = "" then
            text = quality + " quality"
        else
            text = text + " (" + quality + " quality)"
        end if
    end if
    if ipAddress <> "" then
        if text <> "" then text = text + " "
        text = text + ipAddress
    end if
    if text = "" then return "(not set)"
    return text
end function

'-------------------------------------------------------------------------------
' osVersionText
'-------------------------------------------------------------------------------
function osVersionText(osVersion as dynamic) as string
    if osVersion = invalid or GetInterface(osVersion, "ifAssociativeArray") = invalid then return "(not set)"
    text = Strings.ToString(osVersion.major)
    minor = Strings.ToString(osVersion.minor)
    revision = Strings.ToString(osVersion.revision)
    build = Strings.ToString(osVersion.build)
    if minor <> "" then text = text + "." + minor
    if revision <> "" then text = text + "." + revision
    if build <> "" then text = text + " build " + build
    if text = "" then return "(not set)"
    return text
end function

'-------------------------------------------------------------------------------
' uiResolutionText
'-------------------------------------------------------------------------------
function uiResolutionText(uiResolution as dynamic) as string
    if uiResolution = invalid or GetInterface(uiResolution, "ifAssociativeArray") = invalid then return "(not set)"
    name = Strings.ToString(uiResolution.name)
    width = Strings.ToString(uiResolution.width)
    height = Strings.ToString(uiResolution.height)
    dimensions = ""
    if width <> "" and height <> "" then dimensions = width + " x " + height
    if name <> "" and dimensions <> "" then return UCase(name) + " (" + dimensions + ")"
    if dimensions <> "" then return dimensions
    if name <> "" then return UCase(name)
    return "(not set)"
end function

'-------------------------------------------------------------------------------
' getGlobalRegistrySection
'-------------------------------------------------------------------------------
function getGlobalRegistrySection() as object
    settings = SettingsStore.Load("")
    entries = [
        { key: "active-account-key", value: AuthStore.GetActiveAccountKey() }
        { key: "last-server", value: AuthStore.GetLastServer() }
    ]
    for each key in SettingsStore.GlobalKeys()
        value = settings[key]
        if key = SettingsStore.Key.TmdbApiKey then value = truncateText(value, 40)
        entries.Push({ key: key, value: value })
    end for
    return {
        title: "Global Application Registry"
        entries: entries
    }
end function

'-------------------------------------------------------------------------------
' getAccountRegistrySection
'-------------------------------------------------------------------------------
function getAccountRegistrySection(account as object) as object
    settings = SettingsStore.Load(account.accountKey)
    title = "Account: " + account.username
    if account.isActive then title = title + " (active)"
    entries = [
        { key: "account-key", value: account.accountKey }
        { key: "server", value: account.server }
        { key: "username", value: account.username }
        { key: "userId", value: account.userId }
        { key: "primary-image-tag", value: account.primaryImageTag }
        { key: "token", value: truncateWithEllipsis(account.token, 10) }
    ]
    for each key in SettingsStore.AccountKeys()
        entries.Push({ key: key, value: SettingsStore.GetSettingValue(settings, key) })
    end for
    for each state in LibraryViewStateStore.List(account.accountKey)
        entries.Push(getLibraryViewStateEntry(state))
    end for
    return {
        title: title
        entries: entries
    }
end function

'-------------------------------------------------------------------------------
' getLibraryViewStateEntry
'-------------------------------------------------------------------------------
function getLibraryViewStateEntry(state as object) as object
    libraryId = Strings.ToString(state.libraryId)
    libraryTitle = Strings.ToString(state.libraryTitle)
    if libraryTitle = "" then libraryTitle = libraryId
    key = "library-view: " + libraryTitle
    if libraryId <> "" then key = key + Char.NewLine + "library id: " + libraryId

    optionKey = Strings.ToString(state.optionKey)
    value = "browse=" + optionKey
    collectionType = Strings.ToString(state.collectionType)
    if collectionType <> "" then value = collectionType + "; " + value
    detail = ""
    sortKey = Strings.ToString(state.sortKey)
    sortOrder = Strings.ToString(state.sortOrder)
    if sortKey <> "" then
        detail = "sort=" + sortKey
        if sortOrder <> "" then detail = detail + " " + sortOrder
    end if
    if optionKey = "Decade" then detail = detail + "; decade=" + Strings.ToString(state.selectedDecade)
    if optionKey = "Genre" then detail = detail + "; genre=" + Strings.ToString(state.selectedGenre)
    if Left(detail, 2) = "; " then detail = Mid(detail, 3)
    if detail <> "" then value = value + Char.NewLine + detail
    return { key: key, value: value }
end function

'-------------------------------------------------------------------------------
' truncateWithEllipsis
'-------------------------------------------------------------------------------
function truncateWithEllipsis(value as dynamic, maxLength as integer) as string
    text = formatValue(value)
    if Len(text) <= maxLength then return text
    return Left(text, maxLength) + "..."
end function

'-------------------------------------------------------------------------------
' truncateText
'-------------------------------------------------------------------------------
function truncateText(value as dynamic, maxLength as integer) as string
    text = formatValue(value)
    if Len(text) <= maxLength then return text
    return Left(text, maxLength)
end function
