'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.name = m.top.findNode("name")
    m.address = m.top.findNode("address")
    m.separator = m.top.findNode("separator")
    m.observedItem = invalid
end sub

'-------------------------------------------------------------------------------
' onFocusChanged
'-------------------------------------------------------------------------------
sub onFocusChanged()
    focused = m.top.focusPercent > 0.5
    if m.top.itemContent <> invalid and m.top.itemContent.hasField("listFocused") then focused = focused and m.top.itemContent.listFocused
    if focused then
        m.name.color = &h0F1A2AFF
        m.address.color = &h0F1A2AFF
    else
        m.name.color = &hF3F7FBFF
        m.address.color = &hC8D2DEFF
    end if
end sub

'-------------------------------------------------------------------------------
' onContentChanged
'-------------------------------------------------------------------------------
sub onContentChanged()
    if m.observedItem <> invalid then m.observedItem.unobserveFieldScoped("listFocused")
    item = m.top.itemContent
    m.observedItem = item
    if item = invalid then return
    if item.hasField("listFocused") then item.observeFieldScoped("listFocused", "onFocusChanged")
    m.name.text = item.title
    m.address.text = item.description
    isManual = item.hasField("manualEntry") and item.manualEntry
    m.address.visible = not isManual
    m.name.translation = [20, 8]
    if isManual then m.name.translation = [20, 28]
    m.separator.visible = item.hasField("showSeparator") and item.showSeparator
    onFocusChanged()
end sub
