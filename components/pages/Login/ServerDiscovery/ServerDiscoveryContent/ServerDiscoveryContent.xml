<?xml version="1.0" encoding="utf-8"?>
<component name="ServerDiscoveryContent" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/components/pages/Login/ServerDiscovery/ServerDiscoveryContent/ServerDiscoveryContent.bs" />
  <interface>
    <field id="keyboardActive" type="boolean" onChange="onListFocusChanged" />
    <field id="preferredHeight" type="integer" />
    <field id="manualEntryRequested" type="boolean" alwaysNotify="true" />
    <function name="focusManualEntry" />
    <field id="viewState" type="assocarray" onChange="onViewStateChanged" />
    <field id="serverSelected" type="assocarray" alwaysNotify="true" />
    <field id="searchRequested" type="boolean" alwaysNotify="true" />
    <field id="cancelRequested" type="boolean" alwaysNotify="true" />
  </interface>
  <children>
    <LabelPrimary id="status" width="980" numLines="0" maxLines="3" wrap="true" />
    <MarkupList id="servers" translation="[0,48]" itemComponentName="ServerDiscoveryItem"
      itemSize="[980,96]" itemSpacing="[0,8]" numRows="3" drawFocusFeedback="true"
      focusFootprintBitmapUri="pkg:/images/focus/transparent_focus_footprint.9.png"
      vertFocusAnimationStyle="floatingFocus" />
    <PrimaryButton id="search" translation="[0,490]" buttonWidth="300" text="Search Again" />
    <PrimaryButton id="cancel" translation="[680,490]" buttonWidth="300" text="Cancel" />
  </children>
</component>
