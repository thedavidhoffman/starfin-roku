import "pkg:/source/Remote.bs"
import "pkg:/source/Format.bs"
import "pkg:/source/String.bs"
import "pkg:/source/Url.bs"

namespace LoginFocus
    enum Target
        Server = "server"
        Username = "username"
        Password = "password"
        SignIn = "signin"
        QuickConnect = "quickconnect"
        SavedAccounts = "savedaccounts"
        QuickCancel = "quickcancel"
    end enum
end namespace

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    initReferences()
    m.keyboard = { node: invalid, target: "" }
    initHandlers()
    preloadSavedSession()
    syncFieldsFromState()
end sub

'-------------------------------------------------------------------------------
' initReferences
'-------------------------------------------------------------------------------
sub initReferences()
    m.serverInput = m.top.findNode("serverInput")
    m.usernameInput = m.top.findNode("usernameInput")
    m.passwordInput = m.top.findNode("passwordInput")
    m.loginButton = m.top.findNode("loginButton")
    m.quickConnectButton = m.top.findNode("quickConnectButton")
    m.savedAccountsButton = m.top.findNode("savedAccountsButton")
    m.loginStatus = m.top.findNode("loginStatus")
    m.loginForm = m.top.findNode("loginForm")
    m.quickConnectPanel = m.top.findNode("quickConnectPanel")
    m.quickConnectCode = m.top.findNode("quickConnectCode")
    m.quickConnectMessage = m.top.findNode("quickConnectMessage")
    m.quickConnectCancelButton = m.top.findNode("quickConnectCancelButton")

    m.loginFocus = {
        server: { node: m.serverInput, down: LoginFocus.Target.Username }
        username: { node: m.usernameInput, up: LoginFocus.Target.Server, down: LoginFocus.Target.Password, title: "Enter Username", valueField: "usernameValue" }
        password: { node: m.passwordInput, up: LoginFocus.Target.Username, down: LoginFocus.Target.SignIn, title: "Enter Password", valueField: "passwordValue" }
        signIn: { node: m.loginButton, up: LoginFocus.Target.Password, down: LoginFocus.Target.SavedAccounts, right: LoginFocus.Target.QuickConnect }
        quickConnect: { node: m.quickConnectButton, up: LoginFocus.Target.Password, down: LoginFocus.Target.SavedAccounts, left: LoginFocus.Target.SignIn }
        savedAccounts: { node: m.savedAccountsButton, up: LoginFocus.Target.SignIn }
        quickCancel: { node: m.quickConnectCancelButton }
    }
end sub

'-------------------------------------------------------------------------------
' initHandlers
'-------------------------------------------------------------------------------
sub initHandlers()
    m.top.observeField("visible", "onVisibilityChanged")
    m.loginButton.observeField("buttonSelected", "onLoginPressed")
    m.quickConnectButton.observeField("buttonSelected", "onQuickConnectPressed")
    m.savedAccountsButton.observeField("buttonSelected", "onSavedAccountsPressed")
    m.quickConnectCancelButton.observeField("buttonSelected", "onQuickConnectCancelled")
end sub

'-------------------------------------------------------------------------------
' onServerValueChanged
'-------------------------------------------------------------------------------
sub onServerValueChanged()
    syncFieldsFromState()
end sub

'-------------------------------------------------------------------------------
' onSavedAccountsChanged
'-------------------------------------------------------------------------------
sub onSavedAccountsChanged()
    updateSavedAccountsButton()
end sub

'-------------------------------------------------------------------------------
' onUsernameValueChanged
'-------------------------------------------------------------------------------
sub onUsernameValueChanged()
    syncFieldsFromState()
end sub

'-------------------------------------------------------------------------------
' onPasswordValueChanged
'-------------------------------------------------------------------------------
sub onPasswordValueChanged()
    syncFieldsFromState()
end sub

'-------------------------------------------------------------------------------
' onSavedSessionChanged
'-------------------------------------------------------------------------------
sub onSavedSessionChanged()
    preloadSavedSession()
end sub

'-------------------------------------------------------------------------------
' onStatusMessageChanged
'-------------------------------------------------------------------------------
sub onStatusMessageChanged()
    if m.loginStatus <> invalid then m.loginStatus.text = m.top.statusMessage
end sub

'-------------------------------------------------------------------------------
' onQuickConnectStateChanged
'-------------------------------------------------------------------------------
sub onQuickConnectStateChanged()
    state = m.top.quickConnectState
    phase = "idle"
    if state <> invalid then phase = Format.SafeString(state.phase, phase)
    isActive = phase <> "idle" and phase <> "failed"

    m.loginForm.visible = not isActive
    m.quickConnectPanel.visible = isActive
    if isActive then
        m.quickConnectCode.text = Format.SafeString(state.code, "")
        m.quickConnectMessage.text = Format.SafeString(state.message, "")
        focusQuickConnectCancel()
    else if phase = "failed" then
        m.quickConnectCancelButton.hasFocusVisual = false
        m.top.statusMessage = Format.SafeString(state.message, "Quick Connect failed.")
        focusLoginTarget(LoginFocus.Target.QuickConnect)
    else
        m.quickConnectCancelButton.hasFocusVisual = false
    end if
end sub

'-------------------------------------------------------------------------------
' onQuickConnectPressed
'-------------------------------------------------------------------------------
sub onQuickConnectPressed()
    server = Url.NormalizeServer(m.top.serverValue)
    if server = "" then
        m.top.statusMessage = "Server address is required for Quick Connect."
        focusLoginTarget(LoginFocus.Target.Server)
        return
    end if

    m.top.statusMessage = ""
    m.top.quickConnectRequested = { server: server }
end sub

'-------------------------------------------------------------------------------
' onQuickConnectCancelled
'-------------------------------------------------------------------------------
sub onQuickConnectCancelled()
    m.top.quickConnectCancelled = true
    m.top.quickConnectState = { phase: "idle", code: "", message: "" }
    focusLoginTarget(LoginFocus.Target.QuickConnect)
end sub

'-------------------------------------------------------------------------------
' focusQuickConnectCancel
'-------------------------------------------------------------------------------
sub focusQuickConnectCancel()
    focusLoginTarget(LoginFocus.Target.QuickCancel)
end sub

'-------------------------------------------------------------------------------
' activate
'-------------------------------------------------------------------------------
sub activate()
    syncFieldsFromState()
    updateSavedAccountsButton()
    focusLoginTarget(LoginFocus.Target.Server)
end sub

'-------------------------------------------------------------------------------
' focusSavedAccountsButton
'-------------------------------------------------------------------------------
function focusSavedAccountsButton() as boolean
    updateSavedAccountsButton()
    if m.savedAccountsButton.visible <> true then
        focusLoginTarget(LoginFocus.Target.Server)
        return false
    end if
    focusLoginTarget(LoginFocus.Target.SavedAccounts)
    return true
end function

'-------------------------------------------------------------------------------
' focusLoginButton
'-------------------------------------------------------------------------------
function focusLoginButton() as boolean
    focusLoginTarget(LoginFocus.Target.SignIn)
    return true
end function

'-------------------------------------------------------------------------------
' onSavedAccountsPressed
'-------------------------------------------------------------------------------
sub onSavedAccountsPressed()
    accounts = m.top.savedAccounts
    if accounts = invalid then accounts = []
    if accounts.Count() = 0 then return
    m.top.accountPickerRequested = { server: Url.NormalizeServer(m.top.serverValue), accounts: accounts }
end sub

'-------------------------------------------------------------------------------
' updateSavedAccountsButton
'-------------------------------------------------------------------------------
sub updateSavedAccountsButton()
    accounts = m.top.savedAccounts
    if accounts = invalid then accounts = []
    m.savedAccountsButton.visible = (accounts.Count() > 0)
end sub

'-------------------------------------------------------------------------------
' onLoginPressed
'-------------------------------------------------------------------------------
sub onLoginPressed()
    server = Url.NormalizeServer(m.top.serverValue)
    username = Strings.Trim(m.top.usernameValue)
    password = m.top.passwordValue

    if server = "" or username = "" then
        m.top.statusMessage = "Server address and username are required."
        return
    end if

    m.top.statusMessage = "Signing in..."
    m.top.loginRequested = {
        action: "login"
        server: server
        username: username
        password: password
    }
end sub

'-------------------------------------------------------------------------------
' preloadSavedSession
'-------------------------------------------------------------------------------
sub preloadSavedSession()
    savedSession = m.top.savedSession
    if savedSession = invalid then return

    if savedSession.server <> invalid and savedSession.server <> "" then
        m.top.serverValue = savedSession.server
    end if

    if savedSession.username <> invalid and savedSession.username <> "" then
        m.top.usernameValue = savedSession.username
    end if
end sub

'-------------------------------------------------------------------------------
' syncFieldsFromState
'-------------------------------------------------------------------------------
sub syncFieldsFromState()
    if m.serverInput <> invalid then m.serverInput.text = m.top.serverValue
    if m.usernameInput <> invalid then m.usernameInput.text = m.top.usernameValue
    if m.passwordInput <> invalid then
        passwordDisplay = ""
        if m.top.passwordValue <> invalid and m.top.passwordValue <> "" then
            passwordDisplay = RepeatString(Len(m.top.passwordValue), "*")
        end if
        m.passwordInput.text = passwordDisplay
    end if
    if m.loginStatus <> invalid then m.loginStatus.text = m.top.statusMessage
end sub

'-------------------------------------------------------------------------------
' RepeatString
'-------------------------------------------------------------------------------
function RepeatString(length as integer, character as string) as string
    result = ""
    for i = 1 to length
        result = result + character
    end for
    return result
end function

'-------------------------------------------------------------------------------
' openKeyboardDialog
'-------------------------------------------------------------------------------
sub openKeyboardDialog(target as string)
    entry = m.loginFocus[target]
    if entry = invalid or entry.valueField = invalid then return
    scene = m.top.getScene()
    if scene = invalid or not m.top.visible then return
    if scene.dialog <> invalid then return

    keyboard = CreateObject("roSGNode", "StandardKeyboardDialog")
    keyboard.title = entry.title
    keyboard.text = m.top[entry.valueField]
    keyboard.buttons = ["Save", "Cancel"]
    keyboard.observeField("buttonSelected", "onKeyboardDialogButtonSelected")
    keyboard.observeField("wasClosed", "onKeyboardDialogClosed")
    m.keyboard = { node: keyboard, target: target }
    scene.dialog = keyboard
end sub

'-------------------------------------------------------------------------------
' onKeyboardDialogButtonSelected
'-------------------------------------------------------------------------------
sub onKeyboardDialogButtonSelected(event as object)
    keyboard = m.keyboard.node
    if keyboard = invalid then return
    if not event.getRoSGNode().isSameNode(keyboard) then return
    target = m.keyboard.target
    if keyboard.buttonSelected = 0 then m.top[m.loginFocus[target].valueField] = keyboard.text
    closeOwnedLoginKeyboard()
    restoreKeyboardFocus(target)
end sub

'-------------------------------------------------------------------------------
' onKeyboardDialogClosed
'-------------------------------------------------------------------------------
sub onKeyboardDialogClosed(event as object)
    if m.keyboard.node = invalid then return
    if not event.getRoSGNode().isSameNode(m.keyboard.node) then return
    target = m.keyboard.target
    closeOwnedLoginKeyboard()
    restoreKeyboardFocus(target)
end sub

'-------------------------------------------------------------------------------
' closeOwnedLoginKeyboard
'-------------------------------------------------------------------------------
sub closeOwnedLoginKeyboard()
    keyboard = m.keyboard.node
    if keyboard = invalid then return
    m.keyboard = { node: invalid, target: "" }
    keyboard.unobserveField("buttonSelected")
    keyboard.unobserveField("wasClosed")
    scene = m.top.getScene()
    if scene <> invalid and scene.dialog <> invalid then
        if scene.dialog.isSameNode(keyboard) then scene.dialog = invalid
    end if
    keyboard.close = true
end sub

'-------------------------------------------------------------------------------
' restoreKeyboardFocus
'-------------------------------------------------------------------------------
sub restoreKeyboardFocus(target as string)
    if not m.top.visible then return
    scene = m.top.getScene()
    if scene <> invalid and scene.dialog <> invalid then return
    focusLoginTarget(target)
end sub

'-------------------------------------------------------------------------------
' onVisibilityChanged
'-------------------------------------------------------------------------------
sub onVisibilityChanged()
    if not m.top.visible then closeOwnedLoginKeyboard()
end sub

'-------------------------------------------------------------------------------
' focusLoginTarget
'-------------------------------------------------------------------------------
sub focusLoginTarget(target as string)
    entry = m.loginFocus[target]
    if entry = invalid then return
    if not entry.node.visible then return
    for each key in m.loginFocus
        m.loginFocus[key].node.hasFocusVisual = key = target
    end for
    entry.node.setFocus(true)
end sub

'-------------------------------------------------------------------------------
' getFocusedLoginTarget
'-------------------------------------------------------------------------------
function getFocusedLoginTarget() as string
    for each key in m.loginFocus
        if m.loginFocus[key].node.isInFocusChain() then return key
    end for
    return ""
end function

'-------------------------------------------------------------------------------
' handleLoginNavigation
'-------------------------------------------------------------------------------
function handleLoginNavigation(key as string) as boolean
    target = getFocusedLoginTarget()
    if target = "" then
        focusLoginTarget(LoginFocus.Target.Server)
        return true
    end if
    if key = Remote.Key.Up or key = Remote.Key.Down or key = Remote.Key.Left or key = Remote.Key.Right then
        nextTarget = m.loginFocus[target][key]
        if nextTarget <> invalid then focusLoginTarget(nextTarget)
        return true
    end if
    if key <> Remote.Key.OK and key <> Remote.Key.Select then return false
    if target = LoginFocus.Target.Server then
        onChooseServerPressed()
    else if target = LoginFocus.Target.Username or target = LoginFocus.Target.Password then
        openKeyboardDialog(target)
    else if target = LoginFocus.Target.SignIn then
        onLoginPressed()
    else if target = LoginFocus.Target.QuickConnect then
        onQuickConnectPressed()
    else if target = LoginFocus.Target.SavedAccounts then
        onSavedAccountsPressed()
    else
        return false
    end if
    return true
end function

'-------------------------------------------------------------------------------
' onKeyEvent
'-------------------------------------------------------------------------------
function onKeyEvent(key as string, press as boolean) as boolean
    if press = false then return false
    if m.quickConnectPanel.visible = true then
        if key = Remote.Key.Back then
            onQuickConnectCancelled()
            return true
        end if
        if key = Remote.Key.Up or key = Remote.Key.Down or key = Remote.Key.Left or key = Remote.Key.Right then
            focusQuickConnectCancel()
            return true
        end if
        return false
    end if
    return handleLoginNavigation(key)
end function

'-------------------------------------------------------------------------------
' onChooseServerPressed
'-------------------------------------------------------------------------------
sub onChooseServerPressed()
    m.top.overlayRequested = {
        id: "serverDiscovery"
        componentName: "ServerDiscoveryDialog"
        openFunction: "openDiscovery"
        closeField: "closeRequested"
        currentAddress: m.top.serverValue
    }
end sub

'-------------------------------------------------------------------------------
' handleDiscoveryClosed
'-------------------------------------------------------------------------------
sub handleDiscoveryClosed(server as dynamic)
    if server = invalid then
        focusLoginTarget(LoginFocus.Target.Server)
        return
    end if
    address = Url.NormalizeServer(server.address)
    if address <> Url.NormalizeServer(m.top.serverValue) then
        m.top.usernameValue = ""
        m.top.passwordValue = ""
    end if
    m.top.serverValue = address
    m.top.statusMessage = ""
    focusLoginTarget(LoginFocus.Target.Username)
end sub
