<?xml version="1.0" encoding="utf-8"?>
<component name="Login" extends="Group">
  <script type="text/brightscript" uri="pkg:/source/Format.bs" />
  <script type="text/brightscript" uri="pkg:/source/Encode.bs" />
  <script type="text/brightscript" uri="pkg:/source/String.bs" />
  <script type="text/brightscript" uri="pkg:/source/Url.bs" />
  <script type="text/brightscript" uri="pkg:/components/pages/Login/Login.bs" />
  <interface>
    <field id="serverValue" type="string" onChange="onServerValueChanged" />
    <field id="usernameValue" type="string" onChange="onUsernameValueChanged" />
    <field id="passwordValue" type="string" onChange="onPasswordValueChanged" />
    <field id="savedSession" type="assocarray" onChange="onSavedSessionChanged" />
    <field id="savedAccounts" type="array" onChange="onSavedAccountsChanged" />
    <field id="statusMessage" type="string" onChange="onStatusMessageChanged" />
    <field id="loginRequested" type="assocarray" alwaysNotify="true" />
    <field id="accountPickerRequested" type="assocarray" alwaysNotify="true" />
    <function name="activate" />
    <function name="focusSavedAccountsButton" />
    <function name="focusLoginButton" />
  </interface>
  <children>

    <Poster
      id="loginLogo"
      translation="[150,300]"
      uri="pkg:/images/logo-login-screen.png"
      width="650"
      height="150"
      loadDisplayMode="scaleToFit" />

    <!-- description -->
    <LabelPrimary
      id="loginBody"
      translation="[150,460]"
      width="650"
      numLines="5"
      wrap="true"
      text="Welcome to Starfin, a modern Roku client for Jellyfin. Enjoy a refined, intuitive way to browse, discover, and watch your media library." />

    <!-- status -->
    <Label 
      id="loginStatus" 
      translation="[150,700]"
      width="650" 
      numLines="4" 
      wrap="true" 
      color="0xF2C879FF" />

    <Group id="loginForm" translation="[1100,214]">

      <LabelHeading 
        translation="[0,0]" 
        text="Sign In" />
      
      <LabelPrimary 
        translation="[0,64]" 
        width="650" 
        numLines="2" 
        wrap="true" 
        text="To get started please enter your server url, username, and password." />

      <!-- server -->
      <TextInput 
        id="serverInput" 
        translation="[10,186]" 
        fieldWidth="680" 
        fieldHeight="84" 
        placeholder="Press OK to enter server" />

      <!-- username -->
      <TextInput 
        id="usernameInput" 
        translation="[10,334]" 
        fieldWidth="680" 
        fieldHeight="84" 
        placeholder="Press OK to enter username" />

      <!-- password -->
      <TextInput id="passwordInput" 
        translation="[10,482]" 
        fieldWidth="680" 
        fieldHeight="84" 
        placeholder="Press OK to enter password" />

      <!-- signin -->
      <PrimaryButton 
        id="loginButton" 
        translation="[0,615]" 
        buttonWidth="300" 
        buttonHeight="56" 
        text="Sign In" />
      <PrimaryButton
        id="savedAccountsButton"
        visible="false"
        translation="[350,615]"
        buttonWidth="350"
        buttonHeight="56"
        text="Saved Accounts" />
      
    </Group>
  </children>
</component>
