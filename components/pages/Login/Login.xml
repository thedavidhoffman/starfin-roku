<?xml version="1.0" encoding="utf-8"?>
<component name="Login" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/pages/Login/Login.bs" />
  <interface>
    <field id="serverValue" type="string" onChange="onServerValueChanged" />
    <field id="usernameValue" type="string" onChange="onUsernameValueChanged" />
    <field id="passwordValue" type="string" onChange="onPasswordValueChanged" />
    <field id="savedSession" type="assocarray" onChange="onSavedSessionChanged" />
    <field id="savedAccounts" type="array" onChange="onSavedAccountsChanged" />
    <field id="statusMessage" type="string" onChange="onStatusMessageChanged" />
    <field id="loginRequested" type="assocarray" alwaysNotify="true" />
    <field id="quickConnectRequested" type="assocarray" alwaysNotify="true" />
    <field id="quickConnectCancelled" type="boolean" alwaysNotify="true" />
    <field id="quickConnectState" type="assocarray" onChange="onQuickConnectStateChanged" />
    <field id="accountPickerRequested" type="assocarray" alwaysNotify="true" />
    <function name="activate" />
    <function name="focusSavedAccountsButton" />
    <function name="focusLoginButton" />
  </interface>
  <children>

    <Poster
      id="loginLogo"
      translation="[225,214]"
      uri="pkg:/images/logo-login-screen.png"
      width="650"
      height="150"
      loadDisplayMode="scaleToFit" />

    <!-- description -->
    <LabelPrimary
      id="loginBody"
      translation="[225,374]"
      width="650"
      numLines="5"
      wrap="true"
      text="Welcome to Starfin, a modern Roku client for Jellyfin. Enjoy a refined, intuitive way to browse, discover, and watch your media library." />

    <!-- status -->
    <Label 
      id="loginStatus" 
      translation="[225,614]"
      width="650" 
      numLines="4" 
      wrap="true" 
      color="0xF2C879FF" />

    <Group id="loginForm" translation="[995,214]">

      <LabelHeading 
        translation="[0,0]" 
        text="Sign In" />
      
      <LabelPrimary 
        translation="[0,64]" 
        width="650" 
        numLines="2" 
        wrap="true" 
        text="To get started please enter your server url, username, and password." />

      <!-- server -->
      <TextInput 
        id="serverInput" 
        translation="[10,186]" 
        fieldWidth="680" 
        fieldHeight="84" 
        placeholder="Press OK to enter server" />

      <!-- username -->
      <TextInput 
        id="usernameInput" 
        translation="[10,334]" 
        fieldWidth="680" 
        fieldHeight="84" 
        placeholder="Press OK to enter username" />

      <!-- password -->
      <TextInput id="passwordInput" 
        translation="[10,482]" 
        fieldWidth="680" 
        fieldHeight="84" 
        placeholder="Press OK to enter password" />

      <!-- signin -->
      <PrimaryButton 
        id="loginButton" 
        translation="[0,615]" 
        buttonWidth="340"
        buttonHeight="56" 
        text="Sign In" />
      <PrimaryButton
        id="quickConnectButton"
        translation="[360,615]"
        buttonWidth="340"
        buttonHeight="56"
        text="Quick Connect" />
      <PrimaryButton
        id="savedAccountsButton"
        visible="false"
        translation="[0,691]"
        buttonWidth="700"
        buttonHeight="56"
        text="Saved Accounts" />
      
    </Group>

    <Group id="quickConnectPanel" translation="[995,214]" visible="false">
      <LabelHeading text="Quick Connect" />
      <LabelPrimary translation="[0,80]" width="700" numLines="3" wrap="true" text="In a Jellyfin app where you are already signed in, open Quick Connect and approve this code:" />
      <LabelHeading id="quickConnectCode" translation="[0,250]" width="700" horizAlign="center" text="" />
      <LabelPrimary id="quickConnectMessage" translation="[0,350]" width="700" numLines="3" wrap="true" horizAlign="center" text="" />
      <PrimaryButton id="quickConnectCancelButton" translation="[200,510]" buttonWidth="300" buttonHeight="56" text="Cancel" />
    </Group>
  </children>
</component>
