<?xml version="1.0" encoding="utf-8"?>
<component name="Login" extends="Group">
  <script type="text/brightscript" uri="pkg:/source/Format.brs" />
  <script type="text/brightscript" uri="pkg:/source/String.brs" />
  <script type="text/brightscript" uri="pkg:/source/store/AuthStore.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/Login/Login.brs" />
  <interface>
    <field id="serverValue" type="string" onChange="onServerValueChanged" />
    <field id="usernameValue" type="string" onChange="onUsernameValueChanged" />
    <field id="passwordValue" type="string" onChange="onPasswordValueChanged" />
    <field id="savedSession" type="assocarray" onChange="onSavedSessionChanged" />
    <field id="statusMessage" type="string" onChange="onStatusMessageChanged" />
    <field id="loginRequested" type="assocarray" alwaysNotify="true" />
    <function name="activate" />
  </interface>
  <children>

    <!-- description -->
    <LabelPrimary
      id="loginBody"
      translation="[150,175]"
      width="650"
      numLines="5"
      wrap="true"
      text="Welcome to Starfish. The sign-in form includes placeholder credentials so you can select Sign In to complete the sample authentication flow and launch the app." />

    <!-- status -->
    <Label 
      id="loginStatus" 
      translation="[150,495]" 
      width="650" 
      numLines="4" 
      wrap="true" 
      color="0xF2C879FF" />

    <Group id="loginForm" translation="[1100,214]">

      <LabelHeading 
        translation="[0,0]" 
        text="Sign In" />
      
      <LabelPrimary 
        translation="[0,64]" 
        width="650" 
        numLines="2" 
        wrap="true" 
        text="To get started please enter your server url, username, and password." />

      <!-- server -->
      <TextInput 
        id="serverInput" 
        translation="[10,186]" 
        fieldWidth="680" 
        fieldHeight="84" 
        placeholder="Press OK to enter server" />

      <!-- username -->
      <TextInput 
        id="usernameInput" 
        translation="[10,334]" 
        fieldWidth="680" 
        fieldHeight="84" 
        placeholder="Press OK to enter username" />

      <!-- password -->
      <TextInput id="passwordInput" 
        translation="[10,482]" 
        fieldWidth="680" 
        fieldHeight="84" 
        placeholder="Press OK to enter password" />

      <!-- signin -->
      <PrimaryButton 
        id="loginButton" 
        translation="[0,615]" 
        buttonWidth="300" 
        buttonHeight="56" 
        text="Sign In" />
      
    </Group>
  </children>
</component>
