import "pkg:/source/TaskControl.bs"
import "pkg:/source/ApiPayload.bs"
import "pkg:/source/Format.bs"
import "pkg:/source/String.bs"
import "pkg:/source/Encode.bs"
import "pkg:/source/Url.bs"
import "pkg:/source/ItemImage.bs"
import "pkg:/source/LibraryLayoutSetting.bs"
import "pkg:/source/Status.bs"
import "pkg:/source/Spinner.bs"
import "pkg:/source/AsyncLifecycle.bs"
import "pkg:/source/PlaybackMode.bs"
import "pkg:/source/store/RegistryStore.bs"
import "pkg:/source/store/SettingsStore.bs"
import "pkg:/source/Array.bs"
import "pkg:/source/VideoCardGridLayout.bs"
import "pkg:/source/VideoCardPresentation.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.titleLabel = m.top.findNode("titleLabel")
    m.collectionsGrid = m.top.findNode("collectionsGrid")
    m.collectionsTask = m.top.findNode("collectionsTask")

    m.collectionsTask.observeField("response", "onCollectionsResponse")
    m.collectionsGrid.observeField("itemSelected", "onCollectionSelected")
    m.pageState = {
        request: invalid
        collections: []
        navigationStack: []
        pendingDrilldown: invalid
        imageAspect: VideoCardPresentation.Type.Poster
        layoutColumns: 6
        usingTopCollections: false
        lifecycle: AsyncLifecycle.Create()
    }
end sub

'-------------------------------------------------------------------------------
' onSettingsChanged
'-------------------------------------------------------------------------------
sub onSettingsChanged()
    m.pageState.imageAspect = getCollectionImageAspect()
    applyGridLayout(m.pageState.imageAspect)
    renderCollections(m.pageState.collections)
end sub

'-------------------------------------------------------------------------------
' onLoadRequestChanged
'-------------------------------------------------------------------------------
sub onLoadRequestChanged()
    request = m.top.loadRequest
    if request = invalid then return

    m.pageState.request = request
    AsyncLifecycle.Begin(m.pageState.lifecycle, request.libraryId)
    m.pageState.navigationStack = []
    m.pageState.pendingDrilldown = invalid
    m.pageState.usingTopCollections = false
    m.pageState.imageAspect = getCollectionImageAspect()
    m.titleLabel.text = getCollectionTitle(request.title)
    applyGridLayout(m.pageState.imageAspect)
    Spinner.Show(0)
    renderCollections([])

    m.collectionsTask.request = request
    m.collectionsTask.control = TaskControl.Command.Run
end sub

'-------------------------------------------------------------------------------
' onCollectionsResponse
'-------------------------------------------------------------------------------
sub onCollectionsResponse()
    response = m.collectionsTask.response
    if response = invalid then return
    if AsyncLifecycle.IsCurrentResponse(m.pageState.lifecycle, response, "libraryId", "collections") <> true then return

    if Format.SafeString(response.mode, "load") = "drilldown" then
        handleDrilldownResponse(response)
        return
    end if

    if response.ok <> true then
        Spinner.Hide()
        AppStatus.SetMessage(Format.SafeString(response.errorMessage, "Unable to load collections."))
        return
    end if

    rootCollections = getCollectionsFromPayload(response.payload)
    m.pageState.usingTopCollections = hasTopCollections(rootCollections)
    m.pageState.collections = filterRootCollections(rootCollections)
    renderCollections(m.pageState.collections)
    Spinner.Hide()
    AppStatus.ClearMessage()
    focusCollectionsIfActive()
end sub

'-------------------------------------------------------------------------------
' onCollectionSelected
'-------------------------------------------------------------------------------
sub onCollectionSelected()
    selected = m.collectionsGrid.itemSelected
    if selected = invalid then return
    if m.collectionsGrid.content = invalid then return

    node = m.collectionsGrid.content.getChild(selected)
    if node = invalid then return

    item = node.raw
    itemId = Format.SafeString(Format.FirstNonEmpty([item.Id], ""), "")
    if itemId = "" then return

    loadChildCollections(itemId, item)
end sub

'-------------------------------------------------------------------------------
' loadChildCollections
'-------------------------------------------------------------------------------
sub loadChildCollections(itemId as string, item as object)
    request = m.pageState.request
    if request = invalid then return

    title = Format.FirstNonEmpty([item.Name], "Collection")
    childRequest = {
        server: request.server
        token: request.token
        userId: request.userId
        libraryId: itemId
        title: title
        item: item
        mode: "drilldown"
        recursive: false
        includeItemTypes: ""
    }

    m.pageState.pendingDrilldown = {
        itemId: itemId
        item: item
        request: childRequest
    }
    AsyncLifecycle.Begin(m.pageState.lifecycle, itemId)
    Spinner.Show(0)
    AppStatus.ClearMessage()
    m.collectionsTask.control = TaskControl.Command.Stop
    m.collectionsTask.request = childRequest
    m.collectionsTask.control = TaskControl.Command.Run
end sub

'-------------------------------------------------------------------------------
' handleDrilldownResponse
'-------------------------------------------------------------------------------
sub handleDrilldownResponse(response as object)
    Spinner.Hide()

    pending = m.pageState.pendingDrilldown
    m.pageState.pendingDrilldown = invalid
    if pending = invalid then return

    if response.ok <> true then
        AppStatus.SetMessage(Format.SafeString(response.errorMessage, "Unable to load collection."))
        return
    end if

    collections = getCollectionsFromPayload(response.payload)
    if collections.Count() = 0 then
        AppStatus.ClearMessage()
        openSelectedCollection(pending.itemId, pending.item)
        return
    end if

    pushCollectionNavigationState()
    m.pageState.request = pending.request
    m.pageState.collections = collections
    m.pageState.usingTopCollections = false
    m.titleLabel.text = getCollectionTitle(pending.request.title)
    renderCollections(collections)
    AppStatus.ClearMessage()
    focusCollectionsIfActive()
end sub

'-------------------------------------------------------------------------------
' pushCollectionNavigationState
'-------------------------------------------------------------------------------
sub pushCollectionNavigationState()
    m.pageState.navigationStack.Push({
        request: m.pageState.request
        collections: m.pageState.collections
        title: Format.SafeString(m.titleLabel.text, "Collections")
        usingTopCollections: m.pageState.usingTopCollections
    })
end sub

'-------------------------------------------------------------------------------
' navigateBackToParentCollection
'-------------------------------------------------------------------------------
function navigateBackToParentCollection() as boolean
    if m.pageState.navigationStack = invalid then return false
    if m.pageState.navigationStack.Count() = 0 then return false

    lastIndex = m.pageState.navigationStack.Count() - 1
    previous = m.pageState.navigationStack[lastIndex]
    m.pageState.navigationStack.Delete(lastIndex)

    m.pageState.pendingDrilldown = invalid
    m.collectionsTask.control = TaskControl.Command.Stop
    m.pageState.request = previous.request
    m.pageState.usingTopCollections = previous.usingTopCollections
    AsyncLifecycle.Begin(m.pageState.lifecycle, previous.request.libraryId)
    m.pageState.collections = previous.collections
    m.titleLabel.text = Format.SafeString(previous.title, "Collections")
    renderCollections(m.pageState.collections)
    AppStatus.ClearMessage()
    focusCollectionsIfActive()
    return true
end function

'-------------------------------------------------------------------------------
' openSelectedCollection
'-------------------------------------------------------------------------------
sub openSelectedCollection(itemId as string, item as object)
    m.top.selectedCollection = {
        itemId: itemId
        item: item
    }
end sub

'-------------------------------------------------------------------------------
' renderCollections
'-------------------------------------------------------------------------------
sub renderCollections(collections as object)
    content = CreateObject("roSGNode", "ContentNode")
    imageAspect = m.pageState.imageAspect

    for each item in collections
        if Arrays.IsAssocArray(item) = false then continue for

        child = content.createChild("ContentNode")
        child.HDPosterUrl = getItemImageUrl(item, imageAspect)
        child.AddFields({
            imageAspect: imageAspect
            cardLayout: VideoCardGridLayout.GetSpec(imageAspect, "cards", m.pageState.layoutColumns)
            showMetadata: false
            raw: item
        })
    end for

    m.collectionsGrid.content = content
    m.collectionsGrid.visible = content.getChildCount() > 0
    applyGridTranslation(imageAspect, content.getChildCount())
end sub

'-------------------------------------------------------------------------------
' activate
'-------------------------------------------------------------------------------
sub activate()
    AsyncLifecycle.BeginFromField(m.pageState.lifecycle, m.pageState.request, "libraryId")
    m.top.setFocus(true)
    focusCollectionsIfActive()
end sub

'-------------------------------------------------------------------------------
' deactivate
'-------------------------------------------------------------------------------
sub deactivate()
    AsyncLifecycle.Deactivate(m.pageState.lifecycle)
    m.pageState.pendingDrilldown = invalid
    m.collectionsTask.control = TaskControl.Command.Stop
end sub

'-------------------------------------------------------------------------------
' focusCollectionsIfActive
'-------------------------------------------------------------------------------
sub focusCollectionsIfActive()
    if m.collectionsGrid.visible <> true then return
    if m.collectionsGrid.content = invalid then return
    if m.collectionsGrid.content.getChildCount() = 0 then return

    m.collectionsGrid.setFocus(true)
end sub

'-------------------------------------------------------------------------------
' getItemImageUrl
'-------------------------------------------------------------------------------
function getItemImageUrl(item as dynamic, imageAspect as string) as string
    if Arrays.IsAssocArray(item) = false then return ""

    request = m.pageState.request
    if request = invalid then return ""

    layoutSpec = VideoCardGridLayout.GetSpec(imageAspect, "cards", m.pageState.layoutColumns)
    artworkWidth = Number.ToInteger(layoutSpec.artworkSize[0], 0)
    artworkHeight = Number.ToInteger(layoutSpec.artworkSize[1], 0)

    if imageAspect = VideoCardPresentation.Type.Thumbnail then
        return ItemImage.GetThumbnailUrl(request.server, item, artworkWidth, artworkHeight)
    end if
    return ItemImage.GetUrl(request.server, item, "Primary", artworkWidth, artworkHeight)
end function

'-------------------------------------------------------------------------------
' getCollectionImageAspect
'-------------------------------------------------------------------------------
function getCollectionImageAspect() as string
    layout = LibraryLayoutSetting.Parse(m.top.settings[SettingsStore.Key.CollectionCardsLayout])
    m.pageState.layoutColumns = layout.columns
    return layout.presentation
end function

'-------------------------------------------------------------------------------
' applyGridLayout
'-------------------------------------------------------------------------------
sub applyGridLayout(imageAspect as string)
    layoutSpec = VideoCardGridLayout.GetSpec(imageAspect, "cards", m.pageState.layoutColumns)
    m.collectionsGrid.translation = layoutSpec.translation
    m.collectionsGrid.itemSize = layoutSpec.itemSize
    m.collectionsGrid.itemSpacing = layoutSpec.itemSpacing
    m.collectionsGrid.numColumns = layoutSpec.numColumns
    m.collectionsGrid.numRows = layoutSpec.numRows
    m.collectionsGrid.focusBitmapUri = layoutSpec.focusBitmapUri
end sub

'-------------------------------------------------------------------------------
' applyGridTranslation
'-------------------------------------------------------------------------------
sub applyGridTranslation(imageAspect as string, itemCount as integer)
    layoutSpec = VideoCardGridLayout.GetSpec(imageAspect, "cards", m.pageState.layoutColumns)
    m.collectionsGrid.translation = layoutSpec.translation
    if m.pageState.usingTopCollections = true and itemCount = 2 then m.collectionsGrid.translation = [getCenteredTwoItemGridX(layoutSpec), layoutSpec.translation[1]]
end sub

'-------------------------------------------------------------------------------
' getCenteredTwoItemGridX
'-------------------------------------------------------------------------------
function getCenteredTwoItemGridX(layoutSpec as object) as integer
    stride = Number.ToInteger(layoutSpec.itemSize[0], 0) + Number.ToInteger(layoutSpec.itemSpacing[0], 0)
    visibleWidth = Number.ToInteger(layoutSpec.visibleArtworkWidth, 0) + Number.ToInteger(layoutSpec.visibleRightAdjustment, 0)
    visibleSpan = stride + visibleWidth
    centeredVisibleLeft = Number.ToInteger((1920 - visibleSpan) / 2, 0)
    return centeredVisibleLeft - Number.ToInteger(layoutSpec.visibleArtworkOffsetX, 0)
end function

'-------------------------------------------------------------------------------
' getCollectionTitle
'-------------------------------------------------------------------------------
function getCollectionTitle(value as dynamic) as string
    title = Format.SafeString(value, "Collections")
    if Instr(1, LCase(title), "collection") = 0 then return "Collections: " + title
    return title
end function

' getCollectionsFromPayload
'-------------------------------------------------------------------------------
function getCollectionsFromPayload(payload as dynamic) as object
    return filterCollectionItems(ApiPayload.GetItems(payload))
end function

'-------------------------------------------------------------------------------
' filterCollectionItems
'-------------------------------------------------------------------------------
function filterCollectionItems(items as object) as object
    collections = []
    for each item in items
        if isCollectionItem(item) then collections.Push(item)
    end for

    return collections
end function

'-------------------------------------------------------------------------------
' filterRootCollections
'-------------------------------------------------------------------------------
function filterRootCollections(collections as object) as object
    topCollections = []
    for each item in collections
        if hasTopTag(item) then topCollections.Push(item)
    end for

    if topCollections.Count() > 0 then return topCollections
    return collections
end function

'-------------------------------------------------------------------------------
' hasTopCollections
'-------------------------------------------------------------------------------
function hasTopCollections(collections as object) as boolean
    for each item in collections
        if hasTopTag(item) then return true
    end for

    return false
end function

'-------------------------------------------------------------------------------
' hasTopTag
'-------------------------------------------------------------------------------
function hasTopTag(item as dynamic) as boolean
    if Arrays.IsAssocArray(item) = false then return false
    if item.Tags = invalid then return false
    if Type(item.Tags) <> "roArray" then return false

    for each tag in item.Tags
        if LCase(Format.SafeString(tag, "")) = "top" then return true
    end for

    return false
end function

'-------------------------------------------------------------------------------
' isCollectionItem
'-------------------------------------------------------------------------------
function isCollectionItem(item as dynamic) as boolean
    if Arrays.IsAssocArray(item) = false then return false

    return LCase(Format.SafeString(item.Type, "")) = "boxset"
end function

'-------------------------------------------------------------------------------
' onKeyEvent
'-------------------------------------------------------------------------------
function onKeyEvent(key as string, press as boolean) as boolean
    if press = false then return false

    if key = "up" and isCollectionsGridAtFirstRow() then
        m.top.focusExitUp = true
        return true
    end if

    if key = "back" then
        if navigateBackToParentCollection() then return true

        m.top.closeRequested = true
        return true
    end if
    return false
end function

'-------------------------------------------------------------------------------
' isCollectionsGridAtFirstRow
'-------------------------------------------------------------------------------
function isCollectionsGridAtFirstRow() as boolean
    if m.collectionsGrid.isInFocusChain() <> true then return false

    focusedIndex = m.collectionsGrid.itemFocused
    if focusedIndex = invalid then return true

    return focusedIndex < m.collectionsGrid.numColumns
end function
