import "pkg:/source/MaskAssets.bs"
import "pkg:/source/ResolutionProfile.bs"
import "pkg:/source/ResolutionAssets.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.nodes = { mask: m.top.findNode("imageMask"), image: m.top.findNode("image"), title: m.top.findNode("title"), duration: m.top.findNode("duration") }
    MaskAssets.Apply(m.nodes.mask, "movie-extra-mask.png", [320, 180], [213, 120])
    m.top.observeField("itemContent", "renderItem")
    m.top.observeField("itemHasFocus", "updateTitleScrolling")
    renderItem()
    updateTitleScrolling()
end sub

'-------------------------------------------------------------------------------
' renderItem
'-------------------------------------------------------------------------------
sub renderItem()
    item = m.top.itemContent
    if item = invalid then return
    m.nodes.image.uri = item.HDPosterUrl
    m.nodes.title.text = item.title
    m.nodes.duration.text = item.description
end sub

'-------------------------------------------------------------------------------
' updateTitleScrolling
'-------------------------------------------------------------------------------
sub updateTitleScrolling()
    m.nodes.title.repeatCount = (m.top.itemHasFocus ? -1 : 0)
end sub
