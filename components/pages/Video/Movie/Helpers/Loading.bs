import "pkg:/source/Format.bs"
import "pkg:/source/String.bs"
import "pkg:/source/RequestFailure.bs"

'-------------------------------------------------------------------------------
' onLoadRequestChanged
'-------------------------------------------------------------------------------
sub onLoadRequestChanged()
    m.state.watched.pending = invalid
    m.state.mediaOptions.session = invalid
    request = m.top.loadRequest
    if request = invalid then return

    m.state.mediaInfoPending = true
    m.state.movieVersions = invalid
    refreshMediaInfoText(invalid)
    m.state.request = request
    m.state.layout.isFromLibrary = request.sourcePage = "library" and request.libraryBrowseState <> invalid
    m.top.settings = request.settings
    applyMediaShellBackgroundSetting(request.settings)
    applyLibraryBrowseState(request.libraryBrowseState)
    m.state.item = request.item
    m.state.themeLookupActive = false
    AsyncLifecycle.Begin(m.state.lifecycle, request.itemId)
    m.state.selectedStreams = {
        audio: invalid
        subtitle: invalid
        subtitleOff: false
    }
    applyPlaybackVideoMode(request.videoMode)
    m.cast.server = request.server
    Spinner.Show()
    renderMovie(request.item, true)
    LatestRequestLifecycle.Queue(m.state.detailsLoad, request)
    startPendingMovieLoad()
end sub

'-------------------------------------------------------------------------------
' startPendingMovieLoad
'-------------------------------------------------------------------------------
sub startPendingMovieLoad()
    entry = LatestRequestLifecycle.TakeNext(m.state.detailsLoad)
    if entry = invalid then return

    task = takeNextMovieDetailsTask()
    task.request = entry.request
    task.control = TaskControl.Command.Run
end sub

'-------------------------------------------------------------------------------
' takeNextMovieDetailsTask
'-------------------------------------------------------------------------------
function takeNextMovieDetailsTask() as object
    task = m.state.detailsTaskPool.nodes[m.state.detailsTaskPool.nextIndex]
    m.state.detailsTaskPool.nextIndex = (m.state.detailsTaskPool.nextIndex + 1) mod m.state.detailsTaskPool.nodes.Count()
    return task
end function

'-------------------------------------------------------------------------------
' onMovieResponse
'-------------------------------------------------------------------------------
sub onMovieResponse()
    handleMovieResponse(m.movieTask)
end sub

'-------------------------------------------------------------------------------
' onAlternateMovieResponse
'-------------------------------------------------------------------------------
sub onAlternateMovieResponse()
    handleMovieResponse(m.movieTaskAlternate)
end sub

'-------------------------------------------------------------------------------
' handleMovieResponse
'-------------------------------------------------------------------------------
sub handleMovieResponse(task as dynamic)
    if task = invalid then return

    response = task.response
    if response = invalid then return

    completion = LatestRequestLifecycle.Complete(m.state.detailsLoad, response, "movie")
    if completion.matched <> true then return
    if completion.isCurrent <> true then
        startPendingMovieLoad()
        return
    end if

    if response.ok <> true then
        m.state.mediaInfoPending = false
        renderMovie(m.state.item, false)
        Spinner.Hide()
        message = (response.failureKind <> invalid ? "Unable to load this movie. " : "") + RequestFailure.GetDisplayMessage(response, "Unable to load this movie.")
        AppMessage.Show(message)
        m.log.activity("Movie load failed: " + Strings.ToString(response.errorMessage, message))
        return
    end if

    if completion.context <> invalid then
        sourceId = completion.context.sourceId
        if response.payload = invalid or Strings.ToString(response.payload.Id) <> sourceId then
            m.state.mediaInfoPending = false
            renderMovie(m.state.item, false)
            Spinner.Hide()
            AppMessage.Show("Unable to load this movie version.")
            return
        end if
        m.state.movieVersions = MovieVersions.CacheDetails(m.state.movieVersions, sourceId, response.payload)
    else
        m.state.movieVersions = MovieVersions.Create(response.payload)
    end if
    m.state.item = response.payload
    if m.state.movieVersions <> invalid then
        item = MovieVersions.GetSelectedItem(m.state.movieVersions)
        if item = invalid then
            sourceId = m.state.movieVersions.selectedSourceId
            versionRequest = { server: m.state.request.server, token: m.state.request.token, userId: m.state.request.userId, itemId: sourceId }
            LatestRequestLifecycle.Queue(m.state.detailsLoad, versionRequest, { sourceId: sourceId })
            startPendingMovieLoad()
            return
        end if
        m.state.item = item
    end if
    m.state.mediaInfoPending = false
    renderMovie(m.state.item, false)
    m.log.activity("Viewing movie " + ActivityLog.ItemTitle(response.payload, "movie"))
    Spinner.Hide()
    loadThemeSong(m.state.item)
end sub

'-------------------------------------------------------------------------------
' loadThemeSong
'-------------------------------------------------------------------------------
sub loadThemeSong(item as dynamic)
    request = m.state.request
    if request = invalid then return
    if SettingsStore.IsThemeMusicEnabled(m.top.settings) <> true then
        m.log.write("Theme music playback is disabled")
        return
    end if

    m.log.write("Theme music playback is enabled")

    itemId = Format.FirstNonEmpty([item.Id, request.itemId], "")
    if itemId = "" then return

    m.state.themeLookupActive = true
    m.themeSongsTask.control = TaskControl.Command.Stop
    m.themeSongsTask.request = {
        server: request.server
        token: request.token
        userId: request.userId
        itemId: itemId
    }
    m.themeSongsTask.control = TaskControl.Command.Run
end sub

'-------------------------------------------------------------------------------
' onThemeSongsResponse
'-------------------------------------------------------------------------------
sub onThemeSongsResponse()
    response = m.themeSongsTask.response
    if response = invalid then return
    if m.state.lifecycle.isActive <> true then return
    if m.state.themeLookupActive <> true then return
    if response.ok <> true then
        m.log.write("Theme song lookup failed: " + Strings.ToString(response.errorMessage, "Unknown error."))
        return
    end if

    themeSong = response.payload
    if Arrays.IsAssocArray(themeSong) = false then
        m.state.themeLookupActive = false
        m.log.write("Theme music enabled, but no theme song was found")
        return
    end if

    request = m.state.request
    if request = invalid then return
    if Strings.ToString(response.itemId) <> Strings.ToString(request.itemId) then return

    m.state.themeLookupActive = false
    themeSongId = Strings.ToString(themeSong.Id)
    if themeSongId = "" then
        m.state.themeLookupActive = false
        return
    end if

    m.log.write("Theme song found itemId=" + themeSongId)
    m.top.themeRequested = {
        server: request.server
        token: request.token
        userId: request.userId
        itemId: themeSongId
        title: Format.FirstNonEmpty([themeSong.Name, m.state.item.Name], "Theme Music")
        sourceItemId: Strings.ToString(request.itemId)
    }
end sub
