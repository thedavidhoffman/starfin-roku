import "pkg:/source/MaskAssets.bs"
import "pkg:/source/ResolutionProfile.bs"
import "pkg:/source/ResolutionAssets.bs"
'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    initReferences()
    m.nodes.title.font.size = 28
    MaskAssets.Apply(m.nodes.thumbnailMask, "thumbnail-4-col-mask.png", [320, 180], [320 * 2 / 3, 120])
end sub

'-------------------------------------------------------------------------------
' initReferences
'-------------------------------------------------------------------------------
sub initReferences()
    m.nodes = { thumbnailMask: m.top.findNode("thumbnailMask"), thumbnail: m.top.findNode("thumbnail"), title: m.top.findNode("title"), highlight: m.top.findNode("highlight") }
end sub

'-------------------------------------------------------------------------------
' render
'-------------------------------------------------------------------------------
sub render(item as object, selected as boolean)
    m.nodes.title.text = item.title
    m.nodes.thumbnail.uri = item.thumbnail
    if item.thumbnail = "" then m.nodes.thumbnail.uri = "pkg:/images/media-card/thumbnail-placeholder-441x249.png"
    m.nodes.highlight.visible = selected
end sub
