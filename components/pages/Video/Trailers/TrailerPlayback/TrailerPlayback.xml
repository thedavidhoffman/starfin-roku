<?xml version="1.0" encoding="utf-8"?>
<component name="TrailerPlayback" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/components/pages/Video/Trailers/TrailerPlayback/TrailerPlayback.bs" />
  <interface>
    <field id="ended" type="assocarray" alwaysNotify="true" />
    <function name="playStream" />
    <function name="stopPlayback" />
  </interface>
  <children>
    <Rectangle width="1920" height="1080" color="0x000000FF" />
    <Video id="video" width="1920" height="1080" enableUI="false" enableTrickPlay="false" />
    <Spinner id="loading" showDelay="0" />
    <Timer id="timeout" duration="20" repeat="false" />
  </children>
</component>
