import "pkg:/source/Format.bs"
import "pkg:/source/String.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.presentationState = { node: invalid, componentName: "" }
    replacePresentation("VideoPosterCard")
end sub

'-------------------------------------------------------------------------------
' onItemContentChanged
'-------------------------------------------------------------------------------
sub onItemContentChanged()
    item = m.top.itemContent
    if item = invalid then return

    componentName = getPresentationComponentName(Format.SafeString(item.imageAspect, "poster"))
    if componentName <> m.presentationState.componentName then replacePresentation(componentName)

    m.presentationState.node.itemContent = invalid
    m.presentationState.node.itemContent = item
end sub

'-------------------------------------------------------------------------------
' getPresentationComponentName
'-------------------------------------------------------------------------------
function getPresentationComponentName(imageAspect as string) as string
    if imageAspect = "thumbnail" then return "VideoThumbnailCard"
    if imageAspect = "jumbo" then return "VideoJumboCard"
    if imageAspect = "detailed" then return "VideoDetailedCard"
    return "VideoPosterCard"
end function

'-------------------------------------------------------------------------------
' replacePresentation
'-------------------------------------------------------------------------------
sub replacePresentation(componentName as string)
    if m.presentationState.node <> invalid then m.top.removeChild(m.presentationState.node)

    presentation = CreateObject("roSGNode", componentName)
    presentation.id = "presentation"
    m.top.appendChild(presentation)
    m.presentationState.node = presentation
    m.presentationState.componentName = componentName
end sub
