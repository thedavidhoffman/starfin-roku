import "pkg:/source/String.bs"
import "pkg:/source/DateTime.bs"
import "pkg:/source/Format.bs"
import "pkg:/source/MediaMetadataFormatting.bs"
import "pkg:/source/Number.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    initBase()
    m.top.callFunc("applyCardLayout", posterCardLayout())
    initHandlers()
    onItemContentChanged()
end sub

'-------------------------------------------------------------------------------
' posterCardLayout
'-------------------------------------------------------------------------------
function posterCardLayout() as object
    return {
        contentTranslation: [21, 6], posterMaskName: "poster-6-col-mask.png"
        posterSize: [252, 378], hdPosterSize: [168, 252], posterTranslation: [0, 0]
        progressTranslation: [9, 360], progressWidth: 234, progressHeight: 9
        watchedTranslation: [201, 9], watchedSize: 42
        title: { translation: [0, 390], width: 252, height: 48, numLines: 2 }
        metadata: { translation: [0, 429], width: 252, height: 42, numLines: 2 }
    }
end function

'-------------------------------------------------------------------------------
' renderPresentation
'-------------------------------------------------------------------------------
sub renderPresentation(content as object)
    if content.cardLayout <> invalid then m.top.callFunc("applyCardLayout", posterCardLayoutForSize(content.cardLayout.artworkSize, content.cardLayout.numColumns))
    renderStandardText(content)
    if content.cardLayout <> invalid and Number.ToInteger(content.cardLayout.numColumns, 6) = 3 then m.cardNodes.metadataLabel.visible = false
end sub

'-------------------------------------------------------------------------------
' posterCardLayoutForSize
'-------------------------------------------------------------------------------
function posterCardLayoutForSize(size as object, columns as dynamic) as object
    width = Number.ToInteger(size[0], 252)
    height = Number.ToInteger(size[1], 378)
    columnCount = Number.ToInteger(columns, 6)
    watchedSize = Number.ToInteger(width / 6, 42)
    return {
        contentTranslation: [21, 6], posterMaskName: "poster-" + columnCount.ToStr() + "-col-mask.png"
        posterSize: [width, height], hdPosterSize: [Number.ToInteger(width * 0.6667, 168), Number.ToInteger(height * 0.6667, 252)], posterTranslation: [0, 0]
        progressTranslation: [9, height - 18], progressWidth: width - 18, progressHeight: 9
        watchedTranslation: [width - watchedSize - 9, 9], watchedSize: watchedSize
        title: { translation: [0, height + 12], width: width, height: 48, numLines: 2 }
        metadata: { translation: [0, height + 51], width: width, height: 42, numLines: 2 }
    }
end function

'-------------------------------------------------------------------------------
' renderStandardText
'-------------------------------------------------------------------------------
sub renderStandardText(content as object)
    m.cardNodes.title.text = getDisplayTitle(content)
    m.cardNodes.metadataLabel.text = getDisplayMetadata(content)
    m.cardNodes.metadataLabel.visible = content.showMetadata <> false
end sub

'-------------------------------------------------------------------------------
' getDisplayTitle
'-------------------------------------------------------------------------------
function getDisplayTitle(content as object) as string
    item = content.raw
    if item = invalid then return Format.FirstNonEmpty([content.title], "Untitled")
    if LCase(Strings.ToString(item.Type)) = "episode" then return Format.FirstNonEmpty([item.SeriesName, item.Name], "Untitled")
    return Format.FirstNonEmpty([item.Name], "Untitled")
end function

'-------------------------------------------------------------------------------
' getDisplayMetadata
'-------------------------------------------------------------------------------
function getDisplayMetadata(content as object) as string
    if content.hasField("metadataText") then return Strings.ToString(content.metadataText)
    item = content.raw
    if item = invalid then return Format.FirstNonEmpty([content.description], "")
    mediaType = LCase(Strings.ToString(item.Type))
    if mediaType = "movie" or mediaType = "video" then return Strings.ToString(item.ProductionYear)
    if mediaType = "series" then return getSeriesYearRange(item)
    if mediaType = "episode" then return getEpisodeMetadata(item)
    return Format.FirstNonEmpty([item.SeriesName, item.AlbumArtist, item.Album, item.CollectionType, item.Type], "")
end function

'-------------------------------------------------------------------------------
' getSeriesYearRange
'-------------------------------------------------------------------------------
function getSeriesYearRange(item as object) as string
    productionYear = Strings.ToString(item.ProductionYear)
    if productionYear = "" then return ""
    status = LCase(Strings.ToString(item.Status))
    if status = "continuing" then return productionYear + " - Present"
    if status = "ended" then
        endYear = DateTime.ToYear(item.EndDate)
        if endYear = productionYear then return productionYear
        if endYear <> "" then return productionYear + " - " + endYear
    end if
    return productionYear
end function

'-------------------------------------------------------------------------------
' getEpisodeMetadata
'-------------------------------------------------------------------------------
function getEpisodeMetadata(item as object) as string
    episodeTitle = Strings.ToString(item.Name)
    seasonNumber = Strings.ToString(item.ParentIndexNumber)
    episodeNumber = Strings.ToString(item.IndexNumber)
    if seasonNumber = "" or episodeNumber = "" then return episodeTitle
    return "S" + seasonNumber + MediaMetadataFormatting.BulletSeparator() + "E" + episodeNumber + " - " + episodeTitle
end function
