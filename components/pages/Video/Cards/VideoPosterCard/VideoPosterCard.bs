import "pkg:/source/Number.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    initBase()
    m.top.callFunc("applyCardLayout", posterCardLayout())
    initHandlers()
    onItemContentChanged()
end sub

'-------------------------------------------------------------------------------
' posterCardLayout
'-------------------------------------------------------------------------------
function posterCardLayout() as object
    return {
        contentTranslation: [21, 6], posterMaskName: "poster-6-col-mask.png"
        posterSize: [252, 378], hdPosterSize: [168, 252], posterTranslation: [0, 0]
        progressTranslation: [9, 360], progressWidth: 234, progressHeight: 9
        watchedTranslation: [201, 9], watchedSize: 42
        title: { translation: [0, 390], width: 252, height: 48 }
        metadata: { translation: [0, 429], width: 252, height: 42 }
    }
end function

'-------------------------------------------------------------------------------
' renderPresentation
'-------------------------------------------------------------------------------
sub renderPresentation(content as object)
    if content.cardLayout <> invalid then m.top.callFunc("applyCardLayout", posterCardLayoutForSize(content.cardLayout.artworkSize, content.cardLayout.numColumns))
    hideSecond = content.cardLayout <> invalid and Number.ToInteger(content.cardLayout.numColumns, 6) = 3
    renderStandardText(content, hideSecond)
end sub

'-------------------------------------------------------------------------------
' posterCardLayoutForSize
'-------------------------------------------------------------------------------
function posterCardLayoutForSize(size as object, columns as dynamic) as object
    width = Number.ToInteger(size[0], 252)
    height = Number.ToInteger(size[1], 378)
    columnCount = Number.ToInteger(columns, 6)
    watchedSize = Number.ToInteger(width / 6, 42)
    return {
        contentTranslation: [21, 6], posterMaskName: "poster-" + columnCount.ToStr() + "-col-mask.png"
        posterSize: [width, height], hdPosterSize: [Number.ToInteger(width * 0.6667, 168), Number.ToInteger(height * 0.6667, 252)], posterTranslation: [0, 0]
        progressTranslation: [9, height - 18], progressWidth: width - 18, progressHeight: 9
        watchedTranslation: [width - watchedSize - 9, 9], watchedSize: watchedSize
        title: { translation: [0, height + 12], width: width, height: 48 }
        metadata: { translation: [0, height + 51], width: width, height: 42 }
    }
end function
