import "pkg:/source/MediaCard.bs"
import "pkg:/source/String.bs"
import "pkg:/source/MaskAssets.bs"
import "pkg:/source/UnwatchedEpisodeCount.bs"
import "pkg:/source/MediaPlaybackPolicy.bs"
import "pkg:/source/Number.bs"
import "pkg:/source/PlaybackProgress.bs"
import "pkg:/source/ResolutionAssets.bs"
import "pkg:/source/ResolutionProfile.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    initBase()
    initHandlers()
    onItemContentChanged()
end sub

'-------------------------------------------------------------------------------
' initBase
'-------------------------------------------------------------------------------
sub initBase()
    m.cardState = { content: invalid, badgeSize: 42, layout: invalid }
    m.cardNodes = {
        contentGroup: m.top.findNode("contentGroup")
        cardMask: m.top.findNode("cardMask")
        cardBackground: m.top.findNode("cardBackground")
        posterMask: m.top.findNode("posterMask")
        artworkBackground: m.top.findNode("artworkBackground")
        poster: m.top.findNode("poster")
        progressBar: m.top.findNode("progressBar")
        watchedIndicator: m.top.findNode("watchedIndicator")
        title: m.top.findNode("title")
        metadataLabel: m.top.findNode("metadataLabel")
        line3: m.top.findNode("line3")
        overviewLabel: m.top.findNode("overviewLabel")
    }
end sub

'-------------------------------------------------------------------------------
' renderPresentation
'-------------------------------------------------------------------------------
sub renderPresentation(content as object)
    ' No-op fallback required by the base interface. Concrete card components
    ' override this template-method hook to render presentation-specific content.
end sub

'-------------------------------------------------------------------------------
' onItemContentChanged
'-------------------------------------------------------------------------------
sub onItemContentChanged()
    content = m.top.itemContent
    if m.cardState.content <> invalid then m.cardState.content.unobserveField("raw")
    m.cardState.content = content
    if content = invalid then
        for each label in [m.cardNodes.title, m.cardNodes.metadataLabel, m.cardNodes.line3]
            label.text = ""
            label.repeatCount = 0
            label.visible = false
        end for
        updateWatchedIndicator(invalid, invalid, invalid)
        updateProgress(invalid, invalid)
        return
    end if
    content.observeField("raw", "onItemDataChanged")

    item = content.raw
    m.cardNodes.artworkBackground.visible = content.showArtworkBackground = true
    m.cardNodes.poster.loadDisplayMode = "scaleToZoom"
    if content.fitArtwork = true then m.cardNodes.poster.loadDisplayMode = "scaleToFit"
    m.cardNodes.poster.uri = getImageUrl(content)
    updateProgress(item, content.tracksPlaybackProgress)
    m.top.callFunc("renderPresentation", content)
    updateWatchedIndicator(item, content.tracksPlaybackProgress, content.showWatchedIndicator)
    onCardFocusChanged()
end sub

'-------------------------------------------------------------------------------
' getImageUrl
'-------------------------------------------------------------------------------
function getImageUrl(content as object) as string
    imageUrl = content.HDPosterUrl
    if imageUrl <> "" then return imageUrl
    return m.top.placeholderUri
end function

'-------------------------------------------------------------------------------
' updateWatchedIndicator
'-------------------------------------------------------------------------------
sub updateWatchedIndicator(item as dynamic, explicitPolicy as dynamic, showIndicator as dynamic)
    m.cardNodes.watchedIndicator.data = {
        eligible: showIndicator <> false and item <> invalid and MediaPlaybackPolicy.TracksProgress(item, explicitPolicy)
        isWatched: item <> invalid and item.UserData <> invalid and item.UserData.Played = true
        unplayedCount: UnwatchedEpisodeCount.GetCount(item)
        width: m.cardState.badgeSize
        height: m.cardState.badgeSize
    }
end sub

'-------------------------------------------------------------------------------
' updateProgress
'-------------------------------------------------------------------------------
sub updateProgress(item as dynamic, explicitPolicy as dynamic)
    progressPercent = getProgressPercent(item, explicitPolicy)
    trackWidth = Number.ToInteger(m.cardNodes.progressBar.barWidth, 0)
    progressWidth = Number.ToInteger(trackWidth * (progressPercent / 100), 0)
    if progressPercent > 0 and progressWidth < 1 then progressWidth = 1
    if progressWidth > trackWidth then progressWidth = trackWidth
    m.cardNodes.progressBar.progressWidth = progressWidth
    m.cardNodes.progressBar.visible = progressWidth > 0
end sub

'-------------------------------------------------------------------------------
' getProgressPercent
'-------------------------------------------------------------------------------
function getProgressPercent(item as dynamic, explicitPolicy as dynamic) as float
    if item = invalid then return 0
    if MediaPlaybackPolicy.TracksProgress(item, explicitPolicy) <> true then return 0
    if item.UserData <> invalid and item.UserData.Played = true then return 0
    if item.UserData <> invalid and item.UserData.PlayedPercentage <> invalid then
        playedPercentage = Number.ToFloat(item.UserData.PlayedPercentage, 0)
        if playedPercentage <= 0 then return 0
        if playedPercentage > 100 then return 100
        return playedPercentage
    end if
    if item.RunTimeTicks = invalid or item.RunTimeTicks <= 0 then return 0
    progressTicks = PlaybackProgress.GetTicksFromItem(item)
    if progressTicks <= 0 then return 0
    return PlaybackProgress.GetPercentage(progressTicks, item.RunTimeTicks)
end function

'-------------------------------------------------------------------------------
' applyCardLayout
'-------------------------------------------------------------------------------
sub applyCardLayout(layout as object)
    m.cardState.layout = layout
    m.cardNodes.contentGroup.translation = layout.contentTranslation
    MaskAssets.Apply(m.cardNodes.posterMask, layout.posterMaskName, layout.posterSize, layout.hdPosterSize)
    setNodeSize(m.cardNodes.artworkBackground, layout.posterSize)
    setNodeSize(m.cardNodes.poster, layout.posterSize)
    m.cardNodes.posterMask.translation = layout.posterTranslation
    m.cardNodes.progressBar.translation = layout.progressTranslation
    m.cardNodes.progressBar.barWidth = layout.progressWidth
    m.cardNodes.progressBar.barHeight = layout.progressHeight
    m.cardNodes.watchedIndicator.translation = layout.watchedTranslation
    m.cardState.badgeSize = layout.watchedSize
    applyLabelLayout(m.cardNodes.title, layout.title)
    applyLabelLayout(m.cardNodes.metadataLabel, layout.metadata)
end sub

'-------------------------------------------------------------------------------
' setNodeSize
'-------------------------------------------------------------------------------
sub setNodeSize(node as object, size as object)
    node.width = size[0]
    node.height = size[1]
end sub

'-------------------------------------------------------------------------------
' applyLabelLayout
'-------------------------------------------------------------------------------
sub applyLabelLayout(label as object, layout as object)
    label.translation = layout.translation
    label.maxWidth = layout.width
    label.height = layout.height
    if layout.primaryFont <> invalid then label.font = layout.primaryFont
end sub

'-------------------------------------------------------------------------------
' onItemDataChanged
'-------------------------------------------------------------------------------
sub onItemDataChanged()
    content = m.cardState.content
    if content = invalid then return
    updateWatchedIndicator(content.raw, content.tracksPlaybackProgress, content.showWatchedIndicator)
    updateProgress(content.raw, content.tracksPlaybackProgress)
end sub

'-------------------------------------------------------------------------------
' initHandlers
'-------------------------------------------------------------------------------
sub initHandlers()
    m.top.observeField("itemContent", "onItemContentChanged")
    m.top.observeField("itemHasFocus", "onCardFocusChanged")
end sub

'-------------------------------------------------------------------------------
' renderStandardText
'-------------------------------------------------------------------------------
sub renderStandardText(content as object, hideSecond = false as boolean, reserveSecond = false as boolean)
    layout = m.cardState.layout
    applyLabelLayout(m.cardNodes.title, layout.title)
    applyLabelLayout(m.cardNodes.metadataLabel, layout.metadata)
    applyLabelLayout(m.cardNodes.line3, layout.metadata)
    primaryFont = Strings.ToString(layout.title.primaryFont, "font:SmallestBoldSystemFont")
    renderTextLine(m.cardNodes.title, content.line1, primaryFont)
    renderTextLine(m.cardNodes.metadataLabel, content.line2)
    renderTextLine(m.cardNodes.line3, content.line3)
    if hideSecond then m.cardNodes.metadataLabel.visible = false
    if content.line3 <> invalid then
        ' One stack owns three-line spacing. Hidden slots consume no height, but
        ' the caller's item canvas stays fixed so rows and focus do not move.
        spacing = Number.ToInteger(layout.textLineSpacing, 30)
        y = layout.title.translation[1]
        for each label in [m.cardNodes.title, m.cardNodes.metadataLabel, m.cardNodes.line3]
            label.translation = [layout.title.translation[0], y]
            label.height = spacing
            occupied = label.visible
            if label.isSameNode(m.cardNodes.metadataLabel) and reserveSecond then occupied = true
            if occupied then y += spacing
        end for
    end if
end sub

'-------------------------------------------------------------------------------
' renderTextLine
'-------------------------------------------------------------------------------
sub renderTextLine(label as object, line as dynamic, primaryFont = "font:SmallestBoldSystemFont" as string)
    label.repeatCount = 0
    label.text = ""
    label.visible = false
    if line = invalid then return
    label.text = Strings.ToString(line.text)
    label.visible = Strings.Trim(label.text) <> ""
    label.font = "font:TinySystemFont"
    label.color = &hB9C7D6FF
    if line.style = MediaCard.TextStyle.Primary then
        label.font = primaryFont
        label.color = &hF3F7FBFF
    else if line.style = MediaCard.TextStyle.Secondary then
        label.font = "font:SmallestSystemFont"
        label.color = &hD8E2ECFF
    end if
end sub

'-------------------------------------------------------------------------------
' onCardFocusChanged
'-------------------------------------------------------------------------------
sub onCardFocusChanged()
    content = m.cardState.content
    labels = [m.cardNodes.title, m.cardNodes.metadataLabel, m.cardNodes.line3]
    for i = 0 to 2
        label = labels[i]
        label.repeatCount = 0
        if content <> invalid and m.top.itemHasFocus then
            line = content["line" + (i + 1).ToStr()]
            if line <> invalid and label.visible then
                if line.style = MediaCard.TextStyle.Primary or line.style = MediaCard.TextStyle.Secondary then label.repeatCount = -1
            end if
        end if
    end for
end sub
