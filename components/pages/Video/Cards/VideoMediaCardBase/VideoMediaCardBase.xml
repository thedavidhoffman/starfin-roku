<?xml version="1.0" encoding="utf-8"?>
<component name="VideoMediaCardBase" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/pages/Video/Cards/VideoMediaCardBase/VideoMediaCardBase.bs" />
  <interface>
    <field id="itemContent" type="node" onChange="onItemContentChanged" />
    <field id="placeholderUri" type="string" value="pkg:/images/media-card/poster-placeholder-252x378.png" />
    <function name="renderPresentation" />
    <function name="applyCardLayout" />
  </interface>
  <children>
    <Group id="contentGroup">
      <MaskGroup id="cardMask" visible="false">
        <Poster id="cardBackground" uri="pkg:/images/media-card/detailed-card-panel-882x496.png" loadDisplayMode="scaleToFill" />
      </MaskGroup>
      <MaskGroup id="posterMask">
        <Poster id="artworkBackground" uri="pkg:/images/media-card/photo-artwork-background.png" loadDisplayMode="scaleToFill" visible="false" />
        <Poster id="poster" loadDisplayMode="scaleToZoom" />
        <ProgressBar id="progressBar" visible="false" />
      </MaskGroup>
      <Poster id="watchedIndicator" uri="pkg:/images/icons/watched-check.png" visible="false" />
      <Label id="title" wrap="true" color="0xF3F7FBFF" font="font:SmallestBoldSystemFont" />
      <Label id="metadataLabel" wrap="true" color="0xB9C7D6FF" font="font:TinySystemFont" />
      <Label id="overviewLabel" wrap="true" color="0xD8E2ECFF" font="font:SmallestSystemFont" visible="false" />
    </Group>
  </children>
</component>
