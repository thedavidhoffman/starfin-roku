import "pkg:/source/Number.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    initBase()
    m.top.placeholderUri = "pkg:/images/media-card/thumbnail-placeholder-441x249.png"
    m.top.callFunc("applyCardLayout", {
        contentTranslation: [21, 0], posterMaskName: "thumbnail-4-col-mask.png"
        posterSize: [441, 249], hdPosterSize: [294, 166], posterTranslation: [0, 0]
        progressTranslation: [9, 231], progressWidth: 423, progressHeight: 9
        watchedTranslation: [375, 9], watchedSize: 57
        title: { translation: [0, 261], width: 441, height: 34, numLines: 1 }
        metadata: { translation: [0, 297], width: 441, height: 42, numLines: 2 }
    })
end sub

'-------------------------------------------------------------------------------
' renderPresentation
'-------------------------------------------------------------------------------
sub renderPresentation(content as object)
    if content.cardLayout <> invalid then applyThumbnailLayout(content.cardLayout.artworkSize, content.cardLayout.numColumns)
    renderStandardText(content)
    m.cardNodes.title.height = 34
    m.cardNodes.title.numLines = 1
    if content.showMetadata = false then
        m.cardNodes.title.height = 48
        m.cardNodes.title.numLines = 2
    end if
end sub

sub applyThumbnailLayout(size as object, columns as dynamic)
    width = Number.ToInteger(size[0], 441)
    height = Number.ToInteger(size[1], 249)
    columnCount = Number.ToInteger(columns, 4)
    watchedSize = Number.ToInteger(width * 0.13, 57)
    m.top.callFunc("applyCardLayout", {
        contentTranslation: [21, 0], posterMaskName: "thumbnail-" + columnCount.ToStr() + "-col-mask.png"
        posterSize: [width, height], hdPosterSize: [Number.ToInteger(width * 0.6667, 294), Number.ToInteger(height * 0.6667, 166)], posterTranslation: [0, 0]
        progressTranslation: [9, height - 18], progressWidth: width - 18, progressHeight: 9
        watchedTranslation: [width - watchedSize - 9, 9], watchedSize: watchedSize
        title: { translation: [0, height + 12], width: width, height: 34, numLines: 1 }
        metadata: { translation: [0, height + 48], width: width, height: 42, numLines: 2 }
    })
end sub
