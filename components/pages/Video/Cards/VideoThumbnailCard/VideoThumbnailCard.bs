import "pkg:/source/Number.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    initBase()
    m.cardNodes.logoGradient = CreateObject("roSGNode", "Poster")
    m.cardNodes.logoGradient.id = "logoGradient"
    m.cardNodes.logoGradient.uri = "pkg:/images/overlays/episode-logo-gradient.png"
    m.cardNodes.logoGradient.loadDisplayMode = "scaleToFill"
    m.cardNodes.logoGradient.visible = false
    ' Keep the gradient behind both the logo and the progress bar.
    m.cardNodes.posterMask.insertChild(m.cardNodes.logoGradient, 2)
    m.cardNodes.logoOverlay = m.cardNodes.posterMask.createChild("Poster")
    m.cardNodes.logoOverlay.id = "logoOverlay"
    m.cardNodes.logoOverlay.loadDisplayMode = "scaleToFit"
    m.cardNodes.logoOverlay.visible = false
    m.cardNodes.logoOverlay.observeField("loadStatus", "onLogoLoadStatusChanged")
    m.top.placeholderUri = "pkg:/images/media-card/thumbnail-placeholder-441x249.png"
    m.top.callFunc("applyCardLayout", {
        contentTranslation: [21, 0], posterMaskName: "thumbnail-4-col-mask.png"
        posterSize: [441, 249], hdPosterSize: [294, 166], posterTranslation: [0, 0]
        progressTranslation: [9, 231], progressWidth: 423, progressHeight: 9
        watchedTranslation: [375, 9], watchedSize: 57
        title: { translation: [0, 261], width: 441, height: 34, numLines: 1 }
        metadata: { translation: [0, 297], width: 441, height: 42, numLines: 2 }
    })
end sub

'-------------------------------------------------------------------------------
' renderPresentation
'-------------------------------------------------------------------------------
sub renderPresentation(content as object)
    if content.cardLayout <> invalid then applyThumbnailLayout(content.cardLayout.artworkSize, content.cardLayout.numColumns)
    logo = m.cardNodes.logoOverlay
    logo.width = Number.ToInteger(m.cardNodes.poster.width * 0.4, 176)
    logo.height = Number.ToInteger(m.cardNodes.poster.height * 0.25, 62)
    logoY = m.cardNodes.poster.height - logo.height - 12
    if m.cardNodes.progressBar.visible then logoY = m.cardNodes.progressBar.translation[1] - logo.height - 9
    logo.translation = [12, logoY]
    logoUrl = Format.SafeString(content.logoOverlayUrl, "")
    if logo.uri <> logoUrl then
        ' Clear the previous logo's gradient before starting a replacement load.
        m.cardNodes.logoGradient.visible = false
        logo.uri = logoUrl
    else
        onLogoLoadStatusChanged()
    end if
    logo.visible = logo.uri <> ""
    m.cardNodes.logoGradient.width = m.cardNodes.poster.width
    m.cardNodes.logoGradient.height = m.cardNodes.poster.height
    renderStandardText(content)
    m.cardNodes.title.height = 34
    m.cardNodes.title.numLines = 1
    if content.showMetadata = false then
        m.cardNodes.title.height = 48
        m.cardNodes.title.numLines = 2
    end if
end sub

'-------------------------------------------------------------------------------
' onLogoLoadStatusChanged
'-------------------------------------------------------------------------------
sub onLogoLoadStatusChanged()
    logo = m.cardNodes.logoOverlay
    content = m.top.itemContent
    showGradient = false
    if content <> invalid and logo.uri <> "" then
        showGradient = logo.uri = Format.SafeString(content.logoOverlayUrl, "") and logo.loadStatus = "ready"
    end if
    m.cardNodes.logoGradient.visible = showGradient
end sub

'-------------------------------------------------------------------------------
' applyThumbnailLayout
'-------------------------------------------------------------------------------
sub applyThumbnailLayout(size as object, columns as dynamic)
    width = Number.ToInteger(size[0], 441)
    height = Number.ToInteger(size[1], 249)
    columnCount = Number.ToInteger(columns, 4)
    watchedSize = Number.ToInteger(width * 0.13, 57)
    m.top.callFunc("applyCardLayout", {
        contentTranslation: [21, 0], posterMaskName: "thumbnail-" + columnCount.ToStr() + "-col-mask.png"
        posterSize: [width, height], hdPosterSize: [Number.ToInteger(width * 0.6667, 294), Number.ToInteger(height * 0.6667, 166)], posterTranslation: [0, 0]
        progressTranslation: [9, height - 18], progressWidth: width - 18, progressHeight: 9
        watchedTranslation: [width - watchedSize - 9, 9], watchedSize: watchedSize
        title: { translation: [0, height + 12], width: width, height: 34, numLines: 1 }
        metadata: { translation: [0, height + 48], width: width, height: 42, numLines: 2 }
    })
end sub
