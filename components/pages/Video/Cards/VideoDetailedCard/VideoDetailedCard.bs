import "pkg:/source/MediaMetadata.bs"
import "pkg:/source/Format.bs"
import "pkg:/source/MaskAssets.bs"
import "pkg:/source/ResolutionAssets.bs"
import "pkg:/source/ResolutionProfile.bs"
import "pkg:/source/Theme.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    initBase()
    m.cardNodes.metadataRow = m.top.findNode("metadataRow")
    m.cardNodes.contentGroup.appendChild(m.cardNodes.metadataRow)
    m.cardNodes.titleDivider = m.top.findNode("titleDivider")
    m.cardNodes.contentGroup.appendChild(m.cardNodes.titleDivider)
    m.top.callFunc("applyCardLayout", {
        contentTranslation: [27, 0], posterMaskName: "detailed-poster-mask.png"
        posterSize: [288, 432], hdPosterSize: [192, 288], posterTranslation: [24, 32]
        progressTranslation: [9, 414], progressWidth: 270, progressHeight: 9
        watchedTranslation: [258, 44], watchedSize: 42
        textLineSpacing: 40
        title: { translation: [336, 32], width: 516, height: 64, primaryFont: "font:SmallBoldSystemFont" }
        metadata: { translation: [336, 96], width: 516, height: 34 }
    })
    MaskAssets.Apply(m.cardNodes.cardMask, "detailed-card-mask.png", [882, 496], [588, 331])
    m.cardNodes.cardMask.visible = true
    m.cardNodes.cardBackground.width = 882
    m.cardNodes.cardBackground.height = 496
    m.global.observeField("theme", "updateTheme")
    updateTheme()
    m.cardNodes.overviewLabel.translation = [336, 142]
    m.cardNodes.overviewLabel.width = 516
    m.cardNodes.overviewLabel.height = 354
    m.cardNodes.overviewLabel.numLines = 8
    m.cardNodes.overviewLabel.visible = true
    initHandlers()
    onItemContentChanged()
end sub

'-------------------------------------------------------------------------------
' updateTheme
'-------------------------------------------------------------------------------
sub updateTheme()
    m.cardNodes.cardBackground.uri = Theme.DetailedCardBackgroundUri(m.global.theme)
end sub

'-------------------------------------------------------------------------------
' renderPresentation
'-------------------------------------------------------------------------------
sub renderPresentation(content as object)
    item = content.raw
    hasMetadataRow = content.detailMetadata <> invalid
    renderStandardText(content, hasMetadataRow, hasMetadataRow)
    textOffset = 0
    if content.line3 <> invalid then textOffset = 30
    m.cardNodes.titleDivider.translation = [336, 125 + textOffset]
    m.cardNodes.overviewLabel.translation = [336, 142 + textOffset]
    m.cardNodes.overviewLabel.height = 354 - textOffset
    m.cardNodes.metadataRow.translation = m.cardNodes.metadataLabel.translation
    m.cardNodes.metadataRow.visible = hasMetadataRow
    if hasMetadataRow then renderDetailedMetadata(content.detailMetadata)
    overview = "No description available."
    if item <> invalid then overview = Format.FirstNonEmpty([item.Overview], overview)
    m.cardNodes.overviewLabel.text = overview
end sub

'-------------------------------------------------------------------------------
' renderDetailedMetadata
'-------------------------------------------------------------------------------
sub renderDetailedMetadata(data as object)
    input = new MediaMetadata()
    input.leadingText = data.leadingText
    input.runtimeText = data.runtimeText
    input.officialRating = data.officialRating
    input.communityRating = data.communityRating
    input.criticRating = data.criticRating
    input.availableWidth = m.cardNodes.metadataLabel.maxWidth
    input.truncateLeadingText = false
    input.scaleToFit = true
    m.cardNodes.metadataRow.callFunc("render", input)
end sub
