import "pkg:/source/String.bs"
import "pkg:/source/MaskAssets.bs"
import "pkg:/source/ResolutionProfile.bs"
import "pkg:/source/ResolutionAssets.bs"
import "pkg:/source/Format.bs"
import "pkg:/source/DateTime.bs"
import "pkg:/source/MediaMetadata.bs"
import "pkg:/source/PlaybackProgress.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.contentGroup = m.top.findNode("contentGroup")
    m.detailedCard = m.top.findNode("detailedCard")
    m.posterMask = m.top.findNode("posterMask")
    m.artworkBackground = m.top.findNode("artworkBackground")
    m.poster = m.top.findNode("poster")
    m.titleLogo = m.top.findNode("titleLogo")
    m.progressBar = m.top.findNode("progressBar")
    m.watchedIndicator = m.top.findNode("watchedIndicator")
    m.title = m.top.findNode("title")
    m.metadataLabel = m.top.findNode("metadataLabel")
end sub

'-------------------------------------------------------------------------------
' onItemContentChanged
'-------------------------------------------------------------------------------
sub onItemContentChanged()
    item = m.top.itemContent
    if item = invalid then return

    showMetadata = item.showMetadata <> false
    imageAspect = Format.SafeString(item.imageAspect, "poster")
    isDetailed = imageAspect = "detailed"
    m.contentGroup.visible = not isDetailed
    m.detailedCard.visible = isDetailed
    if isDetailed then
        m.detailedCard.itemContent = invalid
        m.detailedCard.itemContent = item
        return
    end if

    applyLayout(imageAspect, showMetadata)
    m.title.text = getDisplayTitle(item)
    m.metadataLabel.text = getDisplayMetadata(item)
    m.metadataLabel.visible = showMetadata
    m.poster.visible = true
    renderTitleLogo(item, imageAspect)
    renderPoster(item, imageAspect)
    updateProgress(item)
    updateWatchedIndicator(item)
end sub

'-------------------------------------------------------------------------------
' renderTitleLogo
'-------------------------------------------------------------------------------
sub renderTitleLogo(item as object, imageAspect as string)
    logoUrl = Format.SafeString(item.logoUrl, "")
    m.titleLogo.visible = imageAspect = "jumbo" and logoUrl <> ""
    m.titleLogo.uri = logoUrl
end sub

'-------------------------------------------------------------------------------
' updateWatchedIndicator
'-------------------------------------------------------------------------------
sub updateWatchedIndicator(item as object)
    raw = getRawItem(item)
    m.watchedIndicator.visible = raw <> invalid and raw.UserData <> invalid and raw.UserData.Played = true
end sub

'-------------------------------------------------------------------------------
' renderPoster
'-------------------------------------------------------------------------------
sub renderPoster(item as object, imageAspect as string)
    m.artworkBackground.visible = item.showArtworkBackground = true
    m.poster.loadDisplayMode = "scaleToZoom"
    if item.fitArtwork = true then m.poster.loadDisplayMode = "scaleToFit"
    m.poster.uri = getImageUrl(item, imageAspect)
end sub

'-------------------------------------------------------------------------------
' getDisplayTitle
'-------------------------------------------------------------------------------
function getDisplayTitle(item as object) as string
    raw = getRawItem(item)
    if raw = invalid then return Format.FirstNonEmpty([item.title], "Untitled")

    mediaType = LCase(Format.SafeString(raw.Type, ""))

    if mediaType = "episode" then
        return Format.FirstNonEmpty([raw.SeriesName, raw.Name], "Untitled")
    end if

    return Format.FirstNonEmpty([raw.Name], "Untitled")
end function

'-------------------------------------------------------------------------------
' getDisplayMetadata
'-------------------------------------------------------------------------------
function getDisplayMetadata(item as object) as string
    if item.hasField("metadataText") then return Format.SafeString(item.metadataText, "")
    raw = getRawItem(item)
    if raw = invalid then return Format.FirstNonEmpty([item.description], "")

    mediaType = LCase(Format.SafeString(raw.Type, ""))

    if mediaType = "movie" or mediaType = "video" then
        return Format.SafeString(raw.ProductionYear, "")
    end if

    if mediaType = "series" then
        return getSeriesYearRange(raw)
    end if

    if mediaType = "episode" then
        return getEpisodeMetadata(raw)
    end if

    return Format.FirstNonEmpty([raw.SeriesName, raw.AlbumArtist, raw.Album, raw.CollectionType, raw.Type], "")
end function

'-------------------------------------------------------------------------------
' getSeriesYearRange
'-------------------------------------------------------------------------------
function getSeriesYearRange(item as object) as string
    productionYear = Format.SafeString(item.ProductionYear, "")
    if productionYear = "" then return ""

    status = LCase(Format.SafeString(item.Status, ""))
    if status = "continuing" then return productionYear + " - Present"

    if status = "ended" then
        endYear = DateTime.ToYear(item.EndDate)
        if endYear = productionYear then return productionYear
        if endYear <> "" then return productionYear + " - " + endYear
    end if

    return productionYear
end function

'-------------------------------------------------------------------------------
' getEpisodeMetadata
'-------------------------------------------------------------------------------
function getEpisodeMetadata(item as object) as string
    episodeTitle = Format.SafeString(item.Name, "")
    seasonNumber = Format.SafeString(item.ParentIndexNumber, "")
    episodeNumber = Format.SafeString(item.IndexNumber, "")

    if seasonNumber = "" or episodeNumber = "" then return episodeTitle

    return "S" + seasonNumber + MediaMetadata.BulletSeparator() + "E" + episodeNumber + " - " + episodeTitle
end function

'-------------------------------------------------------------------------------
' getRawItem
'-------------------------------------------------------------------------------
function getRawItem(item as object) as dynamic
    if item = invalid then return invalid
    return item.raw
end function

'-------------------------------------------------------------------------------
' getImageUrl
'-------------------------------------------------------------------------------
function getImageUrl(item as object, imageAspect as string) as string
    imageUrl = Format.SafeString(item.HDPosterUrl, "")
    if imageUrl <> "" then return imageUrl

    if imageAspect = "wide" or imageAspect = "jumbo" then return "pkg:/images/media-card/thumbnail-placeholder-441x249.png"
    return "pkg:/images/media-card/poster-placeholder-252x378.png"
end function

'-------------------------------------------------------------------------------
' applyLayout
'-------------------------------------------------------------------------------
sub applyLayout(imageAspect as string, showMetadata as boolean)
    m.titleLogo.visible = false
    if imageAspect = "jumbo" then
        applyJumboCardLayout()
    else if imageAspect = "wide" then
        applyThumbnailCardLayout(showMetadata)
    else
        applyPosterCardLayout()
    end if
end sub

'-------------------------------------------------------------------------------
' applyJumboCardLayout
'-------------------------------------------------------------------------------
sub applyJumboCardLayout()
    applyContentLayout([27, 0])
    applyPosterLayout("media-card-jumbo-mask.png", [882, 496], [588, 331])
    applyProgressLayout(882, 496, {
        horizontalMargin: 29
        barHeight: 18
        upwardOffset: 20
    })
    applyLogoLayout([30, 306], [360, 140])
    applyWatchedIndicatorLayout([807, 18], 57)
    applyTextLayout(882, [0, 508], [0, 544], 34, 1)
end sub

'-------------------------------------------------------------------------------
' applyThumbnailCardLayout
'-------------------------------------------------------------------------------
sub applyThumbnailCardLayout(showMetadata as boolean)
    titleHeight = 48
    titleLines = 2
    if showMetadata = true then
        titleHeight = 34
        titleLines = 1
    end if

    applyContentLayout([21, 0])
    applyPosterLayout("media-card-thumbnail-mask.png", [441, 249], [294, 166])
    applyProgressLayout(441, 249)
    applyWatchedIndicatorLayout([375, 9], 57)
    applyTextLayout(441, [0, 261], [0, 297], titleHeight, titleLines)
end sub

'-------------------------------------------------------------------------------
' applyPosterCardLayout
'-------------------------------------------------------------------------------
sub applyPosterCardLayout()
    applyContentLayout([21, 0])
    applyPosterLayout("media-card-poster-mask.png", [252, 378], [168, 252])
    applyProgressLayout(252, 378)
    applyWatchedIndicatorLayout([201, 9], 42)
    applyTextLayout(252, [0, 390], [0, 429], 48, 2)
end sub

'-------------------------------------------------------------------------------
' applyContentLayout
'-------------------------------------------------------------------------------
sub applyContentLayout(translation as object)
    m.contentGroup.translation = translation
end sub

'-------------------------------------------------------------------------------
' applyPosterLayout
'-------------------------------------------------------------------------------
sub applyPosterLayout(maskName as string, maskSize as object, hdMaskSize as object)
    MaskAssets.Apply(m.posterMask, maskName, maskSize, hdMaskSize)
    m.artworkBackground.width = maskSize[0]
    m.artworkBackground.height = maskSize[1]
    m.poster.width = maskSize[0]
    m.poster.height = maskSize[1]
end sub

'-------------------------------------------------------------------------------
' applyLogoLayout
'-------------------------------------------------------------------------------
sub applyLogoLayout(translation as object, size as object)
    m.titleLogo.translation = translation
    m.titleLogo.width = size[0]
    m.titleLogo.height = size[1]
end sub

'-------------------------------------------------------------------------------
' applyWatchedIndicatorLayout
'-------------------------------------------------------------------------------
sub applyWatchedIndicatorLayout(translation as object, size as integer)
    m.watchedIndicator.translation = translation
    m.watchedIndicator.width = size
    m.watchedIndicator.height = size
end sub

'-------------------------------------------------------------------------------
' applyTextLayout
'-------------------------------------------------------------------------------
sub applyTextLayout(width as integer, titleTranslation as object, metadataTranslation as object, titleHeight as integer, titleLines as integer)
    m.title.width = width
    m.title.translation = titleTranslation
    m.title.height = titleHeight
    m.title.numLines = titleLines
    m.metadataLabel.width = width
    m.metadataLabel.translation = metadataTranslation
end sub

'-------------------------------------------------------------------------------
' applyProgressLayout
'-------------------------------------------------------------------------------
sub applyProgressLayout(width as integer, height as integer, style = invalid as dynamic)
    marginX = 9
    baselineHeight = 9
    progressHeight = baselineHeight
    upwardOffset = 0
    if style <> invalid then
        marginX = style.horizontalMargin
        progressHeight = style.barHeight
        upwardOffset = style.upwardOffset
    end if
    progressBottom = 9
    progressWidth = width - (marginX * 2)
    progressY = height - progressBottom - baselineHeight - upwardOffset

    m.progressBar.translation = [marginX, progressY]
    m.progressBar.barWidth = progressWidth
    m.progressBar.barHeight = progressHeight
end sub

'-------------------------------------------------------------------------------
' updateProgress
'-------------------------------------------------------------------------------
sub updateProgress(item as object)
    trackWidth = m.progressBar.barWidth
    progressWidth = getProgressWidth(getRawItem(item), trackWidth)
    visible = progressWidth > 0

    m.progressBar.visible = visible

    if visible <> true then
        m.progressBar.progressWidth = 0
        return
    end if

    m.progressBar.progressWidth = progressWidth
end sub

'-------------------------------------------------------------------------------
' getProgressWidth
'-------------------------------------------------------------------------------
function getProgressWidth(item as dynamic, trackWidth as integer) as integer
    progressPercent = getProgressPercent(item)
    if progressPercent <= 0 then return 0

    progressWidth = int(trackWidth * (progressPercent / 100))
    if progressWidth < 1 then return 1
    if progressWidth > trackWidth then return trackWidth

    return progressWidth
end function

'-------------------------------------------------------------------------------
' getProgressPercent
'-------------------------------------------------------------------------------
function getProgressPercent(item as dynamic) as float
    if item = invalid then return 0
    if item.UserData <> invalid and item.UserData.Played = true then return 0

    if item.UserData <> invalid and item.UserData.PlayedPercentage <> invalid then
        playedPercentage = item.UserData.PlayedPercentage
        if playedPercentage <= 0 then return 0
        if playedPercentage > 100 then return 100
        return playedPercentage
    end if

    if item.RunTimeTicks = invalid or item.RunTimeTicks <= 0 then return 0

    progressTicks = PlaybackProgress.GetTicksFromItem(item)
    if progressTicks <= 0 then return 0

    return PlaybackProgress.GetPercentage(progressTicks, item.RunTimeTicks)
end function
