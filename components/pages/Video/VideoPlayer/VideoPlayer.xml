<?xml version="1.0" encoding="utf-8"?>
<component name="VideoPlayer" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/source/Format.brs" />
  <script type="text/brightscript" uri="pkg:/source/String.brs" />
  <script type="text/brightscript" uri="pkg:/source/Logger.brs" />
  <script type="text/brightscript" uri="pkg:/source/Status.brs" />
  <script type="text/brightscript" uri="pkg:/source/Spinner.brs" />
  <script type="text/brightscript" uri="pkg:/source/Encode.brs" />
  <script type="text/brightscript" uri="pkg:/source/Url.brs" />
  <script type="text/brightscript" uri="pkg:/source/SeriesIdentity.brs" />
  <script type="text/brightscript" uri="pkg:/source/PlaybackProgress.brs" />
  <script type="text/brightscript" uri="pkg:/source/DateTime.brs" />
  <script type="text/brightscript" uri="pkg:/source/MediaMetadata.brs" />
  <script type="text/brightscript" uri="pkg:/source/MediaOptions.brs" />
  <script type="text/brightscript" uri="pkg:/source/api/JellyfinAuth.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/Video/VideoPlayer/Helpers/Cast.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/Video/VideoPlayer/Helpers/StreamOptions.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/Video/VideoPlayer/Helpers/Seek.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/Video/VideoPlayer/Helpers/Trickplay.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/Video/VideoPlayer/Helpers/PlaybackSession.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/Video/VideoPlayer/VideoPlayer.brs" />
  <interface>
    <field id="playRequest" type="assocarray" onChange="onPlayRequestChanged" />
    <field id="playbackProgressChanged" type="assocarray" alwaysNotify="true" />
    <field id="upNextRequested" type="assocarray" alwaysNotify="true" />
    <field id="streamOptionsRequested" type="assocarray" alwaysNotify="true" />
    <field id="selectedPerson" type="assocarray" alwaysNotify="true" />
    <field id="closeRequested" type="boolean" alwaysNotify="true" />
    <function name="handleStreamOptionsOverlayClosed" />
    <function name="pauseForPersonNavigation" />
    <function name="resumeAfterPersonNavigation" />
  </interface>
  <children>
    
    <Rectangle width="1920" height="1080" color="0x000000FF" />
    <Video id="videoPlayer" width="1920" height="1080" enableUI="false" />
    <PlaybackControls id="playbackControls" translation="[0,0]" visible="false" />
    <Clock id="clock" translation="[1680,32]" clockWidth="176" clockHeight="40" color="0xF6F7FBFF" visible="false" />
    <Poster id="castGradient" uri="pkg:/images/overlays/bottom-content-gradient.png" translation="[0,490]" width="1920" height="740" loadDisplayMode="scaleToFit" visible="false" />
    <Cast id="cast" translation="[96,699]" visible="false" />

    <VideoPlaybackInfoTask id="playbackInfoTask" />
    <PlaystateTask id="playstateTask" />
    <TrickplayPreloadTask id="trickplayPreloadTask" />

    <Timer id="controlsHideTimer" duration="5" repeat="false" />
    <Timer id="playstateTimer" duration="30" repeat="true" />
    <Timer id="fastSeekTimer" duration="0.3" repeat="true" />
    <Timer id="leftSeekRepeatTimer" duration="0.5" repeat="true" />
    <Timer id="rightSeekRepeatTimer" duration="0.5" repeat="true" />

  </children>
</component>
