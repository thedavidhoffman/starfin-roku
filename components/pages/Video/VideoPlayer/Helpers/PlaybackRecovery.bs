'-------------------------------------------------------------------------------
' initPlaybackRecovery
'-------------------------------------------------------------------------------
sub initPlaybackRecovery()
    m.recovery = {
        itemId: ""
        originalMode: PlaybackMode.Mode.Automatic
        effectiveMode: PlaybackMode.Mode.Automatic
        internalRestartPending: false
        sameModeRetryUsed: false
        hasEverPlayed: false
        isStable: false
        lastSafePosition: 0
        pendingSeekTarget: invalid
        bufferLastPercent: -1
        bufferLastPosition: 0
        bufferStalledSeconds: 0
        bufferAtHundredSeconds: 0
        bufferMonitoring: false
    }
end sub

'-------------------------------------------------------------------------------
' beginPlaybackRecoveryRequest
'-------------------------------------------------------------------------------
function beginPlaybackRecoveryRequest(request as object) as boolean
    isRecoveryRestart = m.recovery.internalRestartPending = true
    m.recovery.internalRestartPending = false
    stopPlaybackRecoveryTimers()

    if isRecoveryRestart then
        m.recovery.effectiveMode = getRecoveryRequestMode(request)
        return true
    end if

    resetPlaybackRecovery(request)
    return false
end function

'-------------------------------------------------------------------------------
' resetPlaybackRecovery
'-------------------------------------------------------------------------------
sub resetPlaybackRecovery(request = invalid as dynamic)
    stopPlaybackRecoveryTimers()
    mode = PlaybackMode.Mode.Automatic
    itemId = ""
    startPosition = 0
    if request <> invalid then
        mode = getRecoveryRequestMode(request)
        itemId = Format.SafeString(request.itemId, "")
        startPosition = PlaybackProgress.TicksToSeconds(request.startPositionTicks)
    end if

    m.recovery.itemId = itemId
    m.recovery.originalMode = mode
    m.recovery.effectiveMode = mode
    m.recovery.internalRestartPending = false
    m.recovery.sameModeRetryUsed = false
    m.recovery.hasEverPlayed = false
    m.recovery.isStable = false
    m.recovery.lastSafePosition = startPosition
    m.recovery.pendingSeekTarget = invalid
    resetPlaybackRecoveryBufferState()
end sub

'-------------------------------------------------------------------------------
' getRecoveryRequestMode
'-------------------------------------------------------------------------------
function getRecoveryRequestMode(request as dynamic) as string
    if request = invalid then return PlaybackMode.Mode.Automatic
    return PlaybackMode.Normalize(request.videoMode)
end function

'-------------------------------------------------------------------------------
' getOriginalPlaybackMode
'-------------------------------------------------------------------------------
function getOriginalPlaybackMode() as string
    if m.recovery = invalid then return PlaybackMode.Mode.Automatic
    return PlaybackMode.Normalize(m.recovery.originalMode)
end function

'-------------------------------------------------------------------------------
' recordPlaybackRecoveryPosition
'-------------------------------------------------------------------------------
sub recordPlaybackRecoveryPosition(position as dynamic)
    if position = invalid then return
    state = VideoPlayerState.Normalize(m.videoPlayer.state)
    if state <> VideoPlayerState.Value.Playing and state <> VideoPlayerState.Value.Paused then return

    value = Number.ToFloat(position, 0)
    if value >= 0 then
        m.recovery.lastSafePosition = value
        m.recovery.pendingSeekTarget = invalid
    end if
end sub

'-------------------------------------------------------------------------------
' onPlaybackRecoveryStateChanged
'-------------------------------------------------------------------------------
sub onPlaybackRecoveryStateChanged(state as string)
    if state = VideoPlayerState.Value.Buffering then
        m.recovery.isStable = false
        m.recoveryStableTimer.control = TimerControl.Command.Stop
        startPlaybackRecoveryBufferMonitor()
        return
    end if

    stopPlaybackRecoveryBufferMonitor()
    if state = VideoPlayerState.Value.Playing then
        m.recovery.hasEverPlayed = true
        m.recovery.isStable = false
        m.recoveryStableTimer.control = TimerControl.Command.Stop
        m.recoveryStableTimer.control = TimerControl.Command.Start
    else if state = VideoPlayerState.Value.Paused then
        m.recoveryStableTimer.control = TimerControl.Command.Stop
    else if state = VideoPlayerState.Value.Finished then
        m.recoveryStableTimer.control = TimerControl.Command.Stop
    end if
end sub

'-------------------------------------------------------------------------------
' startPlaybackRecoveryBufferMonitor
'-------------------------------------------------------------------------------
sub startPlaybackRecoveryBufferMonitor()
    if m.recovery.bufferMonitoring then return
    resetPlaybackRecoveryBufferState()
    m.recovery.bufferMonitoring = true
    m.recovery.bufferLastPercent = getPlaybackBufferPercent()
    m.recovery.bufferLastPosition = Number.ToFloat(m.videoPlayer.position, 0)
    m.recoveryBufferTimer.control = TimerControl.Command.Stop
    m.recoveryBufferTimer.control = TimerControl.Command.Start
end sub

'-------------------------------------------------------------------------------
' stopPlaybackRecoveryBufferMonitor
'-------------------------------------------------------------------------------
sub stopPlaybackRecoveryBufferMonitor()
    m.recoveryBufferTimer.control = TimerControl.Command.Stop
    m.recovery.bufferMonitoring = false
    resetPlaybackRecoveryBufferState()
end sub

'-------------------------------------------------------------------------------
' resetPlaybackRecoveryBufferState
'-------------------------------------------------------------------------------
sub resetPlaybackRecoveryBufferState()
    m.recovery.bufferLastPercent = -1
    m.recovery.bufferLastPosition = 0
    m.recovery.bufferStalledSeconds = 0
    m.recovery.bufferAtHundredSeconds = 0
end sub

'-------------------------------------------------------------------------------
' onPlaybackRecoveryBufferTimerFire
'-------------------------------------------------------------------------------
sub onPlaybackRecoveryBufferTimerFire()
    if m.playback.phase <> PlaybackSession.Phase.Active then return
    if VideoPlayerState.Normalize(m.videoPlayer.state) <> VideoPlayerState.Value.Buffering then
        stopPlaybackRecoveryBufferMonitor()
        return
    end if

    percent = getPlaybackBufferPercent()
    position = Number.ToFloat(m.videoPlayer.position, 0)
    madeProgress = position > m.recovery.bufferLastPosition
    if percent >= 0 and percent > m.recovery.bufferLastPercent then madeProgress = true

    if madeProgress then
        m.recovery.bufferStalledSeconds = 0
    else
        m.recovery.bufferStalledSeconds = m.recovery.bufferStalledSeconds + 5
    end if

    if percent = 100 and madeProgress <> true then
        m.recovery.bufferAtHundredSeconds = m.recovery.bufferAtHundredSeconds + 5
    else
        m.recovery.bufferAtHundredSeconds = 0
    end if

    m.recovery.bufferLastPercent = percent
    m.recovery.bufferLastPosition = position
    if m.recovery.bufferAtHundredSeconds >= 10 then
        stopPlaybackRecoveryBufferMonitor()
        if handlePlaybackRecoveryFailure("bufferingStuckAt100", "Playback remained buffered at 100 percent.") <> true then
            finalizePlaybackRecoveryFailure("Unable to continue playback after recovery attempts.")
        end if
    else if m.recovery.bufferStalledSeconds >= 30 then
        stopPlaybackRecoveryBufferMonitor()
        if handlePlaybackRecoveryFailure("bufferingStalled", "Playback buffering stopped making progress.") <> true then
            finalizePlaybackRecoveryFailure("Unable to continue playback after recovery attempts.")
        end if
    end if
end sub

'-------------------------------------------------------------------------------
' getPlaybackBufferPercent
'-------------------------------------------------------------------------------
function getPlaybackBufferPercent() as integer
    status = m.videoPlayer.bufferingStatus
    if status = invalid or status.percentage = invalid then return -1
    return Number.ToInteger(status.percentage, -1)
end function

'-------------------------------------------------------------------------------
' onPlaybackRecoveryStableTimerFire
'-------------------------------------------------------------------------------
sub onPlaybackRecoveryStableTimerFire()
    if m.playback.phase <> PlaybackSession.Phase.Active then return
    if VideoPlayerState.Normalize(m.videoPlayer.state) <> VideoPlayerState.Value.Playing then return
    m.recovery.isStable = true
    m.recovery.sameModeRetryUsed = false
    m.log.write("Playback stable for 30 seconds; recovery retry state reset")
#if playbackChaosMonkey
    onPlaybackChaosMonkeyRecoveryStabilized()
#endif
end sub

'-------------------------------------------------------------------------------
' handlePrematurePlaybackFinish
'-------------------------------------------------------------------------------
function handlePrematurePlaybackFinish() as boolean
    if m.playback.prematureFinish = true then return true
    if m.activePlayback = invalid then return false

    ' A truncated stream can report its own short duration and an end position.
    ' Compare item metadata with the last position observed while playing/paused.
    duration = VideoPlayerMetadata_GetRuntimeSeconds(m.activePlayback.context.item)
    if duration <= 0 then return false
    ' An explicit endpoint seek may finish without another playing position.
    if m.recovery.pendingSeekTarget <> invalid and m.recovery.pendingSeekTarget >= duration then return false
    tolerance = duration * 0.02
    ' Allow two default Roku position-notification intervals for short clips.
    if tolerance < 1 then tolerance = 1
    if tolerance > 30 then tolerance = 30
    position = m.recovery.lastSafePosition
    ' A backward seek invalidates the old near-end position as completion
    ' evidence, even if Roku finishes before reporting the requested landing.
    if m.recovery.pendingSeekTarget <> invalid and m.recovery.pendingSeekTarget < position then position = m.recovery.pendingSeekTarget
    if duration - position <= tolerance then return false

    ' Freeze progress before stop/restart notifications can replace it with zero
    ' or the stream's terminal position. A new content assignment releases it.
    m.recovery.lastSafePosition = position
    m.playback.prematureFinish = true
    m.playback.position = position
    detail = "position=" + Format.SafeString(position, "") + " runtime=" + Format.SafeString(duration, "")
    m.log.write("Playback ended prematurely " + detail)
    reportPlaystateStop()
    emitPlaybackProgress(false)
    if handlePlaybackRecoveryFailure("prematureFinish", detail) <> true then
        finalizePlaybackRecoveryFailure("Playback ended early and could not be recovered. Your resume position has been saved.")
    end if
    return true
end function

'-------------------------------------------------------------------------------
' handlePlaybackRecoveryFailure
'-------------------------------------------------------------------------------
function handlePlaybackRecoveryFailure(reason as string, detail as string) as boolean
    request = m.pendingPlaybackRequest
    if request = invalid then request = getAcceptedOrPendingPlaybackRequest()
    if request = invalid or Format.SafeString(request.itemId, "") = "" then return false

    nextMode = ""
    attemptKind = ""
    playMethod = ""
    if reason <> "playbackInfo" then playMethod = getRecoveryPlayMethod(request)
    shouldForceNoRemux = playMethod = "" or playMethod = "directplay"
    if m.recovery.originalMode = PlaybackMode.Mode.AutomaticNoRemux and m.recovery.effectiveMode = PlaybackMode.Mode.AutomaticNoRemux and shouldForceNoRemux then
        nextMode = PlaybackMode.Mode.TranscodeNoRemux
        attemptKind = "fullTranscode"
    else if m.recovery.sameModeRetryUsed <> true then
        nextMode = m.recovery.effectiveMode
        attemptKind = "sameMode"
        m.recovery.sameModeRetryUsed = true
    else if m.recovery.originalMode = PlaybackMode.Mode.Automatic then
        if m.recovery.effectiveMode = PlaybackMode.Mode.Automatic then
            nextMode = PlaybackMode.Mode.TranscodeAllowRemux
            attemptKind = "allowRemux"
        else if m.recovery.effectiveMode = PlaybackMode.Mode.TranscodeAllowRemux then
            nextMode = PlaybackMode.Mode.TranscodeNoRemux
            attemptKind = "fullTranscode"
        end if
    end if

    if nextMode = "" then
        m.log.error("Playback recovery exhausted itemId=" + m.recovery.itemId + " reason=" + reason + " detail=" + detail + " effectiveMode=" + m.recovery.effectiveMode)
#if playbackChaosMonkey
        onPlaybackChaosMonkeyRecoveryExhausted(reason)
#endif
        return false
    end if

    failurePhase = "startup"
    if m.recovery.hasEverPlayed then failurePhase = "runtime"
    m.log.write("Playback recovery attempt itemId=" + m.recovery.itemId + " phase=" + failurePhase + " reason=" + reason + " detail=" + detail + " attempt=" + attemptKind + " fromMode=" + m.recovery.effectiveMode + " toMode=" + nextMode + " position=" + Format.SafeString(m.recovery.lastSafePosition, ""))
    restartRequest = buildStreamRestartPlayRequest()
    if restartRequest = invalid then return false

    restartRequest.startPositionTicks = secondsToTicks(m.recovery.lastSafePosition)
    restartRequest.videoMode = nextMode
    m.recovery.effectiveMode = nextMode
    m.recovery.isStable = false
    m.recovery.internalRestartPending = true
    m.log.activity("Restarting " + getPlaybackActivityTitle() + " using " + nextMode)
#if playbackChaosMonkey
    onPlaybackChaosMonkeyRecoveryStarted(reason)
#endif
    stopPlaybackRecoveryTimers()
    Spinner.Show(0)
    m.top.playRequest = restartRequest
    return true
end function

'-------------------------------------------------------------------------------
' getRecoveryPlayMethod
'-------------------------------------------------------------------------------
function getRecoveryPlayMethod(request as object) as string
    if m.activePlayback = invalid then return ""
    if Format.SafeString(m.activePlayback.session.itemId, "") <> Format.SafeString(request.itemId, "") then return ""
    return LCase(Format.SafeString(m.activePlayback.playMethod, ""))
end function

'-------------------------------------------------------------------------------
' finalizePlaybackRecoveryFailure
'-------------------------------------------------------------------------------
sub finalizePlaybackRecoveryFailure(message as string)
    m.log.activity("Playback failed for " + getPlaybackActivityTitle() + ": " + message)
    m.top.playbackFailed = message
#if playbackChaosMonkey
    stopPlaybackChaosMonkeyTimer()
#endif
    stopPlaybackRecoveryTimers()
    stopPlayback()
    AppMessage.Show(message)
end sub

'-------------------------------------------------------------------------------
' stopPlaybackRecoveryTimers
'-------------------------------------------------------------------------------
sub stopPlaybackRecoveryTimers()
    m.recoveryBufferTimer.control = TimerControl.Command.Stop
    m.recoveryStableTimer.control = TimerControl.Command.Stop
    if m.recovery <> invalid then m.recovery.bufferMonitoring = false
end sub
