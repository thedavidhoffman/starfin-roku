import "pkg:/source/MediaOptionsSession.bs"
import "pkg:/source/VideoMediaSummary.bs"

'-------------------------------------------------------------------------------
' updatePlaybackControlsOptions
'-------------------------------------------------------------------------------
sub updatePlaybackControlsOptions(item as dynamic)
    subtitleStreams = VideoPlayerStreamSelection.GetSubtitleStreams(item)
    audioStreams = VideoPlayerStreamSelection.GetAudioStreams(item)
    m.streamOptions.subtitleStreams = subtitleStreams
    m.streamOptions.audioStreams = audioStreams
    m.playbackControls.mediaInfoText = VideoMediaSummary.GetText(item, m.activePlayback.audioStreamIndex)
end sub

'-------------------------------------------------------------------------------
' commitLocalSubtitleSelection
'-------------------------------------------------------------------------------
function commitLocalSubtitleSelection(request as dynamic, streamIndex as integer, streamTitle as string) as boolean
    if m.activePlayback = invalid or request = invalid then return false

    acceptedRequest = PlaybackRequest.Create(request)
    if acceptedRequest = invalid then return false

    m.activePlayback.request = acceptedRequest
    m.activePlayback.subtitleStreamIndex = streamIndex
    m.activePlayback.subtitleStreamTitle = streamTitle
    m.pendingPlaybackRequest = acceptedRequest
    m.streamOptions.pendingExternalSubtitleUrl = ""
    return true
end function

'-------------------------------------------------------------------------------
' applyChapterSelection
'-------------------------------------------------------------------------------
sub applyChapterSelection(selection as dynamic)
    if selection = invalid or selection.startPositionSeconds = invalid then return

    targetPosition = selection.startPositionSeconds
    if m.playback.duration <> invalid and m.playback.duration > 0 then
        targetPosition = VideoPlayerMetadata.ClampSeconds(targetPosition, 0, m.playback.duration)
    end if

    stopSeekTimers()
    requestPlaybackSeek("chapterSelection", targetPosition)
    m.playback.isSeeking = false
    m.playback.previewPosition = targetPosition
    m.playback.position = targetPosition
    if m.playback.isPlaying = true then
        m.videoPlayer.control = MediaControl.Command.Resume
    else
        m.videoPlayer.control = MediaControl.Command.Pause
    end if

    m.playbackControls.isSeeking = false
    m.playbackControls.thumbnailData = {}
    m.playbackControls.position = targetPosition
    m.playbackControls.previewPosition = targetPosition
    m.log.activity("Selected chapter " + ActivityLog.Quote(selection.label, "chapter"))
end sub

'-------------------------------------------------------------------------------
' dispatchStreamRestart
'-------------------------------------------------------------------------------
function dispatchStreamRestart(request as dynamic, diagnosticMessage as string, activityMessage as string) as boolean
    if request = invalid then return false

    m.log.write(diagnosticMessage)
    m.log.activity(activityMessage)
    m.top.playRequest = request
    return true
end function


'-------------------------------------------------------------------------------
' onMediaOptionsPressed
'-------------------------------------------------------------------------------
sub onMediaOptionsPressed()
    if m.activePlayback = invalid or m.playback.startupPending then return
    if m.mediaOptions.session <> invalid or m.mediaOptions.pendingCommit <> invalid then return
    request = m.activePlayback.request
    item = getCurrentPlaybackItem(request)
    if item = invalid then return
    context = MediaOptionsSession.Context(item, getOriginalPlaybackMode(), m.activePlayback.audioStreamIndex, m.activePlayback.subtitleStreamIndex, m.streamOptions.audioStreams, m.streamOptions.subtitleStreams)
    context.playbackInfo = buildPlaybackInformation()
    m.mediaOptions.generation += 1
    context.generation = m.mediaOptions.generation
    state = VideoPlayerState.Normalize(m.videoPlayer.state)
    m.mediaOptions.session = {
        requestId: m.playback.requestId
        itemId: m.activePlayback.itemId
        context: context
        position: getCurrentPlaybackPosition()
        wasPlaying: state = VideoPlayerState.Value.Playing or state = VideoPlayerState.Value.Buffering
    }
    if m.mediaOptions.session.wasPlaying then m.videoPlayer.control = MediaControl.Command.Pause
    m.controlsHideTimer.control = TimerControl.Command.Stop
    m.top.overlayRequested = {
        id: MediaOptionsSession.Overlay.Options
        sourcePage: "videoPlayer"
        componentName: "MediaOptionsDialog"
        openFunction: "openMediaOptions"
        closeField: "closeRequested"
        optionsContext: context
    }
end sub

'-------------------------------------------------------------------------------
' handleStreamOptionsOverlayClosed
'-------------------------------------------------------------------------------
sub handleStreamOptionsOverlayClosed(closed as object)
    if closed = invalid then return
    session = m.mediaOptions.session
    if session = invalid or closed.request = invalid or closed.request.optionsContext = invalid then return
    if closed.request.optionsContext.generation <> session.context.generation then return
    m.mediaOptions.session = invalid
    if session = invalid or m.activePlayback = invalid then return
    if session.requestId <> m.playback.requestId or session.itemId <> m.activePlayback.itemId then return
    if closed.cancelled = true then
        if session.wasPlaying then m.videoPlayer.control = MediaControl.Command.Resume
        return
    end if
    if closed.overlay = invalid then return
    if closed.overlay.result = invalid then return
    m.mediaOptions.pendingCommit = { session: session, changes: closed.overlay.result }
    ' Wait for removal of the modal to render before rebuilding video content.
    m.mediaOptionsApplyTimer.control = TimerControl.Command.Start
end sub

'-------------------------------------------------------------------------------
' onMediaOptionsApplyTimerFire
'-------------------------------------------------------------------------------
sub onMediaOptionsApplyTimerFire()
    commit = m.mediaOptions.pendingCommit
    m.mediaOptions.pendingCommit = invalid
    if commit = invalid or m.activePlayback = invalid then return
    session = commit.session
    if session.requestId <> m.playback.requestId or session.itemId <> m.activePlayback.itemId then return
    changes = commit.changes
    requestChanges = {
        videoMode: getOriginalPlaybackMode()
        audioStreamIndex: m.activePlayback.audioStreamIndex
        subtitleStreamIndex: m.activePlayback.subtitleStreamIndex
    }
    restart = false
    if changes.videoMode <> invalid then
        requestChanges.videoMode = PlaybackMode.Normalize(changes.videoMode)
        restart = true
    end if
    if changes.audioStreamIndex <> invalid then
        requestChanges.audioStreamIndex = changes.audioStreamIndex
        restart = true
    end if
    subtitleTrack = ""
    subtitleTitle = "Off"
    if changes.subtitleStreamIndex <> invalid then
        requestChanges.subtitleStreamIndex = changes.subtitleStreamIndex
        subtitle = MediaOptionsSession.FindValue(session.context.subtitleOptions, changes.subtitleStreamIndex)
        if subtitle <> invalid then subtitleTitle = subtitle.label
        if changes.subtitleStreamIndex = SubtitleSelection.None then
            if m.streamOptions.activeSubtitleDeliveryMethod = "encode" then restart = true
        else
            external = SubtitlePlayback.FindExternalTrack(m.streamOptions.externalSubtitleTracks, changes.subtitleStreamIndex)
            if external <> invalid then subtitleTrack = SubtitlePlayback.FindAvailableTrackName(m.videoPlayer.availableSubtitleTracks, external.deliveryUrl)
            if subtitleTrack = "" or SubtitlePlayback.RequiresRestart(m.streamOptions.activeSubtitleDeliveryMethod, "external") then restart = true
        end if
    end if
    position = session.position
    if changes.chapter <> invalid then position = changes.chapter.startPositionSeconds
    if m.playback.duration > 0 then position = VideoPlayerMetadata.ClampSeconds(position, 0, m.playback.duration)
    request = PlaybackRequest.WithChanges(m.activePlayback.request, requestChanges)
    if restart then
        request = PlaybackRequest.WithChanges(request, {
            startPositionTicks: secondsToTicks(position)
            startPaused: session.wasPlaying <> true
            restoreMediaOptionsFocus: true
        })
        dispatchStreamRestart(request, "Applying combined media options", "Updated media options")
        return
    end if
    if changes.subtitleStreamIndex <> invalid then
        if commitLocalSubtitleSelection(request, changes.subtitleStreamIndex, subtitleTitle) then
            m.videoPlayer.subtitleTrack = subtitleTrack
            if changes.subtitleStreamIndex = SubtitleSelection.None then
                setSubtitleCaptionMode("Off")
                m.streamOptions.activeSubtitleDeliveryMethod = "none"
            else
                setSubtitleCaptionMode("On")
                m.streamOptions.activeSubtitleDeliveryMethod = "external"
            end if
            m.log.activity("Selected subtitles " + ActivityLog.Quote(subtitleTitle, "Off"))
        end if
    end if
    if changes.chapter <> invalid then applyChapterSelection(changes.chapter)
    if session.wasPlaying then
        m.videoPlayer.control = MediaControl.Command.Resume
    else
        m.videoPlayer.control = MediaControl.Command.Pause
    end if
    restoreMediaOptionsFocus()
end sub

'-------------------------------------------------------------------------------
' restoreMediaOptionsFocus
'-------------------------------------------------------------------------------
sub restoreMediaOptionsFocus()
    showControls(true)
    m.playbackControls.callFunc("focusMediaOptions")
end sub

'-------------------------------------------------------------------------------
' buildStreamRestartPlayRequest
'-------------------------------------------------------------------------------
function buildStreamRestartPlayRequest() as dynamic
    ' Recovery during resolution must retain the complete unaccepted selection.
    if m.pendingPlaybackRequest <> invalid and m.pendingPlaybackRequest.requestId = m.playback.requestId then
        if m.activePlayback = invalid or m.activePlayback.requestId <> m.playback.requestId then return PlaybackRequest.Create(m.pendingPlaybackRequest)
    end if
    request = getAcceptedOrPendingPlaybackRequest()
    if request = invalid then return invalid

    return PlaybackRequest.WithChanges(request, {
        startPositionTicks: secondsToTicks(m.playback.position)
        audioStreamIndex: m.activePlayback.audioStreamIndex
        subtitleStreamIndex: m.activePlayback.subtitleStreamIndex
        subtitleBurnInMode: SubtitleBurnIn.Normalize(request.subtitleBurnInMode)
        videoMode: getOriginalPlaybackMode()
    })
end function
