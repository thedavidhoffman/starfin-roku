import "pkg:/source/String.bs"
'-------------------------------------------------------------------------------
' initPlaybackActions
'-------------------------------------------------------------------------------
sub initPlaybackActions()
    m.playbackAction = {
        itemId: ""
        mode: PlaybackAction.Mode.None
        displayedSource: PlaybackAction.Source.None
        pendingCompletion: invalid
        randomSkipDismissed: false
        musicVideoMetadataDismissed: false
    }
end sub

'-------------------------------------------------------------------------------
' resetPlaybackActionsForItem
'-------------------------------------------------------------------------------
sub resetPlaybackActionsForItem(itemId as string)
    if m.playbackAction.itemId = itemId then return
    hidePlaybackActionButton()
    m.playbackAction.itemId = itemId
    m.playbackAction.randomSkipDismissed = false
    m.playbackAction.musicVideoMetadataDismissed = false
end sub

'-------------------------------------------------------------------------------
' updatePlaybackActionButton
'-------------------------------------------------------------------------------
sub updatePlaybackActionButton(position as dynamic)
    if m.activePlayback = invalid then
        hidePlaybackIntroPresentation()
        return
    end if

    resetPlaybackActionsForItem(m.activePlayback.session.itemId)
    if canShowPlaybackActionButton() <> true then
        hidePlaybackIntroPresentation()
        return
    end if

    item = getCurrentPlaybackItem(getAcceptedOrPendingPlaybackRequest())
    updateMusicVideoIntroMetadata(item, position)
    showRandomSkip = VideoPlayerMetadata.ShouldShowRandomMusicVideoSkip(item, m.activePlayback.queue.mode, m.activePlayback.queue.scope, hasQueueItemAtOffset(1), position, m.playbackAction.randomSkipDismissed)
    if showRandomSkip then
        showPlaybackActionButton(PlaybackAction.Mode.RandomSkip, "Skip")
        return
    end if

    activeIntro = getActiveIntroSegment(Number.ToFloat(position, 0))
    if activeIntro <> invalid then
        m.mediaSegments.activeEndSeconds = activeIntro.endSeconds
        showPlaybackActionButton(PlaybackAction.Mode.SkipIntro, "Skip Intro")
        return
    end if

    activeOutro = getActiveOutroSegment(Number.ToFloat(position, 0))
    if activeOutro <> invalid and hasQueueItemAtOffset(1) then
        m.mediaSegments.activeEndSeconds = activeOutro.endSeconds
        m.mediaSegments.activeOutroIsFallback = activeOutro.isFallback = true
        if NextItemPlayback.Normalize(m.activePlayback.request.nextItemPlayback) = NextItemPlayback.Mode.PlayNextImmediately then
            showPlaybackActionButton(PlaybackAction.Mode.PlayNext, "Play Next")
        else
            showPlaybackActionButton(PlaybackAction.Mode.SkipCredits, "Skip Credits")
        end if
        return
    end if

    hidePlaybackActionButton()
end sub

'-------------------------------------------------------------------------------
' updateMusicVideoIntroMetadata
'-------------------------------------------------------------------------------
sub updateMusicVideoIntroMetadata(item as dynamic, position as dynamic)
    playbackPosition = Number.ToFloat(position, 0)
    visible = VideoPlayerMetadata.IsMusicVideo(item) and playbackPosition >= 0 and playbackPosition < 5 and m.playbackAction.musicVideoMetadataDismissed <> true
    if visible <> true then
        hideMusicVideoIntroMetadata()
        return
    end if

    m.musicVideoArtistLabel.text = VideoPlayerMetadata.GetMusicVideoArtists(item)
    m.musicVideoTitleLabel.text = VideoPlayerMetadata.GetItemTitle(item)
    m.musicVideoIntroMetadata.visible = true
end sub

'-------------------------------------------------------------------------------
' canShowPlaybackActionButton
'-------------------------------------------------------------------------------
function canShowPlaybackActionButton() as boolean
    if m.playback.phase <> PlaybackSession.Phase.Active then return false
    if m.playbackAction.pendingCompletion <> invalid then return false
    if m.playback.isSeeking = true then return false
    if m.overlay.area <> "none" then return false
    return VideoPlayerState.Normalize(m.videoPlayer.state) = VideoPlayerState.Value.Playing
end function

'-------------------------------------------------------------------------------
' showPlaybackActionButton
'-------------------------------------------------------------------------------
sub showPlaybackActionButton(mode as string, text as string)
    source = getPlaybackActionSource(mode)
    presentationChanged = m.playbackActionButton.visible <> true or m.playbackAction.mode <> mode or m.playbackAction.displayedSource <> source
    if presentationChanged then logPlaybackAction("displayed", mode, source)
    m.playbackAction.mode = mode
    m.playbackAction.displayedSource = source
    m.playbackActionButton.text = text
    if m.playbackActionButton.visible = true then return

    m.playbackActionButton.visible = true
    m.playbackActionButton.hasFocusVisual = true
    m.top.setFocus(true)
end sub

'-------------------------------------------------------------------------------
' hidePlaybackActionButton
'-------------------------------------------------------------------------------
sub hidePlaybackActionButton()
    m.playbackAction.mode = PlaybackAction.Mode.None
    m.playbackAction.displayedSource = PlaybackAction.Source.None
    m.playbackActionButton.visible = false
    m.playbackActionButton.hasFocusVisual = false
end sub

'-------------------------------------------------------------------------------
' hideMusicVideoIntroMetadata
'-------------------------------------------------------------------------------
sub hideMusicVideoIntroMetadata()
    m.musicVideoIntroMetadata.visible = false
end sub

'-------------------------------------------------------------------------------
' hidePlaybackIntroPresentation
'-------------------------------------------------------------------------------
sub hidePlaybackIntroPresentation()
    hidePlaybackActionButton()
    hideMusicVideoIntroMetadata()
end sub

'-------------------------------------------------------------------------------
' dismissPlaybackAction
'-------------------------------------------------------------------------------
sub dismissPlaybackAction()
    dismissPlaybackActionPresentation(m.playbackAction.mode)
    m.top.setFocus(true)
end sub

'-------------------------------------------------------------------------------
' dismissPlaybackActionPresentation
'-------------------------------------------------------------------------------
sub dismissPlaybackActionPresentation(mode as string)
    if mode = PlaybackAction.Mode.RandomSkip then
        m.playbackAction.randomSkipDismissed = true
    else if mode = PlaybackAction.Mode.SkipIntro and m.mediaSegments.activeEndSeconds >= 0 then
        m.mediaSegments.introDismissedEndSeconds = m.mediaSegments.activeEndSeconds
    else if (mode = PlaybackAction.Mode.SkipCredits or mode = PlaybackAction.Mode.PlayNext) and m.mediaSegments.activeEndSeconds >= 0 then
        if m.mediaSegments.activeOutroIsFallback then
            ' A duration correction must not revive a dismissed episode prompt.
            m.mediaSegments.fallbackDismissedItemId = m.activePlayback.session.itemId
        else
            m.mediaSegments.outroDismissedEndSeconds = m.mediaSegments.activeEndSeconds
        end if
    end if
    m.playbackAction.musicVideoMetadataDismissed = true
    hidePlaybackIntroPresentation()
end sub

'-------------------------------------------------------------------------------
' onPlaybackActionSelected
'-------------------------------------------------------------------------------
sub onPlaybackActionSelected()
    if m.playbackAction.pendingCompletion <> invalid then return

    mode = m.playbackAction.mode
    if mode = PlaybackAction.Mode.SkipCredits or mode = PlaybackAction.Mode.PlayNext then
        logPlaybackAction("clicked", mode, getPlaybackActionSource(mode))
    end if
    dismissPlaybackActionPresentation(mode)
    if mode = PlaybackAction.Mode.RandomSkip then
        startQueueItemAtOffset(1)
    else if mode = PlaybackAction.Mode.SkipIntro then
        skipActiveIntro()
    else if mode = PlaybackAction.Mode.SkipCredits or mode = PlaybackAction.Mode.PlayNext then
        completeCurrentItemFromPlaybackAction(mode)
    end if
end sub

'-------------------------------------------------------------------------------
' getPlaybackActionSource
'-------------------------------------------------------------------------------
function getPlaybackActionSource(mode as string) as string
    if mode = PlaybackAction.Mode.SkipIntro then return PlaybackAction.Source.IntroSegment
    if mode = PlaybackAction.Mode.SkipCredits or mode = PlaybackAction.Mode.PlayNext then
        if m.mediaSegments.activeOutroIsFallback then return PlaybackAction.Source.NextEpisodeSetting
        return PlaybackAction.Source.OutroSegment
    end if
    return PlaybackAction.Source.None
end function

'-------------------------------------------------------------------------------
' logPlaybackAction
'-------------------------------------------------------------------------------
sub logPlaybackAction(eventName as string, mode as string, source as string)
    if source = PlaybackAction.Source.None then return
    message = "Playback action " + eventName + " action=" + mode + " itemId=" + m.activePlayback.session.itemId + " position=" + Strings.ToString(m.playback.position) + " source=" + source + " endSeconds=" + Strings.ToString(m.mediaSegments.activeEndSeconds)
    if source = PlaybackAction.Source.NextEpisodeSetting then
        message += " settingSeconds=" + NextEpisodePromptSeconds.Normalize(m.activePlayback.request.nextEpisodePromptSeconds)
    end if
    m.log.write(message)
end sub
