import "pkg:/source/String.bs"
'-------------------------------------------------------------------------------
' initMediaSegments
'-------------------------------------------------------------------------------
sub initMediaSegments()
    requestId = 0
    ' Preserve the sequence across resets so a same-item reload cannot reuse an ID.
    if m.mediaSegments <> invalid then requestId = m.mediaSegments.requestId
    m.mediaSegments = {
        requestId: requestId
        pending: false
        itemId: ""
        intros: []
        outros: []
        resolved: false
        introDismissedEndSeconds: -1
        outroDismissedEndSeconds: -1
        fallbackDismissedItemId: ""
        activeOutroIsFallback: false
        activeEndSeconds: -1
    }
end sub

'-------------------------------------------------------------------------------
' resetMediaSegments
'-------------------------------------------------------------------------------
sub resetMediaSegments()
    hidePlaybackActionButton()
    cancelMediaSegmentsLoad()
    initMediaSegments()
end sub

'-------------------------------------------------------------------------------
' cancelMediaSegmentsLoad
'-------------------------------------------------------------------------------
sub cancelMediaSegmentsLoad()
    m.mediaSegments.pending = false
    m.mediaSegmentsTask.control = TaskControl.Command.Stop
end sub

'-------------------------------------------------------------------------------
' loadMediaSegments
'-------------------------------------------------------------------------------
sub loadMediaSegments(playbackResponse as dynamic)
    if playbackResponse = invalid then return
    itemId = MovieVersions.MetadataItemId(m.activePlayback.request)
    if itemId = "" then return
    if m.mediaSegments.itemId = itemId and m.mediaSegments.resolved then return

    if m.mediaSegments.itemId <> itemId then
        resetMediaSegments()
    else
        cancelMediaSegmentsLoad()
    end if
    m.mediaSegments.itemId = itemId
    if VideoPlayerMediaSegments.HasSegments(playbackResponse.payload) <> true then
        resolveMediaSegments([])
        return
    end if

    m.log.write("Loading media segments itemId=" + m.activePlayback.session.itemId)
    m.mediaSegments.requestId++
    m.mediaSegments.pending = true
    m.mediaSegmentsTask.request = {
        requestId: m.mediaSegments.requestId
        server: m.activePlayback.session.server
        token: m.activePlayback.session.token
        itemId: itemId
    }
    m.mediaSegmentsTask.control = TaskControl.Command.Run
end sub

'-------------------------------------------------------------------------------
' onMediaSegmentsResponse
'-------------------------------------------------------------------------------
sub onMediaSegmentsResponse()
    response = m.mediaSegmentsTask.response
    if response = invalid or m.mediaSegments.pending <> true then return
    if Number.ToInteger(response.requestId, -1) <> m.mediaSegments.requestId then return
    if Strings.ToString(response.itemId) <> m.mediaSegments.itemId then return
    if Strings.ToString(response.itemId) <> MovieVersions.MetadataItemId(m.activePlayback.request) then return

    m.mediaSegments.pending = false
    if response.ok <> true then
        m.log.write("Unable to load media segments itemId=" + m.activePlayback.session.itemId + " error=" + Strings.ToString(response.errorMessage))
        return
    end if

    resolveMediaSegments(response.segments)
end sub

'-------------------------------------------------------------------------------
' resolveMediaSegments
'-------------------------------------------------------------------------------
sub resolveMediaSegments(segments as dynamic)
    m.mediaSegments.intros = VideoPlayerMediaSegments.BuildIntros(segments)
    m.mediaSegments.outros = VideoPlayerMediaSegments.BuildOutros(segments)
    m.mediaSegments.resolved = true
    m.log.write("Media segments resolved itemId=" + m.activePlayback.session.itemId + " introCount=" + m.mediaSegments.intros.Count().ToStr() + " outroCount=" + m.mediaSegments.outros.Count().ToStr())
    updatePlaybackActionButton(m.playback.position)
end sub

'-------------------------------------------------------------------------------
' getActiveIntroSegment
'-------------------------------------------------------------------------------
function getActiveIntroSegment(position as float) as dynamic
    if m.mediaSegments = invalid then return invalid
    result = VideoPlayerMediaSegments.EvaluateIntro(m.mediaSegments.intros, position, m.mediaSegments.introDismissedEndSeconds)
    m.mediaSegments.introDismissedEndSeconds = result.dismissedEndSeconds
    return result.activeIntro
end function

'-------------------------------------------------------------------------------
' getActiveOutroSegment
'-------------------------------------------------------------------------------
function getActiveOutroSegment(position as float) as dynamic
    if m.mediaSegments = invalid then return invalid

    ' Official ranges exclude fallback even when no official range is active.
    if m.mediaSegments.outros.Count() > 0 then return getActiveOfficialOutroSegment(position)
    if m.mediaSegments.resolved <> true then return invalid
    return getActiveFallbackOutroSegment(position)
end function

'-------------------------------------------------------------------------------
' getActiveOfficialOutroSegment
'-------------------------------------------------------------------------------
function getActiveOfficialOutroSegment(position as float) as dynamic
    result = VideoPlayerMediaSegments.EvaluateOutro(m.mediaSegments.outros, position, m.mediaSegments.outroDismissedEndSeconds)
    m.mediaSegments.outroDismissedEndSeconds = result.dismissedEndSeconds
    if result.activeOutro = invalid then return invalid
    return {
        startSeconds: result.activeOutro.startSeconds
        endSeconds: result.activeOutro.endSeconds
        isFallback: false
    }
end function

'-------------------------------------------------------------------------------
' getActiveFallbackOutroSegment
'-------------------------------------------------------------------------------
function getActiveFallbackOutroSegment(position as float) as dynamic
    if m.mediaSegments.fallbackDismissedItemId = m.activePlayback.session.itemId then return invalid

    item = getCurrentPlaybackItem(getAcceptedOrPendingPlaybackRequest())
    outros = VideoPlayerMediaSegments.BuildFallbackOutro(item, m.playback.duration, m.activePlayback.request.nextEpisodePromptSeconds)
    ' Fallback dismissal follows the episode, not the derived range's end time.
    result = VideoPlayerMediaSegments.EvaluateOutro(outros, position, -1)
    if result.activeOutro = invalid then return invalid
    return {
        startSeconds: result.activeOutro.startSeconds
        endSeconds: result.activeOutro.endSeconds
        isFallback: true
    }
end function

'-------------------------------------------------------------------------------
' skipActiveIntro
'-------------------------------------------------------------------------------
sub skipActiveIntro()
    targetPosition = m.mediaSegments.activeEndSeconds
    if targetPosition < 0 then return

    m.log.write("Skipping intro itemId=" + m.activePlayback.session.itemId + " position=" + Strings.ToString(m.playback.position) + " target=" + Strings.ToString(targetPosition))
    m.log.activity("Skipped intro for " + getPlaybackActivityTitle())
    m.mediaSegments.introDismissedEndSeconds = targetPosition
    stopSeekTimers()
    m.playback.isSeeking = false
    m.playback.position = targetPosition
    m.playback.previewPosition = targetPosition
    m.playbackControls.position = targetPosition
    m.playbackControls.previewPosition = targetPosition
    requestPlaybackSeek("skipIntro", targetPosition)
    m.videoPlayer.control = MediaControl.Command.Resume
    m.top.setFocus(true)
    reportPlaystateUpdate()
end sub
