#if playbackChaosMonkey
'-------------------------------------------------------------------------------
' initPlaybackChaosMonkey
'-------------------------------------------------------------------------------
sub initPlaybackChaosMonkey()
    timer = CreateObject("roSGNode", "Timer")
    timer.repeat = false
    timer.observeField("fire", "onPlaybackChaosMonkeyTimerFire")
    m.top.appendChild(timer)

    indicator = CreateObject("roSGNode", "Group")
    indicator.translation = [72, 36]
    indicator.visible = false

    background = indicator.createChild("Rectangle")
    background.width = 352
    background.height = 48
    background.color = &hA51D24EE

    label = indicator.createChild("Label")
    label.translation = [0, 3]
    label.width = 352
    label.height = 48
    label.text = "CHAOS MONKEY 0"
    label.horizAlign = "center"
    label.vertAlign = "center"
    label.color = &hFFFFFFFF
    label.font = "font:SmallSystemFont"
    m.top.appendChild(indicator)

    m.chaosMonkey = {
        timer: timer
        indicator: indicator
        label: label
        enabled: false
        awaitingRecovery: false
        injectionCount: 0
        incidentReason: ""
        incidentDetail: ""
        remainingFailures: 0
        scheduledSeconds: 0
        scheduled: false
    }
end sub

'-------------------------------------------------------------------------------
' beginPlaybackChaosMonkeyRequest
'-------------------------------------------------------------------------------
sub beginPlaybackChaosMonkeyRequest(request as dynamic, isRecoveryRestart as boolean)
    stopPlaybackChaosMonkeyTimer()
    if isRecoveryRestart then return

    m.chaosMonkey.enabled = true
    m.chaosMonkey.awaitingRecovery = false
    m.chaosMonkey.injectionCount = 0
    m.chaosMonkey.label.text = "CHAOS MONKEY 0"
    m.chaosMonkey.incidentReason = ""
    m.chaosMonkey.incidentDetail = ""
    m.chaosMonkey.remainingFailures = 0
    m.chaosMonkey.scheduledSeconds = 0
    m.chaosMonkey.scheduled = false
    m.chaosMonkey.indicator.visible = true
    m.log.write("Playback Chaos Monkey enabled itemId=" + Format.SafeString(request.itemId, ""))
end sub

'-------------------------------------------------------------------------------
' onPlaybackChaosMonkeyStateChanged
'-------------------------------------------------------------------------------
sub onPlaybackChaosMonkeyStateChanged(state as string)
    if m.chaosMonkey.enabled <> true then return
    if state <> VideoPlayerState.Value.Playing then
        stopPlaybackChaosMonkeyTimer()
        return
    end if
    if m.chaosMonkey.awaitingRecovery then return
    schedulePlaybackChaosMonkey()
end sub

'-------------------------------------------------------------------------------
' schedulePlaybackChaosMonkey
'-------------------------------------------------------------------------------
sub schedulePlaybackChaosMonkey()
    if m.chaosMonkey.enabled <> true or m.chaosMonkey.awaitingRecovery then return
    if VideoPlayerState.Normalize(m.videoPlayer.state) <> VideoPlayerState.Value.Playing then return
    if m.chaosMonkey.scheduled then return

    delaySeconds = Rnd(31) + 29
    m.chaosMonkey.scheduledSeconds = delaySeconds
    m.chaosMonkey.scheduled = true
    m.chaosMonkey.timer.duration = delaySeconds
    m.chaosMonkey.timer.control = TimerControl.Command.Stop
    m.chaosMonkey.timer.control = TimerControl.Command.Start
    m.log.write("Playback Chaos Monkey scheduled itemId=" + m.recovery.itemId + " delaySeconds=" + Format.SafeString(delaySeconds, "") + " position=" + Format.SafeString(m.recovery.lastSafePosition, ""))
end sub

'-------------------------------------------------------------------------------
' canRunPlaybackChaosMonkey
'-------------------------------------------------------------------------------
function canRunPlaybackChaosMonkey() as boolean
    if m.chaosMonkey.enabled <> true or m.chaosMonkey.awaitingRecovery then return false
    if VideoPlayerState.Normalize(m.videoPlayer.state) <> VideoPlayerState.Value.Playing then return false
    if m.playback.isSeeking then return false
    if m.streamOptions.pendingVideoMode <> "" then return false
    if m.overlay.area <> "none" then return false
    if isPlaybackRecoveryRestarting() then return false
    return true
end function

'-------------------------------------------------------------------------------
' onPlaybackChaosMonkeyTimerFire
'-------------------------------------------------------------------------------
sub onPlaybackChaosMonkeyTimerFire()
    stopPlaybackChaosMonkeyTimer()
    if canRunPlaybackChaosMonkey() <> true then
        m.chaosMonkey.scheduledSeconds = 5
        m.chaosMonkey.scheduled = true
        m.chaosMonkey.timer.duration = 5
        m.chaosMonkey.timer.control = TimerControl.Command.Start
        return
    end if

    failureTypes = [
        { reason: "videoError", detail: "Chaos Monkey injected a video playback error." }
        { reason: "playbackInfo", detail: "Chaos Monkey injected a playback-info failure." }
        { reason: "bufferingStalled", detail: "Chaos Monkey injected stalled buffering." }
        { reason: "bufferingStuckAt100", detail: "Chaos Monkey injected buffering stuck at 100 percent." }
    ]
    failure = failureTypes[Rnd(failureTypes.Count()) - 1]
    m.chaosMonkey.awaitingRecovery = true
    m.chaosMonkey.injectionCount = m.chaosMonkey.injectionCount + 1
    m.chaosMonkey.label.text = "CHAOS MONKEY " + Format.SafeString(m.chaosMonkey.injectionCount, "")
    m.chaosMonkey.incidentReason = failure.reason
    m.chaosMonkey.incidentDetail = failure.detail
    followupLimit = getPlaybackChaosMonkeyFollowupLimit()
    m.chaosMonkey.remainingFailures = Rnd(followupLimit + 1) - 1
    m.log.write("Playback Chaos Monkey injecting itemId=" + m.recovery.itemId + " injection=" + Format.SafeString(m.chaosMonkey.injectionCount, "") + " reason=" + failure.reason + " followupFailures=" + Format.SafeString(m.chaosMonkey.remainingFailures, "") + " effectiveMode=" + m.recovery.effectiveMode + " position=" + Format.SafeString(m.recovery.lastSafePosition, ""))

    reportPlaystateStop()
    if handlePlaybackRecoveryFailure(failure.reason, failure.detail) then return
    finalizePlaybackRecoveryFailure("Unable to continue playback after recovery attempts.")
end sub

'-------------------------------------------------------------------------------
' getPlaybackChaosMonkeyFollowupLimit
'-------------------------------------------------------------------------------
function getPlaybackChaosMonkeyFollowupLimit() as integer
    if m.recovery.originalMode = PlaybackMode.Mode.AutomaticNoRemux then return 1
    if m.recovery.originalMode <> PlaybackMode.Mode.Automatic then return 0
    if m.recovery.effectiveMode = PlaybackMode.Mode.Automatic then return 2
    if m.recovery.effectiveMode = PlaybackMode.Mode.TranscodeAllowRemux then return 1
    return 0
end function

'-------------------------------------------------------------------------------
' consumePlaybackChaosMonkeyStartupFailure
'-------------------------------------------------------------------------------
function consumePlaybackChaosMonkeyStartupFailure() as boolean
    if m.chaosMonkey.enabled <> true or m.chaosMonkey.awaitingRecovery <> true then return false
    if m.chaosMonkey.remainingFailures <= 0 then return false

    m.chaosMonkey.remainingFailures = m.chaosMonkey.remainingFailures - 1
    reason = m.chaosMonkey.incidentReason
    detail = m.chaosMonkey.incidentDetail
    m.log.write("Playback Chaos Monkey continuing incident itemId=" + m.recovery.itemId + " reason=" + reason + " remainingFailures=" + Format.SafeString(m.chaosMonkey.remainingFailures, "") + " effectiveMode=" + m.recovery.effectiveMode)
    if handlePlaybackRecoveryFailure(reason, detail) then return true

    finalizePlaybackRecoveryFailure("Unable to continue playback after recovery attempts.")
    return true
end function

'-------------------------------------------------------------------------------
' onPlaybackChaosMonkeyRecoveryStarted
'-------------------------------------------------------------------------------
sub onPlaybackChaosMonkeyRecoveryStarted(reason as string)
    if m.chaosMonkey.enabled <> true then return
    stopPlaybackChaosMonkeyTimer()
    m.chaosMonkey.awaitingRecovery = true
    m.log.write("Playback Chaos Monkey observing recovery itemId=" + m.recovery.itemId + " reason=" + reason)
end sub

'-------------------------------------------------------------------------------
' onPlaybackChaosMonkeyRecoveryStabilized
'-------------------------------------------------------------------------------
sub onPlaybackChaosMonkeyRecoveryStabilized()
    if m.chaosMonkey.enabled <> true then return
    if m.chaosMonkey.awaitingRecovery then
        m.log.write("Playback Chaos Monkey recovery stabilized itemId=" + m.recovery.itemId + " effectiveMode=" + m.recovery.effectiveMode + " position=" + Format.SafeString(m.recovery.lastSafePosition, ""))
    end if
    m.chaosMonkey.awaitingRecovery = false
    m.chaosMonkey.incidentReason = ""
    m.chaosMonkey.incidentDetail = ""
    m.chaosMonkey.remainingFailures = 0
    schedulePlaybackChaosMonkey()
end sub

'-------------------------------------------------------------------------------
' onPlaybackChaosMonkeyRecoveryExhausted
'-------------------------------------------------------------------------------
sub onPlaybackChaosMonkeyRecoveryExhausted(reason as string)
    if m.chaosMonkey.enabled <> true then return
    stopPlaybackChaosMonkeyTimer()
    m.chaosMonkey.awaitingRecovery = false
    m.chaosMonkey.incidentReason = ""
    m.chaosMonkey.incidentDetail = ""
    m.chaosMonkey.remainingFailures = 0
    m.log.error("Playback Chaos Monkey recovery exhausted itemId=" + m.recovery.itemId + " reason=" + reason + " effectiveMode=" + m.recovery.effectiveMode)
end sub

'-------------------------------------------------------------------------------
' stopPlaybackChaosMonkeyTimer
'-------------------------------------------------------------------------------
sub stopPlaybackChaosMonkeyTimer()
    m.chaosMonkey.timer.control = TimerControl.Command.Stop
    m.chaosMonkey.scheduledSeconds = 0
    m.chaosMonkey.scheduled = false
end sub

'-------------------------------------------------------------------------------
' stopPlaybackChaosMonkey
'-------------------------------------------------------------------------------
sub stopPlaybackChaosMonkey()
    stopPlaybackChaosMonkeyTimer()
    m.chaosMonkey.enabled = false
    m.chaosMonkey.awaitingRecovery = false
    m.chaosMonkey.incidentReason = ""
    m.chaosMonkey.incidentDetail = ""
    m.chaosMonkey.remainingFailures = 0
    m.chaosMonkey.indicator.visible = false
end sub
#endif
