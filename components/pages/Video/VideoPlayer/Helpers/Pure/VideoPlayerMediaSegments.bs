'-------------------------------------------------------------------------------
' VideoPlayerMediaSegments_HasSegments
'-------------------------------------------------------------------------------
function VideoPlayerMediaSegments_HasSegments(playbackInfo as dynamic) as boolean
    if playbackInfo = invalid or playbackInfo.MediaSources = invalid then return false
    if playbackInfo.MediaSources.Count() = 0 or playbackInfo.MediaSources[0] = invalid then return false
    return playbackInfo.MediaSources[0].HasSegments = true
end function

'-------------------------------------------------------------------------------
' VideoPlayerMediaSegments_BuildIntros
'-------------------------------------------------------------------------------
function VideoPlayerMediaSegments_BuildIntros(segments as dynamic) as object
    intros = []
    if segments = invalid then return intros
    for each segment in segments
        if segment <> invalid and LCase(Format.SafeString(segment.Type, "")) = "intro" then
            startSeconds = Number.ToFloat(segment.StartTicks, 0.0) / 10000000
            endSeconds = Number.ToFloat(segment.EndTicks, 0.0) / 10000000
            if endSeconds > startSeconds then intros.Push({ startSeconds: startSeconds, endSeconds: endSeconds })
        end if
    end for
    return intros
end function

'-------------------------------------------------------------------------------
' VideoPlayerMediaSegments_EvaluateIntro
'-------------------------------------------------------------------------------
function VideoPlayerMediaSegments_EvaluateIntro(intros as dynamic, position as float, dismissedEndSeconds as float) as object
    result = { activeIntro: invalid, dismissedEndSeconds: dismissedEndSeconds }
    if intros = invalid then return result

    for each intro in intros
        if intro <> invalid and position >= intro.startSeconds and position < intro.endSeconds - 5 then
            if intro.endSeconds <> dismissedEndSeconds then result.activeIntro = intro
            return result
        end if
    end for

    if dismissedEndSeconds >= 0 and position >= dismissedEndSeconds then result.dismissedEndSeconds = -1
    return result
end function
