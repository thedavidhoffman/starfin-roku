'-------------------------------------------------------------------------------
' onPlayRequestChanged
'-------------------------------------------------------------------------------
sub onPlayRequestChanged()
    incomingRequest = m.top.playRequest
    if incomingRequest = invalid then return

    m.playback.requestId = m.playback.requestId + 1
    request = PlaybackRequest.WithRequestId(incomingRequest, m.playback.requestId)
    m.pendingPlaybackRequest = request
    m.episodeQueueTask.control = "stop"
    episodeQueueCancelPending()
    isRecoveryRestart = m.recovery.internalRestartPending = true
    logPlaybackRequest(request, isRecoveryRestart)
    stopPlayback(isRecoveryRestart)
    isRecoveryRestart = beginPlaybackRecoveryRequest(request)
#if playbackChaosMonkey
    beginPlaybackChaosMonkeyRequest(request, isRecoveryRestart)
#endif
    m.playback.startupPending = true
    Spinner.Show(0)

    m.playbackInfoTask.request = request
    m.playbackInfoTask.control = "run"
end sub

'-------------------------------------------------------------------------------
' onPlaybackInfoResponse
'-------------------------------------------------------------------------------
sub onPlaybackInfoResponse()
    response = m.playbackInfoTask.response
    if response = invalid then return
    responseRequestId = Number.ToInteger(response.requestId, -1)
    if responseRequestId <> m.playback.requestId then
        m.log.write("Ignoring stale playback info response responseRequestId=" + Format.SafeString(responseRequestId, "") + " currentRequestId=" + Format.SafeString(m.playback.requestId, ""))
        return
    end if

#if playbackChaosMonkey
    if response.ok = true and consumePlaybackChaosMonkeyStartupFailure() then return
#endif

    if response.ok <> true then
        m.playback.startupPending = false
        errorMessage = Format.SafeString(response.errorMessage, "Unable to play this item.")
        if handlePlaybackRecoveryFailure("playbackInfo", errorMessage) then return
        Spinner.Hide()
        finalizePlaybackRecoveryFailure("Unable to play this item after recovery attempts.")
        return
    end if

    applyPlaybackResponse(response, m.pendingPlaybackRequest)
end sub

'-------------------------------------------------------------------------------
' applyPlaybackResponse
'-------------------------------------------------------------------------------
sub applyPlaybackResponse(response as object, request as object)
    if response = invalid or request = invalid then return

    item = response.item
    startPositionSeconds = PlaybackProgress.TicksToSeconds(response.startPositionTicks)
    if request.subtitleStreamIndex = invalid then
        request = PlaybackRequest.WithChanges(request, { subtitleStreamIndex: response.subtitleStreamIndex })
        m.pendingPlaybackRequest = request
    end if

    applyPlaybackSessionState(response, request, item)
    loadMediaSegments(response)
    content = buildVideoContent(response, request, item, startPositionSeconds)
    resetPlaybackForStart(item, startPositionSeconds)
    updatePlaybackOverlayData(request, item)
    startVideoContent(content, response, startPositionSeconds)
end sub

'-------------------------------------------------------------------------------
' applyPlaybackSessionState
'-------------------------------------------------------------------------------
sub applyPlaybackSessionState(response as object, request as object, item as dynamic)
    m.activePlayback = ActivePlayback.Create(request, response)
    initializeEpisodeQueue(request, item)
    updatePlaybackSkipAvailability(request, item)
    m.trickplay = buildTrickplayState(item, m.activePlayback.session.itemId)
    startTrickplayPreload()
end sub

'-------------------------------------------------------------------------------
' updatePlaybackSkipAvailability
'-------------------------------------------------------------------------------
sub updatePlaybackSkipAvailability(request as object, item as dynamic)
    isEpisode = VideoPlayerMetadata_IsEpisode(request, item)
    isMovie = VideoPlayerMetadata_IsMovie(request, item)
    m.playbackControls.skipBackEnabled = isEpisode or isMovie
    m.playbackControls.skipForwardEnabled = (isEpisode or isMovie) and hasQueueItemAtOffset(1)
end sub

'-------------------------------------------------------------------------------
' hasQueueItemAtOffset
'-------------------------------------------------------------------------------
function hasQueueItemAtOffset(offset as integer) as boolean
    return episodeQueueHasItemAtOffset(offset)
end function

'-------------------------------------------------------------------------------
' getQueueItemAtOffset
'-------------------------------------------------------------------------------
function getQueueItemAtOffset(offset as integer) as dynamic
    return episodeQueueGetItemAtOffset(offset)
end function

'-------------------------------------------------------------------------------
' onSkipBackPressed
'-------------------------------------------------------------------------------
sub onSkipBackPressed()
    request = getAcceptedOrPendingPlaybackRequest()
    item = getCurrentPlaybackItem(request)
    if VideoPlayerMetadata_IsEpisode(request, item) <> true and VideoPlayerMetadata_IsMovie(request, item) <> true then return

    if (VideoPlayerMetadata_IsEpisode(request, item) = true or VideoPlayerMetadata_IsMovie(request, item) = true) and getCurrentPlaybackPosition() < 15 then
        if startQueueItemAtOffset(-1) = true then return
    end if

    restartCurrentPlayback()
end sub

'-------------------------------------------------------------------------------
' onSkipForwardPressed
'-------------------------------------------------------------------------------
sub onSkipForwardPressed()
    request = getAcceptedOrPendingPlaybackRequest()
    item = getCurrentPlaybackItem(request)

    if VideoPlayerMetadata_IsEpisode(request, item) <> true and VideoPlayerMetadata_IsMovie(request, item) <> true then return
    startQueueItemAtOffset(1)
end sub

'-------------------------------------------------------------------------------
' getCurrentPlaybackItem
'-------------------------------------------------------------------------------
function getCurrentPlaybackItem(request as dynamic) as dynamic
    if m.activePlayback <> invalid and m.activePlayback.context.item <> invalid then return m.activePlayback.context.item
    if request <> invalid then return request.item

    return invalid
end function

'-------------------------------------------------------------------------------
' restartCurrentPlayback
'-------------------------------------------------------------------------------
sub restartCurrentPlayback()
    stopSeekTimers()
    targetPosition = 0
    logPlaybackSeekRequest("restartCurrentPlayback", targetPosition)
    m.playback.isSeeking = false
    m.playback.previewPosition = targetPosition
    m.playback.position = targetPosition
    m.videoPlayer.seek = targetPosition
    if m.playback.isPlaying = true then
        m.videoPlayer.control = "resume"
    else
        m.videoPlayer.control = "pause"
    end if

    m.playbackControls.isSeeking = false
    m.playbackControls.thumbnailData = {}
    m.playbackControls.position = targetPosition
    m.playbackControls.previewPosition = targetPosition
    showControls(true)
end sub

'-------------------------------------------------------------------------------
' startQueueItemAtOffset
'-------------------------------------------------------------------------------
function startQueueItemAtOffset(offset as integer) as boolean
    queueItem = getQueueItemAtOffset(offset)
    if queueItem = invalid then return false
    if Format.SafeString(queueItem.itemId, "") = "" then return false

    emitPlaybackProgress(false)
    m.top.playRequest = buildQueuePlaybackRequest(queueItem, m.activePlayback.queue.index + offset)
    return true
end function

'-------------------------------------------------------------------------------
' buildQueuePlaybackRequest
'-------------------------------------------------------------------------------
function buildQueuePlaybackRequest(queueItem as object, queueIndex as integer) as object
    series = m.activePlayback.context.series
    season = m.activePlayback.context.season
    if queueItem.hasPlaybackContext = true then
        series = queueItem.series
        season = queueItem.season
    else
        if queueItem.series <> invalid then series = queueItem.series
        if queueItem.season <> invalid then season = queueItem.season
    end if

    request = {
        server: m.activePlayback.session.server
        token: m.activePlayback.session.token
        userId: m.activePlayback.session.userId
        itemId: Format.SafeString(queueItem.itemId, "")
        item: queueItem.item
        series: series
        season: season
        startPositionTicks: 0
        playbackQueue: m.activePlayback.queue.items
        playbackQueueIndex: queueIndex
        playbackQueueMode: m.activePlayback.queue.mode
        playbackQueueScope: m.activePlayback.queue.scope
        tracksPlaybackProgress: m.activePlayback.request.tracksPlaybackProgress
        nextItemPlayback: NextItemPlayback.Normalize(m.activePlayback.request.nextItemPlayback)
        videoMode: getOriginalPlaybackMode()
        subtitleBurnInMode: SubtitleBurnIn.Normalize(m.activePlayback.request.subtitleBurnInMode)
    }
    EpisodeQueueIdentity.Apply(request, m.activePlayback.queue.scope, m.episodeQueue.id)
    return request
end function

'-------------------------------------------------------------------------------
' isPlaylistPlaybackQueue
'-------------------------------------------------------------------------------
function isPlaylistPlaybackQueue() as boolean
    if m.activePlayback = invalid or m.activePlayback.queue.items = invalid then return false
    if m.activePlayback.queue.index < 0 or m.activePlayback.queue.index >= m.activePlayback.queue.items.Count() then return false

    currentItem = m.activePlayback.queue.items[m.activePlayback.queue.index]
    return currentItem <> invalid and currentItem.hasPlaybackContext = true
end function

'-------------------------------------------------------------------------------
' buildVideoContent
'-------------------------------------------------------------------------------
function buildVideoContent(response as object, request as object, item as dynamic, startPositionSeconds as integer) as object
    content = CreateObject("roSGNode", "ContentNode")
    content.url = response.streamUrl
    content.streamFormat = response.streamFormat
    content.title = VideoPlayerMetadata_GetItemTitle(item)
    content.PlayStart = startPositionSeconds
    content.AddHeader("Authorization", JellyfinAuth.BuildAuthorizationHeader(request.token, request.userId))

    m.streamOptions.pendingExternalSubtitleUrl = ""
    m.streamOptions.activeSubtitleDeliveryMethod = SubtitlePlayback.NormalizeDeliveryMethod(response.subtitleDeliveryMethod)
    m.streamOptions.externalSubtitleTracks = response.externalSubtitleTracks
    if m.streamOptions.externalSubtitleTracks = invalid then m.streamOptions.externalSubtitleTracks = []
    rokuSubtitleTracks = []
    for each externalTrack in m.streamOptions.externalSubtitleTracks
        rokuSubtitleTracks.Push(externalTrack.track)
    end for
    if rokuSubtitleTracks.Count() > 0 then content.SubtitleTracks = rokuSubtitleTracks
    if response.externalSubtitleTrack <> invalid then
        m.streamOptions.pendingExternalSubtitleUrl = response.externalSubtitleTrack.deliveryUrl
    end if
    m.log.write("Subtitle content resolvedIndex=" + Format.SafeString(response.subtitleStreamIndex, "") + " externalTrackAttached=" + boolToText(response.externalSubtitleTrack <> invalid))

    return content
end function

'-------------------------------------------------------------------------------
' resetPlaybackForStart
'-------------------------------------------------------------------------------
sub resetPlaybackForStart(item as dynamic, startPositionSeconds as integer)
    m.playback.duration = VideoPlayerMetadata_GetRuntimeSeconds(item)
    m.playback.hasEmittedFinalProgress = false
    m.playback.position = startPositionSeconds
    m.playback.waitingForStartPosition = startPositionSeconds > 0
    m.playback.previewPosition = startPositionSeconds
    resetSeekState()
    m.playbackControls.duration = m.playback.duration
    m.playbackControls.position = startPositionSeconds
    m.playbackControls.previewPosition = startPositionSeconds
    m.playbackControls.isSeeking = false
    m.playbackControls.thumbnailData = {}
end sub

'-------------------------------------------------------------------------------
' updatePlaybackOverlayData
'-------------------------------------------------------------------------------
sub updatePlaybackOverlayData(request as object, item as dynamic)
    updatePlaybackControlsMetadata(request, item)
    updateCast(request, item)
    updatePlaybackControlsOptions(item)
    hideCast()
end sub

'-------------------------------------------------------------------------------
' startVideoContent
'-------------------------------------------------------------------------------
sub startVideoContent(content as object, response as object, startPositionSeconds as integer)
    logPlaybackContentAssignment(response, startPositionSeconds)
    m.videoPlayer.content = content
    if m.streamOptions.pendingExternalSubtitleUrl = "" then
        setSubtitleCaptionMode("Off")
        m.videoPlayer.subtitleTrack = ""
    end if
    m.top.setFocus(true)
    updateBufferingSpinner(VideoPlayerState.Value.Buffering)
    m.videoPlayer.control = "play"
    AppStatus.ClearMessage()
end sub

'-------------------------------------------------------------------------------
' onAvailableSubtitleTracksChanged
'-------------------------------------------------------------------------------
sub onAvailableSubtitleTracksChanged()
    deliveryUrl = m.streamOptions.pendingExternalSubtitleUrl
    if deliveryUrl = "" then return

    trackName = SubtitlePlayback.FindAvailableTrackName(m.videoPlayer.availableSubtitleTracks, deliveryUrl)
    if trackName = "" then return

    setSubtitleCaptionMode("On")
    m.videoPlayer.subtitleTrack = trackName
    m.log.write("External subtitle track selected resolvedIndex=" + Format.SafeString(m.activePlayback.subtitleStreamIndex, ""))
end sub

'-------------------------------------------------------------------------------
' setSubtitleCaptionMode
'-------------------------------------------------------------------------------
sub setSubtitleCaptionMode(captionMode as string)
    if m.streamOptions.captionModeCaptured <> true then
        m.streamOptions.originalCaptionMode = m.videoPlayer.globalCaptionMode
        m.streamOptions.captionModeCaptured = true
    end if
    m.videoPlayer.globalCaptionMode = captionMode
end sub

'-------------------------------------------------------------------------------
' cleanupSubtitlePlayback
'-------------------------------------------------------------------------------
sub cleanupSubtitlePlayback()
    m.videoPlayer.subtitleTrack = ""
    m.streamOptions.pendingExternalSubtitleUrl = ""
    m.streamOptions.externalSubtitleTracks = []
    m.streamOptions.activeSubtitleDeliveryMethod = "none"
    if m.streamOptions.captionModeCaptured = true then
        m.videoPlayer.globalCaptionMode = m.streamOptions.originalCaptionMode
    end if
    m.streamOptions.captionModeCaptured = false
    m.streamOptions.originalCaptionMode = invalid
end sub

'-------------------------------------------------------------------------------
' onPlaystateTimerFire
'-------------------------------------------------------------------------------
sub onPlaystateTimerFire()
    reportPlaystateUpdate()
end sub

'-------------------------------------------------------------------------------
' emitPlaybackProgress
'-------------------------------------------------------------------------------
sub emitPlaybackProgress(isFinished as boolean)
    if m.activePlayback = invalid then return
    if m.activePlayback.session.itemId = "" then return
    if tracksCurrentPlaybackProgress() <> true then return
    if m.playback.hasEmittedFinalProgress = true then return

    position = getCurrentPlaybackPosition()
    duration = m.playback.duration
    if duration = invalid or duration <= 0 then duration = m.videoPlayer.duration

    change = {
        itemId: m.activePlayback.session.itemId
        positionTicks: secondsToTicks(position)
        durationTicks: secondsToTicks(duration)
        isFinished: isFinished
        isPaused: VideoPlayerState.Normalize(m.videoPlayer.state) = VideoPlayerState.Value.Paused
    }
    applyPlaybackProgressChange(change)
    m.top.playbackProgressChanged = change
    m.playback.hasEmittedFinalProgress = true
end sub

'-------------------------------------------------------------------------------
' tracksCurrentPlaybackProgress
'-------------------------------------------------------------------------------
function tracksCurrentPlaybackProgress() as boolean
    request = getAcceptedOrPendingPlaybackRequest()
    explicitPolicy = invalid
    if request <> invalid then explicitPolicy = request.tracksPlaybackProgress
    return MediaPlaybackPolicy.TracksProgress(getCurrentPlaybackItem(request), explicitPolicy)
end function

'-------------------------------------------------------------------------------
' applyPlaybackProgressChange
'-------------------------------------------------------------------------------
sub applyPlaybackProgressChange(change as object)
    applyPlaybackProgressChangeToCurrentItem(change)
    applyPlaybackProgressChangeToCurrentQueueItem(change)
    applyPlaybackProgressChangeToPlayRequest(change)
end sub

'-------------------------------------------------------------------------------
' applyPlaybackProgressChangeToCurrentItem
'-------------------------------------------------------------------------------
sub applyPlaybackProgressChangeToCurrentItem(change as object)
    if m.activePlayback = invalid then return
    item = m.activePlayback.context.item
    if item = invalid then return
    if Format.SafeString(Format.FirstNonEmpty([item.Id], ""), "") <> Format.SafeString(change.itemId, "") then return

    PlaybackProgress.ApplyChangeToItem(item, change)
end sub

'-------------------------------------------------------------------------------
' applyPlaybackProgressChangeToCurrentQueueItem
'-------------------------------------------------------------------------------
sub applyPlaybackProgressChangeToCurrentQueueItem(change as object)
    if m.activePlayback = invalid then return
    if m.activePlayback.queue.items = invalid then return
    if m.activePlayback.queue.index < 0 or m.activePlayback.queue.index >= m.activePlayback.queue.items.Count() then return

    queueItem = m.activePlayback.queue.items[m.activePlayback.queue.index]
    if queueItem = invalid then return
    if Format.SafeString(queueItem.itemId, "") <> Format.SafeString(change.itemId, "") then return

    PlaybackProgress.ApplyChangeToItem(queueItem.item, change)
end sub

'-------------------------------------------------------------------------------
' applyPlaybackProgressChangeToPlayRequest
'-------------------------------------------------------------------------------
sub applyPlaybackProgressChangeToPlayRequest(change as object)
    request = getAcceptedOrPendingPlaybackRequest()
    if request = invalid then return
    if Format.SafeString(request.itemId, "") <> Format.SafeString(change.itemId, "") then return

    PlaybackProgress.ApplyChangeToItem(request.item, change)
end sub

'-------------------------------------------------------------------------------
' getAcceptedOrPendingPlaybackRequest
'-------------------------------------------------------------------------------
function getAcceptedOrPendingPlaybackRequest() as dynamic
    if m.activePlayback <> invalid then return m.activePlayback.request
    if m.pendingPlaybackRequest <> invalid then return m.pendingPlaybackRequest
    return invalid
end function

'-------------------------------------------------------------------------------
' getRestorePlaybackRequest
'-------------------------------------------------------------------------------
function getRestorePlaybackRequest() as dynamic
    if m.activePlayback <> invalid then return PlaybackRequest.Create(m.activePlayback.request)
    if m.pendingPlaybackRequest = invalid then return invalid
    return PlaybackRequest.Create(m.pendingPlaybackRequest)
end function

'-------------------------------------------------------------------------------
' secondsToTicks
'-------------------------------------------------------------------------------
function secondsToTicks(seconds as dynamic) as longinteger
    if seconds = invalid or seconds <= 0 then return 0

    return int(seconds) * 10000000&
end function

'-------------------------------------------------------------------------------
' getCurrentPlaybackPosition
'-------------------------------------------------------------------------------
function getCurrentPlaybackPosition() as float
    position = m.videoPlayer.position
    if position <> invalid and position > 0 then return position

    if m.playback <> invalid and m.playback.position <> invalid then return m.playback.position

    return 0
end function

'-------------------------------------------------------------------------------
' requestUpNextAutoPlay
'-------------------------------------------------------------------------------
function requestUpNextAutoPlay() as boolean
    if m.activePlayback = invalid then
        m.log.write("Skipping up-next autoplay: queue is invalid")
        return false
    end if
    if m.activePlayback.queue.items = invalid then
        m.log.write("Skipping up-next autoplay: queue items are invalid")
        return false
    end if

    nextIndex = m.activePlayback.queue.index + 1
    if nextIndex < 0 or nextIndex >= m.activePlayback.queue.items.Count() then
        m.log.write("Skipping up-next autoplay: no next item queueIndex=" + Format.SafeString(m.activePlayback.queue.index, "") + " queueCount=" + Format.SafeString(m.activePlayback.queue.items.Count(), ""))
        return false
    end if

    currentItem = invalid
    if m.activePlayback.queue.index >= 0 and m.activePlayback.queue.index < m.activePlayback.queue.items.Count() then currentItem = m.activePlayback.queue.items[m.activePlayback.queue.index]

    nextItem = m.activePlayback.queue.items[nextIndex]
    if nextItem = invalid or Format.SafeString(nextItem.itemId, "") = "" then
        m.log.write("Skipping up-next autoplay: next item is invalid nextIndex=" + Format.SafeString(nextIndex, ""))
        return false
    end if

    m.log.write("Requesting up-next autoplay currentIndex=" + Format.SafeString(m.activePlayback.queue.index, "") + " nextIndex=" + Format.SafeString(nextIndex, "") + " nextItemId=" + Format.SafeString(nextItem.itemId, ""))
    upNextRequest = {
        finishedItem: currentItem
        nextItem: nextItem
        series: getQueueItemSeries(nextItem)
        season: getQueueItemSeason(nextItem)
        playbackQueue: m.activePlayback.queue.items
        playbackQueueIndex: nextIndex
        playbackQueueMode: m.activePlayback.queue.mode
        playbackQueueScope: m.activePlayback.queue.scope
        tracksPlaybackProgress: m.activePlayback.request.tracksPlaybackProgress
        nextItemPlayback: NextItemPlayback.Normalize(m.activePlayback.request.nextItemPlayback)
        videoMode: getOriginalPlaybackMode()
        subtitleBurnInMode: SubtitleBurnIn.Normalize(m.activePlayback.request.subtitleBurnInMode)
        server: m.activePlayback.session.server
    }
    EpisodeQueueIdentity.Apply(upNextRequest, m.activePlayback.queue.scope, m.episodeQueue.id)
    m.top.upNextRequested = upNextRequest
    return true
end function

'-------------------------------------------------------------------------------
' finalizeCurrentPlaybackItem
'-------------------------------------------------------------------------------
sub finalizeCurrentPlaybackItem()
    reportPlaystateStop(true)
    emitPlaybackProgress(true)
end sub

'-------------------------------------------------------------------------------
' continueAfterCompletedItem
'-------------------------------------------------------------------------------
function continueAfterCompletedItem(completionMode = "" as string) as boolean
    if hasQueueItemAtOffset(1) <> true then return false

    playImmediately = completionMode = "playNext"
    if completionMode = "" then playImmediately = NextItemPlayback.Normalize(m.activePlayback.request.nextItemPlayback) = NextItemPlayback.Mode.PlayNextImmediately
    if playImmediately then
        return startQueueItemAtOffset(1)
    end if

    if requestUpNextAutoPlay() <> true then return false
    finishCompletedPlayback()
    return true
end function

'-------------------------------------------------------------------------------
' completeCurrentItemFromPlaybackAction
'-------------------------------------------------------------------------------
sub completeCurrentItemFromPlaybackAction(mode as string)
    if m.activePlayback = invalid then return

    itemId = Format.SafeString(m.activePlayback.session.itemId, "")
    if itemId = "" then return

    m.playbackAction.pendingCompletion = {
        itemId: itemId
        mode: mode
    }
    m.videoPlayer.control = "pause"
    Spinner.Show()
    finalizeCurrentPlaybackItem()
    m.playbackCompletionTask.request = {
        action: "MarkAsWatched"
        server: m.activePlayback.session.server
        token: m.activePlayback.session.token
        userId: m.activePlayback.session.userId
        itemId: itemId
    }
    m.playbackCompletionTask.control = "run"
end sub

'-------------------------------------------------------------------------------
' onPlaybackCompletionResponse
'-------------------------------------------------------------------------------
sub onPlaybackCompletionResponse()
    pending = m.playbackAction.pendingCompletion
    if pending = invalid then return

    response = m.playbackCompletionTask.response
    if response = invalid then return
    if Format.SafeString(response.itemId, "") <> pending.itemId then return

    m.playbackAction.pendingCompletion = invalid
    Spinner.Hide()
    if response.ok <> true then
        m.log.error("Unable to persist completed playback itemId=" + pending.itemId + " error=" + Format.SafeString(response.errorMessage, ""))
    end if
    if continueAfterCompletedItem(pending.mode) <> true then finishCompletedPlayback()
end sub

'-------------------------------------------------------------------------------
' cancelPlaybackActionCompletion
'-------------------------------------------------------------------------------
sub cancelPlaybackActionCompletion()
    if m.playbackAction = invalid or m.playbackAction.pendingCompletion = invalid then return

    m.playbackCompletionTask.control = "stop"
    m.playbackAction.pendingCompletion = invalid
    Spinner.Hide()
end sub

'-------------------------------------------------------------------------------
' finishCompletedPlayback
'-------------------------------------------------------------------------------
sub finishCompletedPlayback()
    stopPlayback()
    m.top.closeRequested = true
end sub

'-------------------------------------------------------------------------------
' getQueueItemSeries
'-------------------------------------------------------------------------------
function getQueueItemSeries(item as dynamic) as dynamic
    if item <> invalid and item.hasPlaybackContext = true then return item.series
    if item <> invalid and item.series <> invalid then return item.series
    return m.activePlayback.context.series
end function

'-------------------------------------------------------------------------------
' getQueueItemSeason
'-------------------------------------------------------------------------------
function getQueueItemSeason(item as dynamic) as dynamic
    if item <> invalid and item.hasPlaybackContext = true then return item.season
    if item <> invalid and item.season <> invalid then return item.season
    return m.activePlayback.context.season
end function

'-------------------------------------------------------------------------------
' reportPlaystateStart
'-------------------------------------------------------------------------------
sub reportPlaystateStart()
    if m.playback.hasReportedStart = true then return

    reportPlaystate("start")
    m.playback.hasReportedStart = true
end sub

'-------------------------------------------------------------------------------
' reportPlaystateUpdate
'-------------------------------------------------------------------------------
sub reportPlaystateUpdate()
    if m.playback.hasReportedStart <> true then return
    if tracksCurrentPlaybackProgress() <> true then return

    reportPlaystate("update")
end sub

'-------------------------------------------------------------------------------
' reportPlaystateStop
'-------------------------------------------------------------------------------
sub reportPlaystateStop(isFinished = false as boolean)
    if m.playback.hasReportedStart <> true then return

    m.playstateTimer.control = "stop"
    positionOverride = invalid
    if isFinished then
        positionOverride = m.playback.duration
        if positionOverride = invalid or positionOverride <= 0 then positionOverride = m.videoPlayer.duration
    end if
    reportPlaystate("stop", positionOverride)
    m.playback.hasReportedStart = false
end sub

'-------------------------------------------------------------------------------
' reportPlaystate
'-------------------------------------------------------------------------------
sub reportPlaystate(status as string, positionOverride = invalid as dynamic)
    if m.activePlayback = invalid then return
    if m.activePlayback.session.server = "" or m.activePlayback.session.token = "" or m.activePlayback.session.itemId = "" then return

    position = getCurrentPlaybackPosition()
    if positionOverride <> invalid and positionOverride > 0 then position = positionOverride
    if tracksCurrentPlaybackProgress() <> true then position = 0
    isPaused = VideoPlayerState.Normalize(m.videoPlayer.state) = VideoPlayerState.Value.Paused
    m.log.write("Playstate " + status + " itemId=" + m.activePlayback.session.itemId + " position=" + Format.SafeString(position, "") + " paused=" + boolToText(isPaused))

    m.playstateTask.request = {
        server: m.activePlayback.session.server
        token: m.activePlayback.session.token
        itemId: m.activePlayback.session.itemId
        playSessionId: m.activePlayback.playSessionId
        mediaSourceId: m.activePlayback.mediaSourceId
        liveStreamId: m.activePlayback.liveStreamId
        playMethod: Format.SafeString(m.activePlayback.playMethod, "DirectPlay")
        canSeek: m.activePlayback.canSeek
        status: status
        position: position
        isPaused: isPaused
    }
    m.playstateTask.control = "run"
end sub

'-------------------------------------------------------------------------------
' boolToText
'-------------------------------------------------------------------------------
function boolToText(value as boolean) as string
    if value = true then return "true"
    return "false"
end function
