'-------------------------------------------------------------------------------
' initPlaybackDiagnostics
'-------------------------------------------------------------------------------
sub initPlaybackDiagnostics()
    m.playbackDiagnostics = {
        lastObservedPosition: -1
        lastState: ""
        expectedPosition: -1
        expectedReason: ""
    }
end sub

'-------------------------------------------------------------------------------
' logPlaybackRequest
'-------------------------------------------------------------------------------
sub logPlaybackRequest(request as dynamic, isRecoveryRestart as boolean)
    if request = invalid then return

    m.log.write("Playback request itemId=" + Format.SafeString(request.itemId, "") + " mode=" + Format.SafeString(request.videoMode, PlaybackMode.Mode.Automatic) + " startPosition=" + Format.SafeString(PlaybackProgress.TicksToSeconds(request.startPositionTicks), "") + " recoveryRestart=" + playbackDiagnosticBool(isRecoveryRestart) + " currentPosition=" + Format.SafeString(getCurrentPlaybackPosition(), "") + " state=" + LCase(Format.SafeString(m.videoPlayer.state, "")))
end sub

'-------------------------------------------------------------------------------
' logPlaybackContentAssignment
'-------------------------------------------------------------------------------
sub logPlaybackContentAssignment(response as dynamic, startPosition as dynamic)
    m.playbackDiagnostics.lastObservedPosition = Number.ToFloat(startPosition, 0)
    m.playbackDiagnostics.expectedPosition = Number.ToFloat(startPosition, 0)
    m.playbackDiagnostics.expectedReason = "contentAssignment"

    m.log.write("Playback content assignment method=" + Format.SafeString(response.playMethod, "") + " format=" + Format.SafeString(response.streamFormat, "") + " startPosition=" + Format.SafeString(startPosition, ""))
end sub

'-------------------------------------------------------------------------------
' logPlaybackSeekRequest
'-------------------------------------------------------------------------------
sub logPlaybackSeekRequest(reason as string, targetPosition as dynamic)
    sourcePosition = getCurrentPlaybackPosition()
    target = Number.ToFloat(targetPosition, 0)
    m.playbackDiagnostics.expectedPosition = target
    m.playbackDiagnostics.expectedReason = reason

    identity = getPlaybackDiagnosticIdentity()
    m.log.write("Playback seek requested reason=" + reason + " from=" + Format.SafeString(sourcePosition, "") + " to=" + Format.SafeString(target, "") + " delta=" + Format.SafeString(target - sourcePosition, "") + " state=" + LCase(Format.SafeString(m.videoPlayer.state, "")) + " itemId=" + identity.itemId + " playSessionId=" + identity.playSessionId)
end sub

'-------------------------------------------------------------------------------
' diagnosePlaybackPosition
'-------------------------------------------------------------------------------
sub diagnosePlaybackPosition(position as float)
    previousPosition = m.playbackDiagnostics.lastObservedPosition
    if previousPosition >= 0 and position < previousPosition - 2 then
        expected = isExpectedPlaybackPosition(position)
        severity = "UNEXPECTED"
        if expected then severity = "expected"

        identity = getPlaybackDiagnosticIdentity()
        m.log.write("Playback position moved backward classification=" + severity + " from=" + Format.SafeString(previousPosition, "") + " to=" + Format.SafeString(position, "") + " delta=" + Format.SafeString(position - previousPosition, "") + " expectedReason=" + m.playbackDiagnostics.expectedReason + " expectedPosition=" + Format.SafeString(m.playbackDiagnostics.expectedPosition, "") + " state=" + LCase(Format.SafeString(m.videoPlayer.state, "")) + " bufferPercent=" + Format.SafeString(getPlaybackBufferPercent(), "") + " itemId=" + identity.itemId + " playSessionId=" + identity.playSessionId)
    end if

    if isExpectedPlaybackPosition(position) then
        m.playbackDiagnostics.expectedPosition = -1
        m.playbackDiagnostics.expectedReason = ""
    end if
    m.playbackDiagnostics.lastObservedPosition = position
end sub

'-------------------------------------------------------------------------------
' getPlaybackDiagnosticIdentity
'-------------------------------------------------------------------------------
function getPlaybackDiagnosticIdentity() as object
    if m.activePlayback = invalid then return { itemId: "", playSessionId: "" }
    return {
        itemId: Format.SafeString(m.activePlayback.session.itemId, "")
        playSessionId: Format.SafeString(m.activePlayback.playSessionId, "")
    }
end function

'-------------------------------------------------------------------------------
' diagnosePlaybackState
'-------------------------------------------------------------------------------
sub diagnosePlaybackState(state as string)
    previousState = m.playbackDiagnostics.lastState
    message = "Playback state " + previousState + " -> " + state + " position=" + Format.SafeString(m.videoPlayer.position, "")
    if state = "buffering" then message = message + " bufferPercent=" + Format.SafeString(getPlaybackBufferPercent(), "")
    m.log.write(message)
    m.playbackDiagnostics.lastState = state
end sub

'-------------------------------------------------------------------------------
' isExpectedPlaybackPosition
'-------------------------------------------------------------------------------
function isExpectedPlaybackPosition(position as float) as boolean
    expectedPosition = m.playbackDiagnostics.expectedPosition
    if expectedPosition < 0 then return false
    return Abs(position - expectedPosition) <= 5
end function

'-------------------------------------------------------------------------------
' playbackDiagnosticBool
'-------------------------------------------------------------------------------
function playbackDiagnosticBool(value as boolean) as string
    if value then return "true"
    return "false"
end function
