import "pkg:/source/String.bs"
namespace PlaybackDiagnostic

    enum Classification
        Unexpected = "UNEXPECTED"
        Expected = "expected"
        SeekAdjustment = "seek-adjustment"
    end enum

end namespace

'-------------------------------------------------------------------------------
' initPlaybackDiagnostics
'-------------------------------------------------------------------------------
sub initPlaybackDiagnostics()
    m.playbackDiagnostics = {
        lastObservedPosition: -1
        lastState: ""
        expectedPosition: -1
        expectedReason: ""
        seekClock: invalid
        seekMatched: false
    }
end sub

'-------------------------------------------------------------------------------
' logPlaybackRequest
'-------------------------------------------------------------------------------
sub logPlaybackRequest(request as dynamic, isRecoveryRestart as boolean)
    if request = invalid then return

    m.log.write("Playback request itemId=" + Strings.ToString(request.itemId) + " mode=" + Strings.ToString(request.videoMode, PlaybackMode.Mode.Automatic) + " startPosition=" + Strings.ToString(PlaybackProgress.TicksToSeconds(request.startPositionTicks)) + " recoveryRestart=" + playbackDiagnosticBool(isRecoveryRestart) + " currentPosition=" + Strings.ToString(getCurrentPlaybackPosition()) + " state=" + VideoPlayerState.Normalize(m.videoPlayer.state))
end sub

'-------------------------------------------------------------------------------
' logPlaybackContentAssignment
'-------------------------------------------------------------------------------
sub logPlaybackContentAssignment(response as dynamic, startPosition as dynamic)
    m.playbackDiagnostics.lastObservedPosition = Number.ToFloat(startPosition, 0)
    m.playbackDiagnostics.expectedPosition = Number.ToFloat(startPosition, 0)
    m.playbackDiagnostics.expectedReason = "contentAssignment"
    m.playbackDiagnostics.seekClock = invalid
    m.playbackDiagnostics.seekMatched = false

    m.log.write("Playback content assignment method=" + Strings.ToString(response.playMethod) + " format=" + Strings.ToString(response.streamFormat) + " startPosition=" + Strings.ToString(startPosition))
end sub

'-------------------------------------------------------------------------------
' logPlaybackSeekRequest
'-------------------------------------------------------------------------------
sub logPlaybackSeekRequest(reason as string, targetPosition as dynamic)
    sourcePosition = getCurrentPlaybackPosition()
    target = Number.ToFloat(targetPosition, 0)
    m.playbackDiagnostics.expectedPosition = target
    m.playbackDiagnostics.expectedReason = reason
    m.playbackDiagnostics.seekClock = CreateObject("roTimespan")
    m.playbackDiagnostics.seekClock.Mark()
    m.playbackDiagnostics.seekMatched = false

    identity = getPlaybackDiagnosticIdentity()
    m.log.write("Playback seek requested reason=" + reason + " from=" + Strings.ToString(sourcePosition) + " to=" + Strings.ToString(target) + " delta=" + Strings.ToString(target - sourcePosition) + " state=" + VideoPlayerState.Normalize(m.videoPlayer.state) + " itemId=" + identity.itemId + " playSessionId=" + identity.playSessionId)
end sub

'-------------------------------------------------------------------------------
' diagnosePlaybackPosition
'-------------------------------------------------------------------------------
sub diagnosePlaybackPosition(position as float)
    if m.playbackDiagnostics.seekClock <> invalid then
        if m.playbackDiagnostics.seekClock.TotalMilliseconds() > 10000 then
            m.playbackDiagnostics.expectedPosition = -1
            m.playbackDiagnostics.expectedReason = ""
            m.playbackDiagnostics.seekClock = invalid
            m.playbackDiagnostics.seekMatched = false
        end if
    end if
    previousPosition = m.playbackDiagnostics.lastObservedPosition
    if previousPosition >= 0 and position < previousPosition - 2 then
        expected = isExpectedPlaybackPosition(position)
        severity = PlaybackDiagnostic.Classification.Unexpected
        if expected then
            if m.playbackDiagnostics.seekMatched then
                if previousPosition - position <= 5 and isExpectedPlaybackPosition(previousPosition) then severity = PlaybackDiagnostic.Classification.SeekAdjustment
            else
                severity = PlaybackDiagnostic.Classification.Expected
            end if
        end if

        identity = getPlaybackDiagnosticIdentity()
        m.log.write("Playback position moved backward classification=" + severity + " from=" + Strings.ToString(previousPosition) + " to=" + Strings.ToString(position) + " delta=" + Strings.ToString(position - previousPosition) + " expectedReason=" + m.playbackDiagnostics.expectedReason + " expectedPosition=" + Strings.ToString(m.playbackDiagnostics.expectedPosition) + " state=" + VideoPlayerState.Normalize(m.videoPlayer.state) + " bufferPercent=" + Strings.ToString(getPlaybackBufferPercent()) + " itemId=" + identity.itemId + " playSessionId=" + identity.playSessionId)
    end if

    if isExpectedPlaybackPosition(position) then
        ' Retain the target after arrival: Roku can report it before settling
        ' onto an earlier sync frame. This context only affects diagnostics.
        if m.playbackDiagnostics.seekClock <> invalid then
            m.playbackDiagnostics.seekMatched = true
        else
            m.playbackDiagnostics.expectedPosition = -1
            m.playbackDiagnostics.expectedReason = ""
        end if
    else if m.playbackDiagnostics.seekMatched then
        m.playbackDiagnostics.expectedPosition = -1
        m.playbackDiagnostics.expectedReason = ""
        m.playbackDiagnostics.seekClock = invalid
        m.playbackDiagnostics.seekMatched = false
    end if
    m.playbackDiagnostics.lastObservedPosition = position
end sub

'-------------------------------------------------------------------------------
' getPlaybackActivityTitle
'-------------------------------------------------------------------------------
function getPlaybackActivityTitle() as string
    request = getAcceptedOrPendingPlaybackRequest()
    item = getCurrentPlaybackItem(request)
    return getPlaybackItemActivityTitle(item)
end function

'-------------------------------------------------------------------------------
' getPlaybackItemActivityTitle
'-------------------------------------------------------------------------------
function getPlaybackItemActivityTitle(item as dynamic) as string
    if item <> invalid and LCase(Strings.ToString(item.Type)) = "episode" then return ActivityLog.EpisodeTitle(item)
    return ActivityLog.ItemTitle(item, "media")
end function

'-------------------------------------------------------------------------------
' getPlaybackDiagnosticIdentity
'-------------------------------------------------------------------------------
function getPlaybackDiagnosticIdentity() as object
    if m.activePlayback = invalid then return { itemId: "", playSessionId: "" }
    return {
        itemId: m.activePlayback.session.itemId
        playSessionId: m.activePlayback.playSessionId
    }
end function

'-------------------------------------------------------------------------------
' diagnosePlaybackState
'-------------------------------------------------------------------------------
sub diagnosePlaybackState(state as string)
    previousState = m.playbackDiagnostics.lastState
    message = "Playback state " + previousState + " -> " + state + " position=" + Strings.ToString(m.videoPlayer.position)
    if state = VideoPlayerState.Value.Buffering then message = message + " bufferPercent=" + Strings.ToString(getPlaybackBufferPercent())
    m.log.write(message)
    m.playbackDiagnostics.lastState = state
end sub

'-------------------------------------------------------------------------------
' isExpectedPlaybackPosition
'-------------------------------------------------------------------------------
function isExpectedPlaybackPosition(position as float) as boolean
    expectedPosition = m.playbackDiagnostics.expectedPosition
    if expectedPosition < 0 then return false
    return Abs(position - expectedPosition) <= 5
end function

'-------------------------------------------------------------------------------
' playbackDiagnosticBool
'-------------------------------------------------------------------------------
function playbackDiagnosticBool(value as boolean) as string
    if value then return "true"
    return "false"
end function
