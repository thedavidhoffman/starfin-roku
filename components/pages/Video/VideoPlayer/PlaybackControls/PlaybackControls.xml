      <Rectangle id="progressBarBackground" width="1714" height="12" color="0xFFFFFFFF" opacity="0.32" />
      <Rectangle id="progressBar" width="0" height="12" color="0xFFFFFFFF" opacity="0.92" />
      <Rectangle id="previewBar" width="0" height="12" color="0xFFFFFFFF" opacity="0.45" visible="false" />
      <Rectangle id="scrubber" translation="[-10,-7]" width="20" height="26" color="0xFFFFFFFF" />
    </Group>

    <Label id="positionLabel" translation="[103,915]" width="220" height="36" font="font:MediumSystemFont" color="0xFFFFFFFF" />
    <Label id="remainingLabel" translation="[1597,915]" width="220" height="36" font="font:MediumSystemFont" color="0xFFFFFFFF" horizAlign="right" />
  </children>
