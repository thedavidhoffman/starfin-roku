    <TrickplayPreviewStrip id="trickplayPreview" translation="[102,420]" />

    <Label id="titleLabel" translation="[103,760]" width="1280" height="58" font="font:LargeBoldSystemFont" />
    <Label id="subtitleLabel" translation="[103,816]" width="1280" height="36" font="font:SmallSystemFont" />

