<?xml version="1.0" encoding="utf-8"?>
<component name="PlaybackControls" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/source/Format.bs" />
  <script type="text/brightscript" uri="pkg:/source/String.bs" />
  <script type="text/brightscript" uri="pkg:/source/Number.bs" />
  <script type="text/brightscript" uri="pkg:/source/Theme.bs" />
  <script type="text/brightscript" uri="pkg:/source/video-player-helpers/VideoPlayerTrickplay.bs" />
  <script type="text/brightscript" uri="pkg:/source/video-player-helpers/PlaybackControlsLogic.bs" />
  <script type="text/brightscript" uri="pkg:/components/pages/Video/VideoPlayer/PlaybackControls/PlaybackControls.bs" />
  <interface>
    <field id="title" type="string" onChange="onTitleChanged" />
    <field id="subtitle" type="string" onChange="onSubtitleChanged" />
    <field id="position" type="float" onChange="onProgressChanged" />
    <field id="duration" type="float" onChange="onProgressChanged" />
    <field id="previewPosition" type="float" onChange="onPreviewChanged" />
    <field id="isSeeking" type="boolean" onChange="onSeekingChanged" />
    <field id="isPlaying" type="boolean" onChange="onPlayingChanged" />
    <field id="thumbnailData" type="assocarray" onChange="onThumbnailDataChanged" />
    <field id="hasCastOptions" type="boolean" value="false" onChange="onOptionsChanged" />
    <field id="hasChapterOptions" type="boolean" value="false" onChange="onOptionsChanged" />
    <field id="hasSubtitleOptions" type="boolean" value="false" onChange="onOptionsChanged" />
    <field id="hasAudioOptions" type="boolean" value="false" onChange="onOptionsChanged" />
    <field id="hasVideoOptions" type="boolean" value="true" onChange="onOptionsChanged" />
    <field id="skipBackEnabled" type="boolean" value="true" onChange="onSkipButtonAvailabilityChanged" />
    <field id="skipForwardEnabled" type="boolean" value="true" onChange="onSkipButtonAvailabilityChanged" />
    <field id="castOptionsPressed" type="boolean" alwaysNotify="true" />
    <field id="chapterOptionsPressed" type="boolean" alwaysNotify="true" />
    <field id="subtitleOptionsPressed" type="boolean" alwaysNotify="true" />
    <field id="audioOptionsPressed" type="boolean" alwaysNotify="true" />
    <field id="videoOptionsPressed" type="boolean" alwaysNotify="true" />
    <field id="playbackInfoPressed" type="boolean" alwaysNotify="true" />
    <field id="playPausePressed" type="boolean" alwaysNotify="true" />
    <field id="skipBackPressed" type="boolean" alwaysNotify="true" />
    <field id="skipForwardPressed" type="boolean" alwaysNotify="true" />
    <field id="last5Pressed" type="boolean" alwaysNotify="true" />
    <field id="progressLeftPressed" type="boolean" alwaysNotify="true" />
    <field id="progressRightPressed" type="boolean" alwaysNotify="true" />
    <field id="progressLeftReleased" type="boolean" alwaysNotify="true" />
    <field id="progressRightReleased" type="boolean" alwaysNotify="true" />
    <field id="progressRewindPressed" type="boolean" alwaysNotify="true" />
    <field id="progressFastForwardPressed" type="boolean" alwaysNotify="true" />
    <field id="progressSeekCommit" type="boolean" alwaysNotify="true" />
    <field id="progressSeekCancel" type="boolean" alwaysNotify="true" />
    <field id="focusExitDown" type="boolean" alwaysNotify="true" />
    <function name="activate" />
    <function name="deactivate" />
    <function name="resetFocus" />
    <function name="focusProgress" />
    <function name="focusButtons" />
    <function name="releaseFocus" />
  </interface>
  <children>
    <Poster uri="pkg:/images/overlays/bottom-content-gradient.png" translation="[0,490]" width="1920" height="740" loadDisplayMode="scaleToFit" />

    <Group id="buttonGroup">
      <PlaybackIconButton id="chapterButton" translation="[103,962]" visible="false" />
      <PlaybackIconButton id="castButton" translation="[198,962]" visible="false" />
      <PlaybackIconButton id="subtitleButton" translation="[293,962]" visible="false" />
      <PlaybackIconButton id="audioButton" translation="[388,962]" visible="false" />
      <PlaybackIconButton id="videoButton" translation="[483,962]" />
      <PlaybackIconButton id="playbackInfoButton" translation="[578,962]" />
      <PlaybackIconButton id="skipBackButton" translation="[828,962]" />
      <PlaybackIconButton id="playPauseButton" translation="[923,962]" />
      <PlaybackIconButton id="skipForwardButton" translation="[1018,962]" />
      <HeaderButton id="last5Button" translation="[1677,969]" buttonWidth="140" buttonHeight="64" text="Last 5s" visible="false" />
