import "pkg:/source/TextMeasurement.bs"
import "pkg:/source/ResolutionAssets.bs"
import "pkg:/source/ResolutionProfile.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.presentation = {
        background: m.top.findNode("background")
        label: m.top.findNode("textLabel")
        icon: m.top.findNode("iconPoster")
        measurementLabel: CreateObject("roSGNode", "Label")
    }
    m.top.observeField("focusedChild", "onFocusChanged")
    render()
end sub

'-------------------------------------------------------------------------------
' render
'-------------------------------------------------------------------------------
sub render()
    if not m.top.enabled then m.top.hasFocusVisual = false
    hasText = m.top.text <> ""
    m.presentation.background.visible = hasText
    m.presentation.label.visible = hasText
    m.presentation.label.text = m.top.text
    height = 75
    textX = 75
    textY = 23
    padding = 28
    minimumWidth = 150
    iconSize = 48
    iconX = 13.5
    if m.top.compact then
        height = 58
        textX = 60
        textY = 15
        padding = 24
        minimumWidth = 64
        iconSize = 32
        iconX = 16
    end if
    width = height
    m.presentation.background.height = height
    m.presentation.label.translation = [textX, textY]
    m.presentation.icon.translation = [0, 0]
    m.presentation.icon.width = height
    m.presentation.icon.height = height
    if hasText then
        textWidth = TextMeasurement.GetWidth(m.presentation.measurementLabel, m.presentation.label.font, m.top.text)
        width = textWidth + textX + padding
        if width < minimumWidth then width = minimumWidth
        if m.top.maxWidth >= minimumWidth and width > m.top.maxWidth then width = m.top.maxWidth
        m.presentation.background.width = width
        m.presentation.label.width = width - textX - padding
        if m.top.compact then
            ' Match DynamicButton's centered group and focused optical adjustment.
            availableTextWidth = width - 76
            if textWidth > availableTextWidth then textWidth = availableTextWidth
            iconX = (width - 44 - textWidth) / 2
            if m.top.hasFocusVisual and m.top.enabled then iconX -= 1
            m.presentation.label.translation = [iconX + 44, textY]
            m.presentation.label.width = textWidth
        end if
        m.presentation.icon.translation = [iconX, (height - iconSize) / 2]
        m.presentation.icon.width = iconSize
        m.presentation.icon.height = iconSize
    end if
    filename = "playback-summary-unfocused.9.png"
    m.presentation.label.color = &hFFFFFFFF
    m.presentation.icon.uri = m.top.icon
    if m.top.hasFocusVisual and m.top.enabled then
        filename = "playback-summary-focused.9.png"
        m.presentation.label.color = &h0F1A2AFF
        m.presentation.icon.uri = m.top.focusedIcon
    end if
    if m.top.compact then filename = "compact-" + filename
    if hasText then m.presentation.background.uri = ResolutionAssets.GetButtonImageUri(filename)
    opacity = 1.0
    if not m.top.enabled then opacity = 0.35
    m.presentation.background.opacity = opacity
    m.presentation.label.opacity = opacity
    m.presentation.icon.opacity = opacity
    m.top.preferredWidth = width
end sub

'-------------------------------------------------------------------------------
' onFocusChanged
'-------------------------------------------------------------------------------
sub onFocusChanged()
    m.top.hasFocusVisual = m.top.enabled and m.top.isInFocusChain()
end sub

'-------------------------------------------------------------------------------
' onKeyEvent
'-------------------------------------------------------------------------------
function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if key <> "OK" and key <> "select" then return false
    if m.top.enabled then m.top.buttonSelected = true
    return true
end function
