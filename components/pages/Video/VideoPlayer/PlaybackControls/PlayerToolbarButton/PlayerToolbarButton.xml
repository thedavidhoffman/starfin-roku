<?xml version="1.0" encoding="utf-8"?>
<component name="PlayerToolbarButton" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/components/pages/Video/VideoPlayer/PlaybackControls/PlayerToolbarButton/PlayerToolbarButton.bs" />
  <interface>
    <field id="icon" type="string" onChange="render" />
    <field id="focusedIcon" type="string" onChange="render" />
    <field id="text" type="string" onChange="render" />
    <field id="maxWidth" type="integer" value="600" onChange="render" />
    <field id="preferredWidth" type="integer" value="75" />
    <field id="hasFocusVisual" type="boolean" onChange="render" />
    <field id="enabled" type="boolean" value="true" onChange="render" />
    <field id="buttonSelected" type="boolean" alwaysNotify="true" />
  </interface>
  <children>
    <Poster id="background" width="150" height="75" loadDisplayMode="scaleToFill" />
    <Poster id="iconPoster" width="75" height="75" loadDisplayMode="scaleToFit" />
    <Label id="textLabel" translation="[75,23]" width="47" height="32" color="0xFFFFFFFF" font="font:SmallerSystemFont" />
  </children>
</component>
