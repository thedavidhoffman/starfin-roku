import "pkg:/source/MediaOptionsSession.bs"
'-------------------------------------------------------------------------------
' handleStreamOptionsOverlayClosed
'-------------------------------------------------------------------------------
sub handleStreamOptionsOverlayClosed(closed as object)
    if closed = invalid or m.state.mediaOptions.session = invalid then return
    session = m.state.mediaOptions.session
    if closed.request = invalid or closed.request.optionsContext = invalid then return
    if closed.request.optionsContext.generation <> session.context.generation then return
    m.state.mediaOptions.session = invalid
    if closed.cancelled = true or closed.overlay = invalid then return
    if m.state.itemContent = invalid then return
    item = m.state.itemContent.raw
    if item = invalid or item.Id <> session.itemId then return
    result = closed.overlay.result
    if result = invalid then return
    if result.videoMode <> invalid then applyPlaybackVideoMode(result.videoMode)
    m.state.selectedStreams = MediaOptionsSession.ApplyStreamChanges(m.state.selectedStreams, session.context, result)
    applySelectedStreamsToPlaySelection(m.state.playSelection)
    refreshMediaInfoText(m.mediaToolbar.playItem)
    if result.Count() > 0 then m.log.activity("Updated media options")
    if result.chapter <> invalid then
        playSelection = buildRestartSelection(m.state.playSelection)
        if playSelection <> invalid then
            playSelection.startPositionTicks = result.chapter.startPositionTicks
            applySelectedStreamsToPlaySelection(playSelection)
            m.top.selectedEpisode = playSelection
        end if
        return
    end if
    focusVideoToolbar()
end sub

'-------------------------------------------------------------------------------
' applyPlaybackVideoMode
'-------------------------------------------------------------------------------
sub applyPlaybackVideoMode(videoMode as dynamic)
    mode = ""
    if videoMode <> invalid then mode = videoMode.ToStr()
    if mode = "" then mode = SettingsStore.GetSettingValue(m.top.settings, SettingsStore.Key.VideoStreamingMode)
    mode = PlaybackMode.Normalize(mode)
    m.state.videoMode = mode
    if m.state.playSelection <> invalid then m.state.playSelection.AddReplace("videoMode", mode)
end sub

'-------------------------------------------------------------------------------
' onVideoToolbarMediaInfoSelected
'-------------------------------------------------------------------------------
sub onVideoToolbarMediaInfoSelected()
    if m.state.itemContent = invalid then return
    item = m.state.itemContent.raw
    if item = invalid then return
    m.mediaToolbar.callFunc("deactivate")
    m.state.focusArea = "toolbar"
    context = MediaOptionsSession.Context(item, m.state.videoMode, getSelectedAudioStreamIndex(), getSelectedSubtitleStreamIndex(), getAudioStreams(item), getSubtitleStreams(item))
    m.state.mediaOptions.generation += 1
    context.generation = m.state.mediaOptions.generation
    m.state.mediaOptions.session = { context: context, itemId: item.Id }
    m.top.overlayRequested = {
        id: MediaOptionsSession.Overlay.Options
        sourcePage: "tvEpisode"
        componentName: "MediaOptionsDialog"
        openFunction: "openMediaOptions"
        closeField: "closeRequested"
        optionsContext: context
    }
end sub

'-------------------------------------------------------------------------------
' getSubtitleStreams
'-------------------------------------------------------------------------------
function getSubtitleStreams(item as dynamic) as object
    if item = invalid or item.MediaStreams = invalid then return []

    subtitleStreams = []
    for i = 0 to item.MediaStreams.Count() - 1
        stream = item.MediaStreams[i]
        if stream <> invalid and LCase(Format.SafeString(stream.Type, "")) = "subtitle" then
            if stream.Index = invalid then stream.AddReplace("sourceIndex", i)
            subtitleStreams.Push(stream)
        end if
    end for

    return subtitleStreams
end function

'-------------------------------------------------------------------------------
' getAudioStreams
'-------------------------------------------------------------------------------
function getAudioStreams(item as dynamic) as object
    if item = invalid or item.MediaStreams = invalid then return []

    audioStreams = []
    for i = 0 to item.MediaStreams.Count() - 1
        stream = item.MediaStreams[i]
        if stream <> invalid and LCase(Format.SafeString(stream.Type, "")) = "audio" then
            if stream.Index = invalid then stream.AddReplace("sourceIndex", i)
            audioStreams.Push(stream)
        end if
    end for

    return audioStreams
end function

'-------------------------------------------------------------------------------
' applySelectedStreamsToPlaySelection
'-------------------------------------------------------------------------------
sub applySelectedStreamsToPlaySelection(selection as dynamic)
    if selection = invalid then return

    selection.AddReplace("videoMode", m.state.videoMode)

    audioIndex = getSelectedAudioStreamIndex()
    if audioIndex >= 0 then selection.AddReplace("audioStreamIndex", audioIndex)

    subtitleIndex = getSelectedSubtitleStreamIndex()
    if subtitleIndex >= -1 then selection.AddReplace("subtitleStreamIndex", subtitleIndex)
end sub

'-------------------------------------------------------------------------------
' getSelectedAudioStreamIndex
'-------------------------------------------------------------------------------
function getSelectedAudioStreamIndex() as integer
    if m.state = invalid or m.state.selectedStreams = invalid then return -1
    if m.state.selectedStreams.audio = invalid then return -1

    return getSelectedStreamIndex(m.state.selectedStreams.audio, -1)
end function

'-------------------------------------------------------------------------------
' getSelectedSubtitleStreamIndex
'-------------------------------------------------------------------------------
function getSelectedSubtitleStreamIndex() as integer
    if m.state = invalid or m.state.selectedStreams = invalid then return -2
    if m.state.selectedStreams.subtitleOff = true then return -1
    if m.state.selectedStreams.subtitle = invalid then return -2

    return getSelectedStreamIndex(m.state.selectedStreams.subtitle, -2)
end function

'-------------------------------------------------------------------------------
' getSelectedStreamIndex
'-------------------------------------------------------------------------------
function getSelectedStreamIndex(selection as dynamic, fallback as integer) as integer
    if selection = invalid then return fallback
    if selection.streamIndex <> invalid then return Number.ToInteger(selection.streamIndex, fallback)
    if selection.stream <> invalid and selection.stream.Index <> invalid then return Number.ToInteger(selection.stream.Index, fallback)
    return fallback
end function
