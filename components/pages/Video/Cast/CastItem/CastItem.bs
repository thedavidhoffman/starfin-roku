import "pkg:/source/MaskAssets.bs"
import "pkg:/source/ResolutionProfile.bs"
import "pkg:/source/ResolutionAssets.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.posterMask = m.top.findNode("posterMask")
    m.poster = m.top.findNode("poster")
    m.nameLabel = m.top.findNode("nameLabel")
    m.detailsLabel = m.top.findNode("detailsLabel")
    maskProfile = MaskAssets.GetProfile("cast-mask.png", [195, 195], [130, 130])
    m.posterMask.maskUri = maskProfile.uri
    m.posterMask.maskSize = maskProfile.size
    if maskProfile.isHd then m.posterMask.translation = [12, 6]

    ' Observe only after initialization, then render any already assigned fields.
    m.top.observeField("itemContent", "onItemContentChanged")
    m.top.observeField("itemHasFocus", "onItemHasFocusChanged")
    onItemContentChanged()
    onItemHasFocusChanged()
end sub

'-------------------------------------------------------------------------------
' onItemHasFocusChanged
'-------------------------------------------------------------------------------
sub onItemHasFocusChanged()
    repeatCount = 0
    if m.top.itemHasFocus then repeatCount = -1

    m.nameLabel.repeatCount = repeatCount
    m.detailsLabel.repeatCount = repeatCount
end sub

'-------------------------------------------------------------------------------
' onItemContentChanged
'-------------------------------------------------------------------------------
sub onItemContentChanged()
    item = m.top.itemContent
    if item = invalid then return

    m.nameLabel.text = item.title
    m.detailsLabel.text = item.description

    imageUrl = item.HDPosterUrl
    m.poster.visible = imageUrl <> ""
    m.poster.uri = imageUrl
end sub
