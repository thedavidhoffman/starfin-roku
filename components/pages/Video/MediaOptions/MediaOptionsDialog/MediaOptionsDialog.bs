'-------------------------------------------------------------------------------
' openMediaOptions
'-------------------------------------------------------------------------------
sub openMediaOptions()
    m.top.title = "Media Options"
    m.top.dialogWidth = 1560
    m.top.dialogHeight = 940
    m.top.closeOnContentSelected = false
    m.top.result = invalid
    m.top.contentComponentName = "MediaOptionsContent"
    content = m.top.callFunc("getContentComponent")
    content.optionsContext = m.top.optionsContext
    m.top.callFunc("openDialog")
    content.callFunc("focusFirstField")
end sub

'-------------------------------------------------------------------------------
' onCloseRequested
'-------------------------------------------------------------------------------
sub onCloseRequested()
    if m.top.result <> invalid then return
    content = m.top.callFunc("getContentComponent")
    m.top.result = content.callFunc("getChanges")
end sub
