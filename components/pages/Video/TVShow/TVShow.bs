'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    initReferences()
    m.pageState = {
        request: invalid
        series: invalid
        seasons: []
        detailsLoad: LatestRequestLifecycle.Create()
        taskPool: { nodes: [m.tvShowTask, m.tvShowTaskAlternate], nextIndex: 0 }
        playbackRefresh: { needed: false, playPending: false }
        playbackQueue: invalid
        playbackQueueIndex: 0
        randomPlaybackQueue: invalid
        randomQueueLoading: false
        seriesLoaded: false
        seasonWindowStart: 0
        focusArea: "videoToolbar"
        themeLookupActive: false
        lifecycle: AsyncLifecycle.Create()
    }
    m.layout = {
        isPoster: false
        contentDefault: [96, 0]
        contentCastFocused: [96, -397]
        toolbarDefault: [0, 529]
        toolbarCastFocused: [0, 926]
    }
    initHandlers()
    if m.top.loadRequest <> invalid then onLoadRequestChanged()
end sub

'-------------------------------------------------------------------------------
' initReferences
'-------------------------------------------------------------------------------
sub initReferences()
    m.log = new Logger("TVShow", m.global.logService)
    m.episodeCountRefresh = m.top.findNode("episodeCountRefresh")
    m.contentGroup = m.top.findNode("contentGroup")
    m.mediaShell = m.top.findNode("mediaShell")
    m.videoToolbar = m.top.findNode("videoToolbar")
    m.seasonsGrid = m.top.findNode("seasonsGrid")
    m.leftSeasonChevron = m.top.findNode("leftSeasonChevron")
    m.rightSeasonChevron = m.top.findNode("rightSeasonChevron")
    m.cast = m.top.findNode("cast")
    m.chevronFooter = m.top.findNode("chevronFooter")
    m.tvShowTask = m.top.findNode("tvShowTask")
    m.tvShowTaskAlternate = m.top.findNode("tvShowTaskAlternate")
    m.randomPlaybackTask = m.top.findNode("randomPlaybackTask")
    m.themeSongsTask = m.top.findNode("themeSongsTask")
end sub

'-------------------------------------------------------------------------------
' initHandlers
'-------------------------------------------------------------------------------
sub initHandlers()
    m.top.observeField("loadRequest", "onLoadRequestChanged")
    m.episodeCountRefresh.observeField("response", "onEpisodeCountsRefreshed")
    m.tvShowTask.observeField("response", "onTVShowResponse")
    m.tvShowTaskAlternate.observeField("response", "onAlternateTVShowResponse")
    m.randomPlaybackTask.observeField("response", "onRandomPlaybackResponse")
    m.themeSongsTask.observeField("response", "onThemeSongsResponse")
    m.mediaShell.observeField("overlayRequested", "onMediaShellOverlayRequested")
    m.videoToolbar.observeField("playSelected", "onVideoToolbarPlaySelected")
    m.videoToolbar.observeField("randomPlaySelected", "onVideoToolbarRandomPlaySelected")
    m.videoToolbar.observeField("allEpisodesSelected", "onVideoToolbarAllEpisodesSelected")
    m.videoToolbar.observeField("focusExitUp", "onVideoToolbarFocusExitUp")
    m.videoToolbar.observeField("focusExitDown", "onVideoToolbarFocusExitDown")
    m.videoToolbar.observeField("layoutWidth", "positionContentLayout")
    m.seasonsGrid.observeField("itemSelected", "onSeasonSelected")
    m.seasonsGrid.observeField("itemFocused", "updateSeasonChevrons")
    m.cast.observeField("hasItems", "onCastAvailabilityChanged")
    m.cast.observeField("focusExitUp", "onCastFocusExitUp")
    m.cast.observeField("selectedPerson", "onCastPersonSelected")
end sub

'-------------------------------------------------------------------------------
' onVideoToolbarAllEpisodesSelected
'-------------------------------------------------------------------------------
sub onVideoToolbarAllEpisodesSelected()
    request = m.pageState.request
    if request = invalid then return

    firstSeason = getFirstValidSeason()
    if firstSeason = invalid then return
    seasonId = Format.FirstNonEmpty([firstSeason.Id], "")
    if seasonId = "" then return

    m.top.selectedAllEpisodes = {
        seriesId: Strings.ToString(request.itemId)
        seasonId: seasonId
        series: SeriesIdentity.FromItem(request.server, m.pageState.series)
        season: firstSeason
        seasons: m.pageState.seasons
        allEpisodes: true
    }
end sub

'-------------------------------------------------------------------------------
' onVideoToolbarRandomPlaySelected
'-------------------------------------------------------------------------------
sub onVideoToolbarRandomPlaySelected()
    if m.pageState.randomPlaybackQueue <> invalid then
        startRandomPlayback()
        return
    end if
    if m.pageState.randomQueueLoading then return

    request = m.pageState.request
    if request = invalid then return

    m.pageState.randomQueueLoading = true
    Spinner.Show()
    m.randomPlaybackTask.request = {
        server: request.server
        token: request.token
        userId: request.userId
        itemId: request.itemId
    }
    m.randomPlaybackTask.control = TaskControl.Command.Run
end sub

'-------------------------------------------------------------------------------
' onRandomPlaybackResponse
'-------------------------------------------------------------------------------
sub onRandomPlaybackResponse()
    response = m.randomPlaybackTask.response
    if response = invalid then return
    if AsyncLifecycle.IsCurrentResponse(m.pageState.lifecycle, response, "itemId", "tvShowRandomPlayback") <> true then return

    m.pageState.randomQueueLoading = false
    Spinner.Hide()
    if response.ok <> true then
        AppMessage.Show((response.failureKind <> invalid ? "Unable to load random playback. " : "") + RequestFailure.GetDisplayMessage(response, "Unable to load random playback."))
        return
    end if

    m.pageState.randomPlaybackQueue = response.playbackQueue
    startRandomPlayback()
end sub

'-------------------------------------------------------------------------------
' startRandomPlayback
'-------------------------------------------------------------------------------
sub startRandomPlayback()
    queue = shuffledPlaybackQueue(m.pageState.randomPlaybackQueue)
    if queue.Count() = 0 then return

    queueItem = queue[0]
    m.top.selectedEpisode = {
        itemId: queueItem.itemId
        item: queueItem.item
        series: SeriesIdentity.FromItem(Strings.ToString(m.pageState.request.server), m.pageState.series)
        season: queueItem.season
        startPositionTicks: 0
        playbackQueue: queue
        playbackQueueIndex: 0
        playbackQueueMode: "random"
        playbackQueueScope: "random"
    }
end sub

'-------------------------------------------------------------------------------
' shuffledPlaybackQueue
'-------------------------------------------------------------------------------
function shuffledPlaybackQueue(sourceQueue as dynamic) as object
    queue = []
    if sourceQueue = invalid then return queue
    queue.Append(sourceQueue)

    for i = queue.Count() - 1 to 1 step -1
        swapIndex = Number.ToInteger(Rnd(0) * (i + 1), 0)
        if swapIndex < 0 then swapIndex = 0
        if swapIndex > i then swapIndex = i

        item = queue[i]
        queue[i] = queue[swapIndex]
        queue[swapIndex] = item
    end for

    return queue
end function

'-------------------------------------------------------------------------------
' onVideoToolbarPlaySelected
'-------------------------------------------------------------------------------
sub onVideoToolbarPlaySelected()
    if m.pageState.playbackRefresh.needed then
        m.pageState.playbackRefresh.playPending = true
        refreshPlaybackTargets()
        return
    end if
    item = m.videoToolbar.playItem
    shouldResume = false
    if m.videoToolbar.resumeItem <> invalid then
        item = m.videoToolbar.resumeItem
        shouldResume = true
    end if

    emitEpisodeSelection(item, shouldResume)
end sub

'-------------------------------------------------------------------------------
' emitEpisodeSelection
'-------------------------------------------------------------------------------
sub emitEpisodeSelection(item as dynamic, shouldResume as boolean)
    if Arrays.IsAssocArray(item) = false then return

    itemId = Strings.ToString(item.Id)
    if itemId = "" then return

    startPositionTicks = 0
    if shouldResume then startPositionTicks = PlaybackProgress.GetTicksFromItem(item)

    m.top.selectedEpisode = {
        itemId: itemId
        item: item
        series: SeriesIdentity.FromItem(Strings.ToString(m.pageState.request.server), m.pageState.series)
        season: {
            Id: Strings.ToString(item.SeasonId)
            Name: Strings.ToString(item.SeasonName)
        }
        startPositionTicks: startPositionTicks
        playbackQueue: m.pageState.playbackQueue
        playbackQueueIndex: m.pageState.playbackQueueIndex
        playbackQueueScope: "series"
    }
end sub

'-------------------------------------------------------------------------------
' onVideoToolbarFocusExitUp
'-------------------------------------------------------------------------------
sub onVideoToolbarFocusExitUp()
    focusMediaDescription()
end sub

'-------------------------------------------------------------------------------
' onVideoToolbarFocusExitDown
'-------------------------------------------------------------------------------
sub onVideoToolbarFocusExitDown()
    focusSeasonsIfActive()
end sub

'-------------------------------------------------------------------------------
' onMediaShellOverlayRequested
'-------------------------------------------------------------------------------
sub onMediaShellOverlayRequested()
    request = m.mediaShell.overlayRequested
    if request = invalid then return

    request.sourcePage = "tvShow"
    m.top.overlayRequested = request
end sub

'-------------------------------------------------------------------------------
' onSeasonSelected
'-------------------------------------------------------------------------------
sub onSeasonSelected()
    selected = m.seasonsGrid.itemSelected
    if selected = invalid then return
    if m.seasonsGrid.content = invalid then return

    seasonNode = m.seasonsGrid.content.getChild(selected)
    if seasonNode = invalid then return

    season = seasonNode.raw
    seasonId = Format.FirstNonEmpty([season.Id, seasonNode.itemId], "")
    if seasonId = "" then return

    nextSeason = getNextSeason(selected)
    request = m.pageState.request
    if request = invalid then return

    m.top.selectedSeason = {
        seriesId: Format.FirstNonEmpty([request.itemId], "")
        seasonId: seasonId
        series: SeriesIdentity.FromItem(request.server, m.pageState.series)
        season: season
        seasons: m.pageState.seasons
        nextSeason: nextSeason
    }
end sub

'-------------------------------------------------------------------------------
' getNextSeason
'-------------------------------------------------------------------------------
function getNextSeason(selectedIndex as integer) as dynamic
    seasons = m.pageState.seasons
    if seasons = invalid then return invalid

    nextIndex = selectedIndex + 1
    if nextIndex < 0 or nextIndex >= seasons.Count() then return invalid

    return seasons[nextIndex]
end function

'-------------------------------------------------------------------------------
' onLoadRequestChanged
'-------------------------------------------------------------------------------
sub onLoadRequestChanged()
    m.episodeCountRefresh.callFunc("cancel")
    request = m.top.loadRequest
    if request = invalid then return

    m.pageState.request = request
    m.pageState.playbackRefresh = { needed: false, playPending: false }
    m.pageState.seasons = []
    m.pageState.seasonWindowStart = 0
    m.top.settings = request.settings
    m.pageState.series = request.item
    m.pageState.playbackQueue = invalid
    m.pageState.playbackQueueIndex = 0
    m.pageState.randomPlaybackQueue = invalid
    m.pageState.randomQueueLoading = false
    m.pageState.seriesLoaded = false
    m.randomPlaybackTask.control = TaskControl.Command.Stop
    m.pageState.themeLookupActive = false
    AsyncLifecycle.Begin(m.pageState.lifecycle, request.itemId)
    m.pageState.focusArea = "videoToolbar"
    applyMediaShellLayout(request.settings)
    m.videoToolbar.visible = false
    m.videoToolbar.supportsAllEpisodes = false
    setSeasonsVisible(true)
    updateFocusChevron()
    m.cast.server = request.server
    m.cast.people = []
    Spinner.Show(0)
    renderSeries(request.item, true)
    renderSeasons([])
    m.videoToolbar.resumeItem = invalid
    m.videoToolbar.playItem = invalid

    LatestRequestLifecycle.Queue(m.pageState.detailsLoad, request)
    startPendingTVShowLoad()
end sub

'-------------------------------------------------------------------------------
' onSettingsChanged
'-------------------------------------------------------------------------------
sub onSettingsChanged()
    settings = m.top.settings
    wasThemeMusicEnabled = SettingsStore.IsThemeMusicEnabled(m.pageState.request.settings)
    if m.pageState <> invalid and m.pageState.request <> invalid then m.pageState.request.settings = settings
    applyMediaShellLayout(settings)
    if wasThemeMusicEnabled = false and SettingsStore.IsThemeMusicEnabled(m.top.settings) then loadThemeSong(m.pageState.series)
end sub

'-------------------------------------------------------------------------------
' applyMediaShellLayout
'-------------------------------------------------------------------------------
sub applyMediaShellLayout(settings as dynamic)
    mode = SettingsStore.GetSettingValue(settings, SettingsStore.Key.TvSeriesShellLayout)
    isPoster = mode = MediaShellLayout.Mode.Poster
    modeChanged = m.layout.isPoster <> isPoster
    m.layout.isPoster = isPoster
    m.layout.toolbarDefault = (isPoster ? [28, 286] : [0, 529])

    m.mediaShell.backgroundDisplay = mode
    m.mediaShell.contentTranslation = (isPoster ? [0, 0] : [96, 50])
    m.mediaShell.detailsVisible = true
    m.videoToolbar.supportsFocusExitUp = isPoster <> true
    positionContentLayout()
    m.seasonsGrid.itemSize = (isPoster ? [400, 672] : [207, 381])
    m.seasonsGrid.itemSpacing = (isPoster ? [24, 0] : [21, 33])
    m.seasonsGrid.numColumns = (isPoster ? 4 : 8)
    m.seasonsGrid.focusBitmapUri = (isPoster ? "pkg:/images/tv-show/season-poster-focus-400x672.png" : "pkg:/images/tv-show/season-poster-focus-207x381.png")
    positionSeasonsGrid()
    m.cast.displayEnabled = isPoster <> true
    if isPoster then m.cast.callFunc("deactivate")

    if modeChanged and m.pageState.seasons <> invalid then
        m.pageState.seasonWindowStart = 0
        focusedIndex = m.seasonsGrid.itemFocused
        renderSeasons(m.pageState.seasons)
        if focusedIndex >= 0 then m.seasonsGrid.jumpToItem = focusedIndex
    end if
    if isPoster and m.pageState.focusArea = "cast" then
        if m.seasonsGrid.visible then
            focusSeasonsIfActive()
        else
            focusVideoToolbar()
        end if
    else if isPoster and m.pageState.focusArea = "description" then
        focusVideoToolbar()
    end if
    updateFocusChevron()
    updateSeasonChevrons()
end sub

'-------------------------------------------------------------------------------
' positionContentLayout
'-------------------------------------------------------------------------------
sub positionContentLayout()
    isCastFocused = m.layout.isPoster <> true and m.pageState.focusArea = "cast"
    m.contentGroup.translation = (isCastFocused ? m.layout.contentCastFocused : m.layout.contentDefault)
    if m.layout.isPoster and m.videoToolbar.layoutWidth > 0 then
        centeredX = Number.ToInteger((1920 - m.videoToolbar.layoutWidth) / 2, 0)
        m.layout.toolbarDefault = [centeredX - m.layout.contentDefault[0], 286]
    end if
    m.videoToolbar.translation = (isCastFocused ? m.layout.toolbarCastFocused : m.layout.toolbarDefault)
end sub

'-------------------------------------------------------------------------------
' onTVShowResponse
'-------------------------------------------------------------------------------
sub onTVShowResponse()
    handleTVShowResponse(m.tvShowTask.response)
end sub

'-------------------------------------------------------------------------------
' onAlternateTVShowResponse
'-------------------------------------------------------------------------------
sub onAlternateTVShowResponse()
    handleTVShowResponse(m.tvShowTaskAlternate.response)
end sub

'-------------------------------------------------------------------------------
' handleTVShowResponse
'-------------------------------------------------------------------------------
sub handleTVShowResponse(response as dynamic)
    completion = LatestRequestLifecycle.Complete(m.pageState.detailsLoad, response, "tvShow")
    if completion.matched <> true then return
    if completion.isCurrent <> true then
        startPendingTVShowLoad()
        return
    end if
    if completion.context = true then
        applyPlaybackRefresh(response)
        return
    end if

    if response.ok <> true then
        m.videoToolbar.visible = false
        Spinner.Hide()
        renderSeries(m.pageState.series, false)
        message = (response.failureKind <> invalid ? "Unable to load this series. " : "") + RequestFailure.GetDisplayMessage(response, "Unable to load this series.")
        AppMessage.Show(message)
        m.log.activity("TV show load failed: " + Strings.ToString(response.errorMessage, message))
        return
    end if

    payload = response.payload
    if payload = invalid then
        m.videoToolbar.visible = false
        Spinner.Hide()
        renderSeries(m.pageState.series, false)
        AppMessage.Show("Unable to load this series.")
        m.log.activity("TV show load failed: Unable to load this series.")
        return
    end if

    preserveRequestedSeriesImages(payload.series)
    m.pageState.series = payload.series
    m.pageState.seasons = ApiPayload.GetItems(payload.seasons)
    updateAllEpisodesAvailability()
    applyPlaybackTargets(payload)
    m.pageState.seriesLoaded = true
    m.videoToolbar.visible = true
    renderSeries(payload.series, false)
    renderSeasons(m.pageState.seasons)
    m.log.activity("Viewing TV show " + ActivityLog.ItemTitle(payload.series, "TV show") + "; seasons=" + m.pageState.seasons.Count().ToStr())
    Spinner.Hide()
    if m.pageState.focusArea = "videoToolbar" then
        focusVideoToolbar()
    else
        focusSeasonsIfActive()
    end if
    loadThemeSong(payload.series)
end sub

'-------------------------------------------------------------------------------
' updateAllEpisodesAvailability
'-------------------------------------------------------------------------------
sub updateAllEpisodesAvailability()
    m.videoToolbar.supportsAllEpisodes = getFirstValidSeason() <> invalid
end sub

'-------------------------------------------------------------------------------
' getFirstValidSeason
'-------------------------------------------------------------------------------
function getFirstValidSeason() as dynamic
    for each season in m.pageState.seasons
        if Arrays.IsAssocArray(season) and Strings.ToString(season.Id) <> "" then return season
    end for

    return invalid
end function

'-------------------------------------------------------------------------------
' preserveRequestedSeriesImages
'-------------------------------------------------------------------------------
sub preserveRequestedSeriesImages(series as dynamic)
    if Arrays.IsAssocArray(series) = false then return

    requestedSeries = m.pageState.series
    if Arrays.IsAssocArray(requestedSeries) = false then return

    if Strings.ToString(series.thumbUrl) = "" then series.thumbUrl = Strings.ToString(requestedSeries.thumbUrl)
    if Strings.ToString(series.backdropUrl) = "" then series.backdropUrl = Strings.ToString(requestedSeries.backdropUrl)
    if Strings.ToString(series.detailBackdropUrl) = "" then series.detailBackdropUrl = Strings.ToString(requestedSeries.detailBackdropUrl)
end sub

'-------------------------------------------------------------------------------
' onPlaybackProgressChange
'-------------------------------------------------------------------------------
sub onPlaybackProgressChange()
    change = m.top.playbackProgressChange
    if change = invalid or change.isFinished <> true then return

    queue = m.pageState.playbackQueue
    if queue = invalid then return

    currentIndex = Number.ToInteger(m.pageState.playbackQueueIndex, 0)
    if currentIndex < 0 or currentIndex >= queue.Count() then return

    currentItem = queue[currentIndex]
    if Strings.ToString(currentItem.itemId) <> Strings.ToString(change.itemId) then return

    nextIndex = currentIndex + 1
    if nextIndex >= queue.Count() then return

    nextItem = queue[nextIndex]
    if nextItem = invalid or nextItem.item = invalid then return

    m.pageState.playbackQueueIndex = nextIndex
    m.videoToolbar.resumeItem = invalid
    m.videoToolbar.playItem = nextItem.item
end sub

'-------------------------------------------------------------------------------
' loadThemeSong
'-------------------------------------------------------------------------------
sub loadThemeSong(item as dynamic)
    request = m.pageState.request
    if request = invalid then return
    if SettingsStore.IsThemeMusicEnabled(m.top.settings) <> true then
        m.log.write("Theme music playback is disabled")
        return
    end if

    m.log.write("Theme music playback is enabled")

    itemId = Format.FirstNonEmpty([item.Id, request.itemId], "")
    if itemId = "" then return

    m.pageState.themeLookupActive = true
    m.themeSongsTask.control = TaskControl.Command.Stop
    m.themeSongsTask.request = {
        server: request.server
        token: request.token
        userId: request.userId
        itemId: itemId
    }
    m.themeSongsTask.control = TaskControl.Command.Run
end sub

'-------------------------------------------------------------------------------
' onThemeSongsResponse
'-------------------------------------------------------------------------------
sub onThemeSongsResponse()
    response = m.themeSongsTask.response
    if response = invalid then return
    if m.pageState.lifecycle.isActive <> true then return
    if m.pageState.themeLookupActive <> true then return
    if response.ok <> true then
        m.log.write("Theme song lookup failed: " + Strings.ToString(response.errorMessage, "Unknown error."))
        return
    end if

    themeSong = response.payload
    if Arrays.IsAssocArray(themeSong) = false then
        m.pageState.themeLookupActive = false
        m.log.write("Theme music enabled, but no theme song was found")
        return
    end if

    request = m.pageState.request
    if request = invalid then return
    if Strings.ToString(response.itemId) <> Strings.ToString(request.itemId) then return

    m.pageState.themeLookupActive = false
    themeSongId = Strings.ToString(themeSong.Id)
    if themeSongId = "" then
        m.pageState.themeLookupActive = false
        return
    end if

    m.log.write("Theme song found itemId=" + themeSongId)
    m.top.themeRequested = {
        server: request.server
        token: request.token
        userId: request.userId
        itemId: themeSongId
        title: Format.FirstNonEmpty([themeSong.Name, m.pageState.series.Name], "Theme Music")
        sourceItemId: Strings.ToString(request.itemId)
    }
end sub

'-------------------------------------------------------------------------------
' renderSeries
'-------------------------------------------------------------------------------
sub renderSeries(item as dynamic, logoPending = false as boolean)
    if Arrays.IsAssocArray(item) = false then return

    m.mediaShell.mediaContent = {
        mediaType: "tv-show"
        backdropUrl: getBackdropUrl(item)
        logoUrl: getImageUrl(item, JellyfinImage.Type.Logo, 600, 300)
        logoPending: logoPending
        title: getItemTitle(item)
        officialRating: item.OfficialRating
        communityRating: item.CommunityRating
        criticRating: item.CriticRating
        primaryInfoText: getMetaText(item)
        secondaryInfoText: getGenreText(item)
        overview: Format.FirstNonEmpty([item.Overview], "")
    }
    m.cast.people = getPeople(item)
end sub

'-------------------------------------------------------------------------------
' renderSeasons
'-------------------------------------------------------------------------------
sub renderSeasons(seasons as object)
    content = CreateObject("roSGNode", "ContentNode")

    for each season in seasons
        if Arrays.IsAssocArray(season) = false then continue for

        child = content.createChild("ContentNode")
        child.title = getItemTitle(season)
        child.HDPosterUrl = getSeasonPosterUrl(season)
        child.AddFields({
            itemId: Format.FirstNonEmpty([season.Id], "")
            itemType: Format.FirstNonEmpty([season.Type], "")
            seasonYear: getSeasonYearText(season)
            episodeCount: Format.FirstNonEmpty([season.RecursiveItemCount, season.ChildCount], "")
            posterLayout: m.layout.isPoster
            raw: season
        })
    end for

    m.seasonsGrid.content = content
    refreshEpisodeCounts()
    m.seasonsGrid.visible = content.getChildCount() > 0
    positionSeasonsGrid()
    updateFocusChevron()
    updateSeasonChevrons()
end sub

'-------------------------------------------------------------------------------
' positionSeasonsGrid
'-------------------------------------------------------------------------------
sub positionSeasonsGrid()
    if m.layout.isPoster <> true then
        m.seasonsGrid.translation = [0, 630]
        return
    end if

    gridX = 28
    content = m.seasonsGrid.content
    if content <> invalid then
        seasonCount = content.getChildCount()
        if seasonCount >= 1 and seasonCount <= 3 then
            rowWidth = seasonCount * m.seasonsGrid.itemSize[0] + (seasonCount - 1) * m.seasonsGrid.itemSpacing[0]
            gridX = Number.ToInteger((1920 - rowWidth) / 2, 0) - m.layout.contentDefault[0]
        end if
    end if
    m.seasonsGrid.translation = [gridX, 375]
end sub

'-------------------------------------------------------------------------------
' getSeasonPosterUrl
'-------------------------------------------------------------------------------
function getSeasonPosterUrl(season as dynamic) as string
    posterWidth = (m.layout.isPoster ? 400 : 207)
    posterHeight = (m.layout.isPoster ? 603 : 312)
    posterUrl = getImageUrl(season, JellyfinImage.Type.Primary, posterWidth, posterHeight)
    if posterUrl <> "" then return posterUrl

    return getImageUrl(m.pageState.series, JellyfinImage.Type.Primary, posterWidth, posterHeight)
end function

'-------------------------------------------------------------------------------
' setSeasonsVisible
'-------------------------------------------------------------------------------
sub setSeasonsVisible(isVisible as boolean)
    hasSeasons = m.seasonsGrid.content <> invalid and m.seasonsGrid.content.getChildCount() > 0
    visible = isVisible and hasSeasons
    m.seasonsGrid.visible = visible
    updateFocusChevron()
    updateSeasonChevrons()
end sub

'-------------------------------------------------------------------------------
' activate
'-------------------------------------------------------------------------------
sub activate()
    AsyncLifecycle.BeginFromField(m.pageState.lifecycle, m.pageState.request, "itemId")
    refreshEpisodeCounts()
    if m.pageState.playbackRefresh.needed then refreshPlaybackTargets()
    if m.pageState.seriesLoaded <> true then
        m.top.setFocus(true)
        return
    end if
    if m.pageState.focusArea = "cast" and m.cast.visible = true and m.cast.hasItems = true then
        focusCast()
    else if m.pageState.focusArea = "videoToolbar" then
        focusVideoToolbar()
    else
        focusSeasonsIfActive()
    end if
end sub

'-------------------------------------------------------------------------------
' deactivate
'-------------------------------------------------------------------------------
sub deactivate()
    m.episodeCountRefresh.callFunc("cancel")
    m.pageState.playbackRefresh.playPending = false
    AsyncLifecycle.Deactivate(m.pageState.lifecycle)
    m.pageState.themeLookupActive = false
    LatestRequestLifecycle.Deactivate(m.pageState.detailsLoad)
    m.tvShowTask.control = TaskControl.Command.Stop
    m.tvShowTaskAlternate.control = TaskControl.Command.Stop
    m.randomPlaybackTask.control = TaskControl.Command.Stop
    if m.pageState.randomQueueLoading then Spinner.Hide()
    m.pageState.randomQueueLoading = false
    m.themeSongsTask.control = TaskControl.Command.Stop
    m.videoToolbar.callFunc("deactivate")
end sub

'-------------------------------------------------------------------------------
' focusSeasonsIfActive
'-------------------------------------------------------------------------------
sub focusSeasonsIfActive()
    if m.seasonsGrid.content = invalid then return
    if m.seasonsGrid.content.getChildCount() = 0 then return

    m.pageState.focusArea = "seasons"
    positionContentLayout()
    setSeasonsVisible(true)
    m.cast.callFunc("deactivate")
    m.videoToolbar.callFunc("deactivate")
    updateFocusChevron()
    m.top.setFocus(true)
    m.seasonsGrid.setFocus(true)
end sub

'-------------------------------------------------------------------------------
' focusVideoToolbar
'-------------------------------------------------------------------------------
sub focusVideoToolbar()
    m.pageState.focusArea = "videoToolbar"
    positionContentLayout()
    setSeasonsVisible(true)
    m.cast.callFunc("deactivate")
    updateFocusChevron()
    m.top.setFocus(true)
    m.videoToolbar.callFunc("activate")
end sub

'-------------------------------------------------------------------------------
' focusMediaDescription
'-------------------------------------------------------------------------------
function focusMediaDescription() as boolean
    if m.layout.isPoster then return false
    if m.mediaShell.callFunc("canFocusDescription") <> true then return false

    m.pageState.focusArea = "description"
    positionContentLayout()
    setSeasonsVisible(true)
    m.cast.callFunc("deactivate")
    m.videoToolbar.callFunc("deactivate")
    updateFocusChevron()
    m.top.setFocus(true)
    return m.mediaShell.callFunc("focusDescription")
end function

'-------------------------------------------------------------------------------
' handleDescriptionOverlayClosed
'-------------------------------------------------------------------------------
sub handleDescriptionOverlayClosed()
    focusMediaDescription()
end sub

'-------------------------------------------------------------------------------
' focusCast
'-------------------------------------------------------------------------------
sub focusCast()
    if m.layout.isPoster then return
    if m.cast.visible <> true or m.cast.hasItems <> true then return

    m.pageState.focusArea = "cast"
    positionContentLayout()
    setSeasonsVisible(false)
    m.videoToolbar.callFunc("deactivate")
    m.cast.callFunc("activate")
    updateFocusChevron()
end sub

'-------------------------------------------------------------------------------
' onCastAvailabilityChanged
'-------------------------------------------------------------------------------
sub onCastAvailabilityChanged()
    updateFocusChevron()
end sub

'-------------------------------------------------------------------------------
' onCastFocusExitUp
'-------------------------------------------------------------------------------
sub onCastFocusExitUp()
    focusSeasonsIfActive()
end sub

'-------------------------------------------------------------------------------
' updateFocusChevron
'-------------------------------------------------------------------------------
sub updateFocusChevron()
    if m.layout.isPoster then
        m.chevronFooter.direction = ""
        return
    end if

    hasSeasons = m.seasonsGrid.content <> invalid and m.seasonsGrid.content.getChildCount() > 0
    hasCast = m.cast.visible = true and m.cast.hasItems = true

    if m.pageState.focusArea = "seasons" and hasSeasons and hasCast then
        m.chevronFooter.direction = "down"
    else if m.pageState.focusArea = "cast" and hasCast and hasSeasons then
        m.chevronFooter.direction = "up"
    else
        m.chevronFooter.direction = ""
    end if
end sub

'-------------------------------------------------------------------------------
' updateSeasonChevrons
'-------------------------------------------------------------------------------
sub updateSeasonChevrons()
    m.leftSeasonChevron.visible = false
    m.rightSeasonChevron.visible = false
    if m.layout.isPoster <> true or m.seasonsGrid.visible <> true then return
    if m.seasonsGrid.content = invalid then return

    itemCount = m.seasonsGrid.content.getChildCount()
    visibleCount = 4
    if itemCount <= visibleCount then return

    windowStart = m.pageState.seasonWindowStart
    focusedIndex = m.seasonsGrid.itemFocused
    if focusedIndex < windowStart then
        windowStart = focusedIndex
    else if focusedIndex >= windowStart + visibleCount then
        windowStart = focusedIndex - visibleCount + 1
    end if

    if windowStart < 0 then windowStart = 0
    lastWindowStart = itemCount - visibleCount
    if windowStart > lastWindowStart then windowStart = lastWindowStart
    m.pageState.seasonWindowStart = windowStart

    m.leftSeasonChevron.visible = windowStart > 0
    m.rightSeasonChevron.visible = windowStart < lastWindowStart
end sub

'-------------------------------------------------------------------------------
' onCastPersonSelected
'-------------------------------------------------------------------------------
sub onCastPersonSelected()
    if m.layout.isPoster then return
    selection = m.cast.selectedPerson
    if selection = invalid then return
    if selection.itemId = invalid or selection.itemId = "" then return

    selection.sourceItemType = "series"
    selection.sourceSeriesId = Strings.ToString(m.pageState.request.itemId)
    m.top.selectedPerson = selection
end sub

'-------------------------------------------------------------------------------
' onSeasonWatchedStateChange
'-------------------------------------------------------------------------------
sub onSeasonWatchedStateChange()
    change = m.top.seasonWatchedStateChange
    if change = invalid then return

    seasonId = Strings.ToString(change.seasonId)
    if seasonId = "" then return

    updateSeasonWatchedState(m.pageState.seasons, seasonId, change)
    updateSeasonCardWatchedState(seasonId, change)
    refreshEpisodeCounts()
    invalidatePlaybackTargets()
end sub

'-------------------------------------------------------------------------------
' updateSeasonWatchedState
'-------------------------------------------------------------------------------
sub updateSeasonWatchedState(seasons as dynamic, seasonId as string, change as object)
    if seasons = invalid then return

    for each season in seasons
        if Arrays.IsAssocArray(season) = false then continue for
        if Format.FirstNonEmpty([season.Id], "") <> seasonId then continue for

        applySeasonWatchedState(season, change)
        return
    end for
end sub

'-------------------------------------------------------------------------------
' updateSeasonCardWatchedState
'-------------------------------------------------------------------------------
sub updateSeasonCardWatchedState(seasonId as string, change as object)
    if m.seasonsGrid.content = invalid then return

    for i = 0 to m.seasonsGrid.content.getChildCount() - 1
        child = m.seasonsGrid.content.getChild(i)
        if child = invalid then continue for
        if Strings.ToString(child.itemId) <> seasonId then continue for

        raw = child.raw
        if Arrays.IsAssocArray(raw) then
            applySeasonWatchedState(raw, change)
            child.raw = raw
        end if

        return
    end for
end sub

'-------------------------------------------------------------------------------
' applySeasonWatchedState
'-------------------------------------------------------------------------------
sub applySeasonWatchedState(season as object, change as object)
    if season.UserData = invalid then season.UserData = {}

    unplayedItemCount = 0
    if change.unplayedItemCount <> invalid then unplayedItemCount = Number.ToInteger(change.unplayedItemCount, 0)
    if unplayedItemCount < 0 then unplayedItemCount = 0

    season.UserData.UnplayedItemCount = unplayedItemCount
    season.UserData.Played = unplayedItemCount = 0
end sub

'-------------------------------------------------------------------------------
' getItemTitle
'-------------------------------------------------------------------------------
function getItemTitle(item as dynamic) as string
    if Arrays.IsAssocArray(item) = false then return "Series"
    return Format.FirstNonEmpty([item.Name], "Series")
end function

'-------------------------------------------------------------------------------
' getMetaText
'-------------------------------------------------------------------------------
function getMetaText(item as dynamic) as string
    parts = []

    year = Format.FirstNonEmpty([item.ProductionYear], "")
    if year = "" then year = DateTime.ToYear(item.PremiereDate)
    if year <> "" then parts.Push(year)

    episodeCount = Format.FirstNonEmpty([item.RecursiveItemCount], "")
    if episodeCount <> "" then parts.Push(episodeCount + " episodes")

    status = Format.FirstNonEmpty([item.Status], "")
    if status <> "" then parts.Push(status)

    return Arrays.JoinStringValues(parts, MediaMetadataFormatting.BulletSeparator())
end function

'-------------------------------------------------------------------------------
' getSeasonYearText
'-------------------------------------------------------------------------------
function getSeasonYearText(item as dynamic) as string
    year = Format.FirstNonEmpty([item.ProductionYear], "")
    if year = "" then year = DateTime.ToYear(item.PremiereDate)

    return year
end function

'-------------------------------------------------------------------------------
' getGenreText
'-------------------------------------------------------------------------------
function getGenreText(item as dynamic) as string
    if item.Genres = invalid then return ""
    return Arrays.JoinStringValues(item.Genres)
end function

'-------------------------------------------------------------------------------
' getPeople
'-------------------------------------------------------------------------------
function getPeople(item as dynamic) as object
    if item = invalid or item.People = invalid then return []
    return item.People
end function

'-------------------------------------------------------------------------------
' getBackdropUrl
'-------------------------------------------------------------------------------
function getBackdropUrl(item as dynamic) as string
    if item = invalid then return ""

    imageSize = DeviceCapabilities.GetMaxScreenImageSize()
    imageUrl = getImageUrl(item, JellyfinImage.Type.Backdrop, imageSize.width, imageSize.height)
    if imageUrl <> "" then return imageUrl

    imageUrl = getImageUrl(item, JellyfinImage.Type.Primary, imageSize.width, imageSize.height)
    if imageUrl <> "" then return imageUrl

    return Strings.ToString(item.backdropUrl)
end function

'-------------------------------------------------------------------------------
' getImageUrl
'-------------------------------------------------------------------------------
function getImageUrl(item as dynamic, imageType as string, width as integer, height as integer) as string
    request = m.pageState.request
    if request = invalid then return ""

    options = invalid
    if imageType = JellyfinImage.Type.Logo then options = { format: "Png" }
    return ItemImage.GetUrl(request.server, item, imageType, width, height, options)
end function

'-------------------------------------------------------------------------------
' onKeyEvent
'-------------------------------------------------------------------------------
function onKeyEvent(key as string, press as boolean) as boolean
    if press = false then return false
    if key = Remote.Key.Options then return openSeasonMediaActions()

    if key = Remote.Key.Back then
        m.top.closeRequested = true
        return true
    end if

    if key = Remote.Key.Up and m.pageState.focusArea = "seasons" then
        focusVideoToolbar()
        return true
    end if

    if key = Remote.Key.Down and m.pageState.focusArea = "description" then
        focusVideoToolbar()
        return true
    end if

    if key = Remote.Key.Down and m.pageState.focusArea = "seasons" and m.layout.isPoster <> true and m.cast.visible = true and m.cast.hasItems = true then
        focusCast()
        return true
    end if

    return false
end function

'-------------------------------------------------------------------------------
' openSeasonMediaActions
'-------------------------------------------------------------------------------
function openSeasonMediaActions() as boolean
    if m.seasonsGrid.isInFocusChain() <> true then return false
    if m.seasonsGrid.content = invalid then return false
    index = m.seasonsGrid.itemFocused
    if index < 0 or index >= m.seasonsGrid.content.getChildCount() then return false
    node = m.seasonsGrid.content.getChild(index)
    if node.raw = invalid or Strings.ToString(node.raw.Id) = "" then return false
    request = m.pageState.request
    if request = invalid then return false

    m.top.overlayRequested = {
        id: "mediaActions"
        sourcePage: "tvShow"
        componentName: "MediaActionsDialog"
        openFunction: "openMediaActions"
        closeField: "closeRequested"
        item: node.raw
        itemImageUrl: node.HDPosterUrl
        server: request.server
        token: request.token
        userId: request.userId
    }
    return true
end function

'-------------------------------------------------------------------------------
' onMediaStateChange
'-------------------------------------------------------------------------------
sub onMediaStateChange()
    change = m.top.mediaStateChange
    if change = invalid or change.action <> "watched" then return
    for each season in m.pageState.seasons
        if Strings.ToString(season.Id) = Strings.ToString(change.itemId) then
            if UnwatchedEpisodeCount.Normalize(m.global.showUnwatchedEpisodeCount) <> UnwatchedEpisodeCount.Mode.Off then
                refreshEpisodeCounts()
                invalidatePlaybackTargets()
                return
            end if
            unplayedCount = 0
            if change.value <> true then unplayedCount = Number.ToInteger(Format.FirstNonEmpty([season.RecursiveItemCount, season.ChildCount], "1"), 1)
            if change.value <> true and unplayedCount < 1 then unplayedCount = 1
            m.top.seasonWatchedStateChange = { seasonId: change.itemId, unplayedItemCount: unplayedCount }
            return
        end if
    end for
end sub

'-------------------------------------------------------------------------------
' refreshEpisodeCounts
'-------------------------------------------------------------------------------
sub refreshEpisodeCounts()
    request = m.pageState.request
    if request = invalid or m.pageState.lifecycle.isActive <> true then return
    m.episodeCountRefresh.request = { server: request.server, token: request.token, userId: request.userId, items: m.pageState.seasons }
end sub

'-------------------------------------------------------------------------------
' onEpisodeCountsRefreshed
'-------------------------------------------------------------------------------
sub onEpisodeCountsRefreshed()
    response = m.episodeCountRefresh.response
    for each refreshed in response.payload
        for index = 0 to m.pageState.seasons.Count() - 1
            updated = UnwatchedEpisodeCount.WithRefreshedCount(m.pageState.seasons[index], refreshed)
            if updated <> invalid then
                m.pageState.seasons[index] = updated
                if m.seasonsGrid.content <> invalid then
                    for each child in m.seasonsGrid.content.getChildren(-1, 0)
                        if Strings.ToString(child.itemId) = Strings.ToString(updated.Id) then child.raw = updated
                    end for
                end if
            end if
        end for
    end for
end sub
