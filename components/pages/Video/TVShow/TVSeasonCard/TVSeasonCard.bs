import "pkg:/source/Array.bs"
import "pkg:/source/Format.bs"
import "pkg:/source/MaskAssets.bs"
import "pkg:/source/ResolutionProfile.bs"
import "pkg:/source/ResolutionAssets.bs"
import "pkg:/source/MediaMetadataFormatting.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.posterMask = m.top.findNode("seasonPosterMask")
    MaskAssets.Apply(m.posterMask, "season-poster-mask.png", [207, 312], [138, 208])
    m.placeholder = m.top.findNode("placeholder")
    m.poster = m.top.findNode("poster")
    m.watchedIndicator = m.top.findNode("watchedIndicator")
    m.title = m.top.findNode("title")
    m.year = m.top.findNode("year")
    m.itemContent = invalid
    m.posterLayout = false

    ' Observe only after initialization, then render any already assigned fields.
    m.top.observeField("itemContent", "onItemContentChanged")
    onItemContentChanged()
end sub

'-------------------------------------------------------------------------------
' onItemContentChanged
'-------------------------------------------------------------------------------
sub onItemContentChanged()
    item = m.top.itemContent
    ' Layout changes can replace the content node while keeping the same season ID.
    if m.itemContent <> invalid then m.itemContent.unobserveField("raw")
    m.itemContent = item
    if item = invalid then
        m.watchedIndicator.visible = false
        return
    end if

    applyPosterLayout(item.posterLayout = true)
    item.observeField("raw", "onItemDataChanged")

    m.title.text = Format.SafeString(item.title, "")
    m.year.text = getMetadataText(item)

    imageUrl = Format.SafeString(item.HDPosterUrl, "")
    m.poster.visible = imageUrl <> ""
    m.placeholder.visible = imageUrl = ""
    m.poster.uri = imageUrl
    m.watchedIndicator.visible = isSeasonFullyWatched(item)
end sub

'-------------------------------------------------------------------------------
' applyPosterLayout
'-------------------------------------------------------------------------------
sub applyPosterLayout(isPoster as boolean)
    if m.posterLayout = isPoster then return
    m.posterLayout = isPoster

    if isPoster then
        MaskAssets.Apply(m.posterMask, "season-poster-large-mask.png", [400, 603], [267, 402])
        m.placeholder.width = 400
        m.placeholder.height = 603
        m.poster.width = 400
        m.poster.height = 603
        m.watchedIndicator.translation = [346, 9]
        m.title.translation = [0, 618]
        m.title.width = 400
        m.year.translation = [0, 648]
        m.year.width = 400
    else
        MaskAssets.Apply(m.posterMask, "season-poster-mask.png", [207, 312], [138, 208])
        m.placeholder.width = 207
        m.placeholder.height = 312
        m.poster.width = 207
        m.poster.height = 312
        m.watchedIndicator.translation = [153, 9]
        m.title.translation = [0, 327]
        m.title.width = 207
        m.year.translation = [0, 357]
        m.year.width = 207
    end if
end sub

'-------------------------------------------------------------------------------
' onItemDataChanged
'-------------------------------------------------------------------------------
sub onItemDataChanged()
    if m.itemContent = invalid then return

    m.watchedIndicator.visible = isSeasonFullyWatched(m.itemContent)
end sub

'-------------------------------------------------------------------------------
' isSeasonFullyWatched
'-------------------------------------------------------------------------------
function isSeasonFullyWatched(item as dynamic) as boolean
    raw = item.raw
    if raw = invalid or raw.UserData = invalid then return false

    return raw.UserData.UnplayedItemCount = 0
end function

'-------------------------------------------------------------------------------
' getMetadataText
'-------------------------------------------------------------------------------
function getMetadataText(item as dynamic) as string
    parts = []

    year = Format.SafeString(item.seasonYear, "")
    if year <> "" then parts.Push(year)

    episodeText = getEpisodeCountText(item.episodeCount)
    if episodeText <> "" then parts.Push(episodeText)

    return Arrays.JoinStringValues(parts, MediaMetadataFormatting.BulletSeparator())
end function

'-------------------------------------------------------------------------------
' getEpisodeCountText
'-------------------------------------------------------------------------------
function getEpisodeCountText(count as dynamic) as string
    countText = Format.SafeString(count, "")
    if countText = "" then return ""
    if countText = "1" then return "1 ep."

    return countText + " eps."
end function
