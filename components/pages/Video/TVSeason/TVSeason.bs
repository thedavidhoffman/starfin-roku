import "pkg:/source/TaskControl.bs"
import "pkg:/source/TVSeasonTaskResponse.bs"
import "pkg:/source/ApiPayload.bs"
import "pkg:/source/Format.bs"
import "pkg:/source/Encode.bs"
import "pkg:/source/Url.bs"
import "pkg:/source/ItemImage.bs"
import "pkg:/source/SeriesIdentity.bs"
import "pkg:/source/DateTime.bs"
import "pkg:/source/Status.bs"
import "pkg:/source/Spinner.bs"
import "pkg:/source/PlaybackProgress.bs"
import "pkg:/source/Number.bs"
import "pkg:/source/AsyncLifecycle.bs"
import "pkg:/source/ActivityLog.bs"
import "pkg:/source/Logger.bs"
import "pkg:/source/LatestRequestLifecycle.bs"
import "pkg:/source/PlaybackMode.bs"
import "pkg:/source/store/RegistryStore.bs"
import "pkg:/source/store/SettingsStore.bs"
import "pkg:/source/Array.bs"
import "pkg:/components/pages/Video/TVSeason/Helpers/Loading.bs"
import "pkg:/components/pages/Video/TVSeason/Helpers/Rendering.bs"
import "pkg:/components/pages/Video/TVSeason/Helpers/Navigation.bs"
import "pkg:/components/pages/Video/TVSeason/Helpers/MediaState.bs"
import "pkg:/components/pages/Video/TVSeason/Helpers/Playback.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    initReferences()
    initHandlers()
    m.layout = {
        episodeGridColumns: m.episodesGrid.numColumns
    }
    m.pageState = {
        request: invalid
        season: invalid
        seasons: []
        previousSeason: invalid
        nextSeason: invalid
        episodes: []
        episodesLoaded: false
        episodeWindowStart: 0
        episodeListScroll: "horizontal"
        allEpisodes: false
        focusedEpisodeGridIndex: -1
        focusArea: "episodes"
        lifecycle: AsyncLifecycle.Create()
        detailsLoad: LatestRequestLifecycle.Create()
        detailsTaskPool: {
            nodes: [m.tvSeasonTask, m.tvSeasonTaskAlternate]
            nextIndex: 0
        }
    }
end sub

'-------------------------------------------------------------------------------
' initReferences
'-------------------------------------------------------------------------------
sub initReferences()
    m.log = new Logger("TVSeason", m.global.logService)
    m.logoBanner = m.top.findNode("logoBanner")
    m.seasonLabel = m.top.findNode("seasonLabel")
    m.seasonNav = m.top.findNode("seasonNav")
    m.episodesList = m.top.findNode("episodesList")
    m.episodesGrid = m.top.findNode("episodesGrid")
    m.leftChevron = m.top.findNode("leftChevron")
    m.rightChevron = m.top.findNode("rightChevron")
    m.tvSeasonTask = m.top.findNode("tvSeasonTask")
    m.tvSeasonTaskAlternate = m.top.findNode("tvSeasonTaskAlternate")
end sub

'-------------------------------------------------------------------------------
' initHandlers
'-------------------------------------------------------------------------------
sub initHandlers()
    m.tvSeasonTask.observeField("response", "onTVSeasonResponse")
    m.tvSeasonTaskAlternate.observeField("response", "onAlternateTVSeasonResponse")
    m.seasonNav.observeField("previousSelected", "onPreviousSeasonSelected")
    m.seasonNav.observeField("nextSelected", "onNextSeasonSelected")
    m.episodesList.observeField("rowItemFocused", "onEpisodeFocused")
    m.episodesList.observeField("rowItemSelected", "onEpisodeSelected")
    m.episodesGrid.observeField("itemFocused", "onEpisodeFocused")
    m.episodesGrid.observeField("itemSelected", "onEpisodeSelected")
end sub
