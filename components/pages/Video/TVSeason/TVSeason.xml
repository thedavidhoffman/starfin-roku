  <children>

    <TVLogoBanner id="logoBanner" />

    <Label id="seasonLabel" translation="[96,261]" width="300" height="66" color="0xF3F7FBFF" font="font:LargeBoldSystemFont" />
    <TVSeasonNavButton id="seasonNav" translation="[1693,244]" />

    <!-- horizontal episode list -->
    <TVEpisodeRowList
      id="episodesList"
      translation="[81,324]"
      itemComponentName="TVEpisodeCard"
      itemSize="[1758,591]"
      rowItemSize="[[576,591]]"
      rowItemSpacing="[[18,0]]"
      numRows="1"
      drawFocusFeedback="true"
      focusBitmapUri="pkg:/images/tv-season/episode-thumbnail-horizontal-focus-576x591.png"
      focusFootprintBitmapUri=""
      showRowLabel="[false]" />

    <!-- veritcal episode list -->
