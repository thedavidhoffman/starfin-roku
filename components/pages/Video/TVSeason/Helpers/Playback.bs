'-------------------------------------------------------------------------------
' onEpisodeSelected
'-------------------------------------------------------------------------------
sub onEpisodeSelected()
    selection = buildFocusedEpisodeDetailsSelection()
    if selection = invalid then return

    m.top.selectedEpisodeDetails = selection
end sub

'-------------------------------------------------------------------------------
' buildFocusedEpisodeDetailsSelection
'-------------------------------------------------------------------------------
function buildFocusedEpisodeDetailsSelection() as dynamic
    focusedEpisode = getFocusedItemNode()
    if focusedEpisode = invalid then return invalid

    request = buildEpisodeLoadRequest(focusedEpisode)
    if request = invalid then return invalid
    return { loadRequest: request }
end function

'-------------------------------------------------------------------------------
' buildEpisodeLoadRequest
'-------------------------------------------------------------------------------
function buildEpisodeLoadRequest(node as dynamic) as dynamic
    if node = invalid then return invalid
    itemType = Format.SafeString(node.itemType, "")
    if itemType <> MediaItem.Type.Season and itemType <> MediaItem.Type.Episode then return invalid
    itemId = Format.SafeString(node.itemId, "")
    item = node.raw
    request = m.pageState.request
    if itemId = "" or Arrays.IsAssocArray(item) <> true or request = invalid then return invalid

    season = buildEpisodeSeasonIdentity(item, request)
    if itemType = MediaItem.Type.Season then season = item
    queue = buildPlaybackQueue(m.pageState.episodes)
    return {
        server: request.server
        token: request.token
        userId: request.userId
        seriesId: request.seriesId
        seasonId: season.Id
        series: buildSeriesIdentity(request, item)
        season: season
        seasons: m.pageState.seasons
        itemId: itemId
        item: item
        posterUrl: getEpisodeDetailBackdropUrl(node)
        startPositionTicks: PlaybackProgress.GetTicksFromItem(item)
        playbackQueue: queue
        playbackQueueIndex: getPlaybackQueueIndex(queue, itemId)
    }
end function

'-------------------------------------------------------------------------------
' getEpisodeSeasonId
'-------------------------------------------------------------------------------
function getEpisodeSeasonId(item as dynamic, fallbackSeasonId as string) as string
    if item <> invalid then
        seasonId = Format.SafeString(item.SeasonId, "")
        if seasonId <> "" then return seasonId
    end if
    return fallbackSeasonId
end function

'-------------------------------------------------------------------------------
' buildEpisodeSeasonIdentity
'-------------------------------------------------------------------------------
function buildEpisodeSeasonIdentity(item as dynamic, request as object) as object
    seasonId = getEpisodeSeasonId(item, Format.SafeString(request.seasonId, ""))
    for each season in m.pageState.seasons
        if Arrays.IsAssocArray(season) and Format.SafeString(season.Id, "") = seasonId then return season
    end for

    seasonName = ""
    if item <> invalid then seasonName = Format.SafeString(item.SeasonName, "")
    return { Id: seasonId, Name: seasonName }
end function

'-------------------------------------------------------------------------------
' buildSeriesIdentity
'-------------------------------------------------------------------------------
function buildSeriesIdentity(request as object, item as dynamic) as object
    identity = SeriesIdentity.FromItem(Format.SafeString(request.server, ""), request.series)
    seriesId = ""
    if item <> invalid then
        seriesId = Format.FirstNonEmpty([item.SeriesId], "")
        if identity.Name = "" then identity.Name = Format.FirstNonEmpty([item.SeriesName], "")
    end if

    identity.Id = Format.FirstNonEmpty([identity.Id, request.seriesId, seriesId], "")
    if identity.logoUrl = "" then identity.logoUrl = getSeriesLogoUrl()

    return identity
end function

'-------------------------------------------------------------------------------
' buildPlaybackQueue
'-------------------------------------------------------------------------------
function buildPlaybackQueue(episodes as object) as object
    queue = []
    appendEpisodesToPlaybackQueue(queue, episodes, m.pageState.season)

    return queue
end function

'-------------------------------------------------------------------------------
' appendEpisodesToPlaybackQueue
'-------------------------------------------------------------------------------
sub appendEpisodesToPlaybackQueue(queue as object, episodes as dynamic, season as dynamic)
    if episodes = invalid then return

    for each episode in episodes
        if Arrays.IsAssocArray(episode) = false then continue for

        episodeId = Format.SafeString(Format.FirstNonEmpty([episode.Id], ""), "")
        if episodeId = "" then continue for

        queueSeason = season
        if m.pageState.allEpisodes and m.pageState.request <> invalid then queueSeason = buildEpisodeSeasonIdentity(episode, m.pageState.request)
        queue.Push({
            itemId: episodeId
            item: episode
            season: queueSeason
            startPositionTicks: PlaybackProgress.GetTicksFromItem(episode)
        })
    end for
end sub

'-------------------------------------------------------------------------------
' getPlaybackQueueIndex
'-------------------------------------------------------------------------------
function getPlaybackQueueIndex(playbackQueue as object, itemId as string) as integer
    if playbackQueue = invalid then return 0

    for i = 0 to playbackQueue.Count() - 1
        item = playbackQueue[i]
        if item <> invalid and Format.SafeString(item.itemId, "") = itemId then return i
    end for

    return 0
end function

