import "pkg:/source/Format.bs"
import "pkg:/source/String.bs"
'-------------------------------------------------------------------------------
' onWatchedStateChange
'-------------------------------------------------------------------------------
sub onWatchedStateChange()
    change = m.top.watchedStateChange
    if change = invalid then return

    itemId = Strings.ToString(change.itemId)
    if itemId = "" then return

    isWatched = change.isWatched = true
    if isWatched then m.top.playbackProgressChange = invalid
    affectedSeason = updateEpisodeWatchedState(itemId, isWatched)
    if affectedSeason = invalid then return
    renderEpisodes(m.pageState.episodes)
    restoreItemFocus(itemId)
    notifySeasonWatchedStateChanged(affectedSeason)
    refreshEpisodeCounts()
end sub

'-------------------------------------------------------------------------------
' onPlaybackProgressChange
'-------------------------------------------------------------------------------
sub onPlaybackProgressChange()
    change = m.top.playbackProgressChange
    if change = invalid then return

    itemId = Strings.ToString(change.itemId)
    if itemId = "" then return

    affectedSeason = updateEpisodePlaybackProgress(itemId, change)
    if affectedSeason = invalid then return

    renderEpisodes(m.pageState.episodes)
    restoreItemFocus(itemId)
    notifySeasonWatchedStateChanged(affectedSeason)
    refreshEpisodeCounts()
end sub

'-------------------------------------------------------------------------------
' updateEpisodeWatchedState
'-------------------------------------------------------------------------------
function updateEpisodeWatchedState(itemId as string, isWatched as boolean) as dynamic
    if Arrays.IsAssocArray(m.pageState.season) and Format.FirstNonEmpty([m.pageState.season.Id], "") = itemId then
        updateItemWatchedState(m.pageState.season, isWatched)
        updateSeasonEpisodesWatchedState(isWatched)
        return m.pageState.season
    end if

    for each episode in m.pageState.episodes
        if Arrays.IsAssocArray(episode) = false then continue for
        if Format.FirstNonEmpty([episode.Id], "") <> itemId then continue for

        wasWatched = isItemWatched(episode)
        updateItemWatchedState(episode, isWatched)
        return updateSeasonUnplayedCount(episode, wasWatched, isWatched)
    end for

    return invalid
end function

'-------------------------------------------------------------------------------
' updateSeasonEpisodesWatchedState
'-------------------------------------------------------------------------------
sub updateSeasonEpisodesWatchedState(isWatched as boolean)
    for each episode in m.pageState.episodes
        updateItemWatchedState(episode, isWatched)
    end for

    if Arrays.IsAssocArray(m.pageState.season) = false then return
    if UnwatchedEpisodeCount.Normalize(m.global.showUnwatchedEpisodeCount) <> UnwatchedEpisodeCount.Mode.Off then return
    if m.pageState.season.UserData = invalid then m.pageState.season.UserData = {}

    if isWatched then
        m.pageState.season.UserData.UnplayedItemCount = 0
    else
        m.pageState.season.UserData.UnplayedItemCount = m.pageState.episodes.Count()
    end if
end sub

'-------------------------------------------------------------------------------
' updateSeasonUnplayedCount
'-------------------------------------------------------------------------------
function updateSeasonUnplayedCount(episode as object, wasWatched as boolean, isWatched as boolean) as dynamic
    season = getSeasonForEpisode(episode)
    if Arrays.IsAssocArray(season) = false then return invalid
    if UnwatchedEpisodeCount.Normalize(m.global.showUnwatchedEpisodeCount) <> UnwatchedEpisodeCount.Mode.Off then return season
    if season.UserData = invalid then season.UserData = {}

    current = season.UserData.UnplayedItemCount
    if current = invalid then
        current = countUnplayedEpisodes(Strings.ToString(season.Id))
    else
        current = Number.ToInteger(current, 0)
        if isWatched then
            if wasWatched <> true and current > 0 then current = current - 1
        else
            if wasWatched = true or current = 0 then current = current + 1
        end if
    end if

    if current < 0 then current = 0
    season.UserData.UnplayedItemCount = current
    return season
end function

'-------------------------------------------------------------------------------
' getSeasonForEpisode
'-------------------------------------------------------------------------------
function getSeasonForEpisode(episode as object) as dynamic
    seasonId = Strings.ToString(episode.SeasonId)
    currentSeason = m.pageState.season
    if Arrays.IsAssocArray(currentSeason) and Strings.ToString(currentSeason.Id) = seasonId then return currentSeason

    for each season in m.pageState.seasons
        if Arrays.IsAssocArray(season) and Strings.ToString(season.Id) = seasonId then return season
    end for

    if m.pageState.allEpisodes <> true and Arrays.IsAssocArray(currentSeason) then return currentSeason
    return invalid
end function

'-------------------------------------------------------------------------------
' notifySeasonWatchedStateChanged
'-------------------------------------------------------------------------------
sub notifySeasonWatchedStateChanged(season as dynamic)
    if Arrays.IsAssocArray(season) = false then return

    seasonId = Format.FirstNonEmpty([season.Id], "")
    if seasonId = "" then return

    unplayedItemCount = 0
    if UnwatchedEpisodeCount.Normalize(m.global.showUnwatchedEpisodeCount) <> UnwatchedEpisodeCount.Mode.Off then
        unplayedItemCount = UnwatchedEpisodeCount.GetCount(season)
        ' Unknown server totals must not become a fully watched aggregate in the parent page.
        if unplayedItemCount < 0 then return
    else if season.UserData <> invalid and season.UserData.UnplayedItemCount <> invalid then
        unplayedItemCount = Number.ToInteger(season.UserData.UnplayedItemCount, 0)
    end if

    m.top.seasonWatchedStateChanged = {
        seasonId: seasonId
        unplayedItemCount: unplayedItemCount
        isWatched: unplayedItemCount = 0
    }
end sub

'-------------------------------------------------------------------------------
' countUnplayedEpisodes
'-------------------------------------------------------------------------------
function countUnplayedEpisodes(seasonId = "" as string) as integer
    count = 0
    for each episode in m.pageState.episodes
        if Arrays.IsAssocArray(episode) = false then continue for
        if seasonId <> "" and Strings.ToString(episode.SeasonId) <> seasonId then continue for
        if isItemWatched(episode) <> true then count = count + 1
    end for

    return count
end function

'-------------------------------------------------------------------------------
' isItemWatched
'-------------------------------------------------------------------------------
function isItemWatched(item as dynamic) as boolean
    if Arrays.IsAssocArray(item) = false then return false
    if item.UserData = invalid then return false

    return item.UserData.Played = true
end function

'-------------------------------------------------------------------------------
' updateItemWatchedState
'-------------------------------------------------------------------------------
sub updateItemWatchedState(item as dynamic, isWatched as boolean)
    if Arrays.IsAssocArray(item) = false then return
    if item.UserData = invalid then item.UserData = {}

    item.UserData.Played = isWatched
    if isWatched then
        item.UserData.PlayedPercentage = 0
        item.UserData.PlaybackPositionTicks = 0
    else
        item.UserData.PlayedPercentage = 0
    end if
end sub

'-------------------------------------------------------------------------------
' updateEpisodePlaybackProgress
'-------------------------------------------------------------------------------
function updateEpisodePlaybackProgress(itemId as string, change as object) as dynamic
    for each episode in m.pageState.episodes
        if Arrays.IsAssocArray(episode) = false then continue for
        if Format.FirstNonEmpty([episode.Id], "") <> itemId then continue for

        wasWatched = isItemWatched(episode)
        updateItemPlaybackProgress(episode, change)
        return updateSeasonUnplayedCount(episode, wasWatched, isItemWatched(episode))
    end for

    return invalid
end function

'-------------------------------------------------------------------------------
' updateItemPlaybackProgress
'-------------------------------------------------------------------------------
sub updateItemPlaybackProgress(item as dynamic, change as object)
    if Arrays.IsAssocArray(item) = false then return
    if item.UserData = invalid then item.UserData = {}

    if change.isFinished = true then
        item.UserData.Played = true
        item.UserData.PlayedPercentage = 0
        item.UserData.PlaybackPositionTicks = 0
    else
        positionTicks = getPlaybackProgressTicks(change.positionTicks)
        item.UserData.Played = false
        item.UserData.PlaybackPositionTicks = positionTicks
        item.UserData.PlayedPercentage = PlaybackProgress.GetPercentage(positionTicks, item.RunTimeTicks, change.durationTicks)
    end if
end sub

'-------------------------------------------------------------------------------
' getPlaybackProgressTicks
'-------------------------------------------------------------------------------
function getPlaybackProgressTicks(value as dynamic) as longinteger
    if value = invalid or value <= 0 then return 0

    return value
end function

'-------------------------------------------------------------------------------
' refreshEpisodeCounts
'-------------------------------------------------------------------------------
sub refreshEpisodeCounts()
    request = m.pageState.request
    if request = invalid or m.pageState.lifecycle.isActive <> true then return
    items = []
    if m.pageState.season <> invalid then items.Push(m.pageState.season)
    for each season in m.pageState.seasons
        items.Push(season)
    end for
    m.episodeCountRefresh.request = { server: request.server, token: request.token, userId: request.userId, items: items }
end sub

'-------------------------------------------------------------------------------
' onEpisodeCountsRefreshed
'-------------------------------------------------------------------------------
sub onEpisodeCountsRefreshed()
    response = m.episodeCountRefresh.response
    for each refreshed in response.payload
        updated = UnwatchedEpisodeCount.WithRefreshedCount(m.pageState.season, refreshed)
        if updated <> invalid then
            m.pageState.season = updated
            notifySeasonWatchedStateChanged(updated)
        end if
        for index = 0 to m.pageState.seasons.Count() - 1
            updated = UnwatchedEpisodeCount.WithRefreshedCount(m.pageState.seasons[index], refreshed)
            if updated <> invalid then m.pageState.seasons[index] = updated
        end for
    end for
    ' Refresh existing summary content, without rebuilding the episode list or moving focus.
    content = m.episodesGrid.content
    if isVerticalEpisodeList() <> true then
        content = invalid
        if m.episodesList.content <> invalid and m.episodesList.content.getChildCount() > 0 then content = m.episodesList.content.getChild(0)
    end if
    if content = invalid then return
    for each child in content.getChildren(-1, 0)
        if Strings.ToString(child.itemType) = MediaItem.Type.Season then child.raw = m.pageState.season
    end for
end sub
