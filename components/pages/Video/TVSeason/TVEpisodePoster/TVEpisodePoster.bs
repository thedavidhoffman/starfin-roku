import "pkg:/source/String.bs"
import "pkg:/source/UnwatchedEpisodeCount.bs"
import "pkg:/source/MediaItem.bs"
import "pkg:/source/Number.bs"
import "pkg:/source/MaskAssets.bs"
import "pkg:/source/ResolutionProfile.bs"
import "pkg:/source/ResolutionAssets.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    initReferences()
    initHandlers()
    MaskAssets.Apply(m.posterMask, "episode-thumbnail-mask.png", [531, 300], [354, 200])
    if m.top.itemContent <> invalid then onItemContentChanged()
end sub

'-------------------------------------------------------------------------------
' initReferences
'-------------------------------------------------------------------------------
sub initReferences()
    m.posterMask = m.top.findNode("posterMask")
    m.poster = m.top.findNode("poster")
    m.progressBar = m.top.findNode("progressBar")
    m.watchedIndicator = m.top.findNode("watchedIndicator")
    m.contentState = { item: invalid }
end sub

'-------------------------------------------------------------------------------
' initHandlers
'-------------------------------------------------------------------------------
sub initHandlers()
    m.top.observeField("itemContent", "onItemContentChanged")
end sub

'-------------------------------------------------------------------------------
' onItemContentChanged
'-------------------------------------------------------------------------------
sub onItemContentChanged()
    item = m.top.itemContent
    if m.contentState.item <> invalid then m.contentState.item.unobserveField("raw")
    m.contentState.item = item
    if item <> invalid then item.observeField("raw", "onItemDataChanged")
    if item = invalid then
        renderImage("")
        updateProgress(invalid)
        updateWatchedIndicator(invalid)
        return
    end if

    renderImage(item.HDPosterUrl)
    updateProgress(item)
    updateWatchedIndicator(item)
end sub

'-------------------------------------------------------------------------------
' renderImage
'-------------------------------------------------------------------------------
sub renderImage(imageUrl as string)
    m.poster.visible = true
    m.poster.uri = getPosterImageUrl(imageUrl)
end sub

'-------------------------------------------------------------------------------
' getPosterImageUrl
'-------------------------------------------------------------------------------
function getPosterImageUrl(imageUrl as string) as string
    if imageUrl <> "" then return imageUrl

    return "pkg:/images/media-card/thumbnail-placeholder-441x249.png"
end function

'-------------------------------------------------------------------------------
' updateProgress
'-------------------------------------------------------------------------------
sub updateProgress(item as dynamic)
    trackWidth = Number.ToInteger(m.progressBar.barWidth, 513)
    if isItemPlayed(item) or (item <> invalid and Strings.ToString(item.itemType) = MediaItem.Type.Season) then
        m.progressBar.visible = false
        m.progressBar.progressWidth = 0
        return
    end if

    progressWidth = 0
    if item <> invalid then
        if item.progressWidth <> invalid then progressWidth = Number.ToInteger(item.progressWidth, 0)
        if progressWidth = 0 and item.progressPercent <> invalid then
            progress = item.progressPercent
            if progress > 100 then progress = 100
            if progress > 0 then progressWidth = Number.ToInteger(trackWidth * (progress / 100), 0)
        end if
    end if

    visible = progressWidth > 0
    m.progressBar.visible = visible
    if visible <> true then
        m.progressBar.progressWidth = 0
        return
    end if

    if progressWidth > trackWidth then progressWidth = trackWidth
    m.progressBar.progressWidth = progressWidth
end sub

'-------------------------------------------------------------------------------
' updateWatchedIndicator
'-------------------------------------------------------------------------------
sub updateWatchedIndicator(item as dynamic)
    raw = invalid
    if item <> invalid then raw = item.raw
    m.watchedIndicator.data = {
        eligible: item <> invalid
        isWatched: isItemPlayed(item)
        unplayedCount: UnwatchedEpisodeCount.GetCount(raw)
        width: 57
        height: 57
    }
end sub

'-------------------------------------------------------------------------------
' isItemPlayed
'-------------------------------------------------------------------------------
function isItemPlayed(item as dynamic) as boolean
    if item = invalid then return false

    raw = item.raw
    if Strings.ToString(item.itemType) = MediaItem.Type.Season then
        return raw <> invalid and raw.UserData <> invalid and raw.UserData.UnplayedItemCount = 0
    end if

    return raw <> invalid and raw.UserData <> invalid and raw.UserData.Played = true
end function

'-------------------------------------------------------------------------------
' onItemDataChanged
'-------------------------------------------------------------------------------
sub onItemDataChanged()
    item = m.contentState.item
    updateProgress(item)
    updateWatchedIndicator(item)
end sub
