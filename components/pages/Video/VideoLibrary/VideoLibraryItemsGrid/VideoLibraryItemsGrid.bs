import "pkg:/source/Number.bs"

'-------------------------------------------------------------------------------
' onKeyEvent
'-------------------------------------------------------------------------------
function onKeyEvent(key as string, press as boolean) as boolean
    if key = "up" or key = "down" then
        m.top.navigationKeyPressed = {
            key: key
            press: press
        }
    end if

    if press and key = "up" and m.top.interceptFirstRowUp = true then
        focusedIndex = Number.ToInteger(m.top.itemFocused, -1)
        columnCount = Number.ToInteger(m.top.numColumns, 0)
        if focusedIndex >= 0 and columnCount > 0 and focusedIndex < columnCount then
            m.top.focusExitUp = true
            return true
        end if
    end if

    return GridFocus.HandleDown(m.top, key, press)
end function
