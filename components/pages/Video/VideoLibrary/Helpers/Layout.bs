'-------------------------------------------------------------------------------
' applyGridLayout
'-------------------------------------------------------------------------------
sub applyGridLayout(imageAspect as string)
    filterRowOffset = getFilterButtonRowOffset()
    isThumbnailLayout = imageAspect = "wide"
    usesHorizontalLetterLayout = imageAspect = "wide" or imageAspect = "jumbo" or imageAspect = "detailed"

    m.pageState.isThumbnailLayout = isThumbnailLayout
    m.top.thumbnailLayoutActive = isThumbnailLayout
    m.titleLabel.translation = [480, 120]
    m.filterButtonRow.translation = [264, 208]

    layoutSpec = LibraryGridLayout.GetSpec(imageAspect, "items")
    if isMusicVideoLibraryRequest() then
        layoutSpec.itemSpacing = [layoutSpec.itemSpacing[0], layoutSpec.itemSpacing[1] - 39]
    end if
    applyVideoLibraryGridSpec(layoutSpec, filterRowOffset)
    if isPlaylistsView() then
        m.top.callFunc("specializationApplyLayout", imageAspect)
    end if

    applyLetterGutterButtonLayout(usesHorizontalLetterLayout, m.itemsGrid.translation[0], m.itemsGrid.translation[1])
    applyLetterGridLayout(usesHorizontalLetterLayout, m.itemsGrid.translation[0], m.itemsGrid.translation[1])
    updateVideoLibraryProgressLayout(imageAspect)
    syncVideoLibraryChromeLayout(imageAspect)
end sub

'-------------------------------------------------------------------------------
' onVideoLibraryProgressChromeChanged
'-------------------------------------------------------------------------------
sub onVideoLibraryProgressChromeChanged()
    if m.chromeLayout.deferProgressSync = true then return

    syncVideoLibraryChromeLayout()
end sub

'-------------------------------------------------------------------------------
' commitVideoLibraryChromeLayout
'-------------------------------------------------------------------------------
sub commitVideoLibraryChromeLayout()
    m.chromeLayout.deferProgressSync = false
    syncVideoLibraryChromeLayout()
end sub

'-------------------------------------------------------------------------------
' syncVideoLibraryChromeLayout
'-------------------------------------------------------------------------------
sub syncVideoLibraryChromeLayout(imageAspect = invalid as dynamic)
    if imageAspect = invalid then imageAspect = m.pageState.imageAspect

    syncVideoLibraryBrowseControlsLayout(imageAspect)
    if isPlaylistsView() then
        m.top.callFunc("specializationSyncChromeLayout", imageAspect)
    end if
end sub

'-------------------------------------------------------------------------------
' syncVideoLibraryBrowseControlsLayout
'-------------------------------------------------------------------------------
sub syncVideoLibraryBrowseControlsLayout(imageAspect = invalid as dynamic)
    if imageAspect = invalid then imageAspect = m.pageState.imageAspect

    rightEdge = getVideoLibraryChromeRightEdge(imageAspect, "items")
    sortX = rightEdge - m.chromeLayout.sortWidth
    browseX = sortX - m.chromeLayout.buttonGap - m.chromeLayout.browseWidth
    randomX = browseX - m.chromeLayout.buttonGap - m.chromeLayout.randomWidth
    m.musicVideoRandomButton.translation = [randomX, m.chromeLayout.y]
    m.browseByButton.translation = [browseX, m.chromeLayout.y]
    m.sortButton.translation = [sortX, m.chromeLayout.y]

    actionLeft = browseX
    if m.musicVideoRandomButton.visible then actionLeft = randomX
    syncVideoLibraryTitleLayout(actionLeft)
end sub

'-------------------------------------------------------------------------------
' syncVideoLibraryTitleLayout
'-------------------------------------------------------------------------------
sub syncVideoLibraryTitleLayout(actionLeft as integer)
    titleCenter = 960
    defaultHalfWidth = 480
    actionGap = 24
    availableHalfWidth = actionLeft - actionGap - titleCenter
    if availableHalfWidth > defaultHalfWidth then availableHalfWidth = defaultHalfWidth
    if availableHalfWidth < 0 then availableHalfWidth = 0

    m.titleLabel.translation = [titleCenter - availableHalfWidth, m.chromeLayout.y]
    m.titleLabel.width = availableHalfWidth * 2
end sub

'-------------------------------------------------------------------------------
' getVideoLibraryChromeRightEdge
'-------------------------------------------------------------------------------
function getVideoLibraryChromeRightEdge(imageAspect as string, contentRole as string) as integer
    layoutSpec = LibraryGridLayout.GetSpec(imageAspect, contentRole)
    rightEdge = LibraryGridLayout.GetVisibleRightEdge(m.itemsGrid, layoutSpec)
    if m.videoLibraryProgressIndicator.visible then
        rightEdge = Number.ToInteger(m.videoLibraryProgressIndicator.rightEdge, rightEdge)
    end if
    return rightEdge
end function

'-------------------------------------------------------------------------------
' applyVideoLibraryGridSpec
'-------------------------------------------------------------------------------
sub applyVideoLibraryGridSpec(layoutSpec as object, verticalOffset = 0 as integer)
    m.itemsGrid.translation = [layoutSpec.translation[0], layoutSpec.translation[1] + verticalOffset]
    m.itemsGrid.itemSize = layoutSpec.itemSize
    m.itemsGrid.itemSpacing = layoutSpec.itemSpacing
    m.itemsGrid.numColumns = layoutSpec.numColumns
    m.itemsGrid.numRows = layoutSpec.numRows
    m.itemsGrid.focusBitmapUri = layoutSpec.focusBitmapUri
end sub

'-------------------------------------------------------------------------------
' getFilterButtonRowOffset
'-------------------------------------------------------------------------------
function getFilterButtonRowOffset() as integer
    if canShowFilterButtonRowLayout() <> true then
        return 0
    end if
    return 84
end function

'-------------------------------------------------------------------------------
' canShowFilterButtonRowLayout
'-------------------------------------------------------------------------------
function canShowFilterButtonRowLayout() as boolean
    return m.filterButtonRow <> invalid and m.filterButtonRow.visible = true
end function

'-------------------------------------------------------------------------------
' updateVideoLibraryProgressLayout
'-------------------------------------------------------------------------------
sub updateVideoLibraryProgressLayout(imageAspect as string)
    progressLayoutMode = imageAspect
    if isPlaylistsView() then
        progressLayoutMode = m.top.callFunc("specializationProgressLayoutMode", imageAspect)
    end if
    if progressLayoutMode <> "poster" then
        stopVideoLibraryProgressHold()
    end if
    m.videoLibraryProgressIndicator.gridLeft = Number.ToInteger(m.itemsGrid.translation[0])
    m.videoLibraryProgressIndicator.gridTop = Number.ToInteger(m.itemsGrid.translation[1])
    m.videoLibraryProgressIndicator.itemWidth = Number.ToInteger(m.itemsGrid.itemSize[0])
    m.videoLibraryProgressIndicator.itemSpacingX = Number.ToInteger(m.itemsGrid.itemSpacing[0])
    m.videoLibraryProgressIndicator.numColumns = Number.ToInteger(m.itemsGrid.numColumns)
    m.videoLibraryProgressIndicator.numRows = Number.ToInteger(m.itemsGrid.numRows)
    m.videoLibraryProgressIndicator.layoutMode = progressLayoutMode
    updateVideoLibraryProgressItemCount()
    updateVideoLibraryProgressFocusedIndex()
end sub

'-------------------------------------------------------------------------------
' updateVideoLibraryProgressItemCount
'-------------------------------------------------------------------------------
sub updateVideoLibraryProgressItemCount(itemCount = invalid as dynamic)
    resolvedItemCount = 0
    if itemCount <> invalid then
        resolvedItemCount = Number.ToInteger(itemCount)
    else if m.itemsGrid.content <> invalid then
        resolvedItemCount = m.itemsGrid.content.getChildCount()
    end if
    m.videoLibraryProgressIndicator.itemCount = resolvedItemCount
    totalItemCount = m.pageState.paging.totalCount
    if totalItemCount < resolvedItemCount then
        totalItemCount = resolvedItemCount
    end if
    m.videoLibraryProgressIndicator.totalItemCount = totalItemCount
end sub

'-------------------------------------------------------------------------------
' updateVideoLibraryProgressFocusedIndex
'-------------------------------------------------------------------------------
sub updateVideoLibraryProgressFocusedIndex()
    focusedIndex = getCurrentVideoLibraryFocusedIndex()
    m.pageState.progressFocusedIndex = focusedIndex
    m.videoLibraryProgressIndicator.focusedIndex = focusedIndex
end sub

'-------------------------------------------------------------------------------
' getCurrentVideoLibraryFocusedIndex
'-------------------------------------------------------------------------------
function getCurrentVideoLibraryFocusedIndex() as integer
    focusedIndex = m.itemsGrid.itemFocused
    if focusedIndex = invalid or focusedIndex < 0 then
        return 0
    end if
    return focusedIndex
end function

'-------------------------------------------------------------------------------
' getVideoLibraryItemCount
'-------------------------------------------------------------------------------
function getVideoLibraryItemCount() as integer
    if m.itemsGrid.content = invalid then
        return 0
    end if
    return m.itemsGrid.content.getChildCount()
end function

'-------------------------------------------------------------------------------
' applyLetterGutterButtonLayout
'-------------------------------------------------------------------------------
sub applyLetterGutterButtonLayout(isThumbnailLayout as boolean, gridLeft as integer, gridTop as integer)
    if isThumbnailLayout = true then
        thumbnailVisualOffset = 20
        m.letterGutterButton.layoutMode = "horizontal"
        m.letterGutterButton.translation = [
            gridLeft + thumbnailVisualOffset
            156
        ]
        return
    end if
    m.letterGutterButton.layoutMode = "vertical"
    m.letterGutterButton.translation = [
        24
        gridTop
    ]
end sub

'-------------------------------------------------------------------------------
' applyLetterGridLayout
'-------------------------------------------------------------------------------
sub applyLetterGridLayout(isThumbnailLayout as boolean, gridLeft as integer, gridTop as integer)
    if isThumbnailLayout = true then
        thumbnailVisualOffset = 20
        m.pageState.letterGridPanel = {
            x: gridLeft + thumbnailVisualOffset
            y: gridTop
        }
        return
    end if
    m.pageState.letterGridPanel = {
        x: 72
        y: gridTop
    }
end sub
