'-------------------------------------------------------------------------------
' onItemSelected
'-------------------------------------------------------------------------------
sub onItemSelected()
    selected = m.itemsGrid.itemSelected
    if selected = invalid then
        return
    end if
    if m.itemsGrid.content = invalid then
        return
    end if
    node = m.itemsGrid.content.getChild(selected)
    if node = invalid then
        return
    end if
    item = node.raw
    if isPlaylistsView() and m.top.callFunc("specializationHandleItemSelected", selected, item) then
        return
    end if
    itemId = Format.SafeString(Format.FirstNonEmpty([
        item.Id
    ], ""), "")
    if itemId = "" then
        return
    end if
    selection = {
        itemId: itemId
        item: item
        libraryIndex: selected
    }
    if isMusicVideo(item) then
        m.top.selectedVideo = selection
    else if isPlayableMovie(item) then
        m.top.selectedMovie = selection
    else if isTVSeries(item) then
        m.top.selectedSeries = selection
    else if isTVEpisode(item) then
        m.top.selectedEpisode = selection
    end if
end sub

'-------------------------------------------------------------------------------
' isMusicVideo
'-------------------------------------------------------------------------------
function isMusicVideo(item as dynamic) as boolean
    if Arrays.IsAssocArray(item) = false then return false

    return LCase(Format.SafeString(item.Type, "")) = "musicvideo"
end function

'-------------------------------------------------------------------------------
' beginMovieLibraryBrowse
'-------------------------------------------------------------------------------
function beginMovieLibraryBrowse(index as integer) as dynamic
    if m.pageState.request = invalid then return invalid
    if LCase(Format.SafeString(m.pageState.request.includeItemTypes, "")) <> "movie" then return invalid

    m.pageState.movieLibraryBrowse.active = true
    AsyncLifecycle.BeginFromField(m.pageState.lifecycle, m.pageState.request, "libraryId")
    return selectMovieLibraryBrowseIndex(index)
end function

'-------------------------------------------------------------------------------
' selectMovieLibraryBrowseIndex
'-------------------------------------------------------------------------------
function selectMovieLibraryBrowseIndex(index as integer) as dynamic
    if index < 0 or index >= m.pageState.allItems.Count() then return invalid

    item = m.pageState.allItems[index]
    if isPlayableMovie(item) <> true then return invalid

    m.pageState.movieLibraryBrowse.active = true
    m.pageState.movieLibraryBrowse.index = index
    if m.itemsGrid.content <> invalid and index < m.itemsGrid.content.getChildCount() then
        m.itemsGrid.jumpToItem = index
        m.itemsGrid.itemFocused = index
    end if

    requestNextMovieLibraryBrowsePageIfNeeded(index)
    return buildMovieLibraryBrowseState()
end function

'-------------------------------------------------------------------------------
' requestNextMovieLibraryBrowsePageIfNeeded
'-------------------------------------------------------------------------------
sub requestNextMovieLibraryBrowsePageIfNeeded(index as integer)
    if m.pageState.paging.hasMore <> true or m.pageState.paging.requestInFlight = true then return

    loadedCount = m.pageState.allItems.Count()
    if loadedCount <= 0 or loadedCount - index > 10 then return

    loadVideoLibraryPage(m.pageState.paging.nextStartIndex)
end sub

'-------------------------------------------------------------------------------
' buildMovieLibraryBrowseState
'-------------------------------------------------------------------------------
function buildMovieLibraryBrowseState() as dynamic
    index = m.pageState.movieLibraryBrowse.index
    loadedCount = m.pageState.allItems.Count()
    if index < 0 or index >= loadedCount then return invalid

    item = m.pageState.allItems[index]
    if isPlayableMovie(item) <> true then return invalid

    totalCount = m.pageState.paging.totalCount
    if totalCount < loadedCount then totalCount = loadedCount

    return {
        index: index
        itemId: Format.SafeString(item.Id, "")
        item: item
        loadedCount: loadedCount
        totalCount: totalCount
        hasMore: m.pageState.paging.hasMore = true
    }
end function

'-------------------------------------------------------------------------------
' publishMovieLibraryBrowseState
'-------------------------------------------------------------------------------
sub publishMovieLibraryBrowseState()
    if m.pageState.movieLibraryBrowse.active <> true then return

    state = buildMovieLibraryBrowseState()
    if state <> invalid then m.top.movieLibraryBrowseStateChanged = state
end sub

'-------------------------------------------------------------------------------
' renderItems
'-------------------------------------------------------------------------------
sub renderItems(items as object)
    if items = invalid then
        items = []
    end if
    m.pageState.items = items
    detachVideoLibraryGridContent()
    content = buildVideoLibraryContent(items)
    m.itemsGrid.content = content
    m.itemsGrid.visible = content.getChildCount() > 0
    m.emptyFavoritesLabel.visible = isFavoriteBrowseActive() and m.pageState.isLoading <> true and content.getChildCount() = 0
    updateVideoLibraryProgressItemCount(content.getChildCount())
end sub

'-------------------------------------------------------------------------------
' onMediaStateChange
'-------------------------------------------------------------------------------
sub onMediaStateChange()
    change = m.top.mediaStateChange
    if change = invalid then
        return
    end if
    itemId = Format.SafeString(change.itemId, "")
    if itemId = "" then
        return
    end if
    action = Format.SafeString(change.action, "")
    if applyMediaStateChangeToMatchingItems(itemId, change) <> true then
        return
    end if
    if isFavoriteBrowseActive() and action = "favorite" and change.value <> true then
        m.pageState.allItems = getItemsExcludingId(m.pageState.allItems, itemId)
        renderItems(m.pageState.allItems)
        updateTitleLabel(m.pageState.allItems.Count())
        return
    end if
    notifyVideoLibraryItemsChanged(itemId)
    if isPlaylistsView() then
        m.top.callFunc("specializationSyncState")
    end if
end sub

'-------------------------------------------------------------------------------
' applyMediaStateChangeToMatchingItems
'-------------------------------------------------------------------------------
function applyMediaStateChangeToMatchingItems(itemId as string, change as object) as boolean
    didApply = false
    for each item in m.pageState.allItems
        if Format.SafeString(item.Id, "") = itemId then
            if MediaState.ApplyToItem(item, change) then
                didApply = true
            end if
        end if
    end for
    return didApply
end function

'-------------------------------------------------------------------------------
' getItemsExcludingId
'-------------------------------------------------------------------------------
function getItemsExcludingId(items as object, itemId as string) as object
    remaining = []
    for each item in items
        if Format.SafeString(item.Id, "") <> itemId then
            remaining.Push(item)
        end if
    end for
    return remaining
end function

'-------------------------------------------------------------------------------
' onPlaybackProgressChange
'-------------------------------------------------------------------------------
sub onPlaybackProgressChange()
    change = m.top.playbackProgressChange
    if change = invalid then
        return
    end if
    itemId = Format.SafeString(change.itemId, "")
    if itemId = "" then
        return
    end if
    if applyPlaybackProgressChangeToMatchingItems(itemId, change) <> true then
        return
    end if
    notifyVideoLibraryItemsChanged(itemId)
    if isPlaylistsView() then
        m.top.callFunc("specializationSyncState")
    end if
end sub

'-------------------------------------------------------------------------------
' applyPlaybackProgressChangeToMatchingItems
'-------------------------------------------------------------------------------
function applyPlaybackProgressChangeToMatchingItems(itemId as string, change as object) as boolean
    didApply = false
    for each item in m.pageState.allItems
        if Format.SafeString(item.Id, "") = itemId then
            if PlaybackProgress.ApplyChangeToItem(item, change) then
                didApply = true
            end if
        end if
    end for
    return didApply
end function

'-------------------------------------------------------------------------------
' notifyVideoLibraryItemsChanged
'-------------------------------------------------------------------------------
sub notifyVideoLibraryItemsChanged(itemId as string)
    for i = 0 to m.pageState.allItems.Count() - 1
        item = m.pageState.allItems[i]
        if Format.SafeString(item.Id, "") = itemId then
            notifyVideoLibraryItemChanged(item, i)
        end if
    end for
end sub

'-------------------------------------------------------------------------------
' notifyVideoLibraryItemChanged
'-------------------------------------------------------------------------------
sub notifyVideoLibraryItemChanged(item as object, occurrenceIndex = invalid as dynamic)
    cacheKey = getVideoLibraryItemCacheKey(item, occurrenceIndex)
    if cacheKey = "" then
        return
    end if
    node = m.pageState.itemNodeCache[cacheKey]
    if node = invalid then
        return
    end if
    node.raw = invalid
    node.raw = item
end sub

'-------------------------------------------------------------------------------
' detachVideoLibraryGridContent
'-------------------------------------------------------------------------------
sub detachVideoLibraryGridContent()
    if m.itemsGrid = invalid then
        return
    end if
    if m.itemsGrid.content = invalid then
        return
    end if
    childCount = m.itemsGrid.content.getChildCount()
    if childCount > 0 then
        m.itemsGrid.content.removeChildrenIndex(childCount, 0)
    end if
end sub

'-------------------------------------------------------------------------------
' buildVideoLibraryContent
'-------------------------------------------------------------------------------
function buildVideoLibraryContent(items as object) as object
    content = CreateObject("roSGNode", "ContentNode")
    if items = invalid then
        return content
    end if
    ensureVideoLibraryItemNodeCache()
    for i = 0 to items.Count() - 1
        item = items[i]
        node = getCachedVideoLibraryItemNode(item, i)
        if node <> invalid then
            content.appendChild(node)
        end if
    end for
    return content
end function

'-------------------------------------------------------------------------------
' clearVideoLibraryItemNodeCache
'-------------------------------------------------------------------------------
sub clearVideoLibraryItemNodeCache()
    m.pageState.itemNodeCache = {}
    m.pageState.itemNodeCacheLayout = ""
end sub

'-------------------------------------------------------------------------------
' rebuildVideoLibraryItemNodeCache
'-------------------------------------------------------------------------------
sub rebuildVideoLibraryItemNodeCache()
    clearVideoLibraryItemNodeCache()
    ensureVideoLibraryItemNodeCache()
end sub

'-------------------------------------------------------------------------------
' ensureVideoLibraryItemNodeCache
'-------------------------------------------------------------------------------
sub ensureVideoLibraryItemNodeCache()
    layoutKey = m.pageState.imageAspect + ";" + m.pageState.layoutColumns.ToStr()
    if m.pageState.itemNodeCacheLayout = layoutKey then
        return
    end if
    m.pageState.itemNodeCache = {}
    m.pageState.itemNodeCacheLayout = layoutKey
end sub

'-------------------------------------------------------------------------------
' getCachedVideoLibraryItemNode
'-------------------------------------------------------------------------------
function getCachedVideoLibraryItemNode(item as dynamic, occurrenceIndex = invalid as dynamic) as dynamic
    cacheKey = getVideoLibraryItemCacheKey(item, occurrenceIndex)
    if cacheKey = "" then
        return createVideoLibraryItemNode(item)
    end if
    ensureVideoLibraryItemNodeCache()
    node = m.pageState.itemNodeCache[cacheKey]
    if node = invalid then
        node = createVideoLibraryItemNode(item)
        m.pageState.itemNodeCache[cacheKey] = node
    end if
    return node
end function

'-------------------------------------------------------------------------------
' createVideoLibraryItemNode
'-------------------------------------------------------------------------------
function createVideoLibraryItemNode(item as dynamic) as dynamic
    if Arrays.IsAssocArray(item) = false then
        return invalid
    end if
    imageAspect = m.pageState.imageAspect
    node = CreateObject("roSGNode", "ContentNode")
    node.HDPosterUrl = getItemImageUrl(item, imageAspect)
    node.AddFields({
        imageAspect: imageAspect
        cardLayout: VideoCardGridLayout.GetSpec(imageAspect, "items", m.pageState.layoutColumns)
        showMetadata: getVideoLibraryItemMetadataVisibility(item)
        raw: item
    })
    return node
end function

'-------------------------------------------------------------------------------
' getVideoLibraryItemMetadataVisibility
'-------------------------------------------------------------------------------
function getVideoLibraryItemMetadataVisibility(item as object) as boolean
    if isMusicVideoLibraryRequest() then return false
    if isPlaylistsView() then
        return m.top.callFunc("specializationShowsItemMetadata", item)
    end if
    return true
end function

'-------------------------------------------------------------------------------
' getVideoLibraryItemCacheKey
'-------------------------------------------------------------------------------
function getVideoLibraryItemCacheKey(item as dynamic, occurrenceIndex = invalid as dynamic) as string
    if Arrays.IsAssocArray(item) = false then
        return ""
    end if
    if isPlaylistsView() then
        return m.top.callFunc("specializationCacheKey", item, occurrenceIndex)
    end if
    return Format.SafeString(item.Id, "")
end function

'-------------------------------------------------------------------------------
' getVisibleVideoLibraryItems
'-------------------------------------------------------------------------------
function getVisibleVideoLibraryItems() as object
    return m.pageState.allItems
end function

'-------------------------------------------------------------------------------
' getItemImageUrl
'-------------------------------------------------------------------------------
function getItemImageUrl(item as dynamic, imageAspect as string) as string
    if Arrays.IsAssocArray(item) = false then
        return ""
    end if
    if isPlaylistsView() then
        return m.top.callFunc("specializationImageUrl", item, imageAspect)
    end if
    request = m.pageState.request
    if request = invalid then
        return ""
    end if
    layoutSpec = VideoCardGridLayout.GetSpec(imageAspect, "items", m.pageState.layoutColumns)
    artworkWidth = Number.ToInteger(layoutSpec.artworkSize[0], 0)
    artworkHeight = Number.ToInteger(layoutSpec.artworkSize[1], 0)
    if imageAspect = VideoCardPresentation.Type.Thumbnail then
        return ItemImage.GetThumbnailUrl(request.server, item, artworkWidth, artworkHeight)
    end if
    if imageAspect = VideoCardPresentation.Type.Detailed then
        return ItemImage.GetUrl(request.server, item, "Primary", artworkWidth, artworkHeight)
    end if
    return ItemImage.GetUrl(request.server, item, "Primary", artworkWidth, artworkHeight)
end function

'-------------------------------------------------------------------------------
' getVideoLibraryImageAspect
'-------------------------------------------------------------------------------
function getVideoLibraryImageAspect() as string
    if isPlaylistsView() then
        return m.top.callFunc("specializationImageAspect")
    end if
    settings = m.top.settings
    settingKey = SettingsStore.Key.MovieLibraryLayout
    request = m.pageState.request
    collectionType = ""
    if request <> invalid then
        collectionType = Format.SafeString(request.collectionType, "")
    end if
    if collectionType = "tvshows" then
        settingKey = SettingsStore.Key.TvLibraryLayout
    else if collectionType = "collection" then
        settingKey = SettingsStore.Key.CollectionItemsLayout
    else if collectionType = "musicvideos" then
        settingKey = SettingsStore.Key.MusicVideosLayout
    end if
    layout = LibraryLayoutSetting.Parse(settings[settingKey])
    m.pageState.layoutColumns = layout.columns
    return layout.presentation
end function

'-------------------------------------------------------------------------------
' isPlayableMovie
'-------------------------------------------------------------------------------
function isPlayableMovie(item as dynamic) as boolean
    if Arrays.IsAssocArray(item) = false then
        return false
    end if
    itemType = LCase(Format.FirstNonEmpty([
        item.Type
    ], ""))
    return itemType = "movie" or itemType = "video"
end function

'-------------------------------------------------------------------------------
' isTVSeries
'-------------------------------------------------------------------------------
function isTVSeries(item as dynamic) as boolean
    if Arrays.IsAssocArray(item) = false then
        return false
    end if
    return LCase(Format.FirstNonEmpty([
        item.Type
    ], "")) = "series"
end function

'-------------------------------------------------------------------------------
' isTVEpisode
'-------------------------------------------------------------------------------
function isTVEpisode(item as dynamic) as boolean
    if Arrays.IsAssocArray(item) = false then
        return false
    end if
    return LCase(Format.FirstNonEmpty([
        item.Type
    ], "")) = "episode"
end function

'-------------------------------------------------------------------------------
' openMediaActions
'-------------------------------------------------------------------------------
function openMediaActions() as boolean
    if m.itemsGrid.content = invalid then
        return false
    end if
    focusedIndex = m.itemsGrid.itemFocused
    if focusedIndex = invalid or focusedIndex < 0 then
        return false
    end if
    focusedNode = m.itemsGrid.content.getChild(focusedIndex)
    if focusedNode = invalid or focusedNode.raw = invalid then
        return false
    end if
    m.top.overlayRequested = {
        id: "mediaActions"
        sourcePage: "videoLibrary"
        componentName: "MediaActionsDialog"
        openFunction: "openMediaActions"
        closeField: "closeRequested"
        item: focusedNode.raw
        server: m.pageState.request.server
        token: m.pageState.request.token
        userId: m.pageState.request.userId
    }
    return true
end function
