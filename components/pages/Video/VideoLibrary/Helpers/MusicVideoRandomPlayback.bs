'-------------------------------------------------------------------------------
' syncMusicVideoRandomButton
'-------------------------------------------------------------------------------
sub syncMusicVideoRandomButton()
    previousVisible = m.musicVideoRandomButton.visible
    visible = isMusicVideoLibraryRequest() and hasPlayableMusicVideoItems()
    m.musicVideoRandomButton.visible = visible
    if visible <> true then m.musicVideoRandomButton.hasFocusVisual = false
    if visible <> previousVisible and m.chromeLayout.deferProgressSync <> true then syncVideoLibraryChromeLayout()
end sub

'-------------------------------------------------------------------------------
' hasPlayableMusicVideoItems
'-------------------------------------------------------------------------------
function hasPlayableMusicVideoItems() as boolean
    for each item in m.pageState.allItems
        if isMusicVideo(item) and Format.SafeString(item.Id, "") <> "" then return true
    end for
    return false
end function

'-------------------------------------------------------------------------------
' onMusicVideoRandomSelected
'-------------------------------------------------------------------------------
sub onMusicVideoRandomSelected()
    if isMusicVideoLibraryRequest() <> true then return
    if m.pageState.randomPlayback.loading then return

    request = buildVideoLibraryPageRequest(0)
    if request = invalid then return

    m.pageState.randomPlayback.loading = true
    AppStatus.ClearMessage()
    Spinner.Show()
    m.musicVideoRandomPlaybackTask.control = "stop"
    m.musicVideoRandomPlaybackTask.request = request
    m.musicVideoRandomPlaybackTask.control = "run"
end sub

'-------------------------------------------------------------------------------
' onMusicVideoRandomPlaybackResponse
'-------------------------------------------------------------------------------
sub onMusicVideoRandomPlaybackResponse()
    response = m.musicVideoRandomPlaybackTask.response
    if response = invalid then return
    if AsyncLifecycle.IsCurrentResponse(m.pageState.lifecycle, response, "libraryId", "musicVideoRandomPlayback") <> true then return
    if Number.ToInteger(response.queryId, -1) <> m.pageState.paging.queryId then return

    m.pageState.randomPlayback.loading = false
    Spinner.Hide()
    if response.ok <> true then
        AppStatus.SetMessage(Format.SafeString(response.errorMessage, "Unable to load random music videos."))
        focusMusicVideoRandomButton()
        return
    end if

    queue = shuffledMusicVideoPlaybackQueue(response.playbackQueue)
    if queue.Count() = 0 then
        AppStatus.SetMessage("No music videos are available for random playback.")
        focusMusicVideoRandomButton()
        return
    end if

    queueItem = queue[0]
    m.pageState.randomPlayback.restoreFocus = true
    AppStatus.ClearMessage()
    m.top.selectedVideo = {
        itemId: queueItem.itemId
        item: queueItem.item
        startPositionTicks: queueItem.startPositionTicks
        playbackQueue: queue
        playbackQueueIndex: 0
        playbackQueueMode: "random"
        playbackQueueScope: "random"
    }
end sub

'-------------------------------------------------------------------------------
' shuffledMusicVideoPlaybackQueue
'-------------------------------------------------------------------------------
function shuffledMusicVideoPlaybackQueue(sourceQueue as dynamic) as object
    queue = []
    if sourceQueue = invalid then return queue
    queue.Append(sourceQueue)

    for i = queue.Count() - 1 to 1 step -1
        swapIndex = Number.ToInteger(Rnd(0) * (i + 1), 0)
        if swapIndex < 0 then swapIndex = 0
        if swapIndex > i then swapIndex = i

        item = queue[i]
        queue[i] = queue[swapIndex]
        queue[swapIndex] = item
    end for
    return queue
end function

'-------------------------------------------------------------------------------
' cancelMusicVideoRandomPlayback
'-------------------------------------------------------------------------------
sub cancelMusicVideoRandomPlayback(clearRestoreFocus = true as boolean)
    if m.pageState.randomPlayback.loading then Spinner.Hide()
    m.pageState.randomPlayback.loading = false
    if clearRestoreFocus then m.pageState.randomPlayback.restoreFocus = false
    m.musicVideoRandomPlaybackTask.control = "stop"
end sub
