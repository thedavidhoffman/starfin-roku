'-------------------------------------------------------------------------------
' loadSavedVideoLibraryViewState
'-------------------------------------------------------------------------------
function loadSavedVideoLibraryViewState(request as object) as dynamic
    if canPersistVideoLibraryViewState(request) <> true then
        return invalid
    end if
    return LibraryViewStateStore.Load(Format.SafeString(request.accountKey, ""), Format.SafeString(request.libraryId, ""))
end function

'-------------------------------------------------------------------------------
' canPersistVideoLibraryViewState
'-------------------------------------------------------------------------------
function canPersistVideoLibraryViewState(request as dynamic) as boolean
    if request = invalid then
        return false
    end if
    collectionType = LCase(Format.SafeString(request.collectionType, ""))
    if collectionType = "playlist" or collectionType = "playlists" then return false
    if collectionType = "movies" or collectionType = "tvshows" then return true

    includeItemTypes = LCase(Format.SafeString(request.includeItemTypes, ""))
    return includeItemTypes = "movie" or includeItemTypes = "series"
end function

'-------------------------------------------------------------------------------
' persistVideoLibraryViewState
'-------------------------------------------------------------------------------
sub persistVideoLibraryViewState()
    request = m.pageState.request
    if canPersistVideoLibraryViewState(request) <> true then
        return
    end if
    selection = m.pageState.selectedSort
    if selection = invalid then
        return
    end if
    LibraryViewStateStore.Save(Format.SafeString(request.accountKey, ""), Format.SafeString(request.libraryId, ""), {
        optionKey: Format.SafeString(m.pageState.selectedSortKey, "SortName")
        sortKey: Format.SafeString(selection.sortKey, "SortName")
        sortOrder: LibraryBrowse.NormalizeSortOrder(selection.sortOrder)
        selectedDecade: m.pageState.filterSelection.decade
        selectedGenre: m.pageState.filterSelection.genre
        libraryTitle: Format.SafeString(request.title, "")
        collectionType: Format.SafeString(request.collectionType, "")
    })
end sub

'-------------------------------------------------------------------------------
' applySavedVideoLibraryViewState
'-------------------------------------------------------------------------------
sub applySavedVideoLibraryViewState(request as object, state as object)
    m.pageState.request = request
    optionKey = Format.SafeString(state.optionKey, "")
    sortOrder = LibraryBrowse.NormalizeSortOrder(state.sortOrder)
    if optionKey = "Favorites" then
        selection = LibraryBrowse.CreateSortSelection("Favorites", "SortName", "Favorites", sortOrder)
    else if optionKey = "Decade" or optionKey = "Genre" then
        m.pageState.filterSelection.decade = Number.ToInteger(state.selectedDecade, -1)
        m.pageState.filterSelection.genre = Format.SafeString(state.selectedGenre, "")
        selection = LibraryBrowse.CreateSortSelection(optionKey, "SortName", optionKey, sortOrder)
    else if optionKey = "PremiereDate" or optionKey = "DateCreated" or optionKey = "SortName" then
        selection = buildSortSelection(optionKey, sortOrder)
    else
        selection = LibraryBrowse.CreateSortSelection("SortName", "SortName", "Title")
    end if

    commitVideoLibraryBrowseState(selection)
    request.sortBy = Format.SafeString(selection.sortKey, "SortName")
    request.sortOrder = LibraryBrowse.NormalizeSortOrder(selection.sortOrder)
end sub

'-------------------------------------------------------------------------------
' showDecadeFilterRow
'-------------------------------------------------------------------------------
sub showDecadeFilterRow()
    options = m.pageState.filterCache.decadeOptions
    if options = invalid then
        options = []
    end if
    m.pageState.filterSelection.decade = LibraryBrowse.ResolveDecade(options, m.pageState.filterSelection.decade)
    m.filterButtonRow.filterType = "Decade"
    m.filterButtonRow.items = options
    m.filterButtonRow.selectedValue = m.pageState.filterSelection.decade.ToStr()
    m.filterButtonRow.visible = options.Count() > 0
    applyGridLayout(m.pageState.imageAspect)
end sub

'-------------------------------------------------------------------------------
' showGenreFilterRow
'-------------------------------------------------------------------------------
sub showGenreFilterRow()
    options = m.pageState.filterCache.genreOptions
    if options = invalid then
        options = []
    end if
    m.pageState.filterSelection.genre = LibraryBrowse.ResolveGenre(options, m.pageState.filterSelection.genre)
    m.filterButtonRow.filterType = "Genre"
    m.filterButtonRow.items = options
    m.filterButtonRow.selectedValue = m.pageState.filterSelection.genre
    m.filterButtonRow.visible = options.Count() > 0
    applyGridLayout(m.pageState.imageAspect)
end sub

'-------------------------------------------------------------------------------
' hideFilterButtonRow
'-------------------------------------------------------------------------------
sub hideFilterButtonRow()
    m.filterButtonRow.visible = false
    m.filterButtonRow.items = []
    m.filterButtonRow.selectedValue = ""
    applyGridLayout(m.pageState.imageAspect)
end sub

'-------------------------------------------------------------------------------
' onFilterButtonRowSelected
'-------------------------------------------------------------------------------
sub onFilterButtonRowSelected()
    selected = m.filterButtonRow.filterSelected
    if selected = invalid then
        return
    end if
    filterType = Format.SafeString(selected.type, "")
    if filterType = "Decade" then
        selectedDecade = Number.ToInteger(selected.value, -1)
        if selectedDecade = m.pageState.filterSelection.decade then
            m.filterButtonRow.setFocus(true)
            return
        end if
        m.pageState.filterSelection.decade = selectedDecade
        m.filterButtonRow.selectedValue = m.pageState.filterSelection.decade.ToStr()
    else if filterType = "Genre" then
        selectedGenre = Format.SafeString(selected.value, "")
        if selectedGenre = m.pageState.filterSelection.genre then
            m.filterButtonRow.setFocus(true)
            return
        end if
        m.pageState.filterSelection.genre = selectedGenre
        m.filterButtonRow.selectedValue = m.pageState.filterSelection.genre
    else
        return
    end if
    m.filterButtonRow.setFocus(true)
    persistVideoLibraryViewState()
    reloadVideoLibraryForSort("filter")
end sub

'-------------------------------------------------------------------------------
' onFilterButtonRowFocusExitUp
'-------------------------------------------------------------------------------
sub onFilterButtonRowFocusExitUp()
    focusBrowseByButton()
end sub

'-------------------------------------------------------------------------------
' onFilterButtonRowFocusExitDown
'-------------------------------------------------------------------------------
sub onFilterButtonRowFocusExitDown()
    focusItemsIfActive()
end sub

'-------------------------------------------------------------------------------
' createEmptyFilterCache
'-------------------------------------------------------------------------------
function createEmptyFilterCache() as object
    cache = LibraryBrowse.NormalizeFilterOptions(invalid)
    cache.decadeItemsByValue = {}
    cache.genreItemsByValue = {}
    return cache
end function

'-------------------------------------------------------------------------------
' createFilterCacheFromOptions
'-------------------------------------------------------------------------------
function createFilterCacheFromOptions(filterOptions as dynamic) as object
    cache = createEmptyFilterCache()
    options = LibraryBrowse.NormalizeFilterOptions(filterOptions)
    cache.decadeOptions = options.decadeOptions
    cache.genreOptions = options.genreOptions
    return cache
end function

'-------------------------------------------------------------------------------
' getCachedFilterItems
'-------------------------------------------------------------------------------
function getCachedFilterItems(filterType as string, filterValue as string) as object
    cache = m.pageState.filterCache
    if cache = invalid then
        return []
    end if
    if filterType = "Decade" then
        filterKey = Format.SafeString(filterValue, "")
        items = cache.decadeItemsByValue[filterKey]
        if items = invalid then
            items = VideoLibraryFilter.ByDecade(m.pageState.allItems, Number.ToInteger(filterKey, -1))
            cache.decadeItemsByValue[filterKey] = items
        end if
        if items <> invalid then
            return items
        end if
        return []
    end if
    if filterType = "Genre" then
        filterKey = Format.SafeString(filterValue, "")
        items = cache.genreItemsByValue[filterKey]
        if items = invalid then
            items = VideoLibraryFilter.ByGenre(m.pageState.allItems, filterKey)
            cache.genreItemsByValue[filterKey] = items
        end if
        if items <> invalid then
            return items
        end if
        return []
    end if
    return []
end function

'-------------------------------------------------------------------------------
' getSortedVideoLibraryItems
'-------------------------------------------------------------------------------
function getSortedVideoLibraryItems(items as object) as object
    sortedItems = copyVideoLibraryItems(items)
    if sortedItems.Count() < 2 then
        return sortedItems
    end if
    if hasPlaylistSpecialization() then
        return sortedItems
    end if
    selection = m.pageState.selectedSort
    if selection = invalid then
        selection = LibraryBrowse.CreateSortSelection("SortName", "SortName", "Title")
    end if
    sortKey = Format.SafeString(selection.sortKey, "SortName")
    if sortKey = "" then
        return sortedItems
    end if
    if sortKey = "Random" then
        return VideoLibrarySort.Shuffle(sortedItems)
    end if
    sortOrder = LibraryBrowse.NormalizeSortOrder(selection.sortOrder)
    if sortKey = "SortName" then
        return VideoLibrarySort.ByTitle(sortedItems, sortOrder)
    end if
    if sortKey = "PremiereDate" then
        return VideoLibrarySort.ByReleaseDate(sortedItems, sortOrder)
    end if
    if sortKey = "DateCreated" then
        return VideoLibrarySort.ByDateAdded(sortedItems, sortOrder)
    end if
    sortedItems.SortBy(sortKey)
    if LibraryBrowse.NormalizeSortOrder(selection.sortOrder) = "Descending" then
        reverseVideoLibraryItems(sortedItems)
    end if
    return sortedItems
end function

'-------------------------------------------------------------------------------
' copyVideoLibraryItems
'-------------------------------------------------------------------------------
function copyVideoLibraryItems(items as object) as object
    copiedItems = []
    if items = invalid then
        return copiedItems
    end if
    for each item in items
        copiedItems.Push(item)
    end for
    return copiedItems
end function

'-------------------------------------------------------------------------------
' reverseVideoLibraryItems
'-------------------------------------------------------------------------------
sub reverseVideoLibraryItems(items as object)
    if items = invalid or items.Count() < 2 then
        return
    end if
    leftIndex = 0
    rightIndex = items.Count() - 1
    while leftIndex < rightIndex
        temp = items[leftIndex]
        items[leftIndex] = items[rightIndex]
        items[rightIndex] = temp
        leftIndex = leftIndex + 1
        rightIndex = rightIndex - 1
    end while
end sub

'-------------------------------------------------------------------------------
' updateTitleLabel
'-------------------------------------------------------------------------------
sub updateTitleLabel(itemCount = invalid as dynamic)
    request = m.pageState.request
    title = "Library"
    if request <> invalid then
        title = Format.SafeString(request.title, "Library")
    end if
    startsWith = Format.SafeString(m.pageState.letterFilter.selected, "ALL")
    if startsWith <> "" and startsWith <> "ALL" then
        title = title + " (" + startsWith + ")"
    end if
    if itemCount <> invalid then
        title = title + MediaMetadata.BulletSeparator() + Number.FormatWithThousandsSeparator(itemCount) + " items"
    end if
    m.titleLabel.text = title
end sub

'-------------------------------------------------------------------------------
' onLetterGutterButtonFocused
'-------------------------------------------------------------------------------
sub onLetterGutterButtonFocused()
    if m.letterGutterButton.focused <> true then
        return
    end if
    openLetterGrid()
end sub

'-------------------------------------------------------------------------------
' onLetterGutterButtonSelected
'-------------------------------------------------------------------------------
sub onLetterGutterButtonSelected()
    openLetterGrid()
end sub

'-------------------------------------------------------------------------------
' openLetterGrid
'-------------------------------------------------------------------------------
function openLetterGrid() as boolean
    if canUseLetterNavigation() <> true then
        return false
    end if
    m.pageState.letterGridOpen = true
    m.top.letterGridRequested = {
        id: "letterGrid"
        componentName: "LetterGridDialog"
        openFunction: "openGrid"
        closeFields: ["closeRequested"]
        eventFields: ["letterSelected"]
        selectedLetter: m.pageState.letterFilter.selected
        panelX: m.pageState.letterGridPanel.x
        panelY: m.pageState.letterGridPanel.y
    }
    return true
end function

'-------------------------------------------------------------------------------
' closeLetterGrid
'-------------------------------------------------------------------------------
sub closeLetterGrid(focusItems as boolean)
    cancelPendingLetterSelection()
    wasOpen = m.pageState <> invalid and m.pageState.letterGridOpen = true
    if m.pageState <> invalid then
        m.pageState.letterGridOpen = false
    end if
    if wasOpen then
        m.top.letterGridRequested = {
            id: "letterGrid"
            action: "close"
        }
    end if
    if focusItems = true then
        focusItemsIfActive()
    end if
end sub

'-------------------------------------------------------------------------------
' selectLetter
'-------------------------------------------------------------------------------
sub selectLetter(letter as string)
    if letter = "" then
        return
    end if
    if letter = m.pageState.letterFilter.pending then return
    if letter = m.pageState.letterFilter.selected then
        closeLetterGrid(true)
        return
    end if
    beginPendingLetterSelection(letter)
end sub

'-------------------------------------------------------------------------------
' beginPendingLetterSelection
'-------------------------------------------------------------------------------
sub beginPendingLetterSelection(letter as string)
    m.pageState.letterFilter.pending = letter
    if m.pageState.letterFilter.previousPaging = invalid then
        m.pageState.letterFilter.previousPaging = {
            nextStartIndex: m.pageState.paging.nextStartIndex
            totalCount: m.pageState.paging.totalCount
            hasMore: m.pageState.paging.hasMore
        }
    end if
    m.pageState.isLoading = true
    m.pageState.paging.nextStartIndex = 0
    m.pageState.paging.requestInFlight = false
    m.pageState.paging.queryId = m.pageState.paging.queryId + 1
    updateLetterGridStatus("")
    loadVideoLibraryPage(0)
end sub

'-------------------------------------------------------------------------------
' restorePagingAfterRejectedLetterSelection
'-------------------------------------------------------------------------------
sub restorePagingAfterRejectedLetterSelection()
    previousPaging = m.pageState.letterFilter.previousPaging
    m.pageState.letterFilter.pending = ""
    m.pageState.letterFilter.previousPaging = invalid
    m.pageState.isLoading = false
    m.pageState.paging.requestInFlight = false
    if previousPaging = invalid then return

    m.pageState.paging.nextStartIndex = previousPaging.nextStartIndex
    m.pageState.paging.totalCount = previousPaging.totalCount
    m.pageState.paging.hasMore = previousPaging.hasMore
end sub

'-------------------------------------------------------------------------------
' cancelPendingLetterSelection
'-------------------------------------------------------------------------------
sub cancelPendingLetterSelection()
    if m.pageState = invalid or m.pageState.letterFilter.pending = "" then return

    m.videoLibraryTask.control = "stop"
    restorePagingAfterRejectedLetterSelection()
    m.pageState.paging.queryId = m.pageState.paging.queryId + 1
end sub

'-------------------------------------------------------------------------------
' updateLetterGridStatus
'-------------------------------------------------------------------------------
sub updateLetterGridStatus(statusText as string)
    if m.pageState.letterGridOpen <> true then return

    m.top.letterGridRequested = {
        id: "letterGrid"
        action: "update"
        statusText: statusText
    }
end sub

'-------------------------------------------------------------------------------
' onSortOverlayRequested
'-------------------------------------------------------------------------------
sub onSortOverlayRequested()
    request = m.browseByButton.overlayRequested
    if request = invalid then
        return
    end if
    request.selectedSortKey = m.pageState.selectedSortKey
    request.sortOptions = getVideoSortOptions()
    m.top.overlayRequested = request
end sub

'-------------------------------------------------------------------------------
' getVideoSortOptions
'-------------------------------------------------------------------------------
function getVideoSortOptions() as object
    options = [
        {
            optionKey: "SortName"
            sortKey: "SortName"
            sortOrder: ""
            label: "Title"
        }
        {
            optionKey: "PremiereDate"
            sortKey: "PremiereDate"
            sortOrder: ""
            label: "Release Date"
        }
        {
            optionKey: "DateCreated"
            sortKey: "DateCreated"
            sortOrder: ""
            label: "Date Added"
        }
        {
            optionKey: "Favorites"
            sortKey: "SortName"
            sortOrder: ""
            label: "Favorites"
        }
    ]
    if m.pageState.filterCache.decadeOptions.Count() > 0 then
        options.Push({
            optionKey: "Decade"
            sortKey: ""
            sortOrder: ""
            label: "Decade"
        })
    end if
    if m.pageState.filterCache.genreOptions.Count() > 0 then
        options.Push({
            optionKey: "Genre"
            sortKey: ""
            sortOrder: ""
            label: "Genre"
        })
    end if
    return options
end function

'-------------------------------------------------------------------------------
' onSortOrderChanged
'-------------------------------------------------------------------------------
sub onSortOrderChanged()
    applySortOrderSelection(m.sortButton.sortOrderChanged)
end sub

'-------------------------------------------------------------------------------
' applySortSelection
'-------------------------------------------------------------------------------
function applySortSelection(selection as object) as boolean
    if selection = invalid then return false

    selection = resetSortOrder(selection)
    selectedSortKey = Format.SafeString(selection.optionKey, "")
    if selectedSortKey = "" then return false

    if selectedSortKey <> Format.SafeString(m.pageState.selectedSortKey, "") then m.pageState.letterFilter.selected = "ALL"
    if selectedSortKey = "Favorites" then
        if isFavoriteBrowseActive() then return false

        commitVideoLibraryBrowseState(LibraryBrowse.CreateSortSelection("Favorites", "SortName", "Favorites"))
        hideFilterButtonRow()
        persistVideoLibraryViewState()
        reloadVideoLibraryForSort("items")
        return false
    end if
    if selectedSortKey = "Decade" then
        if Format.SafeString(m.pageState.selectedSortKey, "") = "Decade" then return false

        commitVideoLibraryBrowseState(LibraryBrowse.CreateSortSelection("Decade", "SortName", Format.SafeString(selection.label, "Decade")))
        m.pageState.filterSelection.decade = LibraryBrowse.ResolveDecade(m.pageState.filterCache.decadeOptions, m.pageState.filterSelection.decade)
        closeLetterGrid(false)
        persistVideoLibraryViewState()
        showDecadeFilterRow()
        reloadVideoLibraryForSort("filter")
        return false
    end if
    if selectedSortKey = "Genre" then
        if Format.SafeString(m.pageState.selectedSortKey, "") = "Genre" then return false

        commitVideoLibraryBrowseState(LibraryBrowse.CreateSortSelection("Genre", "SortName", Format.SafeString(selection.label, "Genre")))
        m.pageState.filterSelection.genre = LibraryBrowse.ResolveGenre(m.pageState.filterCache.genreOptions, m.pageState.filterSelection.genre)
        closeLetterGrid(false)
        persistVideoLibraryViewState()
        showGenreFilterRow()
        reloadVideoLibraryForSort("filter")
        return false
    end if

    if LibraryBrowse.IsDecadeActive(m.pageState.activeFilterType) or LibraryBrowse.IsGenreActive(m.pageState.activeFilterType) then hideFilterButtonRow()
    if selectedSortKey = m.pageState.selectedSortKey then
        if m.pageState.selectedSort = invalid then return false
        if Format.SafeString(m.pageState.selectedSort.sortOrder, "Ascending") <> "Descending" then return false

        current = m.pageState.selectedSort
        selection = LibraryBrowse.CreateSortSelection(current.optionKey, current.sortKey, current.label)
        commitVideoLibraryBrowseState(selection)
        persistVideoLibraryViewState()
        reloadVideoLibraryForSort("items")
        return false
    end if

    commitVideoLibraryBrowseState(selection)
    persistVideoLibraryViewState()
    reloadVideoLibraryForSort("items")
    return false
end function

'-------------------------------------------------------------------------------
' applySortOrderSelection
'-------------------------------------------------------------------------------
function applySortOrderSelection(selection as object) as boolean
    if selection = invalid then
        return false
    end if
    if m.pageState.selectedSort = invalid then
        return false
    end if
    sortOrder = Format.SafeString(selection.sortOrder, "Ascending")
    if sortOrder <> "Descending" then
        sortOrder = "Ascending"
    end if
    if Format.SafeString(m.pageState.selectedSort.sortOrder, "Ascending") = sortOrder then
        return false
    end if
    current = m.pageState.selectedSort
    selection = LibraryBrowse.CreateSortSelection(current.optionKey, current.sortKey, current.label, sortOrder)
    commitVideoLibraryBrowseState(selection)
    persistVideoLibraryViewState()
    reloadVideoLibraryForSort("items")
    return false
end function


'-------------------------------------------------------------------------------
' resetSortOrder
'-------------------------------------------------------------------------------
function resetSortOrder(selection as object) as object
    if selection = invalid then return selection

    sortKey = Format.SafeString(selection.sortKey, "")
    if sortKey = "" then return selection

    optionKey = Format.SafeString(selection.optionKey, "")
    label = Format.SafeString(selection.label, optionKey)
    return LibraryBrowse.CreateSortSelection(optionKey, sortKey, label)
end function

'-------------------------------------------------------------------------------
' reloadVideoLibraryForSort
'-------------------------------------------------------------------------------
sub reloadVideoLibraryForSort(refocusTarget = invalid as dynamic)
    request = m.pageState.request
    if request = invalid then
        return
    end if
    if m.pageState.selectedSort = invalid then
        return
    end if
    if Format.SafeString(m.pageState.selectedSort.sortKey, "") = "" then
        return
    end if
    request.sortBy = Format.SafeString(m.pageState.selectedSort.sortKey, "SortName")
    request.sortOrder = LibraryBrowse.NormalizeSortOrder(m.pageState.selectedSort.sortOrder)
    m.pageState.request = request
    AsyncLifecycle.Begin(m.pageState.lifecycle, request.libraryId)
    transitionMode = "items"
    if refocusTarget = invalid then transitionMode = "browseButton"
    if refocusTarget = "filter" then transitionMode = m.pageState.activeFilterType
    beginBrowseTransition(transitionMode, true)
    m.pageState.isLoading = true
    m.pageState.paging.nextStartIndex = 0
    m.pageState.paging.totalCount = -1
    m.pageState.paging.hasMore = false
    m.pageState.paging.requestInFlight = false
    m.pageState.paging.queryId = m.pageState.paging.queryId + 1
    m.pageState.allItems = []
    Spinner.Show(0)
    renderItems([])
    m.itemsGrid.jumpToItem = 0
    m.itemsGrid.itemFocused = 0
    loadVideoLibraryPage(0)
end sub

'-------------------------------------------------------------------------------
' isFavoriteBrowseActive
'-------------------------------------------------------------------------------
function isFavoriteBrowseActive() as boolean
    if m.pageState.selectedSort = invalid then return false

    return Format.SafeString(m.pageState.selectedSort.optionKey, "") = "Favorites"
end function

'-------------------------------------------------------------------------------
' buildSortSelection
'-------------------------------------------------------------------------------
function buildSortSelection(sortKey as string, sortOrder as string) as object
    normalizedSortKey = Format.SafeString(sortKey, "SortName")
    if normalizedSortKey = "Random" then
        normalizedSortKey = "SortName"
    end if
    return LibraryBrowse.CreateSortSelection(normalizedSortKey, normalizedSortKey, getSortSelectionLabel(normalizedSortKey), sortOrder)
end function

'-------------------------------------------------------------------------------
' getSortSelectionLabel
'-------------------------------------------------------------------------------
function getSortSelectionLabel(sortKey as string) as string
    if sortKey = "PremiereDate" then
        return "Release Date"
    end if
    if sortKey = "DateCreated" then
        return "Date Added"
    end if
    return "Title"
end function

'-------------------------------------------------------------------------------
' findFirstItemIndexForLetter
'-------------------------------------------------------------------------------
function findFirstItemIndexForLetter(letter as string) as integer
    targetLetter = UCase(Left(letter, 1))
    if targetLetter = "" then
        return -1
    end if
    if m.itemsGrid <> invalid and m.itemsGrid.content <> invalid then
        for i = 0 to m.itemsGrid.content.getChildCount() - 1
            node = m.itemsGrid.content.getChild(i)
            if node <> invalid and getItemSortLetter(node.raw) = targetLetter then
                return i
            end if
        end for
    end if
    items = m.pageState.items
    if items = invalid then
        return -1
    end if
    for i = 0 to items.Count() - 1
        if getItemSortLetter(items[i]) = targetLetter then
            return i
        end if
    end for
    return -1
end function

'-------------------------------------------------------------------------------
' getItemSortLetter
'-------------------------------------------------------------------------------
function getItemSortLetter(item as dynamic) as string
    if Arrays.IsAssocArray(item) = false then
        return ""
    end if
    title = getItemAlphabetTitle(item)
    if title = "" then
        return ""
    end if
    firstLetter = UCase(Left(title, 1))
    if firstLetter >= "A" and firstLetter <= "Z" then
        return firstLetter
    end if
    return "#"
end function

'-------------------------------------------------------------------------------
' getItemAlphabetTitle
'-------------------------------------------------------------------------------
function getItemAlphabetTitle(item as object) as string
    sortName = Strings.Trim(Format.SafeString(item.SortName, ""))
    if sortName <> "" then
        return sortName
    end if
    title = Strings.Trim(Format.SafeString(item.Name, ""))
    if title = "" then
        return ""
    end if
    return stripLeadingSortArticle(title)
end function

'-------------------------------------------------------------------------------
' stripLeadingSortArticle
'-------------------------------------------------------------------------------
function stripLeadingSortArticle(title as string) as string
    normalized = LCase(title)
    if Left(normalized, 4) = "the " then
        return Strings.Trim(Mid(title, 5))
    end if
    if Left(normalized, 3) = "an " then
        return Strings.Trim(Mid(title, 4))
    end if
    if Left(normalized, 2) = "a " then
        return Strings.Trim(Mid(title, 3))
    end if
    return title
end function
