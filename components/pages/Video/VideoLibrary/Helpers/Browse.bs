'-------------------------------------------------------------------------------
' loadSavedVideoLibraryViewState
'-------------------------------------------------------------------------------
function loadSavedVideoLibraryViewState(request as object) as dynamic
    if canPersistVideoLibraryViewState(request) <> true then
        return invalid
    end if
    return LibraryViewStateStore.Load(Format.SafeString(request.accountKey, ""), Format.SafeString(request.libraryId, ""))
end function

'-------------------------------------------------------------------------------
' canPersistVideoLibraryViewState
'-------------------------------------------------------------------------------
function canPersistVideoLibraryViewState(request as dynamic) as boolean
    if request = invalid then
        return false
    end if
    collectionType = LCase(Format.SafeString(request.collectionType, ""))
    if collectionType = "collection" then return false
    if collectionType = "playlist" or collectionType = "playlists" then return false
    if collectionType = "movies" or collectionType = "tvshows" then return true

    includeItemTypes = LCase(Format.SafeString(request.includeItemTypes, ""))
    return includeItemTypes = "movie" or includeItemTypes = "series"
end function

'-------------------------------------------------------------------------------
' persistVideoLibraryViewState
'-------------------------------------------------------------------------------
sub persistVideoLibraryViewState()
    request = m.pageState.request
    if canPersistVideoLibraryViewState(request) <> true then
        return
    end if
    selection = m.pageState.selectedSort
    if selection = invalid then
        return
    end if
    LibraryViewStateStore.Save(Format.SafeString(request.accountKey, ""), Format.SafeString(request.libraryId, ""), {
        optionKey: LibraryBrowse.NormalizeVideoOption(m.pageState.selectedSortKey)
        sortKey: Format.SafeString(selection.sortKey, LibraryBrowse.SortKey.Title)
        sortOrder: LibraryBrowse.NormalizeSortOrder(selection.sortOrder)
        selectedDecade: m.pageState.filterSelection.decade
        selectedGenre: m.pageState.filterSelection.genre
        libraryTitle: Format.SafeString(request.title, "")
        collectionType: Format.SafeString(request.collectionType, "")
    })
end sub

'-------------------------------------------------------------------------------
' applySavedVideoLibraryViewState
'-------------------------------------------------------------------------------
sub applySavedVideoLibraryViewState(request as object, state as object)
    m.pageState.request = request
    optionKey = LibraryBrowse.NormalizeVideoOption(state.optionKey)
    sortOrder = LibraryBrowse.NormalizeSortOrder(state.sortOrder)
    if optionKey = LibraryBrowse.Option.Favorites then
        selection = LibraryBrowse.CreateSortSelection(LibraryBrowse.Option.Favorites, LibraryBrowse.SortKey.Title, "Favorites", sortOrder)
    else if optionKey = LibraryBrowse.Option.Decade or optionKey = LibraryBrowse.Option.Genre then
        m.pageState.filterSelection.decade = Number.ToInteger(state.selectedDecade, -1)
        m.pageState.filterSelection.genre = Format.SafeString(state.selectedGenre, "")
        selection = LibraryBrowse.CreateSortSelection(optionKey, LibraryBrowse.SortKey.Title, optionKey, sortOrder)
    else if optionKey = LibraryBrowse.Option.ReleaseDate or optionKey = LibraryBrowse.Option.DateAdded or optionKey = LibraryBrowse.Option.Title then
        selection = buildSortSelection(optionKey, sortOrder)
    else
        selection = LibraryBrowse.CreateSortSelection(LibraryBrowse.Option.Title, LibraryBrowse.SortKey.Title, "Title")
    end if

    commitVideoLibraryBrowseState(selection)
    request.sortBy = Format.SafeString(selection.sortKey, LibraryBrowse.SortKey.Title)
    request.sortOrder = LibraryBrowse.NormalizeSortOrder(selection.sortOrder)
end sub

'-------------------------------------------------------------------------------
' showDecadeFilterRow
'-------------------------------------------------------------------------------
sub showDecadeFilterRow()
    options = m.pageState.filterOptions.decadeOptions
    if options = invalid then
        options = []
    end if
    m.pageState.filterSelection.decade = LibraryBrowse.ResolveDecade(options, m.pageState.filterSelection.decade)
    m.filterButtonRow.filterType = LibraryBrowse.Option.Decade
    m.filterButtonRow.items = options
    m.filterButtonRow.selectedValue = m.pageState.filterSelection.decade.ToStr()
    m.filterButtonRow.visible = options.Count() > 0
    applyGridLayout(m.pageState.imageAspect)
end sub

'-------------------------------------------------------------------------------
' showGenreFilterRow
'-------------------------------------------------------------------------------
sub showGenreFilterRow()
    options = m.pageState.filterOptions.genreOptions
    if options = invalid then
        options = []
    end if
    m.pageState.filterSelection.genre = LibraryBrowse.ResolveGenre(options, m.pageState.filterSelection.genre)
    m.filterButtonRow.filterType = LibraryBrowse.Option.Genre
    m.filterButtonRow.items = options
    m.filterButtonRow.selectedValue = m.pageState.filterSelection.genre
    m.filterButtonRow.visible = options.Count() > 0
    applyGridLayout(m.pageState.imageAspect)
end sub

'-------------------------------------------------------------------------------
' hideFilterButtonRow
'-------------------------------------------------------------------------------
sub hideFilterButtonRow()
    m.filterButtonRow.visible = false
    m.filterButtonRow.items = []
    m.filterButtonRow.selectedValue = ""
    applyGridLayout(m.pageState.imageAspect)
end sub

'-------------------------------------------------------------------------------
' onFilterButtonRowSelected
'-------------------------------------------------------------------------------
sub onFilterButtonRowSelected()
    selected = m.filterButtonRow.filterSelected
    if selected = invalid then
        return
    end if
    filterType = Format.SafeString(selected.type, "")
    if filterType = LibraryBrowse.Option.Decade then
        selectedDecade = Number.ToInteger(selected.value, -1)
        if selectedDecade = m.pageState.filterSelection.decade then
            m.filterButtonRow.setFocus(true)
            return
        end if
        m.pageState.filterSelection.decade = selectedDecade
        m.filterButtonRow.selectedValue = m.pageState.filterSelection.decade.ToStr()
    else if filterType = LibraryBrowse.Option.Genre then
        selectedGenre = Format.SafeString(selected.value, "")
        if selectedGenre = m.pageState.filterSelection.genre then
            m.filterButtonRow.setFocus(true)
            return
        end if
        m.pageState.filterSelection.genre = selectedGenre
        m.filterButtonRow.selectedValue = m.pageState.filterSelection.genre
    else
        return
    end if
    m.filterButtonRow.setFocus(true)
    persistVideoLibraryViewState()
    scheduleVideoFilterRefresh()
end sub

'-------------------------------------------------------------------------------
' onFilterButtonRowFocusExitUp
'-------------------------------------------------------------------------------
sub onFilterButtonRowFocusExitUp()
    focusBrowseByButton()
end sub

'-------------------------------------------------------------------------------
' onFilterButtonRowFocusExitDown
'-------------------------------------------------------------------------------
sub onFilterButtonRowFocusExitDown()
    focusItemsIfActive()
end sub

'-------------------------------------------------------------------------------
' updateTitleLabel
'-------------------------------------------------------------------------------
sub updateTitleLabel(itemCount = invalid as dynamic)
    request = m.pageState.request
    title = "Library"
    if request <> invalid then
        title = Format.SafeString(request.title, "Library")
    end if
    startsWith = Format.SafeString(m.pageState.letterFilter.selected, "ALL")
    if startsWith <> "" and startsWith <> "ALL" then
        title = title + " (" + startsWith + ")"
    end if
    if itemCount <> invalid then
        title = title + MediaMetadata.BulletSeparator() + Number.FormatWithThousandsSeparator(itemCount) + " items"
    end if
    m.titleLabel.text = title
end sub

'-------------------------------------------------------------------------------
' onLetterGutterButtonFocused
'-------------------------------------------------------------------------------
sub onLetterGutterButtonFocused()
    if m.letterGutterButton.focused <> true then
        return
    end if
    openLetterGrid()
end sub

'-------------------------------------------------------------------------------
' onLetterGutterButtonSelected
'-------------------------------------------------------------------------------
sub onLetterGutterButtonSelected()
    openLetterGrid()
end sub

'-------------------------------------------------------------------------------
' openLetterGrid
'-------------------------------------------------------------------------------
function openLetterGrid() as boolean
    if canUseLetterNavigation() <> true then
        return false
    end if
    m.pageState.letterGridOpen = true
    m.top.letterGridRequested = {
        id: "letterGrid"
        componentName: "LetterGridDialog"
        openFunction: "openGrid"
        closeFields: ["closeRequested"]
        eventFields: ["letterSelected"]
        selectedLetter: m.pageState.letterFilter.selected
        panelX: m.pageState.letterGridPanel.x
        panelY: m.pageState.letterGridPanel.y
    }
    return true
end function

'-------------------------------------------------------------------------------
' closeLetterGrid
'-------------------------------------------------------------------------------
sub closeLetterGrid(focusItems as boolean)
    cancelPendingLetterSelection()
    wasOpen = m.pageState <> invalid and m.pageState.letterGridOpen = true
    if m.pageState <> invalid then
        m.pageState.letterGridOpen = false
    end if
    if wasOpen then
        m.top.letterGridRequested = {
            id: "letterGrid"
            action: "close"
        }
    end if
    if focusItems = true then
        focusItemsIfActive()
    end if
end sub

'-------------------------------------------------------------------------------
' selectLetter
'-------------------------------------------------------------------------------
sub selectLetter(letter as string)
    if letter = "" then
        return
    end if
    if letter = m.pageState.letterFilter.pending then return
    if letter = m.pageState.letterFilter.selected then
        closeLetterGrid(true)
        return
    end if
    beginPendingLetterSelection(letter)
end sub

'-------------------------------------------------------------------------------
' beginPendingLetterSelection
'-------------------------------------------------------------------------------
sub beginPendingLetterSelection(letter as string)
    cancelMusicVideoRandomPlayback()
    m.pageState.letterFilter.pending = letter
    if m.pageState.letterFilter.previousPaging = invalid then
        m.pageState.letterFilter.previousPaging = {
            nextStartIndex: m.pageState.paging.nextStartIndex
            totalCount: m.pageState.paging.totalCount
            hasMore: m.pageState.paging.hasMore
        }
    end if
    m.pageState.isLoading = true
    m.pageState.paging.nextStartIndex = 0
    m.pageState.paging.requestInFlight = false
    m.pageState.paging.queryId = m.pageState.paging.queryId + 1
    updateLetterGridStatus("")
    loadVideoLibraryPage(0)
end sub

'-------------------------------------------------------------------------------
' restorePagingAfterRejectedLetterSelection
'-------------------------------------------------------------------------------
sub restorePagingAfterRejectedLetterSelection()
    previousPaging = m.pageState.letterFilter.previousPaging
    m.pageState.letterFilter.pending = ""
    m.pageState.letterFilter.previousPaging = invalid
    m.pageState.isLoading = false
    m.pageState.paging.requestInFlight = false
    if previousPaging = invalid then return

    m.pageState.paging.nextStartIndex = previousPaging.nextStartIndex
    m.pageState.paging.totalCount = previousPaging.totalCount
    m.pageState.paging.hasMore = previousPaging.hasMore
end sub

'-------------------------------------------------------------------------------
' cancelPendingLetterSelection
'-------------------------------------------------------------------------------
sub cancelPendingLetterSelection()
    if m.pageState = invalid or m.pageState.letterFilter.pending = "" then return

    m.videoLibraryTask.control = TaskControl.Command.Stop
    restorePagingAfterRejectedLetterSelection()
    m.pageState.paging.queryId = m.pageState.paging.queryId + 1
end sub

'-------------------------------------------------------------------------------
' updateLetterGridStatus
'-------------------------------------------------------------------------------
sub updateLetterGridStatus(statusText as string)
    if m.pageState.letterGridOpen <> true then return

    m.top.letterGridRequested = {
        id: "letterGrid"
        action: "update"
        statusText: statusText
    }
end sub

'-------------------------------------------------------------------------------
' onSortOverlayRequested
'-------------------------------------------------------------------------------
sub onSortOverlayRequested()
    request = m.browseByButton.overlayRequested
    if request = invalid then
        return
    end if
    request.selectedSortKey = m.pageState.selectedSortKey
    request.sortOptions = getVideoSortOptions()
    m.top.overlayRequested = request
end sub

'-------------------------------------------------------------------------------
' getVideoSortOptions
'-------------------------------------------------------------------------------
function getVideoSortOptions() as object
    options = [
        {
            optionKey: LibraryBrowse.Option.Title
            sortKey: LibraryBrowse.SortKey.Title
            sortOrder: ""
            label: "Title"
        }
        {
            optionKey: LibraryBrowse.Option.ReleaseDate
            sortKey: LibraryBrowse.SortKey.ReleaseDate
            sortOrder: ""
            label: "Release Date"
        }
        {
            optionKey: LibraryBrowse.Option.DateAdded
            sortKey: LibraryBrowse.SortKey.DateAdded
            sortOrder: ""
            label: "Date Added"
        }
        {
            optionKey: LibraryBrowse.Option.Favorites
            sortKey: LibraryBrowse.SortKey.Title
            sortOrder: ""
            label: "Favorites"
        }
    ]
    capabilities = getVideoLibraryBrowseCapabilities()
    if capabilities.filters = true and m.pageState.filterOptions.decadeOptions.Count() > 0 then
        options.Push({
            optionKey: LibraryBrowse.Option.Decade
            sortKey: ""
            sortOrder: ""
            label: "Decade"
        })
    end if
    if capabilities.filters = true and m.pageState.filterOptions.genreOptions.Count() > 0 then
        options.Push({
            optionKey: LibraryBrowse.Option.Genre
            sortKey: ""
            sortOrder: ""
            label: "Genre"
        })
    end if
    return options
end function

'-------------------------------------------------------------------------------
' onSortOrderChanged
'-------------------------------------------------------------------------------
sub onSortOrderChanged()
    applySortOrderSelection(m.sortButton.sortOrderChanged)
end sub

'-------------------------------------------------------------------------------
' applySortSelection
'-------------------------------------------------------------------------------
sub applySortSelection(selection as object)
    if selection = invalid then return

    selection = resetSortOrder(selection)
    selectedSortKey = Format.SafeString(selection.optionKey, "")
    if selectedSortKey = "" then return

    browseOptionChanged = selectedSortKey <> Format.SafeString(m.pageState.selectedSortKey, "")
    if browseOptionChanged then
        closeLetterGrid(false)
        m.pageState.letterFilter.selected = "ALL"
    end if

    filterRowAction = ""
    reloadTarget = "items"
    if selectedSortKey = LibraryBrowse.Option.Favorites then
        if isFavoriteBrowseActive() then return

        selection = LibraryBrowse.CreateSortSelection(LibraryBrowse.Option.Favorites, LibraryBrowse.SortKey.Title, "Favorites")
        filterRowAction = "hide"
    else if selectedSortKey = LibraryBrowse.Option.Decade then
        if Format.SafeString(m.pageState.selectedSortKey, "") = LibraryBrowse.Option.Decade then return

        selection = LibraryBrowse.CreateSortSelection(LibraryBrowse.Option.Decade, LibraryBrowse.SortKey.Title, Format.SafeString(selection.label, "Decade"))
        m.pageState.filterSelection.decade = LibraryBrowse.ResolveDecade(m.pageState.filterOptions.decadeOptions, m.pageState.filterSelection.decade)
        filterRowAction = LibraryBrowse.Option.Decade
        reloadTarget = "filter"
    else if selectedSortKey = LibraryBrowse.Option.Genre then
        if Format.SafeString(m.pageState.selectedSortKey, "") = LibraryBrowse.Option.Genre then return

        selection = LibraryBrowse.CreateSortSelection(LibraryBrowse.Option.Genre, LibraryBrowse.SortKey.Title, Format.SafeString(selection.label, "Genre"))
        m.pageState.filterSelection.genre = LibraryBrowse.ResolveGenre(m.pageState.filterOptions.genreOptions, m.pageState.filterSelection.genre)
        filterRowAction = LibraryBrowse.Option.Genre
        reloadTarget = "filter"
    else
        if LibraryBrowse.IsDecadeActive(m.pageState.activeFilterType) or LibraryBrowse.IsGenreActive(m.pageState.activeFilterType) then filterRowAction = "hide"
        if selectedSortKey = m.pageState.selectedSortKey then
            if m.pageState.selectedSort = invalid then return
            if Format.SafeString(m.pageState.selectedSort.sortOrder, LibraryBrowse.SortOrder.Ascending) <> LibraryBrowse.SortOrder.Descending then return

            current = m.pageState.selectedSort
            selection = LibraryBrowse.CreateSortSelection(current.optionKey, current.sortKey, current.label)
        end if
    end if

    commitVideoLibraryBrowseState(selection)
    if filterRowAction = LibraryBrowse.Option.Decade then
        showDecadeFilterRow()
    else if filterRowAction = LibraryBrowse.Option.Genre then
        showGenreFilterRow()
    else if filterRowAction = "hide" then
        hideFilterButtonRow()
    end if
    persistVideoLibraryViewState()
    if filterRowAction = LibraryBrowse.Option.Decade or filterRowAction = LibraryBrowse.Option.Genre then
        scheduleVideoFilterRefresh()
    else
        reloadVideoLibraryForSort(reloadTarget)
    end if
end sub

'-------------------------------------------------------------------------------
' scheduleVideoFilterRefresh
'-------------------------------------------------------------------------------
sub scheduleVideoFilterRefresh()
    if m.pageState.request = invalid then return

    cancelMusicVideoRandomPlayback()
    m.filterRefreshTimer.control = TimerControl.Command.Stop
    if m.pageState.filterRefresh.phase = "idle" and m.pageState.committedFilterView = invalid then rememberCommittedVideoFilterView()
    queryId = LibraryBrowseRefresh.Queue(m.pageState.filterRefresh, m.pageState.paging.queryId)
    m.pageState.paging.queryId = queryId
    m.pageState.paging.requestInFlight = false
    m.log.write("Filter refresh queued libraryId=" + getVideoLibraryId() + " mediaType=video filter=" + getVideoFilterLogValue() + " queryId=" + queryId.ToStr())
    m.filterRefreshTimer.duration = 0.2
    m.filterRefreshTimer.control = TimerControl.Command.Start
end sub

'-------------------------------------------------------------------------------
' onVideoFilterRefreshTimerFired
'-------------------------------------------------------------------------------
sub onVideoFilterRefreshTimerFired()
    if m.pageState.filterRefresh.phase = "loading" then
        m.videoLibraryTask.control = TaskControl.Command.Stop
        rollbackVideoFilterRefresh("Library filter request timed out.")
        m.filterRefreshTimer.duration = 0.2
        return
    end if
    if LibraryBrowseRefresh.Begin(m.pageState.filterRefresh) <> true then return

    m.videoLibraryTask.control = TaskControl.Command.Stop
    m.pageState.isLoading = true
    m.pageState.paging.nextStartIndex = 0
    m.pageState.paging.totalCount = -1
    m.pageState.paging.hasMore = false
    m.pageState.paging.requestInFlight = false
    AsyncLifecycle.Begin(m.pageState.lifecycle, m.pageState.request.libraryId)
    beginBrowseTransition(m.pageState.activeFilterType, true)
    m.log.write("Filter refresh started libraryId=" + getVideoLibraryId() + " mediaType=video filter=" + getVideoFilterLogValue() + " queryId=" + m.pageState.paging.queryId.ToStr())
    loadVideoLibraryPage(0)
    m.filterRefreshTimer.duration = LibraryBrowseRefresh.RequestTimeoutSeconds()
    m.filterRefreshTimer.control = TimerControl.Command.Start
end sub

'-------------------------------------------------------------------------------
' rememberCommittedVideoFilterView
'-------------------------------------------------------------------------------
sub rememberCommittedVideoFilterView()
    m.pageState.committedFilterView = {
        selection: LibraryBrowse.CreateSortSelection(m.pageState.selectedSort.optionKey, m.pageState.selectedSort.sortKey, m.pageState.selectedSort.label, m.pageState.selectedSort.sortOrder)
        filterType: m.pageState.activeFilterType
        decade: m.pageState.filterSelection.decade
        genre: m.pageState.filterSelection.genre
        items: m.pageState.allItems
        nextStartIndex: m.pageState.paging.nextStartIndex
        totalCount: m.pageState.paging.totalCount
        hasMore: m.pageState.paging.hasMore
    }
end sub

'-------------------------------------------------------------------------------
' rollbackVideoFilterRefresh
'-------------------------------------------------------------------------------
sub rollbackVideoFilterRefresh(message as string)
    LibraryBrowseRefresh.Rollback(m.pageState.filterRefresh)
    m.pageState.paging.queryId = m.pageState.filterRefresh.queryId
    m.pageState.isLoading = false
    m.pageState.paging.requestInFlight = false
    restoreCommittedVideoFilterView(m.pageState.committedFilterView)
    AppStatus.SetMessage(message)
    focusRestoredVideoFilterView()
    m.log.error("Filter refresh rolled back libraryId=" + getVideoLibraryId() + " mediaType=video message=" + message)
end sub

'-------------------------------------------------------------------------------
' focusRestoredVideoFilterView
'-------------------------------------------------------------------------------
sub focusRestoredVideoFilterView()
    if (LibraryBrowse.IsDecadeActive(m.pageState.activeFilterType) or LibraryBrowse.IsGenreActive(m.pageState.activeFilterType)) and focusFilterButtonRow() then return

    focusBrowseByButton()
end sub

'-------------------------------------------------------------------------------
' restoreCommittedVideoFilterView
'-------------------------------------------------------------------------------
sub restoreCommittedVideoFilterView(previous as dynamic)
    if previous = invalid then return

    commitVideoLibraryBrowseState(previous.selection)
    m.pageState.activeFilterType = previous.filterType
    m.pageState.filterSelection.decade = previous.decade
    m.pageState.filterSelection.genre = previous.genre
    m.pageState.allItems = previous.items
    m.pageState.isLoading = false
    m.pageState.paging.requestInFlight = false
    m.pageState.paging.nextStartIndex = previous.nextStartIndex
    m.pageState.paging.totalCount = previous.totalCount
    m.pageState.paging.hasMore = previous.hasMore
    if LibraryBrowse.IsDecadeActive(previous.filterType) then
        showDecadeFilterRow()
    else if LibraryBrowse.IsGenreActive(previous.filterType) then
        showGenreFilterRow()
    else
        hideFilterButtonRow()
    end if
    rebuildVideoLibraryItemNodeCache()
    renderItems(previous.items)
    updateTitleLabel(previous.totalCount)
    persistVideoLibraryViewState()
end sub

'-------------------------------------------------------------------------------
' getVideoLibraryId
'-------------------------------------------------------------------------------
function getVideoLibraryId() as string
    if m.pageState.request = invalid then return ""
    return Format.SafeString(m.pageState.request.libraryId, "")
end function

'-------------------------------------------------------------------------------
' getVideoFilterLogValue
'-------------------------------------------------------------------------------
function getVideoFilterLogValue() as string
    if LibraryBrowse.IsDecadeActive(m.pageState.activeFilterType) then return "Decade:" + m.pageState.filterSelection.decade.ToStr()
    if LibraryBrowse.IsGenreActive(m.pageState.activeFilterType) then return "Genre:" + m.pageState.filterSelection.genre
    return LibraryBrowse.NormalizeVideoOption(m.pageState.selectedSortKey)
end function

'-------------------------------------------------------------------------------
' applySortOrderSelection
'-------------------------------------------------------------------------------
function applySortOrderSelection(selection as object) as boolean
    if selection = invalid then
        return false
    end if
    if m.pageState.selectedSort = invalid then
        return false
    end if
    sortOrder = LibraryBrowse.NormalizeSortOrder(selection.sortOrder)
    if Format.SafeString(m.pageState.selectedSort.sortOrder, LibraryBrowse.SortOrder.Ascending) = sortOrder then
        return false
    end if
    current = m.pageState.selectedSort
    selection = LibraryBrowse.CreateSortSelection(current.optionKey, current.sortKey, current.label, sortOrder)
    commitVideoLibraryBrowseState(selection)
    persistVideoLibraryViewState()
    reloadVideoLibraryForSort("items")
    return false
end function


'-------------------------------------------------------------------------------
' resetSortOrder
'-------------------------------------------------------------------------------
function resetSortOrder(selection as object) as object
    if selection = invalid then return selection

    sortKey = Format.SafeString(selection.sortKey, "")
    if sortKey = "" then return selection

    optionKey = Format.SafeString(selection.optionKey, "")
    label = Format.SafeString(selection.label, optionKey)
    return LibraryBrowse.CreateSortSelection(optionKey, sortKey, label)
end function

'-------------------------------------------------------------------------------
' reloadVideoLibraryForSort
'-------------------------------------------------------------------------------
sub reloadVideoLibraryForSort(refocusTarget = invalid as dynamic)
    request = m.pageState.request
    if request = invalid then
        return
    end if
    if m.pageState.selectedSort = invalid then
        return
    end if
    if Format.SafeString(m.pageState.selectedSort.sortKey, "") = "" then
        return
    end if
    cancelMusicVideoRandomPlayback()
    m.filterRefreshTimer.control = TimerControl.Command.Stop
    LibraryBrowseRefresh.Cancel(m.pageState.filterRefresh)
    request.sortBy = Format.SafeString(m.pageState.selectedSort.sortKey, LibraryBrowse.SortKey.Title)
    request.sortOrder = LibraryBrowse.NormalizeSortOrder(m.pageState.selectedSort.sortOrder)
    m.pageState.request = request
    AsyncLifecycle.Begin(m.pageState.lifecycle, request.libraryId)
    transitionMode = "items"
    if refocusTarget = invalid then transitionMode = "browseButton"
    if refocusTarget = "filter" then transitionMode = m.pageState.activeFilterType
    beginBrowseTransition(transitionMode, true)
    m.pageState.isLoading = true
    m.chromeLayout.deferProgressSync = true
    m.pageState.paging.nextStartIndex = 0
    m.pageState.paging.totalCount = -1
    m.pageState.paging.hasMore = false
    m.pageState.paging.requestInFlight = false
    m.pageState.paging.queryId = m.pageState.paging.queryId + 1
    m.pageState.allItems = []
    Spinner.Show(0)
    renderItems([])
    m.itemsGrid.jumpToItem = 0
    m.itemsGrid.itemFocused = 0
    loadVideoLibraryPage(0)
end sub

'-------------------------------------------------------------------------------
' isFavoriteBrowseActive
'-------------------------------------------------------------------------------
function isFavoriteBrowseActive() as boolean
    if m.pageState.selectedSort = invalid then return false

    return Format.SafeString(m.pageState.selectedSort.optionKey, "") = LibraryBrowse.Option.Favorites
end function

'-------------------------------------------------------------------------------
' buildSortSelection
'-------------------------------------------------------------------------------
function buildSortSelection(sortKey as string, sortOrder as string) as object
    normalizedSortKey = Format.SafeString(sortKey, LibraryBrowse.SortKey.Title)
    if normalizedSortKey = "Random" then
        normalizedSortKey = LibraryBrowse.SortKey.Title
    end if
    return LibraryBrowse.CreateSortSelection(normalizedSortKey, normalizedSortKey, getSortSelectionLabel(normalizedSortKey), sortOrder)
end function

'-------------------------------------------------------------------------------
' getSortSelectionLabel
'-------------------------------------------------------------------------------
function getSortSelectionLabel(sortKey as string) as string
    if sortKey = LibraryBrowse.SortKey.ReleaseDate then
        return "Release Date"
    end if
    if sortKey = LibraryBrowse.SortKey.DateAdded then
        return "Date Added"
    end if
    return "Title"
end function
