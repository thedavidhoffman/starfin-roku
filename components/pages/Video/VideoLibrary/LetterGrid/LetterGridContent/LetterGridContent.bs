import "pkg:/source/Format.bs"
import "pkg:/source/String.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.lettersGroup = m.top.findNode("lettersGroup")
    m.statusLabel = m.top.findNode("statusLabel")
    m.letterItems = []
    m.focusState = {
        focusedIndex: 0
        columnCount: 6
        itemSize: 64
        itemSpacing: 12
        letterCount: 28
    }
    renderLetters()
end sub

'-------------------------------------------------------------------------------
' onStatusTextChanged
'-------------------------------------------------------------------------------
sub onStatusTextChanged()
    m.statusLabel.text = m.top.statusText
end sub

'-------------------------------------------------------------------------------
' renderLetters
'-------------------------------------------------------------------------------
sub renderLetters()
    m.lettersGroup.removeChildrenIndex(m.lettersGroup.getChildCount(), 0)
    m.letterItems = []

    letters = getVisibleLetters()
    m.focusState.letterCount = letters.Count()

    for i = 0 to letters.Count() - 1
        letter = letters[i]
        item = m.lettersGroup.createChild("SquareButton")
        item.translation = getItemTranslation(i)
        if letter = "ALL" then item.itemWidth = (m.focusState.itemSize * 2) + m.focusState.itemSpacing
        itemContent = CreateObject("roSGNode", "ContentNode")
        itemContent.title = letter
        item.itemContent = itemContent
        item.itemHasFocus = false
        m.letterItems.Push(item)
    end for
end sub

'-------------------------------------------------------------------------------
' getVisibleLetters
'-------------------------------------------------------------------------------
function getVisibleLetters() as object
    letters = ["ALL", "#"]
    for i = 1 to 26
        letters.Push(Chr(64 + i))
    end for
    return letters
end function

'-------------------------------------------------------------------------------
' getItemTranslation
'-------------------------------------------------------------------------------
function getItemTranslation(index as integer) as object
    slot = index
    if index > 0 then slot = index + 1
    column = slot mod m.focusState.columnCount
    row = Fix(slot / m.focusState.columnCount)
    stride = m.focusState.itemSize + m.focusState.itemSpacing

    return [column * stride, row * stride]
end function

'-------------------------------------------------------------------------------
' focusLetters
'-------------------------------------------------------------------------------
sub focusLetters()
    m.lettersGroup.setFocus(true)
    focusActiveLetter()
    updateLetterFocus()
end sub

'-------------------------------------------------------------------------------
' updateLetterFocus
'-------------------------------------------------------------------------------
sub updateLetterFocus()
    for i = 0 to m.letterItems.Count() - 1
        m.letterItems[i].itemHasFocus = i = m.focusState.focusedIndex
        title = Format.SafeString(m.letterItems[i].itemContent.title, "")
        m.letterItems[i].isSelected = title = Format.SafeString(m.top.activeLetter, "ALL")
    end for
end sub

'-------------------------------------------------------------------------------
' onActiveLetterChanged
'-------------------------------------------------------------------------------
sub onActiveLetterChanged()
    focusActiveLetter()
    updateLetterFocus()
end sub

'-------------------------------------------------------------------------------
' focusActiveLetter
'-------------------------------------------------------------------------------
sub focusActiveLetter()
    activeLetter = Format.SafeString(m.top.activeLetter, "ALL")
    for i = 0 to m.letterItems.Count() - 1
        if Format.SafeString(m.letterItems[i].itemContent.title, "") = activeLetter then
            m.focusState.focusedIndex = i
            return
        end if
    end for
    m.focusState.focusedIndex = 0
end sub

'-------------------------------------------------------------------------------
' moveFocus
'-------------------------------------------------------------------------------
function moveFocus(offset as integer) as boolean
    nextIndex = -1
    if Abs(offset) = m.focusState.columnCount then
        nextIndex = findVerticalIndex(m.focusState.focusedIndex, offset > 0)
    else
        nextIndex = m.focusState.focusedIndex + offset
        if nextIndex < 0 or nextIndex >= m.focusState.letterCount then nextIndex = -1
    end if
    if nextIndex < 0 then return true

    if nextIndex = m.focusState.focusedIndex then return true

    m.focusState.focusedIndex = nextIndex
    updateLetterFocus()
    return true
end function

'-------------------------------------------------------------------------------
' findVerticalIndex
'-------------------------------------------------------------------------------
function findVerticalIndex(startIndex as integer, moveDown as boolean) as integer
    startSlot = getLogicalSlot(startIndex)
    targetSlot = startSlot + (moveDown ? m.focusState.columnCount : 0 - m.focusState.columnCount)
    if moveDown = false and targetSlot = 1 then return 0
    for i = 0 to m.letterItems.Count() - 1
        if getLogicalSlot(i) = targetSlot then return i
    end for
    return -1
end function

'-------------------------------------------------------------------------------
' getLogicalSlot
'-------------------------------------------------------------------------------
function getLogicalSlot(index as integer) as integer
    if index <= 0 then return 0
    return index + 1
end function

'-------------------------------------------------------------------------------
' selectFocusedLetter
'-------------------------------------------------------------------------------
function selectFocusedLetter() as boolean
    if m.focusState.focusedIndex < 0 or m.focusState.focusedIndex >= m.letterItems.Count() then return false

    item = m.letterItems[m.focusState.focusedIndex]
    if item = invalid or item.itemContent = invalid then return false

    letter = Format.SafeString(item.itemContent.title, "")
    if letter = "" then return false

    m.top.selectedLetter = letter
    m.top.letterSelected = letter
    return true
end function

'-------------------------------------------------------------------------------
' onKeyEvent
'-------------------------------------------------------------------------------
function onKeyEvent(key as string, press as boolean) as boolean
    if press = false then return false
    normalizedKey = LCase(Format.SafeString(key, ""))

    if normalizedKey = "right" then return moveFocus(1)
    if normalizedKey = "left" then return moveFocus(-1)
    if normalizedKey = "down" then return moveFocus(m.focusState.columnCount)
    if normalizedKey = "up" then return moveFocus(0 - m.focusState.columnCount)
    if normalizedKey = "ok" or normalizedKey = "select" then return selectFocusedLetter()

    return false
end function
