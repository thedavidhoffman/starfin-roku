<?xml version="1.0" encoding="utf-8"?>
<component name="LetterGridItem" extends="Group">
  <script type="text/brightscript" uri="pkg:/source/Format.bs" />
  <script type="text/brightscript" uri="pkg:/source/String.bs" />
  <script type="text/brightscript" uri="pkg:/source/Number.bs" />
  <script type="text/brightscript" uri="pkg:/source/ResolutionAssets.bs" />
  <script type="text/brightscript" uri="pkg:/source/ResolutionProfile.bs" />
  <script type="text/brightscript" uri="pkg:/components/pages/Video/VideoLibrary/LetterGrid/LetterGridItem/LetterGridItem.bs" />
  <interface>
    <field id="itemContent" type="node" onChange="onItemContentChanged" />
    <field id="itemHasFocus" type="boolean" onChange="onItemHasFocusChanged" />
    <field id="isAvailable" type="boolean" value="true" onChange="onAvailabilityChanged" />
    <field id="isSelected" type="boolean" value="false" onChange="onSelectionChanged" />
    <field id="itemWidth" type="integer" value="64" onChange="onItemWidthChanged" />
  </interface>
  <children>
    <Poster id="background" width="64" height="64" uri="pkg:/images/library/letter-tile-background.png" loadDisplayMode="scaleToFit" />
    <Poster id="selectedBackground" width="64" height="64" uri="pkg:/images/library/letter-tile-highlight.png" loadDisplayMode="scaleToFit" opacity="0.55" visible="false" />
    <Poster id="focusBackground" width="64" height="64" uri="pkg:/images/library/letter-tile-highlight.png" loadDisplayMode="scaleToFit" visible="false" />
    <Label id="letterLabel" translation="[1,15]" width="63" height="38" horizAlign="center" color="0xF3F7FBFF" font="font:MediumBoldSystemFont" />
  </children>
</component>
