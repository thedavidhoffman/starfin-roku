<?xml version="1.0" encoding="utf-8"?>
<component name="LetterGridItem" extends="Group">
  <script type="text/brightscript" uri="pkg:/source/Format.brs" />
  <script type="text/brightscript" uri="pkg:/source/String.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/Video/VideoLibrary/LetterGrid/LetterGridItem/LetterGridItem.brs" />
  <interface>
    <field id="itemContent" type="node" onChange="onItemContentChanged" />
    <field id="itemHasFocus" type="boolean" onChange="onItemHasFocusChanged" />
    <field id="isAvailable" type="boolean" value="true" onChange="onAvailabilityChanged" />
  </interface>
  <children>
    <Poster id="background" width="64" height="64" uri="pkg:/images/library/letter-tile-background.png" loadDisplayMode="scaleToFit" />
    <Poster id="focusBackground" width="64" height="64" uri="pkg:/images/library/letter-tile-highlight.png" loadDisplayMode="scaleToFit" visible="false" />
    <Label id="letterLabel" translation="[1,15]" width="63" height="38" horizAlign="center" color="0xF3F7FBFF" font="font:MediumBoldSystemFont" />
  </children>
</component>
