import "pkg:/source/Number.bs"
import "pkg:/source/LibraryGridLayout.bs"

' Displays a vertical scroll-position bar beside large poster libraries. It is
' hidden for thumbnail layouts and short libraries, and its fill tracks the
' currently focused poster row, including simulated progress during key holds.

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.track = m.top.findNode("track")
    m.fill = m.top.findNode("fill")
    m.layout = {
        width: 10
        height: 836
        screenWidth: 1920
        screenHeight: 1080
        xOffset: -10
        bottomMargin: 12
    }

    onProgressStateChanged()
end sub

'-------------------------------------------------------------------------------
' onProgressStateChanged
'-------------------------------------------------------------------------------
sub onProgressStateChanged()
    updateLayout()
    updateProgress()
end sub

'-------------------------------------------------------------------------------
' updateLayout
'-------------------------------------------------------------------------------
sub updateLayout()
    m.top.visible = false

    if LCase(m.top.layoutMode) <> "poster" then return

    gridTop = Number.ToInteger(m.top.gridTop, 0)
    grid = {
        translation: [Number.ToInteger(m.top.gridLeft, 0), gridTop]
        itemSize: [Number.ToInteger(m.top.itemWidth, 0), 0]
        itemSpacing: [Number.ToInteger(m.top.itemSpacingX, 0), 0]
        numColumns: getPositiveInteger(m.top.numColumns, 1)
    }
    gridRight = LibraryGridLayout.GetGridRightEdge(grid)
    x = gridRight + Fix((m.layout.screenWidth - gridRight - m.layout.width) / 2) + m.layout.xOffset
    if x < gridRight then x = gridRight

    height = m.layout.screenHeight - gridTop - m.layout.bottomMargin
    if height < 0 then height = 0

    m.layout.height = height
    m.top.translation = [x, gridTop]
    m.top.rightEdge = x + m.layout.width
    m.track.width = m.layout.width
    m.track.height = height
    m.fill.width = m.layout.width
end sub

'-------------------------------------------------------------------------------
' updateProgress
'-------------------------------------------------------------------------------
sub updateProgress()
    m.fill.height = 0

    if LCase(m.top.layoutMode) <> "poster" then
        m.top.visible = false
        return
    end if

    loadedItemCount = Number.ToInteger(m.top.itemCount, 0)
    totalItemCount = Number.ToInteger(m.top.totalItemCount, -1)
    if totalItemCount < loadedItemCount then totalItemCount = loadedItemCount
    columns = getPositiveInteger(m.top.numColumns, 1)
    visibleRows = getPositiveInteger(m.top.numRows, 1)

    totalRows = Fix((totalItemCount + columns - 1) / columns)
    maxFocusedRow = totalRows - 1
    m.top.visible = totalRows > visibleRows and loadedItemCount > 0
    if m.top.visible <> true then return

    focusedIndex = Number.ToInteger(m.top.focusedIndex, 0)
    if focusedIndex < 0 then focusedIndex = 0
    if focusedIndex >= loadedItemCount then focusedIndex = loadedItemCount - 1

    focusedRow = Fix(focusedIndex / columns)
    fillHeight = 0
    if maxFocusedRow > 0 then fillHeight = Fix((focusedRow / maxFocusedRow) * m.layout.height)

    if focusedRow = maxFocusedRow then fillHeight = m.layout.height
    if fillHeight < 0 then fillHeight = 0
    if fillHeight > m.layout.height then fillHeight = m.layout.height

    m.fill.height = fillHeight
end sub

'-------------------------------------------------------------------------------
' getPositiveInteger
'-------------------------------------------------------------------------------
function getPositiveInteger(value as dynamic, fallback as integer) as integer
    result = Number.ToInteger(value, fallback)
    if result <= 0 then return fallback

    return result
end function
