import "pkg:/source/Format.bs"
import "pkg:/source/String.bs"
import "pkg:/source/Encode.bs"
import "pkg:/source/Url.bs"
import "pkg:/source/Json.bs"
import "pkg:/source/Logger.bs"
import "pkg:/source/MediaMetadata.bs"
import "pkg:/source/Number.bs"
import "pkg:/source/PlaybackProgress.bs"
import "pkg:/source/MediaState.bs"
import "pkg:/source/Status.bs"
import "pkg:/source/Spinner.bs"
import "pkg:/source/AsyncLifecycle.bs"
import "pkg:/source/PlaybackMode.bs"
import "pkg:/source/store/RegistryStore.bs"
import "pkg:/source/store/SettingsStore.bs"
import "pkg:/source/store/LibraryViewStateStore.bs"
import "pkg:/source/Array.bs"
import "pkg:/source/VideoLibrarySort.bs"
import "pkg:/source/VideoLibraryFilter.bs"
import "pkg:/components/pages/Video/VideoLibrary/Helpers/Loading.bs"
import "pkg:/components/pages/Video/VideoLibrary/Helpers/Browse.bs"
import "pkg:/components/pages/Video/VideoLibrary/Helpers/Items.bs"
import "pkg:/components/pages/Video/VideoLibrary/Helpers/Navigation.bs"
import "pkg:/components/pages/Video/VideoLibrary/Helpers/Layout.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    initReferences()
    if hasLibrarySpecialization() then
        m.browseByButton.visible = false
        m.sortButton.visible = false
    end if
    initHandlers()
    m.specializationInitialized = false
    m.pageState = {
        request: invalid
        allItems: []
        items: []
        imageAspect: "poster"
        letterGridOpen: false
        letterGridPanel: {
            x: 72
            y: 208
        }
        isThumbnailLayout: false
        availableLetters: {}
        selectedSortKey: "SortName"
        selectedSort: invalid
        activeFilterType: ""
        selectedDecade: -1
        selectedGenre: ""
        selectedStartsWith: "ALL"
        renderDecadeFilterOnApply: false
        filterCache: createEmptyFilterCache()
        itemNodeCache: {}
        itemNodeCacheAspect: ""
        progressFocusedIndex: 0
        progressHoldKey: ""
        pendingFocusTarget: ""
        refocusBrowseByButtonAfterLoad: false
        refocusSortButtonAfterLoad: false
        isLoading: false
        paging: {
            nextStartIndex: 0
            totalCount: -1
            hasMore: false
            requestInFlight: false
            queryId: 0
        }
        filtersQueryId: 0
        lifecycle: AsyncLifecycle.Create()
    }
    m.browseByButton.selectedSort = getDefaultSortSelection()
    m.sortButton.selectedSort = getDefaultSortSelection()
    m.sortButton.sortEnabled = canUseSortOrder(getDefaultSortSelection())
    m.pageState.selectedSort = getDefaultSortSelection()
end sub

'-------------------------------------------------------------------------------
' initReferences
'-------------------------------------------------------------------------------
sub initReferences()
    m.log = Logger("VideoLibrary", m.global.logService)
    m.titleLabel = m.top.findNode("titleLabel")
    m.browseByButton = m.top.findNode("browseByButton")
    m.sortButton = m.top.findNode("sortButton")
    m.letterGutterButton = m.top.findNode("letterGutterButton")
    m.filterButtonRow = m.top.findNode("filterButtonRow")
    m.emptyFavoritesLabel = m.top.findNode("emptyFavoritesLabel")
    m.itemsGrid = m.top.findNode("itemsGrid")
    m.videoLibraryTask = m.top.findNode("videoLibraryTask")
    m.videoFilterOptionsTask = m.top.findNode("videoFilterOptionsTask")
    m.videoLibraryProgressIndicator = m.top.findNode("videoLibraryProgressIndicator")
    m.videoLibraryProgressHoldTimer = m.top.findNode("videoLibraryProgressHoldTimer")
end sub

'-------------------------------------------------------------------------------
' initHandlers
'-------------------------------------------------------------------------------
sub initHandlers()
    m.videoLibraryTask.observeField("response", "onVideoLibraryResponse")
    m.videoFilterOptionsTask.observeField("response", "onVideoFilterOptionsResponse")
    m.videoLibraryProgressHoldTimer.observeField("fire", "onVideoLibraryProgressHoldTimerFire")
    m.browseByButton.observeField("overlayRequested", "onSortOverlayRequested")
    m.browseByButton.observeField("focusExitDown", "onBrowseByButtonFocusExitDown")
    m.sortButton.observeField("sortOrderChanged", "onSortOrderChanged")
    m.sortButton.observeField("focusExitDown", "onSortButtonFocusExitDown")
    m.letterGutterButton.observeField("focused", "onLetterGutterButtonFocused")
    m.letterGutterButton.observeField("buttonSelected", "onLetterGutterButtonSelected")
    m.filterButtonRow.observeField("focusExitUp", "onFilterButtonRowFocusExitUp")
    m.filterButtonRow.observeField("focusExitDown", "onFilterButtonRowFocusExitDown")
    m.filterButtonRow.observeField("filterSelected", "onFilterButtonRowSelected")
    m.itemsGrid.observeField("itemSelected", "onItemSelected")
    m.itemsGrid.observeField("itemFocused", "onItemFocused")
    m.itemsGrid.observeField("navigationKeyPressed", "onItemsGridNavigationKeyPressed")
end sub

'-------------------------------------------------------------------------------
' onSettingsChanged
'-------------------------------------------------------------------------------
sub onSettingsChanged()
    ensureLibrarySpecializationInitialized()
    imageAspect = getVideoLibraryImageAspect()
    if imageAspect <> m.pageState.imageAspect then
        m.pageState.imageAspect = imageAspect
        rebuildVideoLibraryItemNodeCache()
    end if
    applyGridLayout(m.pageState.imageAspect)
    renderItems(getVisibleVideoLibraryItems())
end sub

'-------------------------------------------------------------------------------
' onLoadRequestChanged
'-------------------------------------------------------------------------------
sub onLoadRequestChanged()
    request = m.top.loadRequest
    if request = invalid then
        return
    end if
    ensureLibrarySpecializationInitialized()
    m.pageState.selectedStartsWith = "ALL"
    prepareLoadRequest(request)
    resetVideoLibraryForLoad()
    loadVideoFilterOptions()
    loadVideoLibraryPage(0)
end sub

'-------------------------------------------------------------------------------
' resetVideoLibraryForLoad
'-------------------------------------------------------------------------------
sub resetVideoLibraryForLoad()
    m.pageState.isLoading = true
    resetFilterState()
    resetVideoLibraryItemsState()
    resetLoadFocusState()
    syncSortControls()
    if hasLibrarySpecialization() then
        m.top.callFunc("specializationReset")
    end if
    updateTitleLabel()
    hideFilterButtonRow()
    Spinner.Show(0)
    closeLetterGrid(false)
    renderItems([])
end sub

'-------------------------------------------------------------------------------
' resetFilterState
'-------------------------------------------------------------------------------
sub resetFilterState()
    optionKey = Format.SafeString(m.pageState.selectedSort.optionKey, "")
    if optionKey = "Decade" or optionKey = "Genre" then
        m.pageState.activeFilterType = optionKey
        if optionKey = "Decade" then
            m.pageState.selectedGenre = ""
        end if
        if optionKey = "Genre" then
            m.pageState.selectedDecade = -1
        end if
        m.pageState.renderDecadeFilterOnApply = false
        m.pageState.filterCache = createEmptyFilterCache()
        return
    end if
    m.pageState.activeFilterType = ""
    m.pageState.selectedDecade = -1
    m.pageState.selectedGenre = ""
    m.pageState.renderDecadeFilterOnApply = false
    m.pageState.filterCache = createEmptyFilterCache()
end sub

'-------------------------------------------------------------------------------
' resetVideoLibraryItemsState
'-------------------------------------------------------------------------------
sub resetVideoLibraryItemsState()
    m.pageState.allItems = []
    m.pageState.items = []
    clearVideoLibraryItemNodeCache()
    m.pageState.paging.nextStartIndex = 0
    m.pageState.paging.totalCount = -1
    m.pageState.paging.hasMore = false
    m.pageState.paging.requestInFlight = false
    m.pageState.paging.queryId = m.pageState.paging.queryId + 1
end sub

'-------------------------------------------------------------------------------
' resetLoadFocusState
'-------------------------------------------------------------------------------
sub resetLoadFocusState()
    m.pageState.pendingFocusTarget = ""
    m.pageState.refocusBrowseByButtonAfterLoad = false
    m.pageState.refocusSortButtonAfterLoad = false
    if isDecadeFilterActive() then m.pageState.pendingFocusTarget = "filterButtonRow"
end sub

'-------------------------------------------------------------------------------
' syncSortControls
'-------------------------------------------------------------------------------
sub syncSortControls()
    sortControlsVisible = true
    if hasLibrarySpecialization() then
        sortControlsVisible = m.top.callFunc("specializationShowsSortControls")
    end if
    m.browseByButton.visible = sortControlsVisible
    m.sortButton.visible = sortControlsVisible
    m.browseByButton.selectedSort = m.pageState.selectedSort
    m.sortButton.selectedSort = m.pageState.selectedSort
    m.sortButton.sortEnabled = canUseSortOrder(m.pageState.selectedSort)
end sub

'-------------------------------------------------------------------------------
' hasLibrarySpecialization
'-------------------------------------------------------------------------------
function hasLibrarySpecialization() as boolean
    return m.top.isSubtype("Playlists")
end function

'-------------------------------------------------------------------------------
' ensureLibrarySpecializationInitialized
'-------------------------------------------------------------------------------
sub ensureLibrarySpecializationInitialized()
    if hasLibrarySpecialization() <> true then
        return
    end if
    if m.specializationInitialized then
        return
    end if
    m.top.callFunc("specializationInitialize")
    m.specializationInitialized = true
end sub
