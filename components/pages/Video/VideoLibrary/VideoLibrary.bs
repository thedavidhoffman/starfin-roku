'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    initReferences()
    m.playlistSpecializationInitialized = false
    m.chromeLayout = {
        randomWidth: 165
        browseWidth: 190
        sortWidth: 48
        buttonGap: 8
        y: 120
        deferProgressSync: false
    }
    m.pageState = {
        request: invalid
        allItems: []
        items: []
        imageAspect: VideoCardPresentation.Type.Poster
        layoutColumns: 6
        letterGridOpen: false
        letterGridPanel: {
            x: 72
            y: 208
        }
        isThumbnailLayout: false
        selectedSortKey: LibraryBrowse.Option.Title
        selectedSort: invalid
        activeFilterType: ""
        filterSelection: {
            decade: -1
            genre: ""
        }
        letterFilter: {
            selected: "ALL"
            pending: ""
            previousPaging: invalid
        }
        filterOptions: LibraryBrowse.NormalizeFilterOptions(invalid)
        filterRefresh: LibraryBrowseRefresh.Create()
        committedFilterView: invalid
        itemNodeCache: {}
        itemNodeCacheLayout: ""
        progressFocusedIndex: 0
        progressHoldKey: ""
        isLoading: false
        paging: {
            nextStartIndex: 0
            totalCount: -1
            hasMore: false
            requestInFlight: false
            queryId: 0
        }
        movieLibraryBrowse: {
            active: false
            index: -1
        }
        randomPlayback: {
            loading: false
            restoreFocus: false
        }
        filtersQueryId: 0
        lifecycle: AsyncLifecycle.Create()
    }
    initHandlers()
    commitVideoLibraryBrowseState(LibraryBrowse.CreateSortSelection(LibraryBrowse.Option.Title, LibraryBrowse.SortKey.Title, "Title"))
end sub

'-------------------------------------------------------------------------------
' initReferences
'-------------------------------------------------------------------------------
sub initReferences()
    m.log = new Logger("VideoLibrary", m.global.logService)
    m.titleLabel = m.top.findNode("titleLabel")
    m.musicVideoRandomButton = m.top.findNode("musicVideoRandomButton")
    m.browseByButton = m.top.findNode("browseByButton")
    m.sortButton = m.top.findNode("sortButton")
    m.letterGutterButton = m.top.findNode("letterGutterButton")
    m.filterButtonRow = m.top.findNode("filterButtonRow")
    m.emptyFavoritesLabel = m.top.findNode("emptyFavoritesLabel")
    m.itemsGrid = m.top.findNode("itemsGrid")
    m.videoLibraryTask = m.top.findNode("videoLibraryTask")
    m.musicVideoRandomPlaybackTask = m.top.findNode("musicVideoRandomPlaybackTask")
    m.videoFilterOptionsTask = m.top.findNode("videoFilterOptionsTask")
    m.videoLibraryProgressIndicator = m.top.findNode("videoLibraryProgressIndicator")
    m.videoLibraryProgressHoldTimer = m.top.findNode("videoLibraryProgressHoldTimer")
    m.filterRefreshTimer = m.top.findNode("filterRefreshTimer")
end sub

'-------------------------------------------------------------------------------
' initHandlers
'-------------------------------------------------------------------------------
sub initHandlers()
    m.videoLibraryTask.observeField("response", "onVideoLibraryResponse")
    m.musicVideoRandomPlaybackTask.observeField("response", "onMusicVideoRandomPlaybackResponse")
    m.videoFilterOptionsTask.observeField("response", "onVideoFilterOptionsResponse")
    m.videoLibraryProgressHoldTimer.observeField("fire", "onVideoLibraryProgressHoldTimerFire")
    m.filterRefreshTimer.observeField("fire", "onVideoFilterRefreshTimerFired")
    m.videoLibraryProgressIndicator.observeField("visible", "onVideoLibraryProgressChromeChanged")
    m.videoLibraryProgressIndicator.observeField("rightEdge", "onVideoLibraryProgressChromeChanged")
    m.browseByButton.observeField("overlayRequested", "onSortOverlayRequested")
    m.browseByButton.observeField("focusExitDown", "onBrowseByButtonFocusExitDown")
    m.sortButton.observeField("sortOrderChanged", "onSortOrderChanged")
    m.sortButton.observeField("focusExitDown", "onSortButtonFocusExitDown")
    m.musicVideoRandomButton.observeField("buttonSelected", "onMusicVideoRandomSelected")
    m.letterGutterButton.observeField("focused", "onLetterGutterButtonFocused")
    m.letterGutterButton.observeField("buttonSelected", "onLetterGutterButtonSelected")
    m.filterButtonRow.observeField("focusExitUp", "onFilterButtonRowFocusExitUp")
    m.filterButtonRow.observeField("focusExitDown", "onFilterButtonRowFocusExitDown")
    m.filterButtonRow.observeField("filterSelected", "onFilterButtonRowSelected")
    m.itemsGrid.observeField("itemSelected", "onItemSelected")
    m.itemsGrid.observeField("itemFocused", "onItemFocused")
    m.itemsGrid.observeField("navigationKeyPressed", "onItemsGridNavigationKeyPressed")
end sub

'-------------------------------------------------------------------------------
' onSettingsChanged
'-------------------------------------------------------------------------------
sub onSettingsChanged()
    ensurePlaylistSpecializationInitialized()
    previousImageAspect = m.pageState.imageAspect
    previousLayoutColumns = m.pageState.layoutColumns
    imageAspect = getVideoLibraryImageAspect()
    if imageAspect <> m.pageState.imageAspect or m.pageState.layoutColumns <> previousLayoutColumns then
        m.pageState.imageAspect = imageAspect
        rebuildVideoLibraryItemNodeCache()
    end if
    applyGridLayout(m.pageState.imageAspect)
    renderItems(getVisibleVideoLibraryItems())
    if imageAspect = VideoCardPresentation.Type.Detailed and previousImageAspect <> VideoCardPresentation.Type.Detailed and m.pageState.request <> invalid then
        reloadVideoLibraryForSort("items")
    end if
end sub

'-------------------------------------------------------------------------------
' onLoadRequestChanged
'-------------------------------------------------------------------------------
sub onLoadRequestChanged()
    request = m.top.loadRequest
    if request = invalid then
        return
    end if
    m.filterRefreshTimer.control = TimerControl.Command.Stop
    LibraryBrowseRefresh.Cancel(m.pageState.filterRefresh)
    m.pageState.committedFilterView = invalid
    ensurePlaylistSpecializationInitialized()
    m.pageState.letterFilter.selected = "ALL"
    m.pageState.letterFilter.pending = ""
    m.pageState.letterFilter.previousPaging = invalid
    prepareLoadRequest(request)
    resetVideoLibraryForLoad()
    loadVideoFilterOptions()
    loadVideoLibraryPage(0)
end sub

'-------------------------------------------------------------------------------
' resetVideoLibraryForLoad
'-------------------------------------------------------------------------------
sub resetVideoLibraryForLoad()
    m.pageState.isLoading = true
    m.chromeLayout.deferProgressSync = true
    resetFilterOptions()
    resetVideoLibraryItemsState()
    beginBrowseTransition(m.pageState.activeFilterType, false)
    syncSortControls()
    if isPlaylistsView() then
        m.top.callFunc("specializationReset")
    end if
    updateTitleLabel()
    hideFilterButtonRow()
    Spinner.Show(0)
    closeLetterGrid(false)
    renderItems([])
end sub

'-------------------------------------------------------------------------------
' resetFilterOptions
'-------------------------------------------------------------------------------
sub resetFilterOptions()
    m.pageState.filterOptions = LibraryBrowse.NormalizeFilterOptions(invalid)
end sub

'-------------------------------------------------------------------------------
' clearFilterSelections
'-------------------------------------------------------------------------------
sub clearFilterSelections()
    m.pageState.activeFilterType = ""
    m.pageState.filterSelection.decade = -1
    m.pageState.filterSelection.genre = ""
end sub

'-------------------------------------------------------------------------------
' commitVideoLibraryBrowseState
'-------------------------------------------------------------------------------
sub commitVideoLibraryBrowseState(selection as object)
    if selection = invalid then return

    optionKey = Format.SafeString(selection.optionKey, "")
    if optionKey = "" then return

    m.pageState.selectedSortKey = optionKey
    m.pageState.selectedSort = selection
    if m.pageState.request <> invalid then
        m.pageState.request.sortBy = Format.SafeString(selection.sortKey, LibraryBrowse.SortKey.Title)
        m.pageState.request.sortOrder = LibraryBrowse.NormalizeSortOrder(selection.sortOrder)
    end if
    if optionKey = LibraryBrowse.Option.Decade or optionKey = LibraryBrowse.Option.Genre then
        m.pageState.activeFilterType = optionKey
    else
        clearFilterSelections()
    end if
    if m.pageState.request <> invalid then m.pageState.request.favoriteOnly = optionKey = LibraryBrowse.Option.Favorites
    syncSortControls()
end sub

'-------------------------------------------------------------------------------
' resetVideoLibraryItemsState
'-------------------------------------------------------------------------------
sub resetVideoLibraryItemsState()
    cancelMusicVideoRandomPlayback()
    m.pageState.allItems = []
    m.pageState.items = []
    clearVideoLibraryItemNodeCache()
    m.pageState.paging.nextStartIndex = 0
    m.pageState.paging.totalCount = -1
    m.pageState.paging.hasMore = false
    m.pageState.paging.requestInFlight = false
    m.pageState.paging.queryId = m.pageState.paging.queryId + 1
    syncMusicVideoRandomButton()
end sub


'-------------------------------------------------------------------------------
' syncSortControls
'-------------------------------------------------------------------------------
sub syncSortControls()
    capabilities = getVideoLibraryBrowseCapabilities()
    applyBrowseCapabilities(capabilities)
    m.letterGutterButton.visible = capabilities.letter = true and supportsLetterNavigation(m.pageState.selectedSort)
    m.browseByButton.selectedSort = m.pageState.selectedSort
    m.sortButton.selectedSort = m.pageState.selectedSort
    m.sortButton.sortEnabled = true
end sub

'-------------------------------------------------------------------------------
' supportsLetterNavigation
'-------------------------------------------------------------------------------
function supportsLetterNavigation(selection as dynamic) as boolean
    if selection = invalid then return true

    sortKey = Format.SafeString(selection.sortKey, LibraryBrowse.SortKey.Title)
    return sortKey <> LibraryBrowse.SortKey.ReleaseDate and sortKey <> LibraryBrowse.SortKey.DateAdded
end function

'-------------------------------------------------------------------------------
' applyBrowseCapabilities
'-------------------------------------------------------------------------------
sub applyBrowseCapabilities(capabilities as object)
    m.browseByButton.visible = capabilities.browse
    m.sortButton.visible = capabilities.sort
end sub

'-------------------------------------------------------------------------------
' getVideoLibraryBrowseCapabilities
'-------------------------------------------------------------------------------
function getVideoLibraryBrowseCapabilities() as object
    if isPlaylistsView() then
        return m.top.callFunc("specializationBrowseCapabilities")
    end if
    if isCollectionContentRequest(m.pageState.request) then
        return { browse: true, sort: true, letter: false, filters: false }
    end if
    return { browse: true, sort: true, letter: true, filters: true }
end function

'-------------------------------------------------------------------------------
' isCollectionContentRequest
'-------------------------------------------------------------------------------
function isCollectionContentRequest(request as dynamic) as boolean
    return request <> invalid and LCase(Format.SafeString(request.collectionType, "")) = "collection"
end function

'-------------------------------------------------------------------------------
' isMusicVideoLibraryRequest
'-------------------------------------------------------------------------------
function isMusicVideoLibraryRequest() as boolean
    request = m.pageState.request
    return request <> invalid and LCase(Format.SafeString(request.collectionType, "")) = "musicvideos"
end function

'-------------------------------------------------------------------------------
' isPlaylistsView
'-------------------------------------------------------------------------------
function isPlaylistsView() as boolean
    return m.top.isSubtype("Playlists")
end function

'-------------------------------------------------------------------------------
' ensurePlaylistSpecializationInitialized
'-------------------------------------------------------------------------------
sub ensurePlaylistSpecializationInitialized()
    if isPlaylistsView() <> true then
        return
    end if
    if m.playlistSpecializationInitialized then
        return
    end if
    m.top.callFunc("specializationInitialize")
    m.playlistSpecializationInitialized = true
end sub
