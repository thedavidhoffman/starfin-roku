'-------------------------------------------------------------------------------
' onKeyEvent
'-------------------------------------------------------------------------------
function onKeyEvent(key as string, press as boolean) as boolean
    if press = false then return false

    if key = "up" and m.top.supportsFocusExitUp = true then
        m.top.focusExitUp = true
        return true
    end if

    if key = "down" then
        m.top.focusExitDown = true
        return true
    end if

    if key = "left" then
        focusButton(m.focusState.focusedIndex - 1)
        return true
    end if

    if key = "right" then
        focusButton(m.focusState.focusedIndex + 1)
        return true
    end if

    return false
end function
