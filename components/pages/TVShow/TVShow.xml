<?xml version="1.0" encoding="utf-8"?>
<component name="TVShow" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/source/Format.brs" />
  <script type="text/brightscript" uri="pkg:/source/String.brs" />
  <script type="text/brightscript" uri="pkg:/source/Logger.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/TVShow/TVShow.brs" />
  <interface>
    <field id="loadRequest" type="assocarray" onChange="onLoadRequestChanged" />
    <field id="closeRequested" type="boolean" alwaysNotify="true" />
    <field id="selectedSeason" type="assocarray" alwaysNotify="true" />
    <function name="activate" />
  </interface>
  <children>
    <Poster id="backdrop" width="1920" height="1080" opacity="0.34" loadDisplayMode="scaleToZoom" />
    <Rectangle width="1920" height="1080" color="0x00000033" />

    <Group id="contentGroup" translation="[96,124]">
      <Poster id="poster" width="300" height="450" loadDisplayMode="scaleToZoom" />

      <Group id="infoGroup" translation="[360,0]">
        <Label id="titleLabel" width="1260" height="78" color="0xF3F7FBFF" font="font:LargeBoldSystemFont" />
        <Label id="metaLabel" translation="[0,92]" width="1260" height="36" color="0xB9C7D6FF" font="font:MediumSystemFont" />
        <Label id="overviewLabel" translation="[0,154]" width="1120" height="210" color="0xF3F7FBFF" font="font:MediumSystemFont" wrap="true" numLines="5" />
      </Group>

      <Label id="seasonsLabel" translation="[0,510]" width="600" height="44" color="0xF3F7FBFF" font="font:MediumBoldSystemFont" text="Seasons" />
      <MarkupGrid
        id="seasonsGrid"
        translation="[0,570]"
        itemComponentName="TVSeasonGridItem"
        itemSize="[180,345]"
        itemSpacing="[34,34]"
        numColumns="8"
        numRows="1"
        drawFocusFeedback="true" />

      <Label id="statusLabel" translation="[0,560]" width="1000" height="44" color="0xF3F7FBFF" text="Loading series..." />
    </Group>

    <TVShowTask id="tvShowTask" />
  </children>
</component>
