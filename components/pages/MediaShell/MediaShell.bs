import "pkg:/source/MediaMetadata.bs"
import "pkg:/source/Number.bs"
import "pkg:/source/String.bs"
import "pkg:/source/MaskAssets.bs"
import "pkg:/source/ResolutionProfile.bs"
import "pkg:/source/ResolutionAssets.bs"
import "pkg:/source/MediaShellLayout.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    initReferences()
    m.logoState = {
        url: ""
        title: ""
        mediaType: ""
        fittedMediaType: ""
    }
    initHandlers()
    onContentTranslationChanged()
    applyBackgroundDisplay()
    onDetailsVisibleChanged()
end sub

'-------------------------------------------------------------------------------
' initReferences
'-------------------------------------------------------------------------------
sub initReferences()
    m.background = {
        full: m.top.findNode("mediaBackgroundFull")
        cornerGroup: m.top.findNode("mediaBackgroundPartialGroup")
        corner: m.top.findNode("mediaBackgroundPartial")
        shade: m.top.findNode("backgroundShade")
        gradient: m.top.findNode("contentGradient")
        url: ""
    }
    MaskAssets.Apply(m.background.cornerGroup, "media-shell-backdrop-mask.png", [1152, 648], [768, 432])
    m.contentGroup = m.top.findNode("contentGroup")
    m.titleLogo = m.top.findNode("titleLogo")
    m.logoFallbackTitleLabel = m.top.findNode("logoFallbackTitleLabel")
    m.episodeTitleLabel = m.top.findNode("episodeTitleLabel")
    m.infoGroup = m.top.findNode("infoGroup")
    m.overviewDescription = m.top.findNode("overviewDescription")

    m.moviePoster = {
        group: m.top.findNode("moviePosterGroup")
        image: m.top.findNode("moviePoster")
        url: ""
    }
    MaskAssets.Apply(m.moviePoster.group, "movie-poster-mask.png", [600, 900], [400, 600])

    m.metadata = {
        primaryRow: m.top.findNode("primaryInfoRow")
        secondaryRow: m.top.findNode("secondaryInfoRow")
    }
end sub

'-------------------------------------------------------------------------------
' initHandlers
'-------------------------------------------------------------------------------
sub initHandlers()
    m.overviewDescription.observeField("overlayRequested", "onDescriptionOverlayRequested")
    m.titleLogo.observeField("loadStatus", "onTitleLogoLoadStatusChanged")
    m.moviePoster.image.observeField("loadStatus", "onMoviePosterLoadStatusChanged")
end sub

'-------------------------------------------------------------------------------
' onContentTranslationChanged
'-------------------------------------------------------------------------------
sub onContentTranslationChanged()
    m.contentGroup.translation = m.top.contentTranslation
end sub

'-------------------------------------------------------------------------------
' onBackgroundDisplayChanged
'-------------------------------------------------------------------------------
sub onBackgroundDisplayChanged()
    content = m.top.mediaContent
    if content <> invalid then renderBackdrop(Strings.ToString(content.backdropUrl))
    applyBackgroundDisplay()
    renderMoviePoster(content)
    applyContentLayout(m.logoState.mediaType)
    if content <> invalid then renderMetadata(content, m.logoState.mediaType)
    applyContentGradientVisibility(m.logoState.mediaType)
    updateLogoFallbackTitlePosition(m.episodeTitleLabel.visible)
    onTitleLogoLoadStatusChanged()
end sub

'-------------------------------------------------------------------------------
' onDetailsVisibleChanged
'-------------------------------------------------------------------------------
sub onDetailsVisibleChanged()
    m.infoGroup.visible = m.top.detailsVisible
end sub

'-------------------------------------------------------------------------------
' onCastVisibleChanged
'-------------------------------------------------------------------------------
sub onCastVisibleChanged()
    applyContentGradientVisibility(m.logoState.mediaType)
end sub

'-------------------------------------------------------------------------------
' applyBackgroundDisplay
'-------------------------------------------------------------------------------
sub applyBackgroundDisplay()
    layout = getContentLayout(m.logoState.mediaType)
    hasBackdrop = m.background.url <> "" and layout.isArtworkFreePoster <> true

    m.background.full.visible = hasBackdrop and layout.isPartial <> true
    m.background.cornerGroup.visible = hasBackdrop and layout.isPartial
end sub

'-------------------------------------------------------------------------------
' onMediaContentChanged
'-------------------------------------------------------------------------------
sub onMediaContentChanged()
    content = m.top.mediaContent
    if content = invalid then return

    mediaType = Strings.ToString(content.mediaType)
    m.logoState.mediaType = mediaType
    logoPending = content.logoPending = true
    applyContentLayout(mediaType)
    applyContentGradientVisibility(mediaType)
    renderBackdrop(Strings.ToString(content.backdropUrl))
    renderMoviePoster(content)
    renderTitle(Strings.ToString(content.title), Strings.ToString(content.logoUrl), Strings.ToString(content.logoTitle), mediaType, logoPending)
    renderMetadata(content, mediaType)
    m.overviewDescription.title = Strings.ToString(content.title, "Description")
    m.overviewDescription.text = Strings.CollapseWhitespace(content.overview)
end sub

'-------------------------------------------------------------------------------
' applyContentGradientVisibility
'-------------------------------------------------------------------------------
sub applyContentGradientVisibility(mediaType as string)
    layout = getContentLayout(mediaType)
    hidesContentGradient = layout.isCinematicDetails and m.top.castVisible <> true
    m.background.shade.visible = layout.isArtworkFreePoster <> true
    m.background.gradient.visible = hidesContentGradient <> true and layout.isArtworkFreePoster <> true and layout.hidesCornerGradient <> true
end sub

'-------------------------------------------------------------------------------
' applyContentLayout
'-------------------------------------------------------------------------------
sub applyContentLayout(mediaType as string)
    layout = getContentLayout(mediaType)
    m.overviewDescription.width = layout.overviewWidth
    m.episodeTitleLabel.width = layout.detailsWidth
    m.episodeTitleLabel.translation = layout.titleTranslation
    m.episodeTitleLabel.height = layout.titleHeight
    m.episodeTitleLabel.font = layout.titleFont
    m.logoFallbackTitleLabel.translation = layout.logoTextTranslation
    m.logoFallbackTitleLabel.height = layout.logoTextHeight
    m.logoFallbackTitleLabel.font = layout.logoTextFont
    m.infoGroup.translation = layout.infoTranslation
    m.metadata.secondaryRow.visible = layout.isSeriesPoster <> true
    m.overviewDescription.visible = layout.isSeriesPoster <> true
end sub

'-------------------------------------------------------------------------------
' getContentLayout
'-------------------------------------------------------------------------------
function getContentLayout(mediaType as string) as object
    mode = LCase(m.top.backgroundDisplay)
    isMovie = mediaType = "movie"
    isSeries = mediaType = "tv-show"
    isEpisode = mediaType = "tv-episode"
    isSeason = mediaType = "tv-season"
    isPoster = mode = MediaShellLayout.Mode.Poster
    isMoviePoster = isPoster and isMovie
    isSeriesPoster = isPoster and isSeries
    isCinematicDetails = mode = MediaShellLayout.Mode.Cinematic and (isMovie or isEpisode or isSeason)
    isPartial = mode = MediaShellLayout.Mode.PartialScreen
    layout = {
        isMoviePoster: isMoviePoster
        isSeriesPoster: isSeriesPoster
        isArtworkFreePoster: isMoviePoster or isSeriesPoster
        isPartial: isPartial
        isCinematicDetails: isCinematicDetails
        hidesCornerGradient: isPartial and (isMovie or isSeries or isEpisode)
        showEpisodeTitle: isEpisode or (isCinematicDetails and isSeason)
        canvasWidth: 1920
        detailsWidth: (isMoviePoster ? 1056 : 1220)
        overviewWidth: (isMoviePoster ? 1056 : 1040)
        logoTextWidth: (isSeriesPoster ? 1920 : (isMoviePoster ? 1056 : 1220))
        logoTextAlign: (isSeriesPoster ? "center" : "left")
        titleTranslation: [0, 0]
        titleHeight: 160
        titleFont: "font:LargeBoldSystemFont"
        infoTranslation: [0, 230]
        logoMaxWidth: 600
        logoMaxHeight: 220
        logoAnchorTop: 230
        logoGap: 40
        logoTextTranslation: [0, 0]
        logoTextHeight: 184
        logoTextFont: "font:LargestSystemFont"
    }
    if isSeriesPoster then
        layout.titleHeight = 0
        layout.infoTranslation = [0, 247]
        layout.logoMaxHeight = 150
        layout.logoAnchorTop = 212
        layout.logoGap = 0
        layout.logoTextTranslation = [0, 104]
        layout.logoTextHeight = 66
    else if isEpisode or (isCinematicDetails and isSeason) then
        titleY = (isCinematicDetails ? 527 : 170)
        layout.titleTranslation = [0, titleY]
        layout.titleHeight = 52
        layout.titleFont = "font:MediumBoldSystemFont"
        layout.infoTranslation = [0, (isCinematicDetails ? 603 : 230)]
        layout.logoMaxWidth = 520
        layout.logoMaxHeight = 120
        layout.logoAnchorTop = titleY
        layout.logoGap = 24
        layout.logoTextTranslation = [0, 34]
        layout.logoTextHeight = 112
    else if isCinematicDetails then
        layout.infoTranslation = [0, 603]
        layout.logoAnchorTop = 603
    end if
    return layout
end function

'-------------------------------------------------------------------------------
' renderBackdrop
'-------------------------------------------------------------------------------
sub renderBackdrop(backdropUrl as string)
    layout = getContentLayout(m.logoState.mediaType)
    if layout.isArtworkFreePoster then
        clearBackdrop()
        return
    end if
    if backdropUrl = "" then
        clearBackdrop()
        return
    end if

    if backdropUrl = m.background.url then return

    m.background.full.opacity = 0.50
    m.background.corner.opacity = 0.50
    m.background.full.uri = backdropUrl
    m.background.corner.uri = backdropUrl
    m.background.url = backdropUrl
    applyBackgroundDisplay()
end sub

'-------------------------------------------------------------------------------
' clearBackdrop
'-------------------------------------------------------------------------------
sub clearBackdrop()
    m.background.full.visible = false
    m.background.cornerGroup.visible = false
    m.background.full.uri = ""
    m.background.corner.uri = ""
    m.background.full.opacity = 0.50
    m.background.corner.opacity = 0.50
    m.background.url = ""
end sub

'-------------------------------------------------------------------------------
' canFocusDescription
'-------------------------------------------------------------------------------
function canFocusDescription() as boolean
    return m.overviewDescription <> invalid and m.overviewDescription.canAcceptFocus = true
end function

'-------------------------------------------------------------------------------
' focusDescription
'-------------------------------------------------------------------------------
function focusDescription() as boolean
    if canFocusDescription() <> true then return false

    m.overviewDescription.setFocus(true)
    return true
end function

'-------------------------------------------------------------------------------
' onDescriptionOverlayRequested
'-------------------------------------------------------------------------------
sub onDescriptionOverlayRequested()
    if m.overviewDescription.overlayRequested = invalid then return

    m.top.overlayRequested = m.overviewDescription.overlayRequested
end sub

'-------------------------------------------------------------------------------
' renderTitle
'-------------------------------------------------------------------------------
sub renderTitle(title as string, logoUrl as string, logoTitle as string, mediaType as string, logoPending as boolean)
    hasLogo = logoUrl <> ""
    m.logoState.mediaType = mediaType
    layout = getContentLayout(mediaType)
    fallbackTitle = getLogoFallbackTitle(title, logoTitle, mediaType)
    showEpisodeTitle = layout.showEpisodeTitle
    showLogoText = hasLogo = false and logoPending = false and fallbackTitle <> ""

    m.episodeTitleLabel.visible = showEpisodeTitle
    m.episodeTitleLabel.text = ""
    m.logoFallbackTitleLabel.visible = showLogoText
    m.logoFallbackTitleLabel.text = ""
    updateLogoFallbackTitlePosition(showEpisodeTitle)

    if showEpisodeTitle then m.episodeTitleLabel.text = title
    if showLogoText then m.logoFallbackTitleLabel.text = fallbackTitle

    if hasLogo then
        m.logoState.title = fallbackTitle
        m.logoState.mediaType = mediaType
        if logoUrl = m.logoState.url and m.titleLogo.uri = logoUrl then
            if m.logoState.fittedMediaType <> mediaType then onTitleLogoLoadStatusChanged()
            return
        end if

        m.logoState.url = logoUrl
        m.logoState.fittedMediaType = ""
        m.titleLogo.visible = false
        m.titleLogo.width = layout.logoMaxWidth
        m.titleLogo.height = layout.logoMaxHeight
        m.titleLogo.translation = [0, 0]
        m.titleLogo.uri = logoUrl
    else
        m.logoState.url = ""
        m.logoState.title = ""
        m.logoState.mediaType = mediaType
        m.logoState.fittedMediaType = ""
        m.titleLogo.visible = false
        m.titleLogo.uri = ""
        m.titleLogo.translation = [0, 0]
    end if
end sub

'-------------------------------------------------------------------------------
' getLogoFallbackTitle
'-------------------------------------------------------------------------------
function getLogoFallbackTitle(title as string, logoTitle as string, mediaType as string) as string
    if mediaType = "tv-episode" or mediaType = "tv-season" then return logoTitle
    return title
end function

'-------------------------------------------------------------------------------
' onTitleLogoLoadStatusChanged
'-------------------------------------------------------------------------------
sub onTitleLogoLoadStatusChanged()
    if m.logoState.url = "" then return

    loadStatus = LCase(m.titleLogo.loadStatus)
    if loadStatus = "failed" then
        m.titleLogo.visible = false
        m.logoFallbackTitleLabel.visible = m.logoState.title <> ""
        m.logoFallbackTitleLabel.text = m.logoState.title
        updateLogoFallbackTitlePosition(m.episodeTitleLabel.visible)
        return
    end if

    if loadStatus <> "ready" then return
    if m.titleLogo.uri <> m.logoState.url then return

    bitmapWidth = m.titleLogo.bitmapWidth
    bitmapHeight = m.titleLogo.bitmapHeight
    if bitmapWidth = invalid or bitmapHeight = invalid then return
    if bitmapWidth <= 0 or bitmapHeight <= 0 then return

    mediaType = m.logoState.mediaType
    layout = getContentLayout(mediaType)
    if layout.isSeriesPoster then
        m.titleLogo.width = layout.logoMaxWidth
        m.titleLogo.height = layout.logoMaxHeight
        m.titleLogo.translation = [Number.ToInteger((layout.canvasWidth - layout.logoMaxWidth) / 2), getLogoBottomAlignedY(layout.logoMaxHeight, layout)]
        m.titleLogo.visible = true
        m.logoState.fittedMediaType = mediaType
        return
    end if

    maxWidth = layout.logoMaxWidth
    maxHeight = layout.logoMaxHeight
    ' Reserve the gap before fitting so tall logos never need a clamped top edge.
    availableHeight = layout.logoAnchorTop - layout.logoGap
    if maxHeight > availableHeight then maxHeight = availableHeight
    logoRatio = bitmapWidth / bitmapHeight
    boxRatio = maxWidth / maxHeight

    if logoRatio > boxRatio then
        fittedWidth = maxWidth
        fittedHeight = Number.ToInteger(maxWidth / logoRatio)
    else
        fittedHeight = maxHeight
        fittedWidth = Number.ToInteger(maxHeight * logoRatio)
    end if

    if fittedWidth < 1 then fittedWidth = 1
    if fittedHeight < 1 then fittedHeight = 1

    m.titleLogo.width = fittedWidth
    m.titleLogo.height = fittedHeight
    m.titleLogo.translation = [0, getLogoBottomAlignedY(fittedHeight, layout)]
    m.titleLogo.visible = true
    m.logoState.fittedMediaType = mediaType
end sub

'-------------------------------------------------------------------------------
' updateLogoFallbackTitlePosition
'-------------------------------------------------------------------------------
sub updateLogoFallbackTitlePosition(hasEpisodeTitle as boolean)
    layout = getContentLayout(m.logoState.mediaType)
    m.logoFallbackTitleLabel.width = layout.logoTextWidth
    m.logoFallbackTitleLabel.horizAlign = layout.logoTextAlign
    if layout.isSeriesPoster then
        m.logoFallbackTitleLabel.translation = layout.logoTextTranslation
        return
    end if

    targetTranslation = m.infoGroup.translation
    gap = 24

    if hasEpisodeTitle then
        targetTranslation = m.episodeTitleLabel.translation
        gap = 8
    end if

    y = Number.ToInteger(targetTranslation[1] - m.logoFallbackTitleLabel.height - gap)
    if y < 0 then y = 0

    m.logoFallbackTitleLabel.translation = [targetTranslation[0], y]
end sub

'-------------------------------------------------------------------------------
' getLogoBottomAlignedY
'-------------------------------------------------------------------------------
function getLogoBottomAlignedY(logoHeight as integer, layout as object) as integer
    y = layout.logoAnchorTop - layout.logoGap - logoHeight
    if y < 0 then return 0
    return y
end function

'-------------------------------------------------------------------------------
' renderMetadata
'-------------------------------------------------------------------------------
sub renderMetadata(content as object, mediaType as string)
    layout = getContentLayout(mediaType)
    primaryInput = new MediaMetadata()
    primaryInput.leadingText = Strings.ToString(content.primaryInfoText)
    primaryInput.availableWidth = layout.detailsWidth
    secondaryInput = new MediaMetadata()
    secondaryInput.leadingText = Strings.ToString(content.secondaryInfoText)
    secondaryInput.availableWidth = layout.detailsWidth
    input = primaryInput
    if mediaType = "tv-episode" then input = secondaryInput
    input.runtimeText = Strings.ToString(content.runtimeText)
    input.officialRating = Strings.ToString(content.officialRating)
    input.communityRating = content.communityRating
    input.criticRating = content.criticRating
    m.metadata.primaryRow.callFunc("render", primaryInput)
    m.metadata.secondaryRow.callFunc("render", secondaryInput)
    positionPrimaryMetadata(layout)
end sub

'-------------------------------------------------------------------------------
' positionPrimaryMetadata
'-------------------------------------------------------------------------------
sub positionPrimaryMetadata(layout as object)
    x = 0
    if layout.isSeriesPoster then x = Number.ToInteger((layout.canvasWidth - m.metadata.primaryRow.boundingRect().width) / 2, 0)
    m.metadata.primaryRow.translation = [x, 0]
end sub

'-------------------------------------------------------------------------------
' renderMoviePoster
'-------------------------------------------------------------------------------
sub renderMoviePoster(content as dynamic)
    layout = getContentLayout(m.logoState.mediaType)
    m.moviePoster.group.visible = layout.isMoviePoster
    if layout.isMoviePoster <> true then
        m.moviePoster.image.uri = ""
        m.moviePoster.url = ""
        return
    end if

    posterUrl = ""
    if content <> invalid then posterUrl = Strings.ToString(content.posterUrl)
    if posterUrl = "" then posterUrl = "pkg:/images/media-card/poster-placeholder-252x378.png"
    if posterUrl = m.moviePoster.url then return
    m.moviePoster.url = posterUrl
    m.moviePoster.image.uri = posterUrl
end sub

'-------------------------------------------------------------------------------
' onMoviePosterLoadStatusChanged
'-------------------------------------------------------------------------------
sub onMoviePosterLoadStatusChanged()
    if m.moviePoster.group.visible <> true then return
    if m.moviePoster.image.loadStatus <> "failed" then return
    if m.moviePoster.image.uri <> m.moviePoster.url then return
    placeholderUri = "pkg:/images/media-card/poster-placeholder-252x378.png"
    if m.moviePoster.url = placeholderUri then return
    m.moviePoster.url = placeholderUri
    m.moviePoster.image.uri = placeholderUri
end sub
