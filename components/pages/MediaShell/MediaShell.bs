import "pkg:/source/Format.bs"
import "pkg:/source/MediaMetadata.bs"
import "pkg:/source/Number.bs"
import "pkg:/source/TextMeasurement.bs"
import "pkg:/source/String.bs"
import "pkg:/source/MaskAssets.bs"
import "pkg:/source/ResolutionProfile.bs"
import "pkg:/source/ResolutionAssets.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    initReferences()
    m.mediaBackgroundUrl = ""
    m.logoState = {
        url: ""
        title: ""
        mediaType: ""
        fittedMediaType: ""
    }
    initHandlers()
    onContentTranslationChanged()
    applyBackgroundDisplay()
    onDetailsVisibleChanged()
end sub

'-------------------------------------------------------------------------------
' initReferences
'-------------------------------------------------------------------------------
sub initReferences()
    m.mediaBackgroundFull = m.top.findNode("mediaBackgroundFull")
    m.mediaBackgroundPartialGroup = m.top.findNode("mediaBackgroundPartialGroup")
    MaskAssets.Apply(m.mediaBackgroundPartialGroup, "media-shell-backdrop-mask.png", [1152, 648], [768, 432])
    m.mediaBackgroundPartial = m.top.findNode("mediaBackgroundPartial")
    m.contentGradient = m.top.findNode("contentGradient")
    m.contentGroup = m.top.findNode("contentGroup")
    m.titleLogo = m.top.findNode("titleLogo")
    m.logoFallbackTitleLabel = m.top.findNode("logoFallbackTitleLabel")
    m.episodeTitleLabel = m.top.findNode("episodeTitleLabel")
    m.infoGroup = m.top.findNode("infoGroup")
    m.primaryInfoLabel = m.top.findNode("primaryInfoLabel")
    m.secondaryInfoLabel = m.top.findNode("secondaryInfoLabel")
    m.overviewDescription = m.top.findNode("overviewDescription")

    m.metadata = {
        inactive: m.top.findNode("inactiveMetadata")
        measurementLabel: CreateObject("roSGNode", "Label")
        maxWidth: m.primaryInfoLabel.width
        badgeMaxWidth: m.top.findNode("contentRatingLabel").width
        runtimeGroup: m.top.findNode("runtimeGroup")
        runtimeLabel: m.top.findNode("runtimeLabel")
        contentRatingGroup: m.top.findNode("contentRatingGroup")
        contentRatingLabel: m.top.findNode("contentRatingLabel")
        contentRatingBorder: m.top.findNode("contentRatingBorder")
        group: m.top.findNode("ratingsGroup")
        primaryRow: m.top.findNode("primaryInfoRow")
        secondaryRow: m.top.findNode("secondaryInfoRow")
        communityGroup: m.top.findNode("communityRatingGroup")
        communityLabel: m.top.findNode("communityRatingLabel")
        criticGroup: m.top.findNode("criticRatingGroup")
        criticLabel: m.top.findNode("criticRatingLabel")
        criticIcon: m.top.findNode("criticRatingIcon")
    }
end sub

'-------------------------------------------------------------------------------
' initHandlers
'-------------------------------------------------------------------------------
sub initHandlers()
    m.overviewDescription.observeField("overlayRequested", "onDescriptionOverlayRequested")
    m.titleLogo.observeField("loadStatus", "onTitleLogoLoadStatusChanged")
end sub

'-------------------------------------------------------------------------------
' onContentTranslationChanged
'-------------------------------------------------------------------------------
sub onContentTranslationChanged()
    m.contentGroup.translation = m.top.contentTranslation
end sub

'-------------------------------------------------------------------------------
' onBackgroundDisplayChanged
'-------------------------------------------------------------------------------
sub onBackgroundDisplayChanged()
    applyBackgroundDisplay()
    applyContentLayout(m.logoState.mediaType)
    applyContentGradientVisibility(m.logoState.mediaType)
    onTitleLogoLoadStatusChanged()
end sub

'-------------------------------------------------------------------------------
' onDetailsVisibleChanged
'-------------------------------------------------------------------------------
sub onDetailsVisibleChanged()
    m.infoGroup.visible = m.top.detailsVisible
end sub

'-------------------------------------------------------------------------------
' onCastVisibleChanged
'-------------------------------------------------------------------------------
sub onCastVisibleChanged()
    applyContentGradientVisibility(m.logoState.mediaType)
end sub

'-------------------------------------------------------------------------------
' applyBackgroundDisplay
'-------------------------------------------------------------------------------
sub applyBackgroundDisplay()
    isPartial = LCase(Format.SafeString(m.top.backgroundDisplay, "full-screen")) = "partial-screen"
    hasBackdrop = m.mediaBackgroundUrl <> ""

    m.mediaBackgroundFull.visible = hasBackdrop and isPartial <> true
    m.mediaBackgroundPartialGroup.visible = hasBackdrop and isPartial
end sub

'-------------------------------------------------------------------------------
' onMediaContentChanged
'-------------------------------------------------------------------------------
sub onMediaContentChanged()
    content = m.top.mediaContent
    if content = invalid then return

    mediaType = Format.SafeString(content.mediaType, "")
    logoPending = content.logoPending = true
    applyContentLayout(mediaType)
    applyContentGradientVisibility(mediaType)
    renderBackdrop(Format.SafeString(content.backdropUrl, ""))
    renderTitle(Format.SafeString(content.title, ""), Format.SafeString(content.logoUrl, ""), Format.SafeString(content.logoTitle, ""), mediaType, logoPending)
    m.primaryInfoLabel.text = Format.SafeString(content.primaryInfoText, "")
    m.secondaryInfoLabel.text = Format.SafeString(content.secondaryInfoText, "")
    renderMetadata(content, mediaType)
    m.overviewDescription.title = Format.SafeString(content.title, "Description")
    m.overviewDescription.text = Strings.CollapseWhitespace(content.overview)
end sub

'-------------------------------------------------------------------------------
' applyContentGradientVisibility
'-------------------------------------------------------------------------------
sub applyContentGradientVisibility(mediaType as string)
    isCinematic = LCase(Format.SafeString(m.top.backgroundDisplay, "full-screen")) = "cinematic"
    usesCinematicDetailLayout = mediaType = "movie" or mediaType = "tv-episode" or mediaType = "tv-season"
    hidesContentGradient = isCinematic and usesCinematicDetailLayout and m.top.castVisible <> true
    m.contentGradient.visible = hidesContentGradient <> true
end sub

'-------------------------------------------------------------------------------
' applyContentLayout
'-------------------------------------------------------------------------------
sub applyContentLayout(mediaType as string)
    layout = getContentLayout(mediaType)

    m.episodeTitleLabel.translation = layout.titleTranslation
    m.episodeTitleLabel.height = layout.titleHeight
    m.episodeTitleLabel.font = layout.titleFont
    m.logoFallbackTitleLabel.translation = layout.logoTextTranslation
    m.logoFallbackTitleLabel.height = layout.logoTextHeight
    m.logoFallbackTitleLabel.font = layout.logoTextFont
    m.infoGroup.translation = layout.infoTranslation
end sub

'-------------------------------------------------------------------------------
' getContentLayout
'-------------------------------------------------------------------------------
function getContentLayout(mediaType as string) as object
    isCinematic = LCase(Format.SafeString(m.top.backgroundDisplay, "full-screen")) = "cinematic"
    if isCinematic and (mediaType = "movie" or mediaType = "tv-episode" or mediaType = "tv-season") then
        if mediaType = "tv-episode" or mediaType = "tv-season" then
            return {
                titleTranslation: [0, 527]
                titleHeight: 52
                titleFont: "font:MediumBoldSystemFont"
                infoTranslation: [0, 603]
                logoMaxWidth: 520
                logoMaxHeight: 120
                logoAnchorTop: 527
                logoGap: 24
                logoTextTranslation: [0, 34]
                logoTextHeight: 112
                logoTextFont: "font:LargestSystemFont"
            }
        end if

        return {
            titleTranslation: [0, 0]
            titleHeight: 160
            titleFont: "font:LargeBoldSystemFont"
            infoTranslation: [0, 603]
            logoMaxWidth: 600
            logoMaxHeight: 220
            logoAnchorTop: 603
            logoGap: 40
            logoTextTranslation: [0, 0]
            logoTextHeight: 184
            logoTextFont: "font:LargestSystemFont"
        }
    end if

    if mediaType = "tv-episode" then
        return {
            titleTranslation: [0, 170]
            titleHeight: 52
            titleFont: "font:MediumBoldSystemFont"
            infoTranslation: [0, 230]
            logoMaxWidth: 520
            logoMaxHeight: 120
            logoAnchorTop: 170
            logoGap: 24
            logoTextTranslation: [0, 34]
            logoTextHeight: 112
            logoTextFont: "font:LargestSystemFont"
        }
    end if

    return {
        titleTranslation: [0, 0]
        titleHeight: 160
        titleFont: "font:LargeBoldSystemFont"
        infoTranslation: [0, 230]
        logoMaxWidth: 600
        logoMaxHeight: 220
        logoAnchorTop: 230
        logoGap: 40
        logoTextTranslation: [0, 0]
        logoTextHeight: 184
        logoTextFont: "font:LargestSystemFont"
    }
end function

'-------------------------------------------------------------------------------
' renderBackdrop
'-------------------------------------------------------------------------------
sub renderBackdrop(backdropUrl as string)
    if backdropUrl = "" then
        clearBackdrop()
        return
    end if

    if backdropUrl = m.mediaBackgroundUrl then return

    m.mediaBackgroundFull.opacity = 0.50
    m.mediaBackgroundPartial.opacity = 0.50
    m.mediaBackgroundFull.uri = backdropUrl
    m.mediaBackgroundPartial.uri = backdropUrl
    m.mediaBackgroundUrl = backdropUrl
    applyBackgroundDisplay()
end sub

'-------------------------------------------------------------------------------
' clearBackdrop
'-------------------------------------------------------------------------------
sub clearBackdrop()
    m.mediaBackgroundFull.visible = false
    m.mediaBackgroundPartialGroup.visible = false
    m.mediaBackgroundFull.uri = ""
    m.mediaBackgroundPartial.uri = ""
    m.mediaBackgroundFull.opacity = 0.50
    m.mediaBackgroundPartial.opacity = 0.50
    m.mediaBackgroundUrl = ""
end sub

'-------------------------------------------------------------------------------
' canFocusDescription
'-------------------------------------------------------------------------------
function canFocusDescription() as boolean
    return m.overviewDescription <> invalid and m.overviewDescription.canAcceptFocus = true
end function

'-------------------------------------------------------------------------------
' focusDescription
'-------------------------------------------------------------------------------
function focusDescription() as boolean
    if canFocusDescription() <> true then return false

    m.overviewDescription.setFocus(true)
    return true
end function

'-------------------------------------------------------------------------------
' onDescriptionOverlayRequested
'-------------------------------------------------------------------------------
sub onDescriptionOverlayRequested()
    request = m.overviewDescription.overlayRequested
    if request = invalid then return

    m.top.overlayRequested = request
end sub

'-------------------------------------------------------------------------------
' renderTitle
'-------------------------------------------------------------------------------
sub renderTitle(title as string, logoUrl as string, logoTitle as string, mediaType as string, logoPending as boolean)
    hasLogo = logoUrl <> ""
    isTVEpisode = mediaType = "tv-episode"
    isCinematicTVSeason = mediaType = "tv-season" and LCase(Format.SafeString(m.top.backgroundDisplay, "full-screen")) = "cinematic"
    fallbackTitle = getLogoFallbackTitle(title, logoTitle, mediaType)
    showEpisodeTitle = isTVEpisode or isCinematicTVSeason
    showLogoText = hasLogo = false and logoPending = false and fallbackTitle <> ""

    m.episodeTitleLabel.visible = showEpisodeTitle
    m.episodeTitleLabel.text = ""
    m.logoFallbackTitleLabel.visible = showLogoText
    m.logoFallbackTitleLabel.text = ""
    updateLogoFallbackTitlePosition(showEpisodeTitle)

    if showEpisodeTitle then m.episodeTitleLabel.text = title
    if showLogoText then m.logoFallbackTitleLabel.text = fallbackTitle

    if hasLogo then
        m.logoState.title = fallbackTitle
        m.logoState.mediaType = mediaType
        if logoUrl = m.logoState.url and Format.SafeString(m.titleLogo.uri, "") = logoUrl then
            if m.logoState.fittedMediaType <> mediaType then onTitleLogoLoadStatusChanged()
            return
        end if

        layout = getContentLayout(mediaType)
        m.logoState.url = logoUrl
        m.logoState.fittedMediaType = ""
        m.titleLogo.visible = false
        m.titleLogo.width = layout.logoMaxWidth
        m.titleLogo.height = layout.logoMaxHeight
        m.titleLogo.translation = [0, 0]
        m.titleLogo.uri = logoUrl
    else
        m.logoState.url = ""
        m.logoState.title = ""
        m.logoState.mediaType = mediaType
        m.logoState.fittedMediaType = ""
        m.titleLogo.visible = false
        m.titleLogo.uri = ""
        m.titleLogo.translation = [0, 0]
    end if
end sub

'-------------------------------------------------------------------------------
' getLogoFallbackTitle
'-------------------------------------------------------------------------------
function getLogoFallbackTitle(title as string, logoTitle as string, mediaType as string) as string
    if mediaType = "tv-episode" or mediaType = "tv-season" then return logoTitle
    return title
end function

'-------------------------------------------------------------------------------
' onTitleLogoLoadStatusChanged
'-------------------------------------------------------------------------------
sub onTitleLogoLoadStatusChanged()
    if m.logoState.url = "" then return

    loadStatus = LCase(Format.SafeString(m.titleLogo.loadStatus, ""))
    if loadStatus = "failed" then
        m.titleLogo.visible = false
        m.logoFallbackTitleLabel.visible = Format.SafeString(m.logoState.title, "") <> ""
        m.logoFallbackTitleLabel.text = Format.SafeString(m.logoState.title, "")
        updateLogoFallbackTitlePosition(m.episodeTitleLabel.visible)
        return
    end if

    if loadStatus <> "ready" then return
    if Format.SafeString(m.titleLogo.uri, "") <> m.logoState.url then return

    bitmapWidth = m.titleLogo.bitmapWidth
    bitmapHeight = m.titleLogo.bitmapHeight
    if bitmapWidth = invalid or bitmapHeight = invalid then return
    if bitmapWidth <= 0 or bitmapHeight <= 0 then return

    mediaType = Format.SafeString(m.logoState.mediaType, "")
    layout = getContentLayout(mediaType)
    maxWidth = layout.logoMaxWidth
    maxHeight = layout.logoMaxHeight
    ' Reserve the gap before fitting so tall logos never need a clamped top edge.
    availableHeight = layout.logoAnchorTop - layout.logoGap
    if maxHeight > availableHeight then maxHeight = availableHeight
    logoRatio = bitmapWidth / bitmapHeight
    boxRatio = maxWidth / maxHeight

    if logoRatio > boxRatio then
        fittedWidth = maxWidth
        fittedHeight = Number.ToInteger(maxWidth / logoRatio)
    else
        fittedHeight = maxHeight
        fittedWidth = Number.ToInteger(maxHeight * logoRatio)
    end if

    if fittedWidth < 1 then fittedWidth = 1
    if fittedHeight < 1 then fittedHeight = 1

    m.titleLogo.width = fittedWidth
    m.titleLogo.height = fittedHeight
    m.titleLogo.translation = [0, getLogoBottomAlignedY(fittedHeight, layout)]
    m.titleLogo.visible = true
    m.logoState.fittedMediaType = mediaType
end sub

'-------------------------------------------------------------------------------
' updateLogoFallbackTitlePosition
'-------------------------------------------------------------------------------
sub updateLogoFallbackTitlePosition(hasEpisodeTitle as boolean)
    targetTranslation = m.infoGroup.translation
    gap = 24

    if hasEpisodeTitle then
        targetTranslation = m.episodeTitleLabel.translation
        gap = 8
    end if

    y = int(targetTranslation[1] - m.logoFallbackTitleLabel.height - gap)
    if y < 0 then y = 0

    m.logoFallbackTitleLabel.translation = [targetTranslation[0], y]
end sub

'-------------------------------------------------------------------------------
' getLogoBottomAlignedY
'-------------------------------------------------------------------------------
function getLogoBottomAlignedY(logoHeight as integer, layout as object) as integer
    y = layout.logoAnchorTop - layout.logoGap - logoHeight
    if y < 0 then return 0
    return y
end function

'-------------------------------------------------------------------------------
' renderMetadata
'-------------------------------------------------------------------------------
sub renderMetadata(content as object, mediaType as string)
    runtimeText = Format.SafeString(content.runtimeText, "")
    contentRatingText = Format.SafeString(content.officialRating, "")
    m.metadata.runtimeLabel.text = runtimeText
    m.metadata.runtimeGroup.visible = runtimeText <> ""
    m.metadata.contentRatingLabel.text = contentRatingText
    m.metadata.contentRatingGroup.visible = contentRatingText <> ""
    badgeTextWidth = TextMeasurement.GetWidth(m.metadata.measurementLabel, m.metadata.contentRatingLabel.font, contentRatingText)
    if badgeTextWidth > m.metadata.badgeMaxWidth then badgeTextWidth = m.metadata.badgeMaxWidth
    m.metadata.contentRatingLabel.width = badgeTextWidth
    m.metadata.contentRatingBorder.width = badgeTextWidth + (2 * m.metadata.contentRatingLabel.translation[0])

    communityText = MediaMetadata.FormatRating(content.communityRating)
    criticRating = MediaMetadata.NormalizeCriticRating(content.criticRating)
    criticText = ""
    if criticRating <> invalid then criticText = criticRating.ToStr() + "%"
    m.metadata.communityLabel.text = communityText
    m.metadata.communityGroup.visible = communityText <> ""
    m.metadata.criticLabel.text = criticText
    m.metadata.criticGroup.visible = criticText <> ""
    m.metadata.criticIcon.uri = ""
    if criticText <> "" then
        m.metadata.criticIcon.uri = "pkg:/images/icons/ratings/tomato-rotten.png"
        if criticRating >= 60 then m.metadata.criticIcon.uri = "pkg:/images/icons/ratings/tomato-fresh.png"
    end if
    m.metadata.group.visible = communityText <> "" or criticText <> ""

    layoutMetadataRow(mediaType)
end sub

'-------------------------------------------------------------------------------
' layoutMetadataRow
'-------------------------------------------------------------------------------
sub layoutMetadataRow(mediaType as string)
    ' Episode ratings follow date/runtime; movies and series use the first row.
    metadataColor = &hFFFFFFFF
    row = m.metadata.primaryRow
    metadataLabel = m.primaryInfoLabel
    m.primaryInfoLabel.width = 0
    m.secondaryInfoLabel.width = m.metadata.maxWidth
    if mediaType = "tv-episode" then
        metadataColor = &hB9C7D6FF
        row = m.metadata.secondaryRow
        metadataLabel = m.secondaryInfoLabel
        m.primaryInfoLabel.width = m.metadata.maxWidth
        m.secondaryInfoLabel.width = 0
    end if
    m.metadata.runtimeLabel.color = metadataColor
    m.metadata.communityLabel.color = metadataColor
    m.metadata.criticLabel.color = metadataColor
    m.primaryInfoLabel.visible = m.primaryInfoLabel.text <> ""
    m.secondaryInfoLabel.visible = m.secondaryInfoLabel.text <> ""
    ' Keep layout membership consistent with the visible items measured below.
    placeMetadataItem(m.primaryInfoLabel, m.metadata.primaryRow)
    placeMetadataItem(m.secondaryInfoLabel, m.metadata.secondaryRow)
    placeMetadataItem(m.metadata.communityGroup, m.metadata.group)
    placeMetadataItem(m.metadata.criticGroup, m.metadata.group)
    trailingWidth = 0
    trailingCount = 0
    for each group in [m.metadata.runtimeGroup, m.metadata.contentRatingGroup, m.metadata.group]
        placeMetadataItem(group, row)
        if group.visible then
            trailingWidth += measureMetadataItem(group)
            trailingCount++
        end if
    end for
    availableWidth = m.metadata.maxWidth - trailingWidth - (trailingCount * row.itemSpacings[0])
    textWidth = TextMeasurement.GetWidth(m.metadata.measurementLabel, metadataLabel.font, metadataLabel.text)
    if textWidth > availableWidth then textWidth = availableWidth
    if textWidth < 0 then textWidth = 0
    metadataLabel.width = textWidth
end sub

'-------------------------------------------------------------------------------
' placeMetadataItem
'-------------------------------------------------------------------------------
sub placeMetadataItem(node as object, row as object)
    ' Hidden nodes must leave the LayoutGroup so they consume neither width nor spacing.
    if node.visible then
        row.appendChild(node)
    else
        m.metadata.inactive.appendChild(node)
    end if
end sub

'-------------------------------------------------------------------------------
' measureMetadataItem
'-------------------------------------------------------------------------------
function measureMetadataItem(node as object) as float
    if node.isSameNode(m.metadata.contentRatingGroup) then return m.metadata.contentRatingBorder.width
    if node.subtype() = "Label" then return TextMeasurement.GetWidth(m.metadata.measurementLabel, node.font, node.text)
    if node.subtype() = "Poster" then return node.width

    width = 0
    visibleCount = 0
    for each child in node.getChildren(-1, 0)
        if child.visible then
            if visibleCount > 0 then width += node.itemSpacings[0]
            width += measureMetadataItem(child)
            visibleCount++
        end if
    end for
    return width
end function
