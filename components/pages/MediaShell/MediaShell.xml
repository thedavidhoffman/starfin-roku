<?xml version="1.0" encoding="utf-8"?>
<component name="MediaShell" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/pages/MediaShell/MediaShell.bs" />
  <interface>
    <field id="mediaContent" type="assocarray" onChange="onMediaContentChanged" />
    <field id="backgroundDisplay" type="string" value="full-screen" onChange="onBackgroundDisplayChanged" />
    <field id="contentTranslation" type="vector2d" value="[96,108]" onChange="onContentTranslationChanged" />
    <field id="detailsVisible" type="boolean" value="true" onChange="onDetailsVisibleChanged" />
    <field id="castVisible" type="boolean" value="false" onChange="onCastVisibleChanged" />
    <field id="overlayRequested" type="assocarray" alwaysNotify="true" />
    <function name="canFocusDescription" />
    <function name="focusDescription" />
  </interface>
  <children>
    <Poster id="mediaBackgroundFull" width="1920" height="1080" opacity="0.50" loadDisplayMode="scaleToZoom" visible="false" />
    <MaskGroup id="mediaBackgroundPartialGroup" translation="[768,0]" maskUri="pkg:/images/masks/fhd/media-shell-backdrop-mask.png" maskSize="[1152,648]" visible="false">
      <Poster id="mediaBackgroundPartial" width="1152" height="648" opacity="0.50" loadDisplayMode="scaleToZoom" />
    </MaskGroup>
    <Rectangle width="1920" height="1080" color="0x00000022" />
    <Poster id="contentGradient" uri="pkg:/images/overlays/bottom-content-gradient.png" translation="[0,490]" width="1920" height="740" loadDisplayMode="scaleToFit" />

    <Group id="contentGroup" translation="[96,108]">

      <!-- title logo (if available) -->
      <Poster id="titleLogo" width="600" height="220" loadDisplayMode="scaleToFit" visible="false" />
      
      <!-- if there's no logo, this is the fallback label -->
      <Label id="logoFallbackTitleLabel" width="1220" height="112" color="0xF3F7FBFF" vertAlign="bottom" visible="false" />

      <!-- when displaying a tv episode -->
      <Label id="episodeTitleLabel" width="1220" height="160" color="0xF3F7FBFF" font="font:LargeBoldSystemFont" />
      
      <Group id="infoGroup" translation="[0,230]" visible="true">
        <Group id="inactiveMetadata" visible="false" />
        
        <!-- when movie -or- tv series... primaryInfoLabel: delimited meta data -->
        <!-- when movie -or- tv series... secondaryInfoLabel: genres -->

        <!-- when tv episode... primaryInfoLabel: season - episode -->
        <!-- when tv episode... secondaryInfoLabel: delimited meta data -->

        <LayoutGroup id="primaryInfoRow" layoutDirection="horiz" itemSpacings="[18]" vertAlignment="center">
          <Label id="primaryInfoLabel" width="1220" height="28" color="0xFFFFFFFF" font="font:SmallestBoldSystemFont" />
          <LayoutGroup id="runtimeGroup" layoutDirection="horiz" itemSpacings="[8]" vertAlignment="center" visible="false">
            <Poster width="26" height="26" uri="pkg:/images/icons/ratings/runtime-clock.png" loadDisplayMode="scaleToFit" />
            <Label id="runtimeLabel" height="28" color="0xFFFFFFFF" font="font:SmallestBoldSystemFont" />
          </LayoutGroup>
          <Group id="contentRatingGroup" visible="false">
            <Poster id="contentRatingBorder" width="64" height="32" uri="pkg:/images/icons/ratings/content-rating-border.9.png" loadDisplayMode="scaleToFill" />
            <!-- One-pixel optical adjustment balances the system font inside the border. -->
            <Label id="contentRatingLabel" width="180" translation="[8,3]" height="28" color="0xFFFFFFFF" font="font:SmallestBoldSystemFont" />
          </Group>
          <LayoutGroup id="ratingsGroup" layoutDirection="horiz" itemSpacings="[18]" vertAlignment="center">
            <LayoutGroup id="communityRatingGroup" layoutDirection="horiz" itemSpacings="[8]" vertAlignment="center" visible="false">
              <Poster width="26" height="26" uri="pkg:/images/icons/ratings/rating-star.png" loadDisplayMode="scaleToFit" />
              <Label id="communityRatingLabel" height="28" color="0xFFFFFFFF" font="font:SmallestBoldSystemFont" />
            </LayoutGroup>
            <LayoutGroup id="criticRatingGroup" layoutDirection="horiz" itemSpacings="[8]" vertAlignment="center" visible="false">
              <Poster id="criticRatingIcon" width="28" height="28" loadDisplayMode="scaleToFit" />
              <Label id="criticRatingLabel" height="28" color="0xFFFFFFFF" font="font:SmallestBoldSystemFont" />
            </LayoutGroup>
          </LayoutGroup>
        </LayoutGroup>
        <LayoutGroup id="secondaryInfoRow" translation="[0,35]" layoutDirection="horiz" itemSpacings="[18]" vertAlignment="center">
          <Label id="secondaryInfoLabel" height="28" color="0xB9C7D6FF" font="font:SmallestBoldSystemFont" />
        </LayoutGroup>
        
        <DescriptionInline
          id="overviewDescription"
          translation="[0,89]"
          width="1040"
          numLines="3" />
      </Group>

    </Group>
  </children>
</component>
