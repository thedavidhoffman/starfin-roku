import "pkg:/source/SettingsClose.bs"

'-------------------------------------------------------------------------------
' openFailure
'-------------------------------------------------------------------------------
sub openFailure()
    m.top.title = "Couldn't save subtitle preferences"
    m.top.dialogWidth = 1100
    m.top.dialogHeight = 720
    m.top.closeOnContentSelected = false
    m.top.contentComponentName = "SettingsSaveFailureContent"
    m.top.decision = SettingsClose.Decision.KeepEditing
    content = m.top.callFunc("getContentComponent")
    content.message = m.top.message
    content.observeField("decision", "onDecision")
    m.top.callFunc("openDialog")
    m.top.callFunc("focusContent")
end sub

'-------------------------------------------------------------------------------
' focusContent
'-------------------------------------------------------------------------------
function focusContent() as boolean
    content = m.top.callFunc("getContentComponent")
    content.callFunc("focusKeepEditing")
    return true
end function

'-------------------------------------------------------------------------------
' onDecision
'-------------------------------------------------------------------------------
sub onDecision()
    content = m.top.callFunc("getContentComponent")
    m.top.decision = content.decision
    m.top.callFunc("closeDialog")
end sub
