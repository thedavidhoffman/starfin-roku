'-------------------------------------------------------------------------------
' setVideoStreamingModeOption
'-------------------------------------------------------------------------------
sub setVideoStreamingModeOption(value as dynamic)
    selectedIndex = 0
    if value = PlaybackMode.Mode.AutomaticNoRemux then
        selectedIndex = 1
    else if value = PlaybackMode.Mode.TranscodeAllowRemux then
        selectedIndex = 2
    else if value = PlaybackMode.Mode.TranscodeNoRemux then
        selectedIndex = 3
    end if
    m.settingsControls.videoStreamingModeOptions.checkedItem = selectedIndex
    m.settingsControls.videoStreamingModeOptions.jumpToItem = selectedIndex
    m.videoStreamingModeCard.description = getVideoStreamingModeDescription(selectedIndex)
end sub

'-------------------------------------------------------------------------------
' getVideoStreamingModeDescription
'-------------------------------------------------------------------------------
function getVideoStreamingModeDescription(index as integer) as string
    if index = 1 then return "Prefers Direct Play. When Direct Play is unavailable, Jellyfin fully converts the video instead of copying it into a new stream. Compatible audio may still be copied. This can resolve playback, timing, keyframe, and seeking problems caused by video remuxing."
    if index = 2 then return "Disables Direct Play. Jellyfin may repackage compatible video or audio without converting it, while transcoding anything the device cannot play. This can improve compatibility while preserving quality where possible."
    if index = 3 then return "Disables Direct Play and forces Jellyfin to convert the video to a supported format, usually H.264. This uses more server processing and may reduce quality, but can resolve playback, timing, keyframe, and seeking problems."
    return "Allows Jellyfin to choose Direct Play, remuxing, or transcoding based on the file, selected audio and subtitle tracks, device capabilities, and network limits. This is the normal playback mode and balances original quality, compatibility, and server processing."
end function

'-------------------------------------------------------------------------------
' getVideoStreamingModeForIndex
'-------------------------------------------------------------------------------
function getVideoStreamingModeForIndex(index as integer) as string
    if index = 1 then return PlaybackMode.Mode.AutomaticNoRemux
    if index = 2 then return PlaybackMode.Mode.TranscodeAllowRemux
    if index = 3 then return PlaybackMode.Mode.TranscodeNoRemux
    return PlaybackMode.Mode.Automatic
end function

'-------------------------------------------------------------------------------
' setSubtitleBurnInOption
'-------------------------------------------------------------------------------
sub setSubtitleBurnInOption(value as dynamic)
    selectedIndex = 0
    if value = SubtitleBurnIn.Mode.PreferExternal then selectedIndex = 1
    if value = SubtitleBurnIn.Mode.Always then selectedIndex = 2
    m.settingsControls.subtitleBurnInOptions.checkedItem = selectedIndex
    m.settingsControls.subtitleBurnInOptions.jumpToItem = selectedIndex
    m.subtitleBurnInCard.description = getSubtitleBurnInDescription(selectedIndex)
end sub

'-------------------------------------------------------------------------------
' getSubtitleBurnInModeForIndex
'-------------------------------------------------------------------------------
function getSubtitleBurnInModeForIndex(index as integer) as string
    if index = 1 then return SubtitleBurnIn.Mode.PreferExternal
    if index = 2 then return SubtitleBurnIn.Mode.Always
    return SubtitleBurnIn.Mode.DuringTranscoding
end function

'-------------------------------------------------------------------------------
' getSubtitleBurnInDescription
'-------------------------------------------------------------------------------
function getSubtitleBurnInDescription(index as integer) as string
    if index = 1 then return "Uses Roku-native external subtitles whenever supported, including during transcoding. This reduces server processing and preserves video quality, but subtitle timing may be less reliable on some media."
    if index = 2 then return "Always burns the selected subtitle into the video. This provides the most reliable synchronization but disables Direct Play and requires additional server processing."
    return "Burns subtitles into the video when Jellyfin is already transcoding. Uses external subtitles during Direct Play. This is the recommended balance of subtitle synchronization, video quality, and server usage."
end function

'-------------------------------------------------------------------------------
' clearResetStarfinButtonFocus
'-------------------------------------------------------------------------------
sub clearResetStarfinButtonFocus()
    if m.categoryPanels[m.categoryState.resetIndex] = invalid then return
    m.settingsControls.resetStarfinButton.hasFocusVisual = false
    m.settingsControls.abortResetButton.hasFocusVisual = false
    m.settingsControls.eraseAllDataButton.hasFocusVisual = false
end sub

'-------------------------------------------------------------------------------
' openKeyboardDialog
'-------------------------------------------------------------------------------
sub openKeyboardDialog()
    keyboardDialog = CreateObject("roSGNode", "StandardKeyboardDialog")
    keyboardDialog.buttons = ["Save", "Cancel"]
    keyboardDialog.title = "Enter TMDB API key"
    keyboardDialog.text = m.settingsControls.tmdbApiKeyInput.text
    keyboardDialog.observeField("buttonSelected", "onKeyboardDialogButtonSelected")

    m.focusState.activeKeyboardField = "tmdbApiKey"
    scene = m.top.getScene()
    if scene <> invalid then scene.dialog = keyboardDialog
end sub

'-------------------------------------------------------------------------------
' onKeyboardDialogButtonSelected
'-------------------------------------------------------------------------------
sub onKeyboardDialogButtonSelected()
    scene = m.top.getScene()
    if scene = invalid or scene.dialog = invalid then return

    keyboardDialog = scene.dialog
    if keyboardDialog.buttonSelected = 0 and m.focusState.activeKeyboardField = "tmdbApiKey" then
        tmdbApiKey = keyboardDialog.text
        if tmdbApiKey = invalid then tmdbApiKey = ""
        m.settingsControls.tmdbApiKeyInput.text = tmdbApiKey
        m.settingsState.values[SettingsStore.Key.TmdbApiKey] = tmdbApiKey
    end if

    scene.dialog = invalid
    m.focusState.activeKeyboardField = invalid
    focusCategoryControl(m.focusState.controlIndex, invalid)
end sub

