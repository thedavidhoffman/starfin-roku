'-------------------------------------------------------------------------------
sub setNextItemPlaybackOption(value as dynamic)
    selectedIndex = 0
    if value = NextItemPlayback.Mode.PlayNextImmediately then selectedIndex = 1
    m.settingsControls.nextItemPlaybackOptions.checkedItem = selectedIndex
    m.settingsControls.nextItemPlaybackOptions.jumpToItem = selectedIndex
    m.nextItemPlaybackCard.description = getNextItemPlaybackDescription(selectedIndex)
end sub

'-------------------------------------------------------------------------------
' getNextItemPlaybackDescription
'-------------------------------------------------------------------------------
function getNextItemPlaybackDescription(index as integer) as string
    if index = 1 then return "When a queued item, such as a TV episode or playlist item, finishes playing, Starfin starts the next item immediately without showing the Up Next screen."
    return "When a queued item, such as a TV episode or playlist item, finishes playing, Starfin shows the Up Next screen. The next item starts when selected or when the 15-second countdown expires."
end function

