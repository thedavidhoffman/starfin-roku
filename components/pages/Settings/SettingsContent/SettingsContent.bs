'-------------------------------------------------------------------------------
' handleMediaShellKey
'-------------------------------------------------------------------------------
function handleMediaShellKey(key as string) as boolean
    controls = m.categoryControls[SettingsNavigation.Category.MediaShell]
    focusedIndex = -1
    for index = 0 to controls.Count() - 1
        if controls[index].isInFocusChain() then focusedIndex = index
    end for
    if focusedIndex < 0 then return false
    m.focusState.controlIndex = focusedIndex
    control = controls[focusedIndex]
    itemIndex = getListIndex(control.itemFocused, getListItemCount(control))
    if key = Remote.Key.Left then
        if focusedIndex = SettingsNavigation.MediaShellControl.Movie or focusedIndex = SettingsNavigation.MediaShellControl.Series or focusedIndex = SettingsNavigation.MediaShellControl.ThemeMusic then
            focusFirstField()
        else
            targetIndex = (focusedIndex = SettingsNavigation.MediaShellControl.Music ? SettingsNavigation.MediaShellControl.Movie : SettingsNavigation.MediaShellControl.Series)
            focusCategoryControl(targetIndex, getListIndex(itemIndex, getListItemCount(controls[targetIndex])))
        end if
        return true
    else if key = Remote.Key.Right then
        if focusedIndex = SettingsNavigation.MediaShellControl.Movie or focusedIndex = SettingsNavigation.MediaShellControl.Series then
            targetIndex = (focusedIndex = SettingsNavigation.MediaShellControl.Movie ? SettingsNavigation.MediaShellControl.Music : SettingsNavigation.MediaShellControl.Episode)
            focusCategoryControl(targetIndex, getListIndex(itemIndex, getListItemCount(controls[targetIndex])))
        end if
        return true
    else if key = Remote.Key.Down and isFocusedAtLastItem(control) then
        if focusedIndex <> SettingsNavigation.MediaShellControl.ThemeMusic then
            if focusedIndex = SettingsNavigation.MediaShellControl.Movie then
                targetIndex = SettingsNavigation.MediaShellControl.Series
            else if focusedIndex = SettingsNavigation.MediaShellControl.Music then
                targetIndex = SettingsNavigation.MediaShellControl.Episode
            else
                targetIndex = SettingsNavigation.MediaShellControl.ThemeMusic
                m.mediaShellState.returnTvControl = focusedIndex
            end if
            focusCategoryControl(targetIndex, 0)
        end if
        return true
    else if key = Remote.Key.Up and isFocusedAtFirstItem(control) then
        if focusedIndex = SettingsNavigation.MediaShellControl.Series or focusedIndex = SettingsNavigation.MediaShellControl.Episode or focusedIndex = SettingsNavigation.MediaShellControl.ThemeMusic then
            if focusedIndex = SettingsNavigation.MediaShellControl.Series then
                targetIndex = SettingsNavigation.MediaShellControl.Movie
            else if focusedIndex = SettingsNavigation.MediaShellControl.Episode then
                targetIndex = SettingsNavigation.MediaShellControl.Music
            else
                targetIndex = m.mediaShellState.returnTvControl
            end if
            focusCategoryControl(targetIndex, getListItemCount(controls[targetIndex]) - 1)
        end if
        return true
    end if
    return false
end function

'-------------------------------------------------------------------------------
' showMediaShellPage
'-------------------------------------------------------------------------------
sub showMediaShellPage(index as integer)
    pages = m.mediaShellState.pages
    changed = pages.index <> index
    pages.index = index
    pages.layouts.visible = index = SettingsNavigation.MediaShellPage.Layouts
    pages.themeMusic.visible = index = SettingsNavigation.MediaShellPage.ThemeMusic
    pages.up.visible = index = SettingsNavigation.MediaShellPage.ThemeMusic
    pages.down.visible = index = SettingsNavigation.MediaShellPage.Layouts
    pages.number.text = "1 / 2"
    if index = SettingsNavigation.MediaShellPage.ThemeMusic then pages.number.text = "2 / 2"
    if changed then
        pages.fade.control = AnimationControl.Command.Stop
        pages.fade.control = AnimationControl.Command.Start
    end if
end sub

