'-------------------------------------------------------------------------------
sub onMediaShellLayoutSelected(event as object)
    control = event.getRoSGNode()
    selectedIndex = getSelectedItemIndex(control)
    if selectedIndex < 0 then return
    for each layout in m.mediaShellState.layouts
        if layout.control.isSameNode(control) then
            control.checkedItem = selectedIndex
            m.settingsState.values[layout.key] = layout.values[selectedIndex]
            return
        end if
    end for
end sub

