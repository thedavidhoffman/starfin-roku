'-------------------------------------------------------------------------------
' setUnwatchedEpisodeCountOption
'-------------------------------------------------------------------------------
sub setUnwatchedEpisodeCountOption(value as dynamic)
    normalized = UnwatchedEpisodeCount.Normalize(value)
    values = [UnwatchedEpisodeCount.Mode.Off, UnwatchedEpisodeCount.Mode.Subtle, UnwatchedEpisodeCount.Mode.HighContrast]
    selectedIndex = 0
    for index = 0 to values.Count() - 1
        if values[index] = normalized then selectedIndex = index
    end for
    m.settingsControls.showUnwatchedEpisodeCountOptions.checkedItem = selectedIndex
    m.settingsControls.showUnwatchedEpisodeCountOptions.jumpToItem = selectedIndex
end sub

'-------------------------------------------------------------------------------
' handleThemeKey
'-------------------------------------------------------------------------------
function handleThemeKey(key as string) as boolean
    controls = m.categoryControls[SettingsNavigation.Category.Theme]
    focusedIndex = -1
    for index = 0 to controls.Count() - 1
        if controls[index].isInFocusChain() then focusedIndex = index
    end for
    if focusedIndex < 0 then return false
    m.focusState.controlIndex = focusedIndex
    control = controls[focusedIndex]
    itemIndex = getListIndex(control.itemFocused, getListItemCount(control))

    if key = Remote.Key.Left then
        if focusedIndex = SettingsNavigation.ThemeControl.UnwatchedCount then
            return focusCategoryControl(SettingsNavigation.ThemeControl.WatchedIndicator, getListIndex(itemIndex, getListItemCount(controls[SettingsNavigation.ThemeControl.WatchedIndicator])))
        end if
        focusFirstField()
        return true
    else if key = Remote.Key.Right then
        if focusedIndex = SettingsNavigation.ThemeControl.WatchedIndicator then return focusCategoryControl(SettingsNavigation.ThemeControl.UnwatchedCount, itemIndex)
        return true
    else if key = Remote.Key.Down and isFocusedAtLastItem(control) then
        if focusedIndex = SettingsNavigation.ThemeControl.Theme then return focusCategoryControl(SettingsNavigation.ThemeControl.WatchedIndicator, 0)
    else if key = Remote.Key.Up and isFocusedAtFirstItem(control) then
        if focusedIndex <> SettingsNavigation.ThemeControl.Theme then return focusCategoryControl(SettingsNavigation.ThemeControl.Theme, getListItemCount(controls[SettingsNavigation.ThemeControl.Theme]) - 1)
    end if
    return false
end function
