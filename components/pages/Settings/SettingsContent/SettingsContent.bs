import "pkg:/source/Remote.bs"
import "pkg:/source/UnwatchedEpisodeCount.bs"
import "pkg:/source/Theme.bs"
import "pkg:/source/Char.bs"
import "pkg:/source/HomeEpisodeImages.bs"
import "pkg:/source/PlaybackMode.bs"
import "pkg:/source/SubtitleBurnIn.bs"
import "pkg:/source/LibraryLayoutSetting.bs"
import "pkg:/source/NextItemPlayback.bs"
import "pkg:/source/NextEpisodePromptSeconds.bs"
import "pkg:/source/store/RegistryStore.bs"
import "pkg:/source/store/SettingsStore.bs"
import "pkg:/source/VideoCardPresentation.bs"
import "pkg:/source/SettingsNavigation.bs"
import "pkg:/source/MediaShellLayout.bs"
import "pkg:/source/AnimationControl.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    initReferences()
    initCategoryList()
    initHandlers()
    showCategory(0)
end sub

'-------------------------------------------------------------------------------
' initCardLayout
'-------------------------------------------------------------------------------
sub initCardLayout(parent as object)
    for each child in parent.getChildren(-1, 0)
        if child.subtype() = "SettingsCard" then
            ' Expand default cards; preserve widths declared for side-by-side cards.
            if child.cardWidth = 1040 then
                child.cardWidth = 1160
            else
                ' Declarative content children are available after the parent initializes.
                child.callFunc("updateCard")
            end if
        else if child.subtype() = "Group" then
            initCardLayout(child)
        end if
    end for
end sub

'-------------------------------------------------------------------------------
' initBadgeCardLayout
'-------------------------------------------------------------------------------
sub initBadgeCardLayout(panel as object)
    watched = panel.findNode("watchedIndicatorCard")
    count = panel.findNode("unwatchedEpisodeCountCard")
    watchedHeadingWidth = watched.callFunc("getHeadingWidth")
    countHeadingWidth = count.callFunc("getHeadingWidth")
    ' Both cards share the same left inset; split spare width equally after headings.
    availableWidth = panel.findNode("themeCard").cardWidth - 16
    watched.cardWidth = (availableWidth + watchedHeadingWidth - countHeadingWidth) / 2
    count.cardWidth = availableWidth - watched.cardWidth
    count.translation = [watched.cardWidth + 16, watched.translation[1]]
end sub

'-------------------------------------------------------------------------------
' initReferences
'-------------------------------------------------------------------------------
sub initReferences()
    m.deviceCategoryList = m.top.findNode("deviceCategoryList")
    m.userCategoryList = m.top.findNode("userCategoryList")
    m.categoryPanels = [invalid, invalid, invalid, invalid, invalid, invalid, invalid, invalid, invalid, invalid, invalid]
    m.categoryControls = [[], [], [], [], [], [], [], [], [], [], []]
    m.settingsControls = {}
    m.resetStarfinState = { confirmationVisible: false }
    m.accountUi = { state: invalid }
    m.categoryState = {
        userTitles: ["Libraries", "Media shell", "Theme", "Playback", "Subtitles", "Credits", "TV", "Screensaver"]
        panelComponents: ["SettingsLibrariesPanel", "SettingsMediaShellPanel", "SettingsThemePanel", "SettingsPlaybackPanel", "SettingsSubtitlesPanel", "SettingsCreditsPanel", "SettingsTVPanel", "SettingsScreensaverPanel", "SettingsGeneralPanel", "SettingsVideoPanel", "SettingsAdvancedPanel"]
        panelIds: ["libraryPanel", "mediaShellPanel", "themePanel", "playbackPanel", "accountSubtitlesPanel", "creditsPanel", "tvPanel", "screensaverPanel", "systemPanel", "videoPanel", "advancedPanel"]
        deviceTitles: ["General", "Video", "Advanced"]
    }
    m.categoryState.userCount = m.categoryState.userTitles.Count()
    m.categoryState.deviceCount = m.categoryState.deviceTitles.Count()
    m.categoryState.deviceOffset = m.categoryState.userCount
    m.categoryState.lastUserIndex = m.categoryState.userCount - 1
    m.categoryState.resetIndex = m.categoryPanels.Count() - 1
    m.focusState = {
        categoryIndex: 0
        controlIndex: 0
        activeKeyboardField: invalid
        returnFocus: invalid
    }
    m.settingsState = { values: SettingsStore.Defaults(), loaded: false }
end sub

'-------------------------------------------------------------------------------
' initHandlers
'-------------------------------------------------------------------------------
sub initHandlers()
    m.deviceCategoryList.observeField("itemFocused", "onDeviceCategoryFocused")
    m.deviceCategoryList.observeField("itemSelected", "onDeviceCategorySelected")
    m.userCategoryList.observeField("itemFocused", "onUserCategoryFocused")
    m.userCategoryList.observeField("itemSelected", "onUserCategorySelected")
    m.top.observeField("accountSubtitleState", "onAccountSubtitleState")
    m.top.observeField("accountSubtitleLanguageOptions", "onAccountLanguageOptionsChanged")
    onAccountSubtitleState()
    onAccountLanguageOptionsChanged()
end sub

'-------------------------------------------------------------------------------
' ensureCategoryPanel
'-------------------------------------------------------------------------------
sub ensureCategoryPanel(index as integer)
    if m.categoryPanels[index] <> invalid then return

    ' Layout-only panels share this owner's state and are retained for this session.
    panel = CreateObject("roSGNode", m.categoryState.panelComponents[index])
    panel.id = m.categoryState.panelIds[index]
    panel.translation = [400, 0]
    panel.visible = false
    m.top.appendChild(panel)
    m.categoryPanels[index] = panel
    initCategoryReferences(index, panel)
    initCardLayout(panel)
    if index = SettingsNavigation.Category.Theme then initBadgeCardLayout(panel)
    initCategoryOptions(index)
    if m.settingsState.loaded then applyCategoryValues(index)
    initCategoryHandlers(index)
    if index = SettingsNavigation.Category.Subtitles then
        onAccountLanguageOptionsChanged()
        onAccountSubtitleState()
    end if
end sub

'-------------------------------------------------------------------------------
' initCategoryReferences
'-------------------------------------------------------------------------------
sub initCategoryReferences(index as integer, panel as object)
    if index = 0 then
        m.settingsControls.librarySettingsGrid = panel.findNode("librarySettingsGrid")
        m.categoryControls[index] = [m.settingsControls.librarySettingsGrid]
    else if index = 1 then
        m.settingsControls.movieShellLayoutOptions = panel.findNode("movieShellLayoutOptions")
        m.settingsControls.seriesShellLayoutOptions = panel.findNode("seriesShellLayoutOptions")
        m.settingsControls.episodeShellLayoutOptions = panel.findNode("episodeShellLayoutOptions")
        m.settingsControls.musicShellLayoutOptions = panel.findNode("musicShellLayoutOptions")
        m.settingsControls.themeMusicOptions = panel.findNode("themeMusicOptions")
        m.categoryControls[index] = [m.settingsControls.movieShellLayoutOptions, m.settingsControls.seriesShellLayoutOptions, m.settingsControls.episodeShellLayoutOptions, m.settingsControls.musicShellLayoutOptions, m.settingsControls.themeMusicOptions]
        m.mediaShellState = {
            layouts: [
                { control: m.settingsControls.movieShellLayoutOptions, key: SettingsStore.Key.MovieShellLayout, values: [MediaShellLayout.Mode.FullScreen, MediaShellLayout.Mode.PartialScreen, MediaShellLayout.Mode.Cinematic, MediaShellLayout.Mode.Poster] }
                { control: m.settingsControls.seriesShellLayoutOptions, key: SettingsStore.Key.TvSeriesShellLayout, values: [MediaShellLayout.Mode.FullScreen, MediaShellLayout.Mode.PartialScreen, MediaShellLayout.Mode.Poster] }
                { control: m.settingsControls.episodeShellLayoutOptions, key: SettingsStore.Key.TvEpisodeShellLayout, values: [MediaShellLayout.Mode.FullScreen, MediaShellLayout.Mode.PartialScreen, MediaShellLayout.Mode.Cinematic] }
                { control: m.settingsControls.musicShellLayoutOptions, key: SettingsStore.Key.MusicShellLayout, values: [MediaShellLayout.Mode.FullScreen, MediaShellLayout.Mode.PartialScreen] }
            ]
            returnTvControl: SettingsNavigation.MediaShellControl.Episode
            pages: {
                layouts: panel.findNode("mediaShellLayoutsPage")
                themeMusic: panel.findNode("mediaShellThemeMusicPage")
                up: panel.findNode("mediaShellPageUp")
                down: panel.findNode("mediaShellPageDown")
                number: panel.findNode("mediaShellPageNumber")
                fade: panel.findNode("mediaShellPageFade")
                index: SettingsNavigation.MediaShellPage.Layouts
            }
        }
    else if index = 2 then
        m.settingsControls.themeOptions = panel.findNode("themeOptions")
        m.settingsControls.showUnwatchedEpisodeCountOptions = panel.findNode("showUnwatchedEpisodeCountOptions")
        m.settingsControls.watchedIndicatorOptions = panel.findNode("watchedIndicatorOptions")
        m.categoryControls[index] = [m.settingsControls.themeOptions, m.settingsControls.watchedIndicatorOptions, m.settingsControls.showUnwatchedEpisodeCountOptions]
    else if index = 3 then
        m.settingsControls.nextItemPlaybackOptions = panel.findNode("nextItemPlaybackOptions")
        m.nextItemPlaybackCard = panel.findNode("nextItemPlaybackCard")
        m.categoryControls[index] = [m.settingsControls.nextItemPlaybackOptions]
    else if index = 4 then
        m.settingsControls.subtitleBurnInOptions = panel.findNode("subtitleBurnInOptions")
        m.subtitleBurnInCard = panel.findNode("subtitleBurnInCard")
        m.categoryControls[index] = []
        initAccountSubtitleReferences(panel)
    else if index = 5 then
        m.settingsControls.nextEpisodePromptSecondsOptions = panel.findNode("nextEpisodePromptSecondsOptions")
        m.categoryControls[index] = [m.settingsControls.nextEpisodePromptSecondsOptions]
    else if index = 6 then
        m.settingsControls.showSeasonSummaryCardOptions = panel.findNode("showSeasonSummaryCardOptions")
        m.settingsControls.homeEpisodeImagesOptions = panel.findNode("homeEpisodeImagesOptions")
        m.settingsControls.tvEpisodeListDisplayOptions = panel.findNode("tvEpisodeListDisplayOptions")
        m.categoryControls[index] = [m.settingsControls.tvEpisodeListDisplayOptions, m.settingsControls.showSeasonSummaryCardOptions, m.settingsControls.homeEpisodeImagesOptions]
    else if index = 7 then
        m.settingsControls.screensaverTypeOptions = panel.findNode("screensaverTypeOptions")
        m.settingsControls.screensaverDelayOptions = panel.findNode("screensaverDelayOptions")
        m.categoryControls[index] = [m.settingsControls.screensaverTypeOptions, m.settingsControls.screensaverDelayOptions]
    else if index = 8 then
        m.settingsControls.displayAccountBadgeOptions = panel.findNode("displayAccountBadgeOptions")
        m.settingsControls.tmdbApiKeyInput = panel.findNode("tmdbApiKeyInput")
        m.categoryControls[index] = [m.settingsControls.displayAccountBadgeOptions, m.settingsControls.tmdbApiKeyInput]
    else if index = 9 then
        m.settingsControls.videoStreamingModeOptions = panel.findNode("videoStreamingModeOptions")
        m.videoStreamingModeCard = panel.findNode("videoStreamingModeCard")
        m.categoryControls[index] = [m.settingsControls.videoStreamingModeOptions]
    else if index = 10 then
        m.settingsControls.resetStarfinButton = panel.findNode("resetStarfinButton")
        m.settingsControls.abortResetButton = panel.findNode("abortResetButton")
        m.settingsControls.eraseAllDataButton = panel.findNode("eraseAllDataButton")
        m.categoryControls[index] = [m.settingsControls.resetStarfinButton]
        m.resetStarfinState.description = panel.findNode("resetStarfinDescription")
        m.resetStarfinState.confirmationGroup = panel.findNode("resetConfirmation")
    end if
end sub

'-------------------------------------------------------------------------------
' initCategoryHandlers
'-------------------------------------------------------------------------------
sub initCategoryHandlers(index as integer)
    if index = 0 then
        m.settingsControls.librarySettingsGrid.observeField("selectionChanged", "onLibrarySelectionChanged")
        m.settingsControls.librarySettingsGrid.observeField("focusExitLeft", "onLibraryFocusExitLeft")
    else if index = 1 then
        m.settingsControls.themeMusicOptions.observeField("itemSelected", "onThemeMusicSelected")
        for each layout in m.mediaShellState.layouts
            layout.control.observeField("itemSelected", "onMediaShellLayoutSelected")
        end for
    else if index = 2 then
        m.settingsControls.showUnwatchedEpisodeCountOptions.observeField("itemSelected", "onUnwatchedEpisodeCountSelected")
        m.settingsControls.watchedIndicatorOptions.observeField("itemSelected", "onWatchedIndicatorSelected")
        m.settingsControls.themeOptions.observeField("itemSelected", "onThemeSelected")
    else if index = 3 then
        m.settingsControls.nextItemPlaybackOptions.observeField("itemSelected", "onNextItemPlaybackSelected")
        m.settingsControls.nextItemPlaybackOptions.observeField("itemFocused", "onNextItemPlaybackFocused")
    else if index = 4 then
        m.settingsControls.subtitleBurnInOptions.observeField("itemSelected", "onSubtitleBurnInSelected")
        m.settingsControls.subtitleBurnInOptions.observeField("itemFocused", "onSubtitleBurnInFocused")
        initAccountSubtitleHandlers()
    else if index = 5 then
        m.settingsControls.nextEpisodePromptSecondsOptions.observeField("itemSelected", "onNextEpisodePromptSecondsSelected")
    else if index = 6 then
        m.settingsControls.showSeasonSummaryCardOptions.observeField("itemSelected", "onShowSeasonSummaryCardSelected")
        m.settingsControls.homeEpisodeImagesOptions.observeField("itemSelected", "onHomeEpisodeImagesSelected")
        m.settingsControls.tvEpisodeListDisplayOptions.observeField("itemSelected", "onTVEpisodeListDisplaySelected")
    else if index = 7 then
        m.settingsControls.screensaverTypeOptions.observeField("itemSelected", "onScreensaverTypeSelected")
        m.settingsControls.screensaverDelayOptions.observeField("itemSelected", "onScreensaverDelaySelected")
    else if index = 8 then
        m.settingsControls.displayAccountBadgeOptions.observeField("itemSelected", "onDisplayAccountBadgeSelected")
    else if index = 9 then
        m.settingsControls.videoStreamingModeOptions.observeField("itemSelected", "onVideoStreamingModeSelected")
        m.settingsControls.videoStreamingModeOptions.observeField("itemFocused", "onVideoStreamingModeFocused")
    else if index = 10 then
        m.settingsControls.resetStarfinButton.observeField("buttonSelected", "onResetStarfinSelected")
        m.settingsControls.abortResetButton.observeField("buttonSelected", "onAbortResetSelected")
        m.settingsControls.eraseAllDataButton.observeField("buttonSelected", "onEraseAllDataSelected")
    end if
end sub

'-------------------------------------------------------------------------------
' applyCategoryValues
'-------------------------------------------------------------------------------
sub applyCategoryValues(index as integer)
    if index = 0 then
        m.settingsControls.librarySettingsGrid.selections = getLibrarySettingsValues()
    else if index = 1 then
        for each layout in m.mediaShellState.layouts
            value = SettingsStore.GetSettingValue(m.settingsState.values, layout.key)
            for optionIndex = 0 to layout.values.Count() - 1
                if layout.values[optionIndex] = value then layout.control.checkedItem = optionIndex
            end for
        end for
        setOnOffOption(m.settingsControls.themeMusicOptions, m.settingsState.values[SettingsStore.Key.ThemeMusic])
    else if index = 2 then
        setUnwatchedEpisodeCountOption(m.settingsState.values[SettingsStore.Key.ShowUnwatchedEpisodeCount])
        setWatchedIndicatorOption(m.settingsState.values[SettingsStore.Key.WatchedIndicatorStyle])
        setThemeOption(m.settingsState.values[SettingsStore.Key.Theme])
    else if index = 3 then
        setNextItemPlaybackOption(m.settingsState.values[SettingsStore.Key.NextItemPlayback])
    else if index = 4 then
        setSubtitleBurnInOption(m.settingsState.values[SettingsStore.Key.SubtitleBurnInMode])
    else if index = 5 then
        setNextEpisodePromptSecondsOption(m.settingsState.values[SettingsStore.Key.NextEpisodePromptSeconds])
    else if index = 6 then
        setOnOffOption(m.settingsControls.showSeasonSummaryCardOptions, m.settingsState.values[SettingsStore.Key.ShowSeasonSummaryCard])
        setHomeEpisodeImagesOption(m.settingsState.values[SettingsStore.Key.HomeEpisodeImages])
        setTVEpisodeListDisplayOption(m.settingsState.values[SettingsStore.Key.TvEpisodeListDisplay])
    else if index = 7 then
        setScreensaverTypeOption(m.settingsState.values[SettingsStore.Key.ScreensaverType])
        setScreensaverDelayOption(m.settingsState.values[SettingsStore.Key.ScreensaverDelay])
    else if index = 8 then
        setOnOffOption(m.settingsControls.displayAccountBadgeOptions, m.settingsState.values[SettingsStore.Key.DisplayAccountBadge])
        m.settingsControls.tmdbApiKeyInput.text = m.settingsState.values[SettingsStore.Key.TmdbApiKey]
    else if index = 9 then
        setVideoStreamingModeOption(m.settingsState.values[SettingsStore.Key.VideoStreamingMode])
    end if
end sub

'-------------------------------------------------------------------------------
' initCategoryList
'-------------------------------------------------------------------------------
sub initCategoryList()
    setOptionTitles(m.deviceCategoryList, m.categoryState.deviceTitles)
    setOptionTitles(m.userCategoryList, m.categoryState.userTitles)
end sub

'-------------------------------------------------------------------------------
' initCategoryOptions
'-------------------------------------------------------------------------------
sub initCategoryOptions(index as integer)
    if index = 0 then
        return
    else if index = 1 then
        for each layout in m.mediaShellState.layouts
            titles = []
            for each value in layout.values
                if value = MediaShellLayout.Mode.FullScreen then
                    titles.Push("Full backdrop")
                else if value = MediaShellLayout.Mode.PartialScreen then
                    titles.Push("Corner backdrop")
                else if value = MediaShellLayout.Mode.Cinematic then
                    titles.Push("Cinematic")
                else
                    titles.Push("Poster")
                end if
            end for
            setOptionTitles(layout.control, titles)
        end for
        setOptionTitles(m.settingsControls.themeMusicOptions, ["Off", "On"])
    else if index = 2 then
        setOptionTitles(m.settingsControls.showUnwatchedEpisodeCountOptions, ["Off", "Subtle", "High contrast"])
        setOptionTitles(m.settingsControls.watchedIndicatorOptions, ["Subtle", "High contrast"])
        setOptionTitles(m.settingsControls.themeOptions, ["Blue gradient", "Black gradient", "Grey gradient", "Pure Black"])
    else if index = 3 then
        setOptionTitles(m.settingsControls.nextItemPlaybackOptions, ["Show " + Char.DoubleQuote + "Up Next" + Char.DoubleQuote, "Play next immediately"])
    else if index = 4 then
        subtitleModeTitles = []
        for each option in AccountSubtitles.Modes()
            subtitleModeTitles.Push(option.title)
        end for
        setOptionTitles(m.accountUi.modes, subtitleModeTitles)
        setOptionTitles(m.settingsControls.subtitleBurnInOptions, ["During transcoding", "Prefer external subtitles", "Always burn in"])
    else if index = 5 then
        nextEpisodePromptSecondsTitles = []
        for each option in NextEpisodePromptSeconds.Options()
            nextEpisodePromptSecondsTitles.Push(option.title)
        end for
        setOptionTitles(m.settingsControls.nextEpisodePromptSecondsOptions, nextEpisodePromptSecondsTitles)
    else if index = 6 then
        setOptionTitles(m.settingsControls.showSeasonSummaryCardOptions, ["Off", "On"])
        setOptionTitles(m.settingsControls.homeEpisodeImagesOptions, ["Series artwork", "Episode thumbnail with logo", "Episode thumbnail without logo"])
        setOptionTitles(m.settingsControls.tvEpisodeListDisplayOptions, ["Horizontal", "Vertical"])
    else if index = 7 then
        setOptionTitles(m.settingsControls.screensaverTypeOptions, ["None", "Bouncing artwork", "Starfield"])
        setOptionTitles(m.settingsControls.screensaverDelayOptions, ["1 minute", "5 minutes", "15 minutes", "30 minutes"])
    else if index = 8 then
        setOptionTitles(m.settingsControls.displayAccountBadgeOptions, ["Off", "On"])
    else if index = 9 then
        setOptionTitles(m.settingsControls.videoStreamingModeOptions, ["Automatic", "Automatic (remux disabled)", "Force transcode (allow remux)", "Force transcode (remux disabled)"])
    end if
end sub

'-------------------------------------------------------------------------------
' setOptionTitles
'-------------------------------------------------------------------------------
sub setOptionTitles(options as object, titles as object)
    content = CreateObject("roSGNode", "ContentNode")
    for each title in titles
        content.createChild("ContentNode").title = title
    end for
    options.content = content
end sub

'-------------------------------------------------------------------------------
' loadSettingsValues
'-------------------------------------------------------------------------------
sub loadSettingsValues()
    m.settingsState.values = SettingsStore.Load(m.top.accountKey)
    m.settingsState.loaded = true
    for index = 0 to m.categoryPanels.Count() - 1
        if m.categoryPanels[index] <> invalid then applyCategoryValues(index)
    end for
end sub

'-------------------------------------------------------------------------------
' focusFirstField
'-------------------------------------------------------------------------------
sub focusFirstField()
    clearResetStarfinButtonFocus()
    if m.focusState.categoryIndex < m.categoryState.deviceOffset then
        m.userCategoryList.jumpToItem = m.focusState.categoryIndex
        m.userCategoryList.setFocus(true)
    else
        m.deviceCategoryList.jumpToItem = m.focusState.categoryIndex - m.categoryState.deviceOffset
        m.deviceCategoryList.setFocus(true)
    end if
    updateTextInputFocusVisual()
end sub

'-------------------------------------------------------------------------------
' captureEditorFocus
'-------------------------------------------------------------------------------
sub captureEditorFocus()
    target = m.top
    while target.focusedChild <> invalid
        child = target.focusedChild
        if child.isSameNode(target) then exit while
        target = child
    end while
    m.focusState.returnFocus = target
end sub

'-------------------------------------------------------------------------------
' restoreEditorFocus
'-------------------------------------------------------------------------------
sub restoreEditorFocus()
    target = m.focusState.returnFocus
    m.focusState.returnFocus = invalid
    if target <> invalid then
        if m.focusState.categoryIndex = SettingsNavigation.Category.MediaShell then
            pageIndex = (m.focusState.controlIndex = SettingsNavigation.MediaShellControl.ThemeMusic ? SettingsNavigation.MediaShellPage.ThemeMusic : SettingsNavigation.MediaShellPage.Layouts)
            showMediaShellPage(pageIndex)
        end if
        target.setFocus(true)
    else
        focusFirstField()
    end if
    updateAccountModeDescription()
end sub

'-------------------------------------------------------------------------------
' focusLastField
'-------------------------------------------------------------------------------
sub focusLastField()
    focusCategoryControl(m.categoryControls[m.focusState.categoryIndex].Count() - 1, invalid)
end sub

'-------------------------------------------------------------------------------
' canMoveFocusToButtons
'-------------------------------------------------------------------------------
function canMoveFocusToButtons() as boolean
    return false
end function

'-------------------------------------------------------------------------------
' onDeviceCategoryFocused
'-------------------------------------------------------------------------------
sub onDeviceCategoryFocused()
    showCategory(m.categoryState.deviceOffset + getListIndex(m.deviceCategoryList.itemFocused, m.categoryState.deviceCount))
end sub

'-------------------------------------------------------------------------------
' getLibrarySettingsValues
'-------------------------------------------------------------------------------
function getLibrarySettingsValues() as object
    values = {}
    for each key in SettingsStore.LibraryKeys()
        values[key] = SettingsStore.GetSettingValue(m.settingsState.values, key)
    end for
    return values
end function

'-------------------------------------------------------------------------------
' onDeviceCategorySelected
'-------------------------------------------------------------------------------
sub onDeviceCategorySelected()
    showCategory(m.categoryState.deviceOffset + getListIndex(m.deviceCategoryList.itemSelected, m.categoryState.deviceCount))
    focusCategoryControl(0, 0)
end sub

'-------------------------------------------------------------------------------
' onUserCategoryFocused
'-------------------------------------------------------------------------------
sub onUserCategoryFocused()
    showCategory(getListIndex(m.userCategoryList.itemFocused, m.categoryState.userCount))
end sub

'-------------------------------------------------------------------------------
' onUserCategorySelected
'-------------------------------------------------------------------------------
sub onUserCategorySelected()
    showCategory(getListIndex(m.userCategoryList.itemSelected, m.categoryState.userCount))
    focusCategoryControl(0, 0)
end sub

'-------------------------------------------------------------------------------
' showCategory
'-------------------------------------------------------------------------------
sub showCategory(index as integer)
    if index < 0 or index >= m.categoryPanels.Count() then return

    ensureCategoryPanel(index)
    m.focusState.categoryIndex = index
    m.focusState.controlIndex = 0
    if index < m.categoryState.userCount then
        m.top.categoryTitle = m.categoryState.userTitles[index]
    else
        m.top.categoryTitle = m.categoryState.deviceTitles[index - m.categoryState.deviceOffset]
    end if
    if index <> m.categoryState.resetIndex and m.resetStarfinState.confirmationVisible then showResetStarfinState()
    for i = 0 to m.categoryPanels.Count() - 1
        if m.categoryPanels[i] <> invalid then m.categoryPanels[i].visible = (i = index)
    end for
    if index = SettingsNavigation.Category.MediaShell then showMediaShellPage(SettingsNavigation.MediaShellPage.Layouts)
    if index = SettingsNavigation.Category.Subtitles then
        showSubtitlePage(SettingsNavigation.SubtitlePage.Account)
        m.top.accountSubtitleAction = { kind: AccountSubtitles.Action.Load }
    end if
end sub

'-------------------------------------------------------------------------------
' onKeyEvent
'-------------------------------------------------------------------------------
function onKeyEvent(key as string, press as boolean) as boolean
    if press = false then return false
    if handleAccountSubtitleKey(key) then return true

    if m.deviceCategoryList.isInFocusChain() or m.userCategoryList.isInFocusChain() then
        if key = Remote.Key.Up and m.userCategoryList.isInFocusChain() and getListIndex(m.userCategoryList.itemFocused, m.categoryState.userCount) = 0 then
            m.deviceCategoryList.jumpToItem = m.categoryState.deviceCount - 1
            m.deviceCategoryList.setFocus(true)
            showCategory(m.categoryState.deviceOffset + m.categoryState.deviceCount - 1)
            return true
        end if
        if key = Remote.Key.Down and m.deviceCategoryList.isInFocusChain() and getListIndex(m.deviceCategoryList.itemFocused, m.categoryState.deviceCount) = m.categoryState.deviceCount - 1 then
            m.userCategoryList.jumpToItem = 0
            m.userCategoryList.setFocus(true)
            showCategory(0)
            return true
        end if
        if key = Remote.Key.Down and m.userCategoryList.isInFocusChain() and getListIndex(m.userCategoryList.itemFocused, m.categoryState.userCount) = m.categoryState.lastUserIndex then
            m.deviceCategoryList.jumpToItem = 0
            m.deviceCategoryList.setFocus(true)
            showCategory(m.categoryState.deviceOffset)
            return true
        end if
        if key = Remote.Key.Up and m.deviceCategoryList.isInFocusChain() and getListIndex(m.deviceCategoryList.itemFocused, m.categoryState.deviceCount) = 0 then
            m.userCategoryList.jumpToItem = m.categoryState.lastUserIndex
            m.userCategoryList.setFocus(true)
            showCategory(m.categoryState.lastUserIndex)
            return true
        end if
        if key = Remote.Key.Right then return focusCategoryControl(0, 0)
        if key = Remote.Key.OK or key = Remote.Key.Select then return true
        return false
    end if

    if m.focusState.categoryIndex = SettingsNavigation.Category.MediaShell then return handleMediaShellKey(key)
    if m.focusState.categoryIndex = SettingsNavigation.Category.Theme then return handleThemeKey(key)

    if m.resetStarfinState.confirmationVisible then
        if key = Remote.Key.Right and m.settingsControls.abortResetButton.isInFocusChain() then return focusCategoryControl(1, invalid)
        if key = Remote.Key.Left and m.settingsControls.eraseAllDataButton.isInFocusChain() then return focusCategoryControl(0, invalid)
    end if

    if key = Remote.Key.Left then
        focusFirstField()
        return true
    end if

    if isTextInputFocused() then
        if key = Remote.Key.Up then return focusCategoryControl(m.focusState.controlIndex - 1, invalid)
        if key = Remote.Key.OK or key = Remote.Key.Select then
            openKeyboardDialog()
            return true
        end if
        return false
    end if

    focusedOptions = getFocusedRadioOptions()
    if key = Remote.Key.Down and isFocusedAtLastItem(focusedOptions) then
        return focusCategoryControl(m.focusState.controlIndex + 1, 0)
    end if
    if key = Remote.Key.Up and isFocusedAtFirstItem(focusedOptions) then
        return focusCategoryControl(m.focusState.controlIndex - 1, invalid)
    end if

    return false
end function

'-------------------------------------------------------------------------------
' onResetStarfinSelected
'-------------------------------------------------------------------------------
sub onResetStarfinSelected()
    m.resetStarfinState.confirmationVisible = true
    m.settingsControls.resetStarfinButton.visible = false
    m.resetStarfinState.description.visible = false
    m.resetStarfinState.confirmationGroup.visible = true
    m.categoryControls[m.categoryState.resetIndex] = [m.settingsControls.abortResetButton, m.settingsControls.eraseAllDataButton]
    focusCategoryControl(0, invalid)
end sub

'-------------------------------------------------------------------------------
' onAbortResetSelected
'-------------------------------------------------------------------------------
sub onAbortResetSelected()
    showResetStarfinState()
    focusCategoryControl(0, invalid)
end sub

'-------------------------------------------------------------------------------
' onEraseAllDataSelected
'-------------------------------------------------------------------------------
sub onEraseAllDataSelected()
    m.top.resetStarfinConfirmed = true
end sub

'-------------------------------------------------------------------------------
' showResetStarfinState
'-------------------------------------------------------------------------------
sub showResetStarfinState()
    m.resetStarfinState.confirmationVisible = false
    m.settingsControls.resetStarfinButton.visible = true
    m.resetStarfinState.description.visible = true
    m.resetStarfinState.confirmationGroup.visible = false
    m.categoryControls[m.categoryState.resetIndex] = [m.settingsControls.resetStarfinButton]
end sub

'-------------------------------------------------------------------------------
' focusCategoryControl
'-------------------------------------------------------------------------------
function focusCategoryControl(index as integer, itemIndex as dynamic) as boolean
    if m.focusState.categoryIndex = SettingsNavigation.Category.Subtitles then return focusAccountSubtitleControl(index)
    controls = m.categoryControls[m.focusState.categoryIndex]
    if index < 0 or index >= controls.Count() then return false

    node = controls[index]
    m.focusState.controlIndex = index
    if m.focusState.categoryIndex = SettingsNavigation.Category.MediaShell then
        pageIndex = (index = SettingsNavigation.MediaShellControl.ThemeMusic ? SettingsNavigation.MediaShellPage.ThemeMusic : SettingsNavigation.MediaShellPage.Layouts)
        showMediaShellPage(pageIndex)
    end if
    if node.subtype() = "LibrarySettingsGrid" then
        if itemIndex = invalid then
            node.callFunc("focusLast")
        else
            node.callFunc("focusFirst")
        end if
        updateTextInputFocusVisual()
        return true
    end if
    if itemIndex <> invalid and node.subtype() = "RadioButtonList" then node.jumpToItem = itemIndex
    clearResetStarfinButtonFocus()
    if node.subtype() = "PrimaryButton" then node.hasFocusVisual = true
    node.setFocus(true)
    updateTextInputFocusVisual()
    return true
end function

'-------------------------------------------------------------------------------
' getSettingsValues
'-------------------------------------------------------------------------------
function getSettingsValues() as object
    settings = {}
    for each key in SettingsStore.Defaults()
        settings[key] = SettingsStore.GetSettingValue(m.settingsState.values, key)
    end for
    return settings
end function

'-------------------------------------------------------------------------------
' onLibrarySelectionChanged
'-------------------------------------------------------------------------------
sub onLibrarySelectionChanged()
    change = m.settingsControls.librarySettingsGrid.selectionChanged
    if change = invalid then return
    key = change.settingKey
    if key = "" then return

    for each libraryKey in SettingsStore.LibraryKeys()
        if libraryKey = key then
            m.settingsState.values[key] = LibraryLayoutSetting.Normalize(change.value)
            return
        end if
    end for
end sub

'-------------------------------------------------------------------------------
' onNextItemPlaybackSelected
'-------------------------------------------------------------------------------
sub onNextItemPlaybackSelected()
    selectedIndex = getSelectedItemIndex(m.settingsControls.nextItemPlaybackOptions)
    if selectedIndex < 0 then return

    m.settingsControls.nextItemPlaybackOptions.checkedItem = selectedIndex
    if selectedIndex = 1 then
        m.settingsState.values[SettingsStore.Key.NextItemPlayback] = NextItemPlayback.Mode.PlayNextImmediately
    else
        m.settingsState.values[SettingsStore.Key.NextItemPlayback] = NextItemPlayback.Mode.ShowUpNext
    end if
end sub

