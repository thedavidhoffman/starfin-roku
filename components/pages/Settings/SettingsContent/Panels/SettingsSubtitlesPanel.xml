<?xml version="1.0" encoding="utf-8"?>
<component name="SettingsSubtitlesPanel" extends="Group">
  <children>
    <Group id="accountSubtitleEditor">
      <Group id="subtitlePageContent">
        <Group id="subtitleLocalPage" visible="false">
          <SettingsCard id="subtitleBurnInCard" title="Subtitle burn-in" cardHeight="384" descriptionTop="252" descriptionHeight="120">
            <RadioButtonList id="subtitleBurnInOptions" translation="[0,64]" itemSize="[0,52]" numRows="3" checkedItem="0" vertFocusAnimationStyle="floatingFocus" fadeFocusFeedbackWhenAutoScrolling="false" focusFootprintBitmapUri="pkg:/images/focus/transparent_focus_footprint.9.png" />
          </SettingsCard>
        </Group>
        <Group id="subtitleAccountPage">
          <Label text="Saved to your Jellyfin account when you close Settings." translation="[3,0]" width="1154" height="40" font="font:SmallestBoldSystemFont" color="0xB7C5D4FF" />
          <Group id="accountSubtitleFields" visible="false">
            <SettingsCard id="accountSubtitleModeCard" translation="[0,60]" title="Subtitle mode" cardHeight="376" descriptionTop="330">
              <RadioButtonList id="accountSubtitleModes" translation="[0,64]" itemSize="[0,44]" numRows="5" checkedItem="0" vertFocusAnimationStyle="floatingFocus" fadeFocusFeedbackWhenAutoScrolling="false" focusFootprintBitmapUri="pkg:/images/focus/transparent_focus_footprint.9.png" />
            </SettingsCard>
            <SettingsCard id="accountSubtitleLanguageCard" translation="[0,454]" title="Preferred language" cardHeight="128" headingY="19">
              <PrimaryButton id="accountSubtitleLanguage" translation="[24,59]" buttonWidth="120" text="Edit" />
              <Label id="accountSubtitleCurrentLanguage" translation="[168,59]" width="968" height="56" vertAlign="center" text="Any language" font="font:MediumSystemFont" />
            </SettingsCard>
          </Group>
          <Group id="accountSubtitleFailure" translation="[0,60]" visible="false">
            <Label text="Unable to load Jellyfin subtitle settings." width="1120" height="60" font="font:SmallSystemFont" />
            <PrimaryButton id="accountSubtitleRetry" translation="[0,84]" buttonWidth="220" text="Retry" />
          </Group>

        </Group>
      </Group>
      <Label id="subtitlePageHint" translation="[24,616]" width="976" height="40" horizAlign="right" vertAlign="center" font="font:SmallestSystemFont" color="0xB7C5D4FF" text="Additional settings" />
      <Poster id="subtitlePageUp" translation="[1120,624]" width="24" height="24" uri="pkg:/images/icons/chevrons/up.png" visible="false" />
      <Label id="subtitlePageNumber" translation="[1024,616]" width="88" height="40" horizAlign="center" vertAlign="center" text="1 / 2" font="font:SmallestSystemFont" color="0xB7C5D4FF" />
      <Poster id="subtitlePageDown" translation="[1120,624]" width="24" height="24" uri="pkg:/images/icons/chevrons/down.png" />
      <Animation id="subtitlePageFade" duration="0.14" easeFunction="linear">
        <FloatFieldInterpolator key="[0,1]" keyValue="[0.7,1]" fieldToInterp="subtitlePageContent.opacity" />
      </Animation>
    </Group>
    <Group id="accountSubtitlePicker" visible="false">
      <SettingsCard id="accountSubtitleLanguagePickerCard" title="Preferred subtitle language" cardHeight="664" descriptionTop="612" description="OK selects a language. Back keeps the previous selection.">
        <RadioButtonList id="accountSubtitleLanguages" translation="[0,64]" itemSize="[0,52]" numRows="10" vertFocusAnimationStyle="floatingFocus" fadeFocusFeedbackWhenAutoScrolling="false" focusFootprintBitmapUri="pkg:/images/focus/transparent_focus_footprint.9.png" />
      </SettingsCard>
    </Group>
    <Spinner id="accountSubtitleSpinner" scale="[0.6041667,0.62]" />
  </children>
</component>
