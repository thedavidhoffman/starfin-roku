<?xml version="1.0" encoding="utf-8"?>
<component name="SettingsAdvancedPanel" extends="Group">
  <children>
    <SettingsCard id="resetStarfinCard" title="Reset application data" cardHeight="320">
      <PrimaryButton id="resetStarfinButton" translation="[24,64]" buttonWidth="300" buttonHeight="56" text="Reset Starfin" />
      <Label id="resetStarfinDescription" translation="[24,144]" width="1112" height="152" wrap="true" numLines="8" color="0xB7C5D4FF" font="font:SmallestSystemFont" text="Deletes all settings, saved accounts, and locally stored Starfin application data from this Roku device. Every saved user will be removed and any authenticated users will be logged out." />
      <Group id="resetConfirmation" translation="[24,64]" visible="false">
        <PrimaryButton id="abortResetButton" buttonWidth="180" buttonHeight="56" text="Abort" />
        <PrimaryButton id="eraseAllDataButton" translation="[204,0]" buttonWidth="280" buttonHeight="56" text="Erase all data" />
        <Label translation="[0,80]" width="1112" height="152" wrap="true" numLines="8" color="0xFFEB3BFF" font="font:SmallBoldSystemFont" text="Please confirm this action. It will permanently erase all Starfin settings and locally stored application data from this Roku device, remove every saved user, and log out all authenticated users. This cannot be undone." />
      </Group>
    </SettingsCard>
  </children>
</component>
