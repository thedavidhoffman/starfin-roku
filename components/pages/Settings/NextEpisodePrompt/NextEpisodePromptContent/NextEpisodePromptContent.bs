import "pkg:/source/NextEpisodePromptSeconds.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.options = m.top.findNode("promptOptions")
    m.options.observeField("itemSelected", "onOptionSelected")
end sub

'-------------------------------------------------------------------------------
' configure
'-------------------------------------------------------------------------------
sub configure(value as dynamic)
    content = CreateObject("roSGNode", "ContentNode")
    selectedIndex = 0
    options = NextEpisodePromptSeconds.Options()
    for index = 0 to options.Count() - 1
        content.createChild("ContentNode").title = options[index].title
        if options[index].value = NextEpisodePromptSeconds.Normalize(value) then selectedIndex = index
    end for
    m.options.content = content
    m.options.checkedItem = selectedIndex
    m.options.jumpToItem = selectedIndex
end sub

'-------------------------------------------------------------------------------
' focusOptions
'-------------------------------------------------------------------------------
sub focusOptions()
    m.options.setFocus(true)
end sub

'-------------------------------------------------------------------------------
' onOptionSelected
'-------------------------------------------------------------------------------
sub onOptionSelected()
    index = m.options.itemSelected
    options = NextEpisodePromptSeconds.Options()
    if index < 0 or index >= options.Count() then return
    m.options.checkedItem = index
    m.top.selectedValue = options[index].value
end sub
