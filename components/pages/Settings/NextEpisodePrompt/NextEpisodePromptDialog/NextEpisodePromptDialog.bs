'-------------------------------------------------------------------------------
' openPicker
'-------------------------------------------------------------------------------
sub openPicker()
    m.top.title = "Show next episode prompt"
    m.top.dialogWidth = 900
    m.top.dialogHeight = 760
    m.top.closeOnContentSelected = false
    m.top.selectedValue = ""
    m.top.contentComponentName = "NextEpisodePromptContent"
    content = m.top.callFunc("getContentComponent")
    content.callFunc("configure", m.top.value)
    content.observeField("selectedValue", "onPromptSelected")
    m.top.callFunc("openDialog")
end sub

'-------------------------------------------------------------------------------
' focusContent
'-------------------------------------------------------------------------------
function focusContent() as boolean
    content = m.top.callFunc("getContentComponent")
    content.callFunc("focusOptions")
    return true
end function

'-------------------------------------------------------------------------------
' onPromptSelected
'-------------------------------------------------------------------------------
sub onPromptSelected()
    content = m.top.callFunc("getContentComponent")
    m.top.selectedValue = content.selectedValue
    m.top.callFunc("closeDialog")
end sub
