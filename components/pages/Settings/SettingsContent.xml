<?xml version="1.0" encoding="utf-8"?>
<component name="SettingsContent" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/source/store/SettingsStore.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/Settings/SettingsContent.brs" />
  <interface>
    <function name="focusFirstField" />
    <function name="focusLastField" />
    <function name="getSettingsValues" />
    <function name="loadSettingsValues" />
    <function name="canMoveFocusToButtons" />
  </interface>
  <children>

    <!-- view library as -->
    <Label
      id="displayLabel"
      translation="[40,0]"
      text="View Library As"
      width="380"
      height="36"
      font="font:MediumBoldSystemFont" />
    <RadioButtonList
      id="displayOptions"
      translation="[40,48]"
      itemSize="[380,48]"
      numRows="2"
      checkedItem="0"
      vertFocusAnimationStyle="floatingFocus"
      fadeFocusFeedbackWhenAutoScrolling="false"
      focusFootprintBitmapUri="pkg:/images/focus/transparent_focus_footprint.9.png" />

    <!-- grid columns -->
    <Label
      id="gridColumnsLabel"
      translation="[1020,0]"
      text="Grid Columns"
      width="380"
      height="36"
      font="font:MediumBoldSystemFont" />
    <RadioButtonList
      id="gridColumnsOptions"
      translation="[1020,48]"
      itemSize="[380,48]"
      numRows="3"
      checkedItem="2"
      vertFocusAnimationStyle="floatingFocus"
      fadeFocusFeedbackWhenAutoScrolling="false"
      focusFootprintBitmapUri="pkg:/images/focus/transparent_focus_footprint.9.png" />

    <!-- series display -->
    <Label
      id="seriesLabel"
      translation="[530,0]"
      text="Collapse Series"
      width="380"
      height="36"
      font="font:MediumBoldSystemFont" />
    <RadioButtonList
      id="seriesOptions"
      translation="[530,48]"
      itemSize="[380,48]"
      numRows="2"
      checkedItem="0"
      vertFocusAnimationStyle="floatingFocus"
      fadeFocusFeedbackWhenAutoScrolling="false"
      focusFootprintBitmapUri="pkg:/images/focus/transparent_focus_footprint.9.png" />

    <!-- screensaver type -->
    <Label
      id="screensaverTypeLabel"
      translation="[40,220]"
      text="Screensaver"
      width="380"
      height="36"
      font="font:MediumBoldSystemFont" />
    <RadioButtonList
      id="screensaverTypeOptions"
      translation="[40,268]"
      itemSize="[380,48]"
      numRows="3"
      checkedItem="0"
      vertFocusAnimationStyle="floatingFocus"
      fadeFocusFeedbackWhenAutoScrolling="false"
      focusFootprintBitmapUri="pkg:/images/focus/transparent_focus_footprint.9.png" />

    <!-- screensaver delay -->
    <Label
      id="screensaverDelayLabel"
      translation="[530,220]"
      text="Start screensaver after"
      width="400"
      height="36"
      font="font:MediumBoldSystemFont" />
    <RadioButtonList
      id="screensaverDelayOptions"
      translation="[530,268]"
      itemSize="[380,48]"
      numRows="4"
      checkedItem="0"
      vertFocusAnimationStyle="floatingFocus"
      fadeFocusFeedbackWhenAutoScrolling="false"
      focusFootprintBitmapUri="pkg:/images/focus/transparent_focus_footprint.9.png" />

    <!-- screensaver note -->
    <Label
      id="screensaverNoteLabel"
      translation="[40,500]"
      text="ABSTV’s in-app screensaver only runs during audiobook playback. While a title is playing, ABSTV disables any configured Roku screensaver and uses its own screensaver instead."
      width="1360"
      height="150"
      wrap="true"
      numLines="3"
      color="0xB7C5D4FF"
      font="font:SmallestSystemFont" />
  </children>
</component>
