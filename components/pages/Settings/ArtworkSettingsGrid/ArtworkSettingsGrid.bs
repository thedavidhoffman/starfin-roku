import "pkg:/source/Format.bs"
import "pkg:/source/Number.bs"
import "pkg:/source/String.bs"
import "pkg:/source/PlaybackMode.bs"
import "pkg:/source/SubtitleBurnIn.bs"
import "pkg:/source/store/RegistryStore.bs"
import "pkg:/source/store/SettingsStore.bs"
import "pkg:/source/VideoCardPresentation.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.libraryLabels = m.top.findNode("artworkLibraryLabels")
    m.optionLists = [
        m.top.findNode("posterOptions")
        m.top.findNode("thumbnailOptions")
        m.top.findNode("jumboOptions")
        m.top.findNode("detailedOptions")
    ]
    m.artworkValues = [
        VideoCardPresentation.Type.Poster
        VideoCardPresentation.Type.Thumbnail
        VideoCardPresentation.Type.Jumbo
        VideoCardPresentation.Type.Detailed
    ]
    m.rows = [
        { title: "TV", settingKey: SettingsStore.Key.TvLibraryDisplay }
        { title: "Movie", settingKey: SettingsStore.Key.MovieLibraryDisplay }
        { title: "Collection Cards", settingKey: SettingsStore.Key.CollectionCardsImageType }
        { title: "Collection Items", settingKey: SettingsStore.Key.CollectionItemsImageType }
        { title: "Playlist Cards", settingKey: SettingsStore.Key.PlaylistCardsImageType }
        { title: "Playlist Items", settingKey: SettingsStore.Key.PlaylistItemsImageType }
        { title: "Music Videos", settingKey: SettingsStore.Key.MusicVideosImageType }
        { title: "Home Videos", settingKey: SettingsStore.Key.HomeVideosImageType }
    ]
    m.isSyncing = false

    initializeContent()
    initializeHandlers()
    onSelectionsChanged()
end sub

'-------------------------------------------------------------------------------
' initializeContent
'-------------------------------------------------------------------------------
sub initializeContent()
    labelsContent = CreateObject("roSGNode", "ContentNode")
    for each row in m.rows
        label = labelsContent.createChild("ContentNode")
        label.title = row.title
    end for
    m.libraryLabels.content = labelsContent
    for each options in m.optionLists
        optionContent = CreateObject("roSGNode", "ContentNode")
        for each row in m.rows
            option = optionContent.createChild("ContentNode")
            option.title = ""
        end for
        options.content = optionContent
    end for
end sub

'-------------------------------------------------------------------------------
' initializeHandlers
'-------------------------------------------------------------------------------
sub initializeHandlers()
    m.optionLists[0].observeField("itemSelected", "onPosterSelected")
    m.optionLists[1].observeField("itemSelected", "onThumbnailSelected")
    m.optionLists[2].observeField("itemSelected", "onJumboSelected")
    m.optionLists[3].observeField("itemSelected", "onDetailedSelected")
end sub

'-------------------------------------------------------------------------------
' onSelectionsChanged
'-------------------------------------------------------------------------------
sub onSelectionsChanged()
    selections = m.top.selections
    if selections = invalid then selections = {}

    checkedStates = [[], [], [], []]
    for each row in m.rows
        selectedValue = VideoCardPresentation.Normalize(selections[row.settingKey])
        selectedColumn = getArtworkColumnIndex(selectedValue)
        for columnIndex = 0 to checkedStates.Count() - 1
            checkedStates[columnIndex].Push(columnIndex = selectedColumn)
        end for
    end for

    m.isSyncing = true
    for columnIndex = 0 to m.optionLists.Count() - 1
        m.optionLists[columnIndex].checkedState = checkedStates[columnIndex]
    end for
    m.isSyncing = false
end sub

'-------------------------------------------------------------------------------
' getArtworkColumnIndex
'-------------------------------------------------------------------------------
function getArtworkColumnIndex(value as string) as integer
    for i = 0 to m.artworkValues.Count() - 1
        if m.artworkValues[i] = value then return i
    end for
    return 0
end function

'-------------------------------------------------------------------------------
' onPosterSelected
'-------------------------------------------------------------------------------
sub onPosterSelected()
    commitSelection(0)
end sub

'-------------------------------------------------------------------------------
' onThumbnailSelected
'-------------------------------------------------------------------------------
sub onThumbnailSelected()
    commitSelection(1)
end sub

'-------------------------------------------------------------------------------
' onJumboSelected
'-------------------------------------------------------------------------------
sub onJumboSelected()
    commitSelection(2)
end sub

'-------------------------------------------------------------------------------
' onDetailedSelected
'-------------------------------------------------------------------------------
sub onDetailedSelected()
    commitSelection(3)
end sub

'-------------------------------------------------------------------------------
' commitSelection
'-------------------------------------------------------------------------------
sub commitSelection(columnIndex as integer)
    if m.isSyncing then return
    rowIndex = Number.ToInteger(m.optionLists[columnIndex].itemSelected, -1)
    if rowIndex < 0 or rowIndex >= m.rows.Count() then return

    selections = {}
    if m.top.selections <> invalid then
        for each key in m.top.selections
            selections[key] = m.top.selections[key]
        end for
    end if
    row = m.rows[rowIndex]
    value = m.artworkValues[columnIndex]
    selections[row.settingKey] = value
    m.top.selections = selections
    m.top.selectionChanged = {
        settingKey: row.settingKey
        value: value
    }
end sub

'-------------------------------------------------------------------------------
' focusFirst
'-------------------------------------------------------------------------------
sub focusFirst()
    focusColumn(0, 0)
end sub

'-------------------------------------------------------------------------------
' focusLast
'-------------------------------------------------------------------------------
sub focusLast()
    focusColumn(m.optionLists.Count() - 1, m.rows.Count() - 1)
end sub

'-------------------------------------------------------------------------------
' focusColumn
'-------------------------------------------------------------------------------
sub focusColumn(columnIndex as integer, rowIndex as integer)
    if columnIndex < 0 or columnIndex >= m.optionLists.Count() then return
    options = m.optionLists[columnIndex]
    options.jumpToItem = rowIndex
    options.setFocus(true)
end sub

'-------------------------------------------------------------------------------
' getFocusedColumnIndex
'-------------------------------------------------------------------------------
function getFocusedColumnIndex() as integer
    for i = 0 to m.optionLists.Count() - 1
        if m.optionLists[i].isInFocusChain() then return i
    end for
    return -1
end function

'-------------------------------------------------------------------------------
' onKeyEvent
'-------------------------------------------------------------------------------
function onKeyEvent(key as string, press as boolean) as boolean
    if press = false then return false
    columnIndex = getFocusedColumnIndex()
    if columnIndex < 0 then return false

    if key = "left" then
        if columnIndex = 0 then
            m.top.focusExitLeft = true
        else
            focusColumn(columnIndex - 1, Number.ToInteger(m.optionLists[columnIndex].itemFocused, 0))
        end if
        return true
    end if
    if key = "right" then
        if columnIndex < m.optionLists.Count() - 1 then
            focusColumn(columnIndex + 1, Number.ToInteger(m.optionLists[columnIndex].itemFocused, 0))
        end if
        return true
    end if

    return false
end function
