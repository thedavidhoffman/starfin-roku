import "pkg:/source/store/SettingsStore.bs"
import "pkg:/source/AccountSubtitles.bs"
import "pkg:/source/SettingsClose.bs"

'-------------------------------------------------------------------------------
' openSettings
'-------------------------------------------------------------------------------
sub openSettings()
    resetAccountState()
    m.originalSettings = invalid
    m.top.title = "Settings"
    m.top.dialogWidth = 1680
    m.top.dialogHeight = 900
    m.top.closeOnContentSelected = false
    m.top.contentComponentName = "SettingsContent"

    content = getSettingsContent()
    if content <> invalid then
        content.accountKey = m.top.accountKey
        content.observeField("resetStarfinConfirmed", "onResetStarfinConfirmed")
        content.observeField("watchedIndicatorPreviewRequested", "onWatchedIndicatorPreviewRequested")
        content.observeField("themePreviewRequested", "onThemePreviewRequested")
        content.observeField("accountSubtitleAction", "onAccountSubtitleAction")
        content.callFunc("loadSettingsValues")
        m.originalSettings = content.callFunc("getSettingsValues")
    end if
    m.top.callFunc("openDialog")
    if content <> invalid then content.callFunc("focusFirstField")
    publishAccountState()
end sub

'-------------------------------------------------------------------------------
' getSettingsContent
'-------------------------------------------------------------------------------
function getSettingsContent() as object
    return m.top.callFunc("getContentComponent")
end function

'-------------------------------------------------------------------------------
' onResetStarfinConfirmed
'-------------------------------------------------------------------------------
sub onResetStarfinConfirmed()
    m.top.resetStarfinConfirmed = true
    finishSettingsClose()
end sub

'-------------------------------------------------------------------------------
' saveSettings
'-------------------------------------------------------------------------------
sub saveSettings()
    content = getSettingsContent()
    if content = invalid then return

    settings = content.callFunc("getSettingsValues")
    if settings = invalid then return
    if SettingsStore.AreEqual(settings, m.originalSettings) then return

    SettingsStore.Save(m.top.accountKey, settings)
    m.top.savedSettings = settings
    m.top.settingsSaved = true
end sub

'-------------------------------------------------------------------------------
' onCloseRequested
'-------------------------------------------------------------------------------
sub onCloseRequested()
    saveSettings()
end sub

'-------------------------------------------------------------------------------
' onThemePreviewRequested
'-------------------------------------------------------------------------------
sub onThemePreviewRequested()
    content = getSettingsContent()
    m.top.themePreviewRequested = content.themePreviewRequested
end sub

'-------------------------------------------------------------------------------
' onWatchedIndicatorPreviewRequested
'-------------------------------------------------------------------------------
sub onWatchedIndicatorPreviewRequested()
    content = getSettingsContent()
    m.top.watchedIndicatorPreviewRequested = content.watchedIndicatorPreviewRequested
end sub

'-------------------------------------------------------------------------------
' closeDialog
'-------------------------------------------------------------------------------
sub closeDialog()
    if m.closeState.phase <> SettingsClose.Phase.Open then return
    if m.accountState.original <> invalid and m.accountState.pending <> invalid then
        if AccountSubtitles.Changes(m.accountState.original, m.accountState.pending).Count() > 0 then
            content = getSettingsContent()
            content.callFunc("captureEditorFocus")
            m.closeState.phase = SettingsClose.Phase.Saving
            startAccountRequest(AccountSubtitles.Command.Save)
            return
        end if
    end if
    finishSettingsClose()
end sub

'-------------------------------------------------------------------------------
' finishSettingsClose
'-------------------------------------------------------------------------------
sub finishSettingsClose()
    if m.closeState.phase = SettingsClose.Phase.Closed then return
    deactivateAccountSession()
    m.dialog.visible = false
    onCloseRequested()
    m.top.closeRequested = true
end sub
