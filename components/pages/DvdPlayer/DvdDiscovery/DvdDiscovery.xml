<?xml version="1.0" encoding="utf-8"?>
<component name="DvdDiscovery" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/pages/DvdPlayer/DvdDiscovery/DvdDiscovery.bs" />
  <interface>
    <field id="presentation" type="assocarray" alwaysNotify="true" />
    <field id="available" type="boolean" value="false" />
    <field id="status" type="string" value="unknown" />
    <field id="version" type="string" />
    <field id="authenticationRequired" type="assocarray" alwaysNotify="true" />
    <field id="accessDenied" type="assocarray" alwaysNotify="true" />
    <function name="discover" />
    <function name="reset" />
  </interface>
</component>
