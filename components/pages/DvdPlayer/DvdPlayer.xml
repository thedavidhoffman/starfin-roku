<?xml version="1.0" encoding="utf-8"?>
<component name="DvdPlayer" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/components/pages/DvdPlayer/DvdPlayer.bs" />
  <interface>
    <field id="loadRequest" type="assocarray" />
    <field id="closeRequested" type="boolean" alwaysNotify="true" />
    <field id="authenticationRequired" type="assocarray" alwaysNotify="true" />
    <field id="cleanupCompletion" type="node" />
    <field id="taskCreated" type="node" alwaysNotify="true" />
    <field id="overlayRequested" type="assocarray" alwaysNotify="true" />
    <function name="handleResumeClosed" />
    <function name="handleFilterClosed" />
    <function name="activate" />
    <function name="deactivate" />
  </interface>
  <children>
    <Rectangle width="1920" height="1080" color="0x000000FF" />
    <Group id="menuHost" />
    <Group id="contentHost" visible="false">
      <Rectangle width="1920" height="1080" color="0x000000FF" />
    </Group>
    <Rectangle id="menuStartupCover" width="1920" height="1080" color="0x000000FF" visible="false" />
    <Group id="startupArtwork" visible="false">
      <Rectangle width="1920" height="1080" color="0x000000FF" />
    </Group>
    <Label id="status" translation="[160,440]" width="1600" height="200" wrap="true" horizAlign="center" color="0xFFFFFFFF" />
    <Group id="filterHint" translation="[520,960]" visible="false">
      <Rectangle width="880" height="64" color="0x07182BD9" />
      <Label translation="[20,0]" width="840" height="64" text="Press Play/Pause for playback filters." font="font:SmallSystemFont" color="0xFFFFFFFF" horizAlign="center" vertAlign="center" />
    </Group>
    <Timer id="filterHintTimer" duration="5" repeat="false" />
    <Animation id="filterHintFade" duration="0.4" easeFunction="linear">
      <FloatFieldInterpolator key="[0,1]" keyValue="[1,0]" fieldToInterp="filterHint.opacity" />
    </Animation>
    <DvdPlaybackControls id="playbackControls" visible="false" />
    <Timer id="filterCapabilityTimer" duration="2" repeat="false" />
    <Timer id="controlsHideTimer" duration="5" repeat="false" />
    <Spinner id="loading" showDelay="0" />
    <Spinner id="filterChangeSpinner" showDelay="0" blockInteraction="true" cancelEnabled="true" />
  </children>
</component>
