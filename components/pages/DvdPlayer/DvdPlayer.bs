import "pkg:/components/pages/DvdPlayer/Helpers/Lifecycle.bs"
import "pkg:/components/pages/DvdPlayer/Helpers/MenuNavigation.bs"
import "pkg:/components/pages/DvdPlayer/Helpers/MenuPreview.bs"
import "pkg:/components/pages/DvdPlayer/Helpers/Presentation.bs"
import "pkg:/components/pages/DvdPlayer/Helpers/StartupArtwork.bs"
import "pkg:/components/pages/DvdPlayer/Helpers/Resume.bs"
import "pkg:/components/pages/DvdPlayer/Helpers/Filters.bs"
import "pkg:/source/Number.bs"
import "pkg:/source/Logger.bs"
import "pkg:/source/String.bs"
import "pkg:/source/Remote.bs"
import "pkg:/source/TaskControl.bs"
import "pkg:/source/SpinnerControl.bs"
import "pkg:/source/MediaControl.bs"
import "pkg:/source/VideoPlayerState.bs"
import "pkg:/source/TimerControl.bs"
import "pkg:/source/api/JellyfinAuth.bs"
import "pkg:/components/pages/DvdPlayer/Helpers/SessionContracts.bs"
import "pkg:/components/pages/DvdPlayer/Helpers/Rendering.bs"
import "pkg:/components/pages/DvdPlayer/Helpers/Playback.bs"
import "pkg:/components/pages/DvdPlayer/Helpers/TransportControls.bs"
import "pkg:/components/pages/DvdPlayer/Helpers/Timeline.bs"
import "pkg:/components/pages/DvdPlayer/Helpers/Paths.bs"
import "pkg:/components/pages/DvdPlayer/Helpers/MenuModel.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.log = new Logger("DvdPlayer", m.global.logService)
    initReferences()
    m.session = invalid
    m.loading = { active: false, generation: 0, task: invalid, failed: false }
    m.native = { task: invalid, requestId: "", revision: -1, state: "", snapshot: invalid, queue: [], inFlight: invalid, navigating: false }
    m.menu = { manifest: invalid, focused: 0 }
    m.rendering = { root: invalid, retainedRoot: invalid, hotspots: invalid, sources: invalid, previewStarted: false, waitingForReveal: false, backgroundReady: false, image: invalid, video: invalid, timer: invalid, buttons: {}, geometry: [], asset: invalid, preview: invalid, previewHost: invalid, previewFailures: {}, rect: invalid }
    m.playback = { active: false, startupClock: invalid, video: invalid, timer: invalid, id: "", started: false, completed: false, pauseRequested: false, buffering: false, progress: 0 }
    m.resume = { requestId: "", mode: DvdSession.StartMode.Normal, prompting: false, closing: false }
    m.highlights = { identity: "", descriptor: invalid, root: invalid, clip: invalid, poster: invalid, timer: invalid, waitExpired: false, state: DvdHighlight.State.Selected }
    m.transport = { title: "", year: "" }
    m.presentation = { loading: false, spinnerRunning: false, filterHint: { shown: false, elapsed: invalid } }
    m.timeline = { diagnosticKey: "" }
    m.startupArtwork = { host: m.top.findNode("startupArtwork"), mask: invalid, poster: invalid }
    initFilters()
    initHandlers()
    onLoadRequestChanged()
end sub

'-------------------------------------------------------------------------------
' initReferences
'-------------------------------------------------------------------------------
sub initReferences()
    m.nodes = { menuStartupCover: m.top.findNode("menuStartupCover"), host: m.top.findNode("menuHost"), status: m.top.findNode("status"), spinner: m.top.findNode("loading"), contentHost: m.top.findNode("contentHost"), controls: m.top.findNode("playbackControls"), filterHint: m.top.findNode("filterHint"), filterHintTimer: m.top.findNode("filterHintTimer"), filterHintFade: m.top.findNode("filterHintFade"), controlsTimer: m.top.findNode("controlsHideTimer"), filterTimer: m.top.findNode("filterCapabilityTimer"), filterSpinner: m.top.findNode("filterChangeSpinner") }
end sub

'-------------------------------------------------------------------------------
' initHandlers
'-------------------------------------------------------------------------------
sub initHandlers()
    m.top.observeField("loadRequest", "onLoadRequestChanged")
    m.nodes.controls.observeField("playPausePressed", "toggleContentPause")
    m.nodes.controls.observeField("filterPressed", "openFilterPicker")
    m.nodes.controls.observeField("interaction", "restartControlsTimer")
    m.nodes.controlsTimer.observeField("fire", "onControlsTimeout")
    m.nodes.filterHintTimer.observeField("fire", "onFilterHintTimeout")
end sub

'-------------------------------------------------------------------------------
' onLoadRequestChanged
'-------------------------------------------------------------------------------
sub onLoadRequestChanged()
    if m.top.loadRequest = invalid then return
    m.session = m.top.loadRequest
    if m.loading.active then beginLoad()
end sub

'-------------------------------------------------------------------------------
' activate
'-------------------------------------------------------------------------------
sub activate()
    wasActive = m.loading.active
    m.loading.active = true
    m.top.visible = true
    if not wasActive then
        disc = m.session.demo
        if disc.userData <> invalid and disc.userData.resume <> invalid then
            promptResume(false)
        else
            beginLoad()
        end if
    else if m.nodes.controls.visible then
        restorePlayerFocus()
    else if m.native.state = DvdSession.State.Menu then
        focusButton(m.menu.focused)
    else
        if not m.filters.open then restorePlayerFocus()
    end if
end sub

'-------------------------------------------------------------------------------
' beginLoad
'-------------------------------------------------------------------------------
sub beginLoad()
    releaseSessionResources()
    beginStartupArtwork()
    m.loading.generation++
    m.loading.failed = false
    requestFilters(DvdFilter.Request.Catalog)
    m.native.revision = -1
    m.native.state = ""
    m.native.snapshot = invalid
    m.native.navigating = false
    m.nodes.status.text = ""
    m.nodes.host.visible = true
    m.nodes.contentHost.visible = false
    m.presentation.loading = true
    restorePlayerFocus()
    task = m.top.createChild("DvdDemoTask")
    m.loading.task = task
    request = {}
    request.Append(m.session)
    request.requestId = m.loading.generation
    task.request = request
    task.observeField("response", "onDemoResponse")
    m.top.taskCreated = task
    task.control = TaskControl.Command.Run
    reconcilePlayerPresentation()
end sub

'-------------------------------------------------------------------------------
' onDemoResponse
'-------------------------------------------------------------------------------
sub onDemoResponse(event as object)
    if not m.loading.active or m.loading.task = invalid then return
    if not event.getRoSGNode().isSameNode(m.loading.task) then return
    response = event.getData()
    if response.requestId <> m.loading.generation then return
    releaseTask()
    if response.ok <> true then
        showFailure(Strings.ToString(response.errorMessage, "Unable to load the DVD."))
        return
    end if
    m.menu.manifest = response.payload
    updateControlsMetadata()
    m.native.requestId = CreateObject("roDeviceInfo").GetRandomUUID()
    task = m.top.createChild("DvdSessionTask")
    m.native.task = task
    completion = CreateObject("roSGNode", "Node")
    completion.addFields({ completed: false })
    m.top.cleanupCompletion = completion
    task.cleanupCompletion = completion
    task.request = { server: m.session.server, token: m.session.token, userId: m.session.userId, requestId: m.native.requestId, discId: m.menu.manifest.id, startPath: m.menu.manifest.session.startPath, startMode: m.resume.mode }
    task.observeField("response", "onSessionResponse")
    m.top.taskCreated = task
    task.control = TaskControl.Command.Run
end sub

'-------------------------------------------------------------------------------
' onSessionResponse
'-------------------------------------------------------------------------------
sub onSessionResponse(event as object)
    if not m.loading.active or m.native.task = invalid then return
    if not event.getRoSGNode().isSameNode(m.native.task) then return
    response = event.getData()
    if response.requestId <> m.native.requestId then return
    if m.resume.closing and response.action <> DvdSession.Event.Closed then return
    if response.action = DvdSession.Event.Closed then
        task = m.native.task
        m.native.task = invalid
        task.unobserveField("response")
        m.top.removeChild(task)
        if m.resume.closing then
            m.top.closeRequested = true
        else if response.errorCode = "resume-unavailable" then
            releaseContentVideo()
            m.presentation.loading = false
            reconcileBlockingPresentation()
            promptResume(true)
        else if Strings.ToString(response.message) <> "" then
            showFailure(response.message)
        else
            m.top.closeRequested = true
        end if
    else if response.action = DvdSession.Event.Command then
        if m.native.inFlight <> invalid then
            if response.commandId = m.native.inFlight.requestId then
                m.highlights.state = DvdHighlight.State.Selected
                if response.ok and isMenuNavigationAction(m.native.inFlight.action) then
                    if DvdPaths.SameId(m.native.inFlight.interruptedPlaybackId, m.playback.id) then releaseContentVideo()
                    hideControls()
                end if
                if response.payload <> invalid then applySnapshot(response.payload, response.ok and (m.native.inFlight.action = DvdSession.Action.Button or isMenuNavigationAction(m.native.inFlight.action)))
                if response.conflict then m.native.navigating = false
                if m.native.inFlight.action = DvdSession.Action.Button and m.native.state = DvdSession.State.Menu then m.native.navigating = false
                if m.native.inFlight.action = DvdSession.Action.SetFilter then handleFilterResult(response)
                m.native.inFlight = invalid
                if m.native.state = DvdSession.State.Menu then renderMenuHighlight()
                reconcileContentPause()
                dispatchCommand()
                reconcilePlayerPresentation()
                restartControlsTimer()
            end if
        end if
    else if response.action = DvdSession.Event.Snapshot then
        try
            applySnapshot(response.payload)
        catch error
            showFailure("The native DVD session supplied an invalid menu or playback unit.")
        end try
    end if
end sub

'-------------------------------------------------------------------------------
' applySnapshot
'-------------------------------------------------------------------------------
sub applySnapshot(snapshot as object, restoreMenuSelection = false as boolean)
    revision = Number.ToInteger(snapshot.revision, -1)
    if revision < m.native.revision then return
    reconcileFilterSnapshot(snapshot)
    ' A successfully established session consumes the initial startup choice.
    ' Recovery must not clear progress saved since an earlier Start over.
    m.resume.mode = DvdSession.StartMode.Normal
    if revision = m.native.revision then
        m.native.snapshot = snapshot
        syncTimeline()
        if restoreMenuSelection and snapshot.state = DvdSession.State.Menu then restoreBackendMenuSelection(snapshot.menu)
        return
    end if
    previousSnapshot = m.native.snapshot
    previousState = m.native.state
    m.native.revision = revision
    m.native.snapshot = snapshot
    m.native.state = snapshot.state
    state = snapshot.state
    if m.filters.open then
        ' A menu picker survives evaluation updates, but not authored navigation.
        keepPicker = m.filters.fromMenu and state = DvdSession.State.Menu and previousState = DvdSession.State.Menu
        if keepPicker then
            currentContinuation = snapshot.menuContinuation
            oldContinuation = previousSnapshot.menuContinuation
            if type(currentContinuation) = "roAssociativeArray" and type(oldContinuation) = "roAssociativeArray" then
                keepPicker = DvdPaths.SameId(currentContinuation.menuInstance, oldContinuation.menuInstance)
            end if
        end if
        if m.filters.fromMenu and not keepPicker then dismissFilterPicker()
        if not m.filters.fromMenu and (state = DvdSession.State.Menu or state = DvdSession.State.Still or state = DvdSession.State.Failed or state = DvdSession.State.Stopped) then dismissFilterPicker()
    end if
    if state <> DvdSession.State.Menu then clearHighlightSheet()
    m.log.write("Native session state=" + state + " revision=" + revision.ToStr())
    preparing = state = DvdSession.State.Starting or state = DvdSession.State.Preparing
    keepMenu = preparing and m.rendering.root <> invalid and m.nodes.host.visible and (previousState = DvdSession.State.Menu or previousState = DvdSession.State.Starting or previousState = DvdSession.State.Preparing)
    ' Retain menu presentation while resolving navigation, never over content.
    m.nodes.host.visible = state = DvdSession.State.Menu or keepMenu
    if state = DvdSession.State.Starting or state = DvdSession.State.Preparing then
        if m.native.inFlight <> invalid then
            if isMenuNavigationAction(m.native.inFlight.action) then
                releaseContentVideo()
                hideControls()
            end if
        end if
        if not keepMenu then stopPreview()
        if m.playback.video <> invalid then m.playback.video.control = MediaControl.Command.Pause
        if m.playback.timer <> invalid then m.playback.timer.control = TimerControl.Command.Stop
        ' Starting is unresolved navigation; preparingPlayback confirms a stream.
        ' Retain the menu underneath, but acknowledge content preparation now.
        m.presentation.loading = state = DvdSession.State.Preparing or not keepMenu
        if not m.filters.open then restorePlayerFocus()
    else if state = DvdSession.State.Menu then
        hideControls()
        m.native.navigating = false
        releaseContentVideo()
        m.nodes.contentHost.visible = false
        m.nodes.host.visible = true
        renderScreen(snapshot.menu)
        reconcileMenuSelection(snapshot, previousSnapshot, restoreMenuSelection)
        m.presentation.loading = false
    else if state = DvdSession.State.Playing or state = DvdSession.State.AwaitingCompletion then
        clearMenu()
        m.native.navigating = false
        if not DvdPaths.SameId(m.playback.id, snapshot.playback.playbackId) then openContentVideo(snapshot.playback)
    else if state = DvdSession.State.Still then
        clearStartupArtwork()
        m.native.navigating = false
        stopPreview()
        if m.playback.video <> invalid then m.playback.video.control = MediaControl.Command.Pause
        if m.playback.timer <> invalid then m.playback.timer.control = TimerControl.Command.Stop
        m.presentation.loading = false
        m.nodes.status.text = ""
        if not m.filters.open then restorePlayerFocus()
    else if state = DvdSession.State.Failed then
        clearStartupArtwork()
        hideControls()
        stopPreview()
        releaseContentVideo()
        m.nodes.contentHost.visible = false
        m.nodes.host.visible = false
        m.presentation.loading = false
        m.nodes.status.text = Strings.ToString(snapshot.error, "Native DVD session failed.")
    else if state <> DvdSession.State.Stopped then
        throw "Unknown native DVD state."
    end if
    reconcileContentPause()
    reconcilePlayerPresentation()
    if m.nodes.controls.visible and not m.filters.open then restorePlayerFocus()
end sub

'-------------------------------------------------------------------------------
' queueCommand
'-------------------------------------------------------------------------------
sub queueCommand(action as string, playbackId = invalid as dynamic, value = invalid as dynamic)
    if m.native.task = invalid then return
    command = { requestId: CreateObject("roDeviceInfo").GetRandomUUID(), action: action }
    if playbackId <> invalid then
        command.playbackId = playbackId
    else
        command.revision = m.native.revision
    end if
    if isMenuNavigationAction(action) then command.interruptedPlaybackId = m.playback.id
    if action = DvdSession.Action.Button then command.button = value
    if action = DvdSession.Action.Progress then command.positionSeconds = value
    if action = DvdSession.Action.Pause or isMenuNavigationAction(action) then
        positionCommand = finalPositionCommand(action)
        if positionCommand <> invalid then
            command.playbackId = positionCommand.playbackId
            command.positionSeconds = positionCommand.positionSeconds
            if isMenuNavigationAction(action) then m.playback.video.control = MediaControl.Command.Pause
        end if
    end if
    m.native.queue.Push(command)
    dispatchCommand()
    reconcilePlayerPresentation()
end sub

'-------------------------------------------------------------------------------
' dispatchCommand
'-------------------------------------------------------------------------------
sub dispatchCommand()
    if m.native.task = invalid or m.native.inFlight <> invalid then return
    while m.native.queue.Count() > 0
        command = m.native.queue.Shift()
        snapshot = m.native.snapshot
        valid = true
        if command.playbackId <> invalid then
            valid = false
            if snapshot <> invalid and snapshot.playback <> invalid then valid = DvdPaths.SameId(command.playbackId, snapshot.playback.playbackId)
        else
            valid = command.revision = m.native.revision
        end if
        if valid and command.action = DvdSession.Action.SetFilter then
            valid = command.playbackId = invalid and m.native.state = DvdSession.State.Menu
            if (m.native.state = DvdSession.State.Playing or m.native.state = DvdSession.State.AwaitingCompletion) and m.playback.video <> invalid and DvdPaths.SameId(m.playback.id, command.playbackId) then
                position = Number.ToFloat(m.playback.video.position, -1)
                if position >= 0 and not m.playback.completed and not m.playback.failed then
                    command.revision = m.native.revision
                    command.positionSeconds = position
                    valid = true
                end if
            end if
        end if
        if valid then
            if command.action = DvdSession.Action.SetFilter then m.log.write("Filter command dispatch id=" + command.filterId + " requestId=" + command.requestId)
            m.native.inFlight = command
            m.native.task.command = command
            return
        else if command.action = DvdSession.Action.SetFilter then
            handleFilterResult({ commandId: command.requestId, ok: false, errorCode: DvdFilter.Error.StalePlayback, message: "Playback changed. Select the filter again to retry." })
        else if isMenuNavigationAction(command.action) or command.action = DvdSession.Action.Button then
            m.native.navigating = false
        end if
    end while
end sub

'-------------------------------------------------------------------------------
' onKeyEvent
'-------------------------------------------------------------------------------
function onKeyEvent(key as string, press as boolean) as boolean
    if not press or not m.loading.active then return false
    if m.resume.closing or m.resume.prompting or m.filters.open then return true
    if key = Remote.Key.Back then
        if m.filters.busy then
            closeDvdSession()
            return true
        end if
        if m.nodes.controls.visible then
            hideControls()
            return true
        end if
        if not m.loading.failed and (m.native.state = DvdSession.State.Playing or m.native.state = DvdSession.State.AwaitingCompletion or m.native.state = DvdSession.State.Still) then
            requestLastMenu()
            return true
        end if
        closeDvdSession()
        return true
    end if
    if m.loading.failed then
        if key = Remote.Key.OK then beginLoad()
        return true
    end if
    if m.filters.busy then return true
    if m.native.state = DvdSession.State.Menu and m.rendering.waitingForReveal then return true
    if key = Remote.Key.Options then
        if m.native.state <> DvdSession.State.Menu then requestDvdMenu()
        return true
    end if
    if m.native.navigating then return true
    if m.native.state = DvdSession.State.Menu then
        if m.native.inFlight <> invalid or m.native.queue.Count() > 0 then return true
        if key = Remote.Key.Play or key = Remote.Key.PlayPause then
            openFilterPicker()
        else if key = Remote.Key.OK then
            activateMenuButton(m.menu.focused)
        else if key = Remote.Key.Up or key = Remote.Key.Down or key = Remote.Key.Left or key = Remote.Key.Right then
            navigateMenu(key)
        end if
    else if m.native.state = DvdSession.State.Playing or m.native.state = DvdSession.State.AwaitingCompletion or m.native.state = DvdSession.State.Still then
        if key = Remote.Key.Play or key = Remote.Key.PlayPause then
            toggleContentPause()
        else if key = Remote.Key.OK or key = Remote.Key.Up or key = Remote.Key.Down or key = Remote.Key.Left or key = Remote.Key.Right then
            showControls()
        end if
    end if
    return true
end function

