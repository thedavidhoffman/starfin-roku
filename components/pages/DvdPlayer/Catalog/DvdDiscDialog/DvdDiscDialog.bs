'-------------------------------------------------------------------------------
' openPicker
'-------------------------------------------------------------------------------
sub openPicker()
    m.top.title = m.top.groupName
    m.top.dialogWidth = 800
    m.top.dialogHeight = 590
    m.top.closeOnContentSelected = false
    m.top.contentComponentName = "DvdCatalogContent"
    content = m.top.callFunc("getContentComponent")
    content.allowRefresh = false
    content.observeField("selectedDemo", "onDiscSelected")
    m.top.callFunc("openDialog")
    content.callFunc("showEntries", m.top.discs, true)
end sub

'-------------------------------------------------------------------------------
' onDiscSelected
'-------------------------------------------------------------------------------
sub onDiscSelected()
    content = m.top.callFunc("getContentComponent")
    m.top.selectedDisc = content.selectedDemo
    m.top.callFunc("closeDialog")
end sub

'-------------------------------------------------------------------------------
' focusContent
'-------------------------------------------------------------------------------
function focusContent() as boolean
    content = m.top.callFunc("getContentComponent")
    content.callFunc("focusItems")
    return true
end function
