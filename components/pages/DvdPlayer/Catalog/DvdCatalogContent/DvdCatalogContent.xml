<?xml version="1.0" encoding="utf-8"?>
<component name="DvdCatalogContent" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/components/pages/DvdPlayer/Catalog/DvdCatalogContent/DvdCatalogContent.bs" />
  <interface>
    <field id="selectedDemo" type="assocarray" alwaysNotify="true" />
    <field id="retryRequested" type="boolean" alwaysNotify="true" />
    <field id="discVisibleRows" type="integer" alias="discs.numRows" />
    <field id="visibleRows" type="integer" alias="titles.numRows" />
    <field id="allowRefresh" type="boolean" value="true" />
    <function name="showEntries" />
    <function name="showStatus" />
    <function name="focusItems" />
  </interface>
  <children>
    <Label id="status" width="680" height="280" wrap="true" color="0xFFFFFFFF" />
    <MarkupList id="discs" focusable="false" translation="[0,-28]" itemComponentName="DvdDiscItem" itemSize="[680,124]" numRows="5" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" visible="false" />
    <LabelList id="titles" itemSize="[680,72]" numRows="5" vertFocusAnimationStyle="floatingFocus" visible="false" />
  </children>
</component>
