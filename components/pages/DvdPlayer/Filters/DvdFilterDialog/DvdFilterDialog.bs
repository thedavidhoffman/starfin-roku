'-------------------------------------------------------------------------------
' openPicker
'-------------------------------------------------------------------------------
sub openPicker()
    m.dialogLayout.contentTop = 140
    m.top.title = "Video filter"
    m.top.dialogWidth = 900
    m.top.dialogHeight = 740
    m.top.showButtons = false
    m.top.closeOnContentSelected = false
    m.top.contentComponentName = "DvdFilterContent"
    content = m.top.callFunc("getContentComponent")
    content.model = m.top.model
    m.top.model.observeFieldScoped("dismissRequested", "onDismissRequested")
    m.top.callFunc("openDialog")
end sub

'-------------------------------------------------------------------------------
' onDismissRequested
'-------------------------------------------------------------------------------
sub onDismissRequested()
    m.top.callFunc("closeDialog")
end sub

'-------------------------------------------------------------------------------
' cleanup
'-------------------------------------------------------------------------------
sub cleanup()
    m.top.model.unobserveFieldScoped("dismissRequested")
    content = m.top.callFunc("getContentComponent")
    content.callFunc("cleanup")
end sub

'-------------------------------------------------------------------------------
' onCloseRequested
'-------------------------------------------------------------------------------
sub onCloseRequested()
    cleanup()
end sub

'-------------------------------------------------------------------------------
' focusContent
'-------------------------------------------------------------------------------
function focusContent() as boolean
    content = m.top.callFunc("getContentComponent")
    content.callFunc("focusItems")
    return true
end function
