namespace DvdSession
    enum StartMode
        Normal = "normal"
        Resume = "resume"
        StartOver = "startOver"
    end enum

    enum State
        Starting = "starting"
        Preparing = "preparingPlayback"
        Menu = "menu"
        Playing = "playing"
        AwaitingCompletion = "awaitingCompletion"
        Still = "still"
        Stopped = "stopped"
        Failed = "failed"
    end enum

    enum Action
        Button = "button"
        Menu = "menu"
        ReturnToLastMenu = "returnToLastMenu"
        StillComplete = "stillComplete"
        Started = "started"
        Progress = "progress"
        Pause = "pause"
        Resume = "resume"
        Complete = "complete"
        Stop = "stop"
        PlaybackFailed = "playbackFailed"
    end enum

    enum Event
        Snapshot = "snapshot"
        Command = "command"
        Closed = "closed"
    end enum
end namespace
