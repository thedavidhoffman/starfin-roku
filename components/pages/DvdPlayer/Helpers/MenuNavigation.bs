'-------------------------------------------------------------------------------
' reconcileMenuSelection
'-------------------------------------------------------------------------------
sub reconcileMenuSelection(snapshot as object, previousSnapshot as dynamic, restoreSelection as boolean)
    menu = snapshot.menu
    previousMenu = invalid
    if previousSnapshot <> invalid then
        if previousSnapshot.state = DvdSession.State.Menu then previousMenu = previousSnapshot.menu
    end if
    if previousMenu = invalid then
        restoreSelection = true
    else if (previousMenu.selectedButton <> menu.selectedButton and m.menu.synchronization = invalid) or FormatJson(previousMenu.buttons) <> FormatJson(menu.buttons) then
        restoreSelection = true
    end if
    if previousMenu <> invalid then
        continuation = snapshot.menuContinuation
        previousContinuation = previousSnapshot.menuContinuation
        if type(continuation) = "roAssociativeArray" and type(previousContinuation) = "roAssociativeArray" then
            menuInstance = continuation.menuInstance
            previousInstance = previousContinuation.menuInstance
            if DvdPaths.SameId(menuInstance, menuInstance) and DvdPaths.SameId(previousInstance, previousInstance) then
                ' Identical button layouts can belong to different authored menus.
                if not DvdPaths.SameId(menuInstance, previousInstance) then restoreSelection = true
            end if
        end if
    end if
    key = m.menu.focused.ToStr()
    if not m.rendering.buttons.DoesExist(key) then restoreSelection = true
    if restoreSelection then
        restoreBackendMenuSelection(menu)
    else
        ' Artwork/atlas updates do not change locally navigated selection.
        renderMenuHighlight()
        restorePlayerFocus()
    end if
end sub

'-------------------------------------------------------------------------------
' restoreBackendMenuSelection
'-------------------------------------------------------------------------------
sub restoreBackendMenuSelection(menu as object)
    focus = Number.ToInteger(menu.selectedButton, 0)
    if not m.rendering.buttons.DoesExist(focus.ToStr()) and m.rendering.geometry.Count() > 0 then focus = m.rendering.geometry[0].id
    m.menu.focused = focus
    if m.rendering.geometry.Count() > 0 then
        focusButton(focus)
    else
        renderMenuHighlight()
        restorePlayerFocus()
    end if
end sub

'-------------------------------------------------------------------------------
' focusButton
'-------------------------------------------------------------------------------
sub focusButton(buttonNumber as integer)
    key = buttonNumber.ToStr()
    if not m.rendering.buttons.DoesExist(key) then return
    m.menu.focused = buttonNumber
    m.highlights.state = DvdHighlight.State.Selected
    renderMenuHighlight()
    restorePlayerFocus()
end sub

'-------------------------------------------------------------------------------
' activateMenuButton
'-------------------------------------------------------------------------------
sub activateMenuButton(buttonId as integer)
    if m.native.task = invalid or m.native.state <> DvdSession.State.Menu then return
    if m.native.navigating or menuCommandPending() then return
    if not m.rendering.buttons.DoesExist(buttonId.ToStr()) then return
    m.log.write("Timing menu-selection sessionId=" + m.native.requestId + " button=" + buttonId.ToStr() + " revision=" + m.native.revision.ToStr())
    m.native.navigating = true
    m.highlights.state = DvdHighlight.State.Activated
    renderMenuHighlight()
    queueCommand(DvdSession.Action.Button, invalid, buttonId)
end sub

'-------------------------------------------------------------------------------
' navigateMenu
'-------------------------------------------------------------------------------
sub navigateMenu(direction as string)
    destination = 0
    for each button in m.rendering.geometry
        if button.id = m.menu.focused then
            destination = Number.ToInteger(button[direction], 0)
            exit for
        end if
    end for
    if not m.rendering.buttons.DoesExist(destination.ToStr()) then return
    for each button in m.rendering.geometry
        if button.id = destination then
            focusButton(destination)
            ' Only a user directional selection triggers authored auto-action.
            if button.autoAction = true then
                activateMenuButton(destination)
            else
                reportMenuState()
            end if
            return
        end if
    end for
end sub

'-------------------------------------------------------------------------------
' synchronizeMenuInstance
'-------------------------------------------------------------------------------
sub synchronizeMenuInstance(snapshot as object)
    if snapshot.capabilities = invalid or snapshot.menuContinuation = invalid then
        m.menu.synchronization = invalid
        return
    end if
    if snapshot.capabilities.menuSynchronization <> true then
        m.menu.synchronization = invalid
        return
    end if
    instance = snapshot.menuContinuation.menuInstance
    if not DvdPaths.SameId(instance, instance) then return
    if m.menu.synchronization <> invalid then
        if DvdPaths.SameId(instance, m.menu.synchronization.instance) then return
    end if
    m.menu.synchronization = { instance: instance, sequence: 0, clock: invalid, ready: false, presentationAccepted: false }
end sub

'-------------------------------------------------------------------------------
' acknowledgeMenuPresentation
'-------------------------------------------------------------------------------
sub acknowledgeMenuPresentation()
    if m.menu.synchronization = invalid or m.native.state <> DvdSession.State.Menu then return
    if m.rendering.waitingForReveal or not m.rendering.backgroundReady then return
    if not m.menu.synchronization.ready or m.menu.synchronization.presentationAccepted then return
    pendingReports = []
    if m.native.inFlight <> invalid then pendingReports.Push(m.native.inFlight)
    for each command in m.native.queue
        pendingReports.Push(command)
    end for
    for each command in pendingReports
        if command.action = DvdSession.Action.MenuState and command.positionSeconds <> invalid then
            if DvdPaths.SameId(command.menuInstance, m.menu.synchronization.instance) then return
        end if
    end for
    if m.menu.synchronization.clock = invalid then m.menu.synchronization.clock = CreateObject("roTimespan")
    reportMenuState()
end sub

'-------------------------------------------------------------------------------
' reportMenuState
'-------------------------------------------------------------------------------
sub reportMenuState()
    sync = m.menu.synchronization
    if sync = invalid or m.native.task = invalid or m.native.state <> DvdSession.State.Menu then return
    if m.native.navigating or menuCommandPending() then return
    selected = m.menu.focused
    if not m.rendering.buttons.DoesExist(selected.ToStr()) then selected = Number.ToInteger(m.native.snapshot.menu.selectedButton, 0)
    if not m.rendering.buttons.DoesExist(selected.ToStr()) then return
    sync.sequence++
    command = { requestId: CreateObject("roDeviceInfo").GetRandomUUID(), action: DvdSession.Action.MenuState, menuInstance: sync.instance, menuSequence: sync.sequence, button: selected }
    if sync.clock <> invalid then
        command.positionSeconds = sync.clock.TotalMilliseconds() / 1000.0
        if command.positionSeconds > 3600 then command.positionSeconds = 3600
    end if
    ' Keep the in-flight report immutable for retries; coalesce only unsent focus.
    pending = []
    for each queued in m.native.queue
        if queued.action <> DvdSession.Action.MenuState then pending.Push(queued)
    end for
    pending.Push(command)
    m.native.queue = pending
    dispatchCommand()
end sub

'-------------------------------------------------------------------------------
' menuCommandPending
'-------------------------------------------------------------------------------
function menuCommandPending() as boolean
    if m.native.inFlight <> invalid then
        if m.native.inFlight.action <> DvdSession.Action.MenuState then return true
    end if
    for each command in m.native.queue
        if command.action <> DvdSession.Action.MenuState then return true
    end for
    return false
end function
