'-------------------------------------------------------------------------------
' fitMenuRect
'-------------------------------------------------------------------------------
function fitMenuRect(video as object, viewportWidth as float, viewportHeight as float) as object
    parts = Strings.ToString(video.aspectRatio).Split(":")
    if parts.Count() <> 2 then throw "Invalid DVD display aspect ratio."
    numerator = Number.ToFloat(parts[0], 0)
    denominator = Number.ToFloat(parts[1], 0)
    if numerator <= 0 or denominator <= 0 then throw "Invalid DVD display aspect ratio."
    sourceWidth = Number.ToFloat(video.sourceWidth, 0)
    sourceHeight = Number.ToFloat(video.sourceHeight, 0)
    if sourceWidth <= 0 or sourceHeight <= 0 then throw "Invalid DVD source dimensions."
    ratio = numerator / denominator
    width = viewportWidth
    height = width / ratio
    if height > viewportHeight then
        height = viewportHeight
        width = height * ratio
    end if
    return { x: (viewportWidth - width) / 2, y: (viewportHeight - height) / 2, width: width, height: height, scaleX: width / sourceWidth, scaleY: height / sourceHeight }
end function
