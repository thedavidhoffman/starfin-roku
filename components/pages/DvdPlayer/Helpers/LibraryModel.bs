'-------------------------------------------------------------------------------
' groupLibraryDiscs
'-------------------------------------------------------------------------------
function groupLibraryDiscs(discs as object) as object
    groups = []
    byKey = {}
    for each disc in discs
        metadataId = Strings.Trim(disc.metadataId)
        key = "disc:" + LCase(Strings.ToString(disc.id)).Replace("-", "")
        if metadataId <> "" then key = "metadata:" + LCase(metadataId).Replace("-", "")
        if not byKey.DoesExist(key) then
            metadata = disc.metadata
            if type(metadata) <> "roAssociativeArray" then metadata = {}
            name = Strings.Trim(metadata.name)
            if name = "" then name = Strings.ToString(disc.name, disc.id)
            year = metadata.year
            if year = invalid then year = disc.year
            posterPath = Strings.Trim(metadata.posterPath)
            if posterPath = "" then posterPath = Strings.ToString(disc.posterPath)
            group = { key: key, name: name, year: year, overview: Strings.Trim(metadata.overview), posterPath: posterPath, metadataId: metadataId, discs: [] }
            byKey[key] = group
            groups.Push(group)
        end if
        byKey[key].discs.Push(disc)
    end for
    for each group in groups
        group.discs = sortGroupDiscs(group.discs)
    end for
    return groups
end function

'-------------------------------------------------------------------------------
' sortGroupDiscs
'-------------------------------------------------------------------------------
function sortGroupDiscs(discs as object) as object
    sorted = []
    for each disc in discs
        index = sorted.Count()
        sorted.Push(disc)
        while index > 0
            previous = sorted[index - 1]
            if not discComesBefore(disc, previous) then exit while
            sorted[index] = previous
            index--
        end while
        sorted[index] = disc
    end for
    return sorted
end function

'-------------------------------------------------------------------------------
' discComesBefore
'-------------------------------------------------------------------------------
function discComesBefore(first as object, second as object) as boolean
    firstNumber = Number.ToInteger(first.discNumber, 0)
    secondNumber = Number.ToInteger(second.discNumber, 0)
    if firstNumber > 0 and secondNumber <= 0 then return true
    if firstNumber <= 0 and secondNumber > 0 then return false
    if firstNumber > 0 and secondNumber > 0 and firstNumber <> secondNumber then return firstNumber < secondNumber
    return LCase(Strings.ToString(first.name)) < LCase(Strings.ToString(second.name))
end function
