namespace DvdFilter
    enum Capability
        Checking = "checking"
        Available = "available"
        Unavailable = "unavailable"
    end enum
    enum Change
        Pending = "pending"
        Accepted = "accepted"
        Rejected = "rejected"
    end enum
    enum Request
        Catalog = "catalog"
        Capability = "capability"
    end enum
    enum Error
        Checking = "filters-checking"
        Unavailable = "filters-unavailable"
        Pending = "filter-change-pending"
        StaleRevision = "stale-revision"
        StalePlayback = "stale-playback"
    end enum
    const None = "none"
end namespace
