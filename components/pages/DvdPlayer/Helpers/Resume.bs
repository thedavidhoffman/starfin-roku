import "pkg:/components/pages/DvdPlayer/Helpers/Contracts.bs"

'-------------------------------------------------------------------------------
' promptResume
'-------------------------------------------------------------------------------
sub promptResume(unavailable as boolean)
    m.resume.prompting = true
    m.resume.requestId = CreateObject("roDeviceInfo").GetRandomUUID()
    m.top.overlayRequested = { id: DvdMenu.Overlay.Resume, componentName: "DvdResumeDialog", openFunction: "openPicker", closeField: "closeRequested", resumeUnavailable: unavailable, requestId: m.resume.requestId, generation: m.loading.generation, discId: m.session.demo.id }
end sub

'-------------------------------------------------------------------------------
' handleResumeClosed
'-------------------------------------------------------------------------------
sub handleResumeClosed(request as object, mode as string)
    if not m.loading.active or not m.resume.prompting then return
    if request.requestId <> m.resume.requestId then return
    if request.generation <> m.loading.generation or request.discId <> m.session.demo.id then return
    m.resume.prompting = false
    if mode <> DvdSession.StartMode.Normal and mode <> DvdSession.StartMode.Resume and mode <> DvdSession.StartMode.StartOver then
        closeDvdSession()
        return
    end if
    m.resume.mode = mode
    beginLoad()
end sub

