'-------------------------------------------------------------------------------
' openContentVideo
'-------------------------------------------------------------------------------
sub openContentVideo(playback as object)
    clearMenu()
    releaseContentVideo()
    m.nodes.host.visible = false
    m.nodes.contentHost.visible = true
    media = JellyfinAuth.BuildMediaRequest(m.session.server, playback.playlistPath, m.session.token, m.session.userId)
    if media.headers.Authorization = invalid then throw "Missing DVD playback authentication."
    m.playback.id = playback.playbackId
    m.playback.active = true
    m.playback.started = false
    m.playback.completed = false
    m.playback.failed = false
    m.playback.pauseRequested = false
    m.playback.progress = 0
    m.playback.buffering = true
    video = m.nodes.contentHost.createChild("Video")
    m.playback.video = video
    video.width = 1920
    video.height = 1080
    video.enableUI = false
    video.enableTrickPlay = false
    video.loop = false
    video.mute = false
    video.notificationInterval = 1
    agent = CreateObject("roHttpAgent")
    agent.SetCertificatesFile("common:/certs/ca-bundle.crt")
    agent.AddHeader("Authorization", media.headers.Authorization)
    video.setHttpAgent(agent)
    content = JellyfinAuth.CreateContent(m.session.server, playback.playlistPath, m.session.token, m.session.userId)
    content.streamFormat = "hls"
    content.live = false
    content.playStart = 0
    video.content = content
    video.observeField("state", "onContentState")
    video.observeField("position", "onContentPosition")
    timer = m.top.createChild("Timer")
    m.playback.timer = timer
    timer.duration = 60
    timer.repeat = false
    timer.observeField("fire", "onContentTimeout")
    timer.control = TimerControl.Command.Start
    m.nodes.spinner.control = SpinnerControl.Command.Start
    m.nodes.status.text = ""
    m.top.setFocus(true)
    video.control = MediaControl.Command.Play
end sub

'-------------------------------------------------------------------------------
' onContentState
'-------------------------------------------------------------------------------
sub onContentState(event as object)
    if not m.loading.active or not m.playback.active or m.playback.video = invalid then return
    if not event.getRoSGNode().isSameNode(m.playback.video) then return
    if m.native.state <> DvdSession.State.Playing and m.native.state <> DvdSession.State.AwaitingCompletion then return
    state = event.getData()
    m.log.write("Native content state=" + Strings.ToString(state) + " playbackId=" + m.playback.id)
    if state = VideoPlayerState.Value.Playing or state = VideoPlayerState.Value.Paused then
        m.playback.buffering = false
        m.playback.timer.control = TimerControl.Command.Stop
        m.nodes.spinner.control = SpinnerControl.Command.Stop
        m.nodes.host.visible = false
        m.nodes.contentHost.visible = true
        m.nodes.status.text = ""
        if state = VideoPlayerState.Value.Playing and not m.playback.started then
            m.playback.started = true
            queueCommand(DvdSession.Action.Started, m.playback.id)
        end if
        reconcileContentPause()
        if state = VideoPlayerState.Value.Paused and m.playback.pauseRequested then showControls()
        restartControlsTimer()
    else if state = VideoPlayerState.Value.Buffering then
        m.nodes.spinner.control = SpinnerControl.Command.Start
        if not m.playback.buffering then m.playback.timer.control = TimerControl.Command.Start
        m.playback.buffering = true
    else if state = VideoPlayerState.Value.Finished then
        if m.playback.completed then return
        m.playback.completed = true
        m.playback.timer.control = TimerControl.Command.Stop
        m.nodes.spinner.control = SpinnerControl.Command.Stop
        ' Keep this Video node/frame until the authored boundary chooses new media.
        queueCommand(DvdSession.Action.Complete, m.playback.id)
    else if state = VideoPlayerState.Value.Error then
        if m.playback.failed then return
        m.playback.failed = true
        queueCommand(DvdSession.Action.PlaybackFailed, m.playback.id)
        m.nodes.status.text = "The DVD stream could not be played."
    end if
    syncControls()
end sub

'-------------------------------------------------------------------------------
' onContentPosition
'-------------------------------------------------------------------------------
sub onContentPosition(event as object)
    if not m.loading.active or m.playback.video = invalid or m.playback.completed then return
    if not event.getRoSGNode().isSameNode(m.playback.video) then return
    if m.native.state <> DvdSession.State.Playing and m.native.state <> DvdSession.State.AwaitingCompletion then return
    position = Number.ToFloat(event.getData(), -1)
    if position < 0 or position < m.playback.progress + 15 then return
    if not m.playback.started or m.playback.video.state <> VideoPlayerState.Value.Playing then return
    if m.native.inFlight = invalid and m.native.queue.Count() = 0 then
        m.playback.progress = position
        queueCommand(DvdSession.Action.Progress, m.playback.id, position)
    end if
end sub

'-------------------------------------------------------------------------------
' onContentTimeout
'-------------------------------------------------------------------------------
sub onContentTimeout(event as object)
    if m.playback.timer = invalid then return
    if not event.getRoSGNode().isSameNode(m.playback.timer) then return
    showFailure("The DVD stream timed out while buffering.")
end sub

'-------------------------------------------------------------------------------
' releaseContentVideo
'-------------------------------------------------------------------------------
sub releaseContentVideo()
    video = m.playback.video
    timer = m.playback.timer
    m.playback.video = invalid
    m.playback.timer = invalid
    m.playback.active = false
    m.playback.id = ""
    if video <> invalid then
        video.unobserveField("state")
        video.unobserveField("position")
        video.control = MediaControl.Command.Stop
        video.content = invalid
        m.nodes.contentHost.removeChild(video)
    end if
    if timer <> invalid then
        timer.unobserveField("fire")
        timer.control = TimerControl.Command.Stop
        m.top.removeChild(timer)
    end if
end sub
