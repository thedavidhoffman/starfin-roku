import "pkg:/source/String.bs"

namespace DvdPaths

    '---------------------------------------------------------------------------
    ' DvdPaths.IsMetadataPoster
    '---------------------------------------------------------------------------
    function IsMetadataPoster(path as dynamic, metadataId as dynamic) as boolean
        return IsImage(path, "Titles", metadataId)
    end function

    '---------------------------------------------------------------------------
    ' DvdPaths.IsImage
    '---------------------------------------------------------------------------
    function IsImage(path as dynamic, kind as string, expectedId = "" as dynamic) as boolean
        pieces = Strings.ToString(path).Split("?")
        if pieces.Count() > 2 then return false
        if pieces.Count() = 2 then
            query = CreateObject("roRegex", "^tag=([A-Za-z0-9._~!$'()*+,;=:@/?-]|%[0-9A-Fa-f]{2})+$", "")
            if not query.IsMatch(pieces[1]) then return false
        end if
        parts = pieces[0].Split("/")
        if parts.Count() < 4 then return false
        if parts[0] <> "Starfin" or parts[1] <> "Dvd" or parts[2] <> "Images" or parts[3] <> kind then return false
        if kind = "Home" then return parts.Count() = 4
        if kind <> "Libraries" and kind <> "Titles" then return false
        if parts.Count() < 5 then return false
        if not SameId(parts[4], expectedId) then return false
        if kind = "Libraries" then return parts.Count() = 5
        return parts.Count() = 6 and parts[5] = "Poster"
    end function

    '---------------------------------------------------------------------------
    ' DvdPaths.SameId
    '---------------------------------------------------------------------------
    function SameId(first as dynamic, second as dynamic) as boolean
        leftId = LCase(Strings.ToString(first)).Replace("-", "")
        rightId = LCase(Strings.ToString(second)).Replace("-", "")
        uuid = CreateObject("roRegex", "^[0-9a-f]{32}$", "")
        return uuid.IsMatch(leftId) and leftId = rightId
    end function

    '---------------------------------------------------------------------------
    ' DvdPaths.IsScoped
    '---------------------------------------------------------------------------
    function IsScoped(path as dynamic, collection as string, id as dynamic) as boolean
        value = Strings.ToString(path)
        safe = CreateObject("roRegex", "^[A-Za-z0-9._~/-]+$", "")
        if not safe.IsMatch(value) then return false
        parts = value.Split("/")
        if parts.Count() < 4 then return false
        if parts[0] <> "Starfin" or parts[1] <> "Dvd" or parts[2] <> collection then return false
        if not SameId(parts[3], id) then return false
        for each part in parts
            if part = "" or part = "." or part = ".." then return false
        end for
        return true
    end function
end namespace
