namespace DvdMenu
    enum BrowserView
        Catalog = "catalog"
        Library = "library"
    end enum

    enum Action
        Navigate = "navigate"
        SelectTitle = "select"
        Audio = "audio"
        Subtitles = "subtitles"
        InfoText = "infoText"
        Resume = "resume"
        Unsupported = "unsupported"
    end enum

    enum Phase
        Loading = "loading"
        Ready = "ready"
        Failed = "failed"
    end enum

    enum Request
        Load = "dvdDemoLoad"
        Catalog = "dvdDemoCatalog"
        Library = "dvdLibrary"
    end enum

    enum Overlay
        Discs = "dvdDiscPicker"
    end enum

    enum PlaybackEvent
        Ready = "ready"
        Closed = "closed"
    end enum

    enum PlaybackState
        Starting = "starting"
        Streaming = "streaming"
        Completed = "completed"
        Failed = "failed"
    end enum
end namespace
