import "pkg:/components/pages/DvdPlayer/Helpers/SessionContracts.bs"

'-------------------------------------------------------------------------------
' openPicker
'-------------------------------------------------------------------------------
sub openPicker()
    m.top.title = "Resume DVD?"
    firstChoice = { id: DvdSession.StartMode.Resume, name: "Resume" }
    if m.top.resumeUnavailable then
        m.top.title = "Saved progress is unavailable"
        firstChoice = { id: DvdSession.StartMode.Normal, name: "Open DVD normally" }
    end if
    m.top.dialogWidth = 800
    m.top.dialogHeight = 390
    m.top.closeOnContentSelected = false
    m.top.contentComponentName = "DvdCatalogContent"
    content = m.top.callFunc("getContentComponent")
    content.allowRefresh = false
    content.visibleRows = 2
    content.observeField("selectedDemo", "onModeSelected")
    m.top.callFunc("openDialog")
    content.callFunc("showEntries", [firstChoice, { id: DvdSession.StartMode.StartOver, name: "Start over" }], false)
end sub

'-------------------------------------------------------------------------------
' onModeSelected
'-------------------------------------------------------------------------------
sub onModeSelected()
    content = m.top.callFunc("getContentComponent")
    m.top.selectedMode = content.selectedDemo.id
    m.top.callFunc("closeDialog")
end sub

'-------------------------------------------------------------------------------
' focusContent
'-------------------------------------------------------------------------------
function focusContent() as boolean
    content = m.top.callFunc("getContentComponent")
    content.callFunc("focusItems")
    return true
end function
