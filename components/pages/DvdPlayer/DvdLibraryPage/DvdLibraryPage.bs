import "pkg:/components/pages/DvdPlayer/Helpers/LibraryBrowse.bs"
import "pkg:/source/store/SettingsStore.bs"
import "pkg:/source/LibraryLayoutSetting.bs"
import "pkg:/source/String.bs"
import "pkg:/source/Number.bs"
import "pkg:/source/Remote.bs"
import "pkg:/source/TaskControl.bs"
import "pkg:/source/SpinnerControl.bs"
import "pkg:/source/VideoCardGridLayout.bs"
import "pkg:/components/pages/DvdPlayer/Helpers/Contracts.bs"
import "pkg:/components/pages/DvdPlayer/Helpers/Paths.bs"
import "pkg:/components/pages/DvdPlayer/Helpers/LibraryModel.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    initReferences()
    m.library = { active: false, rendering: false, loading: false, entryPending: false, task: invalid, generation: 0, groups: [], key: "", index: 0, libraries: [], catalogKey: "", view: DvdMenu.BrowserView.Catalog }
    m.layout = { columns: 6, spec: invalid }
    m.browse = { selection: dvdBrowseSelection(LibraryBrowse.Option.Title), ready: false }
    applyLibraryLayout()
    initHandlers()
    onDvdLayoutChanged()
end sub

'-------------------------------------------------------------------------------
' initReferences
'-------------------------------------------------------------------------------
sub initReferences()
    m.nodes = { grid: m.top.findNode("posters"), name: m.top.findNode("libraryName"), status: m.top.findNode("status"), spinner: m.top.findNode("loading"), browse: m.top.findNode("browseByButton"), sort: m.top.findNode("sortButton") }
end sub

'-------------------------------------------------------------------------------
' initHandlers
'-------------------------------------------------------------------------------
sub initHandlers()
    m.top.observeField("settings", "onDvdLayoutChanged")
    m.nodes.browse.observeField("overlayRequested", "onDvdBrowseRequested")
    m.nodes.browse.observeField("focusExitDown", "focusBrowser")
    m.nodes.sort.observeField("focusExitDown", "focusBrowser")
    m.nodes.sort.observeField("sortOrderChanged", "onDvdSortChanged")
    m.nodes.grid.observeField("itemFocused", "onGroupFocused")
    m.nodes.grid.observeField("itemSelected", "onGroupSelected")
end sub

'-------------------------------------------------------------------------------
' activate
'-------------------------------------------------------------------------------
sub activate()
    if m.library.active then
        focusBrowser()
        return
    end if
    m.library.active = true
    syncDvdBrowseControls()
    m.top.visible = true
    ' Returning from a DVD reuses the retained grid and decoded posters.
    if m.nodes.grid.visible and m.library.groups.Count() > 0 then
        focusBrowser()
    else
        loadLibrary()
    end if
end sub

'-------------------------------------------------------------------------------
' deactivate
'-------------------------------------------------------------------------------
sub deactivate()
    m.library.active = false
    m.top.visible = false
    releaseLibraryTask()
    syncDvdBrowseControls()
    m.nodes.spinner.control = SpinnerControl.Command.Stop
end sub

'-------------------------------------------------------------------------------
' releaseLibraryTask
'-------------------------------------------------------------------------------
sub releaseLibraryTask()
    task = m.library.task
    m.library.task = invalid
    if task = invalid then return
    task.unobserveField("response")
    task.control = TaskControl.Command.Stop
    m.top.removeChild(task)
end sub

'-------------------------------------------------------------------------------
' loadLibrary
'-------------------------------------------------------------------------------
sub loadLibrary()
    if not m.library.active then return
    m.library.loading = true
    releaseLibraryTask()
    m.browse.ready = false
    syncDvdBrowseControls()
    m.library.generation++
    m.nodes.status.text = ""
    m.nodes.grid.visible = false
    m.nodes.name.text = "DVD libraries"
    if m.library.view = DvdMenu.BrowserView.Library then m.nodes.name.text = "DVD: " + Strings.ToString(m.top.loadRequest.library.name, "Library")
    m.nodes.spinner.control = SpinnerControl.Command.Start
    m.top.setFocus(true)
    task = m.top.createChild("DvdDemoTask")
    m.library.task = task
    request = {}
    request.Append(m.top.loadRequest)
    request.action = DvdMenu.Request.Catalog
    if m.library.view = DvdMenu.BrowserView.Library then request.action = DvdMenu.Request.Library
    request.requestId = m.library.generation
    task.request = request
    m.top.taskCreated = task
    task.observeField("response", "onLibraryResponse")
    task.control = TaskControl.Command.Run
end sub

'-------------------------------------------------------------------------------
' onLibraryResponse
'-------------------------------------------------------------------------------
sub onLibraryResponse(event as object)
    if not m.library.active or m.library.task = invalid then return
    if not event.getRoSGNode().isSameNode(m.library.task) then return
    response = event.getData()
    if response.requestId <> m.library.generation then return
    request = m.library.task.request
    releaseLibraryTask()
    m.nodes.spinner.control = SpinnerControl.Command.Stop
    if response.authExpired = true then
        deactivate()
        m.top.authenticationRequired = { request: request, response: response }
        return
    end if
    if response.ok <> true then
        m.nodes.grid.visible = false
        m.nodes.status.text = Strings.ToString(response.errorMessage, "Unable to load DVDs.") + Chr(10) + "Press OK to retry or Back to return."
        m.top.setFocus(true)
        return
    end if
    if m.library.view = DvdMenu.BrowserView.Catalog then
        m.library.libraries = response.payload
        if m.library.libraries.Count() = 1 then
            openLibrary(m.library.libraries[0])
        else
            showLibraries()
        end if
    else
        m.browse.ready = true
        renderGroups(sortLibraryGroups(groupLibraryDiscs(response.payload), m.browse.selection))
    end if
end sub

'-------------------------------------------------------------------------------
' renderGroups
'-------------------------------------------------------------------------------
sub renderGroups(groups as object, focusGrid = true as boolean)
    m.library.rendering = true
    applyLibraryLayout()
    restoreIndex = m.library.index
    if m.library.entryPending then restoreIndex = 0
    if restoreIndex >= groups.Count() then restoreIndex = groups.Count() - 1
    if restoreIndex < 0 then restoreIndex = 0
    content = CreateObject("roSGNode", "ContentNode")
    session = m.top.loadRequest
    for index = 0 to groups.Count() - 1
        group = groups[index]
        if not m.library.entryPending and group.key = m.library.key then restoreIndex = index
        caption = Strings.ToString(group.year)
        discCountLabel = ""
        if group.discs.Count() > 1 then discCountLabel = group.discs.Count().ToStr() + " discs"
        if m.library.view = DvdMenu.BrowserView.Catalog then caption = Strings.ToString(group.library.titleCount, "0") + " DVDs"
        card = content.createChild("ContentNode")
        card.title = group.name
        libraryId = ""
        if group.library <> invalid then libraryId = group.library.id
        card.addFields({ cardLayout: m.layout.spec, caption: caption, discCountLabel: discCountLabel, posterPath: group.posterPath, metadataId: group.metadataId, libraryId: libraryId, session: { server: session.server, token: session.token, userId: session.userId } })
    end for
    m.library.groups = groups
    m.nodes.grid.content = content
    m.nodes.grid.visible = groups.Count() > 0
    m.nodes.status.text = ""
    if groups.Count() = 0 then
        m.nodes.status.text = "No published DVD scans are available in this library. Press OK to refresh or Back to return."
        if m.library.view = DvdMenu.BrowserView.Catalog then m.nodes.status.text = "No enabled DVD libraries are available. Press OK to refresh or Back to return."
    else
        m.nodes.grid.jumpToItem = restoreIndex
        m.nodes.grid.itemFocused = restoreIndex
        showGroup(restoreIndex)
    end if
    m.library.entryPending = false
    m.library.loading = false
    m.library.rendering = false
    if focusGrid then focusBrowser()
end sub

'-------------------------------------------------------------------------------
' showGroup
'-------------------------------------------------------------------------------
sub showGroup(index as integer)
    if index < 0 or index >= m.library.groups.Count() then return
    group = m.library.groups[index]
    m.library.index = index
    m.library.key = group.key
end sub

'-------------------------------------------------------------------------------
' onGroupFocused
'-------------------------------------------------------------------------------
sub onGroupFocused()
    if not m.library.active or m.library.loading or m.library.rendering then return
    if not m.nodes.grid.visible or not m.nodes.grid.isInFocusChain() then return
    showGroup(m.nodes.grid.itemFocused)
end sub

'-------------------------------------------------------------------------------
' onGroupSelected
'-------------------------------------------------------------------------------
sub onGroupSelected()
    if not m.library.active or m.library.loading or m.library.rendering or m.library.task <> invalid then return
    index = m.nodes.grid.itemSelected
    if index < 0 or index >= m.library.groups.Count() then return
    showGroup(index)
    group = m.library.groups[index]
    if m.library.view = DvdMenu.BrowserView.Catalog then
        openLibrary(group.library)
        return
    end if
    if group.discs.Count() = 1 then
        m.top.discSelected = group.discs[0]
    else
        m.top.overlayRequested = { id: DvdMenu.Overlay.Discs, componentName: "DvdDiscDialog", openFunction: "openPicker", closeField: "closeRequested", groupKey: group.key, groupName: group.name, discs: group.discs }
    end if
end sub

'-------------------------------------------------------------------------------
' handleDiscPickerClosed
'-------------------------------------------------------------------------------
sub handleDiscPickerClosed(groupKey as string, selectedDisc as dynamic)
    if not m.library.active then return
    if selectedDisc <> invalid and groupKey = m.library.key then
        for each disc in m.library.groups[m.library.index].discs
            if DvdPaths.SameId(disc.id, selectedDisc.id) then
                m.top.discSelected = disc
                return
            end if
        end for
    end if
    focusBrowser()
end sub

'-------------------------------------------------------------------------------
' focusBrowser
'-------------------------------------------------------------------------------
sub focusBrowser()
    if not m.library.active then return
    if m.nodes.grid.visible and m.library.task = invalid then
        m.nodes.grid.setFocus(true)
    else
        m.top.setFocus(true)
    end if
end sub

'-------------------------------------------------------------------------------
' onKeyEvent
'-------------------------------------------------------------------------------
function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if handleDvdBrowseKey(key) then return true
    if key = Remote.Key.Up then
        if not m.nodes.grid.visible or m.nodes.grid.itemFocused < m.nodes.grid.numColumns then
            m.top.focusExitUp = true
            return true
        end if
    end if
    if key = Remote.Key.Back then
        if m.library.view = DvdMenu.BrowserView.Library and m.library.libraries.Count() > 1 then
            showLibraries()
        else
            m.top.closeRequested = true
        end if
        return true
    end if
    if key = Remote.Key.OK and not m.nodes.grid.visible then
        if m.library.task = invalid then loadLibrary()
        return true
    end if
    return false
end function

'-------------------------------------------------------------------------------
' showLibraries
'-------------------------------------------------------------------------------
sub showLibraries()
    releaseLibraryTask()
    m.nodes.spinner.control = SpinnerControl.Command.Stop
    m.library.view = DvdMenu.BrowserView.Catalog
    m.library.entryPending = false
    m.browse.ready = false
    m.library.key = m.library.catalogKey
    m.library.index = 0
    m.nodes.name.text = "DVD libraries"
    groups = []
    for each library in m.library.libraries
        groups.Push({ key: library.id, name: library.name, library: library, discs: [], posterPath: Strings.ToString(library.artworkPath), metadataId: "", year: "" })
    end for
    renderGroups(groups)
end sub

'-------------------------------------------------------------------------------
' openLibrary
'-------------------------------------------------------------------------------
sub openLibrary(library as object)
    m.library.loading = true
    m.library.entryPending = true
    m.library.catalogKey = library.id
    m.library.view = DvdMenu.BrowserView.Library
    m.library.key = ""
    m.library.index = 0
    request = {}
    request.Append(m.top.loadRequest)
    request.library = library
    m.top.loadRequest = request
    restoreDvdBrowseState()
    loadLibrary()
end sub

'-------------------------------------------------------------------------------
' applyLibraryLayout
'-------------------------------------------------------------------------------
sub applyLibraryLayout()
    spec = VideoCardGridLayout.GetSpec("poster", "cards", m.layout.columns)
    if m.library.view = DvdMenu.BrowserView.Catalog then spec = VideoCardGridLayout.GetSpec("thumbnail", "cards", 4)
    m.layout.spec = spec
    m.nodes.grid.numColumns = spec.numColumns
    m.nodes.grid.numRows = spec.numRows
    m.nodes.grid.itemSize = spec.itemSize
    ' DVD cards reserve both title and caption lines; keep rows separated.
    m.nodes.grid.itemSpacing = [spec.itemSpacing[0], 24]
    m.nodes.grid.focusBitmapUri = spec.focusBitmapUri
    gridTop = 225
    ' Three-column posters use the shared top position to keep titles on screen.
    if m.library.view = DvdMenu.BrowserView.Library and m.layout.columns = 3 then gridTop = spec.translation[1]
    m.nodes.grid.translation = [spec.translation[0], gridTop]
    artworkRight = VideoCardGridLayout.GetVisibleRightEdge(m.nodes.grid, spec)
    sortLeft = artworkRight - 48
    m.nodes.browse.translation = [sortLeft - 8 - m.nodes.browse.buttonWidth, 132]
    m.nodes.sort.translation = [sortLeft, 132]
    syncDvdBrowseControls()
end sub

'-------------------------------------------------------------------------------
' onDvdLayoutChanged
'-------------------------------------------------------------------------------
sub onDvdLayoutChanged()
    titleLayout = LibraryLayoutSetting.Parse(SettingsStore.GetSettingValue(m.top.settings, SettingsStore.Key.DvdTitlesLayout))
    if titleLayout.columns = m.layout.columns then return
    m.layout.columns = titleLayout.columns
    if m.library.view = DvdMenu.BrowserView.Library and m.browse.ready then
        renderGroups(m.library.groups, false)
    end if
end sub
