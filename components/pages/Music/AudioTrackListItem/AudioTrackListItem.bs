import "pkg:/source/Format.bs"
import "pkg:/source/String.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.background = m.top.findNode("background")
    m.numberLabel = m.top.findNode("numberLabel")
    m.titleLabel = m.top.findNode("titleLabel")
    m.durationLabel = m.top.findNode("durationLabel")
    renderFocus()
end sub

'-------------------------------------------------------------------------------
' renderFocus
'-------------------------------------------------------------------------------
sub renderFocus()
    if m.top.itemHasFocus = true or m.top.focusPercent > 0 then
        m.numberLabel.color = &h162231FF
        m.titleLabel.color = &h08111DFF
        m.durationLabel.color = &h162231FF
    else
        m.numberLabel.color = &hB9C7D6FF
        m.titleLabel.color = &hF3F7FBFF
        m.durationLabel.color = &hB9C7D6FF
    end if
end sub

'-------------------------------------------------------------------------------
' render
'-------------------------------------------------------------------------------
sub render()
    item = m.top.itemContent
    if item = invalid then return
    m.numberLabel.text = Format.SafeString(item.trackNumber, "")
    m.titleLabel.text = Format.FirstNonEmpty([item.title], "Untitled Track")
    m.durationLabel.text = Format.SafeString(item.durationText, "")
    m.background.visible = item.isCurrent = true
end sub
