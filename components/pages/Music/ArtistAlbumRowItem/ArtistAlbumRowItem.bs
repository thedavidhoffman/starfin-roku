import "pkg:/source/String.bs"
import "pkg:/source/Format.bs"
import "pkg:/source/MaskAssets.bs"
import "pkg:/source/ResolutionProfile.bs"
import "pkg:/source/ResolutionAssets.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    MaskAssets.Apply(m.top.findNode("albumMask"), "album-mask-300.png", [300, 300], [200, 200])
    m.artwork = m.top.findNode("albumArtwork")
    m.albumLabel = m.top.findNode("albumLabel")
    m.yearLabel = m.top.findNode("yearLabel")

    ' Observe only after initialization, then render any already assigned fields.
    m.top.observeField("itemContent", "onItemContentChanged")
    onItemContentChanged()
end sub

'-------------------------------------------------------------------------------
' onItemContentChanged
'-------------------------------------------------------------------------------
sub onItemContentChanged()
    item = m.top.itemContent
    if item = invalid then return

    m.artwork.uri = item.HDPosterUrl
    m.albumLabel.text = Format.FirstNonEmpty([item.title], "Untitled Album")
    m.yearLabel.text = Strings.ToString(item.releaseYear)
end sub
