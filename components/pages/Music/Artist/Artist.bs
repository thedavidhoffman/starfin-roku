'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.log = new Logger("MusicArtist", m.global.logService)
    m.mediaShell = m.top.findNode("mediaShell")
    m.albumsRow = m.top.findNode("albumsRow")
    m.artistTask = m.top.findNode("artistTask")
    m.artistAlbumsTask = m.top.findNode("artistAlbumsTask")
    m.mediaShell.observeField("overlayRequested", "onMediaShellOverlayRequested")
    m.artistTask.observeField("response", "onArtistResponse")
    m.artistAlbumsTask.observeField("response", "onArtistAlbumsResponse")
    m.albumsRow.observeField("rowItemSelected", "onAlbumSelected")
    m.albumsRow.observeField("rowItemFocused", "onAlbumFocused")
    m.state = {
        request: invalid
        overview: ""
        albums: []
        albumLoad: {
            status: "idle"
            queryId: 0
            requestInFlight: false
            nextStartIndex: 0
            totalCount: -1
            hasMore: false
        }
        lifecycle: AsyncLifecycle.Create()
    }
end sub

'-------------------------------------------------------------------------------
' onAlbumSelected
'-------------------------------------------------------------------------------
sub onAlbumSelected()
    selected = m.albumsRow.rowItemSelected
    if selected = invalid or selected.Count() < 2 then return
    row = m.albumsRow.content.getChild(selected[0])
    if row = invalid then return
    node = row.getChild(selected[1])
    if node = invalid or node.raw = invalid then return
    m.top.selectedAlbum = { itemId: Format.SafeString(node.raw.Id, ""), item: node.raw }
end sub

'-------------------------------------------------------------------------------
' onLoadRequestChanged
'-------------------------------------------------------------------------------
sub onLoadRequestChanged()
    request = m.top.loadRequest
    if request = invalid then return

    m.state.request = request
    m.state.overview = "Loading artist overview..."
    AsyncLifecycle.Begin(m.state.lifecycle, request.itemId)
    applyBackgroundSetting(request.settings)
    renderArtist()
    renderAlbums([])
    m.state.albums = []
    m.state.albumLoad.status = "loading"
    m.state.albumLoad.queryId = m.state.albumLoad.queryId + 1
    m.state.albumLoad.requestInFlight = false
    m.state.albumLoad.nextStartIndex = 0
    m.state.albumLoad.totalCount = -1
    m.state.albumLoad.hasMore = false
    loadAlbumPage(0)

    artistId = Format.SafeString(request.musicBrainzArtistId, "")
    if artistId = "" then
        m.state.overview = "No Wikipedia overview is available for this artist."
        renderArtist()
        return
    end if

    m.artistTask.request = { artistId: artistId }
    m.artistTask.control = "run"
end sub

'-------------------------------------------------------------------------------
' onArtistAlbumsResponse
'-------------------------------------------------------------------------------
sub onArtistAlbumsResponse()
    response = m.artistAlbumsTask.response
    if m.state.lifecycle.isActive <> true then return
    if response = invalid then return
    if Format.SafeString(response.libraryId, "") <> Format.SafeString(m.state.request.libraryId, "") then return
    if Number.ToInteger(response.queryId, -1) <> m.state.albumLoad.queryId then return
    if response.ok <> true then
        m.state.albumLoad.requestInFlight = false
        m.state.albumLoad.status = "failed"
        m.state.albumLoad.hasMore = false
        return
    end if

    startIndex = Number.ToInteger(response.startIndex, -1)
    expectedStartIndex = m.state.albumLoad.nextStartIndex
    if startIndex <> expectedStartIndex then
        m.state.albumLoad.requestInFlight = false
        m.state.albumLoad.status = "failed"
        m.state.albumLoad.hasMore = false
        m.log.error("Artist album page rejected artistId=" + Format.SafeString(m.state.request.itemId, "") + " expectedStartIndex=" + expectedStartIndex.ToStr() + " receivedStartIndex=" + startIndex.ToStr())
        return
    end if
    m.state.albumLoad.requestInFlight = false
    albums = getItemsFromAlbumPayload(response.payload)
    for each album in albums
        m.state.albums.Push(album)
    end for
    m.state.albumLoad.status = "loaded"
    m.state.albumLoad.nextStartIndex = Number.ToInteger(response.nextStartIndex, startIndex + albums.Count())
    m.state.albumLoad.totalCount = Number.ToInteger(response.totalRecordCount, m.state.albums.Count())
    m.state.albumLoad.hasMore = response.hasMore = true
    if startIndex = 0 then
        renderAlbums(albums)
        if m.top.visible = true and m.albumsRow.visible = true and m.mediaShell.isInFocusChain() <> true and m.albumsRow.isInFocusChain() <> true then
            m.top.setFocus(true)
            m.albumsRow.setFocus(true)
        end if
    else
        appendAlbums(albums)
    end if
    requestNextAlbumPageIfNeeded()
end sub

'-------------------------------------------------------------------------------
' loadAlbumPage
'-------------------------------------------------------------------------------
sub loadAlbumPage(startIndex as integer)
    request = m.state.request
    albumRequest = {
        server: request.server
        token: request.token
        userId: request.userId
        libraryId: request.libraryId
        artistIds: request.itemId
        pageStartIndex: startIndex
        queryId: m.state.albumLoad.queryId
        albumSortOrder: "Ascending"
        albumSortBy: "ProductionYear,SortName"
    }
    m.state.albumLoad.requestInFlight = true
    m.artistAlbumsTask.control = "stop"
    m.artistAlbumsTask.request = albumRequest
    m.artistAlbumsTask.control = "run"
end sub

'-------------------------------------------------------------------------------
' onAlbumFocused
'-------------------------------------------------------------------------------
sub onAlbumFocused()
    requestNextAlbumPageIfNeeded()
end sub

'-------------------------------------------------------------------------------
' requestNextAlbumPageIfNeeded
'-------------------------------------------------------------------------------
sub requestNextAlbumPageIfNeeded()
    if m.state.albumLoad.hasMore <> true or m.state.albumLoad.requestInFlight = true then return
    focused = m.albumsRow.rowItemFocused
    if focused = invalid or focused.Count() < 2 then return
    if Number.ToInteger(focused[1], 0) < m.state.albums.Count() - 5 then return

    m.state.albumLoad.status = "loading"
    loadAlbumPage(m.state.albumLoad.nextStartIndex)
end sub

'-------------------------------------------------------------------------------
' getItemsFromAlbumPayload
'-------------------------------------------------------------------------------
function getItemsFromAlbumPayload(payload as dynamic) as object
    if Type(payload) = "roArray" then return payload
    if payload <> invalid and Type(payload.Items) = "roArray" then return payload.Items
    return []
end function

'-------------------------------------------------------------------------------
' renderAlbums
'-------------------------------------------------------------------------------
sub renderAlbums(albums as dynamic)
    if albums = invalid then albums = []

    content = CreateObject("roSGNode", "ContentNode")
    row = content.createChild("ContentNode")
    request = m.state.request
    for each album in albums
        addAlbumNode(row, album, request)
    end for

    hasAlbums = row.getChildCount() > 0
    m.albumsRow.content = content
    m.albumsRow.visible = hasAlbums
end sub

'-------------------------------------------------------------------------------
' appendAlbums
'-------------------------------------------------------------------------------
sub appendAlbums(albums as object)
    content = m.albumsRow.content
    if content = invalid or content.getChildCount() = 0 then
        renderAlbums(albums)
        return
    end if

    row = content.getChild(0)
    request = m.state.request
    for each album in albums
        addAlbumNode(row, album, request)
    end for
    m.albumsRow.visible = row.getChildCount() > 0
end sub

'-------------------------------------------------------------------------------
' addAlbumNode
'-------------------------------------------------------------------------------
sub addAlbumNode(row as object, album as object, request as object)
    child = row.createChild("ContentNode")
    child.title = Format.FirstNonEmpty([album.Name], "Untitled Album")
    child.HDPosterUrl = getAlbumArtworkUrl(album, request)
    child.AddFields({ releaseYear: getAlbumReleaseYear(album), raw: album })
end sub

'-------------------------------------------------------------------------------
' getAlbumArtworkUrl
'-------------------------------------------------------------------------------
function getAlbumArtworkUrl(album as object, request as object) as string
    itemId = Format.SafeString(album.Id, "")
    tag = ""
    if album.ImageTags <> invalid then tag = Format.SafeString(album.ImageTags.Primary, "")
    if itemId = "" or tag = "" then return "pkg:/images/music/album-placeholder-300x300.png"

    return Url.BuildImageUrl(request.server, itemId, "Primary", tag, 300, 300)
end function

'-------------------------------------------------------------------------------
' getAlbumReleaseYear
'-------------------------------------------------------------------------------
function getAlbumReleaseYear(album as object) as string
    year = Number.ToInteger(album.ProductionYear, 0)
    if year <= 0 then
        premiereDate = Format.SafeString(album.PremiereDate, "")
        if Len(premiereDate) >= 4 then year = Number.ToInteger(Left(premiereDate, 4), 0)
    end if
    if year <= 0 then return ""
    return year.ToStr()
end function

'-------------------------------------------------------------------------------
' onArtistResponse
'-------------------------------------------------------------------------------
sub onArtistResponse()
    response = m.artistTask.response
    request = m.state.request
    if response = invalid or request = invalid then return
    if m.state.lifecycle.isActive <> true then return
    if Format.SafeString(response.artistId, "") <> Format.SafeString(request.musicBrainzArtistId, "") then return

    if response.ok = true then
        m.state.overview = Format.SafeString(response.extract, "")
    else
        m.state.overview = "Wikipedia overview unavailable."
    end if
    renderArtist()
end sub

'-------------------------------------------------------------------------------
' renderArtist
'-------------------------------------------------------------------------------
sub renderArtist()
    request = m.state.request
    if request = invalid then return

    item = request.item
    title = "Unknown Artist"
    if item <> invalid then title = Format.FirstNonEmpty([item.Name], title)
    m.mediaShell.mediaContent = {
        mediaType: "artist"
        title: title
        logoUrl: Format.SafeString(request.logoUrl, "")
        logoPending: false
        backdropUrl: Format.SafeString(request.backdropUrl, "")
        primaryInfoText: "Artist"
        secondaryInfoText: ""
        overview: m.state.overview
    }
end sub

'-------------------------------------------------------------------------------
' applyBackgroundSetting
'-------------------------------------------------------------------------------
sub applyBackgroundSetting(settings as dynamic)
    m.mediaShell.backgroundDisplay = SettingsStore.GetSettingValue(settings, SettingsStore.Key.MediaShellBackground)
end sub

'-------------------------------------------------------------------------------
' onMediaShellOverlayRequested
'-------------------------------------------------------------------------------
sub onMediaShellOverlayRequested()
    request = m.mediaShell.overlayRequested
    if request = invalid then return
    request.sourcePage = "musicArtist"
    m.top.overlayRequested = request
end sub

'-------------------------------------------------------------------------------
' handleDescriptionOverlayClosed
'-------------------------------------------------------------------------------
sub handleDescriptionOverlayClosed()
    m.mediaShell.callFunc("focusDescription")
end sub

'-------------------------------------------------------------------------------
' activate
'-------------------------------------------------------------------------------
sub activate()
    AsyncLifecycle.BeginFromField(m.state.lifecycle, m.state.request, "itemId")
    if m.state.albumLoad.status = "loading" and m.state.albumLoad.requestInFlight <> true then loadAlbumPage(m.state.albumLoad.nextStartIndex)
    focusArtistContent()
end sub

'-------------------------------------------------------------------------------
' onFocusRequested
'-------------------------------------------------------------------------------
sub onFocusRequested()
    if m.top.visible <> true then return
    focusArtistContent()
end sub

'-------------------------------------------------------------------------------
' focusArtistContent
'-------------------------------------------------------------------------------
sub focusArtistContent()
    m.top.setFocus(true)
    if m.albumsRow.visible = true then
        m.albumsRow.setFocus(true)
    else
        m.mediaShell.callFunc("focusDescription")
    end if
end sub

'-------------------------------------------------------------------------------
' deactivate
'-------------------------------------------------------------------------------
sub deactivate()
    AsyncLifecycle.Deactivate(m.state.lifecycle)
    m.state.albumLoad.requestInFlight = false
    m.state.albumLoad.queryId = m.state.albumLoad.queryId + 1
    m.artistTask.control = "stop"
    m.artistAlbumsTask.control = "stop"
end sub

'-------------------------------------------------------------------------------
' onKeyEvent
'-------------------------------------------------------------------------------
function onKeyEvent(key as string, press as boolean) as boolean
    if press = false then return false
    normalizedKey = LCase(key)
    if normalizedKey = "up" and m.albumsRow.isInFocusChain() then return m.mediaShell.callFunc("focusDescription")
    if normalizedKey = "down" and m.mediaShell.isInFocusChain() and m.albumsRow.visible = true then
        m.albumsRow.setFocus(true)
        return true
    end if
    if normalizedKey <> "back" then return false

    m.top.closeRequested = true
    return true
end function
