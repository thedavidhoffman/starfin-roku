
'-------------------------------------------------------------------------------
' isAlbumBrowseMode
'-------------------------------------------------------------------------------
function isAlbumBrowseMode() as boolean
    return Format.SafeString(m.state.browse.selection.optionKey, LibraryBrowse.Option.Album) = LibraryBrowse.Option.Album
end function

'-------------------------------------------------------------------------------
' isArtistBrowseMode
'-------------------------------------------------------------------------------
function isArtistBrowseMode() as boolean
    return Format.SafeString(m.state.browse.selection.optionKey, LibraryBrowse.Option.Album) = LibraryBrowse.Option.Artist
end function

'-------------------------------------------------------------------------------
' getMusicSortOptions
'-------------------------------------------------------------------------------
function getMusicSortOptions() as object
    options = [
        { optionKey: LibraryBrowse.Option.Album, sortKey: LibraryBrowse.SortKey.Album, sortOrder: LibraryBrowse.SortOrder.Ascending, label: "Album" }
        { optionKey: LibraryBrowse.Option.ArtistAlbum, sortKey: LibraryBrowse.SortKey.ArtistAlbum, sortOrder: LibraryBrowse.SortOrder.Ascending, label: "Artist/Album" }
        { optionKey: LibraryBrowse.Option.Artist, sortKey: LibraryBrowse.SortKey.Artist, sortOrder: LibraryBrowse.SortOrder.Ascending, label: "Artist" }
        { optionKey: LibraryBrowse.Option.Favorites, sortKey: LibraryBrowse.SortKey.Album, sortOrder: LibraryBrowse.SortOrder.Ascending, label: "Favorites" }
    ]
    if m.state.filters.options.decadeOptions.Count() > 0 then options.Push({ optionKey: LibraryBrowse.Option.Decade, sortKey: "", sortOrder: "", label: "Decade" })
    if m.state.filters.options.genreOptions.Count() > 0 then options.Push({ optionKey: LibraryBrowse.Option.Genre, sortKey: "", sortOrder: "", label: "Genre" })
    return options
end function

'-------------------------------------------------------------------------------
' isFavoriteBrowseActive
'-------------------------------------------------------------------------------
function isFavoriteBrowseActive() as boolean
    return Format.SafeString(m.state.browse.selection.optionKey, "") = LibraryBrowse.Option.Favorites
end function

'-------------------------------------------------------------------------------
' isFilteredAlbumBrowseActive
'-------------------------------------------------------------------------------
function isFilteredAlbumBrowseActive() as boolean
    return LibraryBrowse.IsDecadeActive(m.state.browse.filterType) or LibraryBrowse.IsGenreActive(m.state.browse.filterType)
end function

'-------------------------------------------------------------------------------
' syncSortControls
'-------------------------------------------------------------------------------
sub syncSortControls()
    m.browseByButton.selectedSort = m.state.browse.selection
    m.sortButton.selectedSort = m.state.browse.selection
    m.sortButton.sortEnabled = canUseSortOrder(m.state.browse.selection)
end sub

'-------------------------------------------------------------------------------
' canUseSortOrder
'-------------------------------------------------------------------------------
function canUseSortOrder(selection as object) as boolean
    if selection = invalid then return false

    optionKey = Format.SafeString(selection.optionKey, "")
    if optionKey = LibraryBrowse.Option.Decade or optionKey = LibraryBrowse.Option.Genre then return false

    sortKey = Format.SafeString(selection.sortKey, "")
    return sortKey = LibraryBrowse.SortKey.Album or sortKey = LibraryBrowse.SortKey.ArtistAlbum or sortKey = LibraryBrowse.SortKey.Artist
end function

'-------------------------------------------------------------------------------
' onSortOverlayRequested
'-------------------------------------------------------------------------------
sub onSortOverlayRequested()
    request = m.browseByButton.overlayRequested
    if request = invalid then return

    request.sourcePage = "musicLibrary"
    request.selectedSortKey = m.state.browse.selection.optionKey
    request.sortOptions = getMusicSortOptions()
    m.top.overlayRequested = request
end sub

'-------------------------------------------------------------------------------
' onSortOrderChanged
'-------------------------------------------------------------------------------
sub onSortOrderChanged()
    selection = m.sortButton.sortOrderChanged
    if selection = invalid then return
    if canUseSortOrder(m.state.browse.selection) <> true then return

    sortOrder = LibraryBrowse.NormalizeSortOrder(selection.sortOrder)
    if Format.SafeString(m.state.browse.selection.sortOrder, LibraryBrowse.SortOrder.Ascending) = sortOrder then return

    m.state.browse.selection.sortOrder = sortOrder
    syncSortControls()
    persistMusicLibraryViewState()
    if isArtistBrowseMode() then
        startArtistQuery()
    else if isFilteredAlbumBrowseActive() then
        scheduleFilteredRefresh()
    else
        reloadMusicLibrary()
    end if
end sub

'-------------------------------------------------------------------------------
' applySortSelection
'-------------------------------------------------------------------------------
function applySortSelection(selection as object) as boolean
    if selection = invalid then return false

    optionKey = Format.SafeString(selection.optionKey, "")
    if optionKey = "" then return false
    if optionKey = m.state.browse.selection.optionKey then
        if optionKey = LibraryBrowse.Option.Artist and m.state.content.artists.load.status = "failed" then
            startArtistQuery()
            return true
        end if
        if optionKey <> LibraryBrowse.Option.Artist and m.state.content.albums.load.status = "failed" then
            if optionKey = LibraryBrowse.Option.Decade or optionKey = LibraryBrowse.Option.Genre then m.state.loadingUi.foreground.focusAfterLoad = "filter"
            reloadMusicLibrary()
            return true
        end if
        return false
    end if

    cancelPendingArtistLoad()
    applyMusicBrowseMode(optionKey)
    syncSortControls()
    persistMusicLibraryViewState()
    return startMusicBrowseMode(optionKey)
end function

'-------------------------------------------------------------------------------
' applyMusicBrowseMode
'-------------------------------------------------------------------------------
sub applyMusicBrowseMode(optionKey as string)
    m.state.browse.filterType = ""
    m.state.browse.decade = -1
    m.state.browse.genre = ""
    hideFilterButtonRow()

    if optionKey = LibraryBrowse.Option.Decade then
        m.state.browse.selection = LibraryBrowse.CreateSortSelection(LibraryBrowse.Option.Decade, LibraryBrowse.SortKey.Album, "Decade")
        m.state.browse.filterType = LibraryBrowse.Option.Decade
        m.state.browse.decade = LibraryBrowse.ResolveDecade(m.state.filters.options.decadeOptions, -1)
        showDecadeFilterRow()
    else if optionKey = LibraryBrowse.Option.Genre then
        m.state.browse.selection = LibraryBrowse.CreateSortSelection(LibraryBrowse.Option.Genre, LibraryBrowse.SortKey.Album, "Genre")
        m.state.browse.filterType = LibraryBrowse.Option.Genre
        m.state.browse.genre = LibraryBrowse.ResolveGenre(m.state.filters.options.genreOptions, "")
        showGenreFilterRow()
    else if optionKey = LibraryBrowse.Option.ArtistAlbum then
        m.state.browse.selection = LibraryBrowse.CreateSortSelection(LibraryBrowse.Option.ArtistAlbum, LibraryBrowse.SortKey.ArtistAlbum, "Artist/Album")
    else if optionKey = LibraryBrowse.Option.Artist then
        m.state.browse.selection = LibraryBrowse.CreateSortSelection(LibraryBrowse.Option.Artist, LibraryBrowse.SortKey.Artist, "Artist")
    else if optionKey = LibraryBrowse.Option.Favorites then
        m.state.browse.selection = LibraryBrowse.CreateSortSelection(LibraryBrowse.Option.Favorites, LibraryBrowse.SortKey.Album, "Favorites")
    else
        m.state.browse.selection = LibraryBrowse.CreateSortSelection(LibraryBrowse.Option.Album, LibraryBrowse.SortKey.Album, "Album")
    end if
end sub

'-------------------------------------------------------------------------------
' startMusicBrowseMode
'-------------------------------------------------------------------------------
function startMusicBrowseMode(optionKey as string) as boolean
    if optionKey = LibraryBrowse.Option.Artist then
        m.state.loadingUi.foreground.focusAfterLoad = ""
        startArtistQuery()
        return true
    end if

    if optionKey = LibraryBrowse.Option.Decade or optionKey = LibraryBrowse.Option.Genre then
        scheduleFilteredRefresh()
        return false
    end if

    m.state.loadingUi.foreground.focusAfterLoad = ""
    reloadMusicLibrary()
    return true
end function

'-------------------------------------------------------------------------------
' showDecadeFilterRow
'-------------------------------------------------------------------------------
sub showDecadeFilterRow()
    options = m.state.filters.options.decadeOptions
    if options = invalid then options = []
    m.state.browse.decade = LibraryBrowse.ResolveDecade(options, m.state.browse.decade)

    m.filterButtonRow.filterType = LibraryBrowse.Option.Decade
    m.filterButtonRow.items = options
    m.filterButtonRow.selectedValue = m.state.browse.decade.ToStr()
    filterVisible = options.Count() > 0
    if m.state.loadingUi.foreground.controlsHidden then
        m.state.loadingUi.foreground.restoreFilterVisible = filterVisible
        m.filterButtonRow.visible = false
    else
        m.filterButtonRow.visible = filterVisible
    end if
    updateGridLayout()
end sub

'-------------------------------------------------------------------------------
' showGenreFilterRow
'-------------------------------------------------------------------------------
sub showGenreFilterRow()
    options = m.state.filters.options.genreOptions
    if options = invalid then options = []
    m.state.browse.genre = LibraryBrowse.ResolveGenre(options, m.state.browse.genre)

    m.filterButtonRow.filterType = LibraryBrowse.Option.Genre
    m.filterButtonRow.items = options
    m.filterButtonRow.selectedValue = m.state.browse.genre
    filterVisible = options.Count() > 0
    if m.state.loadingUi.foreground.controlsHidden then
        m.state.loadingUi.foreground.restoreFilterVisible = filterVisible
        m.filterButtonRow.visible = false
    else
        m.filterButtonRow.visible = filterVisible
    end if
    updateGridLayout()
end sub

'-------------------------------------------------------------------------------
' getSelectedDecadeYears
'-------------------------------------------------------------------------------
function getSelectedDecadeYears() as object
    years = []
    if m.state.browse.decade >= 0 then
        for year = m.state.browse.decade to m.state.browse.decade + 9
            years.Push(year.ToStr())
        end for
    end if
    return years
end function

'-------------------------------------------------------------------------------
' hideFilterButtonRow
'-------------------------------------------------------------------------------
sub hideFilterButtonRow()
    if m.state.loadingUi.foreground.controlsHidden then m.state.loadingUi.foreground.restoreFilterVisible = false
    m.filterButtonRow.visible = false
    m.filterButtonRow.items = []
    m.filterButtonRow.selectedValue = ""
    updateGridLayout()
end sub

'-------------------------------------------------------------------------------
' updateGridLayout
'-------------------------------------------------------------------------------
sub updateGridLayout()
    y = 208
    if m.filterButtonRow <> invalid and m.filterButtonRow.visible = true then y = 292
    m.musicGrid.translation = [48, y]
end sub

'-------------------------------------------------------------------------------
' onFilterButtonRowSelected
'-------------------------------------------------------------------------------
sub onFilterButtonRowSelected()
    selected = m.filterButtonRow.filterSelected
    if selected = invalid then return

    filterType = Format.SafeString(selected.type, "")
    if filterType = LibraryBrowse.Option.Decade then
        m.state.browse.decade = Number.ToInteger(selected.value, -1)
        m.filterButtonRow.selectedValue = m.state.browse.decade.ToStr()
    else if filterType = LibraryBrowse.Option.Genre then
        m.state.browse.genre = Format.SafeString(selected.value, "")
        m.filterButtonRow.selectedValue = m.state.browse.genre
    else
        return
    end if

    persistMusicLibraryViewState()
    scheduleFilteredRefresh()
end sub

'-------------------------------------------------------------------------------
' applySavedMusicLibraryViewState
'-------------------------------------------------------------------------------
sub applySavedMusicLibraryViewState(state as object)
    optionKey = LibraryBrowse.NormalizeMusicOption(state.optionKey)
    sortOrder = LibraryBrowse.NormalizeSortOrder(state.sortOrder)
    m.state.browse.filterType = ""
    m.state.browse.decade = -1
    m.state.browse.genre = ""

    if optionKey = LibraryBrowse.Option.Favorites then
        m.state.browse.selection = LibraryBrowse.CreateSortSelection(LibraryBrowse.Option.Favorites, LibraryBrowse.SortKey.Album, "Favorites", sortOrder)
    else if optionKey = LibraryBrowse.Option.Decade or optionKey = LibraryBrowse.Option.Genre then
        m.state.browse.selection = LibraryBrowse.CreateSortSelection(optionKey, LibraryBrowse.SortKey.Album, optionKey)
        m.state.browse.filterType = optionKey
        m.state.browse.decade = Number.ToInteger(state.selectedDecade, -1)
        m.state.browse.genre = Format.SafeString(state.selectedGenre, "")
    else if optionKey = LibraryBrowse.Option.ArtistAlbum then
        m.state.browse.selection = LibraryBrowse.CreateSortSelection(LibraryBrowse.Option.ArtistAlbum, LibraryBrowse.SortKey.ArtistAlbum, "Artist/Album", sortOrder)
    else if optionKey = LibraryBrowse.Option.Artist then
        m.state.browse.selection = LibraryBrowse.CreateSortSelection(LibraryBrowse.Option.Artist, LibraryBrowse.SortKey.Artist, "Artist", sortOrder)
    else
        m.state.browse.selection = LibraryBrowse.CreateSortSelection(LibraryBrowse.Option.Album, LibraryBrowse.SortKey.Album, "Album", sortOrder)
    end if
end sub

'-------------------------------------------------------------------------------
' persistMusicLibraryViewState
'-------------------------------------------------------------------------------
sub persistMusicLibraryViewState()
    request = m.state.context
    selection = m.state.browse.selection
    if request = invalid or selection = invalid then return

    LibraryViewStateStore.Save(Format.SafeString(request.accountKey, ""), Format.SafeString(request.libraryId, ""), {
        optionKey: LibraryBrowse.NormalizeMusicOption(m.state.browse.selection.optionKey)
        sortKey: Format.SafeString(selection.sortKey, LibraryBrowse.SortKey.Album)
        sortOrder: LibraryBrowse.NormalizeSortOrder(selection.sortOrder)
        selectedDecade: m.state.browse.decade
        selectedGenre: m.state.browse.genre
        libraryTitle: Format.SafeString(request.title, "")
        collectionType: Format.SafeString(request.collectionType, "")
    })
end sub
