
'-------------------------------------------------------------------------------
' isAlbumBrowseMode
'-------------------------------------------------------------------------------
function isAlbumBrowseMode() as boolean
    return Format.SafeString(m.state.browse.selection.optionKey, "Album") = "Album"
end function

'-------------------------------------------------------------------------------
' isArtistBrowseMode
'-------------------------------------------------------------------------------
function isArtistBrowseMode() as boolean
    return Format.SafeString(m.state.browse.selection.optionKey, "Album") = "Artist"
end function

'-------------------------------------------------------------------------------
' getMusicSortOptions
'-------------------------------------------------------------------------------
function getMusicSortOptions() as object
    options = [
        { optionKey: "Album", sortKey: "Album", sortOrder: "Ascending", label: "Album" }
        { optionKey: "ArtistAlbum", sortKey: "ArtistAlbum", sortOrder: "Ascending", label: "Artist/Album" }
        { optionKey: "Artist", sortKey: "Artist", sortOrder: "Ascending", label: "Artist" }
        { optionKey: "Favorites", sortKey: "Album", sortOrder: "Ascending", label: "Favorites" }
    ]
    if m.state.filters.options.decadeOptions.Count() > 0 then options.Push({ optionKey: "Decade", sortKey: "", sortOrder: "", label: "Decade" })
    if m.state.filters.options.genreOptions.Count() > 0 then options.Push({ optionKey: "Genre", sortKey: "", sortOrder: "", label: "Genre" })
    return options
end function

'-------------------------------------------------------------------------------
' isFavoriteBrowseActive
'-------------------------------------------------------------------------------
function isFavoriteBrowseActive() as boolean
    return Format.SafeString(m.state.browse.selection.optionKey, "") = "Favorites"
end function

'-------------------------------------------------------------------------------
' syncSortControls
'-------------------------------------------------------------------------------
sub syncSortControls()
    m.browseByButton.selectedSort = m.state.browse.selection
    m.sortButton.selectedSort = m.state.browse.selection
    m.sortButton.sortEnabled = canUseSortOrder(m.state.browse.selection)
end sub

'-------------------------------------------------------------------------------
' canUseSortOrder
'-------------------------------------------------------------------------------
function canUseSortOrder(selection as object) as boolean
    if selection = invalid then return false

    optionKey = Format.SafeString(selection.optionKey, "")
    if optionKey = "Decade" or optionKey = "Genre" then return false

    sortKey = Format.SafeString(selection.sortKey, "")
    return sortKey = "Album" or sortKey = "ArtistAlbum" or sortKey = "Artist"
end function

'-------------------------------------------------------------------------------
' onSortOverlayRequested
'-------------------------------------------------------------------------------
sub onSortOverlayRequested()
    request = m.browseByButton.overlayRequested
    if request = invalid then return

    request.sourcePage = "musicLibrary"
    request.selectedSortKey = m.state.browse.selection.optionKey
    request.sortOptions = getMusicSortOptions()
    m.top.overlayRequested = request
end sub

'-------------------------------------------------------------------------------
' onSortOrderChanged
'-------------------------------------------------------------------------------
sub onSortOrderChanged()
    selection = m.sortButton.sortOrderChanged
    if selection = invalid then return
    if canUseSortOrder(m.state.browse.selection) <> true then return

    sortOrder = Format.SafeString(selection.sortOrder, "Ascending")
    if sortOrder <> "Descending" then sortOrder = "Ascending"
    if Format.SafeString(m.state.browse.selection.sortOrder, "Ascending") = sortOrder then return

    m.state.browse.selection.sortOrder = sortOrder
    syncSortControls()
    persistMusicLibraryViewState()
    if isArtistBrowseMode() then
        startArtistQuery()
    else
        reloadMusicLibrary()
    end if
end sub

'-------------------------------------------------------------------------------
' applySortSelection
'-------------------------------------------------------------------------------
function applySortSelection(selection as object) as boolean
    if selection = invalid then return false

    optionKey = Format.SafeString(selection.optionKey, "")
    if optionKey = "" then return false
    if optionKey = m.state.browse.selection.optionKey then
        if optionKey = "Artist" and m.state.content.artists.load.status = "failed" then
            startArtistQuery()
            return true
        end if
        if optionKey <> "Artist" and m.state.content.albums.load.status = "failed" then
            if optionKey = "Decade" or optionKey = "Genre" then m.state.loadingUi.foreground.focusAfterLoad = "filter"
            reloadMusicLibrary()
            return true
        end if
        return false
    end if
    cancelPendingArtistLoad()
    m.state.browse.filterType = ""
    m.state.browse.decade = -1
    m.state.browse.genre = ""
    hideFilterButtonRow()

    if optionKey = "Decade" then
        m.state.browse.selection = {
            optionKey: "Decade"
            sortKey: "Album"
            sortOrder: "Ascending"
            label: "Decade"
        }
        m.state.browse.filterType = "Decade"
        m.state.browse.decade = LibraryBrowse.ResolveDecade(m.state.filters.options.decadeOptions, -1)
        showDecadeFilterRow()
    else if optionKey = "Genre" then
        m.state.browse.selection = {
            optionKey: "Genre"
            sortKey: "Album"
            sortOrder: "Ascending"
            label: "Genre"
        }
        m.state.browse.filterType = "Genre"
        m.state.browse.genre = LibraryBrowse.ResolveGenre(m.state.filters.options.genreOptions, "")
        showGenreFilterRow()
    else if optionKey = "ArtistAlbum" then
        m.state.browse.selection = {
            optionKey: "ArtistAlbum"
            sortKey: "ArtistAlbum"
            sortOrder: "Ascending"
            label: "Artist/Album"
        }
    else if optionKey = "Artist" then
        m.state.browse.selection = {
            optionKey: "Artist"
            sortKey: "Artist"
            sortOrder: "Ascending"
            label: "Artist"
        }
    else if optionKey = "Favorites" then
        m.state.browse.selection = LibraryBrowse.CreateSortSelection("Favorites", "Album", "Favorites")
    else
        m.state.browse.selection = LibraryBrowse.CreateSortSelection("Album", "Album", "Album")
    end if

    syncSortControls()
    persistMusicLibraryViewState()
    if optionKey = "Artist" then
        m.state.loadingUi.foreground.focusAfterLoad = ""
        startArtistQuery()
    else
        if optionKey = "Decade" or optionKey = "Genre" then
            m.state.loadingUi.foreground.focusAfterLoad = "filter"
        else
            m.state.loadingUi.foreground.focusAfterLoad = ""
        end if
        reloadMusicLibrary()
    end if
    return true
end function

'-------------------------------------------------------------------------------
' showDecadeFilterRow
'-------------------------------------------------------------------------------
sub showDecadeFilterRow()
    options = m.state.filters.options.decadeOptions
    if options = invalid then options = []
    m.state.browse.decade = LibraryBrowse.ResolveDecade(options, m.state.browse.decade)

    m.filterButtonRow.filterType = "Decade"
    m.filterButtonRow.items = options
    m.filterButtonRow.selectedValue = m.state.browse.decade.ToStr()
    filterVisible = options.Count() > 0
    if m.state.loadingUi.foreground.controlsHidden then
        m.state.loadingUi.foreground.restoreFilterVisible = filterVisible
        m.filterButtonRow.visible = false
    else
        m.filterButtonRow.visible = filterVisible
    end if
    updateGridLayout()
end sub

'-------------------------------------------------------------------------------
' showGenreFilterRow
'-------------------------------------------------------------------------------
sub showGenreFilterRow()
    options = m.state.filters.options.genreOptions
    if options = invalid then options = []
    m.state.browse.genre = LibraryBrowse.ResolveGenre(options, m.state.browse.genre)

    m.filterButtonRow.filterType = "Genre"
    m.filterButtonRow.items = options
    m.filterButtonRow.selectedValue = m.state.browse.genre
    filterVisible = options.Count() > 0
    if m.state.loadingUi.foreground.controlsHidden then
        m.state.loadingUi.foreground.restoreFilterVisible = filterVisible
        m.filterButtonRow.visible = false
    else
        m.filterButtonRow.visible = filterVisible
    end if
    updateGridLayout()
end sub

'-------------------------------------------------------------------------------
' getSelectedDecadeYears
'-------------------------------------------------------------------------------
function getSelectedDecadeYears() as object
    years = []
    if m.state.browse.decade >= 0 then
        for year = m.state.browse.decade to m.state.browse.decade + 9
            years.Push(year.ToStr())
        end for
    end if
    return years
end function

'-------------------------------------------------------------------------------
' hideFilterButtonRow
'-------------------------------------------------------------------------------
sub hideFilterButtonRow()
    if m.state.loadingUi.foreground.controlsHidden then m.state.loadingUi.foreground.restoreFilterVisible = false
    m.filterButtonRow.visible = false
    m.filterButtonRow.items = []
    m.filterButtonRow.selectedValue = ""
    updateGridLayout()
end sub

'-------------------------------------------------------------------------------
' updateGridLayout
'-------------------------------------------------------------------------------
sub updateGridLayout()
    y = 208
    if m.filterButtonRow <> invalid and m.filterButtonRow.visible = true then y = 292
    m.musicGrid.translation = [48, y]
end sub

'-------------------------------------------------------------------------------
' onFilterButtonRowSelected
'-------------------------------------------------------------------------------
sub onFilterButtonRowSelected()
    selected = m.filterButtonRow.filterSelected
    if selected = invalid then return

    filterType = Format.SafeString(selected.type, "")
    if filterType = "Decade" then
        m.state.browse.decade = Number.ToInteger(selected.value, -1)
        m.filterButtonRow.selectedValue = m.state.browse.decade.ToStr()
    else if filterType = "Genre" then
        m.state.browse.genre = Format.SafeString(selected.value, "")
        m.filterButtonRow.selectedValue = m.state.browse.genre
    else
        return
    end if

    persistMusicLibraryViewState()
    if restoreCachedFilteredView() <> true then scheduleFilteredRefresh()
end sub

'-------------------------------------------------------------------------------
' applySavedMusicLibraryViewState
'-------------------------------------------------------------------------------
sub applySavedMusicLibraryViewState(state as object)
    optionKey = Format.SafeString(state.optionKey, "")
    sortOrder = LibraryBrowse.NormalizeSortOrder(state.sortOrder)
    m.state.browse.filterType = ""
    m.state.browse.decade = -1
    m.state.browse.genre = ""

    if optionKey = "Favorites" then
        m.state.browse.selection = LibraryBrowse.CreateSortSelection("Favorites", "Album", "Favorites")
        m.state.browse.selection.sortOrder = sortOrder
    else if optionKey = "Decade" or optionKey = "Genre" then
        m.state.browse.selection = { optionKey: optionKey, sortKey: "Album", sortOrder: "Ascending", label: optionKey }
        m.state.browse.filterType = optionKey
        m.state.browse.decade = Number.ToInteger(state.selectedDecade, -1)
        m.state.browse.genre = Format.SafeString(state.selectedGenre, "")
    else if optionKey = "ArtistAlbum" then
        m.state.browse.selection = { optionKey: "ArtistAlbum", sortKey: "ArtistAlbum", sortOrder: sortOrder, label: "Artist/Album" }
    else if optionKey = "Artist" then
        m.state.browse.selection = { optionKey: "Artist", sortKey: "Artist", sortOrder: sortOrder, label: "Artist" }
    else
        m.state.browse.selection = LibraryBrowse.CreateSortSelection("Album", "Album", "Album")
        m.state.browse.selection.sortOrder = sortOrder
    end if
end sub

'-------------------------------------------------------------------------------
' persistMusicLibraryViewState
'-------------------------------------------------------------------------------
sub persistMusicLibraryViewState()
    request = m.state.context
    selection = m.state.browse.selection
    if request = invalid or selection = invalid then return

    LibraryViewStateStore.Save(Format.SafeString(request.accountKey, ""), Format.SafeString(request.libraryId, ""), {
        optionKey: Format.SafeString(m.state.browse.selection.optionKey, "Album")
        sortKey: Format.SafeString(selection.sortKey, "Album")
        sortOrder: Format.SafeString(selection.sortOrder, "Ascending")
        selectedDecade: m.state.browse.decade
        selectedGenre: m.state.browse.genre
        libraryTitle: Format.SafeString(request.title, "")
        collectionType: Format.SafeString(request.collectionType, "")
    })
end sub
