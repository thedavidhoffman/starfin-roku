
'-------------------------------------------------------------------------------
' isAlbumBrowseMode
'-------------------------------------------------------------------------------
function isAlbumBrowseMode() as boolean
    return Format.SafeString(m.state.selectedSortKey, "Album") = "Album"
end function


'-------------------------------------------------------------------------------
' isArtistBrowseMode
'-------------------------------------------------------------------------------
function isArtistBrowseMode() as boolean
    return Format.SafeString(m.state.selectedSortKey, "Album") = "Artist"
end function


'-------------------------------------------------------------------------------
' createEmptyFilterCache
'-------------------------------------------------------------------------------
function createEmptyFilterCache() as object
    return {
        decadeOptions: []
        genreOptions: []
    }
end function


'-------------------------------------------------------------------------------
' createFilterCacheFromOptions
'-------------------------------------------------------------------------------
function createFilterCacheFromOptions(filterOptions as dynamic) as object
    cache = createEmptyFilterCache()
    if Arrays.IsAssocArray(filterOptions) = false then return cache

    if filterOptions.decadeOptions <> invalid then cache.decadeOptions = filterOptions.decadeOptions
    if filterOptions.genreOptions <> invalid then cache.genreOptions = filterOptions.genreOptions

    return cache
end function


'-------------------------------------------------------------------------------
' isDecadeFilterActive
'-------------------------------------------------------------------------------
function isDecadeFilterActive() as boolean
    return Format.SafeString(m.state.activeFilterType, "") = "Decade"
end function


'-------------------------------------------------------------------------------
' isGenreFilterActive
'-------------------------------------------------------------------------------
function isGenreFilterActive() as boolean
    return Format.SafeString(m.state.activeFilterType, "") = "Genre"
end function


'-------------------------------------------------------------------------------
' getMusicSortOptions
'-------------------------------------------------------------------------------
function getMusicSortOptions() as object
    options = [
        { optionKey: "Album", sortKey: "Album", sortOrder: "Ascending", label: "Album" }
        { optionKey: "ArtistAlbum", sortKey: "ArtistAlbum", sortOrder: "Ascending", label: "Artist/Album" }
        { optionKey: "Artist", sortKey: "Artist", sortOrder: "Ascending", label: "Artist" }
        { optionKey: "Favorites", sortKey: "Album", sortOrder: "Ascending", label: "Favorites" }
    ]
    if m.state.filterCache.decadeOptions.Count() > 0 then options.Push({ optionKey: "Decade", sortKey: "", sortOrder: "", label: "Decade" })
    if m.state.filterCache.genreOptions.Count() > 0 then options.Push({ optionKey: "Genre", sortKey: "", sortOrder: "", label: "Genre" })
    return options
end function


'-------------------------------------------------------------------------------
' getDefaultSortSelection
'-------------------------------------------------------------------------------
function getDefaultSortSelection() as object
    return {
        optionKey: "Album"
        sortKey: "Album"
        sortOrder: "Ascending"
        label: "Album"
    }
end function


'-------------------------------------------------------------------------------
' getFavoritesSortSelection
'-------------------------------------------------------------------------------
function getFavoritesSortSelection() as object
    return {
        optionKey: "Favorites"
        sortKey: "Album"
        sortOrder: "Ascending"
        label: "Favorites"
    }
end function


'-------------------------------------------------------------------------------
' isFavoriteBrowseActive
'-------------------------------------------------------------------------------
function isFavoriteBrowseActive() as boolean
    return m.state.request <> invalid and m.state.request.favoriteOnly = true
end function


'-------------------------------------------------------------------------------
' syncSortControls
'-------------------------------------------------------------------------------
sub syncSortControls()
    m.browseByButton.selectedSort = m.state.selectedSort
    m.sortButton.selectedSort = m.state.selectedSort
    m.sortButton.sortEnabled = canUseSortOrder(m.state.selectedSort)
end sub


'-------------------------------------------------------------------------------
' canUseSortOrder
'-------------------------------------------------------------------------------
function canUseSortOrder(selection as object) as boolean
    if selection = invalid then return false

    optionKey = Format.SafeString(selection.optionKey, "")
    if optionKey = "Decade" or optionKey = "Genre" then return false

    sortKey = Format.SafeString(selection.sortKey, "")
    return sortKey = "Album" or sortKey = "ArtistAlbum" or sortKey = "Artist"
end function


'-------------------------------------------------------------------------------
' onSortOverlayRequested
'-------------------------------------------------------------------------------
sub onSortOverlayRequested()
    request = m.browseByButton.overlayRequested
    if request = invalid then return

    request.sourcePage = "musicLibrary"
    request.selectedSortKey = m.state.selectedSortKey
    request.sortOptions = getMusicSortOptions()
    m.top.overlayRequested = request
end sub


'-------------------------------------------------------------------------------
' onSortOrderChanged
'-------------------------------------------------------------------------------
sub onSortOrderChanged()
    selection = m.sortButton.sortOrderChanged
    if selection = invalid then return
    if canUseSortOrder(m.state.selectedSort) <> true then return

    sortOrder = Format.SafeString(selection.sortOrder, "Ascending")
    if sortOrder <> "Descending" then sortOrder = "Ascending"
    if Format.SafeString(m.state.selectedSort.sortOrder, "Ascending") = sortOrder then return

    m.state.selectedSort.sortOrder = sortOrder
    syncSortControls()
    persistMusicLibraryViewState()
    if isArtistBrowseMode() then
        startArtistQuery()
    else
        m.state.request.albumSortOrder = sortOrder
        reloadMusicLibrary()
    end if
end sub


'-------------------------------------------------------------------------------
' applySortSelection
'-------------------------------------------------------------------------------
function applySortSelection(selection as object) as boolean
    if selection = invalid then return false

    optionKey = Format.SafeString(selection.optionKey, "")
    if optionKey = "" then return false
    if optionKey = m.state.selectedSortKey then
        if optionKey = "Artist" and m.state.artistLoad.status = "failed" then
            startArtistQuery()
            return true
        end if
        if optionKey <> "Artist" and m.state.albumLoad.status = "failed" then
            reloadMusicLibrary()
            return true
        end if
        return false
    end if
    cancelPendingArtistLoad()
    m.state.request.favoriteOnly = false
    m.state.request.genre = ""
    m.state.request.years = []
    m.state.request.albumSortBy = "SortName"
    m.state.request.albumSortOrder = "Ascending"
    m.state.activeFilterType = ""
    m.state.selectedDecade = -1
    m.state.selectedGenre = ""
    hideFilterButtonRow()

    if optionKey = "Decade" then
        m.state.selectedSort = {
            optionKey: "Decade"
            sortKey: "Album"
            sortOrder: "Ascending"
            label: "Decade"
        }
        m.state.activeFilterType = "Decade"
        m.state.selectedDecade = getFirstDecadeFilterValue(m.state.filterCache.decadeOptions)
        applySelectedDecadeToRequest()
        showDecadeFilterRow()
    else if optionKey = "Genre" then
        m.state.selectedSortKey = optionKey
        m.state.selectedSort = {
            optionKey: "Genre"
            sortKey: "Album"
            sortOrder: "Ascending"
            label: "Genre"
        }
        m.state.activeFilterType = "Genre"
        m.state.selectedGenre = getFirstGenreFilterValue(m.state.filterCache.genreOptions)
        m.state.request.genre = m.state.selectedGenre
        showGenreFilterRow()
    else if optionKey = "ArtistAlbum" then
        m.state.selectedSort = {
            optionKey: "ArtistAlbum"
            sortKey: "ArtistAlbum"
            sortOrder: "Ascending"
            label: "Artist/Album"
        }
        m.state.request.albumSortBy = "AlbumArtist,SortName"
    else if optionKey = "Artist" then
        m.state.selectedSort = {
            optionKey: "Artist"
            sortKey: "Artist"
            sortOrder: "Ascending"
            label: "Artist"
        }
    else if optionKey = "Favorites" then
        m.state.selectedSort = getFavoritesSortSelection()
        m.state.request.favoriteOnly = true
    else
        m.state.selectedSort = getDefaultSortSelection()
    end if

    m.state.selectedSortKey = Format.SafeString(m.state.selectedSort.optionKey, "Album")
    syncSortControls()
    persistMusicLibraryViewState()
    if optionKey = "Artist" then
        startArtistQuery()
    else
        reloadMusicLibrary()
    end if
    return true
end function


'-------------------------------------------------------------------------------
' showDecadeFilterRow
'-------------------------------------------------------------------------------
sub showDecadeFilterRow()
    options = m.state.filterCache.decadeOptions
    if options = invalid then options = []
    if filterOptionsContainValue(options, m.state.selectedDecade.ToStr()) <> true then m.state.selectedDecade = getFirstDecadeFilterValue(options)

    m.filterButtonRow.filterType = "Decade"
    m.filterButtonRow.items = options
    m.filterButtonRow.selectedValue = m.state.selectedDecade.ToStr()
    filterVisible = options.Count() > 0
    if m.state.foregroundLoad.controlsHidden then
        m.state.foregroundLoad.restoreFilterVisible = filterVisible
        m.filterButtonRow.visible = false
    else
        m.filterButtonRow.visible = filterVisible
    end if
    updateGridLayout()
end sub


'-------------------------------------------------------------------------------
' configureCurrentAlbumRequest
'-------------------------------------------------------------------------------
sub configureCurrentAlbumRequest()
    request = m.state.request
    request.favoriteOnly = m.state.selectedSortKey = "Favorites"
    request.genre = ""
    request.years = []
    request.albumSortBy = "SortName"
    request.albumSortOrder = Format.SafeString(m.state.selectedSort.sortOrder, "Ascending")
    if m.state.selectedSortKey = "ArtistAlbum" then request.albumSortBy = "AlbumArtist,SortName"
    if m.state.selectedSortKey = "Genre" then request.genre = m.state.selectedGenre
    if m.state.selectedSortKey = "Decade" then applySelectedDecadeToRequest()
end sub


'-------------------------------------------------------------------------------
' showGenreFilterRow
'-------------------------------------------------------------------------------
sub showGenreFilterRow()
    options = m.state.filterCache.genreOptions
    if options = invalid then options = []
    if filterOptionsContainValue(options, m.state.selectedGenre) <> true then m.state.selectedGenre = getFirstGenreFilterValue(options)

    m.filterButtonRow.filterType = "Genre"
    m.filterButtonRow.items = options
    m.filterButtonRow.selectedValue = m.state.selectedGenre
    filterVisible = options.Count() > 0
    if m.state.foregroundLoad.controlsHidden then
        m.state.foregroundLoad.restoreFilterVisible = filterVisible
        m.filterButtonRow.visible = false
    else
        m.filterButtonRow.visible = filterVisible
    end if
    updateGridLayout()
end sub


'-------------------------------------------------------------------------------
' applySelectedDecadeToRequest
'-------------------------------------------------------------------------------
sub applySelectedDecadeToRequest()
    years = []
    if m.state.selectedDecade >= 0 then
        for year = m.state.selectedDecade to m.state.selectedDecade + 9
            years.Push(year.ToStr())
        end for
    end if
    m.state.request.years = years
end sub


'-------------------------------------------------------------------------------
' hideFilterButtonRow
'-------------------------------------------------------------------------------
sub hideFilterButtonRow()
    if m.state.foregroundLoad.controlsHidden then m.state.foregroundLoad.restoreFilterVisible = false
    m.filterButtonRow.visible = false
    m.filterButtonRow.items = []
    m.filterButtonRow.selectedValue = ""
    updateGridLayout()
end sub


'-------------------------------------------------------------------------------
' updateGridLayout
'-------------------------------------------------------------------------------
sub updateGridLayout()
    y = 208
    if m.filterButtonRow <> invalid and m.filterButtonRow.visible = true then y = 292
    m.musicGrid.translation = [48, y]
end sub


'-------------------------------------------------------------------------------
' getFirstDecadeFilterValue
'-------------------------------------------------------------------------------
function getFirstDecadeFilterValue(options as object) as integer
    if options = invalid or options.Count() = 0 then return -1

    return Number.ToInteger(options[0].value, -1)
end function


'-------------------------------------------------------------------------------
' getFirstGenreFilterValue
'-------------------------------------------------------------------------------
function getFirstGenreFilterValue(options as object) as string
    if options = invalid or options.Count() = 0 then return ""

    return Format.SafeString(options[0].value, "")
end function


'-------------------------------------------------------------------------------
' onFilterButtonRowSelected
'-------------------------------------------------------------------------------
sub onFilterButtonRowSelected()
    selected = m.filterButtonRow.filterSelected
    if selected = invalid then return

    filterType = Format.SafeString(selected.type, "")
    if filterType = "Decade" then
        m.state.selectedDecade = Number.ToInteger(selected.value, -1)
        m.filterButtonRow.selectedValue = m.state.selectedDecade.ToStr()
        applySelectedDecadeToRequest()
    else if filterType = "Genre" then
        m.state.selectedGenre = Format.SafeString(selected.value, "")
        m.filterButtonRow.selectedValue = m.state.selectedGenre
        m.state.request.genre = m.state.selectedGenre
    else
        return
    end if

    persistMusicLibraryViewState()
    reloadMusicLibrary()
end sub


'-------------------------------------------------------------------------------
' filterOptionsContainValue
'-------------------------------------------------------------------------------
function filterOptionsContainValue(options as object, value as string) as boolean
    if options = invalid or value = "" then return false
    for each option in options
        if Format.SafeString(option.value, "") = value then return true
    end for
    return false
end function


'-------------------------------------------------------------------------------
' applySavedMusicLibraryViewState
'-------------------------------------------------------------------------------
sub applySavedMusicLibraryViewState(request as object, state as object)
    optionKey = Format.SafeString(state.optionKey, "")
    sortOrder = getNormalizedMusicSortOrder(Format.SafeString(state.sortOrder, "Ascending"))
    request.favoriteOnly = false
    m.state.activeFilterType = ""
    m.state.selectedDecade = -1
    m.state.selectedGenre = ""

    if optionKey = "Favorites" then
        request.favoriteOnly = true
        m.state.selectedSort = getFavoritesSortSelection()
        m.state.selectedSort.sortOrder = sortOrder
    else if optionKey = "Decade" or optionKey = "Genre" then
        m.state.selectedSort = { optionKey: optionKey, sortKey: "Album", sortOrder: "Ascending", label: optionKey }
        m.state.activeFilterType = optionKey
        m.state.selectedDecade = Number.ToInteger(state.selectedDecade, -1)
        m.state.selectedGenre = Format.SafeString(state.selectedGenre, "")
    else if optionKey = "ArtistAlbum" then
        m.state.selectedSort = { optionKey: "ArtistAlbum", sortKey: "ArtistAlbum", sortOrder: sortOrder, label: "Artist/Album" }
    else if optionKey = "Artist" then
        m.state.selectedSort = { optionKey: "Artist", sortKey: "Artist", sortOrder: sortOrder, label: "Artist" }
    else
        m.state.selectedSort = getDefaultSortSelection()
        m.state.selectedSort.sortOrder = sortOrder
    end if
    m.state.selectedSortKey = Format.SafeString(m.state.selectedSort.optionKey, "Album")
end sub


'-------------------------------------------------------------------------------
' getNormalizedMusicSortOrder
'-------------------------------------------------------------------------------
function getNormalizedMusicSortOrder(sortOrder as string) as string
    if sortOrder = "Descending" then return "Descending"
    return "Ascending"
end function


'-------------------------------------------------------------------------------
' persistMusicLibraryViewState
'-------------------------------------------------------------------------------
sub persistMusicLibraryViewState()
    request = m.state.request
    selection = m.state.selectedSort
    if request = invalid or selection = invalid then return

    LibraryViewStateStore.Save(Format.SafeString(request.accountKey, ""), Format.SafeString(request.libraryId, ""), {
        optionKey: Format.SafeString(m.state.selectedSortKey, "Album")
        sortKey: Format.SafeString(selection.sortKey, "Album")
        sortOrder: Format.SafeString(selection.sortOrder, "Ascending")
        selectedDecade: m.state.selectedDecade
        selectedGenre: m.state.selectedGenre
        libraryTitle: Format.SafeString(request.title, "")
        collectionType: Format.SafeString(request.collectionType, "")
    })
end sub
