
'-------------------------------------------------------------------------------
' loadFilterOptions
'-------------------------------------------------------------------------------
sub loadFilterOptions()
    filterRequest = {}
    for each key in m.state.context
        filterRequest[key] = m.state.context[key]
    end for
    filterRequest.queryId = m.state.filters.load.queryId
    m.state.filters.load.requestInFlight = true
    m.musicFilterOptionsTask.control = "stop"
    m.musicFilterOptionsTask.request = filterRequest
    m.musicFilterOptionsTask.control = "run"
end sub

'-------------------------------------------------------------------------------
' onMusicFilterOptionsResponse
'-------------------------------------------------------------------------------
sub onMusicFilterOptionsResponse()
    response = m.musicFilterOptionsTask.response
    if response = invalid then return
    if AsyncLifecycle.IsCurrentResponse(m.state.lifecycle, response, "libraryId", "musicFilterOptions") <> true then return
    if Number.ToInteger(response.queryId, -1) <> m.state.filters.load.queryId then return
    if response.ok <> true then
        m.state.filters.load.requestInFlight = false
        m.state.filters.load.status = "failed"
        m.state.loadingUi.foreground.focusAfterLoad = ""
        m.log.error("Music filter options failed libraryId=" + getLibraryId())
        return
    end if

    m.state.filters.load.requestInFlight = false
    m.state.filters.load.status = "loaded"
    m.state.filters.options = LibraryBrowse.NormalizeFilterOptions(response.filterOptions)
    if reconcileActiveFilterSelection() then return
    if LibraryBrowse.IsDecadeActive(m.state.browse.filterType) then showDecadeFilterRow()
    if LibraryBrowse.IsGenreActive(m.state.browse.filterType) then showGenreFilterRow()
    focusAfterForegroundLoad()
end sub

'-------------------------------------------------------------------------------
' reconcileActiveFilterSelection
'-------------------------------------------------------------------------------
function reconcileActiveFilterSelection() as boolean
    if LibraryBrowse.IsDecadeActive(m.state.browse.filterType) then
        options = m.state.filters.options.decadeOptions
        if options.Count() = 0 then return fallBackToAlbumBrowse()
        if LibraryBrowse.ContainsOptionValue(options, m.state.browse.decade.ToStr()) then return false

        m.state.browse.decade = LibraryBrowse.ResolveDecade(options, m.state.browse.decade)
        showDecadeFilterRow()
        persistMusicLibraryViewState()
        reloadMusicLibrary()
        return true
    end if

    if LibraryBrowse.IsGenreActive(m.state.browse.filterType) then
        options = m.state.filters.options.genreOptions
        if options.Count() = 0 then return fallBackToAlbumBrowse()
        if LibraryBrowse.ContainsOptionValue(options, m.state.browse.genre) then return false

        m.state.browse.genre = LibraryBrowse.ResolveGenre(options, m.state.browse.genre)
        showGenreFilterRow()
        persistMusicLibraryViewState()
        reloadMusicLibrary()
        return true
    end if

    return false
end function

'-------------------------------------------------------------------------------
' fallBackToAlbumBrowse
'-------------------------------------------------------------------------------
function fallBackToAlbumBrowse() as boolean
    m.state.browse.selection = LibraryBrowse.CreateSortSelection("Album", "Album", "Album")
    m.state.browse.filterType = ""
    m.state.browse.decade = -1
    m.state.browse.genre = ""
    m.state.loadingUi.foreground.focusAfterLoad = ""
    hideFilterButtonRow()
    syncSortControls()
    persistMusicLibraryViewState()
    reloadMusicLibrary()
    return true
end function

'-------------------------------------------------------------------------------
' onMusicArtistsResponse
'-------------------------------------------------------------------------------
sub onMusicArtistsResponse()
    response = m.musicArtistsTask.response
    if response = invalid then return
    if AsyncLifecycle.IsCurrentResponse(m.state.lifecycle, response, "libraryId", "musicArtists") <> true then return
    if Number.ToInteger(response.queryId, -1) <> m.state.content.artists.load.queryId then return
    if response.ok <> true then
        m.state.content.artists.load.requestInFlight = false
        m.state.content.artists.load.status = "failed"
        m.state.content.artists.load.hasMore = false
        m.log.error("Artist load failed libraryId=" + getLibraryId() + " message=" + Format.SafeString(response.errorMessage, "Unable to load music artists."))
        if isArtistBrowseMode() then
            AppStatus.SetMessage(Format.SafeString(response.errorMessage, "Unable to load music artists."))
            if m.state.loadingUi.foreground.kind = "artists" and finishForegroundLoad("artists") then focusBrowseByButton()
        end if
        return
    end if

    startIndex = Number.ToInteger(response.startIndex, -1)
    expectedStartIndex = m.state.content.artists.load.nextStartIndex
    if startIndex <> expectedStartIndex then
        m.state.content.artists.load.requestInFlight = false
        m.state.content.artists.load.status = "failed"
        m.state.content.artists.load.hasMore = false
        m.log.error("Artist page rejected libraryId=" + getLibraryId() + " expectedStartIndex=" + expectedStartIndex.ToStr() + " receivedStartIndex=" + startIndex.ToStr())
        if m.state.loadingUi.foreground.kind = "artists" and finishForegroundLoad("artists") then focusBrowseByButton()
        return
    end if
    m.state.content.artists.load.requestInFlight = false
    pageArtists = getValidMusicItems(response.payload, "artist")
    for each artist in pageArtists
        m.state.content.artists.items.Push(artist)
    end for
    m.state.content.artists.load.status = "loaded"
    m.state.content.artists.load.nextStartIndex = Number.ToInteger(response.nextStartIndex, startIndex + pageArtists.Count())
    m.state.content.artists.load.totalCount = Number.ToInteger(response.totalRecordCount, m.state.content.artists.items.Count())
    m.state.content.artists.load.hasMore = response.hasMore = true
    m.log.write("Artist page accepted libraryId=" + getLibraryId() + " count=" + m.state.content.artists.items.Count().ToStr())
    if isArtistBrowseMode() then
        AppStatus.ClearMessage()
        if startIndex = 0 then
            renderArtists()
        else
            appendArtistPage(pageArtists)
        end if
        updateTitleLabel(m.state.content.artists.load.totalCount)
        blockingEnded = false
        if m.state.loadingUi.foreground.kind = "artists" and (m.state.content.artists.items.Count() > 0 or m.state.content.artists.load.hasMore <> true) then blockingEnded = finishForegroundLoad("artists")
        if blockingEnded then focusAlbums()
        if pageArtists.Count() = 0 and m.state.content.artists.load.hasMore then
            loadArtistPage(m.state.content.artists.load.nextStartIndex)
        else
            requestNextArtistPageIfNeeded()
        end if
    end if
end sub

'-------------------------------------------------------------------------------
' onMusicLibraryResponse
'-------------------------------------------------------------------------------
sub onMusicLibraryResponse()
    response = m.musicLibraryTask.response
    if response = invalid then return
    if AsyncLifecycle.IsCurrentResponse(m.state.lifecycle, response, "libraryId", "musicLibrary") <> true then return
    if Number.ToInteger(response.queryId, -1) <> m.state.content.albums.load.queryId then return
    if response.ok <> true then
        m.state.loadingUi.filteredRefreshActive = false
        m.state.content.albums.load.requestInFlight = false
        m.state.content.albums.load.status = "failed"
        m.state.content.albums.load.hasMore = false
        m.log.error("Album load failed libraryId=" + getLibraryId() + " message=" + Format.SafeString(response.errorMessage, "Unable to load music library."))
        AppStatus.SetMessage(Format.SafeString(response.errorMessage, "Unable to load music library."))
        if m.state.loadingUi.foreground.kind = "albums" and finishForegroundLoad("albums") then
            if focusAfterForegroundLoad() <> true then focusBrowseByButton()
        end if
        return
    end if

    startIndex = Number.ToInteger(response.startIndex, -1)
    expectedStartIndex = m.state.content.albums.load.nextStartIndex
    if startIndex <> expectedStartIndex then
        m.state.loadingUi.filteredRefreshActive = false
        m.state.content.albums.load.requestInFlight = false
        m.state.content.albums.load.status = "failed"
        m.state.content.albums.load.hasMore = false
        m.log.error("Album page rejected libraryId=" + getLibraryId() + " expectedStartIndex=" + expectedStartIndex.ToStr() + " receivedStartIndex=" + startIndex.ToStr())
        if m.state.loadingUi.foreground.kind = "albums" and finishForegroundLoad("albums") then
            if focusAfterForegroundLoad() <> true then focusBrowseByButton()
        end if
        return
    end if
    m.state.content.albums.load.requestInFlight = false
    if startIndex = 0 then
        m.state.content.albums.load.totalCount = Number.ToInteger(response.totalRecordCount, -1)
        if m.state.content.albums.load.totalCount >= 0 then updateTitleLabel(m.state.content.albums.load.totalCount)
    end if
    pageAlbums = getValidMusicItems(response.payload, "album")
    if isFilteredAlbumBrowseActive() then pageAlbums = canonicalizeFilteredAlbums(pageAlbums)
    isFilteredRefresh = m.state.loadingUi.filteredRefreshActive and startIndex = 0
    if isFilteredRefresh then
        m.state.content.albums.items = pageAlbums
    else
        for each album in pageAlbums
            m.state.content.albums.items.Push(album)
        end for
    end if
    m.log.write("Album page accepted libraryId=" + getLibraryId() + " startIndex=" + startIndex.ToStr() + " pageCount=" + pageAlbums.Count().ToStr() + " totalLoaded=" + m.state.content.albums.items.Count().ToStr())
    AppStatus.ClearMessage()

    hasMore = response.hasMore = true
    m.state.content.albums.load.hasMore = hasMore
    m.state.content.albums.load.nextStartIndex = Number.ToInteger(response.nextStartIndex, startIndex + pageAlbums.Count())
    m.state.content.albums.load.status = "loaded"
    if isFilteredAlbumBrowseActive() then cacheFilteredAlbumPage(pageAlbums, startIndex)
    if m.state.content.albums.load.totalCount < 0 then updateTitleLabel(m.state.content.albums.items.Count())
    if isFilteredRefresh then
        m.state.loadingUi.filteredRefreshActive = false
        renderAlbums(pageAlbums)
    else
        appendAlbumPage(pageAlbums)
    end if
    blockingEnded = false
    if m.state.loadingUi.foreground.kind = "albums" and (m.state.content.albums.items.Count() > 0 or m.state.content.albums.load.hasMore <> true) then blockingEnded = finishForegroundLoad("albums")
    if blockingEnded then
        if focusAfterForegroundLoad() <> true and isMusicLibraryControlFocused() = false then focusAlbums()
    end if
    if pageAlbums.Count() = 0 and m.state.content.albums.load.hasMore then
        loadAlbumPage(m.state.content.albums.load.nextStartIndex)
    else
        requestNextAlbumPageIfNeeded()
    end if
end sub

'-------------------------------------------------------------------------------
' loadAlbumPage
'-------------------------------------------------------------------------------
sub loadAlbumPage(startIndex as integer)
    request = {}
    for each key in m.state.context
        request[key] = m.state.context[key]
    end for
    request.pageStartIndex = startIndex
    request.queryId = m.state.content.albums.load.queryId
    request.favoriteOnly = isFavoriteBrowseActive()
    request.genre = ""
    request.years = []
    request.albumSortBy = "SortName"
    request.albumSortOrder = Format.SafeString(m.state.browse.selection.sortOrder, "Ascending")
    if m.state.browse.selection.optionKey = "ArtistAlbum" then request.albumSortBy = "AlbumArtist,SortName"
    if LibraryBrowse.IsGenreActive(m.state.browse.filterType) then request.genre = m.state.browse.genre
    if LibraryBrowse.IsDecadeActive(m.state.browse.filterType) then request.years = getSelectedDecadeYears()

    m.state.content.albums.load.requestInFlight = true
    m.musicLibraryTask.control = "stop"
    m.musicLibraryTask.request = request
    m.musicLibraryTask.control = "run"
end sub

'-------------------------------------------------------------------------------
' requestNextAlbumPageIfNeeded
'-------------------------------------------------------------------------------
sub requestNextAlbumPageIfNeeded()
    if m.state.content.albums.load.hasMore <> true or m.state.content.albums.load.requestInFlight = true then return
    if isFocusNearLoadedEnd(m.musicGrid, m.state.content.albums.items.Count()) <> true then return

    m.state.content.albums.load.status = "loading"
    loadAlbumPage(m.state.content.albums.load.nextStartIndex)
end sub

'-------------------------------------------------------------------------------
' isFocusNearLoadedEnd
'-------------------------------------------------------------------------------
function isFocusNearLoadedEnd(grid as object, loadedCount as integer) as boolean
    if loadedCount <= 0 then return false
    focusedIndex = Number.ToInteger(grid.itemFocused, 0)
    columnCount = Number.ToInteger(grid.numColumns, 1)
    if columnCount <= 0 then columnCount = 1
    focusedRow = Number.ToInteger(focusedIndex / columnCount, 0)
    loadedRows = Number.ToInteger((loadedCount + columnCount - 1) / columnCount, 0)
    return focusedRow >= loadedRows - 5
end function

'-------------------------------------------------------------------------------
' cancelPendingArtistLoad
'-------------------------------------------------------------------------------
sub cancelPendingArtistLoad()
    if m.state.content.artists.load.status <> "loading" then return

    m.log.write("Artist load cancelled libraryId=" + getLibraryId())
    m.musicArtistsTask.control = "stop"
    m.state.content.artists.load.status = "idle"
    m.state.content.artists.load.queryId = m.state.content.artists.load.queryId + 1
    if m.state.loadingUi.foreground.kind = "artists" then
        m.state.loadingUi.foreground.kind = ""
        m.state.loadingUi.foreground.startedAt = invalid
        showForegroundControls()
        Spinner.Hide()
    end if
    AsyncLifecycle.Deactivate(m.state.lifecycle)
end sub

'-------------------------------------------------------------------------------
' reloadMusicLibrary
'-------------------------------------------------------------------------------
sub reloadMusicLibrary()
    request = m.state.context
    if request = invalid then return

    m.filteredRefreshTimer.control = "stop"
    m.state.loadingUi.filteredRefreshPending = false
    m.state.loadingUi.filteredRefreshActive = false
    m.state.content.albums.items = []
    m.state.content.artists.items = []
    m.state.content.albums.load.status = "loading"
    m.state.content.albums.load.requestInFlight = false
    m.state.content.albums.load.nextStartIndex = 0
    m.state.content.albums.load.totalCount = -1
    m.state.content.albums.load.hasMore = false
    m.state.content.albums.load.queryId = m.state.content.albums.load.queryId + 1
    m.state.content.artists.load.status = "idle"
    m.state.content.artists.load.queryId = m.state.content.artists.load.queryId + 1
    AsyncLifecycle.Begin(m.state.lifecycle, request.libraryId)
    updateTitleLabel()
    renderAlbums([])
    m.log.write("Album reload started libraryId=" + Format.SafeString(request.libraryId, ""))
    queueForegroundLoad("albums")
    m.musicArtistsTask.control = "stop"
end sub

'-------------------------------------------------------------------------------
' scheduleFilteredRefresh
'-------------------------------------------------------------------------------
sub scheduleFilteredRefresh()
    request = m.state.context
    if request = invalid then return

    m.filteredRefreshTimer.control = "stop"
    m.musicLibraryTask.control = "stop"
    m.state.content.albums.load.queryId = m.state.content.albums.load.queryId + 1
    m.state.content.albums.load.status = "debouncing"
    m.state.content.albums.load.requestInFlight = false
    m.state.content.albums.load.hasMore = false
    m.state.loadingUi.filteredRefreshPending = true
    m.filteredRefreshTimer.control = "start"
end sub

'-------------------------------------------------------------------------------
' onFilteredRefreshTimerFired
'-------------------------------------------------------------------------------
sub onFilteredRefreshTimerFired()
    if m.state.loadingUi.filteredRefreshPending <> true then return

    m.state.loadingUi.filteredRefreshPending = false
    m.state.loadingUi.filteredRefreshActive = true
    m.state.content.albums.load.status = "loading"
    m.state.content.albums.load.nextStartIndex = 0
    m.state.content.albums.load.totalCount = -1
    AsyncLifecycle.Begin(m.state.lifecycle, m.state.context.libraryId)
    loadAlbumPage(0)
end sub

'-------------------------------------------------------------------------------
' startArtistQuery
'-------------------------------------------------------------------------------
sub startArtistQuery()
    request = m.state.context
    if request = invalid or isFavoriteBrowseActive() then return

    m.musicLibraryTask.control = "stop"
    m.state.content.albums.load.requestInFlight = false
    m.state.content.albums.load.status = "idle"
    m.state.content.albums.load.queryId = m.state.content.albums.load.queryId + 1
    m.state.content.artists.items = []
    m.state.content.artists.load.status = "loading"
    m.state.content.artists.load.requestInFlight = false
    m.state.content.artists.load.nextStartIndex = 0
    m.state.content.artists.load.totalCount = -1
    m.state.content.artists.load.hasMore = false
    m.state.content.artists.load.queryId = m.state.content.artists.load.queryId + 1
    AsyncLifecycle.Begin(m.state.lifecycle, request.libraryId)
    AppStatus.ClearMessage()
    m.log.write("Artist load started libraryId=" + Format.SafeString(request.libraryId, ""))
    renderArtists()
    queueForegroundLoad("artists")
end sub

'-------------------------------------------------------------------------------
' queueForegroundLoad
'-------------------------------------------------------------------------------
sub queueForegroundLoad(kind as string)
    hideForegroundControls()
    Spinner.Show(0)

    startForegroundLoad(kind)
    if kind = "artists" then
        loadArtistPage(m.state.content.artists.load.nextStartIndex)
    else
        loadAlbumPage(m.state.content.albums.load.nextStartIndex)
    end if
end sub

'-------------------------------------------------------------------------------
' hideForegroundControls
'-------------------------------------------------------------------------------
sub hideForegroundControls()
    if m.state.loadingUi.foreground.controlsHidden then return

    if m.browseByButton.isInFocusChain() or m.sortButton.isInFocusChain() or m.filterButtonRow.isInFocusChain() then m.top.setFocus(true)
    m.state.loadingUi.foreground.controlsHidden = true
    m.state.loadingUi.foreground.restoreFilterVisible = m.filterButtonRow.visible
    m.browseByButton.visible = false
    m.sortButton.visible = false
    m.filterButtonRow.visible = false
    updateGridLayout()
end sub

'-------------------------------------------------------------------------------
' showForegroundControls
'-------------------------------------------------------------------------------
sub showForegroundControls()
    restoreFilterVisible = m.state.loadingUi.foreground.restoreFilterVisible
    m.state.loadingUi.foreground.controlsHidden = false
    m.state.loadingUi.foreground.restoreFilterVisible = false
    m.browseByButton.visible = true
    m.sortButton.visible = true
    m.filterButtonRow.visible = restoreFilterVisible
    updateGridLayout()
end sub

'-------------------------------------------------------------------------------
' loadArtistPage
'-------------------------------------------------------------------------------
sub loadArtistPage(startIndex as integer)
    request = m.state.context
    artistRequest = {}
    for each key in request
        artistRequest[key] = request[key]
    end for
    artistRequest.queryId = m.state.content.artists.load.queryId
    artistRequest.pageStartIndex = startIndex
    artistRequest.artistSortOrder = Format.SafeString(m.state.browse.selection.sortOrder, "Ascending")
    m.state.content.artists.load.requestInFlight = true
    m.musicArtistsTask.control = "stop"
    m.musicArtistsTask.request = artistRequest
    m.musicArtistsTask.control = "run"
end sub

'-------------------------------------------------------------------------------
' requestNextArtistPageIfNeeded
'-------------------------------------------------------------------------------
sub requestNextArtistPageIfNeeded()
    if m.state.content.artists.load.hasMore <> true or m.state.content.artists.load.requestInFlight = true then return
    if isFocusNearLoadedEnd(m.musicGrid, m.state.content.artists.items.Count()) <> true then return

    m.state.content.artists.load.status = "loading"
    loadArtistPage(m.state.content.artists.load.nextStartIndex)
end sub

'-------------------------------------------------------------------------------
' startForegroundLoad
'-------------------------------------------------------------------------------
sub startForegroundLoad(kind as string)
    startedAt = CreateObject("roTimespan")
    startedAt.Mark()
    m.state.loadingUi.foreground.kind = kind
    m.state.loadingUi.foreground.startedAt = startedAt
end sub

'-------------------------------------------------------------------------------
' finishForegroundLoad
'-------------------------------------------------------------------------------
function finishForegroundLoad(kind as string) as boolean
    if m.state.loadingUi.foreground.kind <> kind then return false

    elapsedMs = 0
    if m.state.loadingUi.foreground.startedAt <> invalid then elapsedMs = m.state.loadingUi.foreground.startedAt.TotalMilliseconds()
    m.log.write("Foreground load completed kind=" + kind + " libraryId=" + getLibraryId() + " elapsedMs=" + elapsedMs.ToStr())
    m.state.loadingUi.foreground.kind = ""
    m.state.loadingUi.foreground.startedAt = invalid
    showForegroundControls()
    Spinner.Hide()
    return true
end function

'-------------------------------------------------------------------------------
' getLibraryId
'-------------------------------------------------------------------------------
function getLibraryId() as string
    if m.state.context = invalid then return ""
    return Format.SafeString(m.state.context.libraryId, "")
end function
