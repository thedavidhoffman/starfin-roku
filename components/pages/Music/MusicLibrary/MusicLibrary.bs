'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    initReferences()
    initHandlers()
    initState()
    syncSortControls()
end sub


'-------------------------------------------------------------------------------
' initReferences
'-------------------------------------------------------------------------------
sub initReferences()
    m.log = new Logger("MusicLibrary", m.global.logService)
    m.titleLabel = m.top.findNode("titleLabel")
    m.browseByButton = m.top.findNode("browseByButton")
    m.sortButton = m.top.findNode("sortButton")
    m.filterButtonRow = m.top.findNode("filterButtonRow")
    m.emptyFilterLabel = m.top.findNode("emptyFilterLabel")
    m.musicGrid = m.top.findNode("musicGrid")
    m.musicLibraryTask = m.top.findNode("musicLibraryTask")
    m.musicArtistsTask = m.top.findNode("musicArtistsTask")
    m.musicFilterOptionsTask = m.top.findNode("musicFilterOptionsTask")
end sub


'-------------------------------------------------------------------------------
' initHandlers
'-------------------------------------------------------------------------------
sub initHandlers()
    m.musicLibraryTask.observeField("response", "onMusicLibraryResponse")
    m.musicArtistsTask.observeField("response", "onMusicArtistsResponse")
    m.musicFilterOptionsTask.observeField("response", "onMusicFilterOptionsResponse")
    m.browseByButton.observeField("overlayRequested", "onSortOverlayRequested")
    m.browseByButton.observeField("focusExitDown", "onBrowseByButtonFocusExitDown")
    m.sortButton.observeField("sortOrderChanged", "onSortOrderChanged")
    m.sortButton.observeField("focusExitDown", "onSortButtonFocusExitDown")
    m.filterButtonRow.observeField("filterSelected", "onFilterButtonRowSelected")
    m.filterButtonRow.observeField("focusExitUp", "onFilterButtonRowFocusExitUp")
    m.filterButtonRow.observeField("focusExitDown", "onFilterButtonRowFocusExitDown")
    m.musicGrid.observeField("itemSelected", "onMusicItemSelected")
    m.musicGrid.observeField("itemFocused", "onMusicGridItemFocused")
end sub


'-------------------------------------------------------------------------------
' initState
'-------------------------------------------------------------------------------
sub initState()
    m.state = {
        request: invalid
        loadedAlbums: []
        artists: []
        selectedSortKey: "Album"
        selectedSort: getDefaultSortSelection()
        activeFilterType: ""
        selectedDecade: -1
        selectedGenre: ""
        filterCache: createEmptyFilterCache()
        filterLoad: {
            status: "idle"
            requestInFlight: false
            queryId: 0
        }
        refreshPending: false
        foregroundLoad: {
            kind: ""
            pendingKind: ""
            startedAt: invalid
            controlsHidden: false
            restoreFilterVisible: false
        }
        pagingLoad: {
            spinnerVisible: false
        }
        albumLoad: {
            status: "idle"
            requestInFlight: false
            nextStartIndex: 0
            totalCount: -1
            hasMore: false
            queryId: 0
        }
        artistLoad: {
            status: "idle"
            queryId: 0
            requestInFlight: false
            nextStartIndex: 0
            totalCount: -1
            hasMore: false
        }
        lifecycle: AsyncLifecycle.Create()
    }
end sub


'-------------------------------------------------------------------------------
' onLoadRequestChanged
'-------------------------------------------------------------------------------
sub onLoadRequestChanged()
    request = m.top.loadRequest
    if request = invalid then return

    m.state.request = request
    m.state.loadedAlbums = []
    m.state.artists = []
    m.state.albumLoad.status = "loading"
    m.state.albumLoad.requestInFlight = false
    m.state.albumLoad.nextStartIndex = 0
    m.state.albumLoad.totalCount = -1
    m.state.albumLoad.hasMore = false
    m.state.albumLoad.queryId = m.state.albumLoad.queryId + 1
    m.state.artistLoad.status = "idle"
    m.state.artistLoad.requestInFlight = false
    m.state.artistLoad.nextStartIndex = 0
    m.state.artistLoad.totalCount = -1
    m.state.artistLoad.hasMore = false
    m.state.artistLoad.queryId = m.state.artistLoad.queryId + 1
    m.state.filterLoad.status = "loading"
    m.state.filterLoad.requestInFlight = false
    m.state.filterLoad.queryId = m.state.filterLoad.queryId + 1
    savedState = LibraryViewStateStore.Load(Format.SafeString(request.accountKey, ""), Format.SafeString(request.libraryId, ""))
    if savedState <> invalid then
        applySavedMusicLibraryViewState(request, savedState)
    else if request.favoriteOnly = true then
        m.state.selectedSortKey = "Favorites"
        m.state.selectedSort = getFavoritesSortSelection()
        m.state.activeFilterType = ""
        m.state.selectedDecade = -1
        m.state.selectedGenre = ""
    else
        m.state.selectedSortKey = "Album"
        m.state.selectedSort = getDefaultSortSelection()
        m.state.activeFilterType = ""
        m.state.selectedDecade = -1
        m.state.selectedGenre = ""
    end if
    configureCurrentAlbumRequest()
    m.state.filterCache = createEmptyFilterCache()
    syncSortControls()
    hideFilterButtonRow()
    AsyncLifecycle.Begin(m.state.lifecycle, request.libraryId)
    updateTitleLabel()
    renderAlbums([])
    if isArtistBrowseMode() then
        startArtistQuery()
    else
        m.log.write("Album load started libraryId=" + Format.SafeString(request.libraryId, ""))
        queueForegroundLoad("albums")
    end if
    loadFilterOptions()
end sub


'-------------------------------------------------------------------------------
' activate
'-------------------------------------------------------------------------------
sub activate()
    AsyncLifecycle.BeginFromField(m.state.lifecycle, m.state.request, "libraryId")
    if m.state.refreshPending then
        m.state.refreshPending = false
        reloadMusicLibrary()
        focusAlbums()
        return
    end if
    if m.state.foregroundLoad.kind <> "" then
        focusAlbums()
        return
    end if
    if m.state.foregroundLoad.pendingKind <> "" then
        startPendingForegroundLoad()
        focusAlbums()
        return
    end if

    if m.state.filterLoad.status = "loading" and m.state.filterLoad.requestInFlight <> true then loadFilterOptions()

    if isArtistBrowseMode() then
        if m.state.artistLoad.status = "loading" and m.state.artistLoad.requestInFlight <> true then loadArtistPage(m.state.artistLoad.nextStartIndex)
    else if m.state.albumLoad.status = "loading" and m.state.albumLoad.requestInFlight <> true then
        m.log.write("Album paging resumed libraryId=" + getLibraryId() + " startIndex=" + m.state.albumLoad.nextStartIndex.ToStr())
        loadAlbumPage(m.state.albumLoad.nextStartIndex)
    end if
    focusAlbums()
end sub


'-------------------------------------------------------------------------------
' deactivate
'-------------------------------------------------------------------------------
sub deactivate()
    wasLoading = m.state.foregroundLoad.kind <> ""
    hidePagingSpinner()
    m.state.foregroundLoad.kind = ""
    m.state.foregroundLoad.startedAt = invalid
    m.state.albumLoad.requestInFlight = false
    m.state.albumLoad.queryId = m.state.albumLoad.queryId + 1
    m.state.artistLoad.requestInFlight = false
    m.state.filterLoad.requestInFlight = false
    m.state.artistLoad.queryId = m.state.artistLoad.queryId + 1
    m.state.filterLoad.queryId = m.state.filterLoad.queryId + 1
    AsyncLifecycle.Deactivate(m.state.lifecycle)
    m.musicLibraryTask.control = "stop"
    m.musicArtistsTask.control = "stop"
    m.musicFilterOptionsTask.control = "stop"
    if wasLoading then
        showForegroundControls()
        Spinner.Hide()
    end if
end sub


'-------------------------------------------------------------------------------
' onKeyEvent
'-------------------------------------------------------------------------------
function onKeyEvent(key as string, press as boolean) as boolean
    if press = false then return false
    if key = "options" and getActiveGrid().isInFocusChain() then return openMediaActions()

    if key = "up" and m.browseByButton.isInFocusChain() then
        m.top.focusExitUp = true
        return true
    end if

    if key = "up" and m.sortButton.isInFocusChain() then
        m.top.focusExitUp = true
        return true
    end if

    if key = "right" and m.browseByButton.isInFocusChain() then
        if focusSortButton() = true then return true
        return true
    end if

    if key = "left" and m.sortButton.isInFocusChain() then return focusBrowseByButton()

    if key = "up" and isAlbumsGridAtFirstRow() then
        if focusFilterButtonRow() = true then return true
        return focusBrowseByButton()
    end if

    if key = "back" then
        if isFirstAlbumFocused() <> true then
            getActiveGrid().jumpToItem = 0
            return true
        end if

        m.top.closeRequested = true
        return true
    end if

    return false
end function
