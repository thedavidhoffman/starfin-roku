'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.log = new Logger("MusicLibrary", m.global.logService)
    m.titleLabel = m.top.findNode("titleLabel")
    m.browseByButton = m.top.findNode("browseByButton")
    m.sortButton = m.top.findNode("sortButton")
    m.filterButtonRow = m.top.findNode("filterButtonRow")
    m.emptyFilterLabel = m.top.findNode("emptyFilterLabel")
    m.musicGrid = m.top.findNode("musicGrid")
    m.musicLibraryTask = m.top.findNode("musicLibraryTask")
    m.musicArtistsTask = m.top.findNode("musicArtistsTask")
    m.musicFilterOptionsTask = m.top.findNode("musicFilterOptionsTask")
    m.musicLibraryTask.observeField("response", "onMusicLibraryResponse")
    m.musicArtistsTask.observeField("response", "onMusicArtistsResponse")
    m.musicFilterOptionsTask.observeField("response", "onMusicFilterOptionsResponse")
    m.browseByButton.observeField("overlayRequested", "onSortOverlayRequested")
    m.browseByButton.observeField("focusExitDown", "onBrowseByButtonFocusExitDown")
    m.sortButton.observeField("sortOrderChanged", "onSortOrderChanged")
    m.sortButton.observeField("focusExitDown", "onSortButtonFocusExitDown")
    m.filterButtonRow.observeField("filterSelected", "onFilterButtonRowSelected")
    m.filterButtonRow.observeField("focusExitUp", "onFilterButtonRowFocusExitUp")
    m.filterButtonRow.observeField("focusExitDown", "onFilterButtonRowFocusExitDown")
    m.musicGrid.observeField("itemSelected", "onMusicItemSelected")
    m.musicGrid.observeField("itemFocused", "onMusicGridItemFocused")
    m.state = {
        request: invalid
        loadedAlbums: []
        artists: []
        selectedSortKey: "Album"
        selectedSort: getDefaultSortSelection()
        activeFilterType: ""
        selectedDecade: -1
        selectedGenre: ""
        filterCache: createEmptyFilterCache()
        filterLoad: {
            status: "idle"
            requestInFlight: false
            queryId: 0
        }
        refreshPending: false
        foregroundLoad: {
            kind: ""
            pendingKind: ""
            startedAt: invalid
            controlsHidden: false
            restoreFilterVisible: false
        }
        pagingLoad: {
            spinnerVisible: false
        }
        albumLoad: {
            status: "idle"
            requestInFlight: false
            nextStartIndex: 0
            totalCount: -1
            hasMore: false
            queryId: 0
        }
        artistLoad: {
            status: "idle"
            queryId: 0
            requestInFlight: false
            nextStartIndex: 0
            totalCount: -1
            hasMore: false
        }
        lifecycle: AsyncLifecycle.Create()
    }
    syncSortControls()
end sub

'-------------------------------------------------------------------------------
' onLoadRequestChanged
'-------------------------------------------------------------------------------
sub onLoadRequestChanged()
    request = m.top.loadRequest
    if request = invalid then return

    m.state.request = request
    m.state.loadedAlbums = []
    m.state.artists = []
    m.state.albumLoad.status = "loading"
    m.state.albumLoad.requestInFlight = false
    m.state.albumLoad.nextStartIndex = 0
    m.state.albumLoad.totalCount = -1
    m.state.albumLoad.hasMore = false
    m.state.albumLoad.queryId = m.state.albumLoad.queryId + 1
    m.state.artistLoad.status = "idle"
    m.state.artistLoad.requestInFlight = false
    m.state.artistLoad.nextStartIndex = 0
    m.state.artistLoad.totalCount = -1
    m.state.artistLoad.hasMore = false
    m.state.artistLoad.queryId = m.state.artistLoad.queryId + 1
    m.state.filterLoad.status = "loading"
    m.state.filterLoad.requestInFlight = false
    m.state.filterLoad.queryId = m.state.filterLoad.queryId + 1
    savedState = LibraryViewStateStore.Load(Format.SafeString(request.accountKey, ""), Format.SafeString(request.libraryId, ""))
    if savedState <> invalid then
        applySavedMusicLibraryViewState(request, savedState)
    else if request.favoriteOnly = true then
        m.state.selectedSortKey = "Favorites"
        m.state.selectedSort = getFavoritesSortSelection()
        m.state.activeFilterType = ""
        m.state.selectedDecade = -1
        m.state.selectedGenre = ""
    else
        m.state.selectedSortKey = "Album"
        m.state.selectedSort = getDefaultSortSelection()
        m.state.activeFilterType = ""
        m.state.selectedDecade = -1
        m.state.selectedGenre = ""
    end if
    configureCurrentAlbumRequest()
    m.state.filterCache = createEmptyFilterCache()
    syncSortControls()
    hideFilterButtonRow()
    AsyncLifecycle.Begin(m.state.lifecycle, request.libraryId)
    updateTitleLabel()
    renderAlbums([])
    if isArtistBrowseMode() then
        startArtistQuery()
    else
        m.log.write("Album load started libraryId=" + Format.SafeString(request.libraryId, ""))
        queueForegroundLoad("albums")
    end if
    loadFilterOptions()
end sub

'-------------------------------------------------------------------------------
' loadFilterOptions
'-------------------------------------------------------------------------------
sub loadFilterOptions()
    filterRequest = {}
    for each key in m.state.request
        filterRequest[key] = m.state.request[key]
    end for
    filterRequest.queryId = m.state.filterLoad.queryId
    m.state.filterLoad.requestInFlight = true
    m.musicFilterOptionsTask.control = "stop"
    m.musicFilterOptionsTask.request = filterRequest
    m.musicFilterOptionsTask.control = "run"
end sub

'-------------------------------------------------------------------------------
' onMusicFilterOptionsResponse
'-------------------------------------------------------------------------------
sub onMusicFilterOptionsResponse()
    response = m.musicFilterOptionsTask.response
    if response = invalid then return
    if AsyncLifecycle.IsCurrentResponse(m.state.lifecycle, response, "libraryId", "musicFilterOptions") <> true then return
    if Number.ToInteger(response.queryId, -1) <> m.state.filterLoad.queryId then return
    if response.ok <> true then
        m.state.filterLoad.requestInFlight = false
        m.state.filterLoad.status = "failed"
        m.log.error("Music filter options failed libraryId=" + getLibraryId())
        return
    end if

    m.state.filterLoad.requestInFlight = false
    m.state.filterLoad.status = "loaded"
    m.state.filterCache = createFilterCacheFromOptions(response.filterOptions)
    if reconcileActiveFilterSelection() then return
    if isDecadeFilterActive() then showDecadeFilterRow()
    if isGenreFilterActive() then showGenreFilterRow()
end sub

'-------------------------------------------------------------------------------
' reconcileActiveFilterSelection
'-------------------------------------------------------------------------------
function reconcileActiveFilterSelection() as boolean
    if isDecadeFilterActive() then
        options = m.state.filterCache.decadeOptions
        if options.Count() = 0 then return fallBackToAlbumBrowse()
        if filterOptionsContainValue(options, m.state.selectedDecade.ToStr()) then return false

        m.state.selectedDecade = getFirstDecadeFilterValue(options)
        applySelectedDecadeToRequest()
        showDecadeFilterRow()
        persistMusicLibraryViewState()
        reloadMusicLibrary()
        return true
    end if

    if isGenreFilterActive() then
        options = m.state.filterCache.genreOptions
        if options.Count() = 0 then return fallBackToAlbumBrowse()
        if filterOptionsContainValue(options, m.state.selectedGenre) then return false

        m.state.selectedGenre = getFirstGenreFilterValue(options)
        m.state.request.genre = m.state.selectedGenre
        showGenreFilterRow()
        persistMusicLibraryViewState()
        reloadMusicLibrary()
        return true
    end if

    return false
end function

'-------------------------------------------------------------------------------
' fallBackToAlbumBrowse
'-------------------------------------------------------------------------------
function fallBackToAlbumBrowse() as boolean
    m.state.selectedSortKey = "Album"
    m.state.selectedSort = getDefaultSortSelection()
    m.state.activeFilterType = ""
    m.state.selectedDecade = -1
    m.state.selectedGenre = ""
    configureCurrentAlbumRequest()
    hideFilterButtonRow()
    syncSortControls()
    persistMusicLibraryViewState()
    reloadMusicLibrary()
    return true
end function

'-------------------------------------------------------------------------------
' onMusicArtistsResponse
'-------------------------------------------------------------------------------
sub onMusicArtistsResponse()
    response = m.musicArtistsTask.response
    if response = invalid then return
    if AsyncLifecycle.IsCurrentResponse(m.state.lifecycle, response, "libraryId", "musicArtists") <> true then return
    if Number.ToInteger(response.queryId, -1) <> m.state.artistLoad.queryId then return
    if response.ok <> true then
        hidePagingSpinner()
        m.state.artistLoad.requestInFlight = false
        m.state.artistLoad.status = "failed"
        m.state.artistLoad.hasMore = false
        m.log.error("Artist load failed libraryId=" + getLibraryId() + " message=" + Format.SafeString(response.errorMessage, "Unable to load music artists."))
        if isArtistBrowseMode() then
            AppStatus.SetMessage(Format.SafeString(response.errorMessage, "Unable to load music artists."))
            if m.state.foregroundLoad.kind = "artists" and finishForegroundLoad("artists") then focusBrowseByButton()
        end if
        return
    end if

    startIndex = Number.ToInteger(response.startIndex, -1)
    expectedStartIndex = m.state.artistLoad.nextStartIndex
    if startIndex <> expectedStartIndex then
        hidePagingSpinner()
        m.state.artistLoad.requestInFlight = false
        m.state.artistLoad.status = "failed"
        m.state.artistLoad.hasMore = false
        m.log.error("Artist page rejected libraryId=" + getLibraryId() + " expectedStartIndex=" + expectedStartIndex.ToStr() + " receivedStartIndex=" + startIndex.ToStr())
        if m.state.foregroundLoad.kind = "artists" and finishForegroundLoad("artists") then focusBrowseByButton()
        return
    end if
    hidePagingSpinner()
    m.state.artistLoad.requestInFlight = false
    pageArtists = getValidMusicItems(response.payload, "artist")
    for each artist in pageArtists
        m.state.artists.Push(artist)
    end for
    m.state.artistLoad.status = "loaded"
    m.state.artistLoad.nextStartIndex = Number.ToInteger(response.nextStartIndex, startIndex + pageArtists.Count())
    m.state.artistLoad.totalCount = Number.ToInteger(response.totalRecordCount, m.state.artists.Count())
    m.state.artistLoad.hasMore = response.hasMore = true
    m.log.write("Artist page accepted libraryId=" + getLibraryId() + " count=" + m.state.artists.Count().ToStr())
    if isArtistBrowseMode() then
        AppStatus.ClearMessage()
        if startIndex = 0 then
            renderArtists()
        else
            appendArtistPage(pageArtists)
        end if
        updateTitleLabel(m.state.artistLoad.totalCount)
        blockingEnded = false
        if m.state.foregroundLoad.kind = "artists" and (m.state.artists.Count() > 0 or m.state.artistLoad.hasMore <> true) then blockingEnded = finishForegroundLoad("artists")
        if blockingEnded then focusAlbums()
        if pageArtists.Count() = 0 and m.state.artistLoad.hasMore then
            loadArtistPage(m.state.artistLoad.nextStartIndex)
        else
            requestNextArtistPageIfNeeded()
        end if
    end if
end sub

'-------------------------------------------------------------------------------
' onMusicLibraryResponse
'-------------------------------------------------------------------------------
sub onMusicLibraryResponse()
    response = m.musicLibraryTask.response
    if response = invalid then return
    if AsyncLifecycle.IsCurrentResponse(m.state.lifecycle, response, "libraryId", "musicLibrary") <> true then return
    if Number.ToInteger(response.queryId, -1) <> m.state.albumLoad.queryId then return
    if response.ok <> true then
        hidePagingSpinner()
        m.state.albumLoad.requestInFlight = false
        m.state.albumLoad.status = "failed"
        m.state.albumLoad.hasMore = false
        m.log.error("Album load failed libraryId=" + getLibraryId() + " message=" + Format.SafeString(response.errorMessage, "Unable to load music library."))
        AppStatus.SetMessage(Format.SafeString(response.errorMessage, "Unable to load music library."))
        if m.state.foregroundLoad.kind = "albums" and finishForegroundLoad("albums") then focusBrowseByButton()
        return
    end if

    startIndex = Number.ToInteger(response.startIndex, -1)
    expectedStartIndex = m.state.albumLoad.nextStartIndex
    if startIndex <> expectedStartIndex then
        hidePagingSpinner()
        m.state.albumLoad.requestInFlight = false
        m.state.albumLoad.status = "failed"
        m.state.albumLoad.hasMore = false
        m.log.error("Album page rejected libraryId=" + getLibraryId() + " expectedStartIndex=" + expectedStartIndex.ToStr() + " receivedStartIndex=" + startIndex.ToStr())
        if m.state.foregroundLoad.kind = "albums" and finishForegroundLoad("albums") then focusBrowseByButton()
        return
    end if
    hidePagingSpinner()
    m.state.albumLoad.requestInFlight = false
    if startIndex = 0 then
        m.state.albumLoad.totalCount = Number.ToInteger(response.totalRecordCount, -1)
        if m.state.albumLoad.totalCount >= 0 then updateTitleLabel(m.state.albumLoad.totalCount)
    end if
    pageAlbums = getValidMusicItems(response.payload, "album")
    for each album in pageAlbums
        m.state.loadedAlbums.Push(album)
    end for
    m.log.write("Album page accepted libraryId=" + getLibraryId() + " startIndex=" + startIndex.ToStr() + " pageCount=" + pageAlbums.Count().ToStr() + " totalLoaded=" + m.state.loadedAlbums.Count().ToStr())
    AppStatus.ClearMessage()

    hasMore = response.hasMore = true
    m.state.albumLoad.hasMore = hasMore
    m.state.albumLoad.nextStartIndex = Number.ToInteger(response.nextStartIndex, startIndex + pageAlbums.Count())
    m.state.albumLoad.status = "loaded"
    if m.state.albumLoad.totalCount < 0 then updateTitleLabel(m.state.loadedAlbums.Count())
    appendAlbumPage(pageAlbums)
    blockingEnded = false
    if m.state.foregroundLoad.kind = "albums" and (m.state.loadedAlbums.Count() > 0 or m.state.albumLoad.hasMore <> true) then blockingEnded = finishForegroundLoad("albums")
    if blockingEnded and isMusicLibraryControlFocused() = false then focusAlbums()
    if pageAlbums.Count() = 0 and m.state.albumLoad.hasMore then
        loadAlbumPage(m.state.albumLoad.nextStartIndex)
    else
        requestNextAlbumPageIfNeeded()
    end if
end sub

'-------------------------------------------------------------------------------
' isMusicLibraryControlFocused
'-------------------------------------------------------------------------------
function isMusicLibraryControlFocused() as boolean
    if m.browseByButton.isInFocusChain() then return true
    if m.sortButton.isInFocusChain() then return true
    return m.filterButtonRow.isInFocusChain()
end function

'-------------------------------------------------------------------------------
' loadAlbumPage
'-------------------------------------------------------------------------------
sub loadAlbumPage(startIndex as integer)
    request = {}
    for each key in m.state.request
        request[key] = m.state.request[key]
    end for
    request.pageStartIndex = startIndex
    request.queryId = m.state.albumLoad.queryId
    request.albumSortOrder = Format.SafeString(m.state.request.albumSortOrder, "Ascending")

    if startIndex > 0 then showPagingSpinner()
    m.state.albumLoad.requestInFlight = true
    m.musicLibraryTask.control = "stop"
    m.musicLibraryTask.request = request
    m.musicLibraryTask.control = "run"
end sub

'-------------------------------------------------------------------------------
' onMusicGridItemFocused
'-------------------------------------------------------------------------------
sub onMusicGridItemFocused()
    if isArtistBrowseMode() then
        requestNextArtistPageIfNeeded()
    else
        requestNextAlbumPageIfNeeded()
    end if
end sub

'-------------------------------------------------------------------------------
' onMusicItemSelected
'-------------------------------------------------------------------------------
sub onMusicItemSelected()
    if isArtistBrowseMode() then
        onArtistSelected()
    else
        onAlbumSelected()
    end if
end sub

'-------------------------------------------------------------------------------
' requestNextAlbumPageIfNeeded
'-------------------------------------------------------------------------------
sub requestNextAlbumPageIfNeeded()
    if m.state.albumLoad.hasMore <> true or m.state.albumLoad.requestInFlight = true then return
    if isFocusNearLoadedEnd(m.musicGrid, m.state.loadedAlbums.Count()) <> true then return

    m.state.albumLoad.status = "loading"
    loadAlbumPage(m.state.albumLoad.nextStartIndex)
end sub

'-------------------------------------------------------------------------------
' isFocusNearLoadedEnd
'-------------------------------------------------------------------------------
function isFocusNearLoadedEnd(grid as object, loadedCount as integer) as boolean
    if loadedCount <= 0 then return false
    focusedIndex = Number.ToInteger(grid.itemFocused, 0)
    columnCount = Number.ToInteger(grid.numColumns, 1)
    if columnCount <= 0 then columnCount = 1
    focusedRow = Number.ToInteger(focusedIndex / columnCount, 0)
    loadedRows = Number.ToInteger((loadedCount + columnCount - 1) / columnCount, 0)
    return focusedRow >= loadedRows - 5
end function

'-------------------------------------------------------------------------------
' renderAlbums
'-------------------------------------------------------------------------------
sub renderAlbums(albums as object)
    if albums = invalid then albums = []
    m.state.loadedAlbums = albums
    m.emptyFilterLabel.visible = isFavoriteBrowseActive() and albums.Count() = 0

    content = CreateObject("roSGNode", "ContentNode")
    request = m.state.request

    for each album in albums
        addAlbumContentNode(content, album, request)
    end for

    m.musicGrid.content = content
    m.musicGrid.visible = true
end sub

'-------------------------------------------------------------------------------
' appendAlbumPage
'-------------------------------------------------------------------------------
sub appendAlbumPage(albums as object)
    content = m.musicGrid.content
    if content = invalid then
        content = CreateObject("roSGNode", "ContentNode")
        m.musicGrid.content = content
    end if

    for each album in albums
        addAlbumContentNode(content, album, m.state.request)
    end for
    m.emptyFilterLabel.visible = isFavoriteBrowseActive() and m.state.loadedAlbums.Count() = 0
    m.musicGrid.visible = true
end sub

'-------------------------------------------------------------------------------
' addAlbumContentNode
'-------------------------------------------------------------------------------
function addAlbumContentNode(content as object, album as dynamic, request as dynamic) as boolean
    if Arrays.IsAssocArray(album) = false then
        m.log.error("Skipping malformed album libraryId=" + getLibraryId())
        return false
    end if

    albumName = getDisplayText(Format.FirstNonEmpty([album.Name], "Untitled Album"))
    artistName = getDisplayText(getAlbumArtistName(album))
    child = content.createChild("ContentNode")
    child.title = albumName
    child.HDPosterUrl = getAlbumArtworkUrl(album, request)
    child.AddFields({
        artistName: artistName
        primaryLabel: artistName
        secondaryLabel: albumName
        raw: album
    })
    return true
end function

'-------------------------------------------------------------------------------
' isAlbumBrowseMode
'-------------------------------------------------------------------------------
function isAlbumBrowseMode() as boolean
    return Format.SafeString(m.state.selectedSortKey, "Album") = "Album"
end function

'-------------------------------------------------------------------------------
' renderArtists
'-------------------------------------------------------------------------------
sub renderArtists()
    artists = []
    for each artist in m.state.artists
        if Arrays.IsAssocArray(artist) then
            artists.Push(artist)
        else
            m.log.error("Skipping malformed artist libraryId=" + getLibraryId())
        end if
    end for
    content = CreateObject("roSGNode", "ContentNode")
    request = m.state.request
    for each artist in artists
        addArtistContentNode(content, artist, request)
    end for

    m.musicGrid.content = content
    m.musicGrid.visible = true
    updateTitleLabel(artists.Count())
    m.musicGrid.jumpToItem = 0
    m.musicGrid.itemFocused = 0
end sub

'-------------------------------------------------------------------------------
' getArtistImageUrl
'-------------------------------------------------------------------------------
function getArtistImageUrl(artist as object, request as object, imageType as string, width as integer, height as integer) as string
    itemId = Format.SafeString(artist.Id, "")
    tag = ""
    if imageType = "Primary" and artist.ImageTags <> invalid then tag = Format.SafeString(artist.ImageTags.Primary, "")
    if imageType = "Logo" and artist.ImageTags <> invalid then tag = Format.SafeString(artist.ImageTags.Logo, "")
    if imageType = "Backdrop" and artist.BackdropImageTags <> invalid and artist.BackdropImageTags.Count() > 0 then tag = Format.SafeString(artist.BackdropImageTags[0], "")
    if itemId = "" or tag = "" then return ""
    return Url.BuildImageUrl(request.server, itemId, imageType, tag, width, height)
end function

'-------------------------------------------------------------------------------
' isArtistBrowseMode
'-------------------------------------------------------------------------------
function isArtistBrowseMode() as boolean
    return Format.SafeString(m.state.selectedSortKey, "Album") = "Artist"
end function

'-------------------------------------------------------------------------------
' getAlbumArtworkUrl
'-------------------------------------------------------------------------------
function getAlbumArtworkUrl(album as dynamic, request as dynamic) as string
    if Arrays.IsAssocArray(album) = false then return ""
    if request = invalid then return ""

    directUrl = Format.FirstNonEmpty([album.ImageURL, album.ImageUrl, album.PrimaryImageUrl], "")
    if directUrl <> "" then return directUrl

    itemId = Format.SafeString(Format.FirstNonEmpty([album.Id], ""), "")
    if itemId = "" then return ""

    primaryTag = ""
    if album.ImageTags <> invalid and album.ImageTags.Primary <> invalid then primaryTag = album.ImageTags.Primary
    if primaryTag = "" then return ""

    return Url.BuildImageUrl(request.server, itemId, "Primary", primaryTag, 342, 342)
end function

'-------------------------------------------------------------------------------
' getAlbumArtistName
'-------------------------------------------------------------------------------
function getAlbumArtistName(album as dynamic) as string
    if Arrays.IsAssocArray(album) = false then return "Unknown Artist"

    artist = Format.FirstNonEmpty([album.AlbumArtist, album.Artist], "")
    if artist <> "" then return artist

    artist = Strings.GetJoinedText(album.AlbumArtists)
    if artist <> "" then return artist

    artist = Strings.GetJoinedText(album.Artists)
    if artist <> "" then return artist

    return "Unknown Artist"
end function

'-------------------------------------------------------------------------------
' getAlbumYear
'-------------------------------------------------------------------------------
function getAlbumYear(album as dynamic) as integer
    if Arrays.IsAssocArray(album) = false then return 0

    year = Number.ToInteger(album.ProductionYear, 0)
    if year > 0 then return year

    premiereDate = Format.SafeString(album.PremiereDate, "")
    if Len(premiereDate) < 4 then return 0

    return Number.ToInteger(Left(premiereDate, 4), 0)
end function

'-------------------------------------------------------------------------------
' getDisplayText
'-------------------------------------------------------------------------------
function getDisplayText(text as string) as string
    normalizedText = Strings.Trim(text)
    if LCase(Left(normalizedText, 4)) = "the " then return Mid(normalizedText, 5) + ", The"

    return normalizedText
end function

'-------------------------------------------------------------------------------
' getItemsFromPayload
'-------------------------------------------------------------------------------
function getItemsFromPayload(payload as dynamic) as object
    if payload = invalid then return []
    if Type(payload) = "roArray" then return payload
    if Arrays.IsAssocArray(payload) = false then
        m.log.error("Unexpected music payload type=" + Type(payload))
        return []
    end if
    if Type(payload.Items) = "roArray" then return payload.Items

    m.log.error("Music payload Items is not an array")
    return []
end function

'-------------------------------------------------------------------------------
' createEmptyFilterCache
'-------------------------------------------------------------------------------
function createEmptyFilterCache() as object
    return {
        decadeOptions: []
        genreOptions: []
    }
end function

'-------------------------------------------------------------------------------
' createFilterCacheFromOptions
'-------------------------------------------------------------------------------
function createFilterCacheFromOptions(filterOptions as dynamic) as object
    cache = createEmptyFilterCache()
    if Arrays.IsAssocArray(filterOptions) = false then return cache

    if filterOptions.decadeOptions <> invalid then cache.decadeOptions = filterOptions.decadeOptions
    if filterOptions.genreOptions <> invalid then cache.genreOptions = filterOptions.genreOptions

    return cache
end function

'-------------------------------------------------------------------------------
' isDecadeFilterActive
'-------------------------------------------------------------------------------
function isDecadeFilterActive() as boolean
    return Format.SafeString(m.state.activeFilterType, "") = "Decade"
end function

'-------------------------------------------------------------------------------
' isGenreFilterActive
'-------------------------------------------------------------------------------
function isGenreFilterActive() as boolean
    return Format.SafeString(m.state.activeFilterType, "") = "Genre"
end function

'-------------------------------------------------------------------------------
' updateTitleLabel
'-------------------------------------------------------------------------------
sub updateTitleLabel(albumCount = invalid as dynamic)
    title = "Music"
    if m.state <> invalid and m.state.request <> invalid then title = Format.SafeString(m.state.request.title, "Music")
    if albumCount <> invalid then title = title + MediaMetadata.BulletSeparator() + Number.FormatWithThousandsSeparator(albumCount) + " items"

    m.titleLabel.text = title
end sub

'-------------------------------------------------------------------------------
' appendArtistPage
'-------------------------------------------------------------------------------
sub appendArtistPage(artists as object)
    content = m.musicGrid.content
    if content = invalid then content = CreateObject("roSGNode", "ContentNode")
    for each artist in artists
        if Arrays.IsAssocArray(artist) then addArtistContentNode(content, artist, m.state.request)
    end for
    if m.musicGrid.content = invalid then m.musicGrid.content = content
end sub

'-------------------------------------------------------------------------------
' addArtistContentNode
'-------------------------------------------------------------------------------
sub addArtistContentNode(content as object, artist as object, request as object)
    child = content.createChild("ContentNode")
    artistId = Format.SafeString(artist.Id, "")
    artistName = Format.FirstNonEmpty([artist.Name], "Unknown Artist")
    child.title = artistName
    child.HDPosterUrl = getArtistImageUrl(artist, request, "Primary", 342, 342)
    child.AddFields({
        raw: artist
        itemId: artistId
        primaryLabel: artistName
        secondaryLabel: ""
        cardType: "artist"
    })
end sub

'-------------------------------------------------------------------------------
' getMusicSortOptions
'-------------------------------------------------------------------------------
function getMusicSortOptions() as object
    options = [
        { optionKey: "Album", sortKey: "Album", sortOrder: "Ascending", label: "Album" }
        { optionKey: "ArtistAlbum", sortKey: "ArtistAlbum", sortOrder: "Ascending", label: "Artist/Album" }
        { optionKey: "Artist", sortKey: "Artist", sortOrder: "Ascending", label: "Artist" }
        { optionKey: "Favorites", sortKey: "Album", sortOrder: "Ascending", label: "Favorites" }
    ]
    if m.state.filterCache.decadeOptions.Count() > 0 then options.Push({ optionKey: "Decade", sortKey: "", sortOrder: "", label: "Decade" })
    if m.state.filterCache.genreOptions.Count() > 0 then options.Push({ optionKey: "Genre", sortKey: "", sortOrder: "", label: "Genre" })
    return options
end function

'-------------------------------------------------------------------------------
' getValidMusicItems
'-------------------------------------------------------------------------------
function getValidMusicItems(payload as dynamic, itemKind as string) as object
    validItems = []
    for each item in getItemsFromPayload(payload)
        if Arrays.IsAssocArray(item) then
            validItems.Push(item)
        else
            m.log.error("Skipping malformed " + itemKind + " libraryId=" + getLibraryId())
        end if
    end for
    return validItems
end function

'-------------------------------------------------------------------------------
' getDefaultSortSelection
'-------------------------------------------------------------------------------
function getDefaultSortSelection() as object
    return {
        optionKey: "Album"
        sortKey: "Album"
        sortOrder: "Ascending"
        label: "Album"
    }
end function

'-------------------------------------------------------------------------------
' getFavoritesSortSelection
'-------------------------------------------------------------------------------
function getFavoritesSortSelection() as object
    return {
        optionKey: "Favorites"
        sortKey: "Album"
        sortOrder: "Ascending"
        label: "Favorites"
    }
end function

'-------------------------------------------------------------------------------
' isFavoriteBrowseActive
'-------------------------------------------------------------------------------
function isFavoriteBrowseActive() as boolean
    return m.state.request <> invalid and m.state.request.favoriteOnly = true
end function

'-------------------------------------------------------------------------------
' syncSortControls
'-------------------------------------------------------------------------------
sub syncSortControls()
    m.browseByButton.selectedSort = m.state.selectedSort
    m.sortButton.selectedSort = m.state.selectedSort
    m.sortButton.sortEnabled = canUseSortOrder(m.state.selectedSort)
end sub

'-------------------------------------------------------------------------------
' canUseSortOrder
'-------------------------------------------------------------------------------
function canUseSortOrder(selection as object) as boolean
    if selection = invalid then return false

    optionKey = Format.SafeString(selection.optionKey, "")
    if optionKey = "Decade" or optionKey = "Genre" then return false

    sortKey = Format.SafeString(selection.sortKey, "")
    return sortKey = "Album" or sortKey = "ArtistAlbum" or sortKey = "Artist"
end function

'-------------------------------------------------------------------------------
' onSortOverlayRequested
'-------------------------------------------------------------------------------
sub onSortOverlayRequested()
    request = m.browseByButton.overlayRequested
    if request = invalid then return

    request.sourcePage = "musicLibrary"
    request.selectedSortKey = m.state.selectedSortKey
    request.sortOptions = getMusicSortOptions()
    m.top.overlayRequested = request
end sub

'-------------------------------------------------------------------------------
' onSortOrderChanged
'-------------------------------------------------------------------------------
sub onSortOrderChanged()
    selection = m.sortButton.sortOrderChanged
    if selection = invalid then return
    if canUseSortOrder(m.state.selectedSort) <> true then return

    sortOrder = Format.SafeString(selection.sortOrder, "Ascending")
    if sortOrder <> "Descending" then sortOrder = "Ascending"
    if Format.SafeString(m.state.selectedSort.sortOrder, "Ascending") = sortOrder then return

    m.state.selectedSort.sortOrder = sortOrder
    syncSortControls()
    persistMusicLibraryViewState()
    if isArtistBrowseMode() then
        startArtistQuery()
    else
        m.state.request.albumSortOrder = sortOrder
        reloadMusicLibrary()
    end if
end sub

'-------------------------------------------------------------------------------
' applySortSelection
'-------------------------------------------------------------------------------
function applySortSelection(selection as object) as boolean
    if selection = invalid then return false

    optionKey = Format.SafeString(selection.optionKey, "")
    if optionKey = "" then return false
    if optionKey = m.state.selectedSortKey then
        if optionKey = "Artist" and m.state.artistLoad.status = "failed" then
            startArtistQuery()
            return true
        end if
        if optionKey <> "Artist" and m.state.albumLoad.status = "failed" then
            reloadMusicLibrary()
            return true
        end if
        return false
    end if
    cancelPendingArtistLoad()
    m.state.request.favoriteOnly = false
    m.state.request.genre = ""
    m.state.request.years = []
    m.state.request.albumSortBy = "SortName"
    m.state.request.albumSortOrder = "Ascending"
    m.state.activeFilterType = ""
    m.state.selectedDecade = -1
    m.state.selectedGenre = ""
    hideFilterButtonRow()

    if optionKey = "Decade" then
        m.state.selectedSort = {
            optionKey: "Decade"
            sortKey: "Album"
            sortOrder: "Ascending"
            label: "Decade"
        }
        m.state.activeFilterType = "Decade"
        m.state.selectedDecade = getFirstDecadeFilterValue(m.state.filterCache.decadeOptions)
        applySelectedDecadeToRequest()
        showDecadeFilterRow()
    else if optionKey = "Genre" then
        m.state.selectedSortKey = optionKey
        m.state.selectedSort = {
            optionKey: "Genre"
            sortKey: "Album"
            sortOrder: "Ascending"
            label: "Genre"
        }
        m.state.activeFilterType = "Genre"
        m.state.selectedGenre = getFirstGenreFilterValue(m.state.filterCache.genreOptions)
        m.state.request.genre = m.state.selectedGenre
        showGenreFilterRow()
    else if optionKey = "ArtistAlbum" then
        m.state.selectedSort = {
            optionKey: "ArtistAlbum"
            sortKey: "ArtistAlbum"
            sortOrder: "Ascending"
            label: "Artist/Album"
        }
        m.state.request.albumSortBy = "AlbumArtist,SortName"
    else if optionKey = "Artist" then
        m.state.selectedSort = {
            optionKey: "Artist"
            sortKey: "Artist"
            sortOrder: "Ascending"
            label: "Artist"
        }
    else if optionKey = "Favorites" then
        m.state.selectedSort = getFavoritesSortSelection()
        m.state.request.favoriteOnly = true
    else
        m.state.selectedSort = getDefaultSortSelection()
    end if

    m.state.selectedSortKey = Format.SafeString(m.state.selectedSort.optionKey, "Album")
    syncSortControls()
    persistMusicLibraryViewState()
    if optionKey = "Artist" then
        startArtistQuery()
    else
        reloadMusicLibrary()
    end if
    return true
end function

'-------------------------------------------------------------------------------
' cancelPendingArtistLoad
'-------------------------------------------------------------------------------
sub cancelPendingArtistLoad()
    if m.state.artistLoad.status <> "loading" then return

    hidePagingSpinner()
    m.log.write("Artist load cancelled libraryId=" + getLibraryId())
    m.musicArtistsTask.control = "stop"
    m.state.artistLoad.status = "idle"
    m.state.artistLoad.queryId = m.state.artistLoad.queryId + 1
    if m.state.foregroundLoad.kind = "artists" then
        m.state.foregroundLoad.kind = ""
        m.state.foregroundLoad.startedAt = invalid
        showForegroundControls()
        Spinner.Hide()
    end if
    AsyncLifecycle.Deactivate(m.state.lifecycle)
end sub

'-------------------------------------------------------------------------------
' reloadMusicLibrary
'-------------------------------------------------------------------------------
sub reloadMusicLibrary()
    request = m.state.request
    if request = invalid then return

    hidePagingSpinner()
    m.state.loadedAlbums = []
    m.state.artists = []
    m.state.albumLoad.status = "loading"
    m.state.albumLoad.requestInFlight = false
    m.state.albumLoad.nextStartIndex = 0
    m.state.albumLoad.totalCount = -1
    m.state.albumLoad.hasMore = false
    m.state.albumLoad.queryId = m.state.albumLoad.queryId + 1
    m.state.artistLoad.status = "idle"
    m.state.artistLoad.queryId = m.state.artistLoad.queryId + 1
    AsyncLifecycle.Begin(m.state.lifecycle, request.libraryId)
    updateTitleLabel()
    renderAlbums([])
    m.log.write("Album reload started libraryId=" + Format.SafeString(request.libraryId, ""))
    queueForegroundLoad("albums")
    m.musicArtistsTask.control = "stop"
end sub

'-------------------------------------------------------------------------------
' showDecadeFilterRow
'-------------------------------------------------------------------------------
sub showDecadeFilterRow()
    options = m.state.filterCache.decadeOptions
    if options = invalid then options = []
    if filterOptionsContainValue(options, m.state.selectedDecade.ToStr()) <> true then m.state.selectedDecade = getFirstDecadeFilterValue(options)

    m.filterButtonRow.filterType = "Decade"
    m.filterButtonRow.items = options
    m.filterButtonRow.selectedValue = m.state.selectedDecade.ToStr()
    filterVisible = options.Count() > 0
    if m.state.foregroundLoad.controlsHidden then
        m.state.foregroundLoad.restoreFilterVisible = filterVisible
        m.filterButtonRow.visible = false
    else
        m.filterButtonRow.visible = filterVisible
    end if
    updateGridLayout()
end sub

'-------------------------------------------------------------------------------
' configureCurrentAlbumRequest
'-------------------------------------------------------------------------------
sub configureCurrentAlbumRequest()
    request = m.state.request
    request.favoriteOnly = m.state.selectedSortKey = "Favorites"
    request.genre = ""
    request.years = []
    request.albumSortBy = "SortName"
    request.albumSortOrder = Format.SafeString(m.state.selectedSort.sortOrder, "Ascending")
    if m.state.selectedSortKey = "ArtistAlbum" then request.albumSortBy = "AlbumArtist,SortName"
    if m.state.selectedSortKey = "Genre" then request.genre = m.state.selectedGenre
    if m.state.selectedSortKey = "Decade" then applySelectedDecadeToRequest()
end sub

'-------------------------------------------------------------------------------
' showGenreFilterRow
'-------------------------------------------------------------------------------
sub showGenreFilterRow()
    options = m.state.filterCache.genreOptions
    if options = invalid then options = []
    if filterOptionsContainValue(options, m.state.selectedGenre) <> true then m.state.selectedGenre = getFirstGenreFilterValue(options)

    m.filterButtonRow.filterType = "Genre"
    m.filterButtonRow.items = options
    m.filterButtonRow.selectedValue = m.state.selectedGenre
    filterVisible = options.Count() > 0
    if m.state.foregroundLoad.controlsHidden then
        m.state.foregroundLoad.restoreFilterVisible = filterVisible
        m.filterButtonRow.visible = false
    else
        m.filterButtonRow.visible = filterVisible
    end if
    updateGridLayout()
end sub

'-------------------------------------------------------------------------------
' applySelectedDecadeToRequest
'-------------------------------------------------------------------------------
sub applySelectedDecadeToRequest()
    years = []
    if m.state.selectedDecade >= 0 then
        for year = m.state.selectedDecade to m.state.selectedDecade + 9
            years.Push(year.ToStr())
        end for
    end if
    m.state.request.years = years
end sub

'-------------------------------------------------------------------------------
' hideFilterButtonRow
'-------------------------------------------------------------------------------
sub hideFilterButtonRow()
    if m.state.foregroundLoad.controlsHidden then m.state.foregroundLoad.restoreFilterVisible = false
    m.filterButtonRow.visible = false
    m.filterButtonRow.items = []
    m.filterButtonRow.selectedValue = ""
    updateGridLayout()
end sub

'-------------------------------------------------------------------------------
' updateGridLayout
'-------------------------------------------------------------------------------
sub updateGridLayout()
    y = 208
    if m.filterButtonRow <> invalid and m.filterButtonRow.visible = true then y = 292
    m.musicGrid.translation = [48, y]
end sub

'-------------------------------------------------------------------------------
' getFirstDecadeFilterValue
'-------------------------------------------------------------------------------
function getFirstDecadeFilterValue(options as object) as integer
    if options = invalid or options.Count() = 0 then return -1

    return Number.ToInteger(options[0].value, -1)
end function

'-------------------------------------------------------------------------------
' getFirstGenreFilterValue
'-------------------------------------------------------------------------------
function getFirstGenreFilterValue(options as object) as string
    if options = invalid or options.Count() = 0 then return ""

    return Format.SafeString(options[0].value, "")
end function

'-------------------------------------------------------------------------------
' onFilterButtonRowSelected
'-------------------------------------------------------------------------------
sub onFilterButtonRowSelected()
    selected = m.filterButtonRow.filterSelected
    if selected = invalid then return

    filterType = Format.SafeString(selected.type, "")
    if filterType = "Decade" then
        m.state.selectedDecade = Number.ToInteger(selected.value, -1)
        m.filterButtonRow.selectedValue = m.state.selectedDecade.ToStr()
        applySelectedDecadeToRequest()
    else if filterType = "Genre" then
        m.state.selectedGenre = Format.SafeString(selected.value, "")
        m.filterButtonRow.selectedValue = m.state.selectedGenre
        m.state.request.genre = m.state.selectedGenre
    else
        return
    end if

    persistMusicLibraryViewState()
    reloadMusicLibrary()
end sub

'-------------------------------------------------------------------------------
' focusBrowseByButton
'-------------------------------------------------------------------------------
function focusBrowseByButton() as boolean
    m.top.setFocus(true)
    m.browseByButton.setFocus(true)
    return true
end function

'-------------------------------------------------------------------------------
' focusFilterButtonRow
'-------------------------------------------------------------------------------
function focusFilterButtonRow() as boolean
    if m.filterButtonRow.visible <> true then return false

    m.top.setFocus(true)
    m.filterButtonRow.callFunc("focusFirstButton")
    return true
end function

'-------------------------------------------------------------------------------
' focusSortButton
'-------------------------------------------------------------------------------
function focusSortButton() as boolean
    if m.sortButton.focusable <> true then return false

    m.top.setFocus(true)
    m.sortButton.setFocus(true)
    return true
end function

'-------------------------------------------------------------------------------
' onBrowseByButtonFocusExitDown
'-------------------------------------------------------------------------------
sub onBrowseByButtonFocusExitDown()
    if focusFilterButtonRow() <> true then focusAlbums()
end sub

'-------------------------------------------------------------------------------
' onSortButtonFocusExitDown
'-------------------------------------------------------------------------------
sub onSortButtonFocusExitDown()
    if focusFilterButtonRow() <> true then focusAlbums()
end sub

'-------------------------------------------------------------------------------
' onFilterButtonRowFocusExitUp
'-------------------------------------------------------------------------------
sub onFilterButtonRowFocusExitUp()
    focusBrowseByButton()
end sub

'-------------------------------------------------------------------------------
' onFilterButtonRowFocusExitDown
'-------------------------------------------------------------------------------
sub onFilterButtonRowFocusExitDown()
    focusAlbums()
end sub

'-------------------------------------------------------------------------------
' focusAlbums
'-------------------------------------------------------------------------------
sub focusAlbums()
    grid = getActiveGrid()
    if grid.content = invalid or grid.content.getChildCount() = 0 then
        m.top.setFocus(true)
        return
    end if

    m.top.setFocus(true)
    grid.setFocus(true)
end sub

'-------------------------------------------------------------------------------
' onFocusRequested
'-------------------------------------------------------------------------------
sub onFocusRequested()
    if m.top.visible <> true then return
    focusAlbums()
end sub

'-------------------------------------------------------------------------------
' getActiveGrid
'-------------------------------------------------------------------------------
function getActiveGrid() as object
    return m.musicGrid
end function

'-------------------------------------------------------------------------------
' activate
'-------------------------------------------------------------------------------
sub activate()
    AsyncLifecycle.BeginFromField(m.state.lifecycle, m.state.request, "libraryId")
    if m.state.refreshPending then
        m.state.refreshPending = false
        reloadMusicLibrary()
        focusAlbums()
        return
    end if
    if m.state.foregroundLoad.kind <> "" then
        focusAlbums()
        return
    end if
    if m.state.foregroundLoad.pendingKind <> "" then
        startPendingForegroundLoad()
        focusAlbums()
        return
    end if

    if m.state.filterLoad.status = "loading" and m.state.filterLoad.requestInFlight <> true then loadFilterOptions()

    if isArtistBrowseMode() then
        if m.state.artistLoad.status = "loading" and m.state.artistLoad.requestInFlight <> true then loadArtistPage(m.state.artistLoad.nextStartIndex)
    else if m.state.albumLoad.status = "loading" and m.state.albumLoad.requestInFlight <> true then
        m.log.write("Album paging resumed libraryId=" + getLibraryId() + " startIndex=" + m.state.albumLoad.nextStartIndex.ToStr())
        loadAlbumPage(m.state.albumLoad.nextStartIndex)
    end if
    focusAlbums()
end sub

'-------------------------------------------------------------------------------
' deactivate
'-------------------------------------------------------------------------------
sub deactivate()
    wasLoading = m.state.foregroundLoad.kind <> ""
    hidePagingSpinner()
    m.state.foregroundLoad.kind = ""
    m.state.foregroundLoad.startedAt = invalid
    m.state.albumLoad.requestInFlight = false
    m.state.albumLoad.queryId = m.state.albumLoad.queryId + 1
    m.state.artistLoad.requestInFlight = false
    m.state.filterLoad.requestInFlight = false
    m.state.artistLoad.queryId = m.state.artistLoad.queryId + 1
    m.state.filterLoad.queryId = m.state.filterLoad.queryId + 1
    AsyncLifecycle.Deactivate(m.state.lifecycle)
    m.musicLibraryTask.control = "stop"
    m.musicArtistsTask.control = "stop"
    m.musicFilterOptionsTask.control = "stop"
    if wasLoading then
        showForegroundControls()
        Spinner.Hide()
    end if
end sub

'-------------------------------------------------------------------------------
' startArtistQuery
'-------------------------------------------------------------------------------
sub startArtistQuery()
    request = m.state.request
    if request = invalid or request.favoriteOnly = true then return

    hidePagingSpinner()
    m.musicLibraryTask.control = "stop"
    m.state.albumLoad.requestInFlight = false
    m.state.albumLoad.status = "idle"
    m.state.albumLoad.queryId = m.state.albumLoad.queryId + 1
    m.state.artists = []
    m.state.artistLoad.status = "loading"
    m.state.artistLoad.requestInFlight = false
    m.state.artistLoad.nextStartIndex = 0
    m.state.artistLoad.totalCount = -1
    m.state.artistLoad.hasMore = false
    m.state.artistLoad.queryId = m.state.artistLoad.queryId + 1
    AsyncLifecycle.Begin(m.state.lifecycle, request.libraryId)
    AppStatus.ClearMessage()
    m.log.write("Artist load started libraryId=" + Format.SafeString(request.libraryId, ""))
    renderArtists()
    queueForegroundLoad("artists")
end sub

'-------------------------------------------------------------------------------
' queueForegroundLoad
'-------------------------------------------------------------------------------
sub queueForegroundLoad(kind as string)
    m.state.foregroundLoad.pendingKind = kind
    startPendingForegroundLoad()
end sub

'-------------------------------------------------------------------------------
' startPendingForegroundLoad
'-------------------------------------------------------------------------------
function startPendingForegroundLoad() as boolean
    kind = m.state.foregroundLoad.pendingKind
    if kind = "" then return false
    hideForegroundControls()
    Spinner.Show(0)

    m.state.foregroundLoad.pendingKind = ""
    startForegroundLoad(kind)
    if kind = "artists" then
        loadArtistPage(m.state.artistLoad.nextStartIndex)
    else
        loadAlbumPage(m.state.albumLoad.nextStartIndex)
    end if
    return true
end function

'-------------------------------------------------------------------------------
' hideForegroundControls
'-------------------------------------------------------------------------------
sub hideForegroundControls()
    if m.state.foregroundLoad.controlsHidden then return

    if m.browseByButton.isInFocusChain() or m.sortButton.isInFocusChain() or m.filterButtonRow.isInFocusChain() then m.top.setFocus(true)
    m.state.foregroundLoad.controlsHidden = true
    m.state.foregroundLoad.restoreFilterVisible = m.filterButtonRow.visible
    m.browseByButton.visible = false
    m.sortButton.visible = false
    m.filterButtonRow.visible = false
    updateGridLayout()
end sub

'-------------------------------------------------------------------------------
' showForegroundControls
'-------------------------------------------------------------------------------
sub showForegroundControls()
    restoreFilterVisible = m.state.foregroundLoad.restoreFilterVisible
    m.state.foregroundLoad.controlsHidden = false
    m.state.foregroundLoad.restoreFilterVisible = false
    m.browseByButton.visible = true
    m.sortButton.visible = true
    m.filterButtonRow.visible = restoreFilterVisible
    updateGridLayout()
end sub

'-------------------------------------------------------------------------------
' loadArtistPage
'-------------------------------------------------------------------------------
sub loadArtistPage(startIndex as integer)
    request = m.state.request
    artistRequest = {}
    for each key in request
        artistRequest[key] = request[key]
    end for
    artistRequest.queryId = m.state.artistLoad.queryId
    artistRequest.pageStartIndex = startIndex
    artistRequest.artistSortOrder = Format.SafeString(m.state.selectedSort.sortOrder, "Ascending")
    if startIndex > 0 then showPagingSpinner()
    m.state.artistLoad.requestInFlight = true
    m.musicArtistsTask.control = "stop"
    m.musicArtistsTask.request = artistRequest
    m.musicArtistsTask.control = "run"
end sub

'-------------------------------------------------------------------------------
' showPagingSpinner
'-------------------------------------------------------------------------------
sub showPagingSpinner()
    if m.state.pagingLoad.spinnerVisible then return

    m.state.pagingLoad.spinnerVisible = true
    Spinner.Show(0)
end sub

'-------------------------------------------------------------------------------
' hidePagingSpinner
'-------------------------------------------------------------------------------
sub hidePagingSpinner()
    if m.state.pagingLoad.spinnerVisible <> true then return

    m.state.pagingLoad.spinnerVisible = false
    Spinner.Hide()
end sub

'-------------------------------------------------------------------------------
' requestNextArtistPageIfNeeded
'-------------------------------------------------------------------------------
sub requestNextArtistPageIfNeeded()
    if m.state.artistLoad.hasMore <> true or m.state.artistLoad.requestInFlight = true then return
    if isFocusNearLoadedEnd(m.musicGrid, m.state.artists.Count()) <> true then return

    m.state.artistLoad.status = "loading"
    loadArtistPage(m.state.artistLoad.nextStartIndex)
end sub

'-------------------------------------------------------------------------------
' startForegroundLoad
'-------------------------------------------------------------------------------
sub startForegroundLoad(kind as string)
    startedAt = CreateObject("roTimespan")
    startedAt.Mark()
    m.state.foregroundLoad.kind = kind
    m.state.foregroundLoad.startedAt = startedAt
end sub

'-------------------------------------------------------------------------------
' finishForegroundLoad
'-------------------------------------------------------------------------------
function finishForegroundLoad(kind as string) as boolean
    if m.state.foregroundLoad.kind <> kind then return false

    elapsedMs = 0
    if m.state.foregroundLoad.startedAt <> invalid then elapsedMs = m.state.foregroundLoad.startedAt.TotalMilliseconds()
    m.log.write("Foreground load completed kind=" + kind + " libraryId=" + getLibraryId() + " elapsedMs=" + elapsedMs.ToStr())
    m.state.foregroundLoad.kind = ""
    m.state.foregroundLoad.startedAt = invalid
    showForegroundControls()
    Spinner.Hide()
    return true
end function

'-------------------------------------------------------------------------------
' getLibraryId
'-------------------------------------------------------------------------------
function getLibraryId() as string
    if m.state.request = invalid then return ""
    return Format.SafeString(m.state.request.libraryId, "")
end function

'-------------------------------------------------------------------------------
' onAlbumSelected
'-------------------------------------------------------------------------------
sub onAlbumSelected()
    selected = m.musicGrid.itemSelected
    if selected = invalid or selected < 0 then return
    if m.musicGrid.content = invalid then return
    if selected >= m.musicGrid.content.getChildCount() then return

    albumNode = m.musicGrid.content.getChild(selected)
    if albumNode = invalid then return

    raw = albumNode.raw
    itemId = ""
    if raw <> invalid then itemId = Format.SafeString(Format.FirstNonEmpty([raw.Id], ""), "")
    if itemId = "" then return

    m.top.selectedAlbum = {
        itemId: itemId
        item: raw
    }
end sub

'-------------------------------------------------------------------------------
' onArtistSelected
'-------------------------------------------------------------------------------
sub onArtistSelected()
    selectedIndex = m.musicGrid.itemSelected
    content = m.musicGrid.content
    if content = invalid or selectedIndex < 0 or selectedIndex >= content.getChildCount() then return

    node = content.getChild(selectedIndex)
    raw = node.raw
    if raw = invalid then return

    musicBrainzArtistId = ""
    if raw.ProviderIds <> invalid then musicBrainzArtistId = Format.SafeString(raw.ProviderIds.MusicBrainzArtist, "")
    m.top.selectedArtist = {
        itemId: Format.SafeString(raw.Id, "")
        musicBrainzArtistId: musicBrainzArtistId
        item: raw
        backdropUrl: getArtistImageUrl(raw, m.state.request, "Backdrop", 1920, 1080)
        logoUrl: getArtistImageUrl(raw, m.state.request, "Logo", 600, 300)
    }
end sub

'-------------------------------------------------------------------------------
' isAlbumsGridAtFirstRow
'-------------------------------------------------------------------------------
function isAlbumsGridAtFirstRow() as boolean
    grid = getActiveGrid()
    focusedIndex = grid.itemFocused
    if focusedIndex = invalid then return true

    return focusedIndex < grid.numColumns
end function

'-------------------------------------------------------------------------------
' isFirstAlbumFocused
'-------------------------------------------------------------------------------
function isFirstAlbumFocused() as boolean
    focusedIndex = getActiveGrid().itemFocused
    if focusedIndex = invalid then return true

    return focusedIndex <= 0
end function

'-------------------------------------------------------------------------------
' onKeyEvent
'-------------------------------------------------------------------------------
function onKeyEvent(key as string, press as boolean) as boolean
    if press = false then return false
    if key = "options" and getActiveGrid().isInFocusChain() then return openMediaActions()

    if key = "up" and m.browseByButton.isInFocusChain() then
        m.top.focusExitUp = true
        return true
    end if

    if key = "up" and m.sortButton.isInFocusChain() then
        m.top.focusExitUp = true
        return true
    end if

    if key = "right" and m.browseByButton.isInFocusChain() then
        if focusSortButton() = true then return true
        return true
    end if

    if key = "left" and m.sortButton.isInFocusChain() then return focusBrowseByButton()

    if key = "up" and isAlbumsGridAtFirstRow() then
        if focusFilterButtonRow() = true then return true
        return focusBrowseByButton()
    end if

    if key = "back" then
        if isFirstAlbumFocused() <> true then
            getActiveGrid().jumpToItem = 0
            return true
        end if

        m.top.closeRequested = true
        return true
    end if

    return false
end function

'-------------------------------------------------------------------------------
' openMediaActions
'-------------------------------------------------------------------------------
function openMediaActions() as boolean
    grid = getActiveGrid()
    if grid.content = invalid then return false

    focusedIndex = grid.itemFocused
    if focusedIndex = invalid or focusedIndex < 0 then return false

    focusedNode = grid.content.getChild(focusedIndex)
    if focusedNode = invalid or focusedNode.raw = invalid then return false

    m.top.overlayRequested = {
        id: "mediaActions"
        sourcePage: "musicLibrary"
        componentName: "MediaActionsDialog"
        openFunction: "openMediaActions"
        closeField: "closeRequested"
        item: focusedNode.raw
        server: m.state.request.server
        token: m.state.request.token
        userId: m.state.request.userId
    }
    return true
end function

'-------------------------------------------------------------------------------
' applyMediaStateChange
'-------------------------------------------------------------------------------
sub applyMediaStateChange(change as object)
    applyItemsMediaStateChange(m.state.loadedAlbums, change)
    applyItemsMediaStateChange(m.state.artists, change)
    if isFavoriteBrowseActive() and Format.SafeString(change.action, "") = "favorite" and change.value <> true then
        if m.top.visible = true and m.state.lifecycle.isActive = true then
            reloadMusicLibrary()
        else
            m.state.refreshPending = true
        end if
        return
    end if

    applyGridMediaStateChange(m.musicGrid, change)
end sub

'-------------------------------------------------------------------------------
' filterOptionsContainValue
'-------------------------------------------------------------------------------
function filterOptionsContainValue(options as object, value as string) as boolean
    if options = invalid or value = "" then return false
    for each option in options
        if Format.SafeString(option.value, "") = value then return true
    end for
    return false
end function

'-------------------------------------------------------------------------------
' applySavedMusicLibraryViewState
'-------------------------------------------------------------------------------
sub applySavedMusicLibraryViewState(request as object, state as object)
    optionKey = Format.SafeString(state.optionKey, "")
    sortOrder = getNormalizedMusicSortOrder(Format.SafeString(state.sortOrder, "Ascending"))
    request.favoriteOnly = false
    m.state.activeFilterType = ""
    m.state.selectedDecade = -1
    m.state.selectedGenre = ""

    if optionKey = "Favorites" then
        request.favoriteOnly = true
        m.state.selectedSort = getFavoritesSortSelection()
        m.state.selectedSort.sortOrder = sortOrder
    else if optionKey = "Decade" or optionKey = "Genre" then
        m.state.selectedSort = { optionKey: optionKey, sortKey: "Album", sortOrder: "Ascending", label: optionKey }
        m.state.activeFilterType = optionKey
        m.state.selectedDecade = Number.ToInteger(state.selectedDecade, -1)
        m.state.selectedGenre = Format.SafeString(state.selectedGenre, "")
    else if optionKey = "ArtistAlbum" then
        m.state.selectedSort = { optionKey: "ArtistAlbum", sortKey: "ArtistAlbum", sortOrder: sortOrder, label: "Artist/Album" }
    else if optionKey = "Artist" then
        m.state.selectedSort = { optionKey: "Artist", sortKey: "Artist", sortOrder: sortOrder, label: "Artist" }
    else
        m.state.selectedSort = getDefaultSortSelection()
        m.state.selectedSort.sortOrder = sortOrder
    end if
    m.state.selectedSortKey = Format.SafeString(m.state.selectedSort.optionKey, "Album")
end sub

'-------------------------------------------------------------------------------
' getNormalizedMusicSortOrder
'-------------------------------------------------------------------------------
function getNormalizedMusicSortOrder(sortOrder as string) as string
    if sortOrder = "Descending" then return "Descending"
    return "Ascending"
end function

'-------------------------------------------------------------------------------
' persistMusicLibraryViewState
'-------------------------------------------------------------------------------
sub persistMusicLibraryViewState()
    request = m.state.request
    selection = m.state.selectedSort
    if request = invalid or selection = invalid then return

    LibraryViewStateStore.Save(Format.SafeString(request.accountKey, ""), Format.SafeString(request.libraryId, ""), {
        optionKey: Format.SafeString(m.state.selectedSortKey, "Album")
        sortKey: Format.SafeString(selection.sortKey, "Album")
        sortOrder: Format.SafeString(selection.sortOrder, "Ascending")
        selectedDecade: m.state.selectedDecade
        selectedGenre: m.state.selectedGenre
        libraryTitle: Format.SafeString(request.title, "")
        collectionType: Format.SafeString(request.collectionType, "")
    })
end sub

'-------------------------------------------------------------------------------
' applyItemsMediaStateChange
'-------------------------------------------------------------------------------
sub applyItemsMediaStateChange(items as object, change as object)
    for each item in items
        if Format.SafeString(item.Id, "") = Format.SafeString(change.itemId, "") then
            MediaState.ApplyToItem(item, change)
        end if
    end for
end sub

'-------------------------------------------------------------------------------
' applyGridMediaStateChange
'-------------------------------------------------------------------------------
sub applyGridMediaStateChange(grid as object, change as object)
    if grid.content = invalid then return

    for i = 0 to grid.content.getChildCount() - 1
        itemNode = grid.content.getChild(i)
        item = itemNode.raw
        if item <> invalid and Format.SafeString(item.Id, "") = Format.SafeString(change.itemId, "") then
            updatedItem = cloneMusicLibraryItem(item)
            if MediaState.ApplyToItem(updatedItem, change) <> true then return
            itemNode.raw = updatedItem
            return
        end if
    end for
end sub

'-------------------------------------------------------------------------------
' cloneMusicLibraryItem
'-------------------------------------------------------------------------------
function cloneMusicLibraryItem(item as object) as object
    clone = {}
    for each key in item
        clone[key] = item[key]
    end for

    userData = {}
    if item.UserData <> invalid then
        for each key in item.UserData
            userData[key] = item.UserData[key]
        end for
    end if
    clone.UserData = userData
    return clone
end function
