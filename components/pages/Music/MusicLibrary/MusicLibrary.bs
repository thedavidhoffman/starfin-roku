'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    initReferences()
    initHandlers()
    initState()
    syncSortControls()
end sub


'-------------------------------------------------------------------------------
' initReferences
'-------------------------------------------------------------------------------
sub initReferences()
    m.log = new Logger("MusicLibrary", m.global.logService)
    m.titleLabel = m.top.findNode("titleLabel")
    m.browseByButton = m.top.findNode("browseByButton")
    m.sortButton = m.top.findNode("sortButton")
    m.filterButtonRow = m.top.findNode("filterButtonRow")
    m.emptyFilterLabel = m.top.findNode("emptyFilterLabel")
    m.musicGrid = m.top.findNode("musicGrid")
    m.musicLibraryTask = m.top.findNode("musicLibraryTask")
    m.musicArtistsTask = m.top.findNode("musicArtistsTask")
    m.musicFilterOptionsTask = m.top.findNode("musicFilterOptionsTask")
end sub


'-------------------------------------------------------------------------------
' initHandlers
'-------------------------------------------------------------------------------
sub initHandlers()
    m.musicLibraryTask.observeField("response", "onMusicLibraryResponse")
    m.musicArtistsTask.observeField("response", "onMusicArtistsResponse")
    m.musicFilterOptionsTask.observeField("response", "onMusicFilterOptionsResponse")
    m.browseByButton.observeField("overlayRequested", "onSortOverlayRequested")
    m.browseByButton.observeField("focusExitDown", "onBrowseByButtonFocusExitDown")
    m.sortButton.observeField("sortOrderChanged", "onSortOrderChanged")
    m.sortButton.observeField("focusExitDown", "onSortButtonFocusExitDown")
    m.filterButtonRow.observeField("filterSelected", "onFilterButtonRowSelected")
    m.filterButtonRow.observeField("focusExitUp", "onFilterButtonRowFocusExitUp")
    m.filterButtonRow.observeField("focusExitDown", "onFilterButtonRowFocusExitDown")
    m.musicGrid.observeField("itemSelected", "onMusicItemSelected")
    m.musicGrid.observeField("itemFocused", "onMusicGridItemFocused")
end sub


'-------------------------------------------------------------------------------
' initState
'-------------------------------------------------------------------------------
sub initState()
    m.state = {
        context: invalid
        browse: {
            selection: getDefaultSortSelection()
            filterType: ""
            decade: -1
            genre: ""
        }
        content: {
            albums: {
                items: []
                load: createPageLoadState()
            }
            artists: {
                items: []
                load: createPageLoadState()
            }
        }
        filters: {
            options: createEmptyFilterCache()
            load: createLoadState()
        }
        refreshPending: false
        loadingUi: {
            foreground: {
                kind: ""
                pausedKind: ""
                startedAt: invalid
                controlsHidden: false
                restoreFilterVisible: false
            }
            pagingSpinnerVisible: false
        }
        lifecycle: AsyncLifecycle.Create()
    }
end sub

'-------------------------------------------------------------------------------
' createLoadState
'-------------------------------------------------------------------------------
function createLoadState() as object
    return {
        status: "idle"
        requestInFlight: false
        queryId: 0
    }
end function

'-------------------------------------------------------------------------------
' createPageLoadState
'-------------------------------------------------------------------------------
function createPageLoadState() as object
    state = createLoadState()
    state.nextStartIndex = 0
    state.totalCount = -1
    state.hasMore = false
    return state
end function


'-------------------------------------------------------------------------------
' onLoadRequestChanged
'-------------------------------------------------------------------------------
sub onLoadRequestChanged()
    request = m.top.loadRequest
    if request = invalid then return

    m.state.context = request
    m.state.content.albums.items = []
    m.state.content.artists.items = []
    m.state.content.albums.load.status = "loading"
    m.state.content.albums.load.requestInFlight = false
    m.state.content.albums.load.nextStartIndex = 0
    m.state.content.albums.load.totalCount = -1
    m.state.content.albums.load.hasMore = false
    m.state.content.albums.load.queryId = m.state.content.albums.load.queryId + 1
    m.state.content.artists.load.status = "idle"
    m.state.content.artists.load.requestInFlight = false
    m.state.content.artists.load.nextStartIndex = 0
    m.state.content.artists.load.totalCount = -1
    m.state.content.artists.load.hasMore = false
    m.state.content.artists.load.queryId = m.state.content.artists.load.queryId + 1
    m.state.filters.load.status = "loading"
    m.state.filters.load.requestInFlight = false
    m.state.filters.load.queryId = m.state.filters.load.queryId + 1
    savedState = LibraryViewStateStore.Load(Format.SafeString(request.accountKey, ""), Format.SafeString(request.libraryId, ""))
    if savedState <> invalid then
        applySavedMusicLibraryViewState(savedState)
    else if request.favoriteOnly = true then
        m.state.browse.selection = getFavoritesSortSelection()
        m.state.browse.filterType = ""
        m.state.browse.decade = -1
        m.state.browse.genre = ""
    else
        m.state.browse.selection = getDefaultSortSelection()
        m.state.browse.filterType = ""
        m.state.browse.decade = -1
        m.state.browse.genre = ""
    end if
    m.state.filters.options = createEmptyFilterCache()
    syncSortControls()
    hideFilterButtonRow()
    AsyncLifecycle.Begin(m.state.lifecycle, request.libraryId)
    updateTitleLabel()
    renderAlbums([])
    if isArtistBrowseMode() then
        startArtistQuery()
    else
        m.log.write("Album load started libraryId=" + Format.SafeString(request.libraryId, ""))
        queueForegroundLoad("albums")
    end if
    loadFilterOptions()
end sub


'-------------------------------------------------------------------------------
' activate
'-------------------------------------------------------------------------------
sub activate()
    AsyncLifecycle.BeginFromField(m.state.lifecycle, m.state.context, "libraryId")
    if m.state.refreshPending then
        m.state.refreshPending = false
        reloadMusicLibrary()
        focusAlbums()
        return
    end if
    if m.state.loadingUi.foreground.kind <> "" then
        focusAlbums()
        return
    end if
    if m.state.filters.load.status = "paused" then
        m.state.filters.load.status = "loading"
        loadFilterOptions()
    end if
    if m.state.loadingUi.foreground.pausedKind <> "" then
        kind = m.state.loadingUi.foreground.pausedKind
        m.state.loadingUi.foreground.pausedKind = ""
        if kind = "artists" then
            m.state.content.artists.load.status = "loading"
        else
            m.state.content.albums.load.status = "loading"
        end if
        queueForegroundLoad(kind)
        focusAlbums()
        return
    end if

    if isArtistBrowseMode() then
        if m.state.content.artists.load.status = "paused" then
            m.state.content.artists.load.status = "loading"
            loadArtistPage(m.state.content.artists.load.nextStartIndex)
        end if
    else if m.state.content.albums.load.status = "paused" then
        m.state.content.albums.load.status = "loading"
        m.log.write("Album paging resumed libraryId=" + getLibraryId() + " startIndex=" + m.state.content.albums.load.nextStartIndex.ToStr())
        loadAlbumPage(m.state.content.albums.load.nextStartIndex)
    end if
    focusAlbums()
end sub


'-------------------------------------------------------------------------------
' deactivate
'-------------------------------------------------------------------------------
sub deactivate()
    wasLoading = m.state.loadingUi.foreground.kind <> ""
    m.state.loadingUi.foreground.pausedKind = m.state.loadingUi.foreground.kind
    hidePagingSpinner()
    m.state.loadingUi.foreground.kind = ""
    m.state.loadingUi.foreground.startedAt = invalid
    if m.state.content.albums.load.requestInFlight then m.state.content.albums.load.status = "paused"
    m.state.content.albums.load.requestInFlight = false
    m.state.content.albums.load.queryId = m.state.content.albums.load.queryId + 1
    if m.state.content.artists.load.requestInFlight then m.state.content.artists.load.status = "paused"
    m.state.content.artists.load.requestInFlight = false
    if m.state.filters.load.requestInFlight then m.state.filters.load.status = "paused"
    m.state.filters.load.requestInFlight = false
    m.state.content.artists.load.queryId = m.state.content.artists.load.queryId + 1
    m.state.filters.load.queryId = m.state.filters.load.queryId + 1
    AsyncLifecycle.Deactivate(m.state.lifecycle)
    m.musicLibraryTask.control = "stop"
    m.musicArtistsTask.control = "stop"
    m.musicFilterOptionsTask.control = "stop"
    if wasLoading then
        showForegroundControls()
        Spinner.Hide()
    end if
end sub


'-------------------------------------------------------------------------------
' onKeyEvent
'-------------------------------------------------------------------------------
function onKeyEvent(key as string, press as boolean) as boolean
    if press = false then return false
    if key = "options" and getActiveGrid().isInFocusChain() then return openMediaActions()

    if key = "up" and m.browseByButton.isInFocusChain() then
        m.top.focusExitUp = true
        return true
    end if

    if key = "up" and m.sortButton.isInFocusChain() then
        m.top.focusExitUp = true
        return true
    end if

    if key = "right" and m.browseByButton.isInFocusChain() then
        if focusSortButton() = true then return true
        return true
    end if

    if key = "left" and m.sortButton.isInFocusChain() then return focusBrowseByButton()

    if key = "up" and isAlbumsGridAtFirstRow() then
        if focusFilterButtonRow() = true then return true
        return focusBrowseByButton()
    end if

    if key = "back" then
        if isFirstAlbumFocused() <> true then
            getActiveGrid().jumpToItem = 0
            return true
        end if

        m.top.closeRequested = true
        return true
    end if

    return false
end function
