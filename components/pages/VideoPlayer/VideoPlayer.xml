<?xml version="1.0" encoding="utf-8"?>
<component name="VideoPlayer" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/source/Format.brs" />
  <script type="text/brightscript" uri="pkg:/source/String.brs" />
  <script type="text/brightscript" uri="pkg:/source/Logger.brs" />
  <script type="text/brightscript" uri="pkg:/source/api/JellyfinAuth.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/VideoPlayer/VideoPlayer.brs" />
  <interface>
    <field id="playRequest" type="assocarray" onChange="onPlayRequestChanged" />
    <field id="closeRequested" type="boolean" alwaysNotify="true" />
  </interface>
  <children>
    <Rectangle width="1920" height="1080" color="0x000000FF" />
    <Video id="videoPlayer" width="1920" height="1080" />
    <Label id="statusLabel" translation="[96,96]" width="1500" height="48" color="0xF3F7FBFF" text="Loading video..." />
    <PlaybackInfoTask id="playbackInfoTask" />
  </children>
</component>
