<?xml version="1.0" encoding="utf-8"?>
<component name="PlaybackControls" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/source/Format.brs" />
  <script type="text/brightscript" uri="pkg:/source/String.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/VideoPlayer/PlaybackControls/PlaybackControls.brs" />
  <interface>
    <field id="title" type="string" onChange="onTitleChanged" />
    <field id="position" type="float" onChange="onProgressChanged" />
    <field id="duration" type="float" onChange="onProgressChanged" />
    <field id="previewPosition" type="float" onChange="onPreviewChanged" />
    <field id="isSeeking" type="boolean" onChange="onSeekingChanged" />
    <field id="isPlaying" type="boolean" onChange="onPlayingChanged" />
    <field id="thumbnailData" type="assocarray" onChange="onThumbnailDataChanged" />
    <field id="previousPressed" type="boolean" alwaysNotify="true" />
    <field id="playPausePressed" type="boolean" alwaysNotify="true" />
    <field id="nextPressed" type="boolean" alwaysNotify="true" />
    <field id="progressLeftPressed" type="boolean" alwaysNotify="true" />
    <field id="progressRightPressed" type="boolean" alwaysNotify="true" />
    <field id="progressLeftReleased" type="boolean" alwaysNotify="true" />
    <field id="progressRightReleased" type="boolean" alwaysNotify="true" />
    <field id="progressRewindPressed" type="boolean" alwaysNotify="true" />
    <field id="progressFastForwardPressed" type="boolean" alwaysNotify="true" />
    <field id="progressSeekCommit" type="boolean" alwaysNotify="true" />
    <field id="progressSeekCancel" type="boolean" alwaysNotify="true" />
    <function name="focusProgress" />
    <function name="focusButtons" />
    <function name="releaseFocus" />
  </interface>
  <children>
    <Poster uri="pkg:/images/overlays/bottom-content-gradient.png" translation="[0,490]" width="1920" height="740" loadDisplayMode="scaleToFit" />
    <Label id="titleLabel" translation="[103,772]" width="1400" height="48" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
    <Label id="playbackStateLabel" translation="[103,836]" width="180" height="36" font="font:SmallBoldSystemFont" color="0xFFFFFFFF" />

    <Group id="buttonGroup" translation="[733,969]">
      <HeaderButton id="previousButton" translation="[0,0]" buttonWidth="140" buttonHeight="64" text="Previous" />
      <HeaderButton id="playPauseButton" translation="[156,0]" buttonWidth="140" buttonHeight="64" text="Pause" />
      <HeaderButton id="nextButton" translation="[312,0]" buttonWidth="140" buttonHeight="64" text="Next" />
    </Group>

    <TrickplayPreviewStrip id="trickplayPreview" />

    <Group id="progressBarGroup" translation="[103,915]" focusable="true">
      <Rectangle id="progressFocusRect" translation="[-8,-10]" width="1730" height="32" color="0xFFFFFFFF" opacity="0.18" visible="false" />
      <Rectangle id="progressBarBackground" width="1714" height="12" color="0xFFFFFFFF" opacity="0.32" />
      <Rectangle id="progressBar" width="0" height="12" color="0xFFFFFFFF" opacity="0.92" />
      <Rectangle id="previewBar" width="0" height="12" color="0xFFFFFFFF" opacity="0.45" visible="false" />
      <Rectangle id="scrubber" translation="[-10,-7]" width="20" height="26" color="0xFFFFFFFF" />
    </Group>

    <Label id="positionLabel" translation="[103,945]" width="220" height="36" font="font:MediumSystemFont" color="0xFFFFFFFF" />
    <Label id="remainingLabel" translation="[1597,945]" width="220" height="36" font="font:MediumSystemFont" color="0xFFFFFFFF" horizAlign="right" />
  </children>
</component>
