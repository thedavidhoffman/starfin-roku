<?xml version="1.0" encoding="utf-8"?>
<component name="PlaybackIconButton" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/components/pages/VideoPlayer/PlaybackControls/PlaybackIconButton/PlaybackIconButton.brs" />
  <interface>
    <field id="icon" type="string" onChange="updateIcon" />
    <field id="focusedIcon" type="string" onChange="updateIcon" />
    <field id="hasFocusVisual" type="boolean" onChange="updateIcon" />
    <field id="buttonSelected" type="boolean" alwaysNotify="true" />
  </interface>
  <children>
    <Poster id="iconPoster" width="100" height="100" loadDisplayMode="scaleToFit" />
  </children>
</component>
