<?xml version="1.0" encoding="utf-8"?>
<component name="Header" extends="Group">
  <script type="text/brightscript" uri="pkg:/source/Format.brs" />
  <script type="text/brightscript" uri="pkg:/source/Logger.brs" />
  <script type="text/brightscript" uri="pkg:/source/String.brs" />
  <script type="text/brightscript" uri="pkg:/source/Encode.brs" />
  <script type="text/brightscript" uri="pkg:/source/Color.brs" />
  <script type="text/brightscript" uri="pkg:/source/Url.brs" />
  <script type="text/brightscript" uri="pkg:/source/ButtonAssets.brs" />
  <script type="text/brightscript" uri="pkg:/source/MaskAssets.brs" />
  <script type="text/brightscript" uri="pkg:/source/AccountImage.brs" />
  <script type="text/brightscript" uri="pkg:/source/PlaybackMode.brs" />
  <script type="text/brightscript" uri="pkg:/source/store/SettingsStore.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/Header/Header.brs" />
  <interface>
    <field id="menuOpen" type="boolean" />
    <field id="closeMenuRequested" type="boolean" alwaysNotify="true" onChange="onCloseMenuRequested" />
    <field id="username" type="string" onChange="onUsernameChanged" />
    <field id="userIdentityRequest" type="assocarray" onChange="onUserIdentityRequestChanged" />
    <field id="settings" type="assocarray" onChange="onSettingsChanged" />
    <field id="homeSelected" type="boolean" alwaysNotify="true" />
    <field id="searchSelected" type="boolean" alwaysNotify="true" />
    <field id="downSelected" type="boolean" alwaysNotify="true" />
    <field id="backSelected" type="boolean" alwaysNotify="true" />
    <field id="yourStatsSelected" type="boolean" alwaysNotify="true" />
    <field id="logoutSelected" type="boolean" alwaysNotify="true" />
    <field id="switchAccountSelected" type="boolean" alwaysNotify="true" />
    <field id="overlayRequested" type="assocarray" alwaysNotify="true" />
    <field id="thumbnailLibraryLayout" type="boolean" value="false" onChange="onThumbnailLibraryLayoutChanged" />
    <function name="focusHeader" />
    <function name="focusUserMenuButton" />
    <function name="isHomeButtonFocused" />
  </interface>
  <children>
    <Group id="accountBadge" translation="[48,16]" visible="false">
      <Poster
        id="accountBadgeRing"
        translation="[-3,-3]"
        width="102"
        height="102"
        uri="pkg:/images/header/account-badge-ring-102x102.png" />
      <Poster
        id="accountBadgeGlass"
        translation="[-3,-3]"
        width="102"
        height="102"
        opacity="1.0"
        uri="pkg:/images/header/account-badge-glass-102x102.png" />
      <MaskGroup id="accountBadgeImageMask" maskSize="[96,96]">
        <Poster id="accountBadgeImage" width="96" height="96" loadWidth="96" loadHeight="96" loadDisplayMode="scaleToZoom" />
      </MaskGroup>
      <Label id="accountBadgeName" translation="[122,24]" width="422" height="48" vertAlign="center" color="0xF6F7FBFF" font="font:MediumBoldSystemFont" />
    </Group>
    <Group id="navGroup" translation="[617,34]">
      <Poster
        id="navGlassBackground"
        translation="[-18,-10]"
        width="722"
        height="76"
        uri="pkg:/images/buttons/header-glass-background.9.png"
        loadDisplayMode="scaleToFill" />
      <HeaderButton id="homeButton" translation="[0,0]" buttonWidth="150" buttonHeight="56" text="Home" />
      <HeaderButton id="searchButton" translation="[162,0]" buttonWidth="160" buttonHeight="56" text="Search" />
      <HeaderButton id="settingsButton" translation="[334,0]" buttonWidth="180" buttonHeight="56" text="Settings" />
      <HeaderButton id="userMenuButton" translation="[526,0]" buttonWidth="160" buttonHeight="56" text="Account" />
    </Group>

    <Clock id="clock" translation="[1680,44]" clockWidth="176" clockHeight="40" color="0xF6F7FBFF" />

    <HeaderDropdownMenu id="accountDropdownMenu" visible="false" translation="[1143,110]" menuWidth="260" itemWidth="220" />
  </children>
</component>
