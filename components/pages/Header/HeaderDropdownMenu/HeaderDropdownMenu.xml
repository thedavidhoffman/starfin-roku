<?xml version="1.0" encoding="utf-8"?>
<component name="HeaderDropdownMenu" extends="Group">
  <script type="text/brightscript" uri="pkg:/source/Format.bs" />
  <script type="text/brightscript" uri="pkg:/source/Logger.bs" />
  <script type="text/brightscript" uri="pkg:/source/String.bs" />
  <script type="text/brightscript" uri="pkg:/source/Theme.bs" />
  <script type="text/brightscript" uri="pkg:/source/Number.bs" />
  <script type="text/brightscript" uri="pkg:/source/ResolutionProfile.bs" />
  <script type="text/brightscript" uri="pkg:/source/ResolutionAssets.bs" />
  <script type="text/brightscript" uri="pkg:/components/pages/Header/HeaderDropdownMenu/HeaderDropdownMenu.bs" />
  <interface>
    <field id="items" type="array" onChange="onItemsChanged" />
    <field id="identity" type="assocarray" onChange="onIdentityChanged" />
    <field id="menuWidth" type="float" value="260" onChange="onDimensionsChanged" />
    <field id="itemWidth" type="float" value="220" onChange="onDimensionsChanged" />
    <field id="itemHeight" type="float" value="56" onChange="onDimensionsChanged" />
    <field id="itemSpacing" type="float" value="10" onChange="onDimensionsChanged" />
    <field id="textInset" type="float" value="18" onChange="onDimensionsChanged" />
