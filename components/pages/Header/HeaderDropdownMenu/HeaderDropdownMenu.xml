    <function name="closeMenu" />
    <function name="toggleMenu" />
    <function name="focusFirstItem" />
    <function name="focusItemById" />
    <function name="focusByOffset" />
    <function name="isMenuFocused" />
  </interface>
  <children>
    <Poster
      id="backgroundColor"
      uri="pkg:/images/buttons/header-glass-background-fill.9.png"
      loadDisplayMode="scaleToFill" />
    <Poster
      id="backgroundGlass"
      uri="pkg:/images/buttons/header-glass-background.9.png"
      loadDisplayMode="scaleToFill" />
    <Group id="identityGroup" translation="[20,16]" visible="false">
      <MaskGroup id="identityImageMask" translation="[38,0]">
        <Poster id="identityImage" loadDisplayMode="scaleToZoom" />
      </MaskGroup>
      <Label id="identityName" translation="[0,156]" width="220" height="28" horizAlign="center" font="font:SmallerSystemFont" numLines="1" />
      <Rectangle translation="[0,195]" width="220" height="1" color="0xF3F7FB33" />
    </Group>
    <Group id="itemsGroup" translation="[20,18]" />
  </children>
</component>
