'-------------------------------------------------------------------------------
' getHomeMediaMetadata
'-------------------------------------------------------------------------------
function getHomeMediaMetadata(item as object) as string
    itemType = LCase(Format.SafeString(item.Type, ""))
    if itemType = "photo" then
        captureDate = Format.FirstNonEmpty([item.PremiereDate, item.DateCreated], "")
        dateText = DateTime.ToShortDate(captureDate)
        timeText = DateTime.ToLocalShortTime(captureDate)
        if dateText = "" or timeText = "" then return dateText
        return dateText + MediaMetadata.BulletSeparator() + timeText
    end if

    if itemType = "folder" or itemType = "photoalbum" then
        if item.ChildCount = invalid then return ""
        childCount = Number.ToInteger(item.ChildCount, 0)
        if childCount = 1 then return "1 item"
        return childCount.ToStr() + " items"
    end if

    if itemType = "video" then return Format.SafeString(item.ProductionYear, "")
    return ""
end function
