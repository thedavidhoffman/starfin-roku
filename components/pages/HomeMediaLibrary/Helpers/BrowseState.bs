'-------------------------------------------------------------------------------
' createLevel
'-------------------------------------------------------------------------------
function createLevel(folderId as string, title as string, selection as object) as object
    return {
        folderId: folderId
        title: title
        focusedIndex: 0
        items: []
        nextStartIndex: 0
        totalCount: -1
        hasMore: false
        requestInFlight: false
        loadCompleted: false
        selection: selection
        isFavorites: false
    }
end function

'-------------------------------------------------------------------------------
' createFavoritesLevel
'-------------------------------------------------------------------------------
function createFavoritesLevel(libraryId as string, selection as object) as object
    level = createLevel(libraryId, "Favorites", selection)
    level.isFavorites = true
    return level
end function

'-------------------------------------------------------------------------------
' getCurrentLevel
'-------------------------------------------------------------------------------
function getCurrentLevel() as dynamic
    if m.state.stack.Count() = 0 then return invalid
    return m.state.stack[m.state.stack.Count() - 1]
end function

'-------------------------------------------------------------------------------
' loadRootBrowseSelection
'-------------------------------------------------------------------------------
function loadRootBrowseSelection(request as object) as object
    selection = LibraryBrowse.CreateSortSelection(LibraryBrowse.Option.Title, LibraryBrowse.SortKey.Title, "Title")
    accountKey = Format.SafeString(request.accountKey, "")
    saved = LibraryViewStateStore.Load(accountKey, Format.SafeString(request.libraryId, ""))
    if saved = invalid then return selection

    optionKey = Format.SafeString(saved.optionKey, LibraryBrowse.Option.Title)
    if optionKey <> LibraryBrowse.Option.Title and optionKey <> LibraryBrowse.Option.DateAdded and optionKey <> "IsFolder" then optionKey = LibraryBrowse.Option.Title
    label = "Title"
    if optionKey = LibraryBrowse.Option.DateAdded then label = "Date Added"
    if optionKey = "IsFolder" then label = "Folders First"
    return LibraryBrowse.CreateSortSelection(optionKey, optionKey, label, LibraryBrowse.NormalizeSortOrder(saved.sortOrder))
end function

'-------------------------------------------------------------------------------
' getBrowseOptions
'-------------------------------------------------------------------------------
function getBrowseOptions() as object
    return [
        LibraryBrowse.CreateSortSelection(LibraryBrowse.Option.Title, LibraryBrowse.SortKey.Title, "Title")
        LibraryBrowse.CreateSortSelection(LibraryBrowse.Option.DateAdded, LibraryBrowse.SortKey.DateAdded, "Date Added")
        LibraryBrowse.CreateSortSelection("IsFolder", "IsFolder,SortName", "Folders First")
        LibraryBrowse.CreateSortSelection(LibraryBrowse.Option.Favorites, LibraryBrowse.SortKey.Title, "Favorites")
    ]
end function

'-------------------------------------------------------------------------------
' persistRootBrowseSelection
'-------------------------------------------------------------------------------
sub persistRootBrowseSelection()
    if m.state.stack.Count() <> 1 then return
    request = m.state.request
    level = getCurrentLevel()
    LibraryViewStateStore.Save(Format.SafeString(request.accountKey, ""), Format.SafeString(request.libraryId, ""), {
        optionKey: level.selection.optionKey
        sortKey: level.selection.sortKey
        sortOrder: level.selection.sortOrder
        selectedDecade: -1
        selectedGenre: ""
        libraryTitle: Format.SafeString(request.title, "")
        collectionType: "homevideos"
    })
end sub
