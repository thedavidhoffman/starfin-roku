<?xml version="1.0" encoding="utf-8"?>
<component name="PhotoViewer" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/components/pages/PhotoViewer/PhotoViewer.bs" />
  <interface>
    <field id="loadRequest" type="assocarray" onChange="onLoadRequestChanged" />
    <field id="closeRequested" type="boolean" alwaysNotify="true" />
    <function name="activate" />
    <function name="deactivate" />
  </interface>
  <children>
    <Rectangle width="1920" height="1080" color="0x000000FF" />
    <Poster id="photoSlot0" width="1920" height="1080" loadWidth="1920" loadHeight="1080" loadDisplayMode="scaleToFit" visible="false" />
    <Poster id="photoSlot1" width="1920" height="1080" loadWidth="1920" loadHeight="1080" loadDisplayMode="scaleToFit" visible="false" />
    <Poster id="photoSlot2" width="1920" height="1080" loadWidth="1920" loadHeight="1080" loadDisplayMode="scaleToFit" visible="false" />
    <Poster id="leftChevron" translation="[24,516]" width="48" height="48" uri="pkg:/images/icons/chevrons/left.png" visible="false" />
    <Poster id="rightChevron" translation="[1848,516]" width="48" height="48" uri="pkg:/images/icons/chevrons/right.png" visible="false" />
    <Rectangle id="statusBackground" translation="[660,24]" width="600" height="76" color="0x101010EE" visible="false">
      <Label id="statusLabel" width="600" height="76" horizAlign="center" vertAlign="center" font="font:MediumSystemFont" />
    </Rectangle>
    <Timer id="slideshowTimer" duration="5" repeat="false" />
    <Timer id="statusTimer" duration="2" repeat="false" />
    <Video id="screenSaverControl" visible="false" />
  </children>
</component>
