<?xml version="1.0" encoding="utf-8"?>
<component name="LiveTV" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/source/Format.brs" />
  <script type="text/brightscript" uri="pkg:/source/String.brs" />
  <script type="text/brightscript" uri="pkg:/source/Encode.brs" />
  <script type="text/brightscript" uri="pkg:/source/Url.brs" />
  <script type="text/brightscript" uri="pkg:/source/Logger.brs" />
  <script type="text/brightscript" uri="pkg:/source/DateTime.brs" />
  <script type="text/brightscript" uri="pkg:/source/Status.brs" />
  <script type="text/brightscript" uri="pkg:/source/Spinner.brs" />
  <script type="text/brightscript" uri="pkg:/source/AsyncLifecycle.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/LiveTV/LiveTV.brs" />
  <interface>
    <field id="loadRequest" type="assocarray" onChange="onLoadRequestChanged" />
    <field id="closeRequested" type="boolean" alwaysNotify="true" />
    <field id="playSelected" type="assocarray" alwaysNotify="true" />
    <function name="activate" />
    <function name="deactivate" />
  </interface>
  <children>
    <Rectangle id="previewBg" translation="[0,96]" width="1920" height="474" color="0x07111DCC" />
    <LabelHeading id="titleLabel" translation="[96,120]" width="520" horizAlign="left" text="Live TV" />

    <Group id="previewGroup" translation="[96,190]" visible="false">
      <LayoutGroup id="previewTextGroup" layoutDirection="vert" itemSpacings="[12,18,20,24]">
        <Label id="programTitle" width="1160" height="56" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
        <LayoutGroup id="programMetaGroup" layoutDirection="horiz" itemSpacings="[26]">
          <Label id="programTime" height="34" font="font:SmallSystemFont" color="0xC8D4E6FF" />
          <Label id="programDuration" height="34" font="font:SmallSystemFont" color="0xC8D4E6FF" />
          <Label id="programChannel" height="34" font="font:SmallSystemFont" color="0xC8D4E6FF" />
        </LayoutGroup>
        <Label id="programEpisode" width="1160" height="34" font="font:SmallSystemFont" color="0xDCE7F5FF" />
        <Label id="programOverview" width="1160" height="130" wrap="true" maxLines="4" font="font:SmallSystemFont" color="0xB5C2D4FF" />
      </LayoutGroup>
      <Poster id="programImage" translation="[1230,-28]" width="500" height="375" loadDisplayMode="scaleToFit" />
    </Group>

    <Group id="emptyPreviewGroup" translation="[96,290]">
      <Label id="emptyPreviewTitle" width="1100" height="56" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" text="Select a channel" />
      <Label id="emptyPreviewMessage" translation="[0,70]" width="1100" height="42" font="font:SmallSystemFont" color="0xB5C2D4FF" text="No schedule information" />
    </Group>

    <TimeGrid
      id="guideGrid"
      translation="[0,612]"
      channelInfoWidth="360"
      numRows="6"
      visible="false"
      automaticLoadingDataFeedback="false"
      showLoadingDataFeedback="false"
      showPastTimeScreen="true" />

    <LiveTvChannelsTask id="channelsTask" />
    <Timer id="scheduleBatchTimer" duration="0.05" repeat="false" />
  </children>
</component>
