import "pkg:/source/String.bs"
import "pkg:/source/Format.bs"

'-------------------------------------------------------------------------------
' openBrowse
'-------------------------------------------------------------------------------
sub openBrowse()
    m.selectionHandled = false
    configureDialog()
    syncContent()
    m.top.callFunc("openDialog")
    focusOptions()
end sub

'-------------------------------------------------------------------------------
' configureDialog
'-------------------------------------------------------------------------------
sub configureDialog()
    m.top.title = "Browse By"
    m.top.dialogWidth = 520
    m.top.closeOnContentSelected = false
    optionCount = 7
    if m.top.sortOptions <> invalid then optionCount = m.top.sortOptions.Count()
    if optionCount < 1 then optionCount = 1
    if optionCount > 7 then optionCount = 7
    m.top.dialogHeight = 178 + (optionCount * 52)
    m.top.contentComponentName = "BrowseByContent"
end sub

'-------------------------------------------------------------------------------
' syncContent
'-------------------------------------------------------------------------------
sub syncContent()
    content = getBrowseByContent()
    if content = invalid then return

    content.selectedSortKey = m.top.selectedSortKey
    sortOptions = m.top.sortOptions
    if sortOptions = invalid then sortOptions = []
    content.sortOptions = sortOptions
    if m.browseByContent <> invalid then m.browseByContent.unobserveField("sortSelected")
    m.browseByContent = content
    m.browseByContent.observeField("sortSelected", "onContentSortSelected")
end sub

'-------------------------------------------------------------------------------
' getBrowseByContent
'-------------------------------------------------------------------------------
function getBrowseByContent() as dynamic
    return m.top.callFunc("getContentComponent")
end function

'-------------------------------------------------------------------------------
' focusOptions
'-------------------------------------------------------------------------------
sub focusOptions()
    content = getBrowseByContent()
    if content <> invalid then content.callFunc("focusOptions")
end sub

'-------------------------------------------------------------------------------
' onSelectedSortKeyChanged
'-------------------------------------------------------------------------------
sub onSelectedSortKeyChanged()
    content = getBrowseByContent()
    if content <> invalid then content.selectedSortKey = m.top.selectedSortKey
end sub

'-------------------------------------------------------------------------------
' onContentSortSelected
'-------------------------------------------------------------------------------
sub onContentSortSelected()
    if m.selectionHandled = true then return
    if m.browseByContent = invalid then return

    selection = m.browseByContent.sortSelected
    if selection = invalid then return

    m.selectionHandled = true

    m.top.selectedSortKey = Format.SafeString(selection.optionKey, m.top.selectedSortKey)
    m.top.sortSelected = selection
    m.top.callFunc("closeDialog")
end sub
