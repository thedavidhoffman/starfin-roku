<?xml version="1.0" encoding="utf-8"?>
<component name="SortButton" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/source/Format.bs" />
  <script type="text/brightscript" uri="pkg:/source/String.bs" />
  <script type="text/brightscript" uri="pkg:/source/ResolutionProfile.bs" />
  <script type="text/brightscript" uri="pkg:/source/ResolutionAssets.bs" />
  <script type="text/brightscript" uri="pkg:/components/pages/Library/BrowseOptions/SortButton/SortButton.bs" />
  <interface>
    <field id="selectedSort" type="assocarray" onChange="onSelectedSortChanged" />
    <field id="sortEnabled" type="boolean" value="true" onChange="onSortEnabledChanged" />
    <field id="sortOrderChanged" type="assocarray" alwaysNotify="true" />
    <field id="focusExitDown" type="boolean" alwaysNotify="true" />
  </interface>
  <children>
    <Poster id="background" width="48" height="48" loadDisplayMode="scaleToFill" />
    <Poster id="sortOrderIcon" translation="[10,10]" width="28" height="28" loadDisplayMode="scaleToFit" />
  </children>
</component>
