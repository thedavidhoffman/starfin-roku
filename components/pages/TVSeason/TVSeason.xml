<?xml version="1.0" encoding="utf-8"?>
<component name="TVSeason" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/source/Format.brs" />
  <script type="text/brightscript" uri="pkg:/source/String.brs" />
  <script type="text/brightscript" uri="pkg:/source/Logger.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/TVSeason/TVSeason.brs" />
  <interface>
    <field id="loadRequest" type="assocarray" onChange="onLoadRequestChanged" />
    <field id="closeRequested" type="boolean" alwaysNotify="true" />
    <function name="activate" />
  </interface>
  <children>
    <Poster id="backdrop" width="1920" height="1080" opacity="0.30" loadDisplayMode="scaleToZoom" />
    <Rectangle width="1920" height="1080" color="0x00000055" />

    <Group id="contentGroup" translation="[96,104]">
      <Poster id="poster" width="240" height="360" loadDisplayMode="scaleToZoom" />

      <Group id="infoGroup" translation="[300,0]">
        <Label id="seriesLabel" width="1260" height="34" color="0xB9C7D6FF" font="font:MediumSystemFont" />
        <Label id="titleLabel" translation="[0,44]" width="1260" height="66" color="0xF3F7FBFF" font="font:LargeBoldSystemFont" />
        <Label id="metaLabel" translation="[0,122]" width="1260" height="34" color="0xB9C7D6FF" font="font:MediumSystemFont" />
        <Label id="overviewLabel" translation="[0,178]" width="1120" height="160" color="0xF3F7FBFF" font="font:MediumSystemFont" wrap="true" numLines="4" />
      </Group>

      <Label id="episodesLabel" translation="[0,420]" width="600" height="44" color="0xF3F7FBFF" font="font:MediumBoldSystemFont" text="Episodes" />
      <MarkupList
        id="episodesList"
        translation="[0,480]"
        itemComponentName="TVEpisodeItem"
        itemSize="[1540,178]"
        itemSpacing="[0,22]"
        numRows="3"
        drawFocusFeedback="true" />

      <Label id="statusLabel" translation="[0,480]" width="1000" height="44" color="0xF3F7FBFF" text="Loading season..." />
    </Group>

    <TVSeasonTask id="tvSeasonTask" />
  </children>
</component>
