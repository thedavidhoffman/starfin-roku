<?xml version="1.0" encoding="utf-8"?>
<component name="TVSeason" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/source/Format.brs" />
  <script type="text/brightscript" uri="pkg:/source/String.brs" />
  <script type="text/brightscript" uri="pkg:/source/Logger.brs" />
  <script type="text/brightscript" uri="pkg:/source/Status.brs" />
  <script type="text/brightscript" uri="pkg:/source/PlaybackProgress.brs" />
  <script type="text/brightscript" uri="pkg:/source/store/SettingsStore.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/TVSeason/TVSeason.brs" />
  <interface>
    <field id="loadRequest" type="assocarray" onChange="onLoadRequestChanged" />
    <field id="settings" type="assocarray" onChange="onSettingsChanged" />
    <field id="closeRequested" type="boolean" alwaysNotify="true" />
    <field id="selectedEpisodeDetails" type="assocarray" alwaysNotify="true" />
    <field id="watchedStateChange" type="assocarray" onChange="onWatchedStateChange" />
    <field id="seasonWatchedStateChanged" type="assocarray" alwaysNotify="true" />
    <function name="activate" />
  </interface>
  <children>

    <TVLogoBanner id="logoBanner" />

    <!-- season label -->
    <Label id="seasonLabel" translation="[96.75,260]" width="200" height="66" color="0xF3F7FBFF" font="font:LargeBoldSystemFont" />

    <!-- episode list -->
    <TVEpisodeRowList
      id="episodesList"
      translation="[80.75,324]"
      itemComponentName="TVEpisodeCard"
      itemSize="[1758.5,590]"
      rowItemSize="[[575,590]]"
      rowItemSpacing="[[16.75,0]]"
      numRows="1"
      drawFocusFeedback="true"
      focusBitmapUri="pkg:/images/tv-season/episode-thumbnail-horizontal-focus-575x590.png"
      focusFootprintBitmapUri=""
      showRowLabel="[false]" />

    <MarkupGrid
      id="episodesGrid"
      translation="[80.75,324]"
      itemComponentName="TVEpisodeCard"
      itemSize="[575,590]"
      itemSpacing="[16.75,16.75]"
      numColumns="3"
      numRows="2"
      drawFocusFeedback="true"
      vertFocusAnimationStyle="fixedFocus"
      focusBitmapUri="pkg:/images/tv-season/episode-thumbnail-vertical-focus-575x590.png"
      focusFootprintBitmapUri=""
      visible="false" />

    <!-- left/right episode navigation queues -->
    <Poster id="leftChevron" translation="[37,487]" width="48" height="48" uri="pkg:/images/icons/chevrons/left.png" visible="false" />
    <Poster id="rightChevron" translation="[1830,487]" width="48" height="48" uri="pkg:/images/icons/chevrons/right.png" visible="false" />

    <TVSeasonTask id="tvSeasonTask" />
  </children>
</component>
