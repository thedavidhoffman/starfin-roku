<?xml version="1.0" encoding="utf-8"?>
<component name="TVSeason" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/source/Format.brs" />
  <script type="text/brightscript" uri="pkg:/source/String.brs" />
  <script type="text/brightscript" uri="pkg:/source/Logger.brs" />
  <script type="text/brightscript" uri="pkg:/source/Status.brs" />
  <script type="text/brightscript" uri="pkg:/source/PlaybackProgress.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/TVSeason/TVSeason/TVSeason.brs" />
  <interface>
    <field id="loadRequest" type="assocarray" onChange="onLoadRequestChanged" />
    <field id="closeRequested" type="boolean" alwaysNotify="true" />
    <field id="selectedEpisode" type="assocarray" alwaysNotify="true" />
    <field id="selectedPerson" type="assocarray" alwaysNotify="true" />
    <function name="activate" />
  </interface>
  <children>
    <Rectangle width="1920" height="1080" color="0x00000055" />

    <!-- show logo -->
    <Poster id="showLogo" translation="[660,62]" width="600" height="150" loadDisplayMode="scaleToFit" visible="false" />

    <!-- series label - displays series title if there is no show logo -->
    <Label id="seriesLabel" translation="[0,104]" width="1920" height="66" horizAlign="center" color="0xF3F7FBFF" font="font:LargestSystemFont" />
    
    <!-- season label -->
    <Label id="seasonLabel" translation="[96.75,260]" width="200" height="66" color="0xF3F7FBFF" font="font:LargeBoldSystemFont" />
    
    <!-- episode list -->
    <TVEpisodeRowList
      id="episodesList"
      translation="[80.75,324]"
      itemComponentName="TVEpisodeItem"
      itemSize="[1758.5,590]"
      rowItemSize="[[575,590]]"
      rowItemSpacing="[[16.75,0]]"
      numRows="1"
      drawFocusFeedback="true"
      focusBitmapUri="pkg:/images/masks/rounded-episode-thumbnail-focus-575x590.png"
      focusFootprintBitmapUri=""
      showRowLabel="[false]" />

    <!-- episode details -->
    <TVEpisodeDetails id="episodeDetails" translation="[80.75,324]" visible="false" />

    <!-- left/right episode navigation queues -->
    <Poster id="leftChevron" translation="[42,487]" width="48" height="48" uri="pkg:/images/icons/chevron-left.png" visible="false" />
    <Poster id="rightChevron" translation="[1830,487]" width="48" height="48" uri="pkg:/images/icons/chevron-right.png" visible="false" />

    <!-- episode detail navigation queues -->
    <Poster id="downChevron" translation="[936,1008]" width="48" height="48" uri="pkg:/images/icons/chevron-down.png" visible="true" />
    <Poster id="upChevron" translation="[936,1008]" width="48" height="48" uri="pkg:/images/icons/chevron-up.png" visible="false" />

    <TVSeasonTask id="tvSeasonTask" />
  </children>
</component>
