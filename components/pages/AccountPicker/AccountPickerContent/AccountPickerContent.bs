import "pkg:/source/AccountPicker.bs"
import "pkg:/source/String.bs"
import "pkg:/source/Remote.bs"
import "pkg:/source/Encode.bs"
import "pkg:/source/Url.bs"
import "pkg:/source/AccountImage.bs"
import "pkg:/source/Number.bs"
import "pkg:/source/store/RegistryStore.bs"
import "pkg:/source/store/AuthStore.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    initReferences()
    m.accountState = {
        windowStart: 0
        mode: AccountPicker.Mode.Picker
        removalCandidate: invalid
        focusedKey: m.top.initialFocusAccountKey
        rendering: false
        accountsDirty: false
    }
    m.layoutState = {
        verticalItemWidth: 640
        itemWidth: 246
        visualItemWidth: 207
        itemSpacing: -15
        chevronSize: 48
    }
    initHandlers()
    onAccountsChanged()
end sub

'-------------------------------------------------------------------------------
' initReferences
'-------------------------------------------------------------------------------
sub initReferences()
    m.verticalAccounts = m.top.findNode("verticalAccounts")
    m.accountRows = m.top.findNode("accountRows")
    m.leftChevron = m.top.findNode("leftChevron")
    m.rightChevron = m.top.findNode("rightChevron")
    m.signInButton = m.top.findNode("signInButton")
    m.removalPreview = m.top.findNode("removalPreview")
    m.removalDescription = m.top.findNode("removalDescription")
    m.removeButton = m.top.findNode("removeButton")
    m.cancelButton = m.top.findNode("cancelButton")
end sub

'-------------------------------------------------------------------------------
' initHandlers
'-------------------------------------------------------------------------------
sub initHandlers()
    m.verticalAccounts.observeField("itemSelected", "onVerticalAccountSelected")
    m.verticalAccounts.observeField("itemFocused", "onVerticalAccountFocused")
    m.verticalAccounts.observeField("focusExitDown", "onAccountRowsFocusExitDown")
    m.verticalAccounts.observeField("forgetRequested", "onVerticalForgetRequested")
    m.top.observeField("accounts", "onAccountsChanged")
    m.top.observeField("protectActiveAccount", "onAccountsChanged")
    m.top.observeField("contentWidth", "onGeometryChanged")
    m.top.observeField("visibleRows", "onGeometryChanged")
    m.top.observeField("signInGap", "onGeometryChanged")
    m.top.observeField("horizontalVisibleCount", "onGeometryChanged")
    m.top.observeField("initialFocusAccountKey", "onInitialFocusChanged")
    m.accountRows.observeField("rowItemSelected", "onAccountSelected")
    m.accountRows.observeField("rowItemFocused", "onAccountFocused")
    m.accountRows.observeField("focusExitDown", "onAccountRowsFocusExitDown")
    m.signInButton.observeField("buttonSelected", "onSignInSelected")
    m.removeButton.observeField("buttonSelected", "onRemoveSelected")
    m.cancelButton.observeField("buttonSelected", "onCancelSelected")
end sub

'-------------------------------------------------------------------------------
' onAccountsChanged
'-------------------------------------------------------------------------------
sub onAccountsChanged()
    if m.accountState.mode = AccountPicker.Mode.Remove then
        m.accountState.accountsDirty = true
    else
        renderAccounts()
    end if
end sub

'-------------------------------------------------------------------------------
' renderAccounts
'-------------------------------------------------------------------------------
sub renderAccounts()
    m.accountState.accountsDirty = false
    m.accountState.rendering = true
    m.accountState.windowStart = 0
    showPickerControls()
    accounts = m.top.accounts
    if accounts = invalid then accounts = []
    m.top.verticalLayout = AccountPicker.HasMultipleServers(accounts)
    selectedIndex = getFocusedIndex()
    if accounts.Count() > 0 then m.accountState.focusedKey = accounts[selectedIndex].accountKey
    layoutContent()
    if m.top.verticalLayout then
        m.accountRows.content = invalid
        renderVerticalAccounts(accounts)
    else
        m.verticalAccounts.content = invalid
        renderAccountRows(accounts)
    end if
    m.accountRows.visible = accounts.Count() > 0 and not m.top.verticalLayout
    m.verticalAccounts.visible = accounts.Count() > 0 and m.top.verticalLayout
    m.accountState.rendering = false
    updateChevrons()
end sub

'-------------------------------------------------------------------------------
' renderAccountRows
'-------------------------------------------------------------------------------
sub renderAccountRows(accounts as dynamic)
    content = CreateObject("roSGNode", "ContentNode")
    row = content.createChild("ContentNode")
    if accounts = invalid then accounts = []

    for each account in accounts
        item = row.createChild("ContentNode")
        item.title = Strings.ToString(account.username, "Account")
        if m.top.protectActiveAccount and account.isActive = true then item.description = "Active" else item.description = "* to forget"
        item.HDPosterUrl = buildAccountImageUri(account)
        item.AddFields({ account: account })
    end for

    m.accountRows.content = content
    m.accountRows.visible = row.getChildCount() > 0
    updateChevrons()
end sub

'-------------------------------------------------------------------------------
' layoutAccountRows
'-------------------------------------------------------------------------------
sub layoutAccountRows()
    contentWidth = Number.ToInteger(m.top.contentWidth, 800)
    itemStride = m.layoutState.itemWidth + m.layoutState.itemSpacing
    rowWidth = itemStride * m.top.horizontalVisibleCount
    rowX = Number.ToInteger((contentWidth - rowWidth) / 2, 0)

    accountCount = 0
    if m.top.accounts <> invalid then accountCount = m.top.accounts.Count()
    if accountCount > 0 then
        ' Center visible avatars and labels rather than the padded focus canvases.
        visibleCount = accountCount
        if visibleCount > m.top.horizontalVisibleCount then visibleCount = m.top.horizontalVisibleCount
        visualWidth = itemStride * (visibleCount - 1) + m.layoutState.visualItemWidth
        rowX = Number.ToInteger((contentWidth - visualWidth) / 2, 0)
        if accountCount < m.top.horizontalVisibleCount then rowWidth = itemStride * (accountCount - 1) + m.layoutState.itemWidth
    end if
    m.accountRows.translation = [rowX, 0]
    m.accountRows.itemSize = [rowWidth, 264]
end sub

'-------------------------------------------------------------------------------
' layoutContent
'-------------------------------------------------------------------------------
sub layoutContent()
    contentWidth = Number.ToInteger(m.top.contentWidth, 800)
    layoutAccountRows()
    m.leftChevron.translation = [0, 74]
    m.rightChevron.translation = [contentWidth - m.layoutState.chevronSize, 74]

    buttonWidth = m.signInButton.callFunc("getPreferredWidth", 30)
    m.signInButton.buttonWidth = buttonWidth
    buttonX = Number.ToInteger((contentWidth - buttonWidth) / 2, 0)
    accounts = m.top.accounts
    accountCount = 0
    if accounts <> invalid then accountCount = accounts.Count()
    rowCount = accountCount
    if rowCount > m.top.visibleRows then rowCount = m.top.visibleRows
    bodyHeight = 264
    if m.top.verticalLayout then bodyHeight = rowCount * 128 - 8
    footerGap = m.top.signInGap
    buttonY = bodyHeight + footerGap
    if accountCount = 0 and m.accountState.mode = AccountPicker.Mode.Picker then buttonY = 0
    m.signInButton.translation = [buttonX, buttonY]
    listWidth = m.layoutState.verticalItemWidth
    if listWidth > contentWidth then listWidth = contentWidth
    m.verticalAccounts.translation = [Number.ToInteger((contentWidth - listWidth) / 2, 0), 0]
    m.verticalAccounts.itemSize = [listWidth, 120]
    if rowCount < 1 then rowCount = 1
    m.verticalAccounts.numRows = rowCount
    if m.verticalAccounts.content <> invalid then
        for each item in m.verticalAccounts.content.getChildren(-1, 0)
            item.rowWidth = listWidth
        end for
    end if

    if m.accountState.mode = AccountPicker.Mode.Remove then
        m.top.preferredHeight = layoutRemovalConfirmation(contentWidth)
    else
        m.top.preferredHeight = buttonY + 56
    end if
end sub

'-------------------------------------------------------------------------------
' layoutRemovalConfirmation
'-------------------------------------------------------------------------------
function layoutRemovalConfirmation(contentWidth as integer) as integer
    ' Confirmation geometry is independent of the account list's capacity and presentation.
    bodyWidth = 640
    if bodyWidth > contentWidth then bodyWidth = contentWidth
    previewX = Number.ToInteger((contentWidth - bodyWidth) / 2, 0)
    m.removalPreview.translation = [previewX, 0]
    descriptionX = previewX + m.layoutState.visualItemWidth + 30
    m.removalDescription.width = bodyWidth - m.layoutState.visualItemWidth - 30
    textHeight = Number.ToInteger(m.removalDescription.boundingRect().height + 0.999, 237)
    bodyHeight = 237
    if textHeight > bodyHeight then bodyHeight = textHeight
    m.removalDescription.translation = [descriptionX, Number.ToInteger((bodyHeight - textHeight) / 2, 0)]
    buttonY = bodyHeight + 24

    confirmationGap = 30
    removeButtonWidth = m.removeButton.callFunc("getPreferredWidth", 30)
    m.removeButton.buttonWidth = removeButtonWidth
    cancelButtonWidth = Number.ToInteger(m.cancelButton.buttonWidth, 180)
    confirmationWidth = removeButtonWidth + confirmationGap + cancelButtonWidth
    confirmationX = Number.ToInteger((contentWidth - confirmationWidth) / 2, 0)
    m.removeButton.translation = [confirmationX, buttonY]
    m.cancelButton.translation = [confirmationX + removeButtonWidth + confirmationGap, buttonY]
    return buttonY + 56
end function

'-------------------------------------------------------------------------------
' onAccountFocused
'-------------------------------------------------------------------------------
sub onAccountFocused(event as object)
    if m.accountState.rendering or m.top.verticalLayout or not m.accountRows.visible then return
    saveFocusedAccount()
    updateChevrons(event.getData())
end sub

'-------------------------------------------------------------------------------
' updateChevrons
'-------------------------------------------------------------------------------
sub updateChevrons(focused = invalid as dynamic)
    if m.top.verticalLayout or m.accountState.mode = AccountPicker.Mode.Remove then
        m.leftChevron.visible = false
        m.rightChevron.visible = false
        return
    end if
    overflow = getAccountOverflowState(focused)
    m.leftChevron.visible = overflow.left
    m.rightChevron.visible = overflow.right
end sub

'-------------------------------------------------------------------------------
' getAccountOverflowState
'-------------------------------------------------------------------------------
function getAccountOverflowState(focused = invalid as dynamic) as object
    state = { left: false, right: false }
    visibleItemCount = m.top.horizontalVisibleCount

    if m.accountRows.content = invalid then return state
    if m.accountRows.content.getChildCount() = 0 then return state

    row = m.accountRows.content.getChild(0)
    if row = invalid then return state

    itemCount = row.getChildCount()
    if itemCount <= visibleItemCount then return state

    if focused = invalid then focused = m.accountRows.rowItemFocused
    finalWindowStart = itemCount - visibleItemCount
    windowStart = m.accountState.windowStart
    if windowStart = invalid then windowStart = 0

    if focused <> invalid and focused.Count() >= 2 then
        focusedIndex = focused[1]
        centerOffset = Number.ToInteger(visibleItemCount / 2, 0)
        windowStart = focusedIndex - centerOffset
    end if

    if windowStart < 0 then windowStart = 0
    if windowStart > finalWindowStart then windowStart = finalWindowStart
    m.accountState.windowStart = windowStart

    state.left = windowStart > 0
    state.right = (windowStart + visibleItemCount) < itemCount
    return state
end function

'-------------------------------------------------------------------------------
' buildAccountImageUri
'-------------------------------------------------------------------------------
function buildAccountImageUri(account as object) as string
    return AccountImage.GetUri(account, 195, 195)
end function

'-------------------------------------------------------------------------------
' focusAccounts
'-------------------------------------------------------------------------------
function focusAccounts() as boolean
    m.signInButton.hasFocusVisual = false
    if m.verticalAccounts.visible then
        setVerticalFocusFeedback(true)
        m.verticalAccounts.jumpToItem = getFocusedIndex()
        m.verticalAccounts.setFocus(true)
        return true
    end if
    if m.accountRows.visible = true then
        m.accountRows.jumpToRowItem = [0, getFocusedIndex()]
        m.accountRows.drawFocusFeedback = true
        m.accountRows.setFocus(true)
        return true
    end if

    return focusSignInButton()
end function

'-------------------------------------------------------------------------------
' focusSignInButton
'-------------------------------------------------------------------------------
function focusSignInButton() as boolean
    setVerticalFocusFeedback(false)
    m.accountRows.drawFocusFeedback = false
    m.signInButton.focusable = true
    m.signInButton.setFocus(true)
    m.signInButton.hasFocusVisual = true
    return true
end function

'-------------------------------------------------------------------------------
' onAccountRowsFocusExitDown
'-------------------------------------------------------------------------------
sub onAccountRowsFocusExitDown()
    saveFocusedAccount()
    focusSignInButton()
end sub

'-------------------------------------------------------------------------------
' onAccountSelected
'-------------------------------------------------------------------------------
sub onAccountSelected()
    if m.accountState.mode <> AccountPicker.Mode.Picker then return
    selected = m.accountRows.rowItemSelected
    if selected = invalid or selected.Count() < 2 then return
    row = m.accountRows.content.getChild(selected[0])
    if row = invalid then return
    item = row.getChild(selected[1])
    if item = invalid or item.account = invalid then return
    m.accountState.focusedKey = item.account.accountKey
    m.top.accountSelected = item.account
end sub

'-------------------------------------------------------------------------------
' onSignInSelected
'-------------------------------------------------------------------------------
sub onSignInSelected()
    m.top.signInSelected = true
end sub

'-------------------------------------------------------------------------------
' showPickerControls
'-------------------------------------------------------------------------------
sub showPickerControls()
    m.accountState.mode = AccountPicker.Mode.Picker
    m.accountState.removalCandidate = invalid
    m.signInButton.visible = true
    m.removalPreview.visible = false
    m.removalDescription.visible = false
    m.removeButton.visible = false
    m.cancelButton.visible = false
    m.removeButton.hasFocusVisual = false
    m.cancelButton.hasFocusVisual = false
end sub

'-------------------------------------------------------------------------------
' showRemoveConfirmation
'-------------------------------------------------------------------------------
sub showRemoveConfirmation(account as object)
    if m.top.protectActiveAccount and account.isActive = true then return

    saveFocusedAccount()
    m.accountState.mode = AccountPicker.Mode.Remove
    m.verticalAccounts.visible = false
    m.accountRows.visible = false
    m.accountState.removalCandidate = account
    m.signInButton.visible = false
    m.signInButton.hasFocusVisual = false
    m.removalDescription.visible = true
    m.leftChevron.visible = false
    m.rightChevron.visible = false
    m.removeButton.visible = true
    m.cancelButton.visible = true
    layoutContent()
    preview = CreateObject("roSGNode", "ContentNode")
    preview.title = Strings.ToString(account.username, "Account")
    preview.HDPosterUrl = buildAccountImageUri(account)
    m.removalPreview.itemContent = preview
    m.removalPreview.visible = true
    focusConfirmationButton("remove")
end sub

'-------------------------------------------------------------------------------
' showAccountPicker
'-------------------------------------------------------------------------------
sub showAccountPicker()
    if m.accountState.accountsDirty then
        renderAccounts()
    else
        showPickerControls()
        m.accountRows.visible = not m.top.verticalLayout
        m.verticalAccounts.visible = m.top.verticalLayout
        layoutContent()
        updateChevrons()
    end if
    focusAccounts()
end sub

'-------------------------------------------------------------------------------
' focusConfirmationButton
'-------------------------------------------------------------------------------
sub focusConfirmationButton(buttonName as string)
    isRemove = buttonName = "remove"
    m.accountRows.drawFocusFeedback = false
    m.removeButton.hasFocusVisual = isRemove
    m.cancelButton.hasFocusVisual = not isRemove
    if isRemove then
        m.removeButton.setFocus(true)
    else
        m.cancelButton.setFocus(true)
    end if
end sub

'-------------------------------------------------------------------------------
' onRemoveSelected
'-------------------------------------------------------------------------------
sub onRemoveSelected()
    account = m.accountState.removalCandidate
    if account = invalid then
        showAccountPicker()
        return
    end if
    if m.top.protectActiveAccount and account.isActive = true then
        showAccountPicker()
        return
    end if
    if AuthStore.ForgetAccount(Strings.ToString(account.accountKey), not m.top.protectActiveAccount) <> true then
        focusConfirmationButton("remove")
        return
    end if

    remainingAccounts = []
    accounts = m.top.accounts
    if accounts = invalid then accounts = []
    for each savedAccount in accounts
        if Strings.ToString(savedAccount.accountKey) <> Strings.ToString(account.accountKey) then remainingAccounts.Push(savedAccount)
    end for
    remainingIndex = getFocusedIndex()
    if remainingIndex >= remainingAccounts.Count() then remainingIndex = remainingAccounts.Count() - 1
    m.accountState.focusedKey = ""
    if remainingIndex >= 0 then m.accountState.focusedKey = remainingAccounts[remainingIndex].accountKey
    m.top.accounts = remainingAccounts
    m.top.accountsChanged = remainingAccounts
    showAccountPicker()
end sub

'-------------------------------------------------------------------------------
' onCancelSelected
'-------------------------------------------------------------------------------
sub onCancelSelected()
    showAccountPicker()
end sub

'-------------------------------------------------------------------------------
' getFocusedAccount
'-------------------------------------------------------------------------------
function getFocusedAccount() as dynamic
    if m.top.verticalLayout then
        item = m.verticalAccounts.content.getChild(m.verticalAccounts.itemFocused)
        if item <> invalid then return item.account
        return invalid
    end if
    focused = getValidRowItem(m.accountRows.rowItemFocused)
    if focused = invalid then return invalid
    row = m.accountRows.content.getChild(focused[0])
    if row = invalid then return invalid
    item = row.getChild(focused[1])
    if item = invalid then return invalid
    return item.account
end function

'-------------------------------------------------------------------------------
' saveFocusedAccount
'-------------------------------------------------------------------------------
sub saveFocusedAccount()
    account = getFocusedAccount()
    if account <> invalid then m.accountState.focusedKey = account.accountKey
end sub

'-------------------------------------------------------------------------------
' getValidRowItem
'-------------------------------------------------------------------------------
function getValidRowItem(rowItem as dynamic) as object
    if rowItem = invalid or rowItem.Count() < 2 then return [0, 0]
    if m.accountRows.content = invalid or m.accountRows.content.getChildCount() = 0 then return [0, 0]
    row = m.accountRows.content.getChild(0)
    if row = invalid or row.getChildCount() = 0 then return [0, 0]
    index = rowItem[1]
    if index < 0 then index = 0
    if index >= row.getChildCount() then index = row.getChildCount() - 1
    return [0, index]
end function

'-------------------------------------------------------------------------------
' onKeyEvent
'-------------------------------------------------------------------------------
function onKeyEvent(key as string, press as boolean) as boolean
    if press = false then return false
    if m.accountState.mode = AccountPicker.Mode.Remove then
        if m.removeButton.isInFocusChain() and key = Remote.Key.Right then
            focusConfirmationButton("cancel")
            return true
        end if
        if m.cancelButton.isInFocusChain() and key = Remote.Key.Left then
            focusConfirmationButton("remove")
            return true
        end if
        if key = Remote.Key.Back then
            showAccountPicker()
            return true
        end if
        return false
    end if

    if key = Remote.Key.Options and m.accountRows.isInFocusChain() then
        account = getFocusedAccount()
        if account <> invalid then showRemoveConfirmation(account)
        return true
    end if
    if m.signInButton.isInFocusChain() and key = Remote.Key.Up and (m.accountRows.visible or m.verticalAccounts.visible) then
        m.signInButton.hasFocusVisual = false
        return focusAccounts()
    end if
    return false
end function

'-------------------------------------------------------------------------------
' renderVerticalAccounts
'-------------------------------------------------------------------------------
sub renderVerticalAccounts(accounts as object)
    content = CreateObject("roSGNode", "ContentNode")
    for each account in accounts
        item = content.createChild("ContentNode")
        item.title = Strings.ToString(account.username, "Account")
        item.description = Url.NormalizeServer(account.server)
        accountStatus = "* to forget"
        if m.top.protectActiveAccount and account.isActive = true then accountStatus = "Active"
        item.HDPosterUrl = buildAccountImageUri(account)
        item.addFields({ account: account, accountStatus: accountStatus, rowWidth: m.verticalAccounts.itemSize[0], listFocused: false })
    end for
    m.verticalAccounts.content = content
end sub

'-------------------------------------------------------------------------------
' setVerticalFocusFeedback
'-------------------------------------------------------------------------------
sub setVerticalFocusFeedback(focused as boolean)
    if m.verticalAccounts.content = invalid then return
    for each item in m.verticalAccounts.content.getChildren(-1, 0)
        item.listFocused = focused
    end for
end sub

'-------------------------------------------------------------------------------
' onVerticalAccountSelected
'-------------------------------------------------------------------------------
sub onVerticalAccountSelected()
    if m.accountState.mode <> AccountPicker.Mode.Picker then return
    item = m.verticalAccounts.content.getChild(m.verticalAccounts.itemSelected)
    if item = invalid then return
    m.accountState.focusedKey = item.account.accountKey
    m.top.accountSelected = item.account
end sub

'-------------------------------------------------------------------------------
' onVerticalAccountFocused
'-------------------------------------------------------------------------------
sub onVerticalAccountFocused()
    if m.accountState.rendering or not m.verticalAccounts.visible then return
    saveFocusedAccount()
end sub

'-------------------------------------------------------------------------------
' onVerticalForgetRequested
'-------------------------------------------------------------------------------
sub onVerticalForgetRequested()
    if m.accountState.mode <> AccountPicker.Mode.Picker or not m.verticalAccounts.visible then return
    account = m.verticalAccounts.forgetRequested
    if account <> invalid then showRemoveConfirmation(account)
end sub

'-------------------------------------------------------------------------------
' onGeometryChanged
'-------------------------------------------------------------------------------
sub onGeometryChanged()
    layoutContent()
    updateChevrons()
end sub

'-------------------------------------------------------------------------------
' onInitialFocusChanged
'-------------------------------------------------------------------------------
sub onInitialFocusChanged()
    m.accountState.focusedKey = m.top.initialFocusAccountKey
end sub

'-------------------------------------------------------------------------------
' getFocusedIndex
'-------------------------------------------------------------------------------
function getFocusedIndex() as integer
    accounts = m.top.accounts
    if accounts = invalid then return 0
    activeIndex = 0
    for index = 0 to accounts.Count() - 1
        if accounts[index].accountKey = m.accountState.focusedKey then return index
        if accounts[index].isActive = true then activeIndex = index
    end for
    return activeIndex
end function
