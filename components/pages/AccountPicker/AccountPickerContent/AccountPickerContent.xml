<?xml version="1.0" encoding="utf-8"?>
<component name="AccountPickerContent" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/source/Format.brs" />
  <script type="text/brightscript" uri="pkg:/source/String.brs" />
  <script type="text/brightscript" uri="pkg:/source/Encode.brs" />
  <script type="text/brightscript" uri="pkg:/source/Url.brs" />
  <script type="text/brightscript" uri="pkg:/source/AccountImage.brs" />
  <script type="text/brightscript" uri="pkg:/source/Number.bs" />
  <script type="text/brightscript" uri="pkg:/source/store/AuthStore.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/AccountPicker/AccountPickerContent/AccountPickerContent.bs" />
  <interface>
    <field id="contentWidth" type="integer" value="800" onChange="layoutContent" />
    <field id="accounts" type="array" onChange="onAccountsChanged" />
    <field id="accountSelected" type="assocarray" alwaysNotify="true" />
    <field id="signInSelected" type="boolean" alwaysNotify="true" />
    <field id="accountsChanged" type="array" alwaysNotify="true" />
    <function name="focusAccounts" />
  </interface>
  <children>
    <AccountPickerRowList
      id="accountRows"
      itemComponentName="AccountPickerItem"
      itemSize="[693,264]"
      rowItemSize="[[246,264]]"
      rowItemSpacing="[[-15,0]]"
      numRows="1"
      drawFocusFeedback="true"
      focusBitmapUri="pkg:/images/cast/cast-focus-246x264.png"
      focusFootprintBitmapUri=""
      showRowLabel="[false]" />
    <Poster
      id="leftChevron"
      width="48"
      height="48"
      uri="pkg:/images/icons/chevrons/left.png"
      visible="false" />
    <Poster
      id="rightChevron"
      width="48"
      height="48"
      uri="pkg:/images/icons/chevrons/right.png"
      visible="false" />
    <PrimaryButton
      id="signInButton"
      buttonWidth="420"
      buttonHeight="56"
      text="Sign in another account" />
    <Label
      id="removalDescription"
      visible="false"
      height="150"
      color="0xB9C7D6FF"
      font="font:SmallSystemFont"
      wrap="true"
      numLines="4"
      vertAlign="center"
      text="Removes this user and their settings from Starfin. Their Jellyfin account is unaffected." />
    <PrimaryButton
      id="removeButton"
      visible="false"
      buttonWidth="260"
      buttonHeight="56"
      text="Forget User" />
    <PrimaryButton
      id="cancelButton"
      visible="false"
      buttonWidth="180"
      buttonHeight="56"
      text="Cancel" />
  </children>
</component>
