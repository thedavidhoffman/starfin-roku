<?xml version="1.0" encoding="utf-8"?>
<component name="AccountPickerContent" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/components/pages/AccountPicker/AccountPickerContent/AccountPickerContent.bs" />
  <interface>
    <field id="protectActiveAccount" type="boolean" value="true" />
    <field id="horizontalVisibleCount" type="integer" value="3" />
    <field id="verticalLayout" type="boolean" />
    <field id="initialFocusAccountKey" type="string" />
    <field id="contentWidth" type="integer" value="800" />
    <field id="signInGap" type="integer" value="24" />
    <field id="preferredHeight" type="integer" />
    <field id="visibleRows" type="integer" value="3" />
    <field id="accounts" type="array" />
    <field id="accountSelected" type="assocarray" alwaysNotify="true" />
    <field id="signInSelected" type="boolean" alwaysNotify="true" />
    <field id="accountsChanged" type="array" alwaysNotify="true" />
    <function name="focusAccounts" />
  </interface>
  <children>
    <AccountPickerList id="verticalAccounts" visible="false" itemComponentName="AccountPickerListItem" itemSize="[800,120]" itemSpacing="[0,8]" numRows="3" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" />
    <AccountPickerRowList
      id="accountRows"
      itemComponentName="AccountPickerItem"
      itemSize="[693,264]"
      rowItemSize="[[246,264]]"
      rowItemSpacing="[[-15,0]]"
      numRows="1"
      drawFocusFeedback="true"
      focusBitmapUri="pkg:/images/cast/cast-focus-246x264.png"
      focusFootprintBitmapUri=""
      showRowLabel="[false]" />
    <Poster
      id="leftChevron"
      width="48"
      height="48"
      uri="pkg:/images/icons/chevrons/left.png"
      visible="false" />
    <Poster
      id="rightChevron"
      width="48"
      height="48"
      uri="pkg:/images/icons/chevrons/right.png"
      visible="false" />
    <PrimaryButton
      id="signInButton"
      buttonWidth="420"
      buttonHeight="56"
      text="Sign in with another account" />
    <AccountPickerItem id="removalPreview" visible="false" />
    <Label
      id="removalDescription"
      visible="false"
      color="0xB9C7D6FF"
      font="font:SmallSystemFont"
      wrap="true"
      text="Removes this user and their settings from Starfin. Their Jellyfin account is unaffected." />
    <PrimaryButton
      id="removeButton"
      visible="false"
      buttonWidth="260"
      buttonHeight="56"
      text="Forget User" />
    <PrimaryButton
      id="cancelButton"
      visible="false"
      buttonWidth="180"
      buttonHeight="56"
      text="Cancel" />
  </children>
</component>
