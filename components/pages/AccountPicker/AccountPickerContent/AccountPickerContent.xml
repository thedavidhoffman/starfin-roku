<?xml version="1.0" encoding="utf-8"?>
<component name="AccountPickerContent" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/source/Format.brs" />
  <script type="text/brightscript" uri="pkg:/source/String.brs" />
  <script type="text/brightscript" uri="pkg:/source/Encode.brs" />
  <script type="text/brightscript" uri="pkg:/source/Url.brs" />
  <script type="text/brightscript" uri="pkg:/source/AccountImage.brs" />
  <script type="text/brightscript" uri="pkg:/source/Number.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/AccountPicker/AccountPickerContent/AccountPickerContent.brs" />
  <interface>
    <field id="contentWidth" type="integer" value="800" onChange="layoutContent" />
    <field id="accounts" type="array" onChange="onAccountsChanged" />
    <field id="accountSelected" type="assocarray" alwaysNotify="true" />
    <field id="signInSelected" type="boolean" alwaysNotify="true" />
    <function name="focusAccounts" />
  </interface>
  <children>
    <AccountPickerRowList
      id="accountRows"
      itemComponentName="AccountPickerItem"
      itemSize="[693,264]"
      rowItemSize="[[246,264]]"
      rowItemSpacing="[[-15,0]]"
      numRows="1"
      drawFocusFeedback="true"
      focusBitmapUri="pkg:/images/cast/cast-focus-246x264.png"
      focusFootprintBitmapUri=""
      showRowLabel="[false]" />
    <Poster
      id="leftChevron"
      width="48"
      height="48"
      uri="pkg:/images/icons/chevrons/left.png"
      visible="false" />
    <Poster
      id="rightChevron"
      width="48"
      height="48"
      uri="pkg:/images/icons/chevrons/right.png"
      visible="false" />
    <PrimaryButton
      id="signInButton"
      buttonWidth="420"
      buttonHeight="56"
      text="Sign in another account" />
  </children>
</component>
