'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.pageLayout = { picker: m.top.findNode("picker"), logo: m.top.findNode("startupLogo") }
    m.pageLayout.picker.observeField("preferredHeight", "layoutPicker")
    m.pageLayout.picker.observeField("verticalLayout", "onPresentationChanged")
    onPresentationChanged()
end sub

'-------------------------------------------------------------------------------
' layoutPicker
'-------------------------------------------------------------------------------
sub layoutPicker()
    logoHeight = m.pageLayout.logo.height
    logoGap = 72
    groupHeight = logoHeight + logoGap + m.pageLayout.picker.preferredHeight
    ' Balance the whole group just above center, retaining a top safe margin for long lists.
    groupY = 500 - groupHeight / 2
    if groupY < 60 then groupY = 60
    m.pageLayout.logo.translation = [(1920 - m.pageLayout.logo.width) / 2, groupY]
    m.pageLayout.picker.translation = [(1920 - m.pageLayout.picker.contentWidth) / 2, groupY + logoHeight + logoGap]
end sub

'-------------------------------------------------------------------------------
' focusAccounts
'-------------------------------------------------------------------------------
function focusAccounts() as boolean
    return m.top.findNode("picker").callFunc("focusAccounts")
end function

'-------------------------------------------------------------------------------
' onPresentationChanged
'-------------------------------------------------------------------------------
sub onPresentationChanged()
    width = 1280
    if m.pageLayout.picker.verticalLayout then width = 800
    m.pageLayout.picker.contentWidth = width
    layoutPicker()
end sub
