import "pkg:/source/Remote.bs"

'-------------------------------------------------------------------------------
' onKeyEvent
'-------------------------------------------------------------------------------
function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if key = Remote.Key.Options then
        if m.top.content <> invalid then
            item = m.top.content.getChild(m.top.itemFocused)
            if item <> invalid and item.account <> invalid then m.top.forgetRequested = item.account
        end if
        return true
    end if
    if key = Remote.Key.Down and m.top.content <> invalid then
        if m.top.itemFocused = m.top.content.getChildCount() - 1 then
            m.top.focusExitDown = true
            return true
        end if
    end if
    return false
end function
