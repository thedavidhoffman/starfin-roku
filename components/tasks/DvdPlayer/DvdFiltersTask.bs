import "pkg:/source/api/HttpClient.bs"
import "pkg:/source/api/JellyfinAuth.bs"
import "pkg:/source/Url.bs"
import "pkg:/components/pages/DvdPlayer/Helpers/FilterContracts.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.top.functionName = "executeRequest"
end sub

'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    request = m.top.request
    path = "Starfin/Dvd/Filters"
    if request.kind = DvdFilter.Request.Capability then path = "Starfin/Dvd/Info"
    try
        result = HttpClient.Request(Url.Resolve(request.server, path), "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token), true, 3000)
    catch error
        result = { ok: false, errorMessage: "Unable to load video filters." }
    end try
    result.requestId = request.requestId
    result.kind = request.kind
    m.top.response = result
end sub
