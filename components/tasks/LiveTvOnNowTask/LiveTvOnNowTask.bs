import "pkg:/source/Format.bs"
import "pkg:/source/String.bs"
import "pkg:/source/Logger.bs"
import "pkg:/source/Encode.bs"
import "pkg:/source/Url.bs"
import "pkg:/source/api/HttpClient.bs"
import "pkg:/source/api/JellyfinAuth.bs"
import "pkg:/source/TaskRequest.bs"
import "pkg:/source/TaskResponse.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.log = new Logger("LiveTvOnNowTask", m.global.logService)
    m.top.functionName = "executeRequest"
end sub

'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    request = m.top.request
    validationError = TaskRequest.ValidateRequest(request, "liveTvOnNow")
    if validationError <> invalid then
        m.top.response = validationError
        return
    end if

    params = {
        userId: TaskRequest.GetUserId(request)
        isAiring: true
        limit: getInteger(request.limit, 25)
        imageTypeLimit: 1
        enableImageTypes: "Primary, Backdrop, Thumb"
        enableTotalRecordCount: false
        fields: "ChannelInfo,PrimaryImageAspectRatio"
    }

    requestUrl = request.server + "/livetv/programs/recommended" + Url.BuildQueryString(params)
    response = HttpClient.Request(requestUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
    if response.ok <> true then
        m.top.response = TaskResponse.Failure(response, "liveTvOnNow")
        return
    end if

    m.top.response = TaskResponse.Success(request, "liveTvOnNow", response.data)
end sub

'-------------------------------------------------------------------------------
' getInteger
'-------------------------------------------------------------------------------
function getInteger(value as dynamic, fallback as integer) as integer
    if value = invalid then return fallback
    return value.ToInt()
end function
