import "pkg:/source/JellyfinImage.bs"
import "pkg:/source/String.bs"
import "pkg:/source/Logger.bs"
import "pkg:/source/Encode.bs"
import "pkg:/source/Json.bs"
import "pkg:/source/api/HttpClient.bs"
import "pkg:/source/api/JellyfinAuth.bs"
import "pkg:/source/TaskRequest.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.top.functionName = "executeRequest"
end sub

'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    request = m.top.request
    validationError = validateRequest(request)
    if validationError <> invalid then
        if request <> invalid then
            validationError.AddReplace("channelIds", Strings.ToString(request.channelIds))
            validationError.AddReplace("startTime", Strings.ToString(request.startTime))
            validationError.AddReplace("endTime", Strings.ToString(request.endTime))
        end if
        m.top.response = validationError
        return
    end if

    body = Json.Object([
        Json.Pair("UserId", Strings.ToString(request.userId))
        Json.Pair("ChannelIds", Strings.ToString(request.channelIds))
        Json.Pair("MinEndDate", Strings.ToString(request.startTime))
        Json.Pair("MaxStartDate", Strings.ToString(request.endTime))
        Json.Pair("SortBy", "StartDate")
        Json.Pair("Fields", "Genres")
        Json.BooleanPair("EnableImages", true)
        Json.NumberPair("ImageTypeLimit", 1)
        Json.Pair("EnableImageTypes", Strings.Join([JellyfinImage.Type.Primary, JellyfinImage.Type.Backdrop, JellyfinImage.Type.Thumb]))
        Json.BooleanPair("EnableTotalRecordCount", false)
        Json.BooleanPair("EnableUserData", false)
    ])

    requestUrl = request.server + "/LiveTv/Programs"
    response = HttpClient.Request(requestUrl, "POST", invalid, body, JellyfinAuth.BuildTokenHeaders(request.token))
    if response.ok <> true then
        response.AddReplace("action", "liveTvSchedule")
        response.AddReplace("channelIds", Strings.ToString(request.channelIds))
        response.AddReplace("startTime", Strings.ToString(request.startTime))
        response.AddReplace("endTime", Strings.ToString(request.endTime))
        m.top.response = response
        return
    end if

    m.top.response = {
        ok: true
        action: "liveTvSchedule"
        channelIds: Strings.ToString(request.channelIds)
        startTime: Strings.ToString(request.startTime)
        endTime: Strings.ToString(request.endTime)
        payload: response.data
    }
end sub

'-------------------------------------------------------------------------------
' validateRequest
'-------------------------------------------------------------------------------
function validateRequest(request as dynamic) as dynamic
    validationError = TaskRequest.ValidateRequest(request, "liveTvSchedule", ["channelIds"])
    if validationError <> invalid then return validationError

    if Strings.ToString(request.startTime) = "" or Strings.ToString(request.endTime) = "" then return { ok: false, action: "liveTvSchedule", errorMessage: "Invalid Live TV guide window." }

    return invalid
end function
