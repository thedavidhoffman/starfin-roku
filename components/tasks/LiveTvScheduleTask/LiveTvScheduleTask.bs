import "pkg:/source/Format.bs"
import "pkg:/source/String.bs"
import "pkg:/source/Logger.bs"
import "pkg:/source/Encode.bs"
import "pkg:/source/Json.bs"
import "pkg:/source/api/HttpClient.bs"
import "pkg:/source/api/JellyfinAuth.bs"
import "pkg:/source/TaskRequest.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.top.functionName = "executeRequest"
end sub

'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    request = m.top.request
    validationError = validateRequest(request)
    if validationError <> invalid then
        if request <> invalid then
            validationError.AddReplace("channelIds", Format.SafeString(request.channelIds, ""))
            validationError.AddReplace("startTime", Format.SafeString(request.startTime, ""))
            validationError.AddReplace("endTime", Format.SafeString(request.endTime, ""))
        end if
        m.top.response = validationError
        return
    end if

    body = Json.Object([
        Json.Pair("UserId", Format.SafeString(request.userId, ""))
        Json.Pair("ChannelIds", Format.SafeString(request.channelIds, ""))
        Json.Pair("MinEndDate", Format.SafeString(request.startTime, ""))
        Json.Pair("MaxStartDate", Format.SafeString(request.endTime, ""))
        Json.Pair("SortBy", "StartDate")
        Json.Pair("Fields", "Genres")
        Json.BooleanPair("EnableImages", true)
        Json.NumberPair("ImageTypeLimit", 1)
        Json.Pair("EnableImageTypes", "Primary,Backdrop,Thumb")
        Json.BooleanPair("EnableTotalRecordCount", false)
        Json.BooleanPair("EnableUserData", false)
    ])

    requestUrl = request.server + "/LiveTv/Programs"
    response = HttpClient.Request(requestUrl, "POST", invalid, body, JellyfinAuth.BuildTokenHeaders(request.token))
    if response.ok <> true then
        response.AddReplace("action", "liveTvSchedule")
        response.AddReplace("channelIds", Format.SafeString(request.channelIds, ""))
        response.AddReplace("startTime", Format.SafeString(request.startTime, ""))
        response.AddReplace("endTime", Format.SafeString(request.endTime, ""))
        m.top.response = response
        return
    end if

    m.top.response = {
        ok: true
        action: "liveTvSchedule"
        channelIds: Format.SafeString(request.channelIds, "")
        startTime: Format.SafeString(request.startTime, "")
        endTime: Format.SafeString(request.endTime, "")
        payload: response.data
    }
end sub

'-------------------------------------------------------------------------------
' validateRequest
'-------------------------------------------------------------------------------
function validateRequest(request as dynamic) as dynamic
    validationError = TaskRequest.ValidateRequest(request, "liveTvSchedule", ["channelIds"])
    if validationError <> invalid then return validationError

    if Format.SafeString(request.startTime, "") = "" or Format.SafeString(request.endTime, "") = "" then return { ok: false, action: "liveTvSchedule", errorMessage: "Invalid Live TV guide window." }

    return invalid
end function
