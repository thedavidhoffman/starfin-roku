import "pkg:/source/Format.bs"
import "pkg:/source/Number.bs"
import "pkg:/source/String.bs"
import "pkg:/source/Logger.bs"
import "pkg:/source/Encode.bs"
import "pkg:/source/Url.bs"
import "pkg:/source/api/HttpClient.bs"
import "pkg:/source/api/JellyfinAuth.bs"
import "pkg:/source/TaskRequest.bs"
import "pkg:/source/TaskResponse.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.top.functionName = "executeRequest"
end sub

'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    request = m.top.request
    validationError = TaskRequest.ValidateRequest(request, "favorites")
    if validationError <> invalid then
        m.top.response = validationError
        return
    end if

    params = {
        userid: TaskRequest.GetUserId(request)
        Filters: "IsFavorite"
        Limit: Number.ToInteger(request.limit, 25)
        recursive: true
        sortby: Format.FirstNonEmpty([request.sortBy], "SortName")
        sortOrder: Format.FirstNonEmpty([request.sortOrder], "Ascending")
        EnableTotalRecordCount: false
    }

    itemsResponse = getJson(request, "favorites", "/items/", params)
    if itemsResponse.ok <> true then
        m.top.response = itemsResponse
        return
    end if

    peopleResponse = getJson(request, "favorites", "/persons", params)
    if peopleResponse.ok <> true then
        m.top.response = peopleResponse
        return
    end if

    m.top.response = TaskResponse.Success(request, "favorites", {
        items: itemsResponse.data
        people: peopleResponse.data
    })
end sub

'-------------------------------------------------------------------------------
' getJson
'-------------------------------------------------------------------------------
function getJson(request as object, action as string, path as string, params as object) as object
    requestUrl = request.server + path + Url.BuildQueryString(params)
    response = HttpClient.Request(requestUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
    if response.ok <> true then return TaskResponse.Failure(response, action)

    return response
end function
