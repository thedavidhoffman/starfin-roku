import "pkg:/source/Format.bs"
import "pkg:/source/String.bs"
import "pkg:/source/Logger.bs"
import "pkg:/source/Encode.bs"
import "pkg:/source/Url.bs"
import "pkg:/source/api/HttpClient.bs"
import "pkg:/source/api/JellyfinAuth.bs"
import "pkg:/source/TaskRequest.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.log = new Logger("FavoriteItemTask", m.global.logService)
    m.top.functionName = "executeRequest"
end sub

'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    request = m.top.request
    action = ""
    if request <> invalid then action = Format.SafeString(request.action, "")

    validationError = TaskRequest.ValidateRequest(request, action, ["userId", "itemId"])
    if validationError <> invalid then
        m.top.response = validationError
        return
    end if

    method = ""
    if action = "AddToFavorites" then
        method = "POST"
    else if action = "RemoveFromFavorites" then
        method = "DELETE"
    else
        m.top.response = { ok: false, action: action, errorMessage: "Unknown favorite request action." }
        return
    end if

    params = {
        userId: request.userId
    }
    requestUrl = request.server + "/UserFavoriteItems/" + request.itemId + Url.BuildQueryString(params)
    result = HttpClient.Request(requestUrl, method, invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
    result.AddReplace("action", action)
    result.AddReplace("itemId", request.itemId)
    if result.ok <> true then m.log.error("Favorite update failed: " + Format.SafeString(result.errorMessage, ""))
    m.top.response = result
end sub
