import "pkg:/source/Format.bs"
import "pkg:/source/String.bs"
import "pkg:/source/Logger.bs"
import "pkg:/source/Encode.bs"
import "pkg:/source/Url.bs"
import "pkg:/source/api/HttpClient.bs"
import "pkg:/source/api/JellyfinAuth.bs"
import "pkg:/source/TaskRequest.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.top.functionName = "executeRequest"
end sub

'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    request = m.top.request
    validationError = TaskRequest.ValidateRequest(request, "collections", ["userId", "libraryId"])
    if validationError <> invalid then
        if request <> invalid then
            validationError.AddReplace("libraryId", Format.SafeString(request.libraryId, ""))
            validationError.AddReplace("mode", Format.SafeString(request.mode, "load"))
        end if
        m.top.response = validationError
        return
    end if

    params = {
        userId: Format.SafeString(request.userId, "")
        parentId: Format.SafeString(request.libraryId, "")
        fields: getFields(request)
        enableUserData: false
        enableImageTypes: "Primary,Backdrop,Thumb,Logo"
        imageTypeLimit: 1
        enableTotalRecordCount: false
        sortBy: getSortBy(request)
        sortOrder: getSortOrder(request)
    }
    addOptionalQueryParams(params, request)

    requestUrl = request.server + "/Users/" + Format.SafeString(request.userId, "") + "/Items" + Url.BuildQueryString(params)
    response = HttpClient.Request(requestUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
    if response.ok <> true then
        response.AddReplace("action", "collections")
        response.AddReplace("libraryId", Format.SafeString(request.libraryId, ""))
        response.AddReplace("mode", Format.SafeString(request.mode, "load"))
        m.top.response = response
        return
    end if

    m.top.response = {
        ok: true
        action: "collections"
        libraryId: Format.SafeString(request.libraryId, "")
        mode: Format.SafeString(request.mode, "load")
        payload: response.data
    }
end sub

'-------------------------------------------------------------------------------
' addOptionalQueryParams
'-------------------------------------------------------------------------------
sub addOptionalQueryParams(params as object, request as object)
    if request.recursive <> invalid then params.AddReplace("recursive", request.recursive)

    includeItemTypes = Format.SafeString(request.includeItemTypes, "")
    if includeItemTypes <> "" then params.AddReplace("includeItemTypes", includeItemTypes)
end sub

'-------------------------------------------------------------------------------
' getFields
'-------------------------------------------------------------------------------
function getFields(request as dynamic) as string
    fields = Format.SafeString(request.fields, "")
    if fields <> "" then return fields

    return "PrimaryImageAspectRatio,SortName,Tags"
end function

'-------------------------------------------------------------------------------
' getSortBy
'-------------------------------------------------------------------------------
function getSortBy(request as dynamic) as string
    sortBy = Format.SafeString(request.sortBy, "")
    if sortBy <> "" then return sortBy

    return "IsFolder,SortName"
end function

'-------------------------------------------------------------------------------
' getSortOrder
'-------------------------------------------------------------------------------
function getSortOrder(request as dynamic) as string
    sortOrder = Format.SafeString(request.sortOrder, "")
    if sortOrder <> "" then return sortOrder

    return "Ascending"
end function
