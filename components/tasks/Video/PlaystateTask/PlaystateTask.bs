import "pkg:/source/Format.bs"
import "pkg:/source/String.bs"
import "pkg:/source/Logger.bs"
import "pkg:/source/Json.bs"
import "pkg:/source/api/HttpClient.bs"
import "pkg:/source/api/JellyfinAuth.bs"
import "pkg:/source/TaskRequest.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.log = new Logger("PlaystateTask", m.global.logService)
    m.top.functionName = "executeRequest"
end sub

'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    request = m.top.request
    validationError = TaskRequest.ValidateRequest(request, "playstate", ["itemId"])
    if validationError <> invalid then
        m.top.response = validationError
        return
    end if

    endpoint = getPlaystateEndpoint(request.status)
    if endpoint = "" then
        m.top.response = { ok: false, action: "playstate", errorMessage: "Invalid playstate status." }
        return
    end if

    requestUrl = request.server + endpoint
    body = buildPlaystateBody(request)
    result = HttpClient.Request(requestUrl, "POST", invalid, body, JellyfinAuth.BuildTokenHeaders(request.token), false)
    result.AddReplace("action", "playstate")
    result.AddReplace("statusName", Format.SafeString(request.status, ""))

    if result.ok <> true then
        m.log.error("Playstate " + Format.SafeString(request.status, "") + " failed: " + Format.SafeString(result.errorMessage, ""))
    end if

    m.top.response = result
end sub


'-------------------------------------------------------------------------------
' getPlaystateEndpoint
'-------------------------------------------------------------------------------
function getPlaystateEndpoint(status as dynamic) as string
    normalized = LCase(Format.SafeString(status, ""))
    if normalized = "start" then return "/Sessions/Playing"
    if normalized = "update" then return "/Sessions/Playing/Progress"
    if normalized = "stop" then return "/Sessions/Playing/Stopped"

    return ""
end function

'-------------------------------------------------------------------------------
' buildPlaystateBody
'-------------------------------------------------------------------------------
function buildPlaystateBody(request as object) as string
    isPaused = request.isPaused = true
    if LCase(Format.SafeString(request.status, "")) = "stop" then isPaused = true

    parts = [
        Json.Pair("ItemId", request.itemId)
        Json.NumberPair("PositionTicks", getPositionTicks(request.position))
        Json.BooleanPair("IsPaused", isPaused)
    ]

    playSessionId = Format.SafeString(request.playSessionId, "")
    if playSessionId <> "" then parts.Push(Json.Pair("PlaySessionId", playSessionId))

    mediaSourceId = Format.SafeString(request.mediaSourceId, "")
    if mediaSourceId <> "" then parts.Push(Json.Pair("MediaSourceId", mediaSourceId))

    liveStreamId = Format.SafeString(request.liveStreamId, "")
    if liveStreamId <> "" then parts.Push(Json.Pair("LiveStreamId", liveStreamId))

    parts.Push(Json.Pair("PlayMethod", Format.SafeString(request.playMethod, "DirectPlay")))
    parts.Push(Json.BooleanPair("CanSeek", request.canSeek = true))

    return Json.Object(parts)
end function

'-------------------------------------------------------------------------------
' getPositionTicks
'-------------------------------------------------------------------------------
function getPositionTicks(position as dynamic) as longinteger
    if position = invalid then return 0

    return int(position) * 10000000&
end function
