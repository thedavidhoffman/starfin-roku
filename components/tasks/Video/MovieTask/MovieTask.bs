import "pkg:/source/String.bs"
import "pkg:/source/TaskRequest.bs"
import "pkg:/source/Number.bs"
import "pkg:/source/api/JellyfinMovie.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.top.functionName = "executeRequest"
end sub

'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    request = m.top.request
    validationError = TaskRequest.ValidateRequest(request, "movie", ["itemId"])
    if validationError <> invalid then
        validationError.AddReplace("requestId", getRequestId(request))
        if request <> invalid then validationError.AddReplace("itemId", Strings.ToString(request.itemId))
        m.top.response = validationError
        return
    end if

    result = JellyfinMovie.Load(request)
    if result.ok <> true then
        result.AddReplace("action", "movie")
        result.AddReplace("itemId", Strings.ToString(request.itemId))
        result.AddReplace("requestId", getRequestId(request))
        m.top.response = result
        return
    end if

    m.top.response = {
        ok: true
        action: "movie"
        itemId: Strings.ToString(request.itemId)
        requestId: getRequestId(request)
        payload: result.data
    }
end sub

'-------------------------------------------------------------------------------
' getRequestId
'-------------------------------------------------------------------------------
function getRequestId(request as dynamic) as integer
    if request = invalid then return -1
    return Number.ToInteger(request.requestId, -1)
end function
