import "pkg:/source/Format.bs"
import "pkg:/source/String.bs"
import "pkg:/source/Logger.bs"
import "pkg:/source/Encode.bs"
import "pkg:/source/Url.bs"
import "pkg:/source/api/HttpClient.bs"
import "pkg:/source/api/JellyfinAuth.bs"
import "pkg:/source/TaskRequest.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.log = new Logger("MovieTask", m.global.logService)
    m.top.functionName = "executeRequest"
end sub

'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    request = m.top.request
    validationError = TaskRequest.ValidateRequest(request, "movie", ["itemId"])
    if validationError <> invalid then
        if request <> invalid then validationError.AddReplace("itemId", Format.SafeString(request.itemId, ""))
        m.top.response = validationError
        return
    end if

    params = {
        userId: Format.SafeString(request.userId, "")
        fields: "Chapters,Trickplay,Genres,People,MediaSources,MediaStreams,Overview,UserData"
    }

    requestUrl = request.server + "/Items/" + request.itemId + Url.BuildQueryString(params)
    result = HttpClient.Request(requestUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
    if result.ok <> true then
        result.AddReplace("action", "movie")
        result.AddReplace("itemId", Format.SafeString(request.itemId, ""))
        m.top.response = result
        return
    end if

    m.top.response = {
        ok: true
        action: "movie"
        itemId: Format.SafeString(request.itemId, "")
        payload: result.data
    }
end sub
