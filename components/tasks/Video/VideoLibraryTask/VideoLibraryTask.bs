import "pkg:/source/ApiPayload.bs"
import "pkg:/source/JellyfinImage.bs"
import "pkg:/source/String.bs"
import "pkg:/source/Number.bs"
import "pkg:/source/Logger.bs"
import "pkg:/source/LibraryBrowse.bs"
import "pkg:/source/Encode.bs"
import "pkg:/source/Url.bs"
import "pkg:/source/api/HttpClient.bs"
import "pkg:/source/api/JellyfinAuth.bs"
import "pkg:/source/TaskRequest.bs"
import "pkg:/source/Array.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.top.functionName = "executeRequest"
end sub

'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    request = m.top.request
    validationError = TaskRequest.ValidateRequest(request, "videoLibrary", ["userId", "libraryId"])
    if validationError <> invalid then
        if request <> invalid then validationError.AddReplace("libraryId", Strings.ToString(request.libraryId))
        m.top.response = validationError
        return
    end if

    params = {
        userId: Strings.ToString(request.userId)
        parentId: Strings.ToString(request.libraryId)
        recursive: LCase(Strings.ToString(request.collectionType)) <> "playlists"
        includeItemTypes: Strings.ToString(request.includeItemTypes)
        fields: getVideoLibraryFields(request)
        enableImageTypes: Strings.Join([JellyfinImage.Type.Primary, JellyfinImage.Type.Backdrop, JellyfinImage.Type.Thumb, JellyfinImage.Type.Logo])
        imageTypeLimit: 1
        enableTotalRecordCount: true
        sortBy: getSortBy(request)
        sortOrder: getSortOrder(request)
    }
    if request.favoriteOnly = true then params.AddReplace("filters", "IsFavorite")
    if Strings.ToString(request.genre) <> "" then params.AddReplace("genres", request.genre)
    if Type(request.years) = "roArray" and request.years.Count() > 0 then params.AddReplace("years", request.years.Join(","))
    startsWith = Strings.ToString(request.startsWith, "ALL")
    if startsWith <> "" and startsWith <> "ALL" and startsWith <> "#" then
        params.AddReplace("nameStartsWith", startsWith)
    end if

    pageSize = 100
    startIndex = Number.ToInteger(request.pageStartIndex, 0)
    params.AddReplace("startIndex", startIndex)
    params.AddReplace("limit", pageSize)

    requestMode = getVideoLibraryRequestMode(request, startsWith)
    if requestMode = "nonAlphabetic" then
        response = loadNonAlphabeticPage(request, params, startIndex, pageSize)
    else
        if requestMode = "playlist" then
            playlistParams = {
                userId: Strings.ToString(request.userId)
                fields: getVideoLibraryFields(request)
                enableImageTypes: Strings.Join([JellyfinImage.Type.Primary, JellyfinImage.Type.Backdrop, JellyfinImage.Type.Thumb, JellyfinImage.Type.Logo])
                imageTypeLimit: 1
                startIndex: startIndex
                limit: pageSize
                enableTotalRecordCount: true
            }
            requestUrl = request.server + "/Playlists/" + Strings.ToString(request.libraryId) + "/Items" + Url.BuildQueryString(playlistParams)
        else
            requestUrl = request.server + "/Users/" + Strings.ToString(request.userId) + "/Items" + Url.BuildQueryString(params)
        end if
        response = HttpClient.Request(requestUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token), true, getVideoLibraryTimeoutMs(request))
    end if
    if response.ok <> true then
        response.AddReplace("action", "videoLibrary")
        response.AddReplace("libraryId", Strings.ToString(request.libraryId))
        response.AddReplace("queryId", Number.ToInteger(request.queryId, -1))
        m.top.response = response
        return
    end if

    m.top.response = {
        ok: true
        action: "videoLibrary"
        libraryId: Strings.ToString(request.libraryId)
        payload: response.data
        startIndex: startIndex
        nextStartIndex: startIndex + ApiPayload.GetItems(response.data).Count()
        totalRecordCount: getTotalRecordCount(response.data)
        hasMore: hasMorePages(response.data, startIndex, ApiPayload.GetItems(response.data).Count(), pageSize)
        queryId: Number.ToInteger(request.queryId, -1)
    }
end sub

'-------------------------------------------------------------------------------
' getVideoLibraryRequestMode
'-------------------------------------------------------------------------------
function getVideoLibraryRequestMode(request as object, startsWith as string) as string
    collectionType = LCase(Strings.ToString(request.collectionType))
    if startsWith = "#" and collectionType <> "playlist" then return "nonAlphabetic"
    if collectionType = "playlist" then return "playlist"
    return "items"
end function

'-------------------------------------------------------------------------------
' getVideoLibraryTimeoutMs
'-------------------------------------------------------------------------------
function getVideoLibraryTimeoutMs(request as dynamic) as integer
    collectionType = LCase(Strings.ToString(request.collectionType))
    if collectionType = "movies" or collectionType = "tvshows" then return 120000

    return 60000
end function

'-------------------------------------------------------------------------------
' getVideoLibraryFields
'-------------------------------------------------------------------------------
function getVideoLibraryFields(request as dynamic) as string
    fields = "SortName,ProductionYear"
    if request <> invalid and Strings.ToString(request.sortBy) = LibraryBrowse.SortKey.ReleaseDate then fields = fields + ",PremiereDate"
    if request <> invalid and request.detailed = true then
        fields = fields + ",Overview,OfficialRating"
    end if
    return fields
end function

'-------------------------------------------------------------------------------
' loadNonAlphabeticPage
'-------------------------------------------------------------------------------
function loadNonAlphabeticPage(request as object, params as object, startIndex as integer, pageSize as integer) as object
    yearsKey = ""
    if Type(request.years) = "roArray" then yearsKey = request.years.Join(",")
    cacheKey = Strings.ToString(request.libraryId) + "|" + Strings.ToString(request.sortBy) + "|" + Strings.ToString(request.sortOrder) + "|" + Strings.ToString(request.genre) + "|" + yearsKey + "|" + (request.favoriteOnly = true).ToStr() + "|" + (request.detailed = true).ToStr()
    if startIndex = 0 or m.nonAlphabeticCache = invalid or m.nonAlphabeticCache.key <> cacheKey then
        baseParams = {}
        for each key in params
            if LCase(key) <> "startindex" and LCase(key) <> "limit" then baseParams[key] = params[key]
        end for

        lowerParams = {}
        for each key in baseParams
            lowerParams[key] = baseParams[key]
        end for
        lowerParams.AddReplace("nameLessThan", "A")
        lowerUrl = request.server + "/Users/" + Strings.ToString(request.userId) + "/Items" + Url.BuildQueryString(lowerParams)
        lowerResponse = HttpClient.Request(lowerUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token), true, getVideoLibraryTimeoutMs(request))
        if lowerResponse.ok <> true then return lowerResponse

        upperParams = {}
        for each key in baseParams
            upperParams[key] = baseParams[key]
        end for
        upperParams.AddReplace("nameStartsWithOrGreater", "Z")
        upperUrl = request.server + "/Users/" + Strings.ToString(request.userId) + "/Items" + Url.BuildQueryString(upperParams)
        upperResponse = HttpClient.Request(upperUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token), true, getVideoLibraryTimeoutMs(request))
        if upperResponse.ok <> true then return upperResponse

        items = ApiPayload.GetItems(lowerResponse.data)
        for each item in ApiPayload.GetItems(upperResponse.data)
            name = UCase(Strings.ToString(item.Name))
            if name <> "" and Left(name, 1) <> "Z" then items.Push(item)
        end for
        items = sortNonAlphabeticItems(items, Strings.ToString(request.sortBy, LibraryBrowse.SortKey.Title), LibraryBrowse.NormalizeSortOrder(request.sortOrder))
        m.nonAlphabeticCache = { key: cacheKey, items: items }
    end if

    allItems = m.nonAlphabeticCache.items
    pageItems = []
    lastIndex = startIndex + pageSize - 1
    if lastIndex >= allItems.Count() then lastIndex = allItems.Count() - 1
    if startIndex < allItems.Count() then
        for i = startIndex to lastIndex
            pageItems.Push(allItems[i])
        end for
    end if
    return { ok: true, data: { Items: pageItems, TotalRecordCount: allItems.Count() } }
end function

'-------------------------------------------------------------------------------
' sortNonAlphabeticItems
'-------------------------------------------------------------------------------
function sortNonAlphabeticItems(items as object, sortBy as string, sortOrder as string) as object
    entries = []
    for each item in items
        title = LCase(Strings.ToString(item.SortName, Strings.ToString(item.Name)))
        sortValue = title
        if sortBy = LibraryBrowse.SortKey.ReleaseDate then sortValue = Strings.ToString(item.PremiereDate) + "|" + title
        if sortBy = LibraryBrowse.SortKey.DateAdded then sortValue = Strings.ToString(item.DateCreated) + "|" + title
        entries.Push({ item: item, sortKey: sortValue })
    end for
    entries.SortBy("sortKey")
    result = []
    if sortOrder = LibraryBrowse.SortOrder.Descending then
        for i = entries.Count() - 1 to 0 step -1
            result.Push(entries[i].item)
        end for
    else
        for each entry in entries
            result.Push(entry.item)
        end for
    end if
    return result
end function

'-------------------------------------------------------------------------------
' getTotalRecordCount
'-------------------------------------------------------------------------------
function getTotalRecordCount(payload as dynamic) as integer
    if Arrays.IsAssocArray(payload) = false then return -1
    return Number.ToInteger(payload.TotalRecordCount, -1)
end function

'-------------------------------------------------------------------------------
' hasMorePages
'-------------------------------------------------------------------------------
function hasMorePages(payload as dynamic, startIndex as integer, pageCount as integer, pageSize as integer) as boolean
    if pageCount < pageSize then return false
    totalRecordCount = getTotalRecordCount(payload)
    return totalRecordCount < 0 or startIndex + pageCount < totalRecordCount
end function

'-------------------------------------------------------------------------------
' getSortBy
'-------------------------------------------------------------------------------
function getSortBy(request as dynamic) as string
    sortBy = Strings.ToString(request.sortBy)
    if sortBy = LibraryBrowse.SortKey.ReleaseDate then return "PremiereDate,ProductionYear,SortName"
    if sortBy <> "" then return sortBy

    return LibraryBrowse.SortKey.Title
end function

'-------------------------------------------------------------------------------
' getSortOrder
'-------------------------------------------------------------------------------
function getSortOrder(request as dynamic) as string
    sortOrder = Strings.ToString(request.sortOrder)
    if sortOrder = LibraryBrowse.SortOrder.Descending then return LibraryBrowse.SortOrder.Descending

    return LibraryBrowse.SortOrder.Ascending
end function
