'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.log = Logger.Create("VideoLibraryTask")
    m.top.functionName = "executeRequest"
end sub

'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    request = m.top.request
    validationError = validateRequest(request)
    if validationError <> invalid then
        if request <> invalid then validationError.AddReplace("libraryId", Format.SafeString(request.libraryId, ""))
        m.top.response = validationError
        return
    end if

    params = {
        userId: Format.SafeString(request.userId, "")
        parentId: Format.SafeString(request.libraryId, "")
        recursive: LCase(Format.SafeString(request.collectionType, "")) <> "playlists"
        includeItemTypes: Format.SafeString(request.includeItemTypes, "")
        fields: "SortName,ProductionYear,PremiereDate,DateCreated,Genres"
        enableImageTypes: "Primary,Backdrop,Thumb,Logo"
        imageTypeLimit: 1
        enableTotalRecordCount: false
        sortBy: getSortBy(request)
        sortOrder: getSortOrder(request)
    }
    if request.favoriteOnly = true then params.AddReplace("filters", "IsFavorite")

    if LCase(Format.SafeString(request.collectionType, "")) = "playlist" then
        playlistParams = {
            userId: Format.SafeString(request.userId, "")
            fields: "SortName,ProductionYear,PremiereDate,DateCreated,Genres"
            enableImageTypes: "Primary,Backdrop,Thumb,Logo"
            imageTypeLimit: 1
        }
        requestUrl = request.server + "/Playlists/" + Format.SafeString(request.libraryId, "") + "/Items" + Url.BuildQueryString(playlistParams)
    else
        requestUrl = request.server + "/Users/" + Format.SafeString(request.userId, "") + "/Items" + Url.BuildQueryString(params)
    end if
    response = HttpClient.Request(requestUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
    if response.ok <> true then
        response.AddReplace("action", "videoLibrary")
        response.AddReplace("libraryId", Format.SafeString(request.libraryId, ""))
        m.top.response = response
        return
    end if

    m.top.response = {
        ok: true
        action: "videoLibrary"
        libraryId: Format.SafeString(request.libraryId, "")
        payload: response.data
        filterOptions: buildFilterOptions(getItemsFromPayload(response.data))
    }
end sub

'-------------------------------------------------------------------------------
' buildFilterOptions
'-------------------------------------------------------------------------------
function buildFilterOptions(items as object) as object
    filterOptions = {
        decadeOptions: []
        genreOptions: []
    }
    if items = invalid then return filterOptions

    decadeValues = []
    decadeValueByKey = {}
    genreLabels = []
    genreLabelByKey = {}

    for each item in items
        year = getItemVideoLibraryYear(item)
        if year > 0 then
            decade = Number.ToInteger(Fix(year / 10) * 10, 0)
            decadeKey = decade.ToStr()
            if decadeValueByKey[decadeKey] = invalid then
                decadeValueByKey[decadeKey] = decade
                decadeValues.Push(decade)
            end if
        end if

        for each genre in getItemGenres(item)
            genreLabel = Strings.Trim(Format.SafeString(genre, ""))
            if genreLabel = "" then continue for

            genreKey = LCase(genreLabel)
            if genreLabelByKey[genreKey] = invalid then
                genreLabelByKey[genreKey] = genreLabel
                genreLabels.Push(genreLabel)
            end if
        end for
    end for

    decadeValues.Sort()
    for each decade in decadeValues
        decadeKey = decade.ToStr()
        filterOptions.decadeOptions.Push({
            label: decadeKey
            value: decade
        })
    end for

    genreLabels.Sort()
    for each genreLabel in genreLabels
        filterOptions.genreOptions.Push({
            label: genreLabel
            value: genreLabel
        })
    end for

    return filterOptions
end function

'-------------------------------------------------------------------------------
' getItemsFromPayload
'-------------------------------------------------------------------------------
function getItemsFromPayload(payload as dynamic) as object
    if payload = invalid then return []
    if Type(payload) = "roArray" then return payload
    if Arrays.IsAssocArray(payload) = false then return []
    if payload.Items <> invalid then return payload.Items
    return []
end function

'-------------------------------------------------------------------------------
' getItemGenres
'-------------------------------------------------------------------------------
function getItemGenres(item as dynamic) as object
    if Arrays.IsAssocArray(item) = false then return []
    if item.Genres = invalid then return []

    return item.Genres
end function

'-------------------------------------------------------------------------------
' getItemVideoLibraryYear
'-------------------------------------------------------------------------------
function getItemVideoLibraryYear(item as dynamic) as integer
    if Arrays.IsAssocArray(item) = false then return 0

    productionYear = Number.ToInteger(item.ProductionYear, 0)
    if productionYear > 0 then return productionYear

    premiereDate = Format.SafeString(item.PremiereDate, "")
    if Len(premiereDate) < 4 then return 0

    yearText = Left(premiereDate, 4)
    year = Number.ToInteger(yearText, 0)
    if year <= 0 then return 0

    return year
end function

'-------------------------------------------------------------------------------
' validateRequest
'-------------------------------------------------------------------------------
function validateRequest(request as dynamic) as dynamic
    if request = invalid then return { ok: false, action: "videoLibrary", errorMessage: "Invalid video library request." }
    if request.server = invalid or request.server = "" then return { ok: false, action: "videoLibrary", errorMessage: "Invalid video library server." }
    if request.token = invalid or request.token = "" then return { ok: false, action: "videoLibrary", errorMessage: "Invalid video library token." }
    if request.userId = invalid or request.userId = "" then return { ok: false, action: "videoLibrary", errorMessage: "Invalid video library user." }
    if request.libraryId = invalid or request.libraryId = "" then return { ok: false, action: "videoLibrary", errorMessage: "Invalid video library item." }

    return invalid
end function

'-------------------------------------------------------------------------------
' getSortBy
'-------------------------------------------------------------------------------
function getSortBy(request as dynamic) as string
    sortBy = Format.SafeString(request.sortBy, "")
    if sortBy <> "" then return sortBy

    return "SortName"
end function

'-------------------------------------------------------------------------------
' getSortOrder
'-------------------------------------------------------------------------------
function getSortOrder(request as dynamic) as string
    if Format.SafeString(request.sortBy, "") = "Random" then return ""

    sortOrder = Format.SafeString(request.sortOrder, "")
    if sortOrder = "Descending" then return "Descending"

    return "Ascending"
end function
