import "pkg:/source/Format.bs"
import "pkg:/source/String.bs"
import "pkg:/source/Number.bs"
import "pkg:/source/Logger.bs"
import "pkg:/source/Encode.bs"
import "pkg:/source/Url.bs"
import "pkg:/source/api/HttpClient.bs"
import "pkg:/source/api/JellyfinAuth.bs"
import "pkg:/source/TaskRequest.bs"
import "pkg:/source/Array.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.top.functionName = "executeRequest"
end sub

'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    request = m.top.request
    validationError = TaskRequest.ValidateRequest(request, "videoLibrary", ["userId", "libraryId"])
    if validationError <> invalid then
        if request <> invalid then validationError.AddReplace("libraryId", Format.SafeString(request.libraryId, ""))
        m.top.response = validationError
        return
    end if

    params = {
        userId: Format.SafeString(request.userId, "")
        parentId: Format.SafeString(request.libraryId, "")
        recursive: LCase(Format.SafeString(request.collectionType, "")) <> "playlists"
        includeItemTypes: Format.SafeString(request.includeItemTypes, "")
        fields: "SortName,ProductionYear,PremiereDate,DateCreated,Genres"
        enableImageTypes: "Primary,Backdrop,Thumb,Logo"
        imageTypeLimit: 1
        enableTotalRecordCount: true
        sortBy: getSortBy(request)
        sortOrder: getSortOrder(request)
    }
    if request.favoriteOnly = true then params.AddReplace("filters", "IsFavorite")
    if Format.SafeString(request.genre, "") <> "" then params.AddReplace("genres", request.genre)
    if Type(request.years) = "roArray" and request.years.Count() > 0 then params.AddReplace("years", request.years.Join(","))
    startsWith = Format.SafeString(request.startsWith, "ALL")
    if startsWith <> "" and startsWith <> "ALL" and startsWith <> "#" then
        params.AddReplace("nameStartsWith", startsWith)
    end if

    pageSize = 100
    startIndex = Number.ToInteger(request.pageStartIndex, 0)
    params.AddReplace("startIndex", startIndex)
    params.AddReplace("limit", pageSize)

    requestMode = getVideoLibraryRequestMode(request, startsWith)
    if requestMode = "nonAlphabetic" then
        response = loadNonAlphabeticPage(request, params, startIndex, pageSize)
    else
        if requestMode = "playlist" then
            playlistParams = {
                userId: Format.SafeString(request.userId, "")
                fields: "SortName,ProductionYear,PremiereDate,DateCreated,Genres"
                enableImageTypes: "Primary,Backdrop,Thumb,Logo"
                imageTypeLimit: 1
                startIndex: startIndex
                limit: pageSize
                enableTotalRecordCount: true
            }
            requestUrl = request.server + "/Playlists/" + Format.SafeString(request.libraryId, "") + "/Items" + Url.BuildQueryString(playlistParams)
        else
            requestUrl = request.server + "/Users/" + Format.SafeString(request.userId, "") + "/Items" + Url.BuildQueryString(params)
        end if
        response = HttpClient.Request(requestUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
    end if
    if response.ok <> true then
        response.AddReplace("action", "videoLibrary")
        response.AddReplace("libraryId", Format.SafeString(request.libraryId, ""))
        response.AddReplace("queryId", Number.ToInteger(request.queryId, -1))
        m.top.response = response
        return
    end if

    m.top.response = {
        ok: true
        action: "videoLibrary"
        libraryId: Format.SafeString(request.libraryId, "")
        payload: response.data
        startIndex: startIndex
        nextStartIndex: startIndex + getItemsFromPayload(response.data).Count()
        totalRecordCount: getTotalRecordCount(response.data)
        hasMore: hasMorePages(response.data, startIndex, getItemsFromPayload(response.data).Count(), pageSize)
        queryId: Number.ToInteger(request.queryId, -1)
    }
end sub

'-------------------------------------------------------------------------------
' getVideoLibraryRequestMode
'-------------------------------------------------------------------------------
function getVideoLibraryRequestMode(request as object, startsWith as string) as string
    collectionType = LCase(Format.SafeString(request.collectionType, ""))
    if startsWith = "#" and collectionType <> "playlist" then return "nonAlphabetic"
    if collectionType = "playlist" then return "playlist"
    return "items"
end function

'-------------------------------------------------------------------------------
' loadNonAlphabeticPage
'-------------------------------------------------------------------------------
function loadNonAlphabeticPage(request as object, params as object, startIndex as integer, pageSize as integer) as object
    yearsKey = ""
    if Type(request.years) = "roArray" then yearsKey = request.years.Join(",")
    cacheKey = Format.SafeString(request.libraryId, "") + "|" + Format.SafeString(request.sortBy, "") + "|" + Format.SafeString(request.sortOrder, "") + "|" + Format.SafeString(request.genre, "") + "|" + yearsKey + "|" + (request.favoriteOnly = true).ToStr()
    if startIndex = 0 or m.nonAlphabeticCache = invalid or m.nonAlphabeticCache.key <> cacheKey then
        baseParams = {}
        for each key in params
            if LCase(key) <> "startindex" and LCase(key) <> "limit" then baseParams[key] = params[key]
        end for

        lowerParams = {}
        for each key in baseParams
            lowerParams[key] = baseParams[key]
        end for
        lowerParams.AddReplace("nameLessThan", "A")
        lowerUrl = request.server + "/Users/" + Format.SafeString(request.userId, "") + "/Items" + Url.BuildQueryString(lowerParams)
        lowerResponse = HttpClient.Request(lowerUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
        if lowerResponse.ok <> true then return lowerResponse

        upperParams = {}
        for each key in baseParams
            upperParams[key] = baseParams[key]
        end for
        upperParams.AddReplace("nameStartsWithOrGreater", "Z")
        upperUrl = request.server + "/Users/" + Format.SafeString(request.userId, "") + "/Items" + Url.BuildQueryString(upperParams)
        upperResponse = HttpClient.Request(upperUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
        if upperResponse.ok <> true then return upperResponse

        items = getItemsFromPayload(lowerResponse.data)
        for each item in getItemsFromPayload(upperResponse.data)
            name = UCase(Format.SafeString(item.Name, ""))
            if name <> "" and Left(name, 1) <> "Z" then items.Push(item)
        end for
        items = sortNonAlphabeticItems(items, Format.SafeString(request.sortBy, "SortName"), Format.SafeString(request.sortOrder, "Ascending"))
        m.nonAlphabeticCache = { key: cacheKey, items: items }
    end if

    allItems = m.nonAlphabeticCache.items
    pageItems = []
    lastIndex = startIndex + pageSize - 1
    if lastIndex >= allItems.Count() then lastIndex = allItems.Count() - 1
    if startIndex < allItems.Count() then
        for i = startIndex to lastIndex
            pageItems.Push(allItems[i])
        end for
    end if
    return { ok: true, data: { Items: pageItems, TotalRecordCount: allItems.Count() } }
end function

'-------------------------------------------------------------------------------
' sortNonAlphabeticItems
'-------------------------------------------------------------------------------
function sortNonAlphabeticItems(items as object, sortBy as string, sortOrder as string) as object
    entries = []
    for each item in items
        title = LCase(Format.SafeString(item.SortName, Format.SafeString(item.Name, "")))
        sortValue = title
        if sortBy = "PremiereDate" then sortValue = Format.SafeString(item.PremiereDate, "") + "|" + title
        if sortBy = "DateCreated" then sortValue = Format.SafeString(item.DateCreated, "") + "|" + title
        entries.Push({ item: item, sortKey: sortValue })
    end for
    entries.SortBy("sortKey")
    result = []
    if sortOrder = "Descending" then
        for i = entries.Count() - 1 to 0 step -1
            result.Push(entries[i].item)
        end for
    else
        for each entry in entries
            result.Push(entry.item)
        end for
    end if
    return result
end function

'-------------------------------------------------------------------------------
' getTotalRecordCount
'-------------------------------------------------------------------------------
function getTotalRecordCount(payload as dynamic) as integer
    if Arrays.IsAssocArray(payload) = false then return -1
    return Number.ToInteger(payload.TotalRecordCount, -1)
end function

'-------------------------------------------------------------------------------
' hasMorePages
'-------------------------------------------------------------------------------
function hasMorePages(payload as dynamic, startIndex as integer, pageCount as integer, pageSize as integer) as boolean
    if pageCount < pageSize then return false
    totalRecordCount = getTotalRecordCount(payload)
    return totalRecordCount < 0 or startIndex + pageCount < totalRecordCount
end function

'-------------------------------------------------------------------------------
' buildFilterOptions
'-------------------------------------------------------------------------------
function buildFilterOptions(items as object) as object
    filterOptions = {
        decadeOptions: []
        genreOptions: []
    }
    if items = invalid then return filterOptions

    decadeValues = []
    decadeValueByKey = {}
    genreLabels = []
    genreLabelByKey = {}

    for each item in items
        year = getItemVideoLibraryYear(item)
        if year > 0 then
            decade = Number.ToInteger(Fix(year / 10) * 10, 0)
            decadeKey = decade.ToStr()
            if decadeValueByKey[decadeKey] = invalid then
                decadeValueByKey[decadeKey] = decade
                decadeValues.Push(decade)
            end if
        end if

        for each genre in getItemGenres(item)
            genreLabel = Strings.Trim(Format.SafeString(genre, ""))
            if genreLabel = "" then continue for

            genreKey = LCase(genreLabel)
            if genreLabelByKey[genreKey] = invalid then
                genreLabelByKey[genreKey] = genreLabel
                genreLabels.Push(genreLabel)
            end if
        end for
    end for

    decadeValues.Sort()
    for each decade in decadeValues
        decadeKey = decade.ToStr()
        filterOptions.decadeOptions.Push({
            label: decadeKey
            value: decade
        })
    end for

    genreLabels.Sort()
    for each genreLabel in genreLabels
        filterOptions.genreOptions.Push({
            label: genreLabel
            value: genreLabel
        })
    end for

    return filterOptions
end function

'-------------------------------------------------------------------------------
' getItemsFromPayload
'-------------------------------------------------------------------------------
function getItemsFromPayload(payload as dynamic) as object
    if payload = invalid then return []
    if Type(payload) = "roArray" then return payload
    if Arrays.IsAssocArray(payload) = false then return []
    if payload.Items <> invalid then return payload.Items
    return []
end function

'-------------------------------------------------------------------------------
' getItemGenres
'-------------------------------------------------------------------------------
function getItemGenres(item as dynamic) as object
    if Arrays.IsAssocArray(item) = false then return []
    if item.Genres = invalid then return []

    return item.Genres
end function

'-------------------------------------------------------------------------------
' getItemVideoLibraryYear
'-------------------------------------------------------------------------------
function getItemVideoLibraryYear(item as dynamic) as integer
    if Arrays.IsAssocArray(item) = false then return 0

    productionYear = Number.ToInteger(item.ProductionYear, 0)
    if productionYear > 0 then return productionYear

    premiereDate = Format.SafeString(item.PremiereDate, "")
    if Len(premiereDate) < 4 then return 0

    yearText = Left(premiereDate, 4)
    year = Number.ToInteger(yearText, 0)
    if year <= 0 then return 0

    return year
end function


'-------------------------------------------------------------------------------
' getSortBy
'-------------------------------------------------------------------------------
function getSortBy(request as dynamic) as string
    sortBy = Format.SafeString(request.sortBy, "")
    if sortBy <> "" then return sortBy

    return "SortName"
end function

'-------------------------------------------------------------------------------
' getSortOrder
'-------------------------------------------------------------------------------
function getSortOrder(request as dynamic) as string
    sortOrder = Format.SafeString(request.sortOrder, "")
    if sortOrder = "Descending" then return "Descending"

    return "Ascending"
end function
