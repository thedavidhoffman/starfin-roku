import "pkg:/source/String.bs"
import "pkg:/source/Logger.bs"
import "pkg:/source/Encode.bs"
import "pkg:/source/Url.bs"
import "pkg:/source/api/HttpClient.bs"
import "pkg:/source/api/JellyfinAuth.bs"
import "pkg:/source/TaskRequest.bs"
import "pkg:/source/Array.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.log = new Logger("ThemeSongsTask", m.global.logService)
    m.top.functionName = "executeRequest"
end sub

'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    request = m.top.request
    validationError = TaskRequest.ValidateRequest(request, "themeSongs", ["itemId"])
    if validationError <> invalid then
        m.top.response = validationError
        return
    end if

    params = {
        UserId: Strings.ToString(request.userId)
        EnableTotalRecordCount: false
    }
    requestUrl = request.server + "/Items/" + Strings.ToString(request.itemId) + "/ThemeSongs" + Url.BuildQueryString(params)
    result = HttpClient.Request(requestUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
    if result.ok <> true then
        result.AddReplace("action", "themeSongs")
        m.top.response = result
        return
    end if

    items = getPayloadItems(result.data)
    themeSong = getFirstThemeSongFromItems(items)
    m.log.write("ThemeSongs response itemId=" + Strings.ToString(request.itemId) + " count=" + items.Count().ToStr() + " selectedThemeSongId=" + getThemeSongId(themeSong))
    m.top.response = {
        ok: true
        action: "themeSongs"
        itemId: Strings.ToString(request.itemId)
        payload: themeSong
    }
end sub

'-------------------------------------------------------------------------------
' getFirstThemeSongFromItems
'-------------------------------------------------------------------------------
function getFirstThemeSongFromItems(items as object) as dynamic
    if items.Count() = 0 then return invalid

    for each item in items
        if Arrays.IsAssocArray(item) then return item
    end for

    return invalid
end function

'-------------------------------------------------------------------------------
' getThemeSongId
'-------------------------------------------------------------------------------
function getThemeSongId(item as dynamic) as string
    if Arrays.IsAssocArray(item) = false then return ""

    return Strings.ToString(item.Id)
end function

'-------------------------------------------------------------------------------
' getPayloadItems
'-------------------------------------------------------------------------------
function getPayloadItems(payload as dynamic) as object
    if payload = invalid then return []
    if Type(payload) = "roArray" then return payload
    if Arrays.IsAssocArray(payload) = false then return []
    if payload.Items <> invalid then return payload.Items

    return []
end function
