import "pkg:/source/Format.bs"
import "pkg:/source/String.bs"
import "pkg:/source/Logger.bs"
import "pkg:/source/Number.bs"
import "pkg:/source/PlaybackProgress.bs"
import "pkg:/source/PlaybackMode.bs"
import "pkg:/source/PlaybackRequest.bs"
import "pkg:/source/Encode.bs"
import "pkg:/source/Json.bs"
import "pkg:/source/DeviceCapabilities.bs"
import "pkg:/source/SubtitlePlayback.bs"
import "pkg:/source/SubtitleSelection.bs"
import "pkg:/source/SubtitleBurnIn.bs"
import "pkg:/source/Url.bs"
import "pkg:/source/api/HttpClient.bs"
import "pkg:/source/api/JellyfinAuth.bs"
import "pkg:/source/TaskRequest.bs"
import "pkg:/components/tasks/Video/VideoPlaybackInfoTask/Helpers/PlaybackIdentity.bs"
import "pkg:/components/tasks/Video/VideoPlaybackInfoTask/Helpers/PlaybackLogging.bs"
import "pkg:/components/tasks/Video/VideoPlaybackInfoTask/Helpers/StreamSelection.bs"
import "pkg:/components/tasks/Video/VideoPlaybackInfoTask/Helpers/PlaybackRequest.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.log = new Logger("VideoPlaybackInfoTask", m.global.logService)
    m.top.functionName = "executeRequest"
end sub
'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    request = m.top.request
    requestId = getPlaybackRequestId(request)
    validationError = TaskRequest.ValidateRequest(request, "playbackInfo", ["itemId"])
    if validationError <> invalid then
        validationError.AddReplace("requestId", requestId)
        m.top.response = validationError
        return
    end if

    requestedAudioStreamIndex = getPlaybackRequestAudioStreamIndex(request)
    requestedSubtitleStreamIndex = getPlaybackRequestSubtitleStreamIndex(request)
    displaySize = DeviceCapabilities.GetDisplaySize()
    requestedMediaSourceId = getPlaybackRequestMediaSourceId(request)
    requestedAudioStream = getPlaybackRequestMediaStream(request, requestedAudioStreamIndex)
    requestedMediaSource = getPlaybackRequestMediaSource(request)
    resolvedRequestedSubtitleIndex = getExistingSubtitleStreamIndex(requestedMediaSource, requestedSubtitleStreamIndex)
    subtitleBurnInMode = SubtitleBurnIn.Normalize(request.subtitleBurnInMode)
    alwaysBurnSelectedSubtitle = subtitleBurnInMode = SubtitleBurnIn.Mode.Always and resolvedRequestedSubtitleIndex >= 0
    forceTranscode = shouldForceTranscodeAudio(requestedAudioStream, requestedMediaSource)
    forceStreamSelection = shouldForceStreamSelection(request, requestedMediaSource, requestedAudioStreamIndex)
    forceSubtitleSelection = requestedSubtitleStreamIndex >= 0
    selectedPlaybackMode = getPlaybackMode(request)
    playbackFlags = getPlaybackFlags(selectedPlaybackMode, forceTranscode, forceStreamSelection, forceSubtitleSelection)
    if alwaysBurnSelectedSubtitle then
        playbackFlags.enableDirectPlay = false
        playbackFlags.enableDirectStream = false
        playbackFlags.enableTranscoding = true
    end if
    bitrateLimits = DeviceCapabilities.GetBitrateLimits()
    params = {
        UserId: Format.SafeString(request.userId, "")
        StartTimeTicks: getStartPositionTicks(request)
        IsPlayback: true
        AutoOpenLiveStream: true
        MaxStreamingBitrate: bitrateLimits.maxStreaming
        MaxStaticBitrate: bitrateLimits.maxStatic
        EnableDirectPlay: playbackFlags.enableDirectPlay
        EnableDirectStream: playbackFlags.enableDirectStream
        EnableTranscoding: playbackFlags.enableTranscoding
        AllowVideoStreamCopy: alwaysBurnSelectedSubtitle <> true and selectedPlaybackMode <> PlaybackMode.Mode.AutomaticNoRemux and selectedPlaybackMode <> PlaybackMode.Mode.TranscodeNoRemux
        AllowAudioStreamCopy: true
    }

    if (selectedPlaybackMode = PlaybackMode.Mode.Automatic or selectedPlaybackMode = PlaybackMode.Mode.AutomaticNoRemux) and forceTranscode = true then logForcedTranscodeReason(requestedAudioStream)
    if (selectedPlaybackMode = PlaybackMode.Mode.Automatic or selectedPlaybackMode = PlaybackMode.Mode.AutomaticNoRemux) and forceStreamSelection = true then logForcedStreamSelection(requestedAudioStream)
    m.log.write("Device profile display cap width=" + Format.SafeString(displaySize.width, "") + " height=" + Format.SafeString(displaySize.height, "") + " source=" + Format.SafeString(displaySize.source, ""))
    m.log.write("Requested streams audioStreamIndex=" + Format.SafeString(requestedAudioStreamIndex, "") + " subtitleStreamIndex=" + Format.SafeString(requestedSubtitleStreamIndex, ""))
    m.log.write("Requested video mode=" + selectedPlaybackMode)
    if requestedMediaSourceId <> "" then params.MediaSourceId = requestedMediaSourceId
    if requestedAudioStreamIndex >= 0 then params.AudioStreamIndex = requestedAudioStreamIndex
    if requestedSubtitleStreamIndex >= -1 then params.SubtitleStreamIndex = requestedSubtitleStreamIndex

    requestUrl = request.server + "/Items/" + request.itemId + "/PlaybackInfo" + Url.BuildQueryString(params)
    alwaysBurnInSubtitleWhenTranscoding = shouldAlwaysBurnSubtitleWhenTranscoding(subtitleBurnInMode, requestedSubtitleStreamIndex)
    body = buildPlaybackInfoBody(alwaysBurnInSubtitleWhenTranscoding, alwaysBurnSelectedSubtitle <> true)
    m.log.write("Subtitle burn-in mode=" + subtitleBurnInMode + " activeSubtitle=" + boolToText(resolvedRequestedSubtitleIndex >= 0) + " alwaysBurnInSubtitleWhenTranscoding=" + boolToText(alwaysBurnInSubtitleWhenTranscoding))
    logPlaybackRequest(request, body)

    result = HttpClient.Request(requestUrl, "POST", invalid, body, JellyfinAuth.BuildTokenHeaders(request.token))
    if result.ok <> true then
        logPlaybackError(result)
        result.AddReplace("action", "playbackInfo")
        result.AddReplace("requestId", requestId)
        m.top.response = result
        return
    end if

    logPlaybackResponse(result.data)

    streamInfo = buildStreamInfo(request, result.data, requestedAudioStreamIndex, requestedSubtitleStreamIndex, playbackFlags)
    if streamInfo.ok <> true then
        m.log.error(streamInfo.errorMessage)
        streamInfo.AddReplace("requestId", requestId)
        m.top.response = streamInfo
        return
    end if

    m.log.write("Selected stream URL: " + PlaybackRequest.MaskUrl(streamInfo.streamUrl))

    externalSubtitleTrack = SubtitlePlayback.BuildExternalTrack(result.data, streamInfo.subtitleStreamIndex, request.server, request.token)
    externalSubtitleTracks = SubtitlePlayback.BuildExternalTracks(result.data, request.server, request.token)
    subtitleDeliveryMethod = SubtitlePlayback.GetDeliveryMethod(result.data, streamInfo.subtitleStreamIndex)
    if subtitleDeliveryMethod = "" then subtitleDeliveryMethod = "none"
    m.log.write("Resolved subtitle stream index=" + Format.SafeString(streamInfo.subtitleStreamIndex, "") + " deliveryMethod=" + subtitleDeliveryMethod + " externalTrackAttached=" + boolToText(externalSubtitleTrack <> invalid))

    m.top.response = {
        ok: true
        action: "playbackInfo"
        requestId: requestId
        payload: result.data
        item: request.item
        streamUrl: streamInfo.streamUrl
        streamFormat: streamInfo.streamFormat
        playSessionId: streamInfo.playSessionId
        playbackIdentity: buildPlaybackIdentity(request, streamInfo, PlaybackRequest.FirstMediaSource(result.data))
        startPositionTicks: getStartPositionTicks(request)
        externalSubtitleTrack: externalSubtitleTrack
        externalSubtitleTracks: externalSubtitleTracks
        subtitleDeliveryMethod: subtitleDeliveryMethod
    }
end sub
