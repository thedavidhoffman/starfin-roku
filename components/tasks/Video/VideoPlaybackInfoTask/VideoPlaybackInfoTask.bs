import "pkg:/source/api/JellyfinPlaybackItem.bs"
import "pkg:/source/RemotePlayback.bs"
import "pkg:/source/MediaItem.bs"
import "pkg:/source/String.bs"
import "pkg:/source/Logger.bs"
import "pkg:/source/Number.bs"
import "pkg:/source/PlaybackProgress.bs"
import "pkg:/source/PlaybackMode.bs"
import "pkg:/source/PlaybackRequest.bs"
import "pkg:/source/PlaybackResponse.bs"
import "pkg:/source/MovieVersions.bs"
import "pkg:/source/api/JellyfinMovie.bs"
import "pkg:/source/Encode.bs"
import "pkg:/source/Json.bs"
import "pkg:/source/DeviceCapabilities.bs"
import "pkg:/source/SubtitlePlayback.bs"
import "pkg:/source/SubtitleSelection.bs"
import "pkg:/source/SubtitleBurnIn.bs"
import "pkg:/source/Url.bs"
import "pkg:/source/api/HttpClient.bs"
import "pkg:/source/api/JellyfinAuth.bs"
import "pkg:/source/TaskRequest.bs"
import "pkg:/components/tasks/Video/VideoPlaybackInfoTask/Helpers/PlaybackResolution.bs"
import "pkg:/components/tasks/Video/VideoPlaybackInfoTask/Helpers/PlaybackLogging.bs"
import "pkg:/components/tasks/Video/VideoPlaybackInfoTask/Helpers/StreamSelection.bs"
import "pkg:/components/tasks/Video/VideoPlaybackInfoTask/Helpers/PlaybackRequest.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.log = new Logger("VideoPlaybackInfoTask", m.global.logService)
    m.top.functionName = "executeRequest"
end sub
'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    request = m.top.request
    validationError = TaskRequest.ValidateRequest(request, "playbackInfo", ["itemId"])
    if validationError <> invalid then
        m.top.response = PlaybackResponse.Failure(request, validationError)
        return
    end if

    request = PlaybackRequest.Create(request)
    if request.loadItemDetails = true then
        itemResult = JellyfinPlaybackItem.Load(request)
        if itemResult.ok <> true then
            m.top.response = PlaybackResponse.Failure(request, itemResult)
            return
        end if
        loadedItem = itemResult.data
        if RemotePlayback.BuildSelection(loadedItem) = invalid or Strings.ToString(loadedItem.Id) <> Strings.ToString(request.itemId) or loadedItem.Type <> request.item.Type then
            m.top.response = PlaybackResponse.Failure(request, { errorMessage: "The selected media item is no longer available." })
            return
        end if
        request.item = loadedItem
        request.Delete("loadItemDetails")
        if loadedItem.Type <> MediaItem.Type.Movie then request.startPositionTicks = PlaybackProgress.GetTicksFromItem(loadedItem)
    end if
    if request.movieVersions = invalid then
        versions = MovieVersions.Create(request.item)
        if versions <> invalid then
            sourceId = Strings.ToString(request.mediaSourceId, versions.selectedSourceId)
            if MovieVersions.FindSource(versions, sourceId) = invalid then
                m.top.response = PlaybackResponse.Failure(request, { errorMessage: "The selected media source is no longer available." })
                return
            end if
            versionResult = JellyfinMovie.Load({ server: request.server, token: request.token, userId: request.userId, itemId: sourceId })
            if versionResult.ok <> true then
                m.top.response = PlaybackResponse.Failure(request, versionResult)
                return
            end if
            if versionResult.data = invalid or Strings.ToString(versionResult.data.Id) <> sourceId then
                m.top.response = PlaybackResponse.Failure(request, { errorMessage: "Unable to load this movie version." })
                return
            end if
            versions = MovieVersions.CacheDetails(versions, sourceId, versionResult.data)
            request.movieVersions = MovieVersions.Select(versions, sourceId)
            request.mediaSourceId = sourceId
            request.item = MovieVersions.GetSelectedItem(request.movieVersions)
        end if
    end if

    negotiation = negotiatePlaybackInfo(request)
    result = negotiation.result
    if result.ok <> true then
        logPlaybackError(result)
        m.top.response = PlaybackResponse.Failure(request, result)
        return
    end if

    mediaSource = PlaybackRequest.FirstMediaSource(result.data, Strings.ToString(request.mediaSourceId))
    if mediaSource = invalid then
        failPlaybackNegotiation(request, { errorMessage: "The selected media source is no longer available." }, PlaybackRequest.FirstMediaSource(result.data))
        return
    end if
    result.data.MediaSources = [mediaSource]
    if negotiation.subtitleIndex = SubtitleSelection.NotSet and mediaSource <> invalid then
        defaultIndex = getExistingSubtitleStreamIndex(mediaSource, Number.ToInteger(mediaSource.DefaultSubtitleStreamIndex, SubtitleSelection.None))
        negotiation.subtitleIndex = defaultIndex
        if defaultIndex >= 0 then
            ' Negotiate delivery using the server's choice without changing the viewer's intent.
            followup = PlaybackRequest.WithChanges(request, {
                subtitleStreamIndex: defaultIndex
                audioStreamIndex: getResolvedAudioStreamIndex(mediaSource, negotiation.audioIndex)
                mediaSourceId: Strings.ToString(mediaSource.Id)
                liveStreamId: Strings.ToString(mediaSource.LiveStreamId)
            })
            followup.item = buildSelectedSourceItem(request, mediaSource)
            negotiation = negotiatePlaybackInfo(followup)
            result = negotiation.result
            if result.ok <> true then
                logPlaybackError(result)
                failPlaybackNegotiation(request, result, mediaSource)
                return
            end if
            finalSource = PlaybackRequest.FirstMediaSource(result.data, followup.mediaSourceId)
            if finalSource = invalid or Strings.ToString(finalSource.Id) <> followup.mediaSourceId then
                failPlaybackNegotiation(request, { errorMessage: "Subtitle negotiation changed the selected media source." }, mediaSource)
                return
            end if
            if getExistingSubtitleStreamIndex(finalSource, defaultIndex) <> defaultIndex then
                failPlaybackNegotiation(request, { errorMessage: "The selected subtitle is no longer available." }, mediaSource)
                return
            end if
            result.data.MediaSources = [finalSource]
        end if
    end if
    requestedAudioStreamIndex = negotiation.audioIndex
    requestedSubtitleStreamIndex = negotiation.subtitleIndex
    playbackFlags = negotiation.flags
    alwaysBurnInSubtitleWhenTranscoding = negotiation.burnDuringTranscoding
    logPlaybackResponse(result.data)

    streamInfo = buildStreamInfo(request, result.data, requestedAudioStreamIndex, requestedSubtitleStreamIndex, playbackFlags)
    if streamInfo.ok <> true then
        m.log.error(streamInfo.errorMessage)
        failPlaybackNegotiation(request, streamInfo, mediaSource)
        return
    end if

    m.log.write("Selected stream URL: " + PlaybackRequest.MaskUrl(streamInfo.streamUrl))

    externalSubtitleTracks = SubtitlePlayback.BuildExternalTracks(result.data, request.server)
    if shouldUseEncodedSubtitleDelivery(alwaysBurnInSubtitleWhenTranscoding, streamInfo.playbackMethod, streamInfo.subtitleStreamIndex) then
        externalSubtitleTrack = invalid
        subtitleDeliveryMethod = "encode"
    else
        externalSubtitleTrack = SubtitlePlayback.BuildExternalTrack(result.data, streamInfo.subtitleStreamIndex, request.server)
        subtitleDeliveryMethod = SubtitlePlayback.GetDeliveryMethod(result.data, streamInfo.subtitleStreamIndex)
        if subtitleDeliveryMethod = "" then subtitleDeliveryMethod = "none"
    end if
    m.log.write("Resolved subtitle stream index=" + Strings.ToString(streamInfo.subtitleStreamIndex) + " deliveryMethod=" + subtitleDeliveryMethod + " externalTrackAttached=" + boolToText(externalSubtitleTrack <> invalid))

    resolvedItem = buildSelectedSourceItem(request, PlaybackRequest.FirstMediaSource(result.data))
    responseData = {
        payload: result.data
        item: resolvedItem
        streamUrl: streamInfo.streamUrl
        streamFormat: streamInfo.streamFormat
        playSessionId: streamInfo.playSessionId
        startPositionTicks: getStartPositionTicks(request)
        externalSubtitleTrack: externalSubtitleTrack
        externalSubtitleTracks: externalSubtitleTracks
        subtitleDeliveryMethod: subtitleDeliveryMethod
    }
    playbackResolution = buildPlaybackResolution(request, streamInfo, PlaybackRequest.FirstMediaSource(result.data))
    if request.movieVersions <> invalid then responseData.movieVersions = MovieVersions.CacheDetails(request.movieVersions, streamInfo.mediaSourceId, resolvedItem)
    for each key in playbackResolution
        responseData[key] = playbackResolution[key]
    end for
    m.top.response = PlaybackResponse.Success(request, responseData)
end sub
