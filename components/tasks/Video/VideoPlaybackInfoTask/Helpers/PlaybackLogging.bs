import "pkg:/source/Format.bs"
import "pkg:/source/String.bs"
'-------------------------------------------------------------------------------
' boolToText
'-------------------------------------------------------------------------------
function boolToText(value as dynamic) as string
    if value = true then return "true"
    if value = false then return "false"
    return ""
end function

'-------------------------------------------------------------------------------
' logPlaybackRequest
'-------------------------------------------------------------------------------
sub logPlaybackRequest(request as object, body as string)
    itemName = ""
    if request.item <> invalid then itemName = Format.FirstNonEmpty([request.item.Name], "")

    m.log.write("PlaybackInfo request itemId=" + Strings.ToString(request.itemId) + " title=" + itemName)
    m.log.writeJson(body, 2, "PlaybackInfo request body:")
end sub

'-------------------------------------------------------------------------------
' logPlaybackError
'-------------------------------------------------------------------------------
sub logPlaybackError(result as object)
    status = Strings.ToString(result.status)
    m.log.error("PlaybackInfo failed status=" + status)
    m.log.writeConsoleOnly("PlaybackInfo failure detail status=" + status + " message=" + Strings.ToString(result.errorMessage))

    responseText = Strings.ToString(result.responseText)
    if responseText <> "" then
        m.log.writeConsoleOnly("PlaybackInfo error response:")
        m.log.writeJsonConsoleOnly(responseText, 2)
    end if
end sub

'-------------------------------------------------------------------------------
' logPlaybackResponse
'-------------------------------------------------------------------------------
sub logPlaybackResponse(playbackInfo as dynamic)
    if playbackInfo = invalid then
        m.log.write("PlaybackInfo response parsed as invalid.")
        return
    end if

    mediaSource = PlaybackRequest.FirstMediaSource(playbackInfo)
    m.log.write("PlaybackInfo response PlaySessionId=" + Strings.ToString(playbackInfo.PlaySessionId))

    if mediaSource = invalid then
        m.log.write("PlaybackInfo response has no media source.")
        return
    end if

    m.log.write("PlaybackInfo media source Id=" + Strings.ToString(mediaSource.Id) + " Protocol=" + Strings.ToString(mediaSource.Protocol) + " Container=" + Strings.ToString(mediaSource.Container))
    m.log.write("PlaybackInfo media source Path=" + PlaybackRequest.MaskUrl(mediaSource.Path))
    m.log.write("PlaybackInfo SupportsDirectPlay=" + boolToText(mediaSource.SupportsDirectPlay) + " SupportsDirectStream=" + boolToText(mediaSource.SupportsDirectStream) + " SupportsTranscoding=" + boolToText(mediaSource.SupportsTranscoding))
    m.log.write("PlaybackInfo TranscodingUrl=" + PlaybackRequest.MaskUrl(mediaSource.TranscodingUrl))

    if mediaSource.MediaStreams <> invalid then
        for each stream in mediaSource.MediaStreams
            streamType = Strings.ToString(stream.Type)
            if LCase(streamType) = "audio" or LCase(streamType) = "video" then
                m.log.write("PlaybackInfo stream Type=" + streamType + " Index=" + Strings.ToString(stream.Index) + " Codec=" + Strings.ToString(stream.Codec) + " Channels=" + Strings.ToString(stream.Channels) + " Default=" + boolToText(stream.IsDefault))
            end if
        end for
    end if
end sub

'-------------------------------------------------------------------------------
' logForcedTranscodeReason
'-------------------------------------------------------------------------------
sub logForcedTranscodeReason(stream as dynamic)
    if stream = invalid then
        m.log.write("Forcing audio transcode; stream metadata unavailable.")
        return
    end if
    m.log.write("Forcing transcode because selected multichannel AAC audio is not device-decodable. Index=" + Strings.ToString(stream.arrayIndex) + " Channels=" + Strings.ToString(stream.Channels) + " Title=" + Format.FirstNonEmpty([stream.DisplayTitle, stream.Title], ""))
end sub

'-------------------------------------------------------------------------------
' logForcedStreamSelection
'-------------------------------------------------------------------------------
sub logForcedStreamSelection(stream as dynamic)
    if stream = invalid then
        m.log.write("Disabling direct play for explicit audio selection; stream metadata unavailable.")
        return
    end if
    m.log.write("Disabling direct play because a non-default audio stream was selected. Index=" + Strings.ToString(stream.Index) + " Title=" + Format.FirstNonEmpty([stream.DisplayTitle, stream.Title], ""))
end sub
