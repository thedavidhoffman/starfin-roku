'-------------------------------------------------------------------------------
' buildPlaybackInfoBody
'-------------------------------------------------------------------------------
function buildPlaybackInfoBody(alwaysBurnInSubtitleWhenTranscoding as boolean, includeSubtitleProfiles as boolean) as string
    return Json.Object([
        Json.String("DeviceProfile") + ":" + DeviceCapabilities.BuildDeviceProfileJson(includeSubtitleProfiles)
        Json.BooleanPair("AlwaysBurnInSubtitleWhenTranscoding", alwaysBurnInSubtitleWhenTranscoding)
    ])
end function

'-------------------------------------------------------------------------------
' shouldAlwaysBurnSubtitleWhenTranscoding
'-------------------------------------------------------------------------------
function shouldAlwaysBurnSubtitleWhenTranscoding(subtitleBurnInMode as string, requestedSubtitleStreamIndex as integer) as boolean
    return requestedSubtitleStreamIndex >= 0 and subtitleBurnInMode <> SubtitleBurnIn.Mode.PreferExternal
end function

'-------------------------------------------------------------------------------
' isLiveTvPlaybackRequest
'-------------------------------------------------------------------------------
function isLiveTvPlaybackRequest(request as dynamic) as boolean
    if request = invalid or request.item = invalid then return false

    itemType = LCase(Format.SafeString(request.item.Type, ""))
    return itemType = "tvchannel" or itemType = "livetvchannel"
end function

'-------------------------------------------------------------------------------
' isHttpDirectMediaSource
'-------------------------------------------------------------------------------
function isHttpDirectMediaSource(mediaSource as dynamic) as boolean
    if mediaSource = invalid then return false
    if LCase(Format.SafeString(mediaSource.Protocol, "")) <> "http" then return false

    return Format.SafeString(mediaSource.Path, "") <> ""
end function

'-------------------------------------------------------------------------------
' buildHttpDirectStreamUrl
'-------------------------------------------------------------------------------
function buildHttpDirectStreamUrl(server as string, path as dynamic) as string
    requestUrl = Format.SafeString(path, "")
    if requestUrl = "" then return ""

    lowerUrl = LCase(requestUrl)
    if Instr(1, lowerUrl, "http://localhost") = 1 or Instr(1, lowerUrl, "https://localhost") = 1 or Instr(1, lowerUrl, "http://127.0.0.1") = 1 or Instr(1, lowerUrl, "https://127.0.0.1") = 1 then
        routePath = getAbsoluteUrlRoutePath(requestUrl)
        if routePath <> "" then return PlaybackRequest.BuildServerUrl(server, routePath)
    end if

    return PlaybackRequest.BuildServerUrl(server, requestUrl)
end function

'-------------------------------------------------------------------------------
' getAbsoluteUrlRoutePath
'-------------------------------------------------------------------------------
function getAbsoluteUrlRoutePath(requestUrl as string) as string
    schemeEnd = Instr(1, requestUrl, "://")
    if schemeEnd = 0 then return requestUrl

    pathStart = Instr(schemeEnd + 3, requestUrl, "/")
    if pathStart = 0 then return ""

    return Mid(requestUrl, pathStart)
end function

'-------------------------------------------------------------------------------
' getStartPositionTicks
'-------------------------------------------------------------------------------
function getStartPositionTicks(request as dynamic) as longinteger
    if request = invalid then return 0

    if request.startPositionTicks <> invalid then return request.startPositionTicks
    if request.StartPositionTicks <> invalid then return request.StartPositionTicks

    return PlaybackProgress.GetTicksFromItem(request.item)
end function
