import "pkg:/source/String.bs"
'-------------------------------------------------------------------------------
' buildPlaybackInfoBody
'-------------------------------------------------------------------------------
function buildPlaybackInfoBody(alwaysBurnInSubtitleWhenTranscoding as boolean, includeSubtitleProfiles as boolean) as string
    diagnostics = []
    profileJson = DeviceCapabilities.BuildDeviceProfileJson(includeSubtitleProfiles, diagnostics)
    for each line in diagnostics
        m.log.write(line)
    end for
    return Json.Object([
        Json.String("DeviceProfile") + ":" + profileJson
        Json.BooleanPair("AlwaysBurnInSubtitleWhenTranscoding", alwaysBurnInSubtitleWhenTranscoding)
    ])
end function

'-------------------------------------------------------------------------------
' shouldAlwaysBurnSubtitleWhenTranscoding
'-------------------------------------------------------------------------------
function shouldAlwaysBurnSubtitleWhenTranscoding(subtitleBurnInMode as string, requestedSubtitleStreamIndex as integer) as boolean
    return requestedSubtitleStreamIndex >= 0 and subtitleBurnInMode <> SubtitleBurnIn.Mode.PreferExternal
end function

'-------------------------------------------------------------------------------
' shouldUseEncodedSubtitleDelivery
'-------------------------------------------------------------------------------
function shouldUseEncodedSubtitleDelivery(alwaysBurnInSubtitleWhenTranscoding as boolean, playbackMethod as string, subtitleStreamIndex as integer) as boolean
    return alwaysBurnInSubtitleWhenTranscoding and LCase(playbackMethod) = "transcode" and subtitleStreamIndex >= 0
end function

'-------------------------------------------------------------------------------
' isLiveTvPlaybackRequest
'-------------------------------------------------------------------------------
function isLiveTvPlaybackRequest(request as dynamic) as boolean
    if request = invalid or request.item = invalid then return false

    itemType = LCase(Strings.ToString(request.item.Type))
    return itemType = "tvchannel" or itemType = "livetvchannel"
end function

'-------------------------------------------------------------------------------
' isHttpDirectMediaSource
'-------------------------------------------------------------------------------
function isHttpDirectMediaSource(mediaSource as dynamic) as boolean
    if mediaSource = invalid then return false
    if LCase(Strings.ToString(mediaSource.Protocol)) <> "http" then return false

    return Strings.ToString(mediaSource.Path) <> ""
end function

'-------------------------------------------------------------------------------
' getStartPositionTicks
'-------------------------------------------------------------------------------
function getStartPositionTicks(request as dynamic) as longinteger
    if request = invalid then return 0

    if request.startPositionTicks <> invalid then return request.startPositionTicks
    if request.StartPositionTicks <> invalid then return request.StartPositionTicks

    return PlaybackProgress.GetTicksFromItem(request.item)
end function

'-------------------------------------------------------------------------------
' negotiatePlaybackInfo
'-------------------------------------------------------------------------------
function negotiatePlaybackInfo(request as object) as object
    requestedAudioStreamIndex = getPlaybackRequestAudioStreamIndex(request)
    requestedSubtitleStreamIndex = getPlaybackRequestSubtitleStreamIndex(request)
    displaySize = DeviceCapabilities.GetVideoPlaybackSize()
    requestedMediaSourceId = getPlaybackRequestMediaSourceId(request)
    requestedAudioStream = getPlaybackRequestMediaStream(request, requestedAudioStreamIndex)
    requestedMediaSource = getPlaybackRequestMediaSource(request)
    resolvedRequestedSubtitleIndex = getExistingSubtitleStreamIndex(requestedMediaSource, requestedSubtitleStreamIndex)
    subtitleBurnInMode = SubtitleBurnIn.Normalize(request.subtitleBurnInMode)
    alwaysBurnSelectedSubtitle = subtitleBurnInMode = SubtitleBurnIn.Mode.Always and resolvedRequestedSubtitleIndex >= 0
    forceTranscode = shouldForceTranscodeAudio(requestedAudioStream, requestedMediaSource)
    forceStreamSelection = shouldForceStreamSelection(request, requestedMediaSource, requestedAudioStreamIndex)
    forceSubtitleSelection = requestedSubtitleStreamIndex >= 0
    selectedPlaybackMode = getPlaybackMode(request)
    playbackFlags = getPlaybackFlags(selectedPlaybackMode, forceTranscode, forceStreamSelection, forceSubtitleSelection)
    if alwaysBurnSelectedSubtitle then
        playbackFlags.enableDirectPlay = false
        playbackFlags.enableDirectStream = false
        playbackFlags.enableTranscoding = true
    end if
    bitrateLimits = DeviceCapabilities.GetBitrateLimits()
    params = {
        UserId: Strings.ToString(request.userId)
        StartTimeTicks: getStartPositionTicks(request)
        IsPlayback: true
        AutoOpenLiveStream: true
        MaxStreamingBitrate: bitrateLimits.maxStreaming
        MaxStaticBitrate: bitrateLimits.maxStatic
        EnableDirectPlay: playbackFlags.enableDirectPlay
        EnableDirectStream: playbackFlags.enableDirectStream
        EnableTranscoding: playbackFlags.enableTranscoding
        AllowVideoStreamCopy: alwaysBurnSelectedSubtitle <> true and selectedPlaybackMode <> PlaybackMode.Mode.AutomaticNoRemux and selectedPlaybackMode <> PlaybackMode.Mode.TranscodeNoRemux
        AllowAudioStreamCopy: true
    }

    if (selectedPlaybackMode = PlaybackMode.Mode.Automatic or selectedPlaybackMode = PlaybackMode.Mode.AutomaticNoRemux) and forceTranscode = true then logForcedTranscodeReason(requestedAudioStream)
    if (selectedPlaybackMode = PlaybackMode.Mode.Automatic or selectedPlaybackMode = PlaybackMode.Mode.AutomaticNoRemux) and forceStreamSelection = true then logForcedStreamSelection(requestedAudioStream)
    m.log.write("Device profile display cap width=" + Strings.ToString(displaySize.width) + " height=" + Strings.ToString(displaySize.height) + " source=" + Strings.ToString(displaySize.source))
    m.log.write("Requested streams audioStreamIndex=" + Strings.ToString(requestedAudioStreamIndex) + " subtitleStreamIndex=" + Strings.ToString(requestedSubtitleStreamIndex))
    m.log.write("Requested video mode=" + selectedPlaybackMode)
    if requestedMediaSourceId <> "" then params.MediaSourceId = requestedMediaSourceId
    if Strings.ToString(request.liveStreamId) <> "" then
        params.LiveStreamId = request.liveStreamId
        params.AutoOpenLiveStream = false
    end if
    if requestedAudioStreamIndex >= 0 then params.AudioStreamIndex = requestedAudioStreamIndex
    if requestedSubtitleStreamIndex >= -1 then params.SubtitleStreamIndex = requestedSubtitleStreamIndex

    requestUrl = request.server + "/Items/" + request.itemId + "/PlaybackInfo" + Url.BuildQueryString(params)
    alwaysBurnInSubtitleWhenTranscoding = shouldAlwaysBurnSubtitleWhenTranscoding(subtitleBurnInMode, requestedSubtitleStreamIndex)
    body = buildPlaybackInfoBody(alwaysBurnInSubtitleWhenTranscoding, alwaysBurnSelectedSubtitle <> true)
    m.log.write("Subtitle burn-in mode=" + subtitleBurnInMode + " activeSubtitle=" + boolToText(resolvedRequestedSubtitleIndex >= 0) + " alwaysBurnInSubtitleWhenTranscoding=" + boolToText(alwaysBurnInSubtitleWhenTranscoding))
    logPlaybackRequest(request, body)

    result = HttpClient.Request(requestUrl, "POST", invalid, body, JellyfinAuth.BuildTokenHeaders(request.token))
    return {
        result: result
        audioIndex: requestedAudioStreamIndex
        subtitleIndex: requestedSubtitleStreamIndex
        flags: playbackFlags
        burnDuringTranscoding: alwaysBurnInSubtitleWhenTranscoding
    }
end function

'-------------------------------------------------------------------------------
' buildSelectedSourceItem
'-------------------------------------------------------------------------------
function buildSelectedSourceItem(request as object, mediaSource as object) as object
    item = PlaybackRequest.Create({ item: request.item }).item
    if item = invalid then item = { Id: request.itemId }
    item.MediaSources = [mediaSource]
    item.MediaStreams = mediaSource.MediaStreams
    if mediaSource.RunTimeTicks <> invalid then item.RunTimeTicks = mediaSource.RunTimeTicks
    return item
end function

'-------------------------------------------------------------------------------
' failPlaybackNegotiation
'-------------------------------------------------------------------------------
sub failPlaybackNegotiation(request as object, failure as object, mediaSource as dynamic)
    liveStreamId = ""
    if mediaSource <> invalid then liveStreamId = Strings.ToString(mediaSource.LiveStreamId)
    ' Release only a stream acquired by this negotiation, before recovery can retry.
    if liveStreamId <> "" and liveStreamId <> Strings.ToString(request.liveStreamId) then
        closeUrl = request.server + "/LiveStreams/Close" + Url.BuildQueryString({ LiveStreamId: liveStreamId })
        result = HttpClient.Request(closeUrl, "POST", invalid, "", JellyfinAuth.BuildTokenHeaders(request.token), true, 5000)
        if result.ok <> true then m.log.error("Unable to close the live stream after failed playback negotiation.")
    end if
    m.top.response = PlaybackResponse.Failure(request, failure)
end sub
