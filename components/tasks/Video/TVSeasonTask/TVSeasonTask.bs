import "pkg:/source/Format.bs"
import "pkg:/source/String.bs"
import "pkg:/source/Logger.bs"
import "pkg:/source/Encode.bs"
import "pkg:/source/Url.bs"
import "pkg:/source/api/HttpClient.bs"
import "pkg:/source/api/JellyfinAuth.bs"
import "pkg:/source/TaskRequest.bs"
import "pkg:/source/Number.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.top.functionName = "executeRequest"
end sub

'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    request = m.top.request
    validationError = TaskRequest.ValidateRequest(request, "tvSeason", ["seriesId", "seasonId"])
    if validationError <> invalid then
        validationError.AddReplace("requestId", getRequestId(request))
        if request <> invalid then
            validationError.AddReplace("seriesId", Format.SafeString(request.seriesId, ""))
            validationError.AddReplace("seasonId", Format.SafeString(request.seasonId, ""))
        end if
        m.top.response = validationError
        return
    end if

    seasonResult = loadSeason(request)
    if seasonResult.ok <> true then
        seasonResult.AddReplace("action", "tvSeason")
        seasonResult.AddReplace("seriesId", Format.SafeString(request.seriesId, ""))
        seasonResult.AddReplace("seasonId", Format.SafeString(request.seasonId, ""))
        seasonResult.AddReplace("requestId", getRequestId(request))
        m.top.response = seasonResult
        return
    end if

    episodesSeasonId = Format.SafeString(request.seasonId, "")
    if request.allEpisodes = true then episodesSeasonId = ""
    episodesResult = loadEpisodes(request, episodesSeasonId)
    if episodesResult.ok <> true then
        episodesResult.AddReplace("action", "tvSeason")
        episodesResult.AddReplace("seriesId", Format.SafeString(request.seriesId, ""))
        episodesResult.AddReplace("seasonId", Format.SafeString(request.seasonId, ""))
        episodesResult.AddReplace("requestId", getRequestId(request))
        m.top.response = episodesResult
        return
    end if

    seasonResponse = {
        ok: true
        action: "tvSeason"
        seriesId: Format.SafeString(request.seriesId, "")
        seasonId: Format.SafeString(request.seasonId, "")
        requestId: getRequestId(request)
        payload: {
            season: seasonResult.data
            episodes: episodesResult.data
            seasons: invalid
        }
    }
    m.top.response = seasonResponse

    if request.seriesMetadataPending = true then
        seriesResult = loadSeries(request)
        seriesPayload = invalid
        seriesOk = seriesResult <> invalid and seriesResult.ok = true
        if seriesOk then seriesPayload = seriesResult.data
        m.top.response = {
            ok: seriesOk
            action: "tvSeasonSeries"
            seriesId: Format.SafeString(request.seriesId, "")
            seasonId: Format.SafeString(request.seasonId, "")
            requestId: getRequestId(request)
            payload: seriesPayload
        }
    end if

    if hasRequestSeasons(request) <> true then
        seasonsResult = loadSeasons(request)
        if seasonsResult <> invalid and seasonsResult.ok = true then
            m.top.response = {
                ok: true
                action: "tvSeasonSeasons"
                seriesId: Format.SafeString(request.seriesId, "")
                seasonId: Format.SafeString(request.seasonId, "")
                requestId: getRequestId(request)
                payload: seasonsResult.data
            }
        end if
    end if

    publishCompletion(request)
end sub

'-------------------------------------------------------------------------------
' publishCompletion
'-------------------------------------------------------------------------------
sub publishCompletion(request as object)
    m.top.response = {
        ok: true
        action: "tvSeasonComplete"
        seriesId: Format.SafeString(request.seriesId, "")
        seasonId: Format.SafeString(request.seasonId, "")
        requestId: getRequestId(request)
    }
end sub

'-------------------------------------------------------------------------------
' getRequestId
'-------------------------------------------------------------------------------
function getRequestId(request as dynamic) as integer
    if request = invalid then return -1
    return Number.ToInteger(request.requestId, -1)
end function

'-------------------------------------------------------------------------------
' loadSeason
'-------------------------------------------------------------------------------
function loadSeason(request as object) as object
    params = {
        userId: Format.SafeString(request.userId, "")
        fields: "Genres,People,Overview,Studios"
        enableImageTypes: "Primary,Backdrop,Thumb"
        imageTypeLimit: 1
        enableTotalRecordCount: false
    }

    requestUrl = request.server + "/Items/" + request.seasonId + Url.BuildQueryString(params)
    return HttpClient.Request(requestUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
end function

'-------------------------------------------------------------------------------
' loadSeries
'-------------------------------------------------------------------------------
function loadSeries(request as object) as object
    params = {
        userId: Format.SafeString(request.userId, "")
        fields: "Overview"
        enableImageTypes: "Logo,Thumb,Backdrop"
        imageTypeLimit: 1
    }

    requestUrl = request.server + "/Items/" + request.seriesId + Url.BuildQueryString(params)
    return HttpClient.Request(requestUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
end function

'-------------------------------------------------------------------------------
' loadEpisodes
'-------------------------------------------------------------------------------
function loadEpisodes(request as object, seasonId as string) as object
    params = {
        userId: Format.SafeString(request.userId, "")
        fields: "MediaStreams,MediaSources,Overview,Trickplay,UserData"
        sortBy: "ParentIndexNumber,IndexNumber"
        sortOrder: "Ascending"
        enableImageTypes: "Primary,Backdrop,Thumb"
        imageTypeLimit: 1
    }
    if seasonId <> "" then params.seasonId = seasonId

    requestUrl = request.server + "/Shows/" + request.seriesId + "/Episodes" + Url.BuildQueryString(params)
    return HttpClient.Request(requestUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
end function

'-------------------------------------------------------------------------------
' loadSeasons
'-------------------------------------------------------------------------------
function loadSeasons(request as object) as object
    params = {
        userId: Format.SafeString(request.userId, "")
        enableImageTypes: "Primary,Backdrop,Thumb"
        imageTypeLimit: 1
        enableTotalRecordCount: false
    }

    requestUrl = request.server + "/Shows/" + request.seriesId + "/Seasons" + Url.BuildQueryString(params)
    return HttpClient.Request(requestUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
end function

'-------------------------------------------------------------------------------
' hasRequestSeasons
'-------------------------------------------------------------------------------
function hasRequestSeasons(request as object) as boolean
    if request.seasons = invalid then return false
    if Type(request.seasons) <> "roArray" then return false

    return request.seasons.Count() > 0
end function
