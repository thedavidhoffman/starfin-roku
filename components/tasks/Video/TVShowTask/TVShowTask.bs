import "pkg:/source/ApiPayload.bs"
import "pkg:/source/JellyfinImage.bs"
import "pkg:/source/Format.bs"
import "pkg:/source/String.bs"
import "pkg:/source/Logger.bs"
import "pkg:/source/PlaybackProgress.bs"
import "pkg:/source/Number.bs"
import "pkg:/source/Encode.bs"
import "pkg:/source/Url.bs"
import "pkg:/source/api/HttpClient.bs"
import "pkg:/source/api/JellyfinAuth.bs"
import "pkg:/source/TaskRequest.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.log = new Logger("TVShowTask", m.global.logService)
    m.top.functionName = "executeRequest"
end sub

'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    response = getResponse(m.top.request)
    if m.top.request <> invalid then response.requestId = m.top.request.requestId
    m.top.response = response
end sub

'-------------------------------------------------------------------------------
' getResponse
'-------------------------------------------------------------------------------
function getResponse(request as dynamic) as object
    validationError = TaskRequest.ValidateRequest(request, "tvShow", ["itemId"])
    if validationError <> invalid then
        if request <> invalid then validationError.AddReplace("itemId", Strings.ToString(request.itemId))
        return validationError
    end if

    seriesResult = { data: invalid }
    seasonsResult = { data: invalid }
    if request.playbackOnly <> true then
        seriesResult = loadSeries(request)
        if seriesResult.ok <> true then
            seriesResult.AddReplace("action", "tvShow")
            seriesResult.AddReplace("itemId", Strings.ToString(request.itemId))
            return seriesResult
        end if

        seasonsResult = loadSeasons(request)
        if seasonsResult.ok <> true then
            seasonsResult.AddReplace("action", "tvShow")
            seasonsResult.AddReplace("itemId", Strings.ToString(request.itemId))
            return seasonsResult
        end if
    end if

    resumeItem = invalid
    resumeResult = loadResumeItem(request)
    if resumeResult.ok = true then
        resumeItem = getFirstItem(resumeResult.data)
    else
        if request.playbackOnly = true then
            resumeResult.action = "tvShow"
            resumeResult.itemId = request.itemId
            return resumeResult
        end if
        m.log.write("Unable to load series resume item: " + Strings.ToString(resumeResult.errorMessage, "unknown error"))
    end if

    upNextItem = invalid
    upNextResult = loadUpNextItem(request)
    if upNextResult.ok = true then
        upNextItem = getFirstItem(upNextResult.data)
    else
        if request.playbackOnly = true then
            upNextResult.action = "tvShow"
            upNextResult.itemId = request.itemId
            return upNextResult
        end if
        m.log.write("Unable to load series up-next item: " + Strings.ToString(upNextResult.errorMessage, "unknown error"))
    end if

    playItem = upNextItem
    if resumeItem = invalid and playItem = invalid and resumeResult.ok = true and upNextResult.ok = true then
        replaySeasons = request.seasons
        if request.playbackOnly <> true then replaySeasons = ApiPayload.GetItems(seasonsResult.data)
        firstEpisodeResult = loadFirstEpisode(request, replaySeasons)
        if firstEpisodeResult.ok = true then
            playItem = firstEpisodeResult.data
        else
            if request.playbackOnly = true then
                firstEpisodeResult.action = "tvShow"
                firstEpisodeResult.itemId = request.itemId
                return firstEpisodeResult
            end if
            m.log.write("Unable to load series replay item: " + Strings.ToString(firstEpisodeResult.errorMessage, "unknown error"))
        end if
    end if

    playbackItem = playItem
    if resumeItem <> invalid then playbackItem = resumeItem
    playbackQueue = invalid
    playbackQueueIndex = 0
    if playbackItem <> invalid then
        queue = loadPlaybackQueue(request, playbackItem)
        if queue <> invalid then
            playbackQueue = queue.items
            playbackQueueIndex = queue.index
        end if
    end if

    return {
        ok: true
        action: "tvShow"
        itemId: Strings.ToString(request.itemId)
        payload: {
            series: seriesResult.data
            seasons: seasonsResult.data
            resumeItem: resumeItem
            upNextItem: upNextItem
            playItem: playItem
            playbackQueue: playbackQueue
            playbackQueueIndex: playbackQueueIndex
        }
    }
end function

'-------------------------------------------------------------------------------
' loadSeries
'-------------------------------------------------------------------------------
function loadSeries(request as object) as object
    params = {
        userId: Strings.ToString(request.userId)
        fields: "Genres,People,Overview,Studios"
        enableImageTypes: Strings.Join([JellyfinImage.Type.Primary, JellyfinImage.Type.Backdrop, JellyfinImage.Type.Thumb, JellyfinImage.Type.Logo])
        imageTypeLimit: 1
        enableTotalRecordCount: false
    }

    requestUrl = request.server + "/Items/" + request.itemId + Url.BuildQueryString(params)
    return HttpClient.Request(requestUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
end function

'-------------------------------------------------------------------------------
' loadUpNextItem
'-------------------------------------------------------------------------------
function loadUpNextItem(request as object) as object
    params = {
        UserId: Strings.ToString(request.userId)
        SeriesId: Strings.ToString(request.itemId)
        EnableRewatching: false
        DisableFirstEpisode: false
        Limit: 1
        Fields: "SeriesInfo,People"
        EnableImageTypes: Strings.Join([JellyfinImage.Type.Primary, JellyfinImage.Type.Backdrop, JellyfinImage.Type.Thumb])
        ImageTypeLimit: 1
        EnableTotalRecordCount: false
    }

    requestUrl = request.server + "/Shows/NextUp" + Url.BuildQueryString(params)
    return HttpClient.Request(requestUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
end function

'-------------------------------------------------------------------------------
' loadFirstEpisode
'-------------------------------------------------------------------------------
function loadFirstEpisode(request as object, seasons = invalid as dynamic) as object
    if Arrays.IsArray(seasons) = false then
        seasonsResult = loadSeasons(request)
        if seasonsResult.ok <> true then return seasonsResult
        seasons = ApiPayload.GetItems(seasonsResult.data)
    end if

    for each season in getReplaySeasons(seasons)
        params = {
            UserId: Strings.ToString(request.userId)
            SeasonId: season.Id
            Limit: 1
            StartIndex: 0
            IsMissing: false
            Fields: "SeriesInfo,People,UserData"
            EnableTotalRecordCount: false
        }
        while true
            requestUrl = request.server + "/Shows/" + request.itemId + "/Episodes" + Url.BuildQueryString(params)
            result = HttpClient.Request(requestUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
            if result.ok <> true then return result

            episodes = ApiPayload.GetItems(result.data)
            if episodes.Count() = 0 then exit while
            episode = episodes[0]
            if Arrays.IsAssocArray(episode) then
                if Strings.ToString(episode.Id) <> "" then
                    ' Jellyfin can interleave season-zero Specials into a regular season's episode order.
                    if season.sortNumber = 0 or Number.ToInteger(episode.ParentIndexNumber, -1) <> 0 then return { ok: true, data: episode }
                end if
            end if
            params.StartIndex = params.StartIndex + 1
        end while
    end for

    return { ok: true, data: invalid }
end function

'-------------------------------------------------------------------------------
' getReplaySeasons
'-------------------------------------------------------------------------------
function getReplaySeasons(seasons as object) as object
    regularSeasons = []
    specials = []
    for each season in seasons
        if Arrays.IsAssocArray(season) = false then continue for
        seasonId = Strings.ToString(season.Id)
        if seasonId = "" then continue for

        seasonNumber = Number.ToInteger(season.IndexNumber, 999999)
        entry = { Id: seasonId, sortNumber: seasonNumber }
        if seasonNumber = 0 then
            specials.Push(entry)
        else
            regularSeasons.Push(entry)
        end if
    end for

    ' Sort only season identities; Jellyfin supplies episode order within each season.
    regularSeasons.SortBy("sortNumber")
    regularSeasons.Append(specials)
    return regularSeasons
end function

'-------------------------------------------------------------------------------
' loadPlaybackQueue
'-------------------------------------------------------------------------------
function loadPlaybackQueue(request as object, episode as object) as dynamic
    seasonId = Format.FirstNonEmpty([episode.SeasonId, episode.ParentId], "")
    itemId = Format.FirstNonEmpty([episode.Id], "")
    if seasonId = "" or itemId = "" then return invalid

    params = {
        UserId: Strings.ToString(request.userId)
        SeasonId: seasonId
        Fields: "MediaStreams,MediaSources,Overview,Trickplay,UserData,People"
    }
    requestUrl = request.server + "/Shows/" + request.itemId + "/Episodes" + Url.BuildQueryString(params)
    episodesResult = HttpClient.Request(requestUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
    if episodesResult.ok <> true then
        m.log.write("Unable to load series playback queue for itemId=" + itemId)
        return invalid
    end if

    episodes = ApiPayload.GetItems(episodesResult.data)
    season = buildSeasonIdentity(episode, seasonId)
    queueItems = buildPlaybackQueueItems(episodes, season)
    queueIndex = getPlaybackQueueIndex(queueItems, itemId)
    if queueIndex < 0 then return invalid

    return {
        items: queueItems
        index: queueIndex
    }
end function

'-------------------------------------------------------------------------------
' buildPlaybackQueueItems
'-------------------------------------------------------------------------------
function buildPlaybackQueueItems(episodes as object, season as object) as object
    queue = []
    for each episode in episodes
        episodeId = Format.FirstNonEmpty([episode.Id], "")
        if episodeId = "" then continue for

        queue.Push({
            itemId: episodeId
            item: episode
            season: season
            startPositionTicks: PlaybackProgress.GetTicksFromItem(episode)
        })
    end for

    return queue
end function

'-------------------------------------------------------------------------------
' getPlaybackQueueIndex
'-------------------------------------------------------------------------------
function getPlaybackQueueIndex(queue as object, itemId as string) as integer
    for i = 0 to queue.Count() - 1
        if Strings.ToString(queue[i].itemId) = itemId then return i
    end for

    return -1
end function

'-------------------------------------------------------------------------------
' buildSeasonIdentity
'-------------------------------------------------------------------------------
function buildSeasonIdentity(episode as object, seasonId as string) as object
    seasonName = Format.FirstNonEmpty([episode.SeasonName], "")
    if seasonName = "" and episode.ParentIndexNumber <> invalid then seasonName = "Season " + Strings.ToString(episode.ParentIndexNumber)

    return {
        Id: seasonId
        Name: seasonName
    }
end function

'-------------------------------------------------------------------------------
' loadResumeItem
'-------------------------------------------------------------------------------
function loadResumeItem(request as object) as object
    params = {
        UserId: Strings.ToString(request.userId)
        ParentId: Strings.ToString(request.itemId)
        Recursive: true
        IncludeItemTypes: "Episode"
        Filters: "IsResumable"
        SortBy: "DatePlayed"
        SortOrder: "Descending"
        Limit: 1
        Fields: "SeriesInfo,People"
        EnableImageTypes: Strings.Join([JellyfinImage.Type.Primary, JellyfinImage.Type.Backdrop, JellyfinImage.Type.Thumb])
        ImageTypeLimit: 1
        EnableTotalRecordCount: false
    }

    requestUrl = request.server + "/Items" + Url.BuildQueryString(params)
    return HttpClient.Request(requestUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
end function

'-------------------------------------------------------------------------------
' getFirstItem
'-------------------------------------------------------------------------------
function getFirstItem(payload as dynamic) as dynamic
    if payload = invalid or payload.Items = invalid then return invalid
    if payload.Items.Count() = 0 then return invalid

    return payload.Items[0]
end function

'-------------------------------------------------------------------------------
' loadSeasons
'-------------------------------------------------------------------------------
function loadSeasons(request as object) as object
    params = {
        userId: Strings.ToString(request.userId)
        enableImageTypes: Strings.Join([JellyfinImage.Type.Primary, JellyfinImage.Type.Backdrop, JellyfinImage.Type.Thumb])
        imageTypeLimit: 1
        enableTotalRecordCount: false
    }

    requestUrl = request.server + "/Shows/" + request.itemId + "/Seasons" + Url.BuildQueryString(params)
    return HttpClient.Request(requestUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
end function
