import "pkg:/source/RequestFailure.bs"
import "pkg:/source/Format.bs"
import "pkg:/source/JellyfinImage.bs"
import "pkg:/source/String.bs"
import "pkg:/source/Logger.bs"
import "pkg:/source/Encode.bs"
import "pkg:/source/Url.bs"
import "pkg:/source/api/HttpClient.bs"
import "pkg:/source/api/JellyfinAuth.bs"
import "pkg:/source/TaskRequest.bs"
import "pkg:/source/Array.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.top.functionName = "executeRequest"
end sub

'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    request = m.top.request
    validationError = TaskRequest.ValidateRequest(request, "person", ["userId", "itemId"])
    if validationError <> invalid then
        if request <> invalid then validationError.AddReplace("itemId", Strings.ToString(request.itemId))
        m.top.response = validationError
        return
    end if

    personResult = loadPerson(request)
    if personResult.ok <> true then
        personResult.AddReplace("action", "person")
        personResult.AddReplace("itemId", Strings.ToString(request.itemId))
        m.top.response = personResult
        return
    end if

    itemsResult = loadPersonItems(request)
    if itemsResult.ok <> true then
        itemsResult.AddReplace("action", "person")
        itemsResult.AddReplace("itemId", Strings.ToString(request.itemId))
        m.top.response = itemsResult
        return
    end if

    filteredItems = itemsResult.data
    excludedSeriesIds = getRelatedSeriesIds(filteredItems)
    episodeItemsResult = loadPersonEpisodeItems(request, excludedSeriesIds)
    if episodeItemsResult.ok <> true then
        episodeItemsResult.AddReplace("action", "person")
        episodeItemsResult.AddReplace("itemId", Strings.ToString(request.itemId))
        m.top.response = episodeItemsResult
        return
    end if

    m.top.response = {
        ok: true
        action: "person"
        itemId: Strings.ToString(request.itemId)
        payload: {
            person: personResult.data
            items: filteredItems
            episodeItems: episodeItemsResult.data
        }
    }
end sub

'-------------------------------------------------------------------------------
' loadPerson
'-------------------------------------------------------------------------------
function loadPerson(request as object) as object
    params = {
        userId: Strings.ToString(request.userId)
        fields: "Overview,ExternalUrls"
    }

    requestUrl = request.server + "/Items/" + request.itemId + Url.BuildQueryString(params)
    return HttpClient.Request(requestUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
end function

'-------------------------------------------------------------------------------
' loadPersonItems
'-------------------------------------------------------------------------------
function loadPersonItems(request as object) as object
    params = {
        UserId: Strings.ToString(request.userId)
        PersonIds: Strings.ToString(request.itemId)
        IncludeItemTypes: "Movie,Series"
        Recursive: true
        SortBy: "SortName"
        SortOrder: "Ascending"
        Fields: "PrimaryImageAspectRatio,Overview,People"
        ImageTypeLimit: 1
        EnableImageTypes: Strings.Join([JellyfinImage.Type.Primary, JellyfinImage.Type.Backdrop])
        Limit: 40
    }

    requestUrl = request.server + "/Users/" + request.userId + "/Items" + Url.BuildQueryString(params)
    return HttpClient.Request(requestUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
end function

'-------------------------------------------------------------------------------
' loadPersonEpisodeItems
'-------------------------------------------------------------------------------
function loadPersonEpisodeItems(request as object, excludedSeriesIds as object) as object
    itemLimit = 40
    episodeItems = []

    params = {
        UserId: Strings.ToString(request.userId)
        PersonIds: Strings.ToString(request.itemId)
        IncludeItemTypes: "Episode"
        Recursive: true
        SortBy: "PremiereDate"
        SortOrder: "Descending"
        Fields: "PrimaryImageAspectRatio,Overview,SeriesName"
        ImageTypeLimit: 1
        EnableImageTypes: Strings.Join([JellyfinImage.Type.Primary, JellyfinImage.Type.Backdrop, JellyfinImage.Type.Thumb])
        Limit: 500
    }

    requestUrl = request.server + "/Users/" + request.userId + "/Items" + Url.BuildQueryString(params)
    response = HttpClient.Request(requestUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
    if response.ok <> true then return response

    items = getPayloadItems(response.data)
    if items <> invalid then
        for each item in items
            seriesId = ""
            if Arrays.IsAssocArray(item) then seriesId = Format.FirstNonEmpty([item.SeriesId], "")
            if seriesId <> "" and arrayContainsString(excludedSeriesIds, seriesId) then continue for

            episodeItems.Push(item)
            if episodeItems.Count() = itemLimit then exit for
        end for
    end if

    return loadEpisodeCredits(request, episodeItems)
end function

'-------------------------------------------------------------------------------
' loadEpisodeCredits
'-------------------------------------------------------------------------------
function loadEpisodeCredits(request as object, episodeItems as object) as object
    ids = []
    for each item in episodeItems
        if Arrays.IsAssocArray(item) then
            itemId = Strings.ToString(item.Id)
            if itemId <> "" then ids.Push(itemId)
        end if
    end for
    if ids.Count() = 0 then return { ok: true, data: episodeItems }

    ' The discovery query may return 500 episodes, most of which are discarded.
    ' Request full casts only for the retained shelf items, in one bounded batch.
    params = {
        UserId: Strings.ToString(request.userId)
        Ids: Strings.Join(ids, ",")
        Fields: "People"
        EnableImages: false
        EnableUserData: false
        EnableTotalRecordCount: false
        Limit: ids.Count()
    }
    requestUrl = request.server + "/Users/" + request.userId + "/Items" + Url.BuildQueryString(params)
    response = HttpClient.Request(requestUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
    if response.ok <> true then
        if response.authExpired = true or response.failureKind = RequestFailure.Kind.AuthenticationRequired then return response
        ' Credits are optional enrichment; retain the successfully discovered shelf.
        return { ok: true, data: episodeItems }
    end if

    creditsById = {}
    creditItems = getPayloadItems(response.data)
    if Arrays.IsArray(creditItems) then
        for each item in creditItems
            if Arrays.IsAssocArray(item) then creditsById[Strings.ToString(item.Id)] = item
        end for
    end if
    ' Merge by ID: the batch response need not retain discovery order. Keep the
    ' original artwork, playback metadata, and membership when a credit is absent.
    for each item in episodeItems
        if Arrays.IsAssocArray(item) then
            credit = creditsById[Strings.ToString(item.Id)]
            if credit <> invalid then item.People = credit.People
        end if
    end for
    return { ok: true, data: episodeItems }
end function

'-------------------------------------------------------------------------------
' getRelatedSeriesIds
'-------------------------------------------------------------------------------
function getRelatedSeriesIds(payload as dynamic) as object
    seriesIds = []
    items = getPayloadItems(payload)
    if items = invalid then return seriesIds

    for each item in items
        if Arrays.IsAssocArray(item) = false then continue for
        if LCase(Format.FirstNonEmpty([item.Type], "")) <> "series" then continue for

        seriesId = Format.FirstNonEmpty([item.Id], "")
        if seriesId <> "" and arrayContainsString(seriesIds, seriesId) = false then seriesIds.Push(seriesId)
    end for

    return seriesIds
end function

'-------------------------------------------------------------------------------
' getPayloadItems
'-------------------------------------------------------------------------------
function getPayloadItems(payload as dynamic) as dynamic
    if payload = invalid then return invalid
    if Type(payload) = "roArray" then return payload
    if Arrays.IsAssocArray(payload) = false then return invalid

    return payload.Items
end function

'-------------------------------------------------------------------------------
' arrayContainsString
'-------------------------------------------------------------------------------
function arrayContainsString(values as object, value as string) as boolean
    if value = "" then return false

    for each current in values
        if Strings.ToString(current) = value then return true
    end for

    return false
end function
