import "pkg:/source/String.bs"
import "pkg:/source/Number.bs"
import "pkg:/source/Logger.bs"
import "pkg:/source/api/HttpClient.bs"
import "pkg:/source/api/JellyfinAuth.bs"
import "pkg:/source/TaskRequest.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.log = new Logger("VideoMediaSegmentsTask", m.global.logService)
    m.top.functionName = "executeRequest"
end sub

'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    request = m.top.request
    requestId = -1
    if request <> invalid then requestId = Number.ToInteger(request.requestId, -1)
    validationError = TaskRequest.ValidateRequest(request, "mediaSegments", ["itemId"])
    if validationError <> invalid then
        itemId = ""
        if request <> invalid then itemId = Strings.ToString(request.itemId)
        validationError.AddReplace("itemId", itemId)
        validationError.AddReplace("requestId", requestId)
        m.top.response = validationError
        return
    end if

    itemId = Strings.ToString(request.itemId)
    requestUrl = request.server + "/MediaSegments/" + itemId
    m.log.write("Loading media segments itemId=" + itemId)
    result = HttpClient.Request(requestUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
    if result.ok <> true then
        result.AddReplace("action", "mediaSegments")
        result.AddReplace("itemId", itemId)
        result.AddReplace("requestId", requestId)
        m.top.response = result
        return
    end if

    segments = []
    if result.data <> invalid and result.data.Items <> invalid then segments = result.data.Items
    m.top.response = {
        ok: true
        requestId: requestId
        action: "mediaSegments"
        itemId: itemId
        segments: segments
    }
end sub
