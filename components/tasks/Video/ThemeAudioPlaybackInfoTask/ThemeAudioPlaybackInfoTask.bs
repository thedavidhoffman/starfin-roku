import "pkg:/source/Number.bs"
import "pkg:/source/Format.bs"
import "pkg:/source/String.bs"
import "pkg:/source/Logger.bs"
import "pkg:/source/Encode.bs"
import "pkg:/source/Json.bs"
import "pkg:/source/DeviceCapabilities.bs"
import "pkg:/source/PlaybackRequest.bs"
import "pkg:/source/Url.bs"
import "pkg:/source/api/HttpClient.bs"
import "pkg:/source/api/JellyfinAuth.bs"
import "pkg:/source/TaskRequest.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.log = new Logger("ThemeAudioPlaybackInfoTask", m.global.logService)
    m.top.functionName = "executeRequest"
end sub

'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    request = m.top.request
    response = resolveRequest(request)
    response.requestId = -1
    if request <> invalid then response.requestId = Number.ToInteger(request.requestId, -1)
    m.top.response = response
end sub

'-------------------------------------------------------------------------------
' resolveRequest
'-------------------------------------------------------------------------------
function resolveRequest(request as dynamic) as object
    itemId = ""
    if request <> invalid then itemId = Format.SafeString(request.itemId, "")
    validationError = TaskRequest.ValidateRequest(request, "themeAudioPlaybackInfo", ["itemId"])
    if validationError <> invalid then
        validationError.AddReplace("itemId", itemId)
        return validationError
    end if

    requestUrl = request.server + "/Items/" + itemId + "/PlaybackInfo" + Url.BuildQueryString({
        UserId: Format.SafeString(request.userId, "")
        IsPlayback: true
        EnableDirectPlay: true
        EnableDirectStream: true
    })
    result = HttpClient.Request(requestUrl, "POST", invalid, buildPlaybackInfoBody(), JellyfinAuth.BuildTokenHeaders(request.token))
    if result.ok <> true then
        result.AddReplace("action", "themeAudioPlaybackInfo")
        result.AddReplace("itemId", itemId)
        return result
    end if

    streamInfo = buildThemeAudioStreamInfo(request, result.data)
    if streamInfo.ok <> true then
        streamInfo.AddReplace("itemId", itemId)
        return streamInfo
    end if

    m.log.write("Theme audio PlaybackInfo resolved itemId=" + itemId + " streamFormat=" + Format.SafeString(streamInfo.streamFormat, "") + " streamUrl=" + PlaybackRequest.MaskUrl(streamInfo.streamUrl))
    return {
        ok: true
        action: "themeAudioPlaybackInfo"
        itemId: itemId
        streamUrl: streamInfo.streamUrl
        streamFormat: streamInfo.streamFormat
        title: Format.SafeString(request.title, "Theme Music")
    }
end function

'-------------------------------------------------------------------------------
' buildThemeAudioStreamInfo
'-------------------------------------------------------------------------------
function buildThemeAudioStreamInfo(request as object, playbackInfo as dynamic) as object
    mediaSource = PlaybackRequest.FirstMediaSource(playbackInfo)
    if mediaSource = invalid then return { ok: false, action: "themeAudioPlaybackInfo", errorMessage: "Theme song has no playable media source." }

    transcodingUrl = Format.SafeString(mediaSource.TranscodingUrl, "")
    if transcodingUrl <> "" then
        return {
            ok: true
            streamUrl: Url.Resolve(request.server, transcodingUrl)
            streamFormat: "hls"
        }
    end if

    container = Format.SafeString(mediaSource.Container, "")
    if LCase(Format.SafeString(mediaSource.Protocol, "")) = "http" and Format.SafeString(mediaSource.Path, "") <> "" then
        return {
            ok: true
            streamUrl: Url.Resolve(request.server, mediaSource.Path)
            streamFormat: PlaybackRequest.GetAudioStreamFormat(container)
        }
    end if

    streamParams = {
        Static: true
        Container: container
        MediaSourceId: Format.SafeString(mediaSource.Id, "")
        PlaySessionId: Format.SafeString(playbackInfo.PlaySessionId, "")
    }
    return {
        ok: true
        streamUrl: Url.Resolve(request.server, "/Audio/" + Format.SafeString(request.itemId, "") + "/stream") + Url.BuildQueryString(streamParams)
        streamFormat: PlaybackRequest.GetAudioStreamFormat(container)
    }
end function

'-------------------------------------------------------------------------------
' buildPlaybackInfoBody
'-------------------------------------------------------------------------------
function buildPlaybackInfoBody() as string
    return Json.Object([
        Json.String("DeviceProfile") + ":" + DeviceCapabilities.BuildDeviceProfileJson()
    ])
end function
