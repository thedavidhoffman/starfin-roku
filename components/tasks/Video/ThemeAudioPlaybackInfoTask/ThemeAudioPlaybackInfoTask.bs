'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.log = new Logger("ThemeAudioPlaybackInfoTask", m.global.logService)
    m.top.functionName = "executeRequest"
end sub

'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    request = m.top.request
    validationError = validateRequest(request)
    if validationError <> invalid then
        m.top.response = validationError
        return
    end if

    itemId = Format.SafeString(request.itemId, "")
    requestUrl = request.server + "/Items/" + itemId + "/PlaybackInfo" + Url.BuildQueryString({
        UserId: Format.SafeString(request.userId, "")
        IsPlayback: true
        EnableDirectPlay: true
        EnableDirectStream: true
    })
    result = HttpClient.Request(requestUrl, "POST", invalid, buildPlaybackInfoBody(), JellyfinAuth.BuildTokenHeaders(request.token))
    if result.ok <> true then
        result.AddReplace("action", "themeAudioPlaybackInfo")
        m.top.response = result
        return
    end if

    streamInfo = buildThemeAudioStreamInfo(request, result.data)
    if streamInfo.ok <> true then
        m.top.response = streamInfo
        return
    end if

    m.log.write("Theme audio PlaybackInfo resolved itemId=" + itemId + " streamFormat=" + Format.SafeString(streamInfo.streamFormat, "") + " streamUrl=" + maskUrl(Format.SafeString(streamInfo.streamUrl, "")))
    m.top.response = {
        ok: true
        action: "themeAudioPlaybackInfo"
        itemId: itemId
        streamUrl: streamInfo.streamUrl
        streamFormat: streamInfo.streamFormat
        title: Format.SafeString(request.title, "Theme Music")
    }
end sub

'-------------------------------------------------------------------------------
' buildThemeAudioStreamInfo
'-------------------------------------------------------------------------------
function buildThemeAudioStreamInfo(request as object, playbackInfo as dynamic) as object
    mediaSource = firstMediaSource(playbackInfo)
    if mediaSource = invalid then return { ok: false, action: "themeAudioPlaybackInfo", errorMessage: "Theme song has no playable media source." }

    transcodingUrl = Format.SafeString(mediaSource.TranscodingUrl, "")
    if transcodingUrl <> "" then
        return {
            ok: true
            streamUrl: buildServerUrl(request.server, transcodingUrl)
            streamFormat: "hls"
        }
    end if

    container = Format.SafeString(mediaSource.Container, "")
    streamParams = {
        Static: true
        Container: container
        MediaSourceId: Format.SafeString(mediaSource.Id, "")
        PlaySessionId: Format.SafeString(playbackInfo.PlaySessionId, "")
        api_key: Format.SafeString(request.token, "")
    }
    return {
        ok: true
        streamUrl: request.server + "/Audio/" + Format.SafeString(request.itemId, "") + "/stream" + Url.BuildQueryString(streamParams)
        streamFormat: getStreamFormat(container)
    }
end function

'-------------------------------------------------------------------------------
' maskUrl
'-------------------------------------------------------------------------------
function maskUrl(requestUrl as string) as string
    apiKeyIndex = Instr(1, LCase(requestUrl), "api_key=")
    if apiKeyIndex = 0 then return requestUrl

    valueStart = apiKeyIndex + Len("api_key=")
    valueEnd = Instr(valueStart, requestUrl, "&")
    if valueEnd = 0 then return Left(requestUrl, valueStart - 1) + "[redacted]"

    return Left(requestUrl, valueStart - 1) + "[redacted]" + Mid(requestUrl, valueEnd)
end function

'-------------------------------------------------------------------------------
' buildPlaybackInfoBody
'-------------------------------------------------------------------------------
function buildPlaybackInfoBody() as string
    return Json.Object([
        Json.String("DeviceProfile") + ":" + DeviceCapabilities.BuildDeviceProfileJson()
    ])
end function

'-------------------------------------------------------------------------------
' firstMediaSource
'-------------------------------------------------------------------------------
function firstMediaSource(playbackInfo as dynamic) as dynamic
    if playbackInfo = invalid or playbackInfo.MediaSources = invalid then return invalid
    if playbackInfo.MediaSources.Count() = 0 then return invalid

    return playbackInfo.MediaSources[0]
end function

'-------------------------------------------------------------------------------
' buildServerUrl
'-------------------------------------------------------------------------------
function buildServerUrl(server as string, path as string) as string
    if Instr(1, LCase(path), "http://") = 1 or Instr(1, LCase(path), "https://") = 1 then return path
    if Left(path, 1) = "/" then return server + path

    return server + "/" + path
end function

'-------------------------------------------------------------------------------
' getStreamFormat
'-------------------------------------------------------------------------------
function getStreamFormat(container as string) as string
    normalized = LCase(container)
    if normalized = "m4a" then return "mp4"
    if normalized = "" then return "mp3"

    return normalized
end function

'-------------------------------------------------------------------------------
' validateRequest
'-------------------------------------------------------------------------------
function validateRequest(request as dynamic) as dynamic
    if request = invalid then return { ok: false, action: "themeAudioPlaybackInfo", errorMessage: "Invalid theme audio request." }
    if request.server = invalid or request.server = "" then return { ok: false, action: "themeAudioPlaybackInfo", errorMessage: "Invalid theme audio server." }
    if request.token = invalid or request.token = "" then return { ok: false, action: "themeAudioPlaybackInfo", errorMessage: "Invalid theme audio token." }
    if Format.SafeString(request.itemId, "") = "" then return { ok: false, action: "themeAudioPlaybackInfo", errorMessage: "Invalid theme audio item." }

    return invalid
end function
