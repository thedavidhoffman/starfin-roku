import "pkg:/source/Format.bs"
import "pkg:/source/String.bs"
import "pkg:/source/Number.bs"
import "pkg:/source/DateTime.bs"
import "pkg:/source/Logger.bs"
import "pkg:/source/Url.bs"
import "pkg:/source/Encode.bs"
import "pkg:/source/api/HttpClient.bs"
import "pkg:/source/Array.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.top.functionName = "executeRequest"
end sub

'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    request = m.top.request
    validationError = validateRequest(request)
    if validationError <> invalid then
        if request <> invalid then validationError.AddReplace("personId", Format.SafeString(request.personId, ""))
        m.top.response = validationError
        return
    end if

    requestUrl = "https://api.themoviedb.org/3/person/" + request.personId + "/combined_credits" + Url.BuildQueryString({
        api_key: request.apiKey
    })

    result = HttpClient.Request(requestUrl, "GET", invalid, invalid)
    if result.ok <> true then
        result.AddReplace("action", "filmography")
        result.AddReplace("personId", Format.SafeString(request.personId, ""))
        m.top.response = result
        return
    end if

    m.top.response = {
        ok: true
        action: "filmography"
        personId: Format.SafeString(request.personId, "")
        payload: buildFilmographyItems(result.data)
    }
end sub

'-------------------------------------------------------------------------------
' buildFilmographyItems
'-------------------------------------------------------------------------------
function buildFilmographyItems(payload as dynamic) as object
    items = []
    if payload = invalid or payload.cast = invalid then return items

    for each credit in payload.cast
        if Arrays.IsAssocArray(credit) = false then continue for

        title = Format.FirstNonEmpty([credit.title, credit.name], "")
        if title = "" then continue for
        releaseDate = getCreditDate(credit)
        if releaseDate = "" then continue for

        items.Push({
            sort_date: releaseDate
            release_date: DateTime.ToYear(releaseDate)
            title: title
            character: Format.FirstNonEmpty([credit.character], "")
            poster_path: Format.FirstNonEmpty([credit.poster_path], "")
            overview: Format.FirstNonEmpty([credit.overview], "")
            vote_average: Number.ToFloat(credit.vote_average)
            raw: credit
        })
    end for

    items.SortBy("sort_date")
    items.Reverse()
    return items
end function

' getCreditDate
'-------------------------------------------------------------------------------
function getCreditDate(credit as object) as string
    originalDate = Format.FirstNonEmpty([credit.release_date, credit.first_air_date], "")
    return Format.FirstNonEmpty([credit.first_credit_air_date, originalDate], "")
end function

' validateRequest
'-------------------------------------------------------------------------------
function validateRequest(request as dynamic) as dynamic
    if request = invalid then return { ok: false, action: "filmography", errorMessage: "Invalid filmography request." }
    if request.personId = invalid or request.personId = "" then return { ok: false, action: "filmography", errorMessage: "Invalid TMDB person." }
    if request.apiKey = invalid or request.apiKey = "" then return { ok: false, action: "filmography", errorMessage: "Missing TMDB API key." }

    return invalid
end function

