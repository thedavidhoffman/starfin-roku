import "pkg:/source/Format.bs"
import "pkg:/source/String.bs"
import "pkg:/source/Logger.bs"
import "pkg:/source/PlaybackProgress.bs"
import "pkg:/source/Encode.bs"
import "pkg:/source/Url.bs"
import "pkg:/source/api/HttpClient.bs"
import "pkg:/source/api/JellyfinAuth.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.log = new Logger("TVShowRandomPlaybackTask", m.global.logService)
    m.top.functionName = "executeRequest"
end sub

'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    request = m.top.request
    validationError = validateRequest(request)
    if validationError <> invalid then
        m.top.response = validationError
        return
    end if

    params = {
        UserId: request.userId
        Fields: "MediaStreams,MediaSources,Overview,Trickplay,UserData"
    }
    requestUrl = request.server + "/Shows/" + request.itemId + "/Episodes" + Url.BuildQueryString(params)
    result = HttpClient.Request(requestUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
    if result.ok <> true then
        result.AddReplace("action", "tvShowRandomPlayback")
        result.AddReplace("itemId", request.itemId)
        m.top.response = result
        return
    end if

    m.top.response = {
        ok: true
        action: "tvShowRandomPlayback"
        itemId: request.itemId
        playbackQueue: buildPlaybackQueue(getItemsFromPayload(result.data))
    }
end sub

'-------------------------------------------------------------------------------
' getItemsFromPayload
'-------------------------------------------------------------------------------
function getItemsFromPayload(payload as dynamic) as object
    if payload = invalid then return []
    if Type(payload) = "roArray" then return payload
    if payload.Items <> invalid then return payload.Items
    return []
end function

'-------------------------------------------------------------------------------
' buildPlaybackQueue
'-------------------------------------------------------------------------------
function buildPlaybackQueue(episodes as object) as object
    queue = []
    for each episode in episodes
        episodeId = Format.SafeString(Format.FirstNonEmpty([episode.Id], ""), "")
        if episodeId = "" then continue for

        queue.Push({
            itemId: episodeId
            item: episode
            season: buildSeasonIdentity(episode)
            startPositionTicks: PlaybackProgress.GetTicksFromItem(episode)
        })
    end for

    return queue
end function

'-------------------------------------------------------------------------------
' buildSeasonIdentity
'-------------------------------------------------------------------------------
function buildSeasonIdentity(episode as object) as object
    seasonName = Format.FirstNonEmpty([episode.SeasonName], "")
    if seasonName = "" and episode.ParentIndexNumber <> invalid then seasonName = "Season " + Format.SafeString(episode.ParentIndexNumber, "")

    return {
        Id: Format.SafeString(Format.FirstNonEmpty([episode.SeasonId, episode.ParentId], ""), "")
        Name: seasonName
    }
end function

'-------------------------------------------------------------------------------
' validateRequest
'-------------------------------------------------------------------------------
function validateRequest(request as dynamic) as dynamic
    errorMessage = ""
    if request = invalid then
        errorMessage = "Invalid random playback request."
    else if request.server = invalid or request.server = "" then
        errorMessage = "Invalid random playback server."
    else if request.token = invalid or request.token = "" then
        errorMessage = "Invalid random playback token."
    else if request.userId = invalid or request.userId = "" then
        errorMessage = "Invalid random playback user."
    else if request.itemId = invalid or request.itemId = "" then
        errorMessage = "Invalid random playback series."
    end if
    if errorMessage = "" then return invalid

    itemId = ""
    if request <> invalid then itemId = Format.SafeString(request.itemId, "")
    return {
        ok: false
        action: "tvShowRandomPlayback"
        itemId: itemId
        errorMessage: errorMessage
    }
end function
