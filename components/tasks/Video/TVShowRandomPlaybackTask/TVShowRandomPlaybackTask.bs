import "pkg:/source/String.bs"
import "pkg:/source/ApiPayload.bs"
import "pkg:/source/Format.bs"
import "pkg:/source/Logger.bs"
import "pkg:/source/PlaybackProgress.bs"
import "pkg:/source/Encode.bs"
import "pkg:/source/Url.bs"
import "pkg:/source/api/HttpClient.bs"
import "pkg:/source/api/JellyfinAuth.bs"
import "pkg:/source/TaskRequest.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.top.functionName = "executeRequest"
end sub

'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    request = m.top.request
    response = buildResponse(request)
    if request <> invalid then
        if request.requestId <> invalid then response.requestId = request.requestId
    end if
    m.top.response = response
end sub

'-------------------------------------------------------------------------------
' buildResponse
'-------------------------------------------------------------------------------
function buildResponse(request as dynamic) as object
    validationError = TaskRequest.ValidateRequest(request, "tvShowRandomPlayback", ["userId", "itemId"])
    if validationError <> invalid then
        itemId = ""
        if request <> invalid then itemId = Strings.ToString(request.itemId)
        validationError.AddReplace("itemId", itemId)
        return validationError
    end if

    params = {
        UserId: request.userId
        Fields: "MediaStreams,MediaSources,Overview,Trickplay,UserData"
    }
    requestUrl = request.server + "/Shows/" + request.itemId + "/Episodes" + Url.BuildQueryString(params)
    result = HttpClient.Request(requestUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
    if result.ok <> true then
        result.AddReplace("action", "tvShowRandomPlayback")
        result.AddReplace("itemId", request.itemId)
        return result
    end if

    return {
        ok: true
        action: "tvShowRandomPlayback"
        itemId: request.itemId
        playbackQueue: buildPlaybackQueue(ApiPayload.GetItems(result.data))
    }
end function

'-------------------------------------------------------------------------------
' buildPlaybackQueue
'-------------------------------------------------------------------------------
function buildPlaybackQueue(episodes as object) as object
    queue = []
    for each episode in episodes
        episodeId = Format.FirstNonEmpty([episode.Id], "")
        if episodeId = "" then continue for

        queue.Push({
            itemId: episodeId
            item: episode
            season: buildSeasonIdentity(episode)
            startPositionTicks: PlaybackProgress.GetTicksFromItem(episode)
        })
    end for

    return queue
end function

'-------------------------------------------------------------------------------
' buildSeasonIdentity
'-------------------------------------------------------------------------------
function buildSeasonIdentity(episode as object) as object
    seasonName = Format.FirstNonEmpty([episode.SeasonName], "")
    if seasonName = "" and episode.ParentIndexNumber <> invalid then seasonName = "Season " + Strings.ToString(episode.ParentIndexNumber)

    return {
        Id: Format.FirstNonEmpty([episode.SeasonId, episode.ParentId], "")
        Name: seasonName
    }
end function
