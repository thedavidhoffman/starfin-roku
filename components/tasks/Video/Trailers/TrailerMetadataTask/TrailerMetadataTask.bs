import "pkg:/source/YouTubeTrailer.bs"
import "pkg:/source/Trailers.bs"
'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.top.functionName = "executeRequest"
end sub

'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    request = m.top.request
    for each item in request.items
        if item.source = Trailers.Source.YouTube then
            requestUrl = "https://www.youtube.com/oembed?format=json&url=" + ("https://www.youtube.com/watch?v=" + item.videoId).EncodeUriComponent()
            metadata = YouTubeTrailer.Fetch(requestUrl)
            if type(metadata) = "roAssociativeArray" then
                title = Strings.Trim(metadata.title)
                if title = "" then title = item.title
                m.top.response = { requestId: request.requestId, key: item.key, title: title }
            end if
        end if
    end for
end sub
