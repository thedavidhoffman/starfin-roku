import "pkg:/source/api/HttpClient.bs"
import "pkg:/source/api/JellyfinAuth.bs"
import "pkg:/source/Url.bs"
import "pkg:/source/String.bs"
'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.top.functionName = "executeRequest"
end sub

'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    request = m.top.request
    if Strings.ToString(request.playSessionId) = "" then return
    device = CreateObject("roDeviceInfo")
    deviceId = device.GetChannelClientId()
    if deviceId = "" then deviceId = device.GetModel()
    requestUrl = request.server + "/Videos/ActiveEncodings" + Url.BuildQueryString({ DeviceId: deviceId, PlaySessionId: request.playSessionId })
    result = HttpClient.Request(requestUrl, "DELETE", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token), false, 5000)
    m.top.response = { ok: result.ok }
end sub
