'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.log = new Logger("TVNextSeasonPlaybackTask", m.global.logService)
    m.top.functionName = "executeRequest"
end sub

'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    request = m.top.request
    response = buildResponse(request)
    if request <> invalid then response.AddReplace("requestId", Number.ToInteger(request.requestId, -1))
    m.top.response = response
end sub

'-------------------------------------------------------------------------------
' buildResponse
'-------------------------------------------------------------------------------
function buildResponse(request as dynamic) as object
    validationError = validateRequest(request)
    if validationError <> invalid then return validationError

    seasonsResult = loadSeasons(request)
    if seasonsResult = invalid or seasonsResult.ok <> true then
        return {
            ok: false
            action: "tvNextSeasonPlayback"
            errorMessage: "Unable to load series seasons."
        }
    end if

    nextSeason = getNextSeason(getItemsFromPayload(seasonsResult.data), request.seasonId)
    if nextSeason = invalid then
        return {
            ok: true
            action: "tvNextSeasonPlayback"
            payload: invalid
        }
    end if

    nextSeasonId = Format.SafeString(Format.FirstNonEmpty([nextSeason.Id], ""), "")
    episodesResult = loadEpisodes(request, nextSeasonId)
    if episodesResult = invalid or episodesResult.ok <> true then
        return {
            ok: false
            action: "tvNextSeasonPlayback"
            errorMessage: "Unable to load next season episodes."
        }
    end if

    return {
        ok: true
        action: "tvNextSeasonPlayback"
        payload: {
            season: nextSeason
            items: buildPlaybackQueue(getItemsFromPayload(episodesResult.data), nextSeason)
        }
    }
end function

'-------------------------------------------------------------------------------
' loadSeasons
'-------------------------------------------------------------------------------
function loadSeasons(request as object) as object
    params = {
        userId: request.userId
        enableTotalRecordCount: false
    }
    requestUrl = request.server + "/Shows/" + request.seriesId + "/Seasons" + Url.BuildQueryString(params)
    return HttpClient.Request(requestUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
end function

'-------------------------------------------------------------------------------
' loadEpisodes
'-------------------------------------------------------------------------------
function loadEpisodes(request as object, seasonId as string) as object
    params = {
        userId: request.userId
        seasonId: seasonId
        fields: "MediaStreams,MediaSources,Overview,Trickplay,UserData"
        sortBy: "ParentIndexNumber,IndexNumber"
        sortOrder: "Ascending"
    }
    requestUrl = request.server + "/Shows/" + request.seriesId + "/Episodes" + Url.BuildQueryString(params)
    return HttpClient.Request(requestUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
end function

'-------------------------------------------------------------------------------
' getNextSeason
'-------------------------------------------------------------------------------
function getNextSeason(seasons as object, currentSeasonId as string) as dynamic
    for i = 0 to seasons.Count() - 1
        season = seasons[i]
        if season = invalid then continue for
        if Format.SafeString(Format.FirstNonEmpty([season.Id], ""), "") <> currentSeasonId then continue for

        for nextIndex = i + 1 to seasons.Count() - 1
            nextSeason = seasons[nextIndex]
            if nextSeason <> invalid and Format.SafeString(Format.FirstNonEmpty([nextSeason.Id], ""), "") <> "" then return nextSeason
        end for
        return invalid
    end for

    return invalid
end function

'-------------------------------------------------------------------------------
' buildPlaybackQueue
'-------------------------------------------------------------------------------
function buildPlaybackQueue(episodes as object, season as object) as object
    queue = []
    for each episode in episodes
        if episode = invalid then continue for
        episodeId = Format.SafeString(Format.FirstNonEmpty([episode.Id], ""), "")
        if episodeId = "" then continue for

        queue.Push({
            itemId: episodeId
            item: episode
            season: season
            startPositionTicks: PlaybackProgress.GetTicksFromItem(episode)
        })
    end for
    return queue
end function

'-------------------------------------------------------------------------------
' getItemsFromPayload
'-------------------------------------------------------------------------------
function getItemsFromPayload(payload as dynamic) as object
    if payload = invalid then return []
    if Type(payload) = "roArray" then return payload
    if payload.Items <> invalid then return payload.Items
    return []
end function

'-------------------------------------------------------------------------------
' validateRequest
'-------------------------------------------------------------------------------
function validateRequest(request as dynamic) as dynamic
    if request = invalid then return { ok: false, action: "tvNextSeasonPlayback", errorMessage: "Invalid next season request." }
    if request.server = invalid or request.server = "" then return { ok: false, action: "tvNextSeasonPlayback", errorMessage: "Invalid next season server." }
    if request.token = invalid or request.token = "" then return { ok: false, action: "tvNextSeasonPlayback", errorMessage: "Invalid next season token." }
    if request.userId = invalid or request.userId = "" then return { ok: false, action: "tvNextSeasonPlayback", errorMessage: "Invalid next season user." }
    if request.seriesId = invalid or request.seriesId = "" then return { ok: false, action: "tvNextSeasonPlayback", errorMessage: "Invalid next season series." }
    if request.seasonId = invalid or request.seasonId = "" then return { ok: false, action: "tvNextSeasonPlayback", errorMessage: "Invalid current season." }
    return invalid
end function
