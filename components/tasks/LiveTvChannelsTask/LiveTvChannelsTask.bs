import "pkg:/source/Format.bs"
import "pkg:/source/String.bs"
import "pkg:/source/Logger.bs"
import "pkg:/source/Encode.bs"
import "pkg:/source/Url.bs"
import "pkg:/source/api/HttpClient.bs"
import "pkg:/source/api/JellyfinAuth.bs"
import "pkg:/source/TaskRequest.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.log = new Logger("LiveTvChannelsTask", m.global.logService)
    m.top.functionName = "executeRequest"
end sub

'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    request = m.top.request
    validationError = TaskRequest.ValidateRequest(request, "liveTvChannels")
    if validationError <> invalid then
        if request <> invalid then validationError.AddReplace("userId", Format.SafeString(request.userId, ""))
        m.top.response = validationError
        return
    end if

    params = {
        IncludeItemTypes: "LiveTvChannel"
        SortBy: "SortName"
        SortOrder: "Ascending"
        UserId: Format.SafeString(request.userId, "")
        EnableFavoriteSorting: true
        EnableUserData: false
        AddCurrentProgram: false
        Recursive: true
        ImageTypeLimit: 1
        EnableImageTypes: "Primary"
    }

    requestUrl = request.server + "/Items" + Url.BuildQueryString(params)
    response = HttpClient.Request(requestUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
    if response.ok <> true then
        response.AddReplace("action", "liveTvChannels")
        response.AddReplace("userId", Format.SafeString(request.userId, ""))
        m.top.response = response
        return
    end if

    m.top.response = {
        ok: true
        action: "liveTvChannels"
        userId: Format.SafeString(request.userId, "")
        payload: response.data
    }
end sub
