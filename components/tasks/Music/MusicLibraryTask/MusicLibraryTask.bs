'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.log = new Logger("MusicLibraryTask", m.global.logService)
    m.top.functionName = "executeRequest"
end sub

'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    request = m.top.request
    requestTimer = CreateObject("roTimespan")
    requestTimer.Mark()
    validationError = validateRequest(request)
    if validationError <> invalid then
        if request <> invalid then
            validationError.AddReplace("libraryId", Format.SafeString(request.libraryId, ""))
            validationError.AddReplace("queryId", Number.ToInteger(request.queryId, 0))
        end if
        m.top.response = validationError
        return
    end if

    params = {
        userId: Format.SafeString(request.userId, "")
        parentId: Format.SafeString(request.libraryId, "")
        recursive: true
        includeItemTypes: "MusicAlbum"
        fields: "SortName,AlbumArtist,Artists,ProductionYear,PremiereDate"
        enableImageTypes: "Primary"
        imageTypeLimit: 1
        enableTotalRecordCount: true
        sortBy: getAlbumSortBy(request)
        sortOrder: getAlbumSortOrder(request)
    }
    if request.favoriteOnly = true then params.AddReplace("filters", "IsFavorite")
    if Format.SafeString(request.artistIds, "") <> "" then params.AddReplace("artistIds", request.artistIds)
    if Format.SafeString(request.genre, "") <> "" then params.AddReplace("genres", request.genre)
    if Type(request.years) = "roArray" and request.years.Count() > 0 then params.AddReplace("years", request.years.Join(","))

    pageSize = 100
    startIndex = Number.ToInteger(request.pageStartIndex, 0)
    params.AddReplace("startIndex", startIndex)
    params.AddReplace("limit", pageSize)
    requestUrl = request.server + "/Users/" + Format.SafeString(request.userId, "") + "/Items" + Url.BuildQueryString(params)
    response = HttpClient.Request(requestUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.token))
    m.log.write("HTTP page completed libraryId=" + Format.SafeString(request.libraryId, "") + " startIndex=" + startIndex.ToStr() + " elapsedMs=" + requestTimer.TotalMilliseconds().ToStr() + " ok=" + (response.ok = true).ToStr())
    if response.ok <> true then
        m.log.error("Album request failed libraryId=" + Format.SafeString(request.libraryId, "") + " message=" + Format.SafeString(response.errorMessage, ""))
        response.AddReplace("action", "musicLibrary")
        response.AddReplace("libraryId", Format.SafeString(request.libraryId, ""))
        response.AddReplace("queryId", Number.ToInteger(request.queryId, 0))
        m.top.response = response
        return
    end if

    albums = getItemsFromPayload(response.data)
    m.top.response = {
        ok: true
        action: "musicLibrary"
        libraryId: Format.SafeString(request.libraryId, "")
        payload: response.data
        startIndex: startIndex
        nextStartIndex: startIndex + albums.Count()
        hasMore: hasMoreAlbumPages(response.data, startIndex, albums.Count(), pageSize)
        totalRecordCount: getAlbumTotalRecordCount(response.data)
        queryId: Number.ToInteger(request.queryId, 0)
    }
end sub

'-------------------------------------------------------------------------------
' getAlbumSortBy
'-------------------------------------------------------------------------------
function getAlbumSortBy(request as object) as string
    sortBy = Format.SafeString(request.albumSortBy, "SortName")
    if sortBy = "AlbumArtist,SortName" or sortBy = "ProductionYear,SortName" then return sortBy
    return "SortName"
end function

'-------------------------------------------------------------------------------
' getAlbumSortOrder
'-------------------------------------------------------------------------------
function getAlbumSortOrder(request as object) as string
    if Format.SafeString(request.albumSortOrder, "Ascending") = "Descending" then return "Descending"
    return "Ascending"
end function

'-------------------------------------------------------------------------------
' getAlbumTotalRecordCount
'-------------------------------------------------------------------------------
function getAlbumTotalRecordCount(payload as dynamic) as integer
    if Arrays.IsAssocArray(payload) = false then return -1
    return Number.ToInteger(payload.TotalRecordCount, -1)
end function

'-------------------------------------------------------------------------------
' hasMoreAlbumPages
'-------------------------------------------------------------------------------
function hasMoreAlbumPages(payload as dynamic, startIndex as integer, pageCount as integer, pageSize as integer) as boolean
    if pageCount < pageSize then return false
    if Arrays.IsAssocArray(payload) = false then return true

    totalRecordCount = Number.ToInteger(payload.TotalRecordCount, -1)
    return totalRecordCount < 0 or startIndex + pageCount < totalRecordCount
end function

'-------------------------------------------------------------------------------
' getItemsFromPayload
'-------------------------------------------------------------------------------
function getItemsFromPayload(payload as dynamic) as object
    if payload = invalid then return []
    if Type(payload) = "roArray" then return payload
    if Arrays.IsAssocArray(payload) = false then
        m.log.error("Unexpected album payload type=" + Type(payload))
        return []
    end if
    if Type(payload.Items) = "roArray" then return payload.Items

    m.log.error("Album payload Items is not an array")
    return []
end function

'-------------------------------------------------------------------------------
' validateRequest
'-------------------------------------------------------------------------------
function validateRequest(request as dynamic) as dynamic
    if request = invalid then return { ok: false, action: "musicLibrary", errorMessage: "Invalid music library request." }
    if request.server = invalid or request.server = "" then return { ok: false, action: "musicLibrary", errorMessage: "Invalid music library server." }
    if request.token = invalid or request.token = "" then return { ok: false, action: "musicLibrary", errorMessage: "Invalid music library token." }
    if request.userId = invalid or request.userId = "" then return { ok: false, action: "musicLibrary", errorMessage: "Invalid music library user." }
    if request.libraryId = invalid or request.libraryId = "" then return { ok: false, action: "musicLibrary", errorMessage: "Invalid music library item." }

    return invalid
end function
