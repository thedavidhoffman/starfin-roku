<?xml version="1.0" encoding="utf-8"?>
<component name="ScreensaverOverlay" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/source/Number.bs" />
  <script type="text/brightscript" uri="pkg:/source/PlaybackMode.bs" />
  <script type="text/brightscript" uri="pkg:/source/store/RegistryStore.bs" />
  <script type="text/brightscript" uri="pkg:/source/store/SettingsStore.bs" />
  <script type="text/brightscript" uri="pkg:/components/screensavers/ScreensaverOverlay/ScreensaverOverlay.bs" />
  <interface>
    <field id="settings" type="assocarray" />
    <field id="artworkUri" type="string" />
    <field id="shown" type="boolean" alwaysNotify="true" />
    <field id="dismissed" type="boolean" alwaysNotify="true" />
    <function name="startDelay" />
    <function name="stopOverlay" />
    <function name="recordActivity" />
    <function name="isVisible" />
  </interface>
  <children>
    <Timer id="screensaverDelayTimer" repeat="false" />
    <Group id="screensaverLayer" />
  </children>
</component>
