<?xml version="1.0" encoding="utf-8"?>
<component name="Bounce" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/screensavers/Bounce/Bounce.bs" />
  <interface>
    <field id="artworkUri" type="string" onChange="updatePoster" />
  </interface>
  <children>
    <Rectangle width="1920" height="1080" color="0x000000FF" />
    <Poster id="poster" translation="[710,290]" width="500" height="500" uri="pkg:/images/music/album-placeholder-342x342.png" loadDisplayMode="scaleToFit" />
    <Animation id="bounceAnimation" easeFunction="linear">
      <Vector2DFieldInterpolator id="bounceInterpolator" fieldToInterp="poster.translation" />
    </Animation>
    <Timer id="bounceLegTimer" repeat="false" />
  </children>
</component>
