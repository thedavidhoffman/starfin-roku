<?xml version="1.0" encoding="utf-8"?>
<component name="MediaMetadataRow" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/controls/MediaMetadataRow/MediaMetadataRow.bs" />
  <interface>
    <field id="itemSpacings" type="floatarray" alias="layout.itemSpacings" />
    <field id="leadingText" type="string" onChange="render" />
    <field id="runtimeText" type="string" onChange="render" />
    <field id="officialRating" type="string" onChange="render" />
    <field id="ratings" type="assocarray" onChange="render" />
    <field id="availableWidth" type="float" value="1220" onChange="render" />
    <field id="truncateLeadingText" type="boolean" value="true" onChange="render" />
    <field id="scaleToFit" type="boolean" value="false" onChange="render" />
  </interface>
  <children>
    <Group id="inactiveMetadata" visible="false" />
    <LayoutGroup id="layout" layoutDirection="horiz" itemSpacings="[18]" vertAlignment="center">
    <Label id="leadingLabel" height="28" color="0xFFFFFFFF" font="font:SmallestBoldSystemFont" />
    <LayoutGroup id="runtimeGroup" layoutDirection="horiz" itemSpacings="[8]" vertAlignment="center" visible="false">
      <Poster width="26" height="26" uri="pkg:/images/icons/ratings/runtime-clock.png" loadDisplayMode="scaleToFit" />
      <Label id="runtimeLabel" height="28" color="0xFFFFFFFF" font="font:SmallestBoldSystemFont" />
    </LayoutGroup>
    <Group id="contentRatingGroup" visible="false">
      <Poster id="contentRatingBorder" width="64" height="32" uri="pkg:/images/icons/ratings/content-rating-border.9.png" loadDisplayMode="scaleToFill" />
      <!-- One-pixel optical adjustment balances the system font inside the border. -->
      <Label id="contentRatingLabel" width="180" translation="[8,3]" height="28" color="0xFFFFFFFF" font="font:SmallestBoldSystemFont" />
    </Group>
    <LayoutGroup id="ratingsGroup" layoutDirection="horiz" itemSpacings="[18]" vertAlignment="center">
      <LayoutGroup id="communityRatingGroup" layoutDirection="horiz" itemSpacings="[8]" vertAlignment="center" visible="false">
        <Poster width="26" height="26" uri="pkg:/images/icons/ratings/rating-star.png" loadDisplayMode="scaleToFit" />
        <Label id="communityRatingLabel" height="28" color="0xFFFFFFFF" font="font:SmallestBoldSystemFont" />
      </LayoutGroup>
      <LayoutGroup id="criticRatingGroup" layoutDirection="horiz" itemSpacings="[8]" vertAlignment="center" visible="false">
        <Poster id="criticRatingIcon" width="28" height="28" loadDisplayMode="scaleToFit" />
        <Label id="criticRatingLabel" height="28" color="0xFFFFFFFF" font="font:SmallestBoldSystemFont" />
      </LayoutGroup>
    </LayoutGroup>
    </LayoutGroup>
  </children>
</component>
