<?xml version="1.0" encoding="utf-8"?>
<component name="AccountBadge" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/controls/AccountBadge/AccountBadge.bs" />
  <interface>
    <field id="username" type="string" onChange="onUsernameChanged" />
    <field id="imageUri" type="string" onChange="onImageUriChanged" />
    <field id="backgroundColor" type="color" onChange="onColorsChanged" />
    <field id="ringColor" type="color" onChange="onColorsChanged" />
    <field id="glassColor" type="color" onChange="onColorsChanged" />
  </interface>
  <children>
    <Group id="badgeVisual">
      <Poster id="badgeImage" width="96" height="96" loadWidth="192" loadHeight="192" loadDisplayMode="scaleToZoom" />
      <Poster id="badgeMatte" width="96" height="96" uri="pkg:/images/header/fhd/account-badge-matte.png" />
      <Poster id="badgeRing" translation="[-3,-3]" width="102" height="102" uri="pkg:/images/header/fhd/account-badge-ring-overlay.png" />
      <Poster id="badgeGlass" translation="[-3,-3]" width="102" height="102" uri="pkg:/images/header/fhd/account-badge-glass-overlay.png" />
    </Group>
    <Label id="badgeName" translation="[122,24]" width="422" height="48" vertAlign="center" color="0xF6F7FBFF" font="font:MediumBoldSystemFont" />
  </children>
</component>
