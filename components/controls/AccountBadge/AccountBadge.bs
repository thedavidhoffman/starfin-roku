'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.badgeNodes = {
        visual: m.top.findNode("badgeVisual")
        ring: m.top.findNode("badgeRing")
        glass: m.top.findNode("badgeGlass")
        image: m.top.findNode("badgeImage")
        matte: m.top.findNode("badgeMatte")
        name: m.top.findNode("badgeName")
    }
    configureGeometry()
    onUsernameChanged()
    onImageUriChanged()
    onColorsChanged()
end sub

'-------------------------------------------------------------------------------
' configureGeometry
'-------------------------------------------------------------------------------
sub configureGeometry()
    m.badgeNodes.visual.scale = [1.0, 1.0]
    configureImageGeometry(96, 192)
    configureFrameGeometry(102, -3)
    m.badgeNodes.ring.uri = "pkg:/images/header/fhd/account-badge-ring-overlay.png"
    m.badgeNodes.glass.uri = "pkg:/images/header/fhd/account-badge-glass-overlay.png"
    m.badgeNodes.matte.uri = "pkg:/images/header/fhd/account-badge-matte.png"
end sub

'-------------------------------------------------------------------------------
' configureImageGeometry
'-------------------------------------------------------------------------------
sub configureImageGeometry(size as integer, loadSize as integer)
    m.badgeNodes.image.width = size
    m.badgeNodes.image.height = size
    m.badgeNodes.image.loadWidth = loadSize
    m.badgeNodes.image.loadHeight = loadSize
    m.badgeNodes.matte.width = size
    m.badgeNodes.matte.height = size
end sub

'-------------------------------------------------------------------------------
' configureFrameGeometry
'-------------------------------------------------------------------------------
sub configureFrameGeometry(size as integer, offset as integer)
    m.badgeNodes.ring.translation = [offset, offset]
    m.badgeNodes.ring.width = size
    m.badgeNodes.ring.height = size
    m.badgeNodes.glass.translation = [offset, offset]
    m.badgeNodes.glass.width = size
    m.badgeNodes.glass.height = size
end sub

'-------------------------------------------------------------------------------
' onUsernameChanged
'-------------------------------------------------------------------------------
sub onUsernameChanged()
    m.badgeNodes.name.text = m.top.username
end sub

'-------------------------------------------------------------------------------
' onImageUriChanged
'-------------------------------------------------------------------------------
sub onImageUriChanged()
    m.badgeNodes.image.uri = m.top.imageUri
end sub

'-------------------------------------------------------------------------------
' onColorsChanged
'-------------------------------------------------------------------------------
sub onColorsChanged()
    m.badgeNodes.matte.blendColor = m.top.backgroundColor
    m.badgeNodes.ring.blendColor = m.top.ringColor
    m.badgeNodes.glass.blendColor = m.top.glassColor
end sub
