import "pkg:/source/MediaOptionsSession.bs"
import "pkg:/source/Format.bs"
import "pkg:/source/String.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.activeOverlay = invalid
    m.activeRequest = invalid
end sub

'-------------------------------------------------------------------------------
' openOverlay
'-------------------------------------------------------------------------------
function openOverlay(request as dynamic) as dynamic
    if request = invalid then return invalid

    closeOverlay()

    componentName = request.componentName
    if componentName = invalid or componentName = "" then return invalid

    overlay = CreateObject("roSGNode", componentName)
    if overlay = invalid then return invalid

    applyOverlayRequestFields(overlay, request)

    closeFields = getCloseFields(request)
    for each closeField in closeFields
        if closeField <> invalid and closeField <> "" then overlay.observeFieldScoped(closeField, "onOverlayClosed")
    end for
    eventFields = getEventFields(request)
    for each eventField in eventFields
        if eventField <> invalid and eventField <> "" then overlay.observeFieldScoped(eventField, "onOverlayEventRaised")
    end for

    m.top.appendChild(overlay)
    m.activeOverlay = overlay
    m.activeRequest = request

    openFunction = request.openFunction
    if openFunction <> invalid and openFunction <> "" then overlay.callFunc(openFunction)

    return overlay
end function

'-------------------------------------------------------------------------------
' updateOverlay
'-------------------------------------------------------------------------------
sub updateOverlay(request as dynamic)
    if m.activeOverlay = invalid or request = invalid then return
    if m.activeRequest = invalid then return
    if Format.SafeString(request.id, "") <> Format.SafeString(m.activeRequest.id, "") then return

    applyOverlayRequestFields(m.activeOverlay, request)
end sub

'-------------------------------------------------------------------------------
' applyOverlayRequestFields
'-------------------------------------------------------------------------------
sub applyOverlayRequestFields(overlay as object, request as object)
    requestId = Format.SafeString(request.id, "")

    if requestId = "serverDiscovery" then
        overlay.currentAddress = Format.SafeString(request.currentAddress, "")
        return
    end if

    if requestId = "message" then
        overlay.message = request.message
        return
    end if

    if requestId = "settings" then
        overlay.accountKey = Format.SafeString(request.accountKey, "")
        return
    end if

    if requestId = "accountPicker" then
        overlay.accounts = request.accounts
        return
    end if

    if requestId = "sort" then
        overlay.selectedSortKey = request.selectedSortKey
        if request.sortOptions <> invalid then overlay.sortOptions = request.sortOptions
        return
    end if

    if requestId = "personOverview" then
        overlay.personName = request.personName
        overlay.overviewText = request.overviewText
        return
    end if

    if requestId = "description" then
        overlay.title = request.title
        overlay.text = request.text
        return
    end if

    if requestId = MediaOptionsSession.Overlay.Options then
        overlay.optionsContext = request.optionsContext
        return
    end if

    if requestId = "mediaActions" then
        overlay.item = request.item
        overlay.itemImageUrl = Format.SafeString(request.itemImageUrl, "")
        return
    end if

    if requestId <> "letterGrid" then return

    if request.selectedLetter <> invalid then overlay.activeLetter = Format.SafeString(request.selectedLetter, "ALL")
    if request.panelX <> invalid then overlay.panelX = request.panelX
    if request.panelY <> invalid then overlay.panelY = request.panelY
    if request.statusText <> invalid then overlay.statusText = request.statusText
end sub

'-------------------------------------------------------------------------------
' getCloseFields
'-------------------------------------------------------------------------------
function getCloseFields(request as dynamic) as object
    if request <> invalid and request.closeFields <> invalid then return request.closeFields
    if request <> invalid and request.closeField <> invalid then return [request.closeField]

    return []
end function

'-------------------------------------------------------------------------------
' getEventFields
'-------------------------------------------------------------------------------
function getEventFields(request as dynamic) as object
    if request <> invalid and request.eventFields <> invalid then return request.eventFields

    return []
end function

'-------------------------------------------------------------------------------
' closeOverlay
'-------------------------------------------------------------------------------
sub closeOverlay(notifyCancellation = true as boolean)
    if m.activeOverlay = invalid then return

    for each field in getCloseFields(m.activeRequest)
        if field <> invalid and field <> "" then m.activeOverlay.unobserveFieldScoped(field)
    end for
    for each field in getEventFields(m.activeRequest)
        if field <> invalid and field <> "" then m.activeOverlay.unobserveFieldScoped(field)
    end for
    if m.activeRequest <> invalid and m.activeRequest.id = "serverDiscovery" then
        m.activeOverlay.callFunc("cancelDiscovery")
    end if
    cancelledRequest = m.activeRequest
    m.top.removeChild(m.activeOverlay)
    m.activeOverlay = invalid
    m.activeRequest = invalid
    if notifyCancellation and cancelledRequest <> invalid and cancelledRequest.id = MediaOptionsSession.Overlay.Options then
        m.top.closed = { request: cancelledRequest, overlay: invalid, cancelled: true }
    end if
end sub

'-------------------------------------------------------------------------------
' onOverlayClosed
'-------------------------------------------------------------------------------
sub onOverlayClosed(event as object)
    if m.activeOverlay = invalid or m.activeRequest = invalid then return

    if not event.getRoSGNode().isSameNode(m.activeOverlay) then return
    closedOverlay = m.activeOverlay
    closedRequest = m.activeRequest
    closeOverlay(false)
    m.top.closed = {
        overlay: closedOverlay
        request: closedRequest
    }
end sub

'-------------------------------------------------------------------------------
' onOverlayEventRaised
'-------------------------------------------------------------------------------
sub onOverlayEventRaised(event as object)
    if m.activeOverlay = invalid or m.activeRequest = invalid then return

    if not event.getRoSGNode().isSameNode(m.activeOverlay) then return
    field = event.getField()
    m.top.eventRaised = {
        field: field
        value: m.activeOverlay[field]
        request: m.activeRequest
    }
end sub
