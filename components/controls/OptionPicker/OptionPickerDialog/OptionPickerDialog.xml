<?xml version="1.0" encoding="utf-8"?>
<component name="OptionPickerDialog" extends="Dialog">
  <script type="text/brightscript" uri="pkg:/source/Format.brs" />
  <script type="text/brightscript" uri="pkg:/source/String.brs" />
  <script type="text/brightscript" uri="pkg:/components/controls/OptionPicker/OptionPickerDialog/OptionPickerDialog.brs" />
  <interface>
    <field id="dialogTitle" type="string" onChange="onPickerConfigChanged" />
    <field id="options" type="array" onChange="onPickerConfigChanged" />
    <field id="selectedKey" type="string" onChange="onSelectedKeyChanged" />
    <field id="allowDefaultSelection" type="boolean" value="true" onChange="onPickerConfigChanged" />
    <field id="emptyText" type="string" onChange="onPickerConfigChanged" />
    <field id="closeOnSelect" type="boolean" value="false" />
    <field id="selectedOption" type="assocarray" alwaysNotify="true" />
    <field id="selectedOptionChanged" type="boolean" value="false" />
    <function name="openOptions" />
  </interface>
</component>
