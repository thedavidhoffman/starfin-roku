<?xml version="1.0" encoding="utf-8"?>
<component name="OptionPickerContent" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/source/Format.brs" />
  <script type="text/brightscript" uri="pkg:/source/String.brs" />
  <script type="text/brightscript" uri="pkg:/source/Color.brs" />
  <script type="text/brightscript" uri="pkg:/components/controls/OptionPicker/OptionPickerContent/OptionPickerContent.brs" />
  <interface>
    <field id="options" type="array" onChange="onOptionsChanged" />
    <field id="selectedKey" type="string" onChange="onSelectedKeyChanged" />
    <field id="allowDefaultSelection" type="boolean" value="true" onChange="onAllowDefaultSelectionChanged" />
    <field id="emptyText" type="string" onChange="onEmptyTextChanged" />
    <field id="visibleRowCount" type="integer" value="1" onChange="onVisibleRowCountChanged" />
    <field id="optionSelected" type="assocarray" alwaysNotify="true" />
    <function name="configureOptions" />
    <function name="focusOptions" />
    <function name="getSelectedOption" />
  </interface>
  <children>
    <Label
      id="emptyLabel"
      translation="[0,-30]"
      width="600"
      height="40"
      visible="false"
      color="0xB9C7D6FF"
      font="font:SmallSystemFont" />

    <RadioButtonList
      id="optionList"
      translation="[0,-38]"
      itemSize="[600,52]"
      numRows="6"
      checkedItem="-1"
      visible="false"
      vertFocusAnimationStyle="floatingFocus"
      fadeFocusFeedbackWhenAutoScrolling="false"
      focusFootprintBitmapUri="pkg:/images/focus/transparent_focus_footprint.9.png" />
  </children>
</component>
