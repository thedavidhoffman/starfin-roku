<?xml version="1.0" encoding="utf-8"?>
<component name="MessageContent" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/components/controls/Message/MessageContent/MessageContent.bs" />
  <interface>
    <field id="message" type="string" onChange="onMessageChanged" />
    <field id="preferredHeight" type="integer" value="420" />
    <field id="acknowledged" type="boolean" alwaysNotify="true" />
    <function name="focusAcknowledgment" />
  </interface>
  <children>
    <Group id="viewport">
      <Label id="messageLabel" wrap="true" color="0xF3F7FBFF" font="font:SmallSystemFont" />
    </Group>
    <Rectangle id="scrollTrack" width="4" color="0xF3F7FB33" visible="false" />
    <Rectangle id="scrollThumb" width="4" color="0xF3F7FBFF" visible="false" />
    <PrimaryButton id="okButton" text="OK" buttonHeight="56" />
  </children>
</component>
