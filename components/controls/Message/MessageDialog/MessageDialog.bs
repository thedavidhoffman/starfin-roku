'-------------------------------------------------------------------------------
' openMessage
'-------------------------------------------------------------------------------
sub openMessage()
    m.top.title = "Message"
    m.top.dialogWidth = 800
    m.top.showButtons = false
    m.top.contentComponentName = "MessageContent"
    content = m.top.callFunc("getContentComponent")
    content.observeField("acknowledged", "onAcknowledged")
    onMessageChanged()
    m.top.callFunc("openDialog")
    focusAcknowledgment()
end sub

'-------------------------------------------------------------------------------
' onMessageChanged
'-------------------------------------------------------------------------------
sub onMessageChanged()
    content = m.top.callFunc("getContentComponent")
    if content = invalid then return
    content.message = m.top.message
    m.top.dialogHeight = content.preferredHeight
end sub

'-------------------------------------------------------------------------------
' focusAcknowledgment
'-------------------------------------------------------------------------------
sub focusAcknowledgment()
    content = m.top.callFunc("getContentComponent")
    if content <> invalid then content.callFunc("focusAcknowledgment")
end sub

'-------------------------------------------------------------------------------
' onAcknowledged
'-------------------------------------------------------------------------------
sub onAcknowledged()
    m.top.callFunc("closeDialog")
end sub
