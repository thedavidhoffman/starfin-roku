<?xml version="1.0" encoding="utf-8"?>
<component name="Dialog" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/components/controls/Dialog/Dialog.brs" />
  <interface>
    <field id="title" type="string" onChange="onTitleChanged" />
    <field id="dialogWidth" type="integer" onChange="onDialogSizeChanged" />
    <field id="dialogHeight" type="integer" onChange="onDialogSizeChanged" />
    <field id="contentComponentName" type="string" onChange="onContentComponentNameChanged" />
    <field id="showButtons" type="boolean" onChange="onShowButtonsChanged" />
    <field id="saveButtonText" type="string" onChange="onButtonTextChanged" />
    <field id="cancelButtonText" type="string" onChange="onButtonTextChanged" />
    <field id="saveSelected" type="boolean" alwaysNotify="true" />
    <field id="cancelSelected" type="boolean" alwaysNotify="true" />
    <field id="closeRequested" type="boolean" alwaysNotify="true" />
    <function name="openDialog" />
    <function name="closeDialog" />
    <function name="getContentComponent" />
    <function name="focusContent" />
    <function name="focusSaveButton" />
    <function name="focusCancelButton" />
  </interface>
  <children>
    <Group id="dialog">

      <!-- dialog page backdrop -->
      <Rectangle
        id="backdrop"
        width="1920"
        height="1080"
        color="0x000000AA" />

      <!-- 9-patch image dialog body -->
      <Poster
        id="panel"
        translation="[120,90]"
        width="1680"
        height="900"
        uri="pkg:/images/frames/option-panel-border.9.png"
        loadDisplayMode="scaleToFill" />

      <!-- title -->
      <LabelHeading
        id="titleLabel"
        translation="[180,150]"
        width="1560"
        height="56" />

      <Rectangle
        id="titleRule"
        translation="[180,216]"
        width="1560"
        height="2" />

      <!-- content -->
      <Group
        id="content"
        translation="[180,260]" />

      <!-- footer -->
      <Rectangle
        id="footer"
        visible="false" />

      <PrimaryButton
        id="saveButton"
        visible="false"
        buttonWidth="120"
        buttonHeight="56"
        text="Save" />
      
      <PrimaryButton
        id="cancelButton"
        visible="false"
        buttonWidth="160"
        buttonHeight="56"
        text="Cancel" />

    </Group>
  </children>
</component>
