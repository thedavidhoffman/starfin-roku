<?xml version="1.0" encoding="utf-8"?>
<component name="SettingsCard" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/controls/SettingsCard/SettingsCard.bs" />
  <interface>
    <function name="updateCard" />
    <function name="getHeadingWidth" />
    <field id="title" type="string" />
    <field id="cardWidth" type="float" value="1040" />
    <field id="cardHeight" type="float" value="188" />
    <field id="headingY" type="float" value="24" />
    <field id="description" type="string" />
    <field id="descriptionHeight" type="float" value="40" />
    <field id="descriptionTop" type="float" value="-1" />
  </interface>
  <children>
    <Poster id="background" loadDisplayMode="scaleToFill" />
    <Label id="heading" height="36" font="font:SmallBoldSystemFont" />
    <Label id="descriptionLabel" wrap="true" font="font:SmallestSystemFont" color="0xB7C5D4FF" />
  </children>
</component>
