import "pkg:/source/ResolutionProfile.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.card = {
        background: m.top.findNode("background"), heading: m.top.findNode("heading"), description: m.top.findNode("descriptionLabel")
    }
    m.card.background.uri = "pkg:/images/settings/" + ResolutionProfile.GetName() + "/settings-card-glass.9.png"
    initHandlers()
    updateCard()
end sub

'-------------------------------------------------------------------------------
' initHandlers
'-------------------------------------------------------------------------------
sub initHandlers()
    ' Register after references exist; init renders the current field values.
    for each fieldName in ["title", "cardWidth", "cardHeight", "headingY", "description", "descriptionHeight", "descriptionTop"]
        m.top.observeField(fieldName, "updateCard")
    end for
end sub

'-------------------------------------------------------------------------------
' updateCard
'-------------------------------------------------------------------------------
sub updateCard()
    m.card.background.translation = [3, 3]
    m.card.background.width = m.top.cardWidth - 6
    m.card.background.height = m.top.cardHeight - 6
    inset = 24
    m.card.heading.translation = [inset, m.top.headingY]
    m.card.heading.width = m.top.cardWidth - 2 * inset
    m.card.heading.text = UCase(m.top.title)
    descriptionY = m.top.descriptionTop
    if descriptionY < 0 then descriptionY = m.top.cardHeight - m.top.descriptionHeight - 6
    m.card.description.translation = [inset, descriptionY]
    m.card.description.width = m.top.cardWidth - 2 * inset
    m.card.description.height = m.top.descriptionHeight
    m.card.description.text = m.top.description
    m.card.description.visible = m.top.description <> ""
    ' Native radio focus extends beyond itemSize on both sides.
    radioFocusOverhang = 32
    radioInset = inset + radioFocusOverhang
    for each child in m.top.getChildren(-1, 0)
        if child.subtype() = "RadioButtonList" then
            if child.translation[0] <> radioInset then child.translation = [radioInset, child.translation[1]]
            radioWidth = m.top.cardWidth - 2 * radioInset
            if child.itemSize[0] <> radioWidth then child.itemSize = [radioWidth, child.itemSize[1]]
        end if
    end for
end sub

'-------------------------------------------------------------------------------
' getHeadingWidth
'-------------------------------------------------------------------------------
function getHeadingWidth() as float
    ' Measure the full heading independently of the card's current clipping width.
    measurement = CreateObject("roSGNode", "Label")
    measurement.font = m.card.heading.font
    measurement.text = UCase(m.top.title)
    return measurement.boundingRect().width
end function
