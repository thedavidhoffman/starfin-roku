<?xml version="1.0" encoding="utf-8"?>
<component name="ThemeBackground" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/controls/ThemeBackground/ThemeBackground.bs" />
  <interface>
    <field id="width" type="float" value="1920" onChange="updateSize" />
    <field id="height" type="float" value="1080" onChange="updateSize" />
  </interface>
  <children>
    <Rectangle id="fill" width="1920" height="1080" color="0x000000FF" />
    <Poster id="gradient" uri="pkg:/images/themes/blue/background.png" width="1920" height="1080" loadDisplayMode="scaleToFill" />
  </children>
</component>
