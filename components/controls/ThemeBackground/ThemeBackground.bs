import "pkg:/source/Theme.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    initReferences()
    initHandlers()
    updateSize()
    updateTheme()
end sub

'-------------------------------------------------------------------------------
' initReferences
'-------------------------------------------------------------------------------
sub initReferences()
    m.background = {
        fill: m.top.findNode("fill")
        gradient: m.top.findNode("gradient")
    }
end sub

'-------------------------------------------------------------------------------
' initHandlers
'-------------------------------------------------------------------------------
sub initHandlers()
    m.global.observeField("theme", "updateTheme")
end sub

'-------------------------------------------------------------------------------
' updateSize
'-------------------------------------------------------------------------------
sub updateSize()
    m.background.fill.width = m.top.width
    m.background.fill.height = m.top.height
    m.background.gradient.width = m.top.width
    m.background.gradient.height = m.top.height
end sub

'-------------------------------------------------------------------------------
' updateTheme
'-------------------------------------------------------------------------------
sub updateTheme()
    mode = Theme.Normalize(m.global.theme)
    m.background.fill.color = Theme.BackgroundColor(mode)
    ' Keep the opaque theme color underneath while its gradient image loads.
    m.background.gradient.uri = Theme.BackgroundUri(mode)
end sub
