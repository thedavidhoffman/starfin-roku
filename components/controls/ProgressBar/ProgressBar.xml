<?xml version="1.0" encoding="utf-8"?>
<component name="ProgressBar" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/controls/ProgressBar/ProgressBar.bs" />
  <interface>
    <field id="barWidth" type="float" value="230" onChange="onLayoutChanged" />
    <field id="barHeight" type="float" value="10" onChange="onLayoutChanged" />
    <field id="progressWidth" type="float" value="0" onChange="onProgressChanged" />
  </interface>
  <children>
    <Poster id="border" translation="[-1,-1]" width="232" height="12" uri="pkg:/images/progress/progress-border.9.png" loadDisplayMode="scaleToFill" />
    <Poster id="background" width="230" height="10" uri="pkg:/images/progress/progress-track.9.png" loadDisplayMode="scaleToFill" />
    <Poster id="fill" width="0" height="10" uri="pkg:/images/progress/progress-fill.9.png" loadDisplayMode="scaleToFill" />
  </children>
</component>
