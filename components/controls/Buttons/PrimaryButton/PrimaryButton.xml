<?xml version="1.0" encoding="utf-8"?>
<component name="PrimaryButton" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/controls/Buttons/PrimaryButton/PrimaryButton.bs" />
  <interface>
    <field id="text" type="string" onChange="onTextChanged" />
    <field id="iconUri" type="string" onChange="onIconUriChanged" />
    <field id="focusedIconUri" type="string" onChange="onIconUriChanged" />
    <field id="buttonWidth" type="float" value="300" onChange="onDimensionsChanged" />
    <field id="buttonHeight" type="float" value="56" onChange="onDimensionsChanged" />
    <field id="textFont" type="string" value="font:MediumSystemFont" onChange="onTextFontChanged" />
    <field id="textHeight" type="float" value="32" onChange="onDimensionsChanged" />
    <field id="iconGap" type="float" value="12" onChange="onDimensionsChanged" />
    <field id="contentOffsetX" type="float" onChange="onDimensionsChanged" />
    <field id="hasFocusVisual" type="boolean" onChange="onFocusVisualChanged" />
    <field id="buttonSelected" type="boolean" alwaysNotify="true" />
    <function name="getPreferredWidth" />
  </interface>
  <children>
    <Poster id="bg" width="300" height="56" loadDisplayMode="scaleToFill" />
    <Poster id="icon" visible="false" width="24" height="24" loadDisplayMode="scaleToFit" />
    <Label id="textLabel" translation="[0,12]" width="300" horizAlign="center" font="font:MediumSystemFont" />
  </children>
</component>
