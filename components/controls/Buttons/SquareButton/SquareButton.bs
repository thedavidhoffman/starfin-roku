import "pkg:/source/Format.bs"
import "pkg:/source/String.bs"
import "pkg:/source/Number.bs"
import "pkg:/source/ResolutionAssets.bs"
import "pkg:/source/ResolutionProfile.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.background = m.top.findNode("background")
    m.focusBackground = m.top.findNode("focusBackground")
    m.selectedBackground = m.top.findNode("selectedBackground")
    m.letterLabel = m.top.findNode("letterLabel")
    m.top.observeField("focusedChild", "onFocusChanged")
    updateFocusVisual()
end sub

'-------------------------------------------------------------------------------
' onFocusChanged
'-------------------------------------------------------------------------------
sub onFocusChanged()
    m.top.itemHasFocus = m.top.isInFocusChain()
end sub

'-------------------------------------------------------------------------------
' onItemContentChanged
'-------------------------------------------------------------------------------
sub onItemContentChanged()
    item = m.top.itemContent
    if item = invalid then return

    m.letterLabel.text = Format.SafeString(item.title, "")
end sub

'-------------------------------------------------------------------------------
' onItemHasFocusChanged
'-------------------------------------------------------------------------------
sub onItemHasFocusChanged()
    updateFocusVisual()
end sub

'-------------------------------------------------------------------------------
' onSelectionChanged
'-------------------------------------------------------------------------------
sub onSelectionChanged()
    updateFocusVisual()
end sub

'-------------------------------------------------------------------------------
' onItemWidthChanged
'-------------------------------------------------------------------------------
sub onItemWidthChanged()
    width = Number.ToInteger(m.top.itemWidth, 64)
    if width > 64 then
        m.background.uri = ResolutionAssets.GetButtonImageUri("primary-focused.9.png")
        m.background.blendColor = &h092452FF
        m.selectedBackground.uri = ResolutionAssets.GetButtonImageUri("primary-focused.9.png")
        m.selectedBackground.blendColor = &hF3F7FBFF
        m.focusBackground.uri = ResolutionAssets.GetButtonImageUri("primary-focused.9.png")
        m.focusBackground.blendColor = &hF3F7FBFF
    end if
    m.background.width = width
    m.selectedBackground.width = width
    m.focusBackground.width = width
    m.letterLabel.width = width - 1
end sub

'-------------------------------------------------------------------------------
' updateFocusVisual
'-------------------------------------------------------------------------------
sub updateFocusVisual()
    if m.background = invalid or m.focusBackground = invalid or m.letterLabel = invalid then return

    hasFocus = m.top.itemHasFocus = true
    isSelected = m.top.isSelected = true
    m.focusBackground.visible = hasFocus
    m.selectedBackground.visible = isSelected and hasFocus = false

    if hasFocus or isSelected then
        m.letterLabel.color = &h0F1A2AFF
    else
        m.letterLabel.color = &hF3F7FBFF
    end if
end sub

'-------------------------------------------------------------------------------
' onKeyEvent
'-------------------------------------------------------------------------------
function onKeyEvent(key as string, press as boolean) as boolean
    if press = false then return false

    normalizedKey = LCase(key)
    if normalizedKey = "ok" or normalizedKey = "select" then
        m.top.buttonSelected = true
        return true
    end if

    return false
end function
