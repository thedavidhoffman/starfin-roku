'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    initReferences()
    m.state = {
        isFocused: false
    }
    m.assets = {
        restBg: "pkg:/images/buttons/previous-next-button-unfocused.9.png"
        focusBg: "pkg:/images/buttons/previous-next-button-focused.9.png"
    }
    updateStyles()
end sub

'-------------------------------------------------------------------------------
' initReferences
'-------------------------------------------------------------------------------
sub initReferences()
    m.bg = m.top.findNode("bg")
    m.previousChevron = m.top.findNode("previousChevron")
    m.nextChevron = m.top.findNode("nextChevron")
end sub

'-------------------------------------------------------------------------------
' onAvailabilityChanged
'-------------------------------------------------------------------------------
sub onAvailabilityChanged()
    updateStyles()
end sub

'-------------------------------------------------------------------------------
' activate
'-------------------------------------------------------------------------------
sub activate()
    m.state.isFocused = true
    m.top.setFocus(true)
    updateStyles()
end sub

'-------------------------------------------------------------------------------
' deactivate
'-------------------------------------------------------------------------------
sub deactivate()
    m.state.isFocused = false
    updateStyles()
end sub

'-------------------------------------------------------------------------------
' updateStyles
'-------------------------------------------------------------------------------
sub updateStyles()
    hasNavigation = m.top.hasPrevious = true or m.top.hasNext = true
    m.top.visible = m.top.displayEnabled = true and hasNavigation
    m.bg.visible = true
    if m.state.isFocused = true then
        m.bg.uri = m.assets.focusBg
    else
        m.bg.uri = m.assets.restBg
    end if

    m.previousChevron.visible = true
    m.nextChevron.visible = true

    m.previousChevron.opacity = getChevronOpacity(m.top.hasPrevious = true)
    m.nextChevron.opacity = getChevronOpacity(m.top.hasNext = true)
end sub

'-------------------------------------------------------------------------------
' getChevronOpacity
'-------------------------------------------------------------------------------
function getChevronOpacity(isAvailable as boolean) as float
    if m.state.isFocused = true and isAvailable = true then return 1.0
    return 0.35
end function

'-------------------------------------------------------------------------------
' onKeyEvent
'-------------------------------------------------------------------------------
function onKeyEvent(key as string, press as boolean) as boolean
    if press = false then return false

    if key = "left" and m.top.hasPrevious = true then
        m.top.previousSelected = true
        return true
    end if

    if key = "right" and m.top.hasNext = true then
        m.top.nextSelected = true
        return true
    end if

    return false
end function
