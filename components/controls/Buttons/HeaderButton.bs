import "pkg:/source/Number.bs"
import "pkg:/source/ResolutionAssets.bs"
import "pkg:/source/ResolutionProfile.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.background = m.top.findNode("bg")
    m.textLabel = m.top.findNode("textLabel")
    m.background.uri = ResolutionAssets.GetButtonImageUri("header-button-focused.9.png")
    if m.top.headerBgColor = 0 then m.top.headerBgColor = &h12112BFF
    m.top.observeField("focusedChild", "onFocusChanged")
    onDimensionsChanged()
    onTextLayoutChanged()
    onTextChanged()
    onFocusVisualChanged()
end sub

'-------------------------------------------------------------------------------
' onTextChanged
'-------------------------------------------------------------------------------
sub onTextChanged()
    m.textLabel.text = m.top.text
end sub

'-------------------------------------------------------------------------------
' onDimensionsChanged
'-------------------------------------------------------------------------------
sub onDimensionsChanged()
    width = getButtonWidth()
    height = getButtonHeight()

    m.background.width = width
    m.background.height = height

    updateTextLayout(width, height)
end sub

'-------------------------------------------------------------------------------
' onTextLayoutChanged
'-------------------------------------------------------------------------------
sub onTextLayoutChanged()
    updateTextLayout(getButtonWidth(), getButtonHeight())
end sub

'-------------------------------------------------------------------------------
' updateTextLayout
'-------------------------------------------------------------------------------
sub updateTextLayout(width as integer, height as integer)
    inset = Number.ToInteger(m.top.textInset, 0)
    if inset < 0 then inset = 0
    if inset * 2 >= width then inset = 0

    m.textLabel.horizAlign = getTextAlign()
    m.textLabel.width = width - (inset * 2)
    m.textLabel.translation = [inset, Number.ToInteger((height - 28) / 2, 0)]
end sub

'-------------------------------------------------------------------------------
' getTextAlign
'-------------------------------------------------------------------------------
function getTextAlign() as string
    align = LCase(m.top.textAlign)
    if align = "left" or align = "right" then return align
    return "center"
end function

'-------------------------------------------------------------------------------
' getButtonWidth
'-------------------------------------------------------------------------------
function getButtonWidth() as integer
    width = Number.ToInteger(m.top.buttonWidth, 300)
    if width > 0 then return width
    return 300
end function

'-------------------------------------------------------------------------------
' getButtonHeight
'-------------------------------------------------------------------------------
function getButtonHeight() as integer
    height = Number.ToInteger(m.top.buttonHeight, 56)
    if height > 0 then return height
    return 56
end function

'-------------------------------------------------------------------------------
' onFocusVisualChanged
'-------------------------------------------------------------------------------
sub onFocusVisualChanged()
    hasFocusVisual = m.top.hasFocusVisual = true
    hasActiveVisual = m.top.hasActiveVisual = true

    if hasFocusVisual then
        m.background.visible = true
        m.background.opacity = 1
    else if hasActiveVisual then
        m.background.visible = true
        m.background.opacity = 0.58
    else
        m.background.visible = false
        m.background.opacity = 1
    end if

    if hasFocusVisual or hasActiveVisual then
        m.textLabel.color = m.top.headerBgColor
    else
        m.textLabel.color = &hFFFFFFFF
    end if
end sub

'-------------------------------------------------------------------------------
' onFocusChanged
'-------------------------------------------------------------------------------
sub onFocusChanged()
    m.top.hasFocusVisual = m.top.isInFocusChain()
end sub

'-------------------------------------------------------------------------------
' onKeyEvent
'-------------------------------------------------------------------------------
function onKeyEvent(key as string, press as boolean) as boolean
    if press = false then return false

    if key = "OK" or key = "select" then
        m.top.buttonSelected = true
        return true
    end if

    return false
end function
