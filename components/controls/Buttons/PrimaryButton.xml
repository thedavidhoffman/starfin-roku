<?xml version="1.0" encoding="utf-8"?>
<component name="PrimaryButton" extends="Group">
  <script type="text/brightscript" uri="pkg:/source/ButtonAssets.brs" />
  <script type="text/brightscript" uri="pkg:/source/ResolutionProfile.brs" />
  <script type="text/brightscript" uri="pkg:/source/ResolutionAssets.brs" />
  <script type="text/brightscript" uri="pkg:/source/Number.brs" />
  <script type="text/brightscript" uri="pkg:/components/controls/Buttons/PrimaryButton.brs" />
  <interface>
    <field id="text" type="string" onChange="onTextChanged" />
    <field id="iconUri" type="string" onChange="onIconUriChanged" />
    <field id="focusedIconUri" type="string" onChange="onIconUriChanged" />
    <field id="buttonWidth" type="float" onChange="onDimensionsChanged" />
    <field id="buttonHeight" type="float" onChange="onDimensionsChanged" />
    <field id="textFont" type="string" onChange="onTextFontChanged" />
    <field id="textHeight" type="float" onChange="onDimensionsChanged" />
    <field id="iconGap" type="float" onChange="onDimensionsChanged" />
    <field id="contentOffsetX" type="float" onChange="onDimensionsChanged" />
    <field id="hasFocusVisual" type="boolean" onChange="onFocusVisualChanged" />
    <field id="buttonSelected" type="boolean" alwaysNotify="true" />
    <function name="getPreferredWidth" />
  </interface>
  <children>
    <Poster id="bg" width="300" height="56" uri="pkg:/images/buttons/primary_focused.9.png" loadDisplayMode="scaleToFill" />
    <Poster id="icon" visible="false" width="24" height="24" loadDisplayMode="scaleToFit" />
    <Label id="textLabel" translation="[0,12]" width="300" horizAlign="center" font="font:MediumSystemFont" />
  </children>
</component>
