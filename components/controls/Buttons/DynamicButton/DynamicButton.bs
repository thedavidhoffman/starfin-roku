import "pkg:/source/Remote.bs"
import "pkg:/source/Format.bs"
import "pkg:/source/String.bs"
import "pkg:/source/TextMeasurement.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.background = m.top.findNode("background")
    m.iconPoster = m.top.findNode("iconPoster")
    m.textLabel = m.top.findNode("textLabel")
    m.measurementLabel = CreateObject("roSGNode", "Label")
    m.layout = {
        collapsedWidth: 64
        expandedWidth: 168
        height: 58
        iconSize: 32
        iconX: 16
        iconY: 13
        textX: 60
        textY: 15
        rightPadding: 16
        textPadding: 8
        measuredTextWidth: 0
    }
    m.top.observeField("focusedChild", "onFocusChanged")
    onTextChanged()
    onIconChanged()
    onFocusVisualChanged()
end sub

'-------------------------------------------------------------------------------
' onTextChanged
'-------------------------------------------------------------------------------
sub onTextChanged()
    m.textLabel.text = Format.SafeString(m.top.text, "")
    updatePreferredWidth()
end sub

'-------------------------------------------------------------------------------
' updatePreferredWidth
'-------------------------------------------------------------------------------
sub updatePreferredWidth()
    textWidth = TextMeasurement.GetWidth(m.measurementLabel, m.textLabel.font, m.textLabel.text)
    m.layout.measuredTextWidth = textWidth

    width = m.layout.expandedWidth
    if m.top.expandedWidth > 0 then width = m.top.expandedWidth
    contentWidth = getTextX() + textWidth + m.layout.textPadding + m.layout.rightPadding
    if contentWidth > width then width = contentWidth
    if m.top.maxWidth > 0 and width > m.top.maxWidth then width = m.top.maxWidth
    m.top.preferredWidth = width
    onFocusVisualChanged()
end sub

'-------------------------------------------------------------------------------
' onIconChanged
'-------------------------------------------------------------------------------
sub onIconChanged()
    if m.top.hasFocusVisual = true and Format.SafeString(m.top.focusedIcon, "") <> "" then
        m.iconPoster.uri = m.top.focusedIcon
    else
        m.iconPoster.uri = m.top.icon
    end if
end sub

'-------------------------------------------------------------------------------
' onFocusChanged
'-------------------------------------------------------------------------------
sub onFocusChanged()
    m.top.hasFocusVisual = m.top.isInFocusChain()
end sub

'-------------------------------------------------------------------------------
' onFocusVisualChanged
'-------------------------------------------------------------------------------
sub onFocusVisualChanged()
    hasFocus = m.top.hasFocusVisual = true
    updateBackground(hasFocus)
    layoutContent(hasFocus)
    updateContentColors(hasFocus)
end sub

'-------------------------------------------------------------------------------
' updateBackground
'-------------------------------------------------------------------------------
sub updateBackground(hasFocus as boolean)
    if hasFocus then
        m.background.uri = "pkg:/images/buttons/media-toolbar-button-focused.9.png"
        m.background.width = m.top.preferredWidth
    else
        m.background.uri = "pkg:/images/buttons/media-toolbar-button-unfocused.9.png"
        m.background.width = m.layout.collapsedWidth
    end if

    if m.top.alwaysShowText then m.background.width = m.top.preferredWidth
    m.background.height = m.layout.height
end sub

'-------------------------------------------------------------------------------
' layoutContent
'-------------------------------------------------------------------------------
sub layoutContent(hasFocus as boolean)
    m.iconPoster.visible = m.top.icon <> "" or m.top.focusedIcon <> ""
    m.iconPoster.width = m.layout.iconSize
    m.iconPoster.height = m.layout.iconSize
    m.iconPoster.translation = [m.layout.iconX, m.layout.iconY]
    m.textLabel.translation = [getTextX(), m.layout.textY]
    m.textLabel.width = m.background.width - getTextX() - m.layout.rightPadding
    if m.iconPoster.visible then
        m.textLabel.horizAlign = "left"
    else
        m.textLabel.horizAlign = "center"
    end if
    m.textLabel.visible = hasFocus or m.top.alwaysShowText
    if (hasFocus or m.top.centerContent) and m.iconPoster.visible and m.textLabel.visible then
        ' Center the icon and measured text as one group, retaining their normal gap.
        gap = m.layout.textX - m.layout.iconX - m.layout.iconSize
        textWidth = m.layout.measuredTextWidth
        availableTextWidth = m.background.width - 2 * m.layout.rightPadding - m.layout.iconSize - gap
        if availableTextWidth < 0 then availableTextWidth = 0
        if textWidth > availableTextWidth then textWidth = availableTextWidth
        contentX = (m.background.width - m.layout.iconSize - gap - textWidth) / 2
        ' Optical adjustment accounts for transparent padding around the icon artwork.
        if hasFocus then contentX -= 1
        m.iconPoster.translation = [contentX, m.layout.iconY]
        m.textLabel.translation = [contentX + m.layout.iconSize + gap, m.layout.textY]
        m.textLabel.width = textWidth
    end if
end sub

'-------------------------------------------------------------------------------
' updateContentColors
'-------------------------------------------------------------------------------
sub updateContentColors(hasFocus as boolean)
    if hasFocus then
        m.textLabel.color = &h0F1A2AFF
    else
        m.textLabel.color = &hF3F7FBFF
    end if
    onIconChanged()
end sub

'-------------------------------------------------------------------------------
' onKeyEvent
'-------------------------------------------------------------------------------
function onKeyEvent(key as string, press as boolean) as boolean
    if press = false then return false

    if key = Remote.Key.OK or key = Remote.Key.Select then
        m.top.buttonSelected = true
        return true
    end if

    return false
end function

'-------------------------------------------------------------------------------
' getTextX
'-------------------------------------------------------------------------------
function getTextX() as integer
    if m.top.icon = "" and m.top.focusedIcon = "" then return m.layout.rightPadding
    return m.layout.textX
end function
