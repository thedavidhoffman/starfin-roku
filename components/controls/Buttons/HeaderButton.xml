<?xml version="1.0" encoding="utf-8"?>
<component name="HeaderButton" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/source/ButtonAssets.brs" />
  <script type="text/brightscript" uri="pkg:/source/Number.brs" />
  <script type="text/brightscript" uri="pkg:/components/controls/Buttons/HeaderButton.brs" />
  <interface>
    <field id="text" type="string" onChange="onTextChanged" />
    <field id="buttonWidth" type="float" onChange="onDimensionsChanged" />
    <field id="buttonHeight" type="float" onChange="onDimensionsChanged" />
    <field id="textAlign" type="string" value="center" onChange="onTextLayoutChanged" />
    <field id="textInset" type="float" value="0" onChange="onTextLayoutChanged" />
    <field id="hasFocusVisual" type="boolean" onChange="onFocusVisualChanged" />
    <field id="hasActiveVisual" type="boolean" onChange="onFocusVisualChanged" />
    <field id="headerBgColor" type="integer" onChange="onFocusVisualChanged" />
    <field id="buttonSelected" type="boolean" alwaysNotify="true" />
  </interface>
  <children>
    <Poster id="bg" width="300" height="56" uri="pkg:/images/buttons/header-button-focused.9.png" loadDisplayMode="scaleToFill" visible="false" />
    <Label id="textLabel" translation="[0,14]" width="300" height="28" horizAlign="center" font="font:SmallerSystemFont" />
  </children>
</component>
