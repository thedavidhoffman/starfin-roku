<?xml version="1.0" encoding="utf-8"?>
<component name="TextInput" extends="Group">
  <script type="text/brightscript" uri="pkg:/source/Color.brs" />
  <script type="text/brightscript" uri="pkg:/components/controls/TextInput.brs" />
  <interface>
    <field id="text" type="string" onChange="onTextChanged" />
    <field id="placeholder" type="string" onChange="onTextChanged" />
    <field id="hasFocusVisual" type="boolean" onChange="onFocusVisualChanged" />
    <field id="fieldWidth" type="float" onChange="onDimensionsChanged" />
    <field id="fieldHeight" type="float" onChange="onDimensionsChanged" />
  </interface>
  <children>

    <!-- layer 1: full sized background, same size as focus frame -->
    <RectanglePrimary id="focusFramePlaceholder" translation="[-10,-10]" width="644" height="76" />

    <!-- layer 2: frame that displays on focus -->
    <Rectangle id="focusFrame" translation="[-10,-10]" width="644" height="76" color="0xFFFFFFFF" visible="false" />

    <!-- layer 3: inner background that sits inside the frame -->
    <RectanglePrimary id="bg" width="624" height="56" />

    <!-- text input value -->
    <LabelPrimary id="textLabel" translation="[18,12]" width="580" />
  </children>
</component>