<?xml version="1.0" encoding="utf-8"?>
<component name="Clock" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/controls/Clock/Clock.brs" />
  <interface>
    <field id="clockWidth" type="float" onChange="onDimensionsChanged" />
    <field id="clockHeight" type="float" onChange="onDimensionsChanged" />
    <field id="color" type="integer" onChange="onColorChanged" />
  </interface>
  <children>
    <Label
      id="timeLabel"
      width="160"
      height="40"
      horizAlign="right"
      vertAlign="center"
      color="0xF6F7FBFF"
      font="font:MediumSystemFont" />
    <Timer id="clockTimer" duration="30" repeat="true" />
  </children>
</component>
