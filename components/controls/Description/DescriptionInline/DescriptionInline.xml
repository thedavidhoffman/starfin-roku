<?xml version="1.0" encoding="utf-8"?>
<component name="DescriptionInline" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/source/Format.brs" />
  <script type="text/brightscript" uri="pkg:/source/String.brs" />
  <script type="text/brightscript" uri="pkg:/components/controls/Description/DescriptionInline/DescriptionInline.brs" />
  <interface>
    <field id="text" type="string" onChange="onTextChanged" />
    <field id="title" type="string" />
    <field id="width" type="float" onChange="onWidthChanged" />
    <field id="numLines" type="integer" onChange="onNumLinesChanged" />
    <field id="isTruncated" type="boolean" />
    <field id="canAcceptFocus" type="boolean" />
    <field id="overlayRequested" type="assocarray" alwaysNotify="true" />
    <function name="dismissDialog" />
  </interface>
  <children>
    <Rectangle
      id="descriptionFocusRing"
      color="0xFFFFFF40"
      visible="false" />
    <Label
      id="descriptionLabel"
      wrap="true"
      color="0xF3F7FBFF"
      font="font:SmallSystemFont" />
  </children>
</component>
