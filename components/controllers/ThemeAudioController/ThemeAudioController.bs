import "pkg:/source/ThemeAudio.bs"
import "pkg:/source/Array.bs"
import "pkg:/source/Format.bs"
import "pkg:/source/String.bs"
import "pkg:/source/LatestRequestLifecycle.bs"
import "pkg:/source/Number.bs"
import "pkg:/source/PlaybackRequest.bs"
import "pkg:/source/api/JellyfinAuth.bs"
import "pkg:/source/TaskControl.bs"
import "pkg:/source/MediaControl.bs"
import "pkg:/source/Logger.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.log = new Logger("ThemeAudioController", m.global.logService)
    m.themeAudioState = {
        request: invalid
        isActive: false
        lookup: LatestRequestLifecycle.Create()
        lookupPool: { nodes: [], nextIndex: 0 }
        lifecycle: LatestRequestLifecycle.Create()
        taskPool: { nodes: [], nextIndex: 0 }
    }
    initReferences()
    initHandlers()
end sub

'-------------------------------------------------------------------------------
' initReferences
'-------------------------------------------------------------------------------
sub initReferences()
    m.audio = m.top.findNode("audio")
    m.themeAudioState.lookupPool.nodes = [m.top.findNode("themeSongsTask"), m.top.findNode("themeSongsTaskAlternate")]
    m.themeAudioState.taskPool.nodes = [m.top.findNode("playbackInfoTask"), m.top.findNode("playbackInfoTaskAlternate")]
end sub

'-------------------------------------------------------------------------------
' initHandlers
'-------------------------------------------------------------------------------
sub initHandlers()
    m.themeAudioState.lookupPool.nodes[0].observeField("response", "onThemeSongsResponse")
    m.themeAudioState.lookupPool.nodes[1].observeField("response", "onAlternateThemeSongsResponse")
    m.themeAudioState.taskPool.nodes[0].observeField("response", "onPlaybackInfoResponse")
    m.themeAudioState.taskPool.nodes[1].observeField("response", "onAlternatePlaybackInfoResponse")
    m.audio.observeField("state", "onAudioStateChanged")
end sub

'-------------------------------------------------------------------------------
' startPendingPlayback
'-------------------------------------------------------------------------------
sub startPendingPlayback()
    entry = LatestRequestLifecycle.TakeNext(m.themeAudioState.lifecycle)
    if entry = invalid then return
    pool = m.themeAudioState.taskPool
    task = pool.nodes[pool.nextIndex]
    pool.nextIndex = (pool.nextIndex + 1) mod pool.nodes.Count()
    task.request = entry.request
    task.control = TaskControl.Command.Run
end sub

'-------------------------------------------------------------------------------
' playTheme
'-------------------------------------------------------------------------------
sub playTheme(request as object)
    if request = invalid then return
    if Strings.ToString(request.sourceItemId) = "" then return

    previous = m.themeAudioState.request
    if previous <> invalid then
        if previous.server <> request.server or previous.token <> request.token or previous.userId <> request.userId then stopTheme()
    end if
    ' Invalidate stream resolution immediately, even while the next lookup is pending.
    stopThemePlayback()
    capturedRequest = PlaybackRequest.Create(request)
    m.themeAudioState.request = capturedRequest
    lookupRequest = PlaybackRequest.Create(capturedRequest)
    lookupRequest.itemId = capturedRequest.sourceItemId
    LatestRequestLifecycle.Queue(m.themeAudioState.lookup, lookupRequest, capturedRequest)
    startPendingThemeLookup()
end sub

'-------------------------------------------------------------------------------
' stopTheme
'-------------------------------------------------------------------------------
sub stopTheme()
    m.themeAudioState.request = invalid
    LatestRequestLifecycle.Deactivate(m.themeAudioState.lookup)
    for each task in m.themeAudioState.lookupPool.nodes
        task.control = TaskControl.Command.Stop
    end for
    stopThemePlayback()
end sub

'-------------------------------------------------------------------------------
' stopThemePlayback
'-------------------------------------------------------------------------------
sub stopThemePlayback()
    m.themeAudioState.isActive = false
    LatestRequestLifecycle.Deactivate(m.themeAudioState.lifecycle)
    for each task in m.themeAudioState.taskPool.nodes
        task.control = TaskControl.Command.Stop
    end for
    m.audio.control = MediaControl.Command.Stop
    m.audio.content = invalid
end sub

'-------------------------------------------------------------------------------
' startPendingThemeLookup
'-------------------------------------------------------------------------------
sub startPendingThemeLookup()
    entry = LatestRequestLifecycle.TakeNext(m.themeAudioState.lookup)
    if entry = invalid then return
    pool = m.themeAudioState.lookupPool
    task = pool.nodes[pool.nextIndex]
    pool.nextIndex = (pool.nextIndex + 1) mod pool.nodes.Count()
    task.request = entry.request
    task.control = TaskControl.Command.Run
end sub

'-------------------------------------------------------------------------------
' onThemeSongsResponse
'-------------------------------------------------------------------------------
sub onThemeSongsResponse()
    handleThemeSongsResponse(m.themeAudioState.lookupPool.nodes[0].response)
end sub

'-------------------------------------------------------------------------------
' onAlternateThemeSongsResponse
'-------------------------------------------------------------------------------
sub onAlternateThemeSongsResponse()
    handleThemeSongsResponse(m.themeAudioState.lookupPool.nodes[1].response)
end sub

'-------------------------------------------------------------------------------
' handleThemeSongsResponse
'-------------------------------------------------------------------------------
sub handleThemeSongsResponse(response as dynamic)
    completion = LatestRequestLifecycle.Complete(m.themeAudioState.lookup, response, ThemeAudio.Action.Lookup)
    if completion.matched <> true then return
    startPendingThemeLookup()
    if completion.isCurrent <> true then return
    if response.ok <> true then
        m.log.write("Theme lookup failed: " + Strings.ToString(response.errorMessage, "Unknown error."))
        return
    end if
    song = response.payload
    if Arrays.IsAssocArray(song) <> true then return
    if Strings.ToString(song.Id) = "" then return

    request = PlaybackRequest.Create(completion.context)
    request.itemId = song.Id
    request.title = Format.FirstNonEmpty([song.Name, request.title], "Theme Music")
    LatestRequestLifecycle.Queue(m.themeAudioState.lifecycle, request, request)
    startPendingPlayback()
end sub

'-------------------------------------------------------------------------------
' onPlaybackInfoResponse
'-------------------------------------------------------------------------------
sub onPlaybackInfoResponse()
    handlePlaybackInfoResponse(m.themeAudioState.taskPool.nodes[0].response)
end sub

'-------------------------------------------------------------------------------
' onAlternatePlaybackInfoResponse
'-------------------------------------------------------------------------------
sub onAlternatePlaybackInfoResponse()
    handlePlaybackInfoResponse(m.themeAudioState.taskPool.nodes[1].response)
end sub

'-------------------------------------------------------------------------------
' handlePlaybackInfoResponse
'-------------------------------------------------------------------------------
sub handlePlaybackInfoResponse(response as dynamic)
    completion = LatestRequestLifecycle.Complete(m.themeAudioState.lifecycle, response, ThemeAudio.Action.PlaybackInfo)
    if completion.matched <> true then return
    if completion.isCurrent <> true then return

    if response.ok <> true then
        m.log.write("Unable to play theme music: " + Strings.ToString(response.errorMessage, "Unknown error."))
        return
    end if

    request = completion.context
    content = JellyfinAuth.CreateContent(request.server, response.streamUrl, request.token, request.userId)
    content.streamFormat = response.streamFormat
    content.title = response.title
    if content.url = "" then return

    m.themeAudioState.isActive = true
    m.audio.content = content
    m.audio.control = MediaControl.Command.Play
    m.log.write("Playing theme music itemId=" + response.itemId + " streamFormat=" + content.streamFormat)
end sub

'-------------------------------------------------------------------------------
' onAudioStateChanged
'-------------------------------------------------------------------------------
sub onAudioStateChanged()
    state = m.audio.state
    m.log.write("Theme music audio state changed state=" + state)
    if state = "finished" and m.themeAudioState.isActive = true then
        stopTheme()
    else if state = "error" then
        m.log.write("Theme music playback error")
        stopTheme()
    end if
end sub
