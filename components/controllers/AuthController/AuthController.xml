<?xml version="1.0" encoding="utf-8"?>
<component name="AuthController" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/controllers/AuthController/AuthController.bs" />
  <interface>
    <field id="loginRequest" type="assocarray" onChange="onLoginRequestChanged" />
    <field id="logoutRequest" type="assocarray" alwaysNotify="true" onChange="onLogoutRequestChanged" />
    <field id="resetStarfinRequested" type="boolean" alwaysNotify="true" onChange="onResetStarfinRequested" />
    <field id="switchAccountRequest" type="assocarray" alwaysNotify="true" onChange="onSwitchAccountRequestChanged" />
    <field id="expireActiveSessionRequested" type="assocarray" alwaysNotify="true" onChange="onExpireActiveSessionRequested" />
    <field id="resumeRequested" type="boolean" alwaysNotify="true" onChange="onResumeRequested" />
    <field id="quickConnectRequest" type="assocarray" alwaysNotify="true" onChange="onQuickConnectRequestChanged" />
    <field id="quickConnectCancelRequested" type="boolean" alwaysNotify="true" onChange="onQuickConnectCancelRequested" />
    <field id="quickConnectState" type="assocarray" alwaysNotify="true" />
    <field id="savedSession" type="assocarray" />
    <field id="authenticatedSession" type="assocarray" alwaysNotify="true" />
    <field id="loginRequired" type="assocarray" alwaysNotify="true" />
    <field id="loginFailed" type="assocarray" alwaysNotify="true" />
    <field id="sessionExpired" type="assocarray" alwaysNotify="true" />
    <function name="getAccountsForServer" />
  </interface>
  <children>
    <AuthTask id="authApiTask" />
    <QuickConnectTask id="quickConnectTaskA" />
    <QuickConnectTask id="quickConnectTaskB" />
    <Timer id="quickConnectTimer" duration="3" repeat="false" />
    <Timer id="quickConnectDispatchTimer" duration="0.01" repeat="false" />
  </children>
</component>
