import "pkg:/source/TaskControl.bs"
import "pkg:/source/Encode.bs"
import "pkg:/source/Format.bs"
import "pkg:/source/Logger.bs"
import "pkg:/source/String.bs"
import "pkg:/source/Url.bs"
import "pkg:/source/TimerControl.bs"
import "pkg:/source/store/AuthStore.bs"
import "pkg:/source/store/RegistryStore.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()

    m.log = new Logger("AuthController", m.global.logService)
    m.log.write("init")

    m.authApiTask = m.top.findNode("authApiTask")
    m.quickConnectTasks = [m.top.findNode("quickConnectTaskA"), m.top.findNode("quickConnectTaskB")]
    m.quickConnectTimer = m.top.findNode("quickConnectTimer")
    m.quickConnectDispatchTimer = m.top.findNode("quickConnectDispatchTimer")
    m.savedSession = AuthStore.Load()
    m.authState = {
        isResumingSession: false
        pendingSwitch: invalid
        logoutTasks: []
        quickConnect: {
            active: false
            generation: 0
            server: ""
            secret: ""
            code: ""
            nextTaskIndex: 0
            taskBusy: [false, false]
            pendingRequest: invalid
        }
    }

    m.authApiTask.observeField("response", "onAuthApiResponse")
    m.quickConnectTasks[0].observeField("response", "onQuickConnectResponse")
    m.quickConnectTasks[1].observeField("response", "onQuickConnectResponse")
    m.quickConnectTimer.observeField("fire", "onQuickConnectTimerFired")
    m.quickConnectDispatchTimer.observeField("fire", "onQuickConnectDispatchTimerFired")
    m.top.savedSession = m.savedSession
end sub

'-------------------------------------------------------------------------------
' onQuickConnectRequestChanged
'-------------------------------------------------------------------------------
sub onQuickConnectRequestChanged()
    request = m.top.quickConnectRequest
    if request = invalid then return

    cancelQuickConnect(false)
    state = m.authState.quickConnect
    state.active = true
    state.server = Format.SafeString(request.server, "")
    m.authState.isResumingSession = false
    m.authState.pendingSwitch = invalid
    publishQuickConnectState("starting", "", "Starting Quick Connect...")
    runQuickConnectRequest("initiate")
end sub

'-------------------------------------------------------------------------------
' onQuickConnectCancelRequested
'-------------------------------------------------------------------------------
sub onQuickConnectCancelRequested()
    cancelQuickConnect(true)
end sub

'-------------------------------------------------------------------------------
' onQuickConnectTimerFired
'-------------------------------------------------------------------------------
sub onQuickConnectTimerFired()
    if m.authState.quickConnect.active <> true then return
    runQuickConnectRequest("poll")
end sub

'-------------------------------------------------------------------------------
' onQuickConnectDispatchTimerFired
'-------------------------------------------------------------------------------
sub onQuickConnectDispatchTimerFired()
    dispatchPendingQuickConnectRequest()
end sub

'-------------------------------------------------------------------------------
' runQuickConnectRequest
'-------------------------------------------------------------------------------
sub runQuickConnectRequest(action as string)
    state = m.authState.quickConnect
    request = {
        action: action
        generation: state.generation
        server: state.server
    }
    if action <> "initiate" then request.secret = state.secret
    dispatchQuickConnectRequest(request)
end sub

'-------------------------------------------------------------------------------
' dispatchQuickConnectRequest
'-------------------------------------------------------------------------------
sub dispatchQuickConnectRequest(request as object)
    state = m.authState.quickConnect
    taskIndex = -1
    for offset = 0 to 1
        candidate = (state.nextTaskIndex + offset) mod 2
        if state.taskBusy[candidate] <> true then
            taskIndex = candidate
            exit for
        end if
    end for

    if taskIndex < 0 then
        ' Keep only the newest intent while both bounded Task nodes finish.
        state.pendingRequest = request
        return
    end if

    state.taskBusy[taskIndex] = true
    state.nextTaskIndex = 1 - taskIndex
    task = m.quickConnectTasks[taskIndex]
    task.request = request
    task.control = TaskControl.Command.Run
end sub

'-------------------------------------------------------------------------------
' onQuickConnectResponse
'-------------------------------------------------------------------------------
sub onQuickConnectResponse(event as object)
    response = event.getData()
    if response <> invalid then handleQuickConnectResponse(response)
    releaseQuickConnectTask(event.getRoSGNode())
    if m.authState.quickConnect.pendingRequest <> invalid then m.quickConnectDispatchTimer.control = TimerControl.Command.Start
end sub

'-------------------------------------------------------------------------------
' releaseQuickConnectTask
'-------------------------------------------------------------------------------
sub releaseQuickConnectTask(task as object)
    for i = 0 to m.quickConnectTasks.Count() - 1
        if m.quickConnectTasks[i].isSameNode(task) then
            m.authState.quickConnect.taskBusy[i] = false
            return
        end if
    end for
end sub

'-------------------------------------------------------------------------------
' dispatchPendingQuickConnectRequest
'-------------------------------------------------------------------------------
sub dispatchPendingQuickConnectRequest()
    state = m.authState.quickConnect
    request = state.pendingRequest
    if request = invalid then return
    if state.active <> true or request.generation <> state.generation then
        state.pendingRequest = invalid
        return
    end if

    state.pendingRequest = invalid
    m.quickConnectDispatchTimer.control = TimerControl.Command.Stop
    dispatchQuickConnectRequest(request)
end sub

'-------------------------------------------------------------------------------
' handleQuickConnectResponse
'-------------------------------------------------------------------------------
sub handleQuickConnectResponse(response as object)
    state = m.authState.quickConnect
    if state.active <> true or response.generation <> state.generation then return

    if response.ok <> true then
        if response.action = "poll" and (response.status = 0 or response.status >= 500) then
            publishQuickConnectState("waiting", "", "Connection interrupted. Retrying...")
            m.quickConnectTimer.control = TimerControl.Command.Start
            return
        end if
        failQuickConnect(Format.SafeString(response.errorMessage, "Quick Connect failed."))
        return
    end if

    if response.action = "initiate" then
        state.secret = response.secret
        publishQuickConnectState("waiting", response.code, "Approve this code in Jellyfin.")
        m.quickConnectTimer.control = TimerControl.Command.Start
    else if response.action = "poll" and response.authenticated = true then
        publishQuickConnectState("authenticating", "", "Quick Connect approved. Signing in...")
        runQuickConnectRequest("authenticate")
    else if response.action = "poll" then
        m.quickConnectTimer.control = TimerControl.Command.Start
    else if response.action = "authenticate" then
        state.active = false
        state.secret = ""
        state.code = ""
        state.pendingRequest = invalid
        m.quickConnectTimer.control = TimerControl.Command.Stop
        m.quickConnectDispatchTimer.control = TimerControl.Command.Stop
        publishQuickConnectState("idle", "", "")
        storeAuthenticatedSession(response)
    end if
end sub

'-------------------------------------------------------------------------------
' publishQuickConnectState
'-------------------------------------------------------------------------------
sub publishQuickConnectState(phase as string, code as string, message as string)
    if code <> "" then m.authState.quickConnect.code = code
    m.top.quickConnectState = { phase: phase, code: m.authState.quickConnect.code, message: message }
end sub

'-------------------------------------------------------------------------------
' failQuickConnect
'-------------------------------------------------------------------------------
sub failQuickConnect(message as string)
    state = m.authState.quickConnect
    state.active = false
    state.secret = ""
    state.code = ""
    state.pendingRequest = invalid
    m.quickConnectTimer.control = TimerControl.Command.Stop
    m.quickConnectDispatchTimer.control = TimerControl.Command.Stop
    publishQuickConnectState("failed", "", message)
end sub

'-------------------------------------------------------------------------------
' cancelQuickConnect
'-------------------------------------------------------------------------------
sub cancelQuickConnect(publishState as boolean)
    state = m.authState.quickConnect
    state.generation++
    state.active = false
    state.secret = ""
    state.code = ""
    state.server = ""
    state.pendingRequest = invalid
    m.quickConnectTimer.control = TimerControl.Command.Stop
    m.quickConnectDispatchTimer.control = TimerControl.Command.Stop
    if publishState then publishQuickConnectState("idle", "", "")
end sub

'-------------------------------------------------------------------------------
' onResumeRequested
'-------------------------------------------------------------------------------
sub onResumeRequested()

    m.log.write("onResumeRequested")
    cancelQuickConnect(false)

    if hasSavedSession() then
        m.authState.isResumingSession = true
        runAuthApiRequest({
            action: "authorize"
            server: m.savedSession.server
            token: m.savedSession.token
            userId: m.savedSession.userId
        })
    else
        publishLoginRequired("Enter your Jellyfin server and credentials to begin.", true)
    end if
end sub

'-------------------------------------------------------------------------------
' onLoginRequestChanged
'-------------------------------------------------------------------------------
sub onLoginRequestChanged()

    m.log.write("onLoginRequestChanged")

    request = m.top.loginRequest
    if request = invalid then return

    cancelQuickConnect(false)
    m.authState.isResumingSession = false
    m.authState.pendingSwitch = invalid
    runAuthApiRequest(request)
end sub

'-------------------------------------------------------------------------------
' onLogoutRequestChanged
'-------------------------------------------------------------------------------
sub onLogoutRequestChanged()

    m.log.write("onLogoutRequestChanged")

    request = m.top.logoutRequest
    cancelQuickConnect(false)

    if request <> invalid and request.server <> invalid and request.server <> "" and request.token <> invalid and request.token <> "" then
        runLogoutApiRequest({
            action: "logout"
            server: request.server
            token: request.token
        })
    end if

    clearSavedSession()
    publishLoginRequired("Signed out.", true)
end sub

'-------------------------------------------------------------------------------
' onResetStarfinRequested
'-------------------------------------------------------------------------------
sub onResetStarfinRequested()
    m.log.write("onResetStarfinRequested")
    cancelQuickConnect(false)

    if m.savedSession <> invalid then
        server = Format.SafeString(m.savedSession.server, "")
        token = Format.SafeString(m.savedSession.token, "")
        if server <> "" and token <> "" then
            runLogoutApiRequest({
                action: "logout"
                server: server
                token: token
            })
        end if
    end if

    RegistryStore.ClearAll()
    m.savedSession = AuthStore.Load()
    m.authState.isResumingSession = false
    m.authState.pendingSwitch = invalid
    m.top.savedSession = m.savedSession
    publishLoginRequired("Starfin was reset. Sign in to continue.", false)
end sub

'-------------------------------------------------------------------------------
' onExpireActiveSessionRequested
'-------------------------------------------------------------------------------
sub onExpireActiveSessionRequested()
    request = m.top.expireActiveSessionRequested
    accountKey = Format.SafeString(request.accountKey, "")
    if accountKey = "" or accountKey <> Format.SafeString(m.savedSession.accountKey, "") then return
    if Format.SafeString(m.savedSession.token, "") = "" then return
    server = Format.SafeString(m.savedSession.server, "")
    username = Format.SafeString(m.savedSession.username, "")
    clearSavedSession()
    m.top.sessionExpired = {
        message: Format.SafeString(request.message, "Your session expired. Please sign in again.")
        server: server
        username: username
        accountKey: Format.SafeString(m.savedSession.accountKey, "")
        clearRuntimeSession: true
    }
end sub

'-------------------------------------------------------------------------------
' onSwitchAccountRequestChanged
'-------------------------------------------------------------------------------
sub onSwitchAccountRequestChanged()
    request = m.top.switchAccountRequest
    if request = invalid then return

    accountKey = Format.SafeString(request.accountKey, "")
    source = Format.SafeString(request.source, "header")
    account = AuthStore.LoadAccount(accountKey, true)
    if account = invalid then
        publishLoginFailed("The selected account is no longer available.", { accountKey: accountKey, source: source })
        return
    end if

    m.authState.isResumingSession = false
    m.authState.pendingSwitch = {
        account: account
        accountKey: accountKey
        source: source
    }
    runAuthApiRequest({
        action: "authorize"
        server: account.server
        token: account.token
        userId: account.userId
    })
end sub

'-------------------------------------------------------------------------------
' getAccountsForServer
'-------------------------------------------------------------------------------
function getAccountsForServer(server as string) as object
    return AuthStore.ListAccounts(server)
end function

'-------------------------------------------------------------------------------
' clearSavedSession
'-------------------------------------------------------------------------------
sub clearSavedSession()

    m.log.write("clearSavedSession")

    accountKey = Format.SafeString(m.savedSession.accountKey, "")
    if accountKey <> "" then AuthStore.RemoveToken(accountKey)
    if m.savedSession <> invalid then m.savedSession.token = ""
    m.top.savedSession = m.savedSession
end sub

'-------------------------------------------------------------------------------
' hasSavedSession
'-------------------------------------------------------------------------------
function hasSavedSession() as boolean
    if m.savedSession = invalid then return false
    if m.savedSession.token = invalid or m.savedSession.token = "" then return false
    if m.savedSession.server = invalid or m.savedSession.server = "" then return false
    if m.savedSession.userId = invalid or m.savedSession.userId = "" then return false

    return true
end function

'-------------------------------------------------------------------------------
' runAuthApiRequest
'-------------------------------------------------------------------------------
sub runAuthApiRequest(request as object)

    m.log.write("runAuthApiRequest")

    m.authApiTask.request = request
    m.authApiTask.control = TaskControl.Command.Run
end sub

'-------------------------------------------------------------------------------
' onAuthApiResponse
'-------------------------------------------------------------------------------
sub onAuthApiResponse()

    m.log.write("onAuthApiResponse")

    response = m.authApiTask.response
    if response = invalid then return

    action = getAuthResponseAction(response)
    if response.ok <> true then
        handleAuthError(response, action)
    else if action = "login" or action = "authorize" then
        m.authState.isResumingSession = false
        storeAuthenticatedSession(response)
    end if
end sub

'-------------------------------------------------------------------------------
' getAuthResponseAction
'-------------------------------------------------------------------------------
function getAuthResponseAction(response as dynamic) as string

    m.log.write("getAuthResponseAction")

    if response <> invalid and response.action <> invalid then return response.action
    if m.authApiTask.request <> invalid and m.authApiTask.request.action <> invalid then
        return m.authApiTask.request.action
    end if

    return ""
end function

'-------------------------------------------------------------------------------
' handleAuthError
'-------------------------------------------------------------------------------
sub handleAuthError(response as object, action as string)

    m.log.write("handleAuthError")

    if m.authState.pendingSwitch <> invalid then
        pendingSwitch = m.authState.pendingSwitch
        account = pendingSwitch.account
        m.authState.pendingSwitch = invalid
        if response.authExpired = true then
            AuthStore.RemoveToken(account.accountKey)
            m.top.sessionExpired = {
                message: Format.SafeString(response.errorMessage, "Your saved session expired. Please sign in again.")
                server: account.server
                username: account.username
                accountKey: pendingSwitch.accountKey
                source: pendingSwitch.source
                clearRuntimeSession: false
            }
        else
            publishLoginFailed("Account switch failed: " + Format.SafeString(response.errorMessage, "Unknown error."), pendingSwitch)
        end if
    else if m.authState.isResumingSession = true then
        m.authState.isResumingSession = false
        if response.authExpired = true then
            server = Format.SafeString(m.savedSession.server, "")
            username = Format.SafeString(m.savedSession.username, "")
            clearSavedSession()
            m.top.sessionExpired = {
                message: "Your saved session expired. Please sign in again."
                server: server
                username: username
                accountKey: Format.SafeString(m.savedSession.accountKey, "")
                clearRuntimeSession: true
            }
        else
            publishLoginRequired("Unable to resume the saved session: " + Format.SafeString(response.errorMessage, "Unknown error."), false)
        end if
    else if action = "login" then
        publishLoginFailed("Login failed: " + Format.SafeString(response.errorMessage, "Unknown error."))
    end if

end sub

'-------------------------------------------------------------------------------
' storeAuthenticatedSession
'-------------------------------------------------------------------------------
sub storeAuthenticatedSession(response as object)

    m.log.write("storeAuthenticatedSession")

    m.savedSession = buildAuthenticatedSession(response)
    saveAuthenticatedSession(m.savedSession)
    m.savedSession.accountKey = AuthStore.BuildAccountKey(m.savedSession.server, m.savedSession.userId)
    m.authState.pendingSwitch = invalid
    m.top.savedSession = m.savedSession
    m.top.authenticatedSession = m.savedSession
end sub

'-------------------------------------------------------------------------------
' runLogoutApiRequest
'-------------------------------------------------------------------------------
sub runLogoutApiRequest(request as object)
    task = CreateObject("roSGNode", "AuthTask")
    task.observeField("response", "onLogoutApiResponse")
    m.top.appendChild(task)
    m.authState.logoutTasks.Push(task)
    task.request = request
    task.control = TaskControl.Command.Run
end sub

'-------------------------------------------------------------------------------
' onLogoutApiResponse
'-------------------------------------------------------------------------------
sub onLogoutApiResponse(event as object)
    task = event.getRoSGNode()
    response = event.getData()
    if response <> invalid and response.ok <> true then
        m.log.write("Logout revocation failed: " + Format.SafeString(response.errorMessage, "Unknown error."))
    end if
    for i = m.authState.logoutTasks.Count() - 1 to 0 step -1
        if m.authState.logoutTasks[i].isSameNode(task) then
            m.authState.logoutTasks.Delete(i)
            exit for
        end if
    end for
    m.top.removeChild(task)
end sub

'-------------------------------------------------------------------------------
' buildAuthenticatedSession
'-------------------------------------------------------------------------------
function buildAuthenticatedSession(response as object) as object

    payload = response.payload
    sessionToken = response.token
    username = ""
    userId = invalid
    primaryImageTag = ""

    if payload <> invalid and payload.AccessToken <> invalid then
        sessionToken = payload.AccessToken
    end if
    
    server = response.server

    if payload <> invalid and payload.User <> invalid then
        username = Format.SafeString(payload.User.Name, "")
        userId = payload.User.Id
        primaryImageTag = Format.SafeString(payload.User.PrimaryImageTag, "")
    end if

    return {
        accountKey: AuthStore.BuildAccountKey(server, userId)
        server: server
        username: username
        token: sessionToken
        userId: userId
        primaryImageTag: primaryImageTag
    }

end function

'-------------------------------------------------------------------------------
' saveAuthenticatedSession
'-------------------------------------------------------------------------------
sub saveAuthenticatedSession(session as object)
    AuthStore.Save(session.server, session.username, session.token, session.userId, session.primaryImageTag)
end sub

'-------------------------------------------------------------------------------
' publishLoginRequired
'-------------------------------------------------------------------------------
sub publishLoginRequired(message as string, openSavedAccounts = false as boolean)

    m.log.write("publishLoginRequired")

    m.top.loginRequired = {
        message: message
        openSavedAccounts: openSavedAccounts
    }
end sub

'-------------------------------------------------------------------------------
' publishLoginFailed
'-------------------------------------------------------------------------------
sub publishLoginFailed(message as string, context = invalid as dynamic)

    m.log.write("publishLoginFailed")

    result = {
        message: message
    }
    if context <> invalid then
        result.accountKey = Format.SafeString(context.accountKey, "")
        result.source = Format.SafeString(context.source, "")
    end if
    m.top.loginFailed = result
end sub
