{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "validate",
            "type": "shell",
            "command": "npm run validate",
            "problemMatcher": "$msCompile",
            "presentation": {
                "echo": true,
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "package",
            "type": "shell",
            "command": "npm run package",
            "problemMatcher": "$msCompile",
            "presentation": {
                "echo": true,
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            }
        },
        {
            "label": "debug:build",
            "type": "shell",
            "command": "npm run debug:build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "echo": true,
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            }
        },
        {
            "label": "deploy",
            "type": "shell",
            "command": "npm run deploy",
            "problemMatcher": "$msCompile",
            "presentation": {
                "echo": true,
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            }
        },
        {
            "label": "clean-staging",
            "type": "shell",
            "command": "if (Test-Path build) { Remove-Item -Recurse -Force build }",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            }
        }
    ]
}
