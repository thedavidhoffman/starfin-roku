{
    "rootDir": ".",
    "files": [
        "manifest",
        "source/**/*",
        "!source/main.brs",
        "components/**/*",
        {
            "src": "components/pages/Video/VideoPlayer/Helpers/Pure/*.brs",
            "dest": "source/video-player-helpers"
        },
        {
            "src": "tests/specs/source/**/*",
            "dest": "source/tests/source"
        },
        {
            "src": "tests/specs/components/pages/Video/VideoPlayer/Helpers/Pure/**/*",
            "dest": "source/tests/video-player"
        },
        {
            "src": "tests/main.brs",
            "dest": "source/main.brs"
        },
        "images/**/*",
        "fonts/**/*"
    ],
    "stagingFolderPath": "build/tests",
    "outFile": "out/starfin-roku-tests.zip",
    "plugins": [
        "rooibos-roku"
    ],
    "rooibos": {
        "testsFilePattern": "**/*.spec.bs",
        "showOnlyFailures": false,
        "catchCrashes": true,
        "sendHomeOnFinish": false
    },
    "bs_const": {
        "playbackChaosMonkey": false
    }
}
