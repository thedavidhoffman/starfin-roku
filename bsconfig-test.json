{
    "rootDir": ".",
    "files": [
        "manifest",
        "source/**/*",
        "!source/main.bs",
        "components/**/*",
        {
            "src": "components/pages/Video/VideoPlayer/Helpers/Pure/*.{brs,bs}",
            "dest": "source/video-player-helpers"
        },
        {
            "src": "tests/specs/source/**/*",
            "dest": "source/tests/source"
        },
        {
            "src": "tests/specs/components/pages/Video/VideoPlayer/Helpers/Pure/**/*",
            "dest": "source/tests/video-player"
        },
        {
            "src": "tests/specs/components/controls/**/*",
            "dest": "source/tests/components/controls"
        },
        {
            "src": "tests/specs/components/controllers/**/*",
            "dest": "source/tests/components/controllers"
        },
        {
            "src": "tests/specs/components/pages/Music/AudioPlayer/**/*",
            "dest": "source/tests/components/pages/Music/AudioPlayer"
        },
        {
            "src": "tests/specs/components/pages/Music/MusicLibrary/**/*",
            "dest": "source/tests/components/pages/Music/MusicLibrary"
        },
        {
            "src": "tests/specs/components/pages/Settings/**/*",
            "dest": "source/tests/components/pages/Settings"
        },
        {
            "src": "tests/specs/components/screensavers/**/*",
            "dest": "source/tests/components/screensavers"
        },
        {
            "src": "tests/specs/components/tasks/**/*",
            "dest": "source/tests/components/tasks"
        },
        {
            "src": "tests/specs/components/services/**/*",
            "dest": "source/tests/components/services"
        },
        {
            "src": "tests/main.brs",
            "dest": "source/main.brs"
        },
        "images/**/*",
        "fonts/**/*"
    ],
    "stagingFolderPath": "build/tests",
    "outFile": "out/starfin-roku-tests.zip",
    "plugins": [
        "rooibos-roku"
    ],
    "autoImportComponentScript": true,
    "diagnosticFilters": [
        1107
    ],
    "rooibos": {
        "testsFilePattern": "**/*.spec.bs",
        "showOnlyFailures": false,
        "catchCrashes": true,
        "sendHomeOnFinish": false
    },
    "bs_const": {
        "playbackChaosMonkey": false
    }
}
