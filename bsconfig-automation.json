{
    "rootDir": ".",
    "files": [
        "manifest",
        "source/**/*",
        "components/**/*",
        "images/**/*",
        {
            "src": "components/pages/Video/VideoPlayer/Helpers/Pure/*.brs",
            "dest": "source/video-player-helpers"
        },
        {
            "src": "components/pages/Video/VideoPlayer/Helpers/Pure/*.bs",
            "dest": "source/video-player-helpers"
        },
        {
            "src": "node_modules/roku-test-automation/device/**/*",
            "dest": "/"
        }
    ],
    "stagingDir": "build/automation",
    "outFile": "out/starfin-roku-automation.zip",
    "retainStagingDir": true,
    "manifest": {
        "bs_const": {
            "playbackChaosMonkey": false,
            "enableRta": true
        }
    }
}
