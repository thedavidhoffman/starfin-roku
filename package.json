{
  "name": "starfin-roku",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "A Jellyfin client for Roku.",
  "devDependencies": {
    "@danecodes/roku-ecp": "0.9.0",
    "@danecodes/roku-screenshot": "0.1.0",
    "brighterscript": "^0.72.5",
    "brighterscript-formatter": "1.7.19",
    "dotenv": "17.4.2",
    "mocha": "11.7.5",
    "mochawesome": "8.0.1",
    "rimraf": "6.1.3",
    "roku-deploy": "3.16.1",
    "roku-test-automation": "2.2.2",
    "rooibos-roku": "^5.16.4",
    "sharp": "^0.33.5",
    "yazl": "^3.3.1"
  },
  "scripts": {
    "clean": "npx rimraf build/ out/",
    "validate": "npx bsc --rootDir . --stagingFolder build/staging",
    "debug:build": "npx bsc --project bsconfig.json --staging-folder-path build/staging --retain-staging-folder --source-map --copy-to-staging --create-package false",
    "test:build": "npx bsc --project bsconfig-test.json",
    "test": "node scripts/run-rooibos.mjs --project bsconfig-test.json",
    "automation:build": "npx bsc --project bsconfig-automation.json",
    "automation:test": "node scripts/run-rta.mjs",
    "automation:test:release": "node scripts/run-rta.mjs --release-report",
    "automation:report:test": "node --test tests/automation/unit/*.test.mjs",
    "generate:image-masks": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/generate-hd-mask-assets.ps1",
    "validate:image-geometry": "node ./scripts/verify-image-geometry.mjs",
    "increment-build-version": "node ./scripts/increment-build-version.mjs",
    "build": "npm run increment-build-version && npm run clean && npm run validate",
    "package": "npm run build && node ./scripts/package.mjs",
    "deploy": "npm run increment-build-version && npm run validate && node ./scripts/deploy.mjs",
    "logviewer": "node ./scripts/logviewer.mjs"
  },
  "keywords": [
    "audiobookshelf",
    "roku",
    "audiobooks",
    "scenegraph"
  ],
  "license": "UNLICENSED"
}
