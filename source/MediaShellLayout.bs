namespace MediaShellLayout

    enum Mode
        FullScreen = "full-screen"
        PartialScreen = "partial-screen"
        Cinematic = "cinematic"
        Poster = "poster"
    end enum

    '---------------------------------------------------------------------------
    ' MediaShellLayout.Normalize
    '---------------------------------------------------------------------------
    function Normalize(value as dynamic, defaultMode = Mode.FullScreen as string, allowPoster = true as boolean) as string
        normalized = ""
        if value <> invalid then normalized = LCase(value.ToStr())
        if normalized = Mode.FullScreen or normalized = Mode.PartialScreen or normalized = Mode.Cinematic then return normalized
        if allowPoster and normalized = Mode.Poster then return normalized
        return defaultMode
    end function

    '---------------------------------------------------------------------------
    ' MediaShellLayout.NormalizeSeries
    '---------------------------------------------------------------------------
    function NormalizeSeries(value as dynamic) as string
        mode = Normalize(value, Mode.PartialScreen)
        if mode = Mode.Cinematic then return Mode.PartialScreen
        return mode
    end function

    '---------------------------------------------------------------------------
    ' MediaShellLayout.NormalizeMusic
    '---------------------------------------------------------------------------
    function NormalizeMusic(value as dynamic) as string
        if Normalize(value) = Mode.PartialScreen then return Mode.PartialScreen
        return Mode.FullScreen
    end function

end namespace
