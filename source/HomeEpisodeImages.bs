namespace HomeEpisodeImages

    enum Mode
        Series = "series"
        WithLogo = "episode-with-logo"
        WithoutLogo = "episode-without-logo"
    end enum

    '---------------------------------------------------------------------------
    ' HomeEpisodeImages.Normalize
    '---------------------------------------------------------------------------
    function Normalize(value as dynamic) as string
        normalized = ""
        if value <> invalid then normalized = LCase(value.ToStr())
        if normalized = Mode.WithLogo then return Mode.WithLogo
        if normalized = Mode.WithoutLogo then return Mode.WithoutLogo
        return Mode.Series
    end function

end namespace
