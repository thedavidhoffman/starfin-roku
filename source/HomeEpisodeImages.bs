namespace HomeEpisodeImages

    enum Mode
        Off = "off"
        WithLogo = "on-with-logo"
        WithoutLogo = "on-without-logo"
    end enum

    function Normalize(value as dynamic) as string
        normalized = ""
        if value <> invalid then normalized = LCase(value.ToStr())
        if normalized = "on" or normalized = Mode.WithLogo then return Mode.WithLogo
        if normalized = Mode.WithoutLogo then return Mode.WithoutLogo
        return Mode.Off
    end function

end namespace
