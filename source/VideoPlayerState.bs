import "pkg:/source/Format.bs"

namespace VideoPlayerState

    enum Value
        None = "none"
        Buffering = "buffering"
        Playing = "playing"
        Paused = "paused"
        Stopped = "stopped"
        Finished = "finished"
        Error = "error"
    end enum

    '---------------------------------------------------------------------------
    ' VideoPlayerState.Normalize
    '---------------------------------------------------------------------------
    function Normalize(value as dynamic) as string
        normalized = LCase(Format.SafeString(value, ""))
        if normalized = VideoPlayerState.Value.Buffering then return VideoPlayerState.Value.Buffering
        if normalized = VideoPlayerState.Value.Playing then return VideoPlayerState.Value.Playing
        if normalized = VideoPlayerState.Value.Paused then return VideoPlayerState.Value.Paused
        if normalized = VideoPlayerState.Value.Stopped then return VideoPlayerState.Value.Stopped
        if normalized = VideoPlayerState.Value.Finished then return VideoPlayerState.Value.Finished
        if normalized = VideoPlayerState.Value.Error then return VideoPlayerState.Value.Error
        return VideoPlayerState.Value.None
    end function

end namespace
