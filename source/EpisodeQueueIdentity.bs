import "pkg:/source/Format.bs"
import "pkg:/source/Number.bs"

namespace EpisodeQueueIdentity

    '-------------------------------------------------------------------------------
    ' Apply
    '-------------------------------------------------------------------------------
    sub Apply(target as dynamic, scope as dynamic, value as dynamic)
        if target = invalid then return
        if target.DoesExist("episodeQueueId") then target.Delete("episodeQueueId")
        if Format.SafeString(scope, "") <> "series" then return

        queueId = Number.ToInteger(value, 0)
        if queueId > 0 then target.AddReplace("episodeQueueId", queueId)
    end sub

end namespace
