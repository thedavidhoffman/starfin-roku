namespace Strings

    '---------------------------------------------------------------------------
    ' Strings.Trim
    '---------------------------------------------------------------------------
    ' Example: "  Starfin Roku  " returns "Starfin Roku".
    '---------------------------------------------------------------------------
    function Trim(value as dynamic) as string
        if value = invalid then return ""

        text = value.ToStr()
        startIndex = 0
        endIndex = Len(text) - 1

        while startIndex <= endIndex and Mid(text, startIndex + 1, 1) = " "
            startIndex = startIndex + 1
        end while

        while endIndex >= startIndex and Mid(text, endIndex + 1, 1) = " "
            endIndex = endIndex - 1
        end while

        if startIndex > endIndex then return ""
        return Mid(text, startIndex + 1, endIndex - startIndex + 1)
    end function

    '---------------------------------------------------------------------------
    ' Strings.Replace
    '---------------------------------------------------------------------------
    ' Example: ("one fish", "fish", "movie") returns "one movie".
    '---------------------------------------------------------------------------
    function Replace(value as string, oldValue as string, newValue as string) as string
        result = ""
        remaining = value
        index = Instr(1, remaining, oldValue)

        while index > 0
            result = result + Left(remaining, index - 1) + newValue
            remaining = Mid(remaining, index + Len(oldValue))
            index = Instr(1, remaining, oldValue)
        end while

        return result + remaining
    end function

    '---------------------------------------------------------------------------
    ' Strings.CollapseWhitespace
    '---------------------------------------------------------------------------
    ' Example: "  one  two  " returns "one two".
    '---------------------------------------------------------------------------
    function CollapseWhitespace(value as dynamic) as string
        text = Format.SafeString(value, "")
        result = ""
        previousWasSpace = false

        for i = 1 to Len(text)
            char = Mid(text, i, 1)
            isSpace = (char = " " or char = Chr(10) or char = Chr(13) or char = Chr(9))

            if isSpace then
                if previousWasSpace = false then result = result + " "
                previousWasSpace = true
            else
                result = result + char
                previousWasSpace = false
            end if
        end for

        return Strings.Trim(result)
    end function

    ' Case-insensitive comparator for natural sorting, so numbered text sorts by
    ' numeric value ("Book 2" before "Book 10") instead of plain text order.
    '---------------------------------------------------------------------------
    ' Strings.NaturalCompare
    '---------------------------------------------------------------------------
    ' Example: ("Book 2", "Book 10") returns -1.
    '---------------------------------------------------------------------------
    function NaturalCompare(leftValue as dynamic, rightValue as dynamic) as integer
        left = LCase(Format.SafeString(leftValue, ""))
        right = LCase(Format.SafeString(rightValue, ""))
        leftIndex = 1
        rightIndex = 1

        while leftIndex <= Len(left) and rightIndex <= Len(right)
            leftChar = Mid(left, leftIndex, 1)
            rightChar = Mid(right, rightIndex, 1)

            if Strings.IsDigit(leftChar) and Strings.IsDigit(rightChar) then
                comparison = Strings.__CompareNumberRuns(left, leftIndex, right, rightIndex)
                if comparison <> 0 then return comparison

                leftIndex = Strings.__GetDigitRunEnd(left, leftIndex) + 1
                rightIndex = Strings.__GetDigitRunEnd(right, rightIndex) + 1
            else
                if leftChar < rightChar then return -1
                if leftChar > rightChar then return 1

                leftIndex = leftIndex + 1
                rightIndex = rightIndex + 1
            end if
        end while

        if leftIndex <= Len(left) then return 1
        if rightIndex <= Len(right) then return -1
        return 0
    end function

    '---------------------------------------------------------------------------
    ' Strings.__CompareNumberRuns
    '---------------------------------------------------------------------------
    ' Example: ("2", 1, "10", 1) returns -1.
    '---------------------------------------------------------------------------
    function __CompareNumberRuns(left as string, leftIndex as integer, right as string, rightIndex as integer) as integer
        leftEnd = Strings.__GetDigitRunEnd(left, leftIndex)
        rightEnd = Strings.__GetDigitRunEnd(right, rightIndex)
        leftNumber = Strings.__TrimLeadingZeroes(Mid(left, leftIndex, leftEnd - leftIndex + 1))
        rightNumber = Strings.__TrimLeadingZeroes(Mid(right, rightIndex, rightEnd - rightIndex + 1))

        if Len(leftNumber) < Len(rightNumber) then return -1
        if Len(leftNumber) > Len(rightNumber) then return 1

        for i = 1 to Len(leftNumber)
            leftChar = Mid(leftNumber, i, 1)
            rightChar = Mid(rightNumber, i, 1)
            if leftChar < rightChar then return -1
            if leftChar > rightChar then return 1
        end for

        leftRunLength = leftEnd - leftIndex + 1
        rightRunLength = rightEnd - rightIndex + 1
        if leftRunLength < rightRunLength then return -1
        if leftRunLength > rightRunLength then return 1
        return 0
    end function

    '---------------------------------------------------------------------------
    ' Strings.__GetDigitRunEnd
    '---------------------------------------------------------------------------
    ' Example: ("abc123", 4) returns 6.
    '---------------------------------------------------------------------------
    function __GetDigitRunEnd(value as string, startIndex as integer) as integer
        index = startIndex

        while index <= Len(value) and Strings.IsDigit(Mid(value, index, 1))
            index = index + 1
        end while

        return index - 1
    end function

    '---------------------------------------------------------------------------
    ' Strings.__TrimLeadingZeroes
    '---------------------------------------------------------------------------
    ' Example: "002" returns "2".
    '---------------------------------------------------------------------------
    function __TrimLeadingZeroes(value as string) as string
        index = 1

        while index < Len(value) and Mid(value, index, 1) = "0"
            index = index + 1
        end while

        return Mid(value, index)
    end function

    '---------------------------------------------------------------------------
    ' Strings.IsDigit
    '---------------------------------------------------------------------------
    ' Example: "9" returns true; "a" returns false.
    '---------------------------------------------------------------------------
    function IsDigit(value as string) as boolean
        return value >= "0" and value <= "9"
    end function

    '---------------------------------------------------------------------------
    ' Strings.StripHtmlMarkup
    '---------------------------------------------------------------------------
    ' Example: "<p>First</p><p>Second</p>" returns "First Second".
    '---------------------------------------------------------------------------
    function StripHtmlMarkup(value as dynamic) as string
        text = Format.SafeString(value, "")
        text = Strings.Replace(text, "</p> <p>", Chr(10))
        text = Strings.Replace(text, "</p><p>", Chr(10))
        result = ""
        insideTag = false

        for i = 1 to Len(text)
            char = Mid(text, i, 1)
            if char = "<" then
                insideTag = true
            else if char = ">" then
                insideTag = false
                result = result + " "
            else if insideTag = false then
                result = result + char
            end if
        end for

        result = Strings.Replace(result, "&nbsp;", " ")
        result = Strings.Replace(result, "&amp;", "&")
        result = Strings.Replace(result, "&quot;", Chr(34))
        result = Strings.Replace(result, "&#39;", "'")
        result = Strings.Replace(result, "&apos;", "'")
        result = Strings.Replace(result, "&lt;", "<")
        result = Strings.Replace(result, "&gt;", ">")

        return Strings.CollapseWhitespace(result)
    end function

    '---------------------------------------------------------------------------
    ' Strings.GetJoinedText
    '---------------------------------------------------------------------------
    ' Example: [" First ", "", "Second"] returns "First, Second".
    '---------------------------------------------------------------------------
    function GetJoinedText(values as dynamic) as string
        if values = invalid then return ""

        if Type(values) <> "roArray" and Type(values) <> "roAssociativeArray" then
            return Strings.Trim(values.ToStr())
        end if

        result = ""
        for each value in values
            text = Strings.Trim(value.ToStr())
            if text <> "" then
                if result <> "" then result = result + ", "
                result = result + text
            end if
        end for

        return result
    end function

end namespace
