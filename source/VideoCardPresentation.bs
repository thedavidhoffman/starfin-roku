namespace VideoCardPresentation

    enum Type
        Poster = "poster"
        Thumbnail = "thumbnail"
        Jumbo = "jumbo"
        Detailed = "detailed"
    end enum

    '---------------------------------------------------------------------------
    ' VideoCardPresentation.Normalize
    '---------------------------------------------------------------------------
    function Normalize(value as dynamic) as string
        normalized = ""
        if value <> invalid then normalized = LCase(value.ToStr())
        if normalized = VideoCardPresentation.Type.Thumbnail then return VideoCardPresentation.Type.Thumbnail
        if normalized = VideoCardPresentation.Type.Jumbo then return VideoCardPresentation.Type.Jumbo
        if normalized = VideoCardPresentation.Type.Detailed then return VideoCardPresentation.Type.Detailed
        return VideoCardPresentation.Type.Poster
    end function

end namespace
