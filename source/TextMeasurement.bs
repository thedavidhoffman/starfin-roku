import "pkg:/source/Number.bs"

' Measures full text using Roku's actual SceneGraph font instead of estimating
' character widths or measuring a visible label constrained by its layout.
' Callers retain an unattached, unconstrained Label and reuse it for measurements;
' this helper updates that label's font and text and rounds the width up so the
' result does not clip fractional pixels. Padding and minimum widths belong to
' the caller.
namespace TextMeasurement

    '---------------------------------------------------------------------------
    ' TextMeasurement.GetWidth
    '---------------------------------------------------------------------------
    function GetWidth(measurementLabel as object, font as object, text as string) as integer
        measurementLabel.font = font
        measurementLabel.text = text
        measuredWidth = measurementLabel.boundingRect().width
        width = Number.ToInteger(measuredWidth, 0)
        if measuredWidth > width then width++
        return width
    end function

end namespace
