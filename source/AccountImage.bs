import "pkg:/source/String.bs"
import "pkg:/source/JellyfinImage.bs"

namespace AccountImage

    '---------------------------------------------------------------------------
    ' AccountImage.GetUri
    '---------------------------------------------------------------------------
    function GetUri(account as object, width as integer, height as integer) as string
        placeholderUri = "pkg:/images/cast/cast-placeholder-195x195.png"
        server = Url.NormalizeServer(Strings.ToString(account.server))
        userId = Strings.ToString(account.userId)
        primaryImageTag = Strings.ToString(account.primaryImageTag)
        if server = "" or userId = "" or primaryImageTag = "" then return placeholderUri

        query = Url.BuildQueryString({
            tag: primaryImageTag
            maxWidth: width
            maxHeight: height
            quality: 90
            format: "Jpg"
        })
        return server + "/Users/" + userId + "/Images/" + JellyfinImage.Type.Primary + query
    end function

end namespace
