namespace AccountImage

    '---------------------------------------------------------------------------
    ' AccountImage.GetUri
    '---------------------------------------------------------------------------
    function GetUri(account as object, width as integer, height as integer) as string
        placeholderUri = "pkg:/images/cast/cast-placeholder-195x195.png"
        server = Url.NormalizeServer(Format.SafeString(account.server, ""))
        userId = Format.SafeString(account.userId, "")
        primaryImageTag = Format.SafeString(account.primaryImageTag, "")
        if server = "" or userId = "" or primaryImageTag = "" then return placeholderUri

        query = Url.BuildQueryString({
            tag: primaryImageTag
            maxWidth: width
            maxHeight: height
            quality: 90
            format: "Jpg"
        })
        return server + "/Users/" + userId + "/Images/Primary" + query
    end function

end namespace
