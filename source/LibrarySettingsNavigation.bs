namespace LibrarySettingsNavigation

    '---------------------------------------------------------------------------
    ' LibrarySettingsNavigation.Move
    '---------------------------------------------------------------------------
    function Move(row as integer, position as integer, key as string, positionCounts as object) as object
        result = { row: row, position: position, exit: false, handled: true }
        if key = "back" then
            result.exit = true
            return result
        end if
        if key = "left" then
            if position = 0 then
                result.exit = true
            else
                result.position = position - 1
            end if
            return result
        end if
        if key = "right" then
            result.position = position + 1
        else if key = "up" then
            if row > 0 then result.row = row - 1
        else if key = "down" then
            if row < positionCounts.Count() - 1 then result.row = row + 1
        else
            result.handled = false
            return result
        end if

        maxPosition = positionCounts[result.row] - 1
        if result.position > maxPosition then result.position = maxPosition
        return result
    end function

end namespace
