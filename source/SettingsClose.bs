namespace SettingsClose
    enum Phase
        Open = "open"
        Saving = "saving"
        AwaitingDecision = "awaitingDecision"
        Closed = "closed"
    end enum

    enum Decision
        Retry = "retry"
        Discard = "discard"
        KeepEditing = "keepEditing"
    end enum

    enum Request
