namespace PlaybackMode

    '---------------------------------------------------------------------------
    ' PlaybackMode.Mode
    '---------------------------------------------------------------------------
    enum Mode
        Automatic = "automatic"
        AutomaticNoRemux = "automatic-no-remux"
        TranscodeAllowRemux = "transcode-allow-remux"
        TranscodeNoRemux = "transcode-no-remux"
    end enum

    '---------------------------------------------------------------------------
    ' PlaybackMode.Normalize
    '---------------------------------------------------------------------------
    function Normalize(value as dynamic) as string
        if value = invalid then return Mode.Automatic
        mode = value.ToStr()
        if mode = Mode.Automatic or mode = Mode.AutomaticNoRemux or mode = Mode.TranscodeAllowRemux or mode = Mode.TranscodeNoRemux then return mode
        return Mode.Automatic
    end function

end namespace
