import "pkg:/source/Number.bs"

namespace PlaybackBitrate

    '---------------------------------------------------------------------------
    ' PlaybackBitrate.Normalize
    '---------------------------------------------------------------------------
    function Normalize(value as dynamic) as integer
        bitrate = Number.ToInteger(value, 0)
        for each choice in [2000000, 4000000, 6000000, 8000000]
            if bitrate = choice then return bitrate
        end for
        return 0
    end function

end namespace
