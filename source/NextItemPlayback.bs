namespace NextItemPlayback

    enum Mode
        ShowUpNext = "show-up-next"
        PlayNextImmediately = "play-next-immediately"
    end enum

    function Normalize(value as dynamic) as string
        normalized = ""
        if value <> invalid then normalized = LCase(value.ToStr())
        if normalized = Mode.PlayNextImmediately then return normalized
        return Mode.ShowUpNext
    end function

end namespace
