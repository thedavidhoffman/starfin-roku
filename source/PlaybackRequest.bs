import "pkg:/source/Format.bs"

namespace PlaybackRequest

    '-------------------------------------------------------------------------------
    ' PlaybackRequest.Create
    '-------------------------------------------------------------------------------
    function Create(data as dynamic) as object
        if data = invalid then return {}

        request = {}
        for each key in data
            request[key] = data[key]
        end for

        if data.item <> invalid then request.item = PlaybackRequest.__CopyItem(data.item)
        if data.playbackQueue <> invalid then request.playbackQueue = PlaybackRequest.__CopyArray(data.playbackQueue)

        return request
    end function

    '-------------------------------------------------------------------------------
    ' PlaybackRequest.__CopyItem
    '-------------------------------------------------------------------------------
    function __CopyItem(value as dynamic) as dynamic
        if Type(value) <> "roAssociativeArray" then return value

        result = {}
        for each key in value
            result[key] = value[key]
        end for
        if Type(value.UserData) = "roAssociativeArray" then
            userData = {}
            for each key in value.UserData
                userData[key] = value.UserData[key]
            end for
            result.UserData = userData
        end if

        return result
    end function

    '-------------------------------------------------------------------------------
    ' PlaybackRequest.__CopyArray
    '-------------------------------------------------------------------------------
    function __CopyArray(value as dynamic) as dynamic
        if Type(value) <> "roArray" then return value

        result = []
        for each item in value
            result.Push(item)
        end for
        return result
    end function

    '-------------------------------------------------------------------------------
    ' PlaybackRequest.WithRequestId
    '-------------------------------------------------------------------------------
    function WithRequestId(request as dynamic, requestId as integer) as object
        return PlaybackRequest.WithChanges(request, { requestId: requestId })
    end function

    '-------------------------------------------------------------------------------
    ' PlaybackRequest.WithChanges
    '-------------------------------------------------------------------------------
    function WithChanges(request as dynamic, changes as dynamic) as object
        result = PlaybackRequest.Create(request)
        if changes = invalid then return result

        for each key in changes
            result[key] = changes[key]
        end for
        if changes.item <> invalid then result.item = PlaybackRequest.__CopyItem(changes.item)
        if changes.playbackQueue <> invalid then result.playbackQueue = PlaybackRequest.__CopyArray(changes.playbackQueue)

        return result
    end function

    '-------------------------------------------------------------------------------
    ' PlaybackRequest.FirstMediaSource
    '-------------------------------------------------------------------------------
    function FirstMediaSource(playbackInfo as dynamic) as dynamic
        if playbackInfo = invalid or playbackInfo.MediaSources = invalid then return invalid
        if playbackInfo.MediaSources.Count() = 0 then return invalid

        return playbackInfo.MediaSources[0]
    end function

    '-------------------------------------------------------------------------------
    ' PlaybackRequest.BuildServerUrl
    '-------------------------------------------------------------------------------
    function BuildServerUrl(server as string, path as string) as string
        if Instr(1, LCase(path), "http://") = 1 or Instr(1, LCase(path), "https://") = 1 then return path
        if Left(path, 1) = "/" then return server + path

        return server + "/" + path
    end function

    '-------------------------------------------------------------------------------
    ' PlaybackRequest.MaskUrl
    '-------------------------------------------------------------------------------
    function MaskUrl(requestUrl as dynamic) as string
        text = Format.SafeString(requestUrl, "")
        if text = "" then return ""

        for each name in ["api_key", "ApiKey", "token", "X-Emby-Token"]
            text = PlaybackRequest.__MaskQueryValue(text, name)
        end for

        return text
    end function

    '-------------------------------------------------------------------------------
    ' PlaybackRequest.GetAudioStreamFormat
    '-------------------------------------------------------------------------------
    function GetAudioStreamFormat(container as string) as string
        normalized = LCase(container)
        if normalized = "m4a" then return "mp4"
        if normalized = "" then return "mp3"

        return normalized
    end function

    '-------------------------------------------------------------------------------
    ' PlaybackRequest.GetVideoStreamFormat
    '-------------------------------------------------------------------------------
    function GetVideoStreamFormat(container as string) as string
        normalized = LCase(container)
        if normalized = "mov" or normalized = "m4v" then return "mp4"
        if normalized = "" then return "mp4"

        return normalized
    end function

    '-------------------------------------------------------------------------------
    ' PlaybackRequest.__MaskQueryValue
    '-------------------------------------------------------------------------------
    function __MaskQueryValue(requestUrl as string, name as string) as string
        queryStart = Instr(1, requestUrl, "?")
        if queryStart = 0 then return requestUrl

        lowerUrl = LCase(requestUrl)
        lowerName = LCase(name)
        searchStart = queryStart + 1

        while true
            keyStart = Instr(searchStart, lowerUrl, lowerName + "=")
            if keyStart = 0 then exit while

            isQueryKey = keyStart = queryStart + 1 or Mid(requestUrl, keyStart - 1, 1) = "&"
            if isQueryKey then
                valueStart = keyStart + Len(name) + 1
                valueEnd = Instr(valueStart, requestUrl, "&")
                if valueEnd = 0 then valueEnd = Len(requestUrl) + 1

                requestUrl = Left(requestUrl, valueStart - 1) + "[redacted]" + Mid(requestUrl, valueEnd)
                lowerUrl = LCase(requestUrl)
                searchStart = valueStart + Len("[redacted]")
            else
                searchStart = keyStart + Len(name) + 1
            end if
        end while

        return requestUrl
    end function

end namespace
