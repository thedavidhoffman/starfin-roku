namespace TaskRequest

    '---------------------------------------------------------------------------
    ' TaskRequest.ValidateRequest
    '---------------------------------------------------------------------------
    function ValidateRequest(request as dynamic, action as string, requiredProperties = [] as object) as dynamic
        if request = invalid then return { ok: false, action: action, errorMessage: "Invalid request." }
        if request.server = invalid or request.server = "" then return { ok: false, action: action, errorMessage: "Invalid request server." }
        if request.token = invalid or request.token = "" then return { ok: false, action: action, errorMessage: "Invalid request token." }

        for each propertyName in requiredProperties
            if request[propertyName] = invalid or request[propertyName] = "" then
                return { ok: false, action: action, errorMessage: "Invalid request " + propertyName + "." }
            end if
        end for

        return invalid
    end function

    '---------------------------------------------------------------------------
    ' TaskRequest.GetUserId
    '---------------------------------------------------------------------------
    function GetUserId(request as dynamic) as string
        if request = invalid then return ""
        if request.userId = invalid then return ""

        return Format.SafeString(request.userId, "")
    end function

end namespace
