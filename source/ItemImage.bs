namespace ItemImage

    '---------------------------------------------------------------------------
    ' ItemImage.GetTag
    '---------------------------------------------------------------------------
    function GetTag(item as dynamic, imageType as string) as string
        if item = invalid then return ""

        if imageType = "Backdrop" then
            if Type(item.BackdropImageTags) <> "roArray" or item.BackdropImageTags.Count() = 0 then return ""
            return Format.SafeString(item.BackdropImageTags[0], "")
        end if

        if item.ImageTags = invalid then return ""
        if imageType = "Primary" then return Format.SafeString(item.ImageTags.Primary, "")
        if imageType = "Thumb" then return Format.SafeString(item.ImageTags.Thumb, "")
        if imageType = "Logo" then return Format.SafeString(item.ImageTags.Logo, "")
        return ""
    end function

    '---------------------------------------------------------------------------
    ' ItemImage.GetUrl
    '---------------------------------------------------------------------------
    function GetUrl(server as dynamic, item as dynamic, imageType as string, width as integer, height as integer, options = invalid as dynamic) as string
        if item = invalid then return ""

        normalizedServer = Format.SafeString(server, "")
        itemId = Format.SafeString(item.Id, "")
        tag = ItemImage.GetTag(item, imageType)
        if normalizedServer = "" or itemId = "" or tag = "" then return ""

        return Url.BuildImageUrl(normalizedServer, itemId, imageType, tag, width, height, options)
    end function

    '---------------------------------------------------------------------------
    ' ItemImage.GetThumbnailUrl
    '---------------------------------------------------------------------------
    function GetThumbnailUrl(server as dynamic, item as dynamic, width as integer, height as integer) as string
        imageUrl = ItemImage.GetUrl(server, item, "Thumb", width, height)
        if imageUrl <> "" then return imageUrl
        imageUrl = ItemImage.GetUrl(server, item, "Backdrop", width, height)
        if imageUrl <> "" then return imageUrl
        return ItemImage.GetUrl(server, item, "Primary", width, height)
    end function

end namespace
