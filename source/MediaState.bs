import "pkg:/source/String.bs"

namespace MediaState

    enum Change
        Watched = "watched"
        Favorite = "favorite"
        Progress = "progress"
    end enum

    '---------------------------------------------------------------------------
    ' MediaState.ApplyToItem
    '---------------------------------------------------------------------------
    function ApplyToItem(item as object, mediaChange as object) as boolean
        action = Strings.ToString(mediaChange.action)
        if action <> "watched" and action <> "favorite" then return false
        if item.UserData = invalid then item.UserData = {}

        if action = "watched" then
            item.UserData.Played = mediaChange.value = true
            item.UserData.PlayedPercentage = 0
            if mediaChange.value = true then item.UserData.PlaybackPositionTicks = 0
            return true
        end if

        item.UserData.IsFavorite = mediaChange.value = true
        return true
    end function

end namespace
