import "pkg:/source/Format.bs"
import "pkg:/source/String.bs"

namespace Arrays

    '---------------------------------------------------------------------------
    ' Arrays.GetCount
    '---------------------------------------------------------------------------
    function GetCount(values as dynamic) as integer

        if values = invalid then return 0
        
        valueType = Type(values)
        if valueType <> "roArray" and valueType <> "roAssociativeArray" then return 0
        
        return values.Count()

    end function

    '---------------------------------------------------------------------------
    ' Arrays.IsAssocArray
    '---------------------------------------------------------------------------
    function IsAssocArray(value as dynamic) as boolean
        valueType = Type(value)
        return valueType = "roAssociativeArray" or valueType = "roSGNodeEvent"
    end function

    '---------------------------------------------------------------------------
    ' Arrays.JoinStringValues
    '---------------------------------------------------------------------------
    ' Example: ["one", "two", "three"] returns "one, two, three".
    '---------------------------------------------------------------------------
    function JoinStringValues(values as dynamic, separator = ", " as string) as string

        if values = invalid then return ""

        result = ""
        for each value in values
            part = Strings.Trim(Format.SafeString(value, ""))
            if part = "" then continue for

            if result <> "" then result = result + separator
            result = result + part
        end for

        return result

    end function

end namespace
