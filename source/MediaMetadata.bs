import "pkg:/source/Number.bs"

namespace MediaMetadata

    '---------------------------------------------------------------------------
    ' MediaMetadata.FormatRating
    '---------------------------------------------------------------------------
    ' Example: 8.25 returns "8.3".
    '---------------------------------------------------------------------------
    function FormatRating(value as dynamic) as string
        if value = invalid then return ""

        rating = val(value.ToStr())
        if rating <= 0 then return ""

        return (int((rating * 10) + 0.5) / 10).ToStr()
    end function

    '---------------------------------------------------------------------------
    ' MediaMetadata.FormatRuntime
    '---------------------------------------------------------------------------
    ' Example: 75000000000 ticks returns "2h 5m".
    '---------------------------------------------------------------------------
    function FormatRuntime(runTimeTicks as dynamic) as string
        if runTimeTicks = invalid then return ""

        minutes = int(runTimeTicks / 600000000)
        if minutes <= 0 then return ""

        hours = int(minutes / 60)
        remainingMinutes = minutes mod 60
        if hours > 0 then return hours.ToStr() + "h " + remainingMinutes.ToStr() + "m"
        return minutes.ToStr() + "m"
    end function

    '---------------------------------------------------------------------------
    ' MediaMetadata.BulletSeparator
    '---------------------------------------------------------------------------
    function BulletSeparator() as string
        return " • "
    end function

    '---------------------------------------------------------------------------
    ' MediaMetadata.NormalizeCriticRating
    '---------------------------------------------------------------------------
    function NormalizeCriticRating(value as dynamic) as dynamic
        if value = invalid then return invalid
        valueType = Type(value)
        if valueType <> "Integer" and valueType <> "roInt" and valueType <> "LongInteger" and valueType <> "roLongInteger" and valueType <> "Float" and valueType <> "roFloat" and valueType <> "Double" and valueType <> "roDouble" then return invalid
        rating = Number.ToFloat(value, -1)
        if rating < 0 or rating > 100 then return invalid
        return Number.ToInteger(rating + 0.5)
    end function

end namespace
