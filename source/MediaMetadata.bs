' Complete input for one metadata-row render; the row does not retain it.
class MediaMetadata
    public leadingText = "" as string
    public runtimeText = "" as string
    public officialRating = "" as string
    ' Ratings retain invalid and malformed API values for the existing formatters.
    ' In particular, a missing critic rating must not become a valid zero score.
    public communityRating = invalid as dynamic
    public criticRating = invalid as dynamic
    public itemSpacing = 18 as float
    public availableWidth = 1220 as float
    public truncateLeadingText = true as boolean
    public scaleToFit = false as boolean
end class
