import "pkg:/source/Format.bs"
import "pkg:/source/PlaybackProgress.bs"
import "pkg:/source/ItemImage.bs"
import "pkg:/source/Url.bs"
import "pkg:/source/String.bs"

namespace HomeVideoPlayback

    enum Overlay
        Playback = "homeVideoPlayback"
    end enum

    '---------------------------------------------------------------------------
    ' HomeVideoPlayback.CreateOverlayRequest
    '---------------------------------------------------------------------------
    function CreateOverlayRequest(item as object, server as string, sourcePage as string) as dynamic
        if PlaybackProgress.GetTicksFromItem(item) <= 0 then return invalid
        return {
            id: Overlay.Playback
            componentName: "HomeVideoPlaybackDialog"
            openFunction: "openPlayback"
            closeField: "closeRequested"
            sourcePage: sourcePage
            item: item
            itemImageUrl: ItemImage.GetThumbnailUrl(server, item, 441, 249)
        }
    end function

end namespace
