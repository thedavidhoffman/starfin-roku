import "pkg:/source/Number.bs"

namespace PlaybackResponse

    '-------------------------------------------------------------------------------
    ' PlaybackResponse.Success
    '-------------------------------------------------------------------------------
    function Success(request as dynamic, resolvedData as dynamic) as object
        response = {
            ok: true
            action: "playbackInfo"
            requestId: PlaybackResponse.__GetRequestId(request)
        }

        return PlaybackResponse.__WithData(response, resolvedData)
    end function

    '-------------------------------------------------------------------------------
    ' PlaybackResponse.Failure
    '-------------------------------------------------------------------------------
    function Failure(request as dynamic, error as dynamic) as object
        response = {
            ok: false
            action: "playbackInfo"
            requestId: PlaybackResponse.__GetRequestId(request)
            errorMessage: "Unable to play this item."
        }

        return PlaybackResponse.__WithData(response, error)
    end function

    '-------------------------------------------------------------------------------
    ' PlaybackResponse.__WithData
    '-------------------------------------------------------------------------------
    function __WithData(response as object, data as dynamic) as object
        if data = invalid then return response

        for each key in data
            normalizedKey = LCase(key)
            if normalizedKey <> "ok" and normalizedKey <> "action" and normalizedKey <> "requestid" then response[key] = data[key]
        end for

        return response
    end function

    '-------------------------------------------------------------------------------
    ' PlaybackResponse.__GetRequestId
    '-------------------------------------------------------------------------------
    function __GetRequestId(request as dynamic) as integer
        if request = invalid then return -1
        return Number.ToInteger(request.requestId, -1)
    end function

end namespace
