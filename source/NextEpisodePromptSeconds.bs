namespace NextEpisodePromptSeconds

    enum Preset
        Off = "0"
        FifteenSeconds = "15"
        ThirtySeconds = "30"
        FortyFiveSeconds = "45"
        SixtySeconds = "60"
        SeventyFiveSeconds = "75"
        NinetySeconds = "90"
        OneHundredFiveSeconds = "105"
        OneHundredTwentySeconds = "120"
    end enum

    '---------------------------------------------------------------------------
    ' NextEpisodePromptSeconds.Options
    '---------------------------------------------------------------------------
    function Options() as object
        return [
            { value: Preset.Off, title: "Off" }
            { value: Preset.FifteenSeconds, title: "15 seconds" }
            { value: Preset.ThirtySeconds, title: "30 seconds" }
            { value: Preset.FortyFiveSeconds, title: "45 seconds" }
            { value: Preset.SixtySeconds, title: "60 seconds" }
            { value: Preset.SeventyFiveSeconds, title: "75 seconds" }
            { value: Preset.NinetySeconds, title: "90 seconds" }
            { value: Preset.OneHundredFiveSeconds, title: "105 seconds" }
            { value: Preset.OneHundredTwentySeconds, title: "120 seconds" }
        ]
    end function

    '---------------------------------------------------------------------------
    ' NextEpisodePromptSeconds.Normalize
    '---------------------------------------------------------------------------
    function Normalize(value as dynamic) as string
        normalized = ""
        if value <> invalid then normalized = value.ToStr()
        if normalized = Preset.FifteenSeconds then return normalized
        if normalized = Preset.ThirtySeconds then return normalized
        if normalized = Preset.FortyFiveSeconds then return normalized
        if normalized = Preset.SixtySeconds then return normalized
        if normalized = Preset.SeventyFiveSeconds then return normalized
        if normalized = Preset.NinetySeconds then return normalized
        if normalized = Preset.OneHundredFiveSeconds then return normalized
        if normalized = Preset.OneHundredTwentySeconds then return normalized
        return Preset.Off
    end function

end namespace
