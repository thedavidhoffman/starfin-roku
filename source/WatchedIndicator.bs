namespace WatchedIndicator

    enum Style
        Subtle = "subtle"
        HighContrast = "high-contrast"
    end enum

    '---------------------------------------------------------------------------
    ' WatchedIndicator.Normalize
    '---------------------------------------------------------------------------
    function Normalize(value as dynamic) as string
        if GetInterface(value, "ifString") <> invalid then
            if LCase(value.Trim()) = Style.HighContrast then return Style.HighContrast
        end if
        return Style.Subtle
    end function

    '---------------------------------------------------------------------------
    ' WatchedIndicator.GetImageUri
    '---------------------------------------------------------------------------
    function GetImageUri(value as dynamic) as string
        if Normalize(value) = Style.HighContrast then return "pkg:/images/icons/watched-check-high-contrast.png"
        return "pkg:/images/icons/watched-check.png"
    end function

end namespace
