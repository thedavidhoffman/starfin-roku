'-------------------------------------------------------------------------------
' VideoLibrarySort_ByReleaseDate
'-------------------------------------------------------------------------------
function VideoLibrarySort_ByReleaseDate(items as object, sortOrder = "Ascending" as string) as object
    entries = []
    if items = invalid then return entries

    for each item in items
        entries.Push({
            item: item
            sortKey: __GetVideoLibraryReleaseDateSortKey(item)
        })
    end for

    return __SortVideoLibraryEntries(entries, sortOrder)
end function

'-------------------------------------------------------------------------------
' VideoLibrarySort_ByDateAdded
'-------------------------------------------------------------------------------
function VideoLibrarySort_ByDateAdded(items as object, sortOrder = "Ascending" as string) as object
    entries = []
    if items = invalid then return entries

    for each item in items
        entries.Push({
            item: item
            sortKey: __GetVideoLibraryDateAddedSortKey(item)
        })
    end for

    return __SortVideoLibraryEntries(entries, sortOrder)
end function

'-------------------------------------------------------------------------------
' VideoLibrarySort_ByTitle
'-------------------------------------------------------------------------------
function VideoLibrarySort_ByTitle(items as object, sortOrder = "Ascending" as string) as object
    entries = []
    if items = invalid then return entries

    for each item in items
        entries.Push({
            item: item
            sortKey: __GetVideoLibrarySortTitle(item)
        })
    end for

    return __SortVideoLibraryEntries(entries, sortOrder)
end function

'-------------------------------------------------------------------------------
' VideoLibrarySort_Shuffle
'-------------------------------------------------------------------------------
function VideoLibrarySort_Shuffle(items as object, randomValues = invalid as dynamic) as object
    shuffledItems = []
    if items = invalid then return shuffledItems

    for each item in items
        shuffledItems.Push(item)
    end for

    randomIndex = 0
    for i = shuffledItems.Count() - 1 to 1 step -1
        randomValue = Rnd(0)
        if randomValues <> invalid and randomIndex < randomValues.Count() then randomValue = Number.ToFloat(randomValues[randomIndex], 0.0)
        randomIndex = randomIndex + 1

        swapIndex = Number.ToInteger(randomValue * (i + 1), 0)
        if swapIndex < 0 then swapIndex = 0
        if swapIndex > i then swapIndex = i

        temp = shuffledItems[i]
        shuffledItems[i] = shuffledItems[swapIndex]
        shuffledItems[swapIndex] = temp
    end for

    return shuffledItems
end function

'-------------------------------------------------------------------------------
' __SortVideoLibraryEntries
'-------------------------------------------------------------------------------
function __SortVideoLibraryEntries(entries as object, sortOrder as string) as object
    entries.SortBy("sortKey")

    sortedItems = []
    if sortOrder = "Descending" then
        for i = entries.Count() - 1 to 0 step -1
            sortedItems.Push(entries[i].item)
        end for
    else
        for each entry in entries
            sortedItems.Push(entry.item)
        end for
    end if

    return sortedItems
end function

'-------------------------------------------------------------------------------
' __GetVideoLibraryDateAddedSortKey
'-------------------------------------------------------------------------------
function __GetVideoLibraryDateAddedSortKey(item as object) as string
    dateCreatedKey = "0000-00-00"
    dateCreated = SafeString(item.DateCreated, "")
    if Len(dateCreated) >= 4 and Number.ToInteger(Left(dateCreated, 4), 0) > 0 then dateCreatedKey = dateCreated

    return dateCreatedKey + "|" + __GetVideoLibrarySortTitle(item)
end function

'-------------------------------------------------------------------------------
' __GetVideoLibraryReleaseDateSortKey
'-------------------------------------------------------------------------------
function __GetVideoLibraryReleaseDateSortKey(item as object) as string
    releaseDateKey = "0000-00-00"
    premiereDate = SafeString(item.PremiereDate, "")
    if Len(premiereDate) >= 4 and Number.ToInteger(Left(premiereDate, 4), 0) > 0 then
        releaseDateKey = premiereDate
    else
        productionYear = Number.ToInteger(item.ProductionYear, 0)
        if productionYear > 0 then releaseDateKey = Right("0000" + productionYear.ToStr(), 4) + "-00-00"
    end if

    return releaseDateKey + "|" + __GetVideoLibrarySortTitle(item)
end function

'-------------------------------------------------------------------------------
' __GetVideoLibrarySortTitle
'-------------------------------------------------------------------------------
function __GetVideoLibrarySortTitle(item as object) as string
    title = String_Trim(SafeString(item.SortName, ""))
    if title = "" then title = String_Trim(SafeString(item.Name, ""))
    return LCase(title)
end function
