namespace VideoLibrarySort

    '---------------------------------------------------------------------------
    ' VideoLibrarySort.ByReleaseDate
    '---------------------------------------------------------------------------
    function ByReleaseDate(items as object, sortOrder = "Ascending" as string) as object
        entries = []
        if items = invalid then return entries

        for each item in items
            entries.Push({
                item: item
                sortKey: VideoLibrarySort.__GetReleaseDateKey(item)
            })
        end for

        return VideoLibrarySort.__SortEntries(entries, sortOrder)
    end function

    '---------------------------------------------------------------------------
    ' VideoLibrarySort.ByDateAdded
    '---------------------------------------------------------------------------
    function ByDateAdded(items as object, sortOrder = "Ascending" as string) as object
        entries = []
        if items = invalid then return entries

        for each item in items
            entries.Push({
                item: item
                sortKey: VideoLibrarySort.__GetDateAddedKey(item)
            })
        end for

        return VideoLibrarySort.__SortEntries(entries, sortOrder)
    end function

    '---------------------------------------------------------------------------
    ' VideoLibrarySort.ByTitle
    '---------------------------------------------------------------------------
    function ByTitle(items as object, sortOrder = "Ascending" as string) as object
        entries = []
        if items = invalid then return entries

        for each item in items
            entries.Push({
                item: item
                sortKey: VideoLibrarySort.__GetTitle(item)
            })
        end for

        return VideoLibrarySort.__SortEntries(entries, sortOrder)
    end function

    '---------------------------------------------------------------------------
    ' VideoLibrarySort.Shuffle
    '---------------------------------------------------------------------------
    function Shuffle(items as object, randomValues = invalid as dynamic) as object
        shuffledItems = []
        if items = invalid then return shuffledItems

        for each item in items
            shuffledItems.Push(item)
        end for

        randomIndex = 0
        for i = shuffledItems.Count() - 1 to 1 step -1
            randomValue = Rnd(0)
            if randomValues <> invalid and randomIndex < randomValues.Count() then randomValue = Number.ToFloat(randomValues[randomIndex], 0.0)
            randomIndex = randomIndex + 1

            swapIndex = Number.ToInteger(randomValue * (i + 1), 0)
            if swapIndex < 0 then swapIndex = 0
            if swapIndex > i then swapIndex = i

            temp = shuffledItems[i]
            shuffledItems[i] = shuffledItems[swapIndex]
            shuffledItems[swapIndex] = temp
        end for

        return shuffledItems
    end function

    '---------------------------------------------------------------------------
    ' VideoLibrarySort.__SortEntries
    '---------------------------------------------------------------------------
    function __SortEntries(entries as object, sortOrder as string) as object
        entries.SortBy("sortKey")

        sortedItems = []
        if sortOrder = "Descending" then
            for i = entries.Count() - 1 to 0 step -1
                sortedItems.Push(entries[i].item)
            end for
        else
            for each entry in entries
                sortedItems.Push(entry.item)
            end for
        end if

        return sortedItems
    end function

    '---------------------------------------------------------------------------
    ' VideoLibrarySort.__GetDateAddedKey
    '---------------------------------------------------------------------------
    function __GetDateAddedKey(item as object) as string
        dateCreatedKey = "0000-00-00"
        dateCreated = Format.SafeString(item.DateCreated, "")
        if Len(dateCreated) >= 4 and Number.ToInteger(Left(dateCreated, 4), 0) > 0 then dateCreatedKey = dateCreated

        return dateCreatedKey + "|" + VideoLibrarySort.__GetTitle(item)
    end function

    '---------------------------------------------------------------------------
    ' VideoLibrarySort.__GetReleaseDateKey
    '---------------------------------------------------------------------------
    function __GetReleaseDateKey(item as object) as string
        releaseDateKey = "0000-00-00"
        premiereDate = Format.SafeString(item.PremiereDate, "")
        if Len(premiereDate) >= 4 and Number.ToInteger(Left(premiereDate, 4), 0) > 0 then
            releaseDateKey = premiereDate
        else
            productionYear = Number.ToInteger(item.ProductionYear, 0)
            if productionYear > 0 then releaseDateKey = Right("0000" + productionYear.ToStr(), 4) + "-00-00"
        end if

        return releaseDateKey + "|" + VideoLibrarySort.__GetTitle(item)
    end function

    '---------------------------------------------------------------------------
    ' VideoLibrarySort.__GetTitle
    '---------------------------------------------------------------------------
    function __GetTitle(item as object) as string
        title = Strings.Trim(Format.SafeString(item.SortName, ""))
        if title = "" then title = Strings.Trim(Format.SafeString(item.Name, ""))
        return LCase(title)
    end function

end namespace
