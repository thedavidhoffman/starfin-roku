namespace MaskAssets

    '---------------------------------------------------------------------------
    ' MaskAssets.GetProfile
    '---------------------------------------------------------------------------
    function GetProfile(filename as string, fhdSize as object, hdSize as object) as object
        if ResolutionProfile.IsHd() then
            return {
                uri: ResolutionAssets.GetMaskImageUri(filename)
                size: hdSize
                isHd: true
            }
        end if

        return {
            uri: ResolutionAssets.GetMaskImageUri(filename)
            size: fhdSize
            isHd: false
        }
    end function

    '---------------------------------------------------------------------------
    ' MaskAssets.Apply
    '---------------------------------------------------------------------------
    sub Apply(maskNode as object, filename as string, fhdSize as object, hdSize as object)
        profile = MaskAssets.GetProfile(filename, fhdSize, hdSize)
        maskNode.maskUri = profile.uri
        maskNode.maskSize = profile.size
    end sub

end namespace
