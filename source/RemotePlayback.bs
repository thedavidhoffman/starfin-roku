import "pkg:/source/Array.bs"
import "pkg:/source/String.bs"
import "pkg:/source/MediaItem.bs"

namespace RemotePlayback

    '---------------------------------------------------------------------------
    ' RemotePlayback.BuildSelection
    '---------------------------------------------------------------------------
    function BuildSelection(item as dynamic) as dynamic
        if Arrays.IsAssocArray(item) <> true or Strings.ToString(item.Id) = "" then return invalid
        itemType = Strings.ToString(item.Type)
        if itemType <> MediaItem.Type.Movie and itemType <> MediaItem.Type.Episode and itemType <> MediaItem.Type.Video and itemType <> MediaItem.Type.MusicVideo and itemType <> MediaItem.Type.MusicAlbum then return invalid
        if item.IsMissing = true or item.IsVirtualItem = true then return invalid
        return { itemId: item.Id, item: item, loadItemDetails: itemType <> MediaItem.Type.MusicAlbum }
    end function

end namespace
