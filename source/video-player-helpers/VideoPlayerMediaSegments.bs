import "pkg:/source/Format.bs"
import "pkg:/source/Number.bs"

namespace VideoPlayerMediaSegments

    '---------------------------------------------------------------------------
    ' VideoPlayerMediaSegments.HasSegments
    '---------------------------------------------------------------------------
    function HasSegments(playbackInfo as dynamic) as boolean
        if playbackInfo = invalid or playbackInfo.MediaSources = invalid then return false
        if playbackInfo.MediaSources.Count() = 0 or playbackInfo.MediaSources[0] = invalid then return false
        return playbackInfo.MediaSources[0].HasSegments = true
    end function

    '---------------------------------------------------------------------------
    ' VideoPlayerMediaSegments.BuildIntros
    '---------------------------------------------------------------------------
    function BuildIntros(segments as dynamic) as object
        return VideoPlayerMediaSegments.__BuildRanges(segments, "intro")
    end function

    '---------------------------------------------------------------------------
    ' VideoPlayerMediaSegments.BuildOutros
    '---------------------------------------------------------------------------
    function BuildOutros(segments as dynamic) as object
        return VideoPlayerMediaSegments.__BuildRanges(segments, "outro")
    end function

    '---------------------------------------------------------------------------
    ' VideoPlayerMediaSegments.__BuildRanges
    '---------------------------------------------------------------------------
    function __BuildRanges(segments as dynamic, segmentType as string) as object
        ranges = []
        if segments = invalid then return ranges
        for each segment in segments
            if segment <> invalid and LCase(Format.SafeString(segment.Type, "")) = segmentType then
                startSeconds = Number.ToFloat(segment.StartTicks, 0.0) / 10000000
                endSeconds = Number.ToFloat(segment.EndTicks, 0.0) / 10000000
                if endSeconds > startSeconds then ranges.Push({ startSeconds: startSeconds, endSeconds: endSeconds })
            end if
        end for
        return ranges
    end function

    '---------------------------------------------------------------------------
    ' VideoPlayerMediaSegments.EvaluateOutro
    '---------------------------------------------------------------------------
    function EvaluateOutro(outros as dynamic, position as float, dismissedEndSeconds as float) as object
        result = VideoPlayerMediaSegments.EvaluateIntro(outros, position, dismissedEndSeconds)
        return { activeOutro: result.activeIntro, dismissedEndSeconds: result.dismissedEndSeconds }
    end function

    '---------------------------------------------------------------------------
    ' VideoPlayerMediaSegments.EvaluateIntro
    '---------------------------------------------------------------------------
    function EvaluateIntro(intros as dynamic, position as float, dismissedEndSeconds as float) as object
        result = { activeIntro: invalid, dismissedEndSeconds: dismissedEndSeconds }
        if intros = invalid then return result

        for each intro in intros
            if intro <> invalid and position >= intro.startSeconds and position < intro.endSeconds - 5 then
                if intro.endSeconds <> dismissedEndSeconds then result.activeIntro = intro
                return result
            end if
        end for

        if dismissedEndSeconds >= 0 and position >= dismissedEndSeconds then result.dismissedEndSeconds = -1
        return result
    end function

end namespace
