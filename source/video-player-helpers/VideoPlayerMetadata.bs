import "pkg:/source/Format.bs"
import "pkg:/source/Number.bs"
import "pkg:/source/SeriesIdentity.bs"
import "pkg:/source/DateTime.bs"
import "pkg:/source/MediaMetadata.bs"

namespace VideoPlayerMetadata

    '---------------------------------------------------------------------------
    ' VideoPlayerMetadata.GetItemTitle
    '---------------------------------------------------------------------------
    function GetItemTitle(item as dynamic) as string
        if item = invalid then return "Video"
        return Format.FirstNonEmpty([item.Name], "Video")
    end function

    '---------------------------------------------------------------------------
    ' VideoPlayerMetadata.IsEpisode
    '---------------------------------------------------------------------------
    function IsEpisode(request as dynamic, item as dynamic) as boolean
        if request <> invalid and request.series <> invalid then return true
        if item = invalid then return false
        return LCase(Format.FirstNonEmpty([item.Type], "")) = "episode"
    end function

    '---------------------------------------------------------------------------
    ' VideoPlayerMetadata.IsMovie
    '---------------------------------------------------------------------------
    function IsMovie(request as dynamic, item as dynamic) as boolean
        if VideoPlayerMetadata.IsEpisode(request, item) then return false
        if item = invalid then return false
        itemType = LCase(Format.FirstNonEmpty([item.Type], ""))
        return itemType = "movie" or itemType = "video" or itemType = "musicvideo"
    end function

    '---------------------------------------------------------------------------
    ' VideoPlayerMetadata.IsMusicVideo
    '---------------------------------------------------------------------------
    function IsMusicVideo(item as dynamic) as boolean
        if item = invalid then return false
        return LCase(Format.SafeString(item.Type, "")) = "musicvideo"
    end function

    '---------------------------------------------------------------------------
    ' VideoPlayerMetadata.GetMusicVideoArtists
    '---------------------------------------------------------------------------
    function GetMusicVideoArtists(item as dynamic) as string
        if item = invalid or Type(item.Artists) <> "roArray" then return ""
        artists = []
        for each artist in item.Artists
            artistName = Format.SafeString(artist, "")
            if artistName <> "" then artists.Push(artistName)
        end for
        return artists.Join(", ")
    end function

    '---------------------------------------------------------------------------
    ' VideoPlayerMetadata.ShouldShowRandomMusicVideoSkip
    '---------------------------------------------------------------------------
    function ShouldShowRandomMusicVideoSkip(item as dynamic, queueMode as dynamic, queueScope as dynamic, hasNext as boolean, position as dynamic, dismissed as boolean) as boolean
        if VideoPlayerMetadata.IsMusicVideo(item) <> true then return false
        if Format.SafeString(queueMode, "") <> "random" or Format.SafeString(queueScope, "") <> "random" then return false
        if hasNext <> true or dismissed = true then return false
        playbackPosition = Number.ToFloat(position, 0)
        return playbackPosition >= 0 and playbackPosition < 5
    end function

    '---------------------------------------------------------------------------
    ' VideoPlayerMetadata.GetSeriesTitle
    '---------------------------------------------------------------------------
    function GetSeriesTitle(request as dynamic, item as dynamic) as string
        if request <> invalid and request.series <> invalid then
            identity = SeriesIdentity.FromItem(Format.SafeString(request.server, ""), request.series)
            title = Format.FirstNonEmpty([identity.Name], "")
            if title <> "" then return title
        end if
        if item = invalid then return "Video"
        return Format.FirstNonEmpty([item.SeriesName, item.Series], VideoPlayerMetadata.GetItemTitle(item))
    end function

    '---------------------------------------------------------------------------
    ' VideoPlayerMetadata.GetMovieText
    '---------------------------------------------------------------------------
    function GetMovieText(item as dynamic) as string
        if item = invalid then return ""
        year = Format.FirstNonEmpty([item.ProductionYear], "")
        if year = "" then year = DateTime.ToYear(item.PremiereDate)
        return year
    end function

    '---------------------------------------------------------------------------
    ' VideoPlayerMetadata.GetEpisodeText
    '---------------------------------------------------------------------------
    function GetEpisodeText(item as dynamic) as string
        if item = invalid then return ""
        parts = []
        episodeNumberText = VideoPlayerMetadata.__GetEpisodeNumberText(item)
        if episodeNumberText <> "" then parts.Push(episodeNumberText)
        title = Format.FirstNonEmpty([item.Name], "")
        if title <> "" then parts.Push(title)
        dateText = DateTime.ToShortDate(VideoPlayerMetadata.__GetAiredDateText(item))
        if dateText <> "" then parts.Push(dateText)
        runtimeText = MediaMetadata.FormatRuntime(item.RunTimeTicks)
        if runtimeText <> "" then parts.Push(runtimeText)
        return VideoPlayerMetadata.__Join(parts)
    end function

    '---------------------------------------------------------------------------
    ' VideoPlayerMetadata.__GetEpisodeNumberText
    '---------------------------------------------------------------------------
    function __GetEpisodeNumberText(item as dynamic) as string
        if item = invalid then return ""
        seasonNumber = Format.FirstNonEmpty([item.ParentIndexNumber, item.SeasonNumber], "")
        episodeNumber = Format.FirstNonEmpty([item.IndexNumber, item.EpisodeNumber], "")
        if seasonNumber <> "" and episodeNumber <> "" then return "S" + seasonNumber + MediaMetadata.BulletSeparator() + "E" + episodeNumber
        if seasonNumber <> "" then return "S" + seasonNumber
        if episodeNumber <> "" then return "E" + episodeNumber
        return ""
    end function

    '---------------------------------------------------------------------------
    ' VideoPlayerMetadata.__GetAiredDateText
    '---------------------------------------------------------------------------
    function __GetAiredDateText(item as dynamic) as string
        if item = invalid then return ""
        airedDate = Format.FirstNonEmpty([item.PremiereDate, item.AirDate, item.DateCreated], "")
        if Len(airedDate) >= 10 then return Left(airedDate, 10)
        return airedDate
    end function

    '---------------------------------------------------------------------------
    ' VideoPlayerMetadata.__Join
    '---------------------------------------------------------------------------
    function __Join(values as dynamic) as string
        if values = invalid then return ""
        result = ""
        for each value in values
            text = Format.SafeString(value, "")
            if text = "" then continue for
            if result <> "" then result = result + MediaMetadata.BulletSeparator()
            result = result + text
        end for
        return result
    end function

    '---------------------------------------------------------------------------
    ' VideoPlayerMetadata.GetRuntimeSeconds
    '---------------------------------------------------------------------------
    function GetRuntimeSeconds(item as dynamic) as float
        if item = invalid or item.RunTimeTicks = invalid or item.RunTimeTicks <= 0 then return 0
        return item.RunTimeTicks / 10000000
    end function

    '---------------------------------------------------------------------------
    ' VideoPlayerMetadata.ClampSeconds
    '---------------------------------------------------------------------------
    function ClampSeconds(value as float, minimum as float, maximum as float) as float
        if value < minimum then return minimum
        if value > maximum then return maximum
        return value
    end function

end namespace
