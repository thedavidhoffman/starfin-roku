import "pkg:/source/Format.bs"

namespace VideoPlayerStreamSelection

    '---------------------------------------------------------------------------
    ' VideoPlayerStreamSelection.__GetStreams
    '---------------------------------------------------------------------------
    function __GetStreams(item as dynamic, streamType as string) as object
        if item = invalid or item.MediaStreams = invalid then return []
        streams = []
        targetType = LCase(streamType)
        for each stream in item.MediaStreams
            if stream <> invalid and LCase(Format.SafeString(stream.Type, "")) = targetType then streams.Push(stream)
        end for
        return streams
    end function

    '---------------------------------------------------------------------------
    ' VideoPlayerStreamSelection.GetSubtitleStreams
    '---------------------------------------------------------------------------
    function GetSubtitleStreams(item as dynamic) as object
        return VideoPlayerStreamSelection.__GetStreams(item, "subtitle")
    end function

    '---------------------------------------------------------------------------
    ' VideoPlayerStreamSelection.GetAudioStreams
    '---------------------------------------------------------------------------
    function GetAudioStreams(item as dynamic) as object
        return VideoPlayerStreamSelection.__GetStreams(item, "audio")
    end function

end namespace
