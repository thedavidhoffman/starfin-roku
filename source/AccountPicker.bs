import "pkg:/source/Url.bs"

namespace AccountPicker
    enum Source
        Header = "header"
        Login = "login"
        Startup = "startup"
    end enum

    enum Mode
        Picker = "picker"
        Remove = "remove"
    end enum

    '---------------------------------------------------------------------------
    ' AccountPicker.HasMultipleServers
    '---------------------------------------------------------------------------
    function HasMultipleServers(accounts as dynamic) as boolean
        if accounts = invalid or accounts.Count() < 2 then return false
        server = Url.ServerIdentity(accounts[0].server)
        for each account in accounts
            if Url.ServerIdentity(account.server) <> server then return true
        end for
        return false
    end function
end namespace
