import "pkg:/source/Char.bs"
import "pkg:/source/Format.bs"
import "pkg:/source/Url.bs"

namespace JellyfinAuth

    '---------------------------------------------------------------------------
    ' JellyfinAuth.BuildClientHeader
    '---------------------------------------------------------------------------
    function BuildClientHeader() as string
        quote = Char.DoubleQuote
        deviceInfo = CreateObject("roDeviceInfo")
        appInfo = CreateObject("roAppInfo")

        deviceName = Format.SafeString(deviceInfo.GetModelDisplayName(), "")
        if deviceName = "" then deviceName = Format.SafeString(deviceInfo.GetModel(), "Roku")

        deviceId = Format.SafeString(deviceInfo.GetChannelClientId(), "")
        if deviceId = "" then deviceId = Format.SafeString(deviceInfo.GetModel(), "roku")

        auth = "MediaBrowser Client=" + quote + "Starfin Roku" + quote
        auth = auth + ", Device=" + quote + deviceName + quote
        auth = auth + ", Version=" + quote + Format.SafeString(appInfo.GetVersion(), "1.0.0") + quote
        auth = auth + ", DeviceId=" + quote + deviceId + quote

        return auth
    end function

    '---------------------------------------------------------------------------
    ' JellyfinAuth.BuildAuthorizationHeader
    '---------------------------------------------------------------------------
    function BuildAuthorizationHeader(token as dynamic, userId = invalid as dynamic) as string
        quote = Char.DoubleQuote
        auth = JellyfinAuth.BuildClientHeader()

        if userId <> invalid and userId <> "" then
            auth = auth + ", UserId=" + quote + Format.SafeString(userId, "") + quote
        end if

        if token <> invalid and token <> "" then
            auth = auth + ", Token=" + quote + Format.SafeString(token, "") + quote
        end if

        return auth
    end function

    '---------------------------------------------------------------------------
    ' JellyfinAuth.BuildTokenHeaders
    '---------------------------------------------------------------------------
    function BuildTokenHeaders(token as dynamic) as object
        return {
            Authorization: JellyfinAuth.BuildAuthorizationHeader(token)
        }
    end function

    '---------------------------------------------------------------------------
    ' JellyfinAuth.BuildMediaRequest
    '---------------------------------------------------------------------------
    function BuildMediaRequest(server as dynamic, urlValue as dynamic, token as dynamic, userId = invalid as dynamic) as object
        resolvedUrl = Url.Resolve(server, urlValue)
        result = { url: resolvedUrl, headers: {} }
        if JellyfinAuth.__CanAuthenticate(server, resolvedUrl) <> true then return result

        if Format.SafeString(token, "") <> "" then result.headers = { Authorization: JellyfinAuth.BuildAuthorizationHeader(token, userId) }
        return result
    end function

    '---------------------------------------------------------------------------
    ' JellyfinAuth.CreateContent
    '---------------------------------------------------------------------------
    function CreateContent(server as dynamic, streamUrl as dynamic, token as dynamic, userId = invalid as dynamic) as object
        mediaRequest = JellyfinAuth.BuildMediaRequest(server, streamUrl, token, userId)
        content = CreateObject("roSGNode", "ContentNode")
        content.url = mediaRequest.url
        headers = []
        if mediaRequest.headers.Authorization <> invalid then headers.Push("Authorization: " + mediaRequest.headers.Authorization)
        content.HttpHeaders = headers
        return content
    end function

    '---------------------------------------------------------------------------
    ' JellyfinAuth.__CanAuthenticate
    '---------------------------------------------------------------------------
    function __CanAuthenticate(server as dynamic, urlValue as string) as boolean
        origin = Url.GetOrigin(server)
        return origin <> "" and Url.GetOrigin(urlValue) = origin
    end function

end namespace
