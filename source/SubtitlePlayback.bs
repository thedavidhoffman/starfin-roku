import "pkg:/source/Url.bs"

namespace SubtitlePlayback

    function NormalizeDeliveryMethod(value as dynamic) as string
        method = LCase(Format.SafeString(value, "none"))
        if method = "external" then return "external"
        if method = "encode" then return "encode"
        return "none"
    end function

    function RequiresRestart(currentDeliveryMethod as dynamic, targetDeliveryMethod as dynamic) as boolean
        currentMethod = SubtitlePlayback.NormalizeDeliveryMethod(currentDeliveryMethod)
        targetMethod = SubtitlePlayback.NormalizeDeliveryMethod(targetDeliveryMethod)
        return currentMethod <> "external" or targetMethod <> "external"
    end function

    '---------------------------------------------------------------------------
    ' SubtitlePlayback.BuildExternalTrack
    '---------------------------------------------------------------------------
    function BuildExternalTrack(playbackInfo as dynamic, streamIndex as integer, server as string) as dynamic
        stream = SubtitlePlayback.__GetSelectedStream(playbackInfo, streamIndex)
        if stream = invalid then return invalid
        if LCase(Format.SafeString(stream.DeliveryMethod, "")) <> "external" then return invalid

        deliveryUrl = Url.Resolve(server, stream.DeliveryUrl)
        if deliveryUrl = "" then return invalid

        return {
            index: streamIndex
            codec: Format.SafeString(stream.Codec, "")
            deliveryUrl: deliveryUrl
            track: {
                Language: Format.SafeString(stream.Language, "")
                Description: Format.FirstNonEmpty([stream.DisplayTitle, stream.Title], "")
                TrackName: deliveryUrl
            }
        }
    end function

    function BuildExternalTracks(playbackInfo as dynamic, server as string) as object
        tracks = []
        if playbackInfo = invalid or playbackInfo.MediaSources = invalid or playbackInfo.MediaSources.Count() = 0 then return tracks
        mediaSource = playbackInfo.MediaSources[0]
        if mediaSource = invalid or mediaSource.MediaStreams = invalid then return tracks
        for each stream in mediaSource.MediaStreams
            if stream <> invalid and LCase(Format.SafeString(stream.Type, "")) = "subtitle" then
                track = SubtitlePlayback.BuildExternalTrack(playbackInfo, Number.ToInteger(stream.Index, SubtitleSelection.None), server)
                if track <> invalid then tracks.Push(track)
            end if
        end for
        return tracks
    end function

    function FindExternalTrack(tracks as dynamic, streamIndex as integer) as dynamic
        if tracks = invalid then return invalid
        for each track in tracks
            if track <> invalid and Number.ToInteger(track.index, SubtitleSelection.None) = streamIndex then return track
        end for
        return invalid
    end function

    '---------------------------------------------------------------------------
    ' SubtitlePlayback.GetDeliveryMethod
    '---------------------------------------------------------------------------
    function GetDeliveryMethod(playbackInfo as dynamic, streamIndex as integer) as string
        stream = SubtitlePlayback.__GetSelectedStream(playbackInfo, streamIndex)
        if stream = invalid then return ""
        return LCase(Format.SafeString(stream.DeliveryMethod, ""))
    end function

    '---------------------------------------------------------------------------
    ' SubtitlePlayback.FindAvailableTrackName
    '---------------------------------------------------------------------------
    function FindAvailableTrackName(availableTracks as dynamic, deliveryUrl as string) as string
        if availableTracks = invalid or deliveryUrl = "" then return ""

        for each availableTrack in availableTracks
            if availableTrack = invalid then continue for
            trackName = Format.SafeString(availableTrack.TrackName, "")
            if Instr(1, trackName, deliveryUrl) > 0 then return trackName
        end for

        return ""
    end function

    '---------------------------------------------------------------------------
    ' SubtitlePlayback.__GetSelectedStream
    '---------------------------------------------------------------------------
    function __GetSelectedStream(playbackInfo as dynamic, streamIndex as integer) as dynamic
        if playbackInfo = invalid or playbackInfo.MediaSources = invalid or playbackInfo.MediaSources.Count() = 0 then return invalid
        mediaSource = playbackInfo.MediaSources[0]
        if mediaSource = invalid or mediaSource.MediaStreams = invalid then return invalid

        for each stream in mediaSource.MediaStreams
            if stream = invalid then continue for
            if LCase(Format.SafeString(stream.Type, "")) <> "subtitle" then continue for
            if Number.ToInteger(stream.Index, -1) = streamIndex then return stream
        end for

        return invalid
    end function

end namespace
