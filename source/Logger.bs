class Logger
    private label as string
    private collector as dynamic

    '---------------------------------------------------------------------------
    ' new
    '---------------------------------------------------------------------------
    sub new(label as string, collector as dynamic)
        m.label = label
        m.collector = collector
    end sub

    '---------------------------------------------------------------------------
    ' write
    '---------------------------------------------------------------------------
    function write(message as dynamic) as object
        line = m.format(message)
        ? line
        m.collectLine(line)
        return m
    end function

    '---------------------------------------------------------------------------
    ' writeConsoleOnly
    '---------------------------------------------------------------------------
    function writeConsoleOnly(message as dynamic) as object
        ? m.format(message)
        return m
    end function

    '---------------------------------------------------------------------------
    ' writeJson
    '---------------------------------------------------------------------------
    function writeJson(jsonText as dynamic, indent = 0 as integer, heading = "" as string) as object
        lines = m.formatJsonText(jsonText)
        prefix = m.indent(indent)
        displayEntry = ""
        if heading <> "" then
            formattedHeading = m.format(heading)
            ? formattedHeading
            displayEntry = formattedHeading
        end if
        for i = 0 to lines.Count() - 1
            line = prefix + lines[i]
            formattedLine = m.format(line)
            ? formattedLine
            if displayEntry = "" then
                displayEntry = formattedLine
            else
                displayEntry = displayEntry + Chr(10) + line
            end if
        end for
        if displayEntry <> "" then m.collectLine(displayEntry)
        return m
    end function

    '---------------------------------------------------------------------------
    ' writeJsonConsoleOnly
    '---------------------------------------------------------------------------
    function writeJsonConsoleOnly(jsonText as dynamic, indent = 0 as integer) as object
        lines = m.formatJsonText(jsonText)
        prefix = m.indent(indent)
        for each line in lines
            m.writeConsoleOnly(prefix + line)
        end for
        return m
    end function

    '---------------------------------------------------------------------------
    ' error
    '---------------------------------------------------------------------------
    function error(message as dynamic) as object
        return m.write("ERROR: " + message)
    end function

    '---------------------------------------------------------------------------
    ' collectLine
    '---------------------------------------------------------------------------
    private sub collectLine(line as string)
        if m.collector = invalid then return
        m.collector.appendRequested = line
    end sub

    '---------------------------------------------------------------------------
    ' format
    '---------------------------------------------------------------------------
    private function format(message as dynamic) as string
        text = Format.SafeString(message, "")
        if m.label <> "" then text = "[" + m.label + "] " + text
        return m.timestampPrefix() + text
    end function

    '---------------------------------------------------------------------------
    ' formatJsonText
    '---------------------------------------------------------------------------
    private function formatJsonText(jsonText as dynamic) as object
        text = Format.SafeString(jsonText, "")
        lines = []
        if text = "" then
            lines.Push("")
            return lines
        end if
        indentLevel = 0
        currentLine = ""
        inString = false
        escapeNext = false
        quote = Chr(34)
        for i = 1 to Len(text)
            char = Mid(text, i, 1)
            if inString = true then
                currentLine = currentLine + char
                if escapeNext = true then
                    escapeNext = false
                else if char = "\" then
                    escapeNext = true
                else if char = quote then
                    inString = false
                end if
            else if char = quote then
                inString = true
                currentLine = currentLine + char
            else if char = "{" or char = "[" then
                currentLine = m.trimRight(currentLine) + char
                lines.Push(currentLine)
                indentLevel = indentLevel + 1
                currentLine = m.indent(indentLevel)
            else if char = "}" or char = "]" then
                if m.trim(currentLine) <> "" then lines.Push(m.trimRight(currentLine))
                indentLevel = indentLevel - 1
                if indentLevel < 0 then indentLevel = 0
                currentLine = m.indent(indentLevel) + char
            else if char = "," then
                currentLine = m.trimRight(currentLine) + char
                lines.Push(currentLine)
                currentLine = m.indent(indentLevel)
            else if char = ":" then
                currentLine = m.trimRight(currentLine) + ": "
            else if m.isWhitespace(char) <> true then
                currentLine = currentLine + char
            end if
        end for
        if m.trim(currentLine) <> "" then lines.Push(m.trimRight(currentLine))
        return lines
    end function

    '---------------------------------------------------------------------------
    ' indent
    '---------------------------------------------------------------------------
    private function indent(level as integer) as string
        text = ""
        for i = 1 to level
            text = text + "  "
        end for
        return text
    end function

    '---------------------------------------------------------------------------
    ' isWhitespace
    '---------------------------------------------------------------------------
    private function isWhitespace(char as string) as boolean
        return char = " " or char = Chr(9) or char = Chr(10) or char = Chr(13)
    end function

    '---------------------------------------------------------------------------
    ' trim
    '---------------------------------------------------------------------------
    private function trim(text as string) as string
        return m.trimLeft(m.trimRight(text))
    end function

    '---------------------------------------------------------------------------
    ' trimLeft
    '---------------------------------------------------------------------------
    private function trimLeft(text as string) as string
        while Len(text) > 0 and m.isWhitespace(Left(text, 1)) = true
            text = Mid(text, 2)
        end while
        return text
    end function

    '---------------------------------------------------------------------------
    ' trimRight
    '---------------------------------------------------------------------------
    private function trimRight(text as string) as string
        while Len(text) > 0 and m.isWhitespace(Right(text, 1)) = true
            text = Left(text, Len(text) - 1)
        end while
        return text
    end function

    '---------------------------------------------------------------------------
    ' timestampPrefix
    '---------------------------------------------------------------------------
    private function timestampPrefix() as string
        timestamp = CreateObject("roDateTime")
        timestamp.ToLocalTime()
        return m.pad2(timestamp.GetMonth()) + "/" + m.pad2(timestamp.GetDayOfMonth()) + " " + m.pad2(timestamp.GetHours()) + ":" + m.pad2(timestamp.GetMinutes()) + ":" + m.pad2(timestamp.GetSeconds()) + " "
    end function

    '---------------------------------------------------------------------------
    ' pad2
    '---------------------------------------------------------------------------
    private function pad2(value as integer) as string
        text = value.ToStr()
        if Len(text) < 2 then return "0" + text
        return text
    end function
end class
