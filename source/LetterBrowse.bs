import "pkg:/source/Format.bs"
import "pkg:/source/LibraryBrowse.bs"

namespace LetterBrowse

    '---------------------------------------------------------------------------
    ' LetterBrowse.SortItems
    '---------------------------------------------------------------------------
    function SortItems(items as object, sortOrder as dynamic) as object
        entries = []
        for each item in items
            entries.Push({ item: item, sortKey: LCase(Format.SafeString(item.SortName, Format.SafeString(item.Name, ""))) })
        end for
        entries.SortBy("sortKey")

        result = []
        if LibraryBrowse.NormalizeSortOrder(sortOrder) = LibraryBrowse.SortOrder.Descending then
            for i = entries.Count() - 1 to 0 step -1
                result.Push(entries[i].item)
            end for
        else
            for each entry in entries
                result.Push(entry.item)
            end for
        end if
        return result
    end function

    '---------------------------------------------------------------------------
    ' LetterBrowse.GetPage
    '---------------------------------------------------------------------------
    function GetPage(items as object, startIndex as integer, pageSize as integer) as object
        pageItems = []
        lastIndex = startIndex + pageSize - 1
        if lastIndex >= items.Count() then lastIndex = items.Count() - 1
        if startIndex < items.Count() then
            for i = startIndex to lastIndex
                pageItems.Push(items[i])
            end for
        end if
        return pageItems
    end function

end namespace
