namespace RegistryStore

    '---------------------------------------------------------------------------
    ' RegistryStore.AccountSectionName
    '---------------------------------------------------------------------------
    function AccountSectionName(accountKey as string) as string
        return "STARFIN_ACCOUNT_" + accountKey
    end function

    '---------------------------------------------------------------------------
    ' RegistryStore.ClearAll
    '---------------------------------------------------------------------------
    sub ClearAll()
        registry = CreateObject("roRegistry")
        for each sectionName in registry.GetSectionList()
            registry.Delete(sectionName)
        end for
        registry.Flush()
    end sub

end namespace
