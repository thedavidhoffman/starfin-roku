import "pkg:/source/SubtitleBurnIn.bs"
import "pkg:/source/LibraryLayoutSetting.bs"
import "pkg:/source/PlaybackMode.bs"
import "pkg:/source/NextItemPlayback.bs"
import "pkg:/source/store/RegistryStore.bs"

namespace SettingsStore

    '---------------------------------------------------------------------------
    ' SettingsStore.Key
    '---------------------------------------------------------------------------
    enum Key
        TvLibraryLayout = "tv-library-layout"
        MovieLibraryLayout = "movie-library-layout"
        CollectionCardsLayout = "collection-cards-layout"
        CollectionItemsLayout = "collection-items-layout"
        PlaylistCardsLayout = "playlist-cards-layout"
        PlaylistItemsLayout = "playlist-items-layout"
        MusicVideosLayout = "music-videos-layout"
        HomeVideosLayout = "home-videos-layout"
        TvEpisodeListDisplay = "tv-ep-list-scroll"
        MediaShellBackground = "media-shell-background"
        ThemeMusic = "theme-music"
        NextItemPlayback = "next-item-playback"
        ScreensaverType = "screensaver-type"
        ScreensaverDelay = "screensaver-delay"
        VideoStreamingMode = "video-streaming-mode"
        SubtitleBurnInMode = "subtitle-burn-in-mode"
        DisplayAccountBadge = "display-account-badge"
        TmdbApiKey = "tmdb-api-key"
    end enum

    '---------------------------------------------------------------------------
    ' SettingsStore.Defaults
    '---------------------------------------------------------------------------
    function Defaults() as object
        defaultSettings = {}
        defaultSettings[Key.TvLibraryLayout] = "poster;6"
        defaultSettings[Key.MovieLibraryLayout] = "poster;6"
        defaultSettings[Key.CollectionCardsLayout] = "poster;6"
        defaultSettings[Key.CollectionItemsLayout] = "poster;6"
        defaultSettings[Key.PlaylistCardsLayout] = "poster;6"
        defaultSettings[Key.PlaylistItemsLayout] = "poster;6"
        defaultSettings[Key.MusicVideosLayout] = "poster;6"
        defaultSettings[Key.HomeVideosLayout] = "poster;6"
        defaultSettings[Key.TvEpisodeListDisplay] = "vertical"
        defaultSettings[Key.MediaShellBackground] = "full-screen"
        defaultSettings[Key.ThemeMusic] = "off"
        defaultSettings[Key.NextItemPlayback] = NextItemPlayback.Mode.ShowUpNext
        defaultSettings[Key.ScreensaverType] = "none"
        defaultSettings[Key.ScreensaverDelay] = "1"
        defaultSettings[Key.VideoStreamingMode] = PlaybackMode.Mode.Automatic
        defaultSettings[Key.SubtitleBurnInMode] = SubtitleBurnIn.Mode.DuringTranscoding
        defaultSettings[Key.DisplayAccountBadge] = "off"
        defaultSettings[Key.TmdbApiKey] = ""
        return defaultSettings
    end function

    '---------------------------------------------------------------------------
    ' SettingsStore.AccountKeys
    '---------------------------------------------------------------------------
    function AccountKeys() as object
        return [Key.TvLibraryLayout, Key.MovieLibraryLayout, Key.CollectionCardsLayout, Key.CollectionItemsLayout, Key.PlaylistCardsLayout, Key.PlaylistItemsLayout, Key.MusicVideosLayout, Key.HomeVideosLayout, Key.TvEpisodeListDisplay, Key.MediaShellBackground, Key.ThemeMusic, Key.NextItemPlayback, Key.ScreensaverType, Key.ScreensaverDelay]
    end function

    function LibraryKeys() as object
        return [Key.TvLibraryLayout, Key.MovieLibraryLayout, Key.CollectionCardsLayout, Key.CollectionItemsLayout, Key.PlaylistCardsLayout, Key.PlaylistItemsLayout, Key.MusicVideosLayout, Key.HomeVideosLayout]
    end function

    '---------------------------------------------------------------------------
    ' SettingsStore.Load
    '---------------------------------------------------------------------------
    function Load(accountKey as string) as object
        defaultSettings = SettingsStore.Defaults()
        settings = {}
        values = {}
        if accountKey <> "" then
            accountStore = CreateObject("roRegistrySection", RegistryStore.AccountSectionName(accountKey))
            values = accountStore.ReadMulti(SettingsStore.AccountKeys())
            if values = invalid then values = {}
        end if

        for each key in SettingsStore.AccountKeys()
            settings[key] = SettingsStore.GetValue(values, key, defaultSettings[key])
        end for
        for each key in SettingsStore.LibraryKeys()
            settings[key] = LibraryLayoutSetting.Normalize(settings[key])
        end for
        settings[Key.ScreensaverType] = SettingsStore.NormalizeScreensaverType(settings[Key.ScreensaverType])
        settings[Key.NextItemPlayback] = NextItemPlayback.Normalize(settings[Key.NextItemPlayback])
        settings[Key.DisplayAccountBadge] = SettingsStore.LoadGlobal(Key.DisplayAccountBadge)
        settings[Key.VideoStreamingMode] = PlaybackMode.Normalize(SettingsStore.LoadGlobal(Key.VideoStreamingMode))
        settings[Key.SubtitleBurnInMode] = SubtitleBurnIn.Normalize(SettingsStore.LoadGlobal(Key.SubtitleBurnInMode))
        settings[Key.TmdbApiKey] = SettingsStore.LoadIntegration(Key.TmdbApiKey)
        return settings
    end function

    '---------------------------------------------------------------------------
    ' SettingsStore.Save
    '---------------------------------------------------------------------------
    sub Save(accountKey as string, settings as object)
        if accountKey <> "" then
            accountStore = CreateObject("roRegistrySection", RegistryStore.AccountSectionName(accountKey))
            for each key in SettingsStore.AccountKeys()
                value = SettingsStore.GetSettingValue(settings, key)
                if SettingsStore.__IsLibraryKey(key) then value = LibraryLayoutSetting.Normalize(value)
                if key = Key.ScreensaverType then value = SettingsStore.NormalizeScreensaverType(value)
                if key = Key.NextItemPlayback then value = NextItemPlayback.Normalize(value)
                accountStore.Write(key, value)
            end for
            accountStore.Flush()
        end if
        SettingsStore.SaveGlobal(Key.DisplayAccountBadge, SettingsStore.GetSettingValue(settings, Key.DisplayAccountBadge))
        SettingsStore.SaveGlobal(Key.VideoStreamingMode, PlaybackMode.Normalize(SettingsStore.GetSettingValue(settings, Key.VideoStreamingMode)))
        SettingsStore.SaveGlobal(Key.SubtitleBurnInMode, SubtitleBurnIn.Normalize(SettingsStore.GetSettingValue(settings, Key.SubtitleBurnInMode)))
        SettingsStore.SaveIntegration(Key.TmdbApiKey, SettingsStore.GetSettingValue(settings, Key.TmdbApiKey))
    end sub

    function __IsLibraryKey(key as string) as boolean
        for each libraryKey in SettingsStore.LibraryKeys()
            if libraryKey = key then return true
        end for
        return false
    end function

    '---------------------------------------------------------------------------
    ' SettingsStore.LoadGlobal
    '---------------------------------------------------------------------------
    function LoadGlobal(key as string) as string
        defaultSettings = SettingsStore.Defaults()
        return SettingsStore.GetValue(CreateObject("roRegistrySection", "STARFIN_ROKU"), key, defaultSettings[key])
    end function

    '---------------------------------------------------------------------------
    ' SettingsStore.SaveGlobal
    '---------------------------------------------------------------------------
    sub SaveGlobal(key as string, value as string)
        globalStore = CreateObject("roRegistrySection", "STARFIN_ROKU")
        globalStore.Write(key, value)
        globalStore.Flush()
    end sub

    '---------------------------------------------------------------------------
    ' SettingsStore.LoadIntegration
    '---------------------------------------------------------------------------
    function LoadIntegration(key as string) as string
        return SettingsStore.LoadGlobal(key)
    end function

    '---------------------------------------------------------------------------
    ' SettingsStore.SaveIntegration
    '---------------------------------------------------------------------------
    sub SaveIntegration(key as string, value as string)
        SettingsStore.SaveGlobal(key, value)
    end sub

    '---------------------------------------------------------------------------
    ' SettingsStore.GetValue
    '---------------------------------------------------------------------------
    function GetValue(values as dynamic, key as string, defaultValue as string) as string
        value = invalid
        if values <> invalid then
            if GetInterface(values, "ifAssociativeArray") <> invalid then
                value = values[key]
            else
                value = values.Read(key)
            end if
        end if
        if value = invalid or value = "" then return defaultValue
        return value
    end function

    '---------------------------------------------------------------------------
    ' SettingsStore.GetSettingValue
    '---------------------------------------------------------------------------
    function GetSettingValue(settings as dynamic, key as string) as string
        defaultSettings = SettingsStore.Defaults()
        defaultValue = ""
        if defaultSettings[key] <> invalid then defaultValue = defaultSettings[key]
        if settings = invalid then return defaultValue
        if settings[key] = invalid or settings[key] = "" then return defaultValue
        return settings[key].ToStr()
    end function

    '---------------------------------------------------------------------------
    ' SettingsStore.IsThemeMusicEnabled
    '---------------------------------------------------------------------------
    function IsThemeMusicEnabled(settings as dynamic) as boolean
        return LCase(SettingsStore.GetSettingValue(settings, Key.ThemeMusic)) = "on"
    end function

    '---------------------------------------------------------------------------
    ' SettingsStore.NormalizeScreensaverType
    '---------------------------------------------------------------------------
    function NormalizeScreensaverType(value as dynamic) as string
        normalized = ""
        if value <> invalid then normalized = LCase(value.ToStr())
        if normalized = "bounce" then return normalized
        if normalized = "starfield" then return normalized
        return "none"
    end function

    '---------------------------------------------------------------------------
    ' SettingsStore.AreEqual
    '---------------------------------------------------------------------------
    function AreEqual(left as dynamic, right as dynamic) as boolean
        if left = invalid or right = invalid then return false
        for each key in SettingsStore.Defaults()
            if SettingsStore.GetSettingValue(left, key) <> SettingsStore.GetSettingValue(right, key) then return false
        end for
        return true
    end function

end namespace
