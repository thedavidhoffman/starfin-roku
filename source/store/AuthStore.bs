import "pkg:/source/String.bs"
import "pkg:/source/Url.bs"
import "pkg:/source/Encode.bs"
import "pkg:/source/store/RegistryStore.bs"
namespace AuthStore

    '---------------------------------------------------------------------------
    ' AuthStore.__GetStore
    '---------------------------------------------------------------------------
    function __GetStore() as object
        return CreateObject("roRegistrySection", "STARFIN_ROKU")
    end function

    '---------------------------------------------------------------------------
    ' AuthStore.BuildAccountKey
    '---------------------------------------------------------------------------
    function BuildAccountKey(server as string, userId as dynamic) as string
        return "v2/" + Encode.Url(Url.ServerIdentity(server)) + "/" + Encode.Url(Strings.ToString(userId))
    end function

    '---------------------------------------------------------------------------
    ' AuthStore.MigrateAccounts
    '---------------------------------------------------------------------------
    function MigrateAccounts() as boolean
        registry = CreateObject("roRegistry")
        succeeded = true
        for each sectionName in registry.GetSectionList()
            if LCase(Left(sectionName, 16)) <> "starfin_account_" then continue for
            oldKey = Mid(sectionName, 17)
            legacy = CreateObject("roRegistrySection", sectionName)
            server = legacy.Read("server")
            userId = legacy.Read("user-id")
            if server = "" or userId = "" then continue for
            newKey = BuildAccountKey(server, userId)
            if oldKey = newKey then continue for
            try
                if not __MigrateAccount(legacy, oldKey, newKey) then succeeded = false
            catch error
                succeeded = false
            end try
        end for
        return succeeded
    end function

    '---------------------------------------------------------------------------
    ' AuthStore.__MigrateAccount
    '---------------------------------------------------------------------------
    function __MigrateAccount(legacy as object, oldKey as string, newKey as string) as boolean
        destination = CreateObject("roRegistrySection", RegistryStore.AccountSectionName(newKey))
        ' Preserve all account-owned settings and resume safely after partial migration.
        for each key in legacy.GetKeyList()
            if not destination.Exists(key) then
                if not destination.Write(key, legacy.Read(key)) then return false
            end if
        end for
        if not destination.Flush() then return false
        globalStore = __GetStore()
        if globalStore.Read("active-account-key") = oldKey then
            if not globalStore.Write("active-account-key", newKey) then return false
            if not globalStore.Flush() then return false
        end if
        registry = CreateObject("roRegistry")
        if not registry.Delete(RegistryStore.AccountSectionName(oldKey)) then return false
        return registry.Flush()
    end function

    '---------------------------------------------------------------------------
    ' AuthStore.Load
    '---------------------------------------------------------------------------
    function Load() as object
        globalStore = AuthStore.__GetStore()
        accountKey = globalStore.Read("active-account-key")
        if accountKey = "" then
            return {
                accountKey: ""
                server: AuthStore.GetLastServer()
                username: ""
                token: ""
                userId: ""
                primaryImageTag: ""
            }
        end if

        account = AuthStore.LoadAccount(accountKey, true)
        if account = invalid then
            AuthStore.ClearActiveAccount()
            return {
                accountKey: ""
                server: AuthStore.GetLastServer()
                username: ""
                token: ""
                userId: ""
                primaryImageTag: ""
            }
        end if

        return account
    end function

    '---------------------------------------------------------------------------
    ' AuthStore.Save
    '---------------------------------------------------------------------------
    sub Save(server as string, username as string, token as string, userId as dynamic, primaryImageTag = "" as string)
        accountKey = AuthStore.BuildAccountKey(server, userId)
        accountStore = CreateObject("roRegistrySection", RegistryStore.AccountSectionName(accountKey))
        accountStore.Write("server", Url.NormalizeServer(server))
        accountStore.Write("username", username)
        accountStore.Write("token", token)
        accountStore.Write("user-id", Strings.ToString(userId))
        accountStore.Write("primary-image-tag", primaryImageTag)
        accountStore.Flush()

        AuthStore.SetActiveAccount(accountKey)
    end sub

    '---------------------------------------------------------------------------
    ' AuthStore.LoadAccount
    '---------------------------------------------------------------------------
    function LoadAccount(accountKey as string, includeToken = false as boolean) as dynamic
        if accountKey = "" then return invalid
        accountStore = CreateObject("roRegistrySection", RegistryStore.AccountSectionName(accountKey))
        server = accountStore.Read("server")
        userId = accountStore.Read("user-id")
        if server = "" or userId = "" then return invalid

        account = {
            accountKey: accountKey
            server: server
            username: accountStore.Read("username")
            userId: userId
            primaryImageTag: accountStore.Read("primary-image-tag")
        }
        if includeToken then account.token = accountStore.Read("token")
        return account
    end function

    '---------------------------------------------------------------------------
    ' AuthStore.ListAllAccounts
    '---------------------------------------------------------------------------
    function ListAllAccounts(includeToken = false as boolean) as object
        activeAccountKey = AuthStore.GetActiveAccountKey()
        accounts = []
        registry = CreateObject("roRegistry")
        for each sectionName in registry.GetSectionList()
            if LCase(Left(sectionName, 16)) = "starfin_account_" then
                accountKey = Mid(sectionName, 17)
                account = AuthStore.LoadAccount(accountKey, includeToken)
                if account <> invalid then
                    account.isActive = (accountKey = activeAccountKey)
                    activeSort = "1"
                    if account.isActive then activeSort = "0"
                    account.sortKey = activeSort + "--" + LCase(account.server) + "--" + LCase(account.username) + "--" + accountKey
                    accounts.Push(account)
                end if
            end if
        end for
        accounts.SortBy("sortKey")
        for each account in accounts
            account.Delete("sortKey")
        end for
        return accounts
    end function

    '---------------------------------------------------------------------------
    ' AuthStore.GetActiveAccountKey
    '---------------------------------------------------------------------------
    function GetActiveAccountKey() as string
        return AuthStore.__GetStore().Read("active-account-key")
    end function

    '---------------------------------------------------------------------------
    ' AuthStore.GetLastServer
    '---------------------------------------------------------------------------
    function GetLastServer() as string
        return AuthStore.__GetStore().Read("server")
    end function

    '---------------------------------------------------------------------------
    ' AuthStore.SetActiveAccount
    '---------------------------------------------------------------------------
    sub SetActiveAccount(accountKey as string)
        account = AuthStore.LoadAccount(accountKey, false)
        if account = invalid then return
        globalStore = AuthStore.__GetStore()
        globalStore.Write("active-account-key", accountKey)
        globalStore.Write("server", account.server)
        globalStore.Flush()
    end sub

    '---------------------------------------------------------------------------
    ' AuthStore.RemoveToken
    '---------------------------------------------------------------------------
    sub RemoveToken(accountKey as string)
        if accountKey = "" then return
        accountStore = CreateObject("roRegistrySection", RegistryStore.AccountSectionName(accountKey))
        accountStore.Delete("token")
        accountStore.Flush()
        if AuthStore.GetActiveAccountKey() = accountKey then AuthStore.ClearActiveAccount()
    end sub

    '---------------------------------------------------------------------------
    ' AuthStore.ForgetAccount
    '---------------------------------------------------------------------------
    function ForgetAccount(accountKey as string, allowActive = false as boolean) as boolean
        if accountKey = "" then return false
        isActive = GetActiveAccountKey() = accountKey
        if isActive and not allowActive then return false

        registry = CreateObject("roRegistry")
        wasDeleted = registry.Delete(RegistryStore.AccountSectionName(accountKey))
        if not wasDeleted then return false
        if not registry.Flush() then return false
        ' Startup has no authenticated session; only confirmed removal clears its last-used reference.
        if isActive then ClearActiveAccount()
        return wasDeleted
    end function

    '---------------------------------------------------------------------------
    ' AuthStore.ClearActiveAccount
    '---------------------------------------------------------------------------
    sub ClearActiveAccount()
        globalStore = AuthStore.__GetStore()
        globalStore.Delete("active-account-key")
        globalStore.Flush()
    end sub

end namespace
