namespace SubtitleBurnIn
    enum Mode
        DuringTranscoding = "during-transcoding"
        PreferExternal = "prefer-external"
        Always = "always"
    end enum

    function Normalize(value as dynamic) as string
        normalized = ""
        if value <> invalid then normalized = LCase(value.ToStr())
        if normalized = Mode.PreferExternal then return Mode.PreferExternal
        if normalized = Mode.Always then return Mode.Always
        return Mode.DuringTranscoding
    end function
end namespace
