import "pkg:/source/Number.bs"

namespace LibraryGridLayout

    '---------------------------------------------------------------------------
    ' LibraryGridLayout.GetSpec
    '---------------------------------------------------------------------------
    function GetSpec(imageAspect as string, contentRole as string) as object
        if imageAspect = "jumbo" then
            return {
                translation: [24, 207]
                itemSize: [936, 591]
                itemSpacing: [0, 18]
                numColumns: 2
                numRows: 2
                focusBitmapUri: "pkg:/images/library/jumbo-focus-936x591.png"
                artworkSize: [882, 496]
                visibleArtworkOffsetX: 27
                visibleArtworkWidth: 882
                visibleRightAdjustment: 0
            }
        end if

        if imageAspect = "wide" then
            spacing = [0, 12]
            if contentRole = "cards" then spacing = [0, -24]
            return {
                translation: [24, 207]
                itemSize: [465, 348]
                itemSpacing: spacing
                numColumns: 4
                numRows: 3
                focusBitmapUri: "pkg:/images/library/thumbnail-focus-465x348.png"
                artworkSize: [441, 249]
                visibleArtworkOffsetX: 21
                visibleArtworkWidth: 441
                visibleRightAdjustment: -1
            }
        end if

        spacing = [-12, 27]
        if contentRole = "cards" then spacing = [-12, -12]
        return {
            translation: [96, 207]
            itemSize: [297, 465]
            itemSpacing: spacing
            numColumns: 6
            numRows: 2
            focusBitmapUri: "pkg:/images/library/poster-focus-297x465.png"
            artworkSize: [252, 378]
            visibleArtworkOffsetX: 21
            visibleArtworkWidth: 252
            visibleRightAdjustment: 0
        }
    end function

    '---------------------------------------------------------------------------
    ' LibraryGridLayout.GetGridRightEdge
    '---------------------------------------------------------------------------
    function GetGridRightEdge(grid as object) as integer
        columns = Number.ToInteger(grid.numColumns, 0)
        gridLeft = Number.ToInteger(grid.translation[0], 0)
        if columns <= 0 then return gridLeft

        itemWidth = Number.ToInteger(grid.itemSize[0], 0)
        spacingX = Number.ToInteger(grid.itemSpacing[0], 0)
        return gridLeft + (columns * itemWidth) + ((columns - 1) * spacingX)
    end function

    '---------------------------------------------------------------------------
    ' LibraryGridLayout.GetVisibleRightEdge
    '---------------------------------------------------------------------------
    function GetVisibleRightEdge(grid as object, spec as object) as integer
        columns = Number.ToInteger(grid.numColumns, 0)
        if columns <= 0 then return Number.ToInteger(grid.translation[0], 0)

        cellStride = Number.ToInteger(grid.itemSize[0], 0) + Number.ToInteger(grid.itemSpacing[0], 0)
        lastCellLeft = Number.ToInteger(grid.translation[0], 0) + ((columns - 1) * cellStride)
        contentOffsetX = Number.ToInteger(spec.visibleArtworkOffsetX, 0)
        visualWidth = Number.ToInteger(spec.visibleArtworkWidth, 0)
        rightAdjustment = Number.ToInteger(spec.visibleRightAdjustment, 0)
        return lastCellLeft + contentOffsetX + visualWidth + rightAdjustment
    end function

end namespace
