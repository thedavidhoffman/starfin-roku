import "pkg:/source/Number.bs"
import "pkg:/source/ResolutionAssets.bs"
import "pkg:/source/ResolutionProfile.bs"
import "pkg:/source/VideoCardPresentation.bs"

namespace VideoCardGridLayout

    '---------------------------------------------------------------------------
    ' VideoCardGridLayout.GetSpec
    '---------------------------------------------------------------------------
    function GetSpec(imageAspect as string, contentRole as string, columns = invalid as dynamic) as object
        if imageAspect = VideoCardPresentation.Type.Detailed then return VideoCardGridLayout.__DetailedSpec()
        if imageAspect = VideoCardPresentation.Type.Thumbnail then return VideoCardGridLayout.__ThumbnailSpec(contentRole, Number.ToInteger(columns, 4))
        return VideoCardGridLayout.__PosterSpec(contentRole, Number.ToInteger(columns, 6))
    end function

    '---------------------------------------------------------------------------
    ' VideoCardGridLayout.__DetailedSpec
    '---------------------------------------------------------------------------
    function __DetailedSpec() as object
        return {
            translation: [24, 207]
            itemSize: [936, 591]
            itemSpacing: [0, -39]
            numColumns: 2
            numRows: 2
            focusBitmapUri: "pkg:/images/library/detailed-focus-936x591.png"
            artworkSize: [288, 432]
            visibleArtworkOffsetX: 27
            visibleArtworkWidth: 882
            visibleRightAdjustment: 0
        }
    end function

    '---------------------------------------------------------------------------
    ' VideoCardGridLayout.__ThumbnailSpec
    '---------------------------------------------------------------------------
    function __ThumbnailSpec(contentRole as string, columns as integer) as object
        widths = { "2": 906, "3": 596, "4": 441 }
        heights = { "2": 510, "3": 335, "4": 249 }
        artworkWidth = widths[columns.ToStr()]
        if artworkWidth = invalid then
            columns = 4
            artworkWidth = 441
        end if
        artworkHeight = heights[columns.ToStr()]
        spacing = [0, 12]
        if contentRole = "cards" then spacing = [0, -24]
        return {
            translation: [24, 207]
            itemSize: [artworkWidth + 24, artworkHeight + 99]
            itemSpacing: spacing
            numColumns: columns
            numRows: 3
            focusBitmapUri: ResolutionAssets.GetLibraryImageUri("thumbnail-" + columns.ToStr() + "-col-focus.png")
            artworkSize: [artworkWidth, artworkHeight]
            visibleArtworkOffsetX: 21
            visibleArtworkWidth: artworkWidth
            visibleRightAdjustment: -1
        }
    end function

    '---------------------------------------------------------------------------
    ' VideoCardGridLayout.__PosterSpec
    '---------------------------------------------------------------------------
    function __PosterSpec(contentRole as string, columns as integer) as object
        widths = { "3": 537, "4": 393, "5": 309, "6": 252 }
        heights = { "3": 806, "4": 590, "5": 464, "6": 378 }
        artworkWidth = widths[columns.ToStr()]
        if artworkWidth = invalid then
            columns = 6
            artworkWidth = 252
        end if
        artworkHeight = heights[columns.ToStr()]
        spacing = [-12, 27]
        if columns = 4 then spacing[0] = -10
        if contentRole = "cards" then spacing = [-12, -12]
        if contentRole = "cards" and columns = 4 then spacing[0] = -10
        return {
            translation: [96, 207]
            itemSize: [artworkWidth + 45, artworkHeight + 87]
            itemSpacing: spacing
            numColumns: columns
            numRows: 2
            focusBitmapUri: ResolutionAssets.GetLibraryImageUri("poster-" + columns.ToStr() + "-col-focus.png")
            artworkSize: [artworkWidth, artworkHeight]
            visibleArtworkOffsetX: 21
            visibleArtworkWidth: artworkWidth
            visibleRightAdjustment: 0
        }
    end function

    '---------------------------------------------------------------------------
    ' VideoCardGridLayout.GetGridRightEdge
    '---------------------------------------------------------------------------
    function GetGridRightEdge(grid as object) as integer
        columns = Number.ToInteger(grid.numColumns, 0)
        gridLeft = Number.ToInteger(grid.translation[0], 0)
        if columns <= 0 then return gridLeft

        itemWidth = Number.ToInteger(grid.itemSize[0], 0)
        spacingX = Number.ToInteger(grid.itemSpacing[0], 0)
        return gridLeft + (columns * itemWidth) + ((columns - 1) * spacingX)
    end function

    '---------------------------------------------------------------------------
    ' VideoCardGridLayout.GetVisibleRightEdge
    '---------------------------------------------------------------------------
    function GetVisibleRightEdge(grid as object, spec as object) as integer
        columns = Number.ToInteger(grid.numColumns, 0)
        if columns <= 0 then return Number.ToInteger(grid.translation[0], 0)

        cellStride = Number.ToInteger(grid.itemSize[0], 0) + Number.ToInteger(grid.itemSpacing[0], 0)
        lastCellLeft = Number.ToInteger(grid.translation[0], 0) + ((columns - 1) * cellStride)
        contentOffsetX = Number.ToInteger(spec.visibleArtworkOffsetX, 0)
        visualWidth = Number.ToInteger(spec.visibleArtworkWidth, 0)
        rightAdjustment = Number.ToInteger(spec.visibleRightAdjustment, 0)
        return lastCellLeft + contentOffsetX + visualWidth + rightAdjustment
    end function

end namespace
