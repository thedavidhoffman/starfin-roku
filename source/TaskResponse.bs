namespace TaskResponse

    '---------------------------------------------------------------------------
    ' TaskResponse.Success
    '---------------------------------------------------------------------------
    function Success(request as object, action as string, payload as dynamic) as object
        return {
            ok: true
            action: action
            server: request.server
            payload: payload
        }
    end function

    '---------------------------------------------------------------------------
    ' TaskResponse.Failure
    '---------------------------------------------------------------------------
    function Failure(response as dynamic, action as string) as object
        if response = invalid then return { ok: false, action: action, errorMessage: "Request failed." }

        response.AddReplace("action", action)
        return response
    end function

end namespace
