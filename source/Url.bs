import "pkg:/source/Format.bs"
import "pkg:/source/Encode.bs"

namespace Url

    '---------------------------------------------------------------------------
    ' Url.NormalizeServer
    '---------------------------------------------------------------------------
    ' Example: " jellyfin.example.com/// " returns "http://jellyfin.example.com".
    '---------------------------------------------------------------------------
    function NormalizeServer(server as string) as string

        if server = invalid then return ""

        normalized = Strings.Trim(server)

        if normalized = "" then return ""

        if Instr(1, LCase(normalized), "http://") <> 1 and Instr(1, LCase(normalized), "https://") <> 1 then
            normalized = "http://" + normalized
        end if

        while Right(normalized, 1) = "/"
            normalized = Left(normalized, Len(normalized) - 1)
        end while

        return normalized

    end function

    '---------------------------------------------------------------------------
    ' Url.BuildQueryString
    '---------------------------------------------------------------------------
    ' Example: { enabled: true } returns "?enabled=true".
    '---------------------------------------------------------------------------
    function BuildQueryString(params as object) as string
        if params = invalid or params.Count() = 0 then return ""

        query = ""
        for each key in params
            textValue = Url.__QueryValue(params[key])
            if textValue <> "" then
                if query <> "" then query = query + "&"
                query = query + Encode.Url(key.ToStr()) + "=" + Encode.Url(textValue)
            end if
        end for

        if query = "" then return ""
        return "?" + query
    end function

    '---------------------------------------------------------------------------
    ' Url.BuildImageUrl
    '---------------------------------------------------------------------------
    ' Example: ("server", "id", "Primary", "", 300, 200) returns "http://server/Items/id/Images/Primary?maxWidth=300&maxHeight=200&quality=90".
    '---------------------------------------------------------------------------
    function BuildImageUrl(server as string, itemId as string, imageType as string, tag as string, width as integer, height as integer, options = invalid as dynamic) as string
        serverUrl = Url.NormalizeServer(server)
        if serverUrl = "" then return ""
        if itemId = "" or imageType = "" then return ""

        query = "?maxWidth=" + width.ToStr() + "&maxHeight=" + height.ToStr() + "&quality=90"
        if tag <> "" then query = "?tag=" + tag + "&maxWidth=" + width.ToStr() + "&maxHeight=" + height.ToStr() + "&quality=90"

        if options <> invalid then
            for each key in options
                value = Url.__QueryValue(options[key])
                if value <> "" then query = query + "&" + key.ToStr() + "=" + value
            end for
        end if

        return serverUrl + "/Items/" + itemId + "/Images/" + imageType + query
    end function

    '---------------------------------------------------------------------------
    ' Url.Resolve
    '---------------------------------------------------------------------------
    function Resolve(server as dynamic, urlValue as dynamic) as string
        path = Format.SafeString(urlValue, "")
        if path = "" then return ""
        base = Format.SafeString(server, "")
        ' A leading // supplies a host, not a path beneath the server.
        if Left(path, 2) = "//" then
            schemeEnd = Instr(1, base, "://")
            if schemeEnd = 0 then return path
            return Left(base, schemeEnd) + path
        end if
        schemePattern = CreateObject("roRegex", "^[A-Za-z][A-Za-z0-9+.-]*:", "")
        if schemePattern.IsMatch(path) then return path
        if base = "" then return path
        while Right(base, 1) = "/"
            base = Left(base, Len(base) - 1)
        end while
        if Left(path, 1) = "/" then return base + path
        return base + "/" + path
    end function

    '---------------------------------------------------------------------------
    ' Url.GetOrigin
    '---------------------------------------------------------------------------
    function GetOrigin(urlValue as dynamic) as string
        normalized = LCase(Format.SafeString(urlValue, ""))
        schemeEnd = Instr(1, normalized, "://")
        if schemeEnd = 0 then return ""

        scheme = Left(normalized, schemeEnd - 1)
        if scheme <> "http" and scheme <> "https" then return ""
        authorityStart = schemeEnd + 3
        authorityEnd = Len(normalized) + 1
        for each separator in ["/", "?", "#"]
            position = Instr(authorityStart, normalized, separator)
            if position > 0 and position < authorityEnd then authorityEnd = position
        end for
        authority = Mid(normalized, authorityStart, authorityEnd - authorityStart)
        if authority = "" or Instr(1, authority, "@") > 0 then return ""

        if scheme = "http" and Right(authority, 3) = ":80" then authority = Left(authority, Len(authority) - 3)
        if scheme = "https" and Right(authority, 4) = ":443" then authority = Left(authority, Len(authority) - 4)
        return scheme + "://" + authority
    end function

    '---------------------------------------------------------------------------
    ' Url.__QueryValue
    '---------------------------------------------------------------------------
    ' Example: false returns "false".
    '---------------------------------------------------------------------------
    function __QueryValue(value as dynamic) as string
        if Type(value) = "roBoolean" or Type(value) = "Boolean" then
            if value then return "true"
            return "false"
        end if

        return Format.SafeString(value, "")
    end function

end namespace
