import "pkg:/source/String.bs"
namespace MediaPlaybackPolicy

    '---------------------------------------------------------------------------
    ' MediaPlaybackPolicy.TracksProgress
    '---------------------------------------------------------------------------
    function TracksProgress(item as dynamic, explicitPolicy = invalid as dynamic) as boolean
        if item <> invalid and LCase(Strings.ToString(item.Type)) = "musicvideo" then return false
        if explicitPolicy <> invalid then return explicitPolicy = true
        return true
    end function

end namespace
