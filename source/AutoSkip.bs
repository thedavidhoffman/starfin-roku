namespace AutoSkip

    enum SeekReason
        Segment = "autoSkipSegment"
    end enum

    enum Mode
        Off = "off"
        On = "on"
    end enum

    '---------------------------------------------------------------------------
    ' AutoSkip.Normalize
    '---------------------------------------------------------------------------
    function Normalize(value as dynamic) as string
        if value <> invalid and LCase(value.ToStr()) = Mode.On then return Mode.On
        return Mode.Off
    end function

end namespace
