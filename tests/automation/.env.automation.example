# Copy this file to tests/automation/.env.automation before running automation tests.
# Then replace the example values with configuration for your local environment.

# This file contains environment variables used by automation tests.

# It allows for defining
#   1 - Sensitive information we don't want checked in
#   2 - Defining library specific test criteria so it is not hard-coded in the tests

# Roku development device used to sideload and execute the automation channel.
ROKU_HOST=192.168.1.100
ROKU_DEV_PASSWORD=your-roku-dev-password

# Jellyfin test account used by the authenticated smoke test.
JELLYFIN_SERVER_URL=http://jellyfin.example:8096
JELLYFIN_USERNAME=automation-user
JELLYFIN_PASSWORD=your-test-account-password

# Library-specific Search expectations. Additional objects may be added to the array.
# Expected titles only need to be present in their section; extra results and ordering are ignored.
SEARCH_CASES=[{"query":"star","moviesAndSeries":["Star Blazers","Star Blazers 2199","Star Trek","Star Trek II: The Wrath of Khan"],"episodes":["Star Trek","starting now","Saga of a Star World","Start Me Up","Starting Over"],"people":["Adam Starks","Amy Starling","Antony Starr"]}]

# Movie library and letters exercised by the letter-grid automation tests.
LETTERGRID_SEARCH_LIBRARY=Movies
LETTERGRID_CASES=["A","B","C"]

# TV series library and expected season metadata used by TV-series smoke tests.
TVSERIES_LIBRARY=TV Shows
TVSERIES_SMOKE_TEST={"seriesName":"30 Rock","seasons":[{"season":1,"year":2006,"episodeCount":21},{"season":2,"year":2007,"episodeCount":15},{"season":3,"year":2008,"episodeCount":22},{"season":4,"year":2009,"episodeCount":22},{"season":5,"year":2010,"episodeCount":22},{"season":6,"year":2012,"episodeCount":21},{"season":7,"year":2012,"episodeCount":12}],"season1":[{"number":1,"title":"Pilot","date":"2006-10-11"},{"number":2,"title":"The Aftermath","date":"2006-10-18"},{"number":3,"title":"Blind Date","date":"2006-10-25"},{"number":4,"title":"Jack the Writer","date":"2006-11-01"},{"number":5,"title":"Jack-Tor","date":"2006-11-16"},{"number":6,"title":"Jack Meets Dennis","date":"2006-11-30"},{"number":7,"title":"Tracy Does Conan","date":"2006-12-07"},{"number":8,"title":"The Break-Up","date":"2006-12-14"},{"number":9,"title":"The Baby Show","date":"2007-01-04"},{"number":10,"title":"The Rural Juror","date":"2007-01-11"},{"number":11,"title":"The Head and the Hair","date":"2007-01-18"},{"number":12,"title":"Black Tie","date":"2007-02-01"},{"number":13,"title":"Up All Night","date":"2007-02-08"},{"number":14,"title":"The C Word","date":"2007-02-15"},{"number":15,"title":"Hard Ball","date":"2007-02-22"},{"number":16,"title":"The Source Awards","date":"2007-03-01"},{"number":17,"title":"The Fighting Irish","date":"2007-03-08"},{"number":18,"title":"Fireworks","date":"2007-04-05"},{"number":19,"title":"Corporate Crush","date":"2007-04-12"},{"number":20,"title":"Cleveland","date":"2007-04-19"},{"number":21,"title":"Hiatus","date":"2007-04-26"}]}
