sub startActiveReport()
    sent = m.top.sent
    if sent = invalid then sent = []
    snapshot = {}
    snapshot.Append(m.reporting.active)
    sent.Push(snapshot)
    m.top.sent = sent
end sub

sub respond(ok as boolean, requestId = -1 as integer)
    if requestId < 0 then requestId = m.reporting.active.requestId
    m.reporting.tasks[0].response = { ok: ok, requestId: requestId }
end sub
