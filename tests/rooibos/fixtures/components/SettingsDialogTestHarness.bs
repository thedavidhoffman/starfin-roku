'-------------------------------------------------------------------------------
' onContentComponentNameChanged
'-------------------------------------------------------------------------------
sub onContentComponentNameChanged()
    if m.top.contentComponentName = "SettingsContent" then
        m.top.contentComponentName = "SettingsContentTestHarness"
    end if

    ' Roku does not reenter this callback for its own field assignment.
    ' Keep the inherited creation path; configure the new child's own context.
    updateContentComponent()
    content = m.top.callFunc("getContentComponent")
    if content <> invalid and m.top.contentComponentName = "SettingsContentTestHarness" then
        content.callFunc("installSettingsFixture", m.top.fixtureSettings, m.top.fixtureCapture)
    end if
end sub
