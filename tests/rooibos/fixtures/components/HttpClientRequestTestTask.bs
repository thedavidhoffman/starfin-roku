import "pkg:/source/api/HttpClient.bs"
import "pkg:/source/api/JellyfinAuth.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.top.functionName = "executeRequest"
end sub

'-------------------------------------------------------------------------------
' executeRequest
'-------------------------------------------------------------------------------
sub executeRequest()
    try
        request = m.top.request
        requestUrl = request.fixture.server + request.fixture.tilePath
        if request.scenario = "postPlain" or request.scenario = "postJson" then
            headers = JellyfinAuth.BuildTokenHeaders(request.fixture.token)
            body = "synthetic log " + Chr(233) + Chr(10) + "second line"
            if request.scenario = "postPlain" then
                headers["content-type"] = "text/plain; charset=utf-8"
            else
                body = "{}"
            end if
            posted = HttpClient.Request(request.fixture.server + request.fixture.postPath, "POST", invalid, body, headers, false, 5000)
            m.top.response = { posted: posted }
            return
        end if
        if request.scenario = "response" then
            result = HttpClient.Request(request.fixture.server + request.fixture.exceptionPath, "GET", invalid, invalid, invalid, false, 5000)
        else
            ' An object header value cannot be converted with ToStr. This fails
            ' after the real transfer and message port have been created.
            result = HttpClient.Request(requestUrl, "GET", invalid, invalid, { "X-Fixture": {} }, false, 5000)
        end if
        response = { failure: result }
        if request.scenario = "recovery" then
            response.recovered = HttpClient.Request(requestUrl, "GET", invalid, invalid, JellyfinAuth.BuildTokenHeaders(request.fixture.token), false, 5000)
        end if
        m.top.response = response
    catch error
        m.top.response = { escapedException: true, errorNumber: error.number }
    end try
end sub
