namespace tests

    @suite("Playback response helpers")
    class PlaybackResponseTests extends rooibos.BaseTestSuite

        @describe("PlaybackResponse.Success")

        @it("creates a correlated success without allowing contract fields to be replaced")
        function _()
            response = PlaybackResponse.Success({ requestId: 8 }, { requestId: 99, streamUrl: "stream", playSessionId: "session-1" })

            m.assertTrue(response.ok)
            m.assertEqual(response.action, "playbackInfo")
            m.assertEqual(response.requestId, 8)
            m.assertEqual(response.streamUrl, "stream")
            m.assertEqual(response.playSessionId, "session-1")
        end function

        @describe("PlaybackResponse.Failure")

        @it("creates a correlated failure with the supplied error")
        function _()
            response = PlaybackResponse.Failure({ requestId: 9 }, { ok: true, errorMessage: "No stream" })

            m.assertFalse(response.ok)
            m.assertEqual(response.action, "playbackInfo")
            m.assertEqual(response.requestId, 9)
            m.assertEqual(response.errorMessage, "No stream")
        end function

    end class

end namespace
