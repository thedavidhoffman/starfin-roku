namespace tests

    @suite("Task response helpers")
    class TaskResponseTests extends rooibos.BaseTestSuite

        @describe("success responses")

        @it("builds the common response envelope")
        function _()
            payload = { Items: [{ Id: "item-1" }] }

            result = TaskResponse.Success({ server: "server" }, "load", payload)

            m.assertTrue(result.ok)
            m.assertEqual(result.action, "load")
            m.assertEqual(result.server, "server")
            m.assertEqual(result.payload, payload)
        end function

        @describe("action correlation")

        @it("adds an action to an existing response")
        function _()
            response = { ok: false, errorMessage: "Unavailable." }

            result = TaskResponse.Failure(response, "load")

            m.assertEqual(result, response)
            m.assertEqual(result.action, "load")
            m.assertEqual(result.errorMessage, "Unavailable.")
        end function

        @it("builds a failure response when the response is missing")
        function _()
            result = TaskResponse.Failure(invalid, "load")

            m.assertFalse(result.ok)
            m.assertEqual(result.action, "load")
            m.assertEqual(result.errorMessage, "Request failed.")
        end function

    end class

end namespace
