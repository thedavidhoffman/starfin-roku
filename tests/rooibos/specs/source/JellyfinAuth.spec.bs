import "pkg:/source/Char.bs"

namespace tests

    @suite("Jellyfin authentication headers")
    class JellyfinAuthTests extends rooibos.BaseTestSuite

        @describe("JellyfinAuth header builders")

        @it("builds a client header with required fields")
        function _()
            header = JellyfinAuth.BuildClientHeader()
            m.assertTrue(Instr(1, header, "MediaBrowser Client=" + Char.DoubleQuote + "Starfin Roku" + Char.DoubleQuote) = 1)
            m.assertTrue(Instr(1, header, ", Device=" + Char.DoubleQuote) > 0)
            m.assertTrue(Instr(1, header, ", Version=" + Char.DoubleQuote) > 0)
            m.assertTrue(Instr(1, header, ", DeviceId=" + Char.DoubleQuote) > 0)
        end function

        @it("adds optional user and token values")
        function _()
            header = JellyfinAuth.BuildAuthorizationHeader("token-1", "user-1")
            m.assertTrue(Instr(1, header, "UserId=" + Char.DoubleQuote + "user-1" + Char.DoubleQuote) > 0)
            m.assertTrue(Instr(1, header, "Token=" + Char.DoubleQuote + "token-1" + Char.DoubleQuote) > 0)

            header = JellyfinAuth.BuildAuthorizationHeader(invalid)
            m.assertEqual(Instr(1, header, "UserId="), 0)
            m.assertEqual(Instr(1, header, "Token="), 0)
        end function

        @it("wraps authorization in the token-header shape")
        function _()
            headers = JellyfinAuth.BuildTokenHeaders("token-1")
            m.assertEqual(headers.Count(), 1)
            m.assertTrue(Instr(1, headers.Authorization, "Token=" + Char.DoubleQuote + "token-1" + Char.DoubleQuote) > 0)
        end function

    end class

end namespace
