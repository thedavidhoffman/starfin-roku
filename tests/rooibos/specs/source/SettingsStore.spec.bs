        @describe("burn-in legacy device cleanup")

        @it("removes the legacy device value during load without copying it to the account")
        function _()
            m.snapshotBurnInRegistry()
            legacy = CreateObject("roRegistrySection", "STARFIN_ROKU")
            legacy.Write("subtitle-burn-in-mode", "always")
            legacy.Flush()
            account = CreateObject("roRegistrySection", RegistryStore.AccountSectionName("rooibos-burn-in-cleanup"))
            account.Delete("subtitle-burn-in-mode")
            account.Flush()

            settings = SettingsStore.Load("rooibos-burn-in-cleanup")

            m.assertEqual(settings[SettingsStore.Key.SubtitleBurnInMode], "during-transcoding")
            m.assertFalse(legacy.Exists("subtitle-burn-in-mode"))
            m.assertFalse(account.Exists("subtitle-burn-in-mode"))
        end function

        @it("loads an existing account burn-in value instead of the legacy device value")
        function _()
            m.snapshotBurnInRegistry()
            legacy = CreateObject("roRegistrySection", "STARFIN_ROKU")
            legacy.Write("subtitle-burn-in-mode", "always")
            legacy.Flush()
            account = CreateObject("roRegistrySection", RegistryStore.AccountSectionName("rooibos-burn-in-cleanup"))
            account.Write("subtitle-burn-in-mode", "prefer-external")
            account.Flush()

            settings = SettingsStore.Load("rooibos-burn-in-cleanup")

            m.assertEqual(settings[SettingsStore.Key.SubtitleBurnInMode], "prefer-external")
        end function

        @it("saves account burn-in without performing migration cleanup")
        function _()
            m.snapshotBurnInRegistry()
            legacy = CreateObject("roRegistrySection", "STARFIN_ROKU")
            legacy.Write("subtitle-burn-in-mode", "always")
            legacy.Write("rooibos-unrelated", "preserve")
            legacy.Flush()
            settings = SettingsStore.Defaults()
            settings[SettingsStore.Key.SubtitleBurnInMode] = "prefer-external"

            SettingsStore.Save("rooibos-burn-in-cleanup", settings)

            account = CreateObject("roRegistrySection", RegistryStore.AccountSectionName("rooibos-burn-in-cleanup"))
            m.assertEqual(account.Read("subtitle-burn-in-mode"), "prefer-external")
            m.assertTrue(legacy.Exists("subtitle-burn-in-mode"))
            m.assertEqual(legacy.Read("rooibos-unrelated"), "preserve")
            m.assertEqual(legacy.Read("video-streaming-mode"), settings[SettingsStore.Key.VideoStreamingMode])
        end function

        @it("cleans up the device key when loading without an account")
        function _()
            m.snapshotBurnInRegistry()
            legacy = CreateObject("roRegistrySection", "STARFIN_ROKU")
            legacy.Write("subtitle-burn-in-mode", "always")
            legacy.Flush()

            SettingsStore.Load("")

            m.assertFalse(legacy.Exists("subtitle-burn-in-mode"))
        end function

        @it("can save repeatedly after the legacy key is removed")
        function _()
            m.snapshotBurnInRegistry()
            legacy = CreateObject("roRegistrySection", "STARFIN_ROKU")
            legacy.Delete("subtitle-burn-in-mode")
            legacy.Flush()
            settings = SettingsStore.Defaults()
            settings[SettingsStore.Key.SubtitleBurnInMode] = "always"

            SettingsStore.Save("rooibos-burn-in-cleanup", settings)
            SettingsStore.Save("rooibos-burn-in-cleanup", settings)

            m.assertFalse(legacy.Exists("subtitle-burn-in-mode"))
            m.assertEqual(SettingsStore.Load("rooibos-burn-in-cleanup")[SettingsStore.Key.SubtitleBurnInMode], "always")
        end function

        function snapshotBurnInRegistry()
            m.snapshotMigrationRegistry([RegistryStore.AccountSectionName("rooibos-burn-in-cleanup")])
        end function

        function snapshotMigrationRegistry(extraNames as object)
            m.registrySnapshot = {}
            names = []
            registry = CreateObject("roRegistry")
            for each name in registry.GetSectionList()
                names.Push(name)
            end for
            names.Push("STARFIN_ROKU")
            names.Append(extraNames)
            for each name in names
                if m.registrySnapshot.DoesExist(name) <> true then
                    section = CreateObject("roRegistrySection", name)
                    m.registrySnapshot[name] = section.ReadMulti(section.GetKeyList())
                end if
            end for
        end function

        @describe("independent media shell preferences")

        @it("defaults MovieShellLayout")
