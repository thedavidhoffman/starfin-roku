        @it("provides the Next Item Playback registry key")
        function _()
            m.assertEqual(SettingsStore.Key.NextItemPlayback, "next-item-playback")
        end function

        @describe("SettingsStore.Defaults")

        @it("indexes every default by its enum value")
        function _()
            defaults = SettingsStore.Defaults()

            m.assertEqual(defaults.Count(), 20)
            m.assertEqual(defaults[SettingsStore.Key.TvLibraryLayout], "poster;6")
            m.assertEqual(defaults[SettingsStore.Key.MovieLibraryLayout], "poster;6")
            m.assertEqual(defaults[SettingsStore.Key.CollectionCardsLayout], "poster;6")
            m.assertEqual(defaults[SettingsStore.Key.CollectionItemsLayout], "poster;6")
            m.assertEqual(defaults[SettingsStore.Key.PlaylistCardsLayout], "poster;6")
            m.assertEqual(defaults[SettingsStore.Key.PlaylistItemsLayout], "poster;6")
            m.assertEqual(defaults[SettingsStore.Key.MusicVideosLayout], "poster;6")
            m.assertEqual(defaults[SettingsStore.Key.HomeVideosLayout], "poster;6")
            m.assertEqual(defaults[SettingsStore.Key.TvEpisodeListDisplay], "vertical")
            m.assertEqual(defaults[SettingsStore.Key.ShowSeasonSummaryCard], "on")
            m.assertEqual(defaults[SettingsStore.Key.MediaShellBackground], "full-screen")
            m.assertEqual(defaults[SettingsStore.Key.ThemeMusic], "off")
            m.assertEqual(defaults[SettingsStore.Key.NextItemPlayback], NextItemPlayback.Mode.ShowUpNext)
            m.assertEqual(defaults[SettingsStore.Key.ScreensaverType], "none")
            m.assertEqual(defaults[SettingsStore.Key.ScreensaverDelay], "1")
            m.assertEqual(defaults[SettingsStore.Key.VideoStreamingMode], PlaybackMode.Mode.Automatic)
            m.assertEqual(defaults[SettingsStore.Key.SubtitleBurnInMode], SubtitleBurnIn.Mode.DuringTranscoding)
            m.assertEqual(defaults[SettingsStore.Key.DisplayAccountBadge], "off")
            m.assertEqual(defaults[SettingsStore.Key.TmdbApiKey], "")
        end function

        @describe("SettingsStore.AccountKeys")

        @it("contains only account-scoped setting keys")
        function _()
            m.assertEqual(SettingsStore.AccountKeys(), [
                SettingsStore.Key.TvLibraryLayout
                SettingsStore.Key.MovieLibraryLayout
                SettingsStore.Key.CollectionCardsLayout
                SettingsStore.Key.CollectionItemsLayout
                SettingsStore.Key.PlaylistCardsLayout
                SettingsStore.Key.PlaylistItemsLayout
                SettingsStore.Key.MusicVideosLayout
                SettingsStore.Key.HomeVideosLayout
                SettingsStore.Key.TvEpisodeListDisplay
                SettingsStore.Key.ShowSeasonSummaryCard
                SettingsStore.Key.HomeEpisodeImages
                SettingsStore.Key.MediaShellBackground
                SettingsStore.Key.ThemeMusic
                SettingsStore.Key.NextItemPlayback
                SettingsStore.Key.ScreensaverType
                SettingsStore.Key.ScreensaverDelay
            ])
        end function

        @describe("SettingsStore.LibraryKeys")

        @it("contains every library layout key")
        function _()
            m.assertEqual(SettingsStore.LibraryKeys(), [
                SettingsStore.Key.TvLibraryLayout
                SettingsStore.Key.MovieLibraryLayout
                SettingsStore.Key.CollectionCardsLayout
                SettingsStore.Key.CollectionItemsLayout
                SettingsStore.Key.PlaylistCardsLayout
                SettingsStore.Key.PlaylistItemsLayout
                SettingsStore.Key.MusicVideosLayout
                SettingsStore.Key.HomeVideosLayout
            ])
        end function

        @describe("SettingsStore value helpers")

        @it("preserves the Starfield screensaver type")
        function _()
            m.assertEqual(SettingsStore.NormalizeScreensaverType("starfield"), "starfield")
        end function

        @it("preserves the bouncing artwork screensaver type")
        function _()
            m.assertEqual(SettingsStore.NormalizeScreensaverType("bounce"), "bounce")
        end function

        @it("falls back to None for the legacy Roku type")
        function _()
            m.assertEqual(SettingsStore.NormalizeScreensaverType("roku"), "none")
        end function

        @it("falls back to None for an unknown type")
        function _()
            m.assertEqual(SettingsStore.NormalizeScreensaverType("unknown"), "none")
        end function

        @it("reads associative-array values and applies fallbacks")
        function _()
            values = { present: "value", empty: "" }
            m.assertEqual(SettingsStore.GetValue(values, "present", "fallback"), "value")
            m.assertEqual(SettingsStore.GetValue(values, "missing", "fallback"), "fallback")
            m.assertEqual(SettingsStore.GetValue(values, "empty", "fallback"), "fallback")
            m.assertEqual(SettingsStore.GetValue(invalid, "present", "fallback"), "fallback")
        end function

        @it("uses enum-indexed defaults for missing settings")
        function _()
            settings = {}
            settings[SettingsStore.Key.ThemeMusic] = "on"

            m.assertEqual(SettingsStore.GetSettingValue(settings, SettingsStore.Key.ThemeMusic), "on")
            m.assertEqual(SettingsStore.GetSettingValue(settings, SettingsStore.Key.VideoStreamingMode), PlaybackMode.Mode.Automatic)
            m.assertEqual(SettingsStore.GetSettingValue(settings, SettingsStore.Key.SubtitleBurnInMode), SubtitleBurnIn.Mode.DuringTranscoding)
            m.assertEqual(SettingsStore.GetSettingValue(settings, SettingsStore.Key.NextItemPlayback), NextItemPlayback.Mode.ShowUpNext)
            m.assertEqual(SettingsStore.GetSettingValue(invalid, SettingsStore.Key.TvLibraryLayout), "poster;6")
            m.assertEqual(SettingsStore.GetSettingValue({}, "unknown-key"), "")
        end function

        @describe("SettingsStore.IsThemeMusicEnabled")

        @it("enables theme music for on")
        function _()
            settings = {}
            settings[SettingsStore.Key.ThemeMusic] = "on"

            m.assertTrue(SettingsStore.IsThemeMusicEnabled(settings))
        end function

        @it("enables theme music case-insensitively")
        function _()
            settings = {}
            settings[SettingsStore.Key.ThemeMusic] = "ON"

            m.assertTrue(SettingsStore.IsThemeMusicEnabled(settings))
        end function

        @it("disables theme music for off")
        function _()
            settings = {}
            settings[SettingsStore.Key.ThemeMusic] = "off"

            m.assertFalse(SettingsStore.IsThemeMusicEnabled(settings))
        end function

        @it("disables theme music when settings are missing")
        function _()
            m.assertFalse(SettingsStore.IsThemeMusicEnabled(invalid))
        end function

        @it("compares effective setting values")
        function _()
            left = SettingsStore.Defaults()
            right = SettingsStore.Defaults()
            m.assertTrue(SettingsStore.AreEqual(left, right))

            right[SettingsStore.Key.ThemeMusic] = "on"
            m.assertFalse(SettingsStore.AreEqual(left, right))
            m.assertFalse(SettingsStore.AreEqual(invalid, right))
            m.assertFalse(SettingsStore.AreEqual(left, invalid))
        end function

        @it("loads and saves canonical episode image mode for series")
        function _()
            accountKey = "rooibos-images-modes"
            sectionName = RegistryStore.AccountSectionName(accountKey)
            m.registrySnapshot = {}
            for each name in ["STARFIN_ROKU", sectionName]
                section = CreateObject("roRegistrySection", name)
                m.registrySnapshot[name] = section.ReadMulti(section.GetKeyList())
            end for
            section = CreateObject("roRegistrySection", sectionName)
            section.Write("home-episode-images", "series")
            section.Flush()

            settings = SettingsStore.Load(accountKey)

            m.assertEqual(settings[SettingsStore.Key.HomeEpisodeImages], "series")
            m.assertEqual(section.Read("home-episode-images"), "series")

            SettingsStore.Save(accountKey, settings)

            m.assertEqual(section.Read("home-episode-images"), "series")
        end function

        @it("loads and saves canonical episode image mode for episode-without-logo")
        function _()
            accountKey = "rooibos-images-modes"
            sectionName = RegistryStore.AccountSectionName(accountKey)
            m.registrySnapshot = {}
            for each name in ["STARFIN_ROKU", sectionName]
                section = CreateObject("roRegistrySection", name)
                m.registrySnapshot[name] = section.ReadMulti(section.GetKeyList())
            end for
            section = CreateObject("roRegistrySection", sectionName)
            section.Write("home-episode-images", "episode-without-logo")
            section.Flush()

            settings = SettingsStore.Load(accountKey)

            m.assertEqual(settings[SettingsStore.Key.HomeEpisodeImages], "episode-without-logo")
            m.assertEqual(section.Read("home-episode-images"), "episode-without-logo")

            SettingsStore.Save(accountKey, settings)

            m.assertEqual(section.Read("home-episode-images"), "episode-without-logo")
        end function

        @it("loads and saves canonical episode image mode for episode-with-logo")
        function _()
            accountKey = "rooibos-images-modes"
            sectionName = RegistryStore.AccountSectionName(accountKey)
            m.registrySnapshot = {}
            for each name in ["STARFIN_ROKU", sectionName]
                section = CreateObject("roRegistrySection", name)
                m.registrySnapshot[name] = section.ReadMulti(section.GetKeyList())
            end for
            section = CreateObject("roRegistrySection", sectionName)
            section.Write("home-episode-images", "episode-with-logo")
            section.Flush()

            settings = SettingsStore.Load(accountKey)

            m.assertEqual(settings[SettingsStore.Key.HomeEpisodeImages], "episode-with-logo")
            m.assertEqual(section.Read("home-episode-images"), "episode-with-logo")

            SettingsStore.Save(accountKey, settings)

            m.assertEqual(section.Read("home-episode-images"), "episode-with-logo")
        end function

    end class

