        @it("preserves valid library layouts on direct reads")
        function _()
            m.assertEqual(SettingsStore.GetSettingValue({ "tv-library-layout": "thumbnail;4" }, SettingsStore.Key.TvLibraryLayout), "thumbnail;4")
        end function

        @it("preserves valid video modes on direct reads")
        function _()
            m.assertEqual(SettingsStore.GetSettingValue({ "video-streaming-mode": "transcode-no-remux" }, SettingsStore.Key.VideoStreamingMode), "transcode-no-remux")
        end function

        @it("defaults invalid video modes on direct reads")
        function _()
            m.assertEqual(SettingsStore.GetSettingValue({ "video-streaming-mode": "unknown" }, SettingsStore.Key.VideoStreamingMode), "automatic")
        end function

        @it("normalizes screensaver types on direct reads")
        function _()
            m.assertEqual(SettingsStore.GetSettingValue({ "screensaver-type": "STARFIELD" }, SettingsStore.Key.ScreensaverType), "starfield")
        end function

        @it("defaults invalid screensaver types on direct reads")
        function _()
            m.assertEqual(SettingsStore.GetSettingValue({ "screensaver-type": "unknown" }, SettingsStore.Key.ScreensaverType), "none")
        end function

        @it("normalizes raw account settings during load")
        function _()
            name = RegistryStore.AccountSectionName("rooibos-normalization")
            section = CreateObject("roRegistrySection", name)
            m.registrySnapshot = {}
            m.registrySnapshot[name] = section.ReadMulti(section.GetKeyList())
            section.Write("screensaver-type", "STARFIELD")
            section.Flush()

            settings = SettingsStore.Load("rooibos-normalization")

            m.assertEqual(settings[SettingsStore.Key.ScreensaverType], "starfield")
        end function

        @it("normalizes account settings before writing to registry")
        function _()
            m.registrySnapshot = {}
            name = RegistryStore.AccountSectionName("rooibos-normalization")
            for each sectionName in ["STARFIN_ROKU", name]
                section = CreateObject("roRegistrySection", sectionName)
                m.registrySnapshot[sectionName] = section.ReadMulti(section.GetKeyList())
            end for
            settings = SettingsStore.Defaults()
            settings[SettingsStore.Key.ScreensaverType] = "STARFIELD"

            SettingsStore.Save("rooibos-normalization", settings)

            section = CreateObject("roRegistrySection", name)
            m.assertEqual(section.Read("screensaver-type"), "starfield")
        end function

        @describe("SettingsStore.IsThemeMusicEnabled")

        @it("enables theme music for on")
        function _()
            settings = {}
            settings[SettingsStore.Key.ThemeMusic] = "on"

            m.assertTrue(SettingsStore.IsThemeMusicEnabled(settings))
        end function

        @it("enables theme music case-insensitively")
        function _()
            settings = {}
            settings[SettingsStore.Key.ThemeMusic] = "ON"

            m.assertTrue(SettingsStore.IsThemeMusicEnabled(settings))
        end function

        @it("disables theme music for off")
        function _()
            settings = {}
            settings[SettingsStore.Key.ThemeMusic] = "off"

            m.assertFalse(SettingsStore.IsThemeMusicEnabled(settings))
        end function

        @it("disables theme music when settings are missing")
        function _()
            m.assertFalse(SettingsStore.IsThemeMusicEnabled(invalid))
        end function

        @it("compares effective setting values")
        function _()
            left = SettingsStore.Defaults()
            right = SettingsStore.Defaults()
            m.assertTrue(SettingsStore.AreEqual(left, right))

            right[SettingsStore.Key.ThemeMusic] = "on"
            m.assertFalse(SettingsStore.AreEqual(left, right))
            m.assertFalse(SettingsStore.AreEqual(invalid, right))
            m.assertFalse(SettingsStore.AreEqual(left, invalid))
        end function

        @it("treats unsupported values as equal to their effective defaults")
        function _()
            m.assertTrue(SettingsStore.AreEqual({ "next-episode-prompt-seconds": "1000" }, { "next-episode-prompt-seconds": "0" }))
        end function

        @it("treats equivalent normalized values as equal")
        function _()
            m.assertTrue(SettingsStore.AreEqual({ "screensaver-type": "STARFIELD" }, { "screensaver-type": "starfield" }))
        end function

        @it("distinguishes different valid normalized settings")
        function _()
            m.assertFalse(SettingsStore.AreEqual({ "next-episode-prompt-seconds": "30" }, { "next-episode-prompt-seconds": "60" }))
        end function

        @describe("bulk global settings")

        @it("defines the complete global settings scope")
        function _()
            m.assertEqual(SettingsStore.GlobalKeys(), ["display-account-badge", "video-streaming-mode", "subtitle-burn-in-mode", "tmdb-api-key"])
        end function

        @it("loads defaults for missing global settings without an account")
        function _()
            section = CreateObject("roRegistrySection", "STARFIN_ROKU")
            m.registrySnapshot = {}
            m.registrySnapshot["STARFIN_ROKU"] = section.ReadMulti(section.GetKeyList())
            for each key in SettingsStore.GlobalKeys()
                section.Delete(key)
            end for
            section.Flush()

            settings = SettingsStore.Load("")

            m.assertEqual(settings[SettingsStore.Key.DisplayAccountBadge], "off")
            m.assertEqual(settings[SettingsStore.Key.VideoStreamingMode], "automatic")
            m.assertEqual(settings[SettingsStore.Key.SubtitleBurnInMode], "during-transcoding")
            m.assertEqual(settings[SettingsStore.Key.TmdbApiKey], "")
        end function

        @it("persists global settings separately from account settings")
        function _()
            accountKey = "rooibos-bulk-global"
            accountSectionName = RegistryStore.AccountSectionName(accountKey)
            m.registrySnapshot = {}
            for each name in ["STARFIN_ROKU", accountSectionName]
                section = CreateObject("roRegistrySection", name)
                m.registrySnapshot[name] = section.ReadMulti(section.GetKeyList())
            end for
            settings = SettingsStore.Defaults()
            settings[SettingsStore.Key.Theme] = "black"
            settings[SettingsStore.Key.DisplayAccountBadge] = "on"
            settings[SettingsStore.Key.VideoStreamingMode] = "transcode-no-remux"
            settings[SettingsStore.Key.SubtitleBurnInMode] = "ALWAYS"
            settings[SettingsStore.Key.TmdbApiKey] = "test-api-key"

            SettingsStore.Save(accountKey, settings)
            loaded = SettingsStore.Load(accountKey)

            globalSection = CreateObject("roRegistrySection", "STARFIN_ROKU")
            m.assertEqual(globalSection.Read("display-account-badge"), "on")
            m.assertEqual(globalSection.Read("video-streaming-mode"), "transcode-no-remux")
            m.assertEqual(globalSection.Read("subtitle-burn-in-mode"), "always")
            m.assertEqual(globalSection.Read("tmdb-api-key"), "test-api-key")
            m.assertEqual(loaded[SettingsStore.Key.DisplayAccountBadge], "on")
            m.assertEqual(loaded[SettingsStore.Key.VideoStreamingMode], "transcode-no-remux")
            m.assertEqual(loaded[SettingsStore.Key.SubtitleBurnInMode], "always")
            m.assertEqual(loaded[SettingsStore.Key.TmdbApiKey], "test-api-key")
            accountSection = CreateObject("roRegistrySection", accountSectionName)
            m.assertEqual(accountSection.Read("theme"), "black")
            m.assertEqual(loaded[SettingsStore.Key.Theme], "black")
        end function

        @it("saves global settings without an account")
        function _()
            section = CreateObject("roRegistrySection", "STARFIN_ROKU")
            m.registrySnapshot = {}
            m.registrySnapshot["STARFIN_ROKU"] = section.ReadMulti(section.GetKeyList())
            settings = SettingsStore.Defaults()
            settings[SettingsStore.Key.VideoStreamingMode] = "transcode-allow-remux"
            settings[SettingsStore.Key.Theme] = "black"

            SettingsStore.Save("", settings)
            loaded = SettingsStore.Load("")

            m.assertEqual(section.Read("video-streaming-mode"), "transcode-allow-remux")
            m.assertEqual(loaded[SettingsStore.Key.VideoStreamingMode], "transcode-allow-remux")
            m.assertEqual(loaded[SettingsStore.Key.Theme], "blue")
        end function

        @describe("Home episode image persistence")

        @it("loads and saves canonical episode image mode for series")
        function _()
            accountKey = "rooibos-images-modes"
            sectionName = RegistryStore.AccountSectionName(accountKey)
            m.registrySnapshot = {}
            for each name in ["STARFIN_ROKU", sectionName]
                section = CreateObject("roRegistrySection", name)
                m.registrySnapshot[name] = section.ReadMulti(section.GetKeyList())
            end for
            section = CreateObject("roRegistrySection", sectionName)
            section.Write("home-episode-images", "series")
            section.Flush()

            settings = SettingsStore.Load(accountKey)

            m.assertEqual(settings[SettingsStore.Key.HomeEpisodeImages], "series")
            m.assertEqual(section.Read("home-episode-images"), "series")

            SettingsStore.Save(accountKey, settings)

            m.assertEqual(section.Read("home-episode-images"), "series")
        end function

        @it("loads and saves canonical episode image mode for episode-without-logo")
        function _()
            accountKey = "rooibos-images-modes"
            sectionName = RegistryStore.AccountSectionName(accountKey)
            m.registrySnapshot = {}
            for each name in ["STARFIN_ROKU", sectionName]
                section = CreateObject("roRegistrySection", name)
                m.registrySnapshot[name] = section.ReadMulti(section.GetKeyList())
            end for
            section = CreateObject("roRegistrySection", sectionName)
            section.Write("home-episode-images", "episode-without-logo")
            section.Flush()

            settings = SettingsStore.Load(accountKey)

            m.assertEqual(settings[SettingsStore.Key.HomeEpisodeImages], "episode-without-logo")
            m.assertEqual(section.Read("home-episode-images"), "episode-without-logo")

            SettingsStore.Save(accountKey, settings)

            m.assertEqual(section.Read("home-episode-images"), "episode-without-logo")
        end function

        @it("loads and saves canonical episode image mode for episode-with-logo")
        function _()
            accountKey = "rooibos-images-modes"
            sectionName = RegistryStore.AccountSectionName(accountKey)
            m.registrySnapshot = {}
            for each name in ["STARFIN_ROKU", sectionName]
                section = CreateObject("roRegistrySection", name)
                m.registrySnapshot[name] = section.ReadMulti(section.GetKeyList())
            end for
            section = CreateObject("roRegistrySection", sectionName)
            section.Write("home-episode-images", "episode-with-logo")
            section.Flush()

            settings = SettingsStore.Load(accountKey)

            m.assertEqual(settings[SettingsStore.Key.HomeEpisodeImages], "episode-with-logo")
            m.assertEqual(section.Read("home-episode-images"), "episode-with-logo")

            SettingsStore.Save(accountKey, settings)

            m.assertEqual(section.Read("home-episode-images"), "episode-with-logo")
        end function

        @describe("credits fallback persistence")

        @it("defaults credits fallback to Off")
        function _()
            m.assertEqual(SettingsStore.Key.NextEpisodePromptSeconds, "next-episode-prompt-seconds")
            m.assertEqual(SettingsStore.GetSettingValue({}, SettingsStore.Key.NextEpisodePromptSeconds), "0")
        end function

        @it("normalizes unsupported credits fallback values")
        function _()
            m.assertEqual(SettingsStore.GetSettingValue({ "next-episode-prompt-seconds": "1000" }, SettingsStore.Key.NextEpisodePromptSeconds), "0")
        end function

        @it("persists credits fallback separately for each account")
        function _()
            m.registrySnapshot = {}
            for each name in ["STARFIN_ROKU", RegistryStore.AccountSectionName("rooibos-credits-a"), RegistryStore.AccountSectionName("rooibos-credits-b")]
                section = CreateObject("roRegistrySection", name)
                m.registrySnapshot[name] = section.ReadMulti(section.GetKeyList())
            end for
            settings = SettingsStore.Defaults()
            settings[SettingsStore.Key.NextEpisodePromptSeconds] = "75"
            SettingsStore.Save("rooibos-credits-a", settings)
            settings[SettingsStore.Key.NextEpisodePromptSeconds] = "30"
            SettingsStore.Save("rooibos-credits-b", settings)

            m.assertEqual(SettingsStore.Load("rooibos-credits-a")[SettingsStore.Key.NextEpisodePromptSeconds], "75")
            m.assertEqual(SettingsStore.Load("rooibos-credits-b")[SettingsStore.Key.NextEpisodePromptSeconds], "30")
        end function

        @describe("watched indicator preference")

        @it("defaults watched style to subtle")
        function _()
            m.assertEqual(SettingsStore.Key.WatchedIndicatorStyle, "watched-indicator-style")
            m.assertEqual(SettingsStore.GetSettingValue({}, SettingsStore.Key.WatchedIndicatorStyle), "subtle")
        end function

        @it("normalizes invalid watched style")
        function _()
            m.assertEqual(SettingsStore.GetSettingValue({ "watched-indicator-style": "unknown" }, SettingsStore.Key.WatchedIndicatorStyle), "subtle")
        end function

        @it("persists watched style per account")
        function _()
            m.registrySnapshot = {}
            for each name in ["STARFIN_ROKU", RegistryStore.AccountSectionName("rooibos-watched-a"), RegistryStore.AccountSectionName("rooibos-watched-b")]
                section = CreateObject("roRegistrySection", name)
                m.registrySnapshot[name] = section.ReadMulti(section.GetKeyList())
            end for
            settings = SettingsStore.Defaults()
            settings[SettingsStore.Key.WatchedIndicatorStyle] = "high-contrast"
            SettingsStore.Save("rooibos-watched-a", settings)
            settings[SettingsStore.Key.WatchedIndicatorStyle] = "subtle"
            SettingsStore.Save("rooibos-watched-b", settings)

            m.assertEqual(SettingsStore.Load("rooibos-watched-a")[SettingsStore.Key.WatchedIndicatorStyle], "high-contrast")
            m.assertEqual(SettingsStore.Load("rooibos-watched-b")[SettingsStore.Key.WatchedIndicatorStyle], "subtle")
        end function

    end class

end namespace
