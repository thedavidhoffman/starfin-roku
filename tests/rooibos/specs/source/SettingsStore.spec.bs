            m.assertEqual(SettingsStore.GetSettingValue(settings, SettingsStore.Key.MovieShellLayout), "partial-screen")
            m.assertEqual(SettingsStore.GetSettingValue(settings, SettingsStore.Key.TvEpisodeShellLayout), "cinematic")
        end function

