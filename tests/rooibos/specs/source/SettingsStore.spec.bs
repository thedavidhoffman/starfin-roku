namespace tests

    @suite("Settings store")
    class SettingsStoreTests extends rooibos.BaseTestSuite

        protected override function beforeEach()
            m.originalMigrationComplete = m.global.settingsMigrationComplete
            m.global.settingsMigrationComplete = false
        end function

        protected override function afterEach()
            m.global.settingsMigrationComplete = m.originalMigrationComplete
            globalAa = getGlobalAa()
            globalAa.Delete("settingsStoreMigrationCalls")
            globalAa.Delete("settingsStoreMigrationResults")
            if m.registrySnapshot = invalid then return invalid

            registry = CreateObject("roRegistry")
            for each name in m.registrySnapshot
                registry.Delete(name)
                values = m.registrySnapshot[name]
                if values.Count() > 0 then
                    section = CreateObject("roRegistrySection", name)
                    section.WriteMulti(values)
                    section.Flush()
                end if
            end for
            registry.Flush()
            m.registrySnapshot = invalid
        end function

        @describe("session migration completion")

        @it("marks migration complete after the first successful global load")
        function _()
            m.prepareMigrationResults([true])

            SettingsStore.Load("")

            m.assertTrue(m.global.settingsMigrationComplete)
            m.assertEqual(getGlobalAa().settingsStoreMigrationCalls, 1)
        end function

        @it("skips migration for account loads after a successful global load")
        function _()
            m.prepareMigrationResults([true])
            SettingsStore.Load("")

            SettingsStore.Load("rooibos-session-a")
            SettingsStore.Load("rooibos-session-b")

            m.assertTrue(m.global.settingsMigrationComplete)
            m.assertEqual(getGlobalAa().settingsStoreMigrationCalls, 1)
        end function

        @it("keeps completion unset and returns settings after a failed migration")
        function _()
            m.prepareMigrationResults([false])

            settings = SettingsStore.Load("")

            m.assertFalse(m.global.settingsMigrationComplete)
            m.assertEqual(settings[SettingsStore.Key.MovieShellLayout], "full-screen")
            m.assertEqual(getGlobalAa().settingsStoreMigrationCalls, 1)
        end function

        @it("retries migration until a later load succeeds")
        function _()
            m.prepareMigrationResults([false, true])
            SettingsStore.Load("")

            SettingsStore.Load("rooibos-session-a")
            SettingsStore.Load("rooibos-session-b")

            m.assertTrue(m.global.settingsMigrationComplete)
            m.assertEqual(getGlobalAa().settingsStoreMigrationCalls, 2)
        end function

        @it("continues retrying when successive migrations fail")
        function _()
            m.prepareMigrationResults([false, false])

            SettingsStore.Load("")
            SettingsStore.Load("rooibos-session-a")

            m.assertFalse(m.global.settingsMigrationComplete)
            m.assertEqual(getGlobalAa().settingsStoreMigrationCalls, 2)
        end function

        @it("runs migration again when a new session starts with completion unset")
        function _()
            m.prepareMigrationResults([true, true])
            SettingsStore.Load("")

            m.global.settingsMigrationComplete = false
            SettingsStore.Load("")

            m.assertTrue(m.global.settingsMigrationComplete)
            m.assertEqual(getGlobalAa().settingsStoreMigrationCalls, 2)
        end function

        function prepareMigrationResults(results as object)
            globalAa = getGlobalAa()
            globalAa.settingsStoreMigrationCalls = 0
            globalAa.settingsStoreMigrationResults = results
            m.stubCall(SettingsMigration.Migrate, m.nextMigrationResult)
        end function

        function nextMigrationResult() as boolean
            globalAa = getGlobalAa()
            index = globalAa.settingsStoreMigrationCalls
            globalAa.settingsStoreMigrationCalls += 1
            results = globalAa.settingsStoreMigrationResults
            if index >= results.Count() then return false
            return results[index]
        end function

        @describe("theme preference")

        @it("defaults missing themes to blue")
        function _()
            m.assertEqual(SettingsStore.Key.Theme, "theme")
            m.assertEqual(SettingsStore.GetSettingValue({}, SettingsStore.Key.Theme), "blue")
        end function

        @it("normalizes unsupported themes to blue")
        function _()
            m.assertEqual(SettingsStore.GetSettingValue({ theme: "unknown" }, SettingsStore.Key.Theme), "blue")
        end function

        @it("persists themes separately for each account")
        function _()
            m.snapshotMigrationRegistry([])
            for each name in ["STARFIN_ROKU", RegistryStore.AccountSectionName("rooibos-theme-a"), RegistryStore.AccountSectionName("rooibos-theme-b")]
                section = CreateObject("roRegistrySection", name)
                m.registrySnapshot[name] = section.ReadMulti(section.GetKeyList())
            end for
            settings = SettingsStore.Defaults()
            settings[SettingsStore.Key.Theme] = "black"
            SettingsStore.Save("rooibos-theme-a", settings)
            settings[SettingsStore.Key.Theme] = "grey"
            SettingsStore.Save("rooibos-theme-b", settings)

            m.assertEqual(SettingsStore.Load("rooibos-theme-a")[SettingsStore.Key.Theme], "black")
            m.assertEqual(SettingsStore.Load("rooibos-theme-b")[SettingsStore.Key.Theme], "grey")
        end function

        @describe("season summary setting")

        @it("defaults existing and new accounts to On")
        function _()
            m.assertEqual(SettingsStore.Key.ShowSeasonSummaryCard, "show-season-summary-card")
            m.assertEqual(SettingsStore.GetSettingValue(invalid, SettingsStore.Key.ShowSeasonSummaryCard), "on")
            m.assertEqual(SettingsStore.GetSettingValue({}, SettingsStore.Key.ShowSeasonSummaryCard), "on")
        end function

        @it("persists separate summary preferences across account reloads")
        function _()
            m.snapshotMigrationRegistry([])
            for each name in ["STARFIN_ROKU", RegistryStore.AccountSectionName("rooibos-summary-a"), RegistryStore.AccountSectionName("rooibos-summary-b")]
                section = CreateObject("roRegistrySection", name)
                m.registrySnapshot[name] = section.ReadMulti(section.GetKeyList())
            end for
            settings = SettingsStore.Defaults()
            settings[SettingsStore.Key.ShowSeasonSummaryCard] = "off"
            SettingsStore.Save("rooibos-summary-a", settings)
            settings[SettingsStore.Key.ShowSeasonSummaryCard] = "on"
            SettingsStore.Save("rooibos-summary-b", settings)

            m.assertEqual(SettingsStore.Load("rooibos-summary-a")[SettingsStore.Key.ShowSeasonSummaryCard], "off")
            m.assertEqual(SettingsStore.Load("rooibos-summary-b")[SettingsStore.Key.ShowSeasonSummaryCard], "on")
            m.assertEqual(SettingsStore.Load("rooibos-summary-a")[SettingsStore.Key.ShowSeasonSummaryCard], "off")
        end function

        @describe("Home episode images")

        @it("defaults missing episode image preferences to series")
        function _()
            m.assertEqual(SettingsStore.Key.HomeEpisodeImages, "home-episode-images")
            m.assertEqual(SettingsStore.GetSettingValue(invalid, SettingsStore.Key.HomeEpisodeImages), "series")
            m.assertEqual(SettingsStore.GetSettingValue({}, SettingsStore.Key.HomeEpisodeImages), "series")
        end function

        @it("persists episode images separately for each account")
        function _()
            ' Save also writes device settings; restore all affected sections even if assertions fail.
            m.snapshotMigrationRegistry([])
            for each name in ["STARFIN_ROKU", RegistryStore.AccountSectionName("rooibos-images-a"), RegistryStore.AccountSectionName("rooibos-images-b")]
                section = CreateObject("roRegistrySection", name)
                m.registrySnapshot[name] = section.ReadMulti(section.GetKeyList())
            end for

            settings = SettingsStore.Defaults()
            settings[SettingsStore.Key.HomeEpisodeImages] = "series"
            SettingsStore.Save("rooibos-images-a", settings)
            settings[SettingsStore.Key.HomeEpisodeImages] = "episode-with-logo"
            SettingsStore.Save("rooibos-images-b", settings)

            m.assertEqual(SettingsStore.Load("rooibos-images-a")[SettingsStore.Key.HomeEpisodeImages], "series")
            m.assertEqual(SettingsStore.Load("rooibos-images-b")[SettingsStore.Key.HomeEpisodeImages], "episode-with-logo")

        end function

        @it("preserves explicitly selected series artwork")
        function _()
            m.assertEqual(SettingsStore.GetSettingValue({ "home-episode-images": "series" }, SettingsStore.Key.HomeEpisodeImages), "series")
        end function

