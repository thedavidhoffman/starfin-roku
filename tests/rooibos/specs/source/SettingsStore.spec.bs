        function _()
            m.assertEqual(SettingsStore.GetSettingValue({ "media-shell-background": "cinematic", "movie-shell-layout": "unknown" }, SettingsStore.Key.MovieShellLayout), "full-screen")
        end function

        @it("rejects saved episode Poster")
        function _()
            m.assertEqual(SettingsStore.GetSettingValue({ "tv-episode-shell-layout": "poster" }, SettingsStore.Key.TvEpisodeShellLayout), "full-screen")
        end function

        @it("compares independent preferences")
        function _()
            left = SettingsStore.Defaults()
            right = SettingsStore.Defaults()
            right[SettingsStore.Key.TvSeriesShellLayout] = "poster"
            m.assertFalse(SettingsStore.AreEqual(left, right))
        end function

        @it("migrates and persists legacy layouts before returning settings")
        function _()
            m.snapshotMigrationRegistry([RegistryStore.AccountSectionName("rooibos-shell-a"), RegistryStore.AccountSectionName("rooibos-shell-b")])
            section = CreateObject("roRegistrySection", RegistryStore.AccountSectionName("rooibos-shell-a"))
            section.Delete(SettingsStore.Key.MovieShellLayout)
            section.Delete(SettingsStore.Key.TvSeriesShellLayout)
            section.Delete(SettingsStore.Key.TvEpisodeShellLayout)
            section.Delete(SettingsStore.Key.MusicShellLayout)
            section.Write("media-shell-background", "cinematic")
            section.Flush()
            settings = SettingsStore.Load("rooibos-shell-a")
            m.assertEqual(settings[SettingsStore.Key.MovieShellLayout], "cinematic")
            m.assertEqual(section.Read("movie-shell-layout"), "cinematic")
            m.assertFalse(section.Exists("media-shell-background"))
        end function

        @it("loads compatible legacy values when migration fails")
        function _()
            m.snapshotMigrationRegistry([RegistryStore.AccountSectionName("rooibos-shell-a")])
            section = CreateObject("roRegistrySection", RegistryStore.AccountSectionName("rooibos-shell-a"))
            for each key in ["movie-shell-layout", "tv-series-shell-layout", "tv-episode-shell-layout", "music-shell-layout"]
                section.Delete(key)
            end for
            section.Write("media-shell-background", "cinematic")
            section.Flush()
            m.stubCall(SettingsMigration.Migrate, false)

            settings = SettingsStore.Load("rooibos-shell-a")

            m.assertEqual(settings[SettingsStore.Key.MovieShellLayout], "cinematic")
            m.assertEqual(settings[SettingsStore.Key.TvSeriesShellLayout], "partial-screen")
            m.assertTrue(section.Exists("media-shell-background"))
            m.assertFalse(section.Exists("movie-shell-layout"))
        end function

        @it("normal saving retains the completed layout migration")
        function _()
            m.snapshotMigrationRegistry([RegistryStore.AccountSectionName("rooibos-shell-a"), RegistryStore.AccountSectionName("rooibos-shell-b")])
            section = CreateObject("roRegistrySection", RegistryStore.AccountSectionName("rooibos-shell-a"))
            section.Delete(SettingsStore.Key.MovieShellLayout)
            section.Delete(SettingsStore.Key.TvSeriesShellLayout)
            section.Delete(SettingsStore.Key.TvEpisodeShellLayout)
            section.Delete(SettingsStore.Key.MusicShellLayout)
            section.Write("media-shell-background", "cinematic")
            section.Flush()
            settings = SettingsStore.Load("rooibos-shell-a")
            SettingsStore.Save("rooibos-shell-a", settings)
            m.assertEqual(section.Read("movie-shell-layout"), "cinematic")
            m.assertEqual(section.Read("tv-series-shell-layout"), "partial-screen")
            m.assertEqual(section.Read("tv-episode-shell-layout"), "cinematic")
            m.assertFalse(section.Exists("media-shell-background"))
        end function

        @it("isolates media layouts between accounts")
        function _()
            m.snapshotMigrationRegistry([RegistryStore.AccountSectionName("rooibos-shell-a"), RegistryStore.AccountSectionName("rooibos-shell-b")])
            section = CreateObject("roRegistrySection", RegistryStore.AccountSectionName("rooibos-shell-a"))
            section.Delete(SettingsStore.Key.MovieShellLayout)
            section.Delete(SettingsStore.Key.TvSeriesShellLayout)
            section.Delete(SettingsStore.Key.TvEpisodeShellLayout)
            section.Delete(SettingsStore.Key.MusicShellLayout)
            section.Write("media-shell-background", "cinematic")
            section.Flush()
            first = SettingsStore.Defaults()
            first[SettingsStore.Key.MovieShellLayout] = "poster"
            SettingsStore.Save("rooibos-shell-a", first)
            SettingsStore.Save("rooibos-shell-b", SettingsStore.Defaults())
            m.assertEqual(SettingsStore.Load("rooibos-shell-a")[SettingsStore.Key.MovieShellLayout], "poster")
            m.assertEqual(SettingsStore.Load("rooibos-shell-b")[SettingsStore.Key.MovieShellLayout], "full-screen")
        end function

