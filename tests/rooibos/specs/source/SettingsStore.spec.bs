        end function

        @it("migrates legacy partial-screen for MovieShellLayout")
        function _()
            m.assertEqual(SettingsStore.GetSettingValue({ "media-shell-background": "partial-screen" }, SettingsStore.Key.MovieShellLayout), "partial-screen")
        end function

