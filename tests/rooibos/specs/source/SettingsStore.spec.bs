            m.assertEqual(SettingsStore.Key.PlaylistItemsLayout, "playlist-items-layout")
        end function

        @it("provides the persisted registry key values (case 7)")
        function _()
            m.assertEqual(SettingsStore.Key.TvEpisodeListDisplay, "tv-ep-list-scroll")
        end function

        @it("provides the persisted registry key values (case 8)")
        function _()
            m.assertEqual(SettingsStore.Key.MediaShellBackground, "media-shell-background")
