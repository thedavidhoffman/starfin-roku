namespace tests

    @suite("Next item playback")
    class NextItemPlaybackTests extends rooibos.BaseTestSuite

        @describe("normalization")

        @it("preserves immediate playback")
        function _()
            m.assertEqual(NextItemPlayback.Normalize("PLAY-NEXT-IMMEDIATELY"), NextItemPlayback.Mode.PlayNextImmediately)
        end function

        @it("defaults missing values to Show Up Next")
        function _()
            m.assertEqual(NextItemPlayback.Normalize(invalid), NextItemPlayback.Mode.ShowUpNext)
        end function

        @it("defaults unsupported values to Show Up Next")
        function _()
            m.assertEqual(NextItemPlayback.Normalize("unsupported"), NextItemPlayback.Mode.ShowUpNext)
        end function

    end class

end namespace
