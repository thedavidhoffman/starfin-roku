namespace tests

    @suite("Episode queue identity")
    class EpisodeQueueIdentityTests extends rooibos.BaseTestSuite

        @describe("Apply")

        @it("adds a positive identity to a series request")
        function _()
            request = {}

            EpisodeQueueIdentity.Apply(request, "series", 7)

            m.assertEqual(request.episodeQueueId, 7)
        end function

        @it("removes identity from non-series and invalid requests")
        function _()
            for each scope in ["playlist", "random", "adHoc", ""]
                request = { episodeQueueId: 7 }

                EpisodeQueueIdentity.Apply(request, scope, 7)

                m.assertFalse(request.DoesExist("episodeQueueId"))
            end for

            request = { episodeQueueId: 7 }
            EpisodeQueueIdentity.Apply(request, "series", 0)
            m.assertFalse(request.DoesExist("episodeQueueId"))
        end function

    end class

end namespace
