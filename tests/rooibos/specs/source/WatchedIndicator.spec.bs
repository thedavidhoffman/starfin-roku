import "pkg:/source/WatchedIndicator.bs"

namespace tests

    @suite("Watched indicator style")
    class WatchedIndicatorTests extends rooibos.BaseTestSuite

        @describe("normalization and assets")

        @it("defaults missing styles to subtle")
        function _()
            m.assertEqual(WatchedIndicator.Normalize(invalid), "subtle")
        end function

        @it("defaults unknown styles to subtle")
        function _()
            m.assertEqual(WatchedIndicator.Normalize("unknown"), "subtle")
        end function

        @it("normalizes high contrast")
        function _()
            m.assertEqual(WatchedIndicator.Normalize(" HIGH-CONTRAST "), "high-contrast")
        end function

        @it("resolves subtle artwork")
        function _()
            m.assertEqual(WatchedIndicator.GetImageUri("subtle"), "pkg:/images/icons/watched-check.png")
        end function

        @it("resolves high contrast artwork")
        function _()
            m.assertEqual(WatchedIndicator.GetImageUri("high-contrast"), "pkg:/images/icons/watched-check-high-contrast.png")
        end function

    end class

end namespace
