namespace tests

    @suite("TVSeasonTaskResponse")
    class TVSeasonTaskResponseTests extends rooibos.BaseTestSuite

        @describe("Action")

        @it("maps Season to the task response literal")
        function _()
            m.assertEqual(TVSeasonTaskResponse.Action.Season, "tvSeason")
        end function

        @it("maps Series to the task response literal")
        function _()
            m.assertEqual(TVSeasonTaskResponse.Action.Series, "tvSeasonSeries")
        end function

        @it("maps Seasons to the task response literal")
        function _()
            m.assertEqual(TVSeasonTaskResponse.Action.Seasons, "tvSeasonSeasons")
        end function

        @it("maps Complete to the task response literal")
        function _()
            m.assertEqual(TVSeasonTaskResponse.Action.Complete, "tvSeasonComplete")
        end function

    end class

end namespace
