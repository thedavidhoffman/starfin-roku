import "pkg:/source/Remote.bs"

namespace tests

    @suite("Remote key contract")
    class RemoteTests extends rooibos.BaseTestSuite

        @describe("literal key values")

        @it("preserves the Up key value")
        function _()
            m.assertEqual(Remote.Key.Up, "up")
        end function

        @it("preserves the Down key value")
        function _()
            m.assertEqual(Remote.Key.Down, "down")
        end function

        @it("preserves the Left key value")
        function _()
            m.assertEqual(Remote.Key.Left, "left")
        end function

        @it("preserves the Right key value")
        function _()
            m.assertEqual(Remote.Key.Right, "right")
        end function

        @it("preserves the Back key value")
        function _()
            m.assertEqual(Remote.Key.Back, "back")
        end function

        @it("preserves the OK key value")
        function _()
            m.assertEqual(Remote.Key.OK, "OK")
        end function

        @it("preserves the Select key value")
        function _()
            m.assertEqual(Remote.Key.Select, "select")
        end function

        @it("preserves the Play key value")
        function _()
            m.assertEqual(Remote.Key.Play, "play")
        end function

        @it("preserves the PlayPause key value")
        function _()
            m.assertEqual(Remote.Key.PlayPause, "playpause")
        end function

        @it("preserves the Rewind key value")
        function _()
            m.assertEqual(Remote.Key.Rewind, "rewind")
        end function

        @it("preserves the FastForward key value")
        function _()
            m.assertEqual(Remote.Key.FastForward, "fastforward")
        end function

        @it("preserves the Options key value")
        function _()
            m.assertEqual(Remote.Key.Options, "options")
        end function

    end class

end namespace
