namespace tests

    @suite("Activity log helpers")
    class ActivityLogTests extends rooibos.BaseTestSuite

        @describe("ActivityLog.Quote")

        @it("quotes a readable title")
        function _()
            m.assertEqual(ActivityLog.Quote("Alien", "movie"), Chr(34) + "Alien" + Chr(34))
        end function

        @it("uses the supplied fallback for a missing title")
        function _()
            m.assertEqual(ActivityLog.Quote("", "movie"), Chr(34) + "movie" + Chr(34))
        end function

        @it("uses a fallback when request context is unavailable")
        function _()
            m.assertEqual(ActivityLog.RequestTitle(invalid, "Music"), Chr(34) + "Music" + Chr(34))
        end function

        @describe("ActivityLog.SeasonTitle")

        @it("includes the TV show and season names")
        function _()
            title = ActivityLog.SeasonTitle({ Name: "The Angry Beavers" }, { Name: "Season 1" })

            m.assertEqual(title, Chr(34) + "The Angry Beavers - Season 1" + Chr(34))
        end function

        @it("uses the season name when show metadata is unavailable")
        function _()
            title = ActivityLog.SeasonTitle(invalid, { Name: "Season 1" })

            m.assertEqual(title, Chr(34) + "Season 1" + Chr(34))
        end function

        @it("uses a readable fallback when TV metadata is unavailable")
        function _()
            title = ActivityLog.SeasonTitle(invalid, invalid)

            m.assertEqual(title, Chr(34) + "season" + Chr(34))
        end function

        @describe("ActivityLog.EpisodeTitle")

        @it("formats series, season, episode, and title")
        function _()
            item = { SeriesName: "Severance", ParentIndexNumber: 2, IndexNumber: 4, Name: "Woe's Hollow" }

            m.assertEqual(ActivityLog.EpisodeTitle(item), Chr(34) + "Severance - S02E04 - Woe's Hollow" + Chr(34))
        end function

        @it("omits unavailable identity segments")
        function _()
            m.assertEqual(ActivityLog.EpisodeTitle({ Name: "Pilot" }), Chr(34) + "Pilot" + Chr(34))
        end function

    end class

end namespace
