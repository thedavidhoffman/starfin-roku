import "pkg:/source/Char.bs"

namespace tests

    @suite("Activity log helpers")
    class ActivityLogTests extends rooibos.BaseTestSuite

        @describe("ActivityLog.Quote")

        @it("quotes a readable title")
        function _()
            m.assertEqual(ActivityLog.Quote("Alien", "movie"), Char.DoubleQuote + "Alien" + Char.DoubleQuote)
        end function

        @it("uses the supplied fallback for a missing title")
        function _()
            m.assertEqual(ActivityLog.Quote("", "movie"), Char.DoubleQuote + "movie" + Char.DoubleQuote)
        end function

        @it("uses a fallback when request context is unavailable")
        function _()
            m.assertEqual(ActivityLog.RequestTitle(invalid, "Music"), Char.DoubleQuote + "Music" + Char.DoubleQuote)
        end function

        @describe("ActivityLog.SeasonTitle")

        @it("includes the TV show and season names")
        function _()
            title = ActivityLog.SeasonTitle({ Name: "The Angry Beavers" }, { Name: "Season 1" })

            m.assertEqual(title, Char.DoubleQuote + "The Angry Beavers - Season 1" + Char.DoubleQuote)
        end function

        @it("uses the season name when show metadata is unavailable")
        function _()
            title = ActivityLog.SeasonTitle(invalid, { Name: "Season 1" })

            m.assertEqual(title, Char.DoubleQuote + "Season 1" + Char.DoubleQuote)
        end function

        @it("uses a readable fallback when TV metadata is unavailable")
        function _()
            title = ActivityLog.SeasonTitle(invalid, invalid)

            m.assertEqual(title, Char.DoubleQuote + "season" + Char.DoubleQuote)
        end function

        @describe("ActivityLog.EpisodeTitle")

        @it("formats series, season, episode, and title")
        function _()
            item = { SeriesName: "Severance", ParentIndexNumber: 2, IndexNumber: 4, Name: "Woe's Hollow" }

            m.assertEqual(ActivityLog.EpisodeTitle(item), Char.DoubleQuote + "Severance - S02E04 - Woe's Hollow" + Char.DoubleQuote)
        end function

        @it("omits unavailable identity segments")
        function _()
            m.assertEqual(ActivityLog.EpisodeTitle({ Name: "Pilot" }), Char.DoubleQuote + "Pilot" + Char.DoubleQuote)
        end function

    end class

end namespace
