import "pkg:/source/PlaybackBitrate.bs"

namespace tests

    @suite("PlaybackBitrate")
    class PlaybackBitrateTests extends rooibos.BaseTestSuite

        @describe("title limit normalization")

        @it("normalizes invalid to 0")
        function _()
            m.assertEqual(PlaybackBitrate.Normalize(invalid), 0)
        end function

        @it("normalizes 0 to 0")
        function _()
            m.assertEqual(PlaybackBitrate.Normalize(0), 0)
        end function

        @it("normalizes 2000000 to 2000000")
        function _()
            m.assertEqual(PlaybackBitrate.Normalize(2000000), 2000000)
        end function

        @it("normalizes 4000000 to 4000000")
        function _()
            m.assertEqual(PlaybackBitrate.Normalize(4000000), 4000000)
        end function

        @it("normalizes 6000000 to 6000000")
        function _()
            m.assertEqual(PlaybackBitrate.Normalize(6000000), 6000000)
        end function

        @it("normalizes 8000000 to 8000000")
        function _()
            m.assertEqual(PlaybackBitrate.Normalize(8000000), 8000000)
        end function

        @it("normalizes -1 to 0")
        function _()
            m.assertEqual(PlaybackBitrate.Normalize(-1), 0)
        end function

        @it("normalizes 10000000 to 0")
        function _()
            m.assertEqual(PlaybackBitrate.Normalize(10000000), 0)
        end function

        @it("normalizes bad to 0")
        function _()
            m.assertEqual(PlaybackBitrate.Normalize("bad"), 0)
        end function

    end class

end namespace
