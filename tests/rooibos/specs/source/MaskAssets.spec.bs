namespace tests

    @suite("Resolution-aware mask assets")
    class MaskAssetsTests extends rooibos.BaseTestSuite

        @describe("MaskAssets profiles")

        @it("selects HD mask URI and dimensions")
        function _()
            originalProfile = m.global.resolutionProfile
            if m.global.HasField("resolutionProfile") = false then m.global.AddField("resolutionProfile", "assocarray", false)
            m.global.resolutionProfile = { resolution: "hd" }

            profile = MaskAssets.GetProfile("mask.png", [300, 200], [200, 133])
            m.assertEqual(profile.uri, "pkg:/images/masks/hd/mask.png")
            m.assertEqual(profile.size, [200, 133])
            m.assertTrue(profile.isHd)

            m.global.resolutionProfile = originalProfile
        end function

        @it("selects FHD values and applies them to a mask node")
        function _()
            originalProfile = m.global.resolutionProfile
            if m.global.HasField("resolutionProfile") = false then m.global.AddField("resolutionProfile", "assocarray", false)
            m.global.resolutionProfile = { resolution: "fhd" }
            maskNode = {}

            MaskAssets.Apply(maskNode, "mask.png", [300, 200], [200, 133])
            m.assertEqual(maskNode.maskUri, "pkg:/images/masks/fhd/mask.png")
            m.assertEqual(maskNode.maskSize, [300, 200])

            m.global.resolutionProfile = originalProfile
        end function

    end class

end namespace
