import "pkg:/source/RemotePlayback.bs"

namespace tests

    @suite("RemotePlayback")
    class RemotePlaybackTests extends rooibos.BaseTestSuite

        @describe("eligibility")

        @it("accepts Movie")
        function _()
            item = { Id: "item-1", Type: "Movie" }
            selection = RemotePlayback.BuildSelection(item)

            m.assertEqual(selection.itemId, "item-1")
            m.assertEqual(selection.item, item)
            m.assertEqual(selection.loadItemDetails, true)
            m.assertInvalid(selection.startPositionTicks)
        end function

        @it("accepts Episode")
        function _()
            item = { Id: "item-1", Type: "Episode" }
            selection = RemotePlayback.BuildSelection(item)

            m.assertEqual(selection.itemId, "item-1")
            m.assertEqual(selection.item, item)
            m.assertEqual(selection.loadItemDetails, true)
            m.assertInvalid(selection.startPositionTicks)
        end function

        @it("accepts Video")
        function _()
            item = { Id: "item-1", Type: "Video" }
            selection = RemotePlayback.BuildSelection(item)

            m.assertEqual(selection.itemId, "item-1")
            m.assertEqual(selection.item, item)
            m.assertEqual(selection.loadItemDetails, true)
            m.assertInvalid(selection.startPositionTicks)
        end function

        @it("accepts MusicVideo")
        function _()
            item = { Id: "item-1", Type: "MusicVideo" }
            selection = RemotePlayback.BuildSelection(item)

            m.assertEqual(selection.itemId, "item-1")
            m.assertEqual(selection.item, item)
            m.assertEqual(selection.loadItemDetails, true)
            m.assertInvalid(selection.startPositionTicks)
        end function

        @it("accepts MusicAlbum")
        function _()
            item = { Id: "item-1", Type: "MusicAlbum" }
            selection = RemotePlayback.BuildSelection(item)

            m.assertEqual(selection.itemId, "item-1")
            m.assertEqual(selection.item, item)
            m.assertEqual(selection.loadItemDetails, false)
            m.assertInvalid(selection.startPositionTicks)
        end function

        @it("excludes CollectionFolder")
        function _()
            m.assertInvalid(RemotePlayback.BuildSelection({ Id: "item-1", Type: "CollectionFolder" }))
        end function

        @it("excludes BoxSet")
        function _()
            m.assertInvalid(RemotePlayback.BuildSelection({ Id: "item-1", Type: "BoxSet" }))
        end function

        @it("excludes Folder")
        function _()
            m.assertInvalid(RemotePlayback.BuildSelection({ Id: "item-1", Type: "Folder" }))
        end function

        @it("excludes Series")
        function _()
            m.assertInvalid(RemotePlayback.BuildSelection({ Id: "item-1", Type: "Series" }))
        end function

        @it("excludes Season")
        function _()
            m.assertInvalid(RemotePlayback.BuildSelection({ Id: "item-1", Type: "Season" }))
        end function

        @it("excludes MusicArtist")
        function _()
            m.assertInvalid(RemotePlayback.BuildSelection({ Id: "item-1", Type: "MusicArtist" }))
        end function

        @it("excludes Playlist")
        function _()
            m.assertInvalid(RemotePlayback.BuildSelection({ Id: "item-1", Type: "Playlist" }))
        end function

        @it("excludes Photo")
        function _()
            m.assertInvalid(RemotePlayback.BuildSelection({ Id: "item-1", Type: "Photo" }))
        end function

        @it("excludes PhotoAlbum")
        function _()
            m.assertInvalid(RemotePlayback.BuildSelection({ Id: "item-1", Type: "PhotoAlbum" }))
        end function

        @it("excludes Audio")
        function _()
            m.assertInvalid(RemotePlayback.BuildSelection({ Id: "item-1", Type: "Audio" }))
        end function

        @it("rejects missing IDs")
        function _()
            m.assertInvalid(RemotePlayback.BuildSelection({ Type: "Movie" }))
        end function

        @it("rejects missing media")
        function _()
            m.assertInvalid(RemotePlayback.BuildSelection({ Id: "movie-1", Type: "Movie", IsMissing: true }))
        end function

        @it("rejects virtual media")
        function _()
            m.assertInvalid(RemotePlayback.BuildSelection({ Id: "episode-1", Type: "Episode", IsVirtualItem: true }))
        end function

    end class

end namespace
