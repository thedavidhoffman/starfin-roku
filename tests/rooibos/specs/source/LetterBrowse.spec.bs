namespace tests

    @suite("Letter browse helpers")
    class LetterBrowseTests extends rooibos.BaseTestSuite

        @describe("sorting")

        @it("sorts items by sort name ascending")
        function _()
            items = [{ Name: "Zulu" }, { Name: "Display", SortName: "Alpha" }]

            result = LetterBrowse.SortItems(items, "Ascending")

            m.assertEqual(result[0].Name, "Display")
            m.assertEqual(result[1].Name, "Zulu")
        end function

        @it("sorts items by sort name descending")
        function _()
            items = [{ Name: "Zulu" }, { Name: "Alpha" }]

            result = LetterBrowse.SortItems(items, "Descending")

            m.assertEqual(result[0].Name, "Zulu")
            m.assertEqual(result[1].Name, "Alpha")
        end function

        @describe("paging")

        @it("returns a bounded page")
        function _()
            result = LetterBrowse.GetPage([0, 1, 2, 3], 1, 2)

            m.assertEqual(result, [1, 2])
        end function

        @it("returns a partial final page")
        function _()
            result = LetterBrowse.GetPage([0, 1, 2], 2, 2)

            m.assertEqual(result, [2])
        end function

        @it("returns an empty page beyond the item count")
        function _()
            result = LetterBrowse.GetPage([0, 1], 2, 2)

            m.assertEqual(result, [])
        end function

    end class

end namespace
