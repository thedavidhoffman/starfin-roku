import "pkg:/source/Char.bs"

namespace tests

    @suite("Logger class")
    class LoggerTests extends rooibos.BaseTestSuite

        @describe("public logging behavior")

        @it("collects normal writes and errors but excludes console-only writes")
        function _()
            collector = CreateObject("roSGNode", "LogService")
            log = new Logger("LoggerTest", collector)

            log.write("normal message")
            log.error("failed message")
            log.writeConsoleOnly("private message")
            log.writeJsonConsoleOnly("{" + Char.DoubleQuote + "Private" + Char.DoubleQuote + ":true}")

            entries = collector.callFunc("getSnapshot")
            m.assertEqual(entries.Count(), 2)
            m.assertTrue(Instr(1, entries[0], "[LoggerTest] normal message") > 0)
            m.assertTrue(Instr(1, entries[1], "[LoggerTest] ERROR: failed message") > 0)
        end function

        @it("collects activity with the component label and searchable prefix")
        function _()
            collector = CreateObject("roSGNode", "LogService")
            log = new Logger("Movie", collector)

            result = log.activity("Viewing movie " + Char.DoubleQuote + "Alien" + Char.DoubleQuote)

            entries = collector.callFunc("getSnapshot")
            m.assertEqual(entries.Count(), 1)
            m.assertEqual(Mid(entries[0], 3, 1), "/")
            m.assertEqual(Mid(entries[0], 6, 1), " ")
            m.assertEqual(Mid(entries[0], 9, 1), ":")
            m.assertEqual(Mid(entries[0], 12, 1), ":")
            m.assertTrue(Instr(1, entries[0], "[Movie] Activity: Viewing movie " + Char.DoubleQuote + "Alien" + Char.DoubleQuote) > 0)
            m.assertEqual(result, log)
        end function

        @it("collects formatted JSON as one multiline entry with a heading")
        function _()
            collector = CreateObject("roSGNode", "LogService")
            log = new Logger("LoggerTest", collector)
            escapedText = "A\" + Char.DoubleQuote + "B"
            jsonText = "{" + Char.DoubleQuote + "Name" + Char.DoubleQuote + ":" + Char.DoubleQuote + escapedText + Char.DoubleQuote + "," + Char.DoubleQuote + "Values" + Char.DoubleQuote + ":[1,2]}"

            log.writeJson(jsonText, 2, "Request body:")

            entries = collector.callFunc("getSnapshot")
            m.assertEqual(entries.Count(), 1)
            m.assertTrue(Instr(1, entries[0], "[LoggerTest] Request body:") > 0)
            m.assertTrue(Instr(1, entries[0], Char.NewLine + "    {") > 0)
            m.assertTrue(Instr(1, entries[0], Char.NewLine + "      " + Char.DoubleQuote + "Name" + Char.DoubleQuote + ": " + Char.DoubleQuote + escapedText + Char.DoubleQuote + ",") > 0)
            m.assertTrue(Instr(1, entries[0], Char.NewLine + "      " + Char.DoubleQuote + "Values" + Char.DoubleQuote + ":[") > 0)
            m.assertTrue(Instr(1, entries[0], Char.NewLine + "        1,") > 0)
            m.assertTrue(Instr(1, entries[0], Char.NewLine + "        2") > 0)
        end function

        @it("writes only to the collector injected into the constructor")
        function _()
            injectedCollector = CreateObject("roSGNode", "LogService")
            unrelatedCollector = CreateObject("roSGNode", "LogService")
            log = new Logger("InjectedLogger", injectedCollector)

            log.write("injected message")

            m.assertEqual(injectedCollector.callFunc("getSnapshot").Count(), 1)
            m.assertEqual(unrelatedCollector.callFunc("getSnapshot").Count(), 0)
        end function

        @it("continues console logging when the injected collector is invalid")
        function _()
            log = new Logger("ConsoleLogger", invalid)
            result = log.write("console message")
            m.assertNotInvalid(result)
        end function

    end class

end namespace
