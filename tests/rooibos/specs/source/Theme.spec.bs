namespace tests

    @suite("Theme values")
    class ThemeTests extends rooibos.BaseTestSuite

        @describe("Theme selection")

        @it("returns the default theme and required color groups")
        function _()
            themeValues = Theme.Get()
            m.assertNotInvalid(themeValues.background)
            m.assertNotInvalid(themeValues.text)
            m.assertNotInvalid(themeValues.accent)
            m.assertNotInvalid(themeValues.control)
            m.assertEqual(themeValues.background.header, &h12112BFF)
            m.assertEqual(themeValues.text.light.primary, &hF3F7FBFF)
            m.assertEqual(themeValues.accent.primary, &hE09B42FF)
            m.assertEqual(themeValues.control.inputFocus, &h21405EFF)
        end function

        @it("falls back to the default theme for unknown names")
        function _()
            m.assertEqual(Theme.Get("Unknown"), Theme.Get("Default"))
        end function

    end class

end namespace
