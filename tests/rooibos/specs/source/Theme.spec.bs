namespace tests

    @suite("Theme values")
    class ThemeTests extends rooibos.BaseTestSuite

        protected override function beforeEach()
            m.originalProfile = m.global.resolutionProfile
            if not m.global.hasField("resolutionProfile") then m.global.addField("resolutionProfile", "assocarray", false)
            m.global.resolutionProfile = { resolution: "fhd" }
        end function

        protected override function afterEach()
            m.global.resolutionProfile = m.originalProfile
        end function

        @describe("Account badge palette")

        @it("provides the blue badge palette")
        function _()
            palette = Theme.AccountBadge("blue")

            m.assertEqual(palette.background, &h12112BFF)
            m.assertEqual(palette.ring, &h010D29FF)
            m.assertEqual(palette.glass, &hE1E8F7FF)
        end function

        @it("provides the black badge palette")
        function _()
            palette = Theme.AccountBadge("black")

            m.assertEqual(palette.background, &h0B0B0BFF)
            m.assertEqual(palette.ring, &h121212FF)
            m.assertEqual(palette.glass, &hE8E8E8FF)
        end function

        @it("provides the grey badge palette")
        function _()
            palette = Theme.AccountBadge("grey")

            m.assertEqual(palette.background, &h2D2C2CFF)
            m.assertEqual(palette.ring, &h343434FF)
            m.assertEqual(palette.glass, &hE8E8E8FF)
        end function

        @it("provides the unknown badge palette")
        function _()
            palette = Theme.AccountBadge("unknown")

            m.assertEqual(palette.background, &h12112BFF)
            m.assertEqual(palette.ring, &h010D29FF)
            m.assertEqual(palette.glass, &hE1E8F7FF)
        end function

        @describe("Square button palette")

        @it("resolves blue square button palette")
        function _()
            palette = Theme.SquareButton("blue")

            m.assertEqual(palette.backgroundUri, "pkg:/images/themes/blue/square-button-background.png")
            m.assertEqual(palette.wideFill, &h092452FF)
            m.assertEqual(palette.focusedText, &h0F1A2AFF)
            m.assertEqual(palette.text, &hF3F7FBFF)
        end function

        @it("resolves black square button palette")
        function _()
            palette = Theme.SquareButton("black")

            m.assertEqual(palette.backgroundUri, "pkg:/images/themes/black/square-button-background.png")
            m.assertEqual(palette.wideFill, &h262626FF)
            m.assertEqual(palette.focusedText, &h121212FF)
            m.assertEqual(palette.text, &hF3F7FBFF)
        end function

        @it("resolves grey square button palette")
        function _()
            palette = Theme.SquareButton("grey")

            m.assertEqual(palette.backgroundUri, "pkg:/images/themes/grey/square-button-background.png")
            m.assertEqual(palette.wideFill, &h4A4A4AFF)
            m.assertEqual(palette.focusedText, &h242424FF)
            m.assertEqual(palette.text, &hF3F7FBFF)
        end function

        @it("resolves unknown square button palette")
        function _()
            palette = Theme.SquareButton("unknown")

            m.assertEqual(palette.backgroundUri, "pkg:/images/themes/blue/square-button-background.png")
            m.assertEqual(palette.wideFill, &h092452FF)
            m.assertEqual(palette.focusedText, &h0F1A2AFF)
            m.assertEqual(palette.text, &hF3F7FBFF)
        end function

        @describe("Dialog panels")

        @it("resolves blue dialog panel for fhd")
        function _()
            m.global.resolutionProfile = { resolution: "fhd" }

            m.assertEqual(Theme.DialogPanelUri("blue"), "pkg:/images/themes/blue/fhd/dialog-panel.9.png")
        end function

        @it("resolves blue dialog panel for hd")
        function _()
            m.global.resolutionProfile = { resolution: "hd" }

            m.assertEqual(Theme.DialogPanelUri("blue"), "pkg:/images/themes/blue/hd/dialog-panel.9.png")
        end function

        @it("resolves black dialog panel for fhd")
        function _()
            m.global.resolutionProfile = { resolution: "fhd" }

            m.assertEqual(Theme.DialogPanelUri("black"), "pkg:/images/themes/black/fhd/dialog-panel.9.png")
        end function

        @it("resolves black dialog panel for hd")
        function _()
            m.global.resolutionProfile = { resolution: "hd" }

            m.assertEqual(Theme.DialogPanelUri("black"), "pkg:/images/themes/black/hd/dialog-panel.9.png")
        end function

        @it("resolves grey dialog panel for fhd")
        function _()
            m.global.resolutionProfile = { resolution: "fhd" }

            m.assertEqual(Theme.DialogPanelUri("grey"), "pkg:/images/themes/grey/fhd/dialog-panel.9.png")
        end function

        @it("resolves grey dialog panel for hd")
        function _()
            m.global.resolutionProfile = { resolution: "hd" }

            m.assertEqual(Theme.DialogPanelUri("grey"), "pkg:/images/themes/grey/hd/dialog-panel.9.png")
        end function

        @it("resolves unknown dialog panel for fhd")
        function _()
            m.global.resolutionProfile = { resolution: "fhd" }

            m.assertEqual(Theme.DialogPanelUri("unknown"), "pkg:/images/themes/blue/fhd/dialog-panel.9.png")
        end function

        @it("resolves unknown dialog panel for hd")
        function _()
            m.global.resolutionProfile = { resolution: "hd" }

            m.assertEqual(Theme.DialogPanelUri("unknown"), "pkg:/images/themes/blue/hd/dialog-panel.9.png")
        end function

        @describe("Theme selection")

        @it("normalizes blue regardless of case")
        function _()
            m.assertEqual(Theme.Normalize("BLUE"), "blue")
        end function

        @it("normalizes black regardless of case")
        function _()
            m.assertEqual(Theme.Normalize("BLACK"), "black")
        end function

        @it("normalizes grey regardless of case")
        function _()
            m.assertEqual(Theme.Normalize("GREY"), "grey")
        end function

        @it("defaults missing preferences to blue")
        function _()
            m.assertEqual(Theme.Normalize(invalid), "blue")
        end function

        @it("defaults unsupported preferences to blue")
        function _()
            m.assertEqual(Theme.Normalize("unknown"), "blue")
        end function

        @it("provides the background color for blue")
        function _()
            m.assertEqual(Theme.BackgroundColor("blue"), &h000000FF)
        end function

        @it("provides the background color for black")
        function _()
            m.assertEqual(Theme.BackgroundColor("black"), &h121212FF)
        end function

        @it("provides the background color for grey")
        function _()
            m.assertEqual(Theme.BackgroundColor("grey"), &h343434FF)
        end function

        @it("provides the background color for unknown")
        function _()
            m.assertEqual(Theme.BackgroundColor("unknown"), &h000000FF)
        end function

        @it("provides the gradient image for blue")
        function _()
            m.assertEqual(Theme.BackgroundUri("blue"), "pkg:/images/themes/blue/background.png")
        end function

        @it("provides the gradient image for black")
        function _()
            m.assertEqual(Theme.BackgroundUri("black"), "pkg:/images/themes/black/background.png")
        end function

        @it("provides the gradient image for grey")
        function _()
            m.assertEqual(Theme.BackgroundUri("grey"), "pkg:/images/themes/grey/background.png")
        end function

        @it("provides the gradient image for unknown")
        function _()
            m.assertEqual(Theme.BackgroundUri("unknown"), "pkg:/images/themes/blue/background.png")
        end function

        @it("resolves blue menu assets for fhd")
        function _()
            m.global.resolutionProfile = { resolution: "fhd" }

            palette = Theme.HeaderMenu("blue")

            m.assertEqual(palette.fillUri, "pkg:/images/themes/blue/fhd/header-menu-fill.9.png")
            m.assertEqual(palette.glassUri, "pkg:/images/themes/blue/fhd/header-menu-glass.9.png")
            m.assertEqual(palette.focusedText, &h12112BFF)
        end function

        @it("resolves blue menu assets for hd")
        function _()
            m.global.resolutionProfile = { resolution: "hd" }

            palette = Theme.HeaderMenu("blue")

            m.assertEqual(palette.fillUri, "pkg:/images/themes/blue/hd/header-menu-fill.9.png")
            m.assertEqual(palette.glassUri, "pkg:/images/themes/blue/hd/header-menu-glass.9.png")
            m.assertEqual(palette.focusedText, &h12112BFF)
        end function

        @it("resolves black menu assets for fhd")
        function _()
            m.global.resolutionProfile = { resolution: "fhd" }

            palette = Theme.HeaderMenu("black")

            m.assertEqual(palette.fillUri, "pkg:/images/themes/black/fhd/header-menu-fill.9.png")
            m.assertEqual(palette.glassUri, "pkg:/images/themes/black/fhd/header-menu-glass.9.png")
            m.assertEqual(palette.focusedText, &h121212FF)
        end function

        @it("resolves black menu assets for hd")
        function _()
            m.global.resolutionProfile = { resolution: "hd" }

            palette = Theme.HeaderMenu("black")

            m.assertEqual(palette.fillUri, "pkg:/images/themes/black/hd/header-menu-fill.9.png")
            m.assertEqual(palette.glassUri, "pkg:/images/themes/black/hd/header-menu-glass.9.png")
            m.assertEqual(palette.focusedText, &h121212FF)
        end function

        @it("resolves grey menu assets for fhd")
        function _()
            m.global.resolutionProfile = { resolution: "fhd" }

            palette = Theme.HeaderMenu("grey")

            m.assertEqual(palette.fillUri, "pkg:/images/themes/grey/fhd/header-menu-fill.9.png")
            m.assertEqual(palette.glassUri, "pkg:/images/themes/grey/fhd/header-menu-glass.9.png")
            m.assertEqual(palette.focusedText, &h242424FF)
        end function

        @it("resolves grey menu assets for hd")
        function _()
            m.global.resolutionProfile = { resolution: "hd" }

            palette = Theme.HeaderMenu("grey")

            m.assertEqual(palette.fillUri, "pkg:/images/themes/grey/hd/header-menu-fill.9.png")
            m.assertEqual(palette.glassUri, "pkg:/images/themes/grey/hd/header-menu-glass.9.png")
            m.assertEqual(palette.focusedText, &h242424FF)
        end function

        @it("returns the default theme and required color groups")
        function _()
            themeValues = Theme.Get()
            m.assertNotInvalid(themeValues.background)
            m.assertNotInvalid(themeValues.text)
            m.assertNotInvalid(themeValues.accent)
            m.assertNotInvalid(themeValues.control)
            m.assertEqual(themeValues.background.header, &h12112BFF)
            m.assertEqual(themeValues.text.light.primary, &hF3F7FBFF)
            m.assertEqual(themeValues.accent.primary, &hE09B42FF)
            m.assertEqual(themeValues.control.inputFocus, &h21405EFF)
        end function

        @it("falls back to the default theme for unknown names")
        function _()
            m.assertEqual(Theme.Get("Unknown"), Theme.Get("Default"))
        end function

    end class

end namespace
