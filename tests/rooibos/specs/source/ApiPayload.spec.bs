namespace tests

    @suite("API payload helpers")
    class ApiPayloadTests extends rooibos.BaseTestSuite

        @describe("item normalization")

        @it("returns an empty array for an invalid payload")
        function _()
            result = ApiPayload.GetItems(invalid)

            m.assertEqual(result, [])
        end function

        @it("returns an array payload unchanged")
        function _()
            payload = [{ Id: "item-1" }]

            result = ApiPayload.GetItems(payload)

            m.assertEqual(result, payload)
        end function

        @it("returns the Items array from an API response payload")
        function _()
            items = [{ Id: "item-1" }]

            result = ApiPayload.GetItems({ Items: items })

            m.assertEqual(result, items)
        end function

        @it("returns an empty array when Items is missing")
        function _()
            result = ApiPayload.GetItems({ TotalRecordCount: 0 })

            m.assertEqual(result, [])
        end function

        @it("returns an empty array when Items is not an array")
        function _()
            result = ApiPayload.GetItems({ Items: "invalid" })

            m.assertEqual(result, [])
        end function

        @it("returns an empty array for an unrelated payload type")
        function _()
            result = ApiPayload.GetItems("invalid")

            m.assertEqual(result, [])
        end function

    end class

end namespace
