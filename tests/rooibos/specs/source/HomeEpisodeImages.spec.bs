import "pkg:/source/HomeEpisodeImages.bs"

namespace tests

    @suite("Home episode image modes")
    class HomeEpisodeImagesTests extends rooibos.BaseTestSuite

        @describe("normalization")

        @it("preserves off")
        function _()
            m.assertEqual(HomeEpisodeImages.Normalize("off"), "off")
        end function

        @it("preserves logos")
        function _()
            m.assertEqual(HomeEpisodeImages.Normalize("on-with-logo"), "on-with-logo")
        end function

        @it("preserves no logos")
        function _()
            m.assertEqual(HomeEpisodeImages.Normalize("on-without-logo"), "on-without-logo")
        end function

        @it("maps legacy on to logos")
        function _()
            m.assertEqual(HomeEpisodeImages.Normalize("on"), "on-with-logo")
        end function

        @it("accepts uppercase")
        function _()
            m.assertEqual(HomeEpisodeImages.Normalize("ON-WITHOUT-LOGO"), "on-without-logo")
        end function

        @it("defaults invalid to off")
        function _()
            m.assertEqual(HomeEpisodeImages.Normalize(invalid), "off")
        end function

        @it("defaults empty to off")
        function _()
            m.assertEqual(HomeEpisodeImages.Normalize(""), "off")
        end function

        @it("defaults unknown to off")
        function _()
            m.assertEqual(HomeEpisodeImages.Normalize("unknown"), "off")
        end function

    end class

end namespace
