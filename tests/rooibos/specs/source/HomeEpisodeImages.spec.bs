import "pkg:/source/HomeEpisodeImages.bs"

namespace tests

    @suite("Home episode image modes")
    class HomeEpisodeImagesTests extends rooibos.BaseTestSuite

        @describe("normalization")

        @it("preserves series")
        function _()
            m.assertEqual(HomeEpisodeImages.Normalize("series"), "series")
        end function

        @it("preserves logos")
        function _()
            m.assertEqual(HomeEpisodeImages.Normalize("episode-with-logo"), "episode-with-logo")
        end function

        @it("preserves no logos")
        function _()
            m.assertEqual(HomeEpisodeImages.Normalize("episode-without-logo"), "episode-without-logo")
        end function

        @it("uses series for unsupported legacy values")
        function _()
            m.assertEqual(HomeEpisodeImages.Normalize("on"), "series")
        end function

        @it("accepts uppercase")
        function _()
            m.assertEqual(HomeEpisodeImages.Normalize("EPISODE-WITHOUT-LOGO"), "episode-without-logo")
        end function

        @it("defaults invalid to series")
        function _()
            m.assertEqual(HomeEpisodeImages.Normalize(invalid), "series")
        end function

        @it("defaults empty to series")
        function _()
            m.assertEqual(HomeEpisodeImages.Normalize(""), "series")
        end function

        @it("defaults unknown to series")
        function _()
            m.assertEqual(HomeEpisodeImages.Normalize("unknown"), "series")
        end function

    end class

end namespace
