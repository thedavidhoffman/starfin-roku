namespace tests

    @suite("Jellyfin movie metadata")
    class JellyfinmoviemetadataTests extends rooibos.BaseTestSuite

        @describe("request and response behavior")

        @it("requests trailer metadata with movie details")
        function _()
            m.stubCall(HttpClient.Request, function(requestUrl, method, token, body, headers)
                getGlobalAa().trailerMovieUrl = requestUrl
                return { ok: true, data: { Id: "movie" } }
            end function)
            result = JellyfinMovie.Load({ server: "https://server", token: "token", userId: "user", itemId: "movie" })
            m.assertTrue(result.ok)
            m.assertTrue(Instr(1, getGlobalAa().trailerMovieUrl, "RemoteTrailers") > 0)
        end function

    end class

end namespace
