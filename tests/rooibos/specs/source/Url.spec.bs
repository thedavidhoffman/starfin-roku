namespace tests

    @suite("URL helpers")
    class UrlTests extends rooibos.BaseTestSuite

        @describe("Url.NormalizeServer")

        @it("adds the default scheme and removes trailing slashes")
        function _()
            m.assertEqual(Url.NormalizeServer(" jellyfin.example.com/// "), "http://jellyfin.example.com")
        end function

        @it("preserves an existing HTTP or HTTPS scheme (case 1)")
        function _()
            m.assertEqual(Url.NormalizeServer("HTTP://server.local/"), "HTTP://server.local")
        end function

        @it("preserves an existing HTTP or HTTPS scheme (case 2)")
        function _()
            m.assertEqual(Url.NormalizeServer("https://server.local"), "https://server.local")
        end function

        @it("returns an empty string for an empty server")
        function _()
            m.assertEqual(Url.NormalizeServer("   "), "")
        end function

        @describe("Url.BuildQueryString")

        @it("returns an empty string for invalid or empty parameters (case 1)")
        function _()
            m.assertEqual(Url.BuildQueryString(invalid), "")
        end function

        @it("returns an empty string for invalid or empty parameters (case 2)")
        function _()
            m.assertEqual(Url.BuildQueryString({}), "")
        end function

        @it("encodes parameter names and values")
        function _()
            m.assertEqual(Url.BuildQueryString({ "search term": "science fiction" }), "?search%20term=science%20fiction")
        end function

        @it("serializes boolean values and omits empty values (case 1)")
        function _()
            m.assertEqual(Url.BuildQueryString({ enabled: true }), "?enabled=true")
        end function

        @it("serializes boolean values and omits empty values (case 2)")
        function _()
            m.assertEqual(Url.BuildQueryString({ enabled: false }), "?enabled=false")
        end function

        @it("serializes boolean values and omits empty values (case 3)")
        function _()
            m.assertEqual(Url.BuildQueryString({ empty: "" }), "")
        end function

        @describe("Url.BuildImageUrl")

        @it("builds an image URL without a tag")
        function _()
            result = Url.BuildImageUrl("server.local/", "item-1", "Primary", "", 300, 200)
            m.assertEqual(result, "http://server.local/Items/item-1/Images/Primary?maxWidth=300&maxHeight=200&quality=90")
        end function

        @it("includes the tag and optional image parameters")
        function _()
            result = Url.BuildImageUrl("https://server.local", "item-1", "Backdrop", "tag-1", 1920, 1080, { format: "Png" })
            m.assertEqual(result, "https://server.local/Items/item-1/Images/Backdrop?tag=tag-1&maxWidth=1920&maxHeight=1080&quality=90&format=Png")
        end function

        @it("returns an empty string when required values are missing (case 1)")
        function _()
            m.assertEqual(Url.BuildImageUrl("", "item-1", "Primary", "", 300, 200), "")
        end function

        @it("returns an empty string when required values are missing (case 2)")
        function _()
            m.assertEqual(Url.BuildImageUrl("server.local", "", "Primary", "", 300, 200), "")
        end function

        @it("returns an empty string when required values are missing (case 3)")
        function _()
            m.assertEqual(Url.BuildImageUrl("server.local", "item-1", "", "", 300, 200), "")
        end function

        @describe("URL resolution and origins")

        @it("resolves a root-relative media path beneath the server base")
        function _()
            m.assertEqual(Url.Resolve("https://server/base/", "/stream"), "https://server/base/stream")
        end function

        @it("resolves a relative media path beneath the server base")
        function _()
            m.assertEqual(Url.Resolve("https://server/base/", "stream"), "https://server/base/stream")
        end function

        @it("preserves an absolute external URL")
        function _()
            m.assertEqual(Url.Resolve("https://server", "https://cdn.test/stream"), "https://cdn.test/stream")
        end function

        @it("resolves network-relative URLs without changing their host")
        function _()
            m.assertEqual(Url.Resolve("https://server/base", "//cdn.test/master.m3u8"), "https://cdn.test/master.m3u8")
        end function

        @it("preserves empty media URLs")
        function _()
            m.assertEqual(Url.Resolve("https://server", ""), "")
        end function

        @it("preserves non-HTTP schemes")
        function _()
            m.assertEqual(Url.Resolve("https://server", "tmp:/tile.jpg"), "tmp:/tile.jpg")
        end function

        @it("normalizes HTTPS origins")
        function _()
            m.assertEqual(Url.GetOrigin("https://SERVER:443/base?q=1#f"), "https://server")
        end function

        @it("normalizes HTTP origins")
        function _()
            m.assertEqual(Url.GetOrigin("http://SERVER:80/base"), "http://server")
        end function

        @it("retains non-default origin ports")
        function _()
            m.assertEqual(Url.GetOrigin("https://server:8443/path"), "https://server:8443")
        end function

        @it("rejects non-HTTP authentication origins")
        function _()
            m.assertEqual(Url.GetOrigin("tmp:/tile.jpg"), "")
        end function

        @it("rejects origins containing user information")
        function _()
            m.assertEqual(Url.GetOrigin("https://user@server/path"), "")
        end function

    end class

end namespace
