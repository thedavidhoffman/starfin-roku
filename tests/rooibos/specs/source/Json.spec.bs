import "pkg:/source/Char.bs"

namespace tests

    @suite("JSON helpers")
    class JsonTests extends rooibos.BaseTestSuite

        @describe("Json.String")

        @it("quotes strings and escapes backslashes and quotation marks")
        function _()
            quote = Char.DoubleQuote
            m.assertEqual(Json.String("C:\path"), quote + "C:\\path" + quote)
            m.assertEqual(Json.String("A" + quote + "B"), quote + "A\" + quote + "B" + quote)
        end function

        @describe("JSON pairs")

        @it("preserves field-name casing in string pairs")
        function _()
            m.assertEqual(Json.Pair("DeviceId", "roku-1"), Char.DoubleQuote + "DeviceId" + Char.DoubleQuote + ":" + Char.DoubleQuote + "roku-1" + Char.DoubleQuote)
        end function

        @it("serializes boolean pairs (case 1)")
        function _()
            m.assertEqual(Json.BooleanPair("Enabled", true), Char.DoubleQuote + "Enabled" + Char.DoubleQuote + ":true")
        end function

        @it("serializes boolean pairs (case 2)")
        function _()
            m.assertEqual(Json.BooleanPair("Enabled", false), Char.DoubleQuote + "Enabled" + Char.DoubleQuote + ":false")
        end function

        @it("serializes number pairs (case 1)")
        function _()
            m.assertEqual(Json.NumberPair("Count", 42), Char.DoubleQuote + "Count" + Char.DoubleQuote + ":42")
        end function

        @it("serializes number pairs (case 2)")
        function _()
            m.assertEqual(Json.NumberPair("Count", invalid), Char.DoubleQuote + "Count" + Char.DoubleQuote + ":0")
        end function

        @describe("JSON collections")

        @it("serializes string arrays and invalid arrays (case 1)")
        function _()
            m.assertEqual(Json.ArrayPair("Values", ["one", "two"]), Char.DoubleQuote + "Values" + Char.DoubleQuote + ":[" + Char.DoubleQuote + "one" + Char.DoubleQuote + "," + Char.DoubleQuote + "two" + Char.DoubleQuote + "]")
        end function

        @it("serializes string arrays and invalid arrays (case 2)")
        function _()
            m.assertEqual(Json.ArrayPair("Values", invalid), Char.DoubleQuote + "Values" + Char.DoubleQuote + ":[]")
        end function

        @it("builds nested objects from pre-serialized parts")
        function _()
            parts = [Json.Pair("Name", "Starfin"), Json.BooleanPair("Active", true)]
            result = Json.ObjectPair("Client", parts)
            m.assertEqual(result, Char.DoubleQuote + "Client" + Char.DoubleQuote + ":{" + Char.DoubleQuote + "Name" + Char.DoubleQuote + ":" + Char.DoubleQuote + "Starfin" + Char.DoubleQuote + "," + Char.DoubleQuote + "Active" + Char.DoubleQuote + ":true}")
        end function

        @it("joins parts and handles empty collections (case 1)")
        function _()
            m.assertEqual(Json.JoinParts(["one", "two", "three"]), "one,two,three")
        end function

        @it("joins parts and handles empty collections (case 2)")
        function _()
            m.assertEqual(Json.JoinParts([]), "")
        end function

        @it("joins parts and handles empty collections (case 3)")
        function _()
            m.assertEqual(Json.JoinParts(invalid), "")
        end function

        @it("joins parts and handles empty collections (case 4)")
        function _()
            m.assertEqual(Json.Object([]), "{}")
        end function

        @describe("Json.Number")

        @it("normalizes separators, invalid values, and exponent notation (case 1)")
        function _()
            m.assertEqual(Json.Number("1,234.5"), "1234.5")
        end function

        @it("normalizes separators, invalid values, and exponent notation (case 2)")
        function _()
            m.assertEqual(Json.Number(invalid), "0")
        end function

        @it("normalizes separators, invalid values, and exponent notation (case 3)")
        function _()
            m.assertEqual(Json.Number("1.25e3"), "1250")
        end function

        @it("normalizes separators, invalid values, and exponent notation (case 4)")
        function _()
            m.assertEqual(Json.Number("-2.5e-2"), "-0.025")
        end function

    end class

end namespace
