namespace tests

    @suite("Performance beacon state")
    class PerformanceBeaconTests extends rooibos.BaseTestSuite

        @describe("dialog and launch sequencing")

        @it("emits one matching authentication dialog pair")
        function _()
            state = PerformanceBeacon.Create()

            m.assertEqual(PerformanceBeacon.BeginDialog(state), "AppDialogInitiate")
            m.assertEqual(PerformanceBeacon.BeginDialog(state), "")
            m.assertEqual(PerformanceBeacon.CompleteDialog(state), "AppDialogComplete")
            m.assertEqual(PerformanceBeacon.CompleteDialog(state), "")
        end function

        @it("emits launch completion exactly once")
        function _()
            state = PerformanceBeacon.Create()

            m.assertEqual(PerformanceBeacon.CompleteLaunch(state), "AppLaunchComplete")
            m.assertEqual(PerformanceBeacon.CompleteLaunch(state), "")
        end function

        @it("does not begin runtime dialogs after launch completion")
        function _()
            state = PerformanceBeacon.Create()
            PerformanceBeacon.CompleteLaunch(state)

            m.assertEqual(PerformanceBeacon.BeginDialog(state), "")
        end function

    end class

end namespace
