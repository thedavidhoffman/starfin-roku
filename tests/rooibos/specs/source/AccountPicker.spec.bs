namespace tests

    @suite("Account picker server layouts")
    class AccountPickerTests extends rooibos.BaseTestSuite

        @describe("normalized server identity")

        @it("uses horizontal layout for an empty list")
        function _()
            m.assertFalse(AccountPicker.HasMultipleServers([]))
        end function

        @it("uses horizontal layout before accounts are assigned")
        function _()
            m.assertFalse(AccountPicker.HasMultipleServers(invalid))
        end function

        @it("uses horizontal layout for a single account")
        function _()
            m.assertFalse(AccountPicker.HasMultipleServers([{ server: "http://one" }]))
        end function

        @it("normalizes case and trailing slashes before comparing servers")
        function _()
            m.assertFalse(AccountPicker.HasMultipleServers([{ server: "http://One/" }, { server: "http://one" }]))
        end function

        @it("uses vertical layout for distinct server addresses")
        function _()
            m.assertTrue(AccountPicker.HasMultipleServers([{ server: "http://one" }, { server: "http://two" }]))
        end function

        @it("keeps distinct server ports separate")
        function _()
            m.assertTrue(AccountPicker.HasMultipleServers([{ server: "http://one:8096" }, { server: "http://one:8097" }]))
        end function

        @it("preserves path case when distinguishing servers")
        function _()
            m.assertTrue(AccountPicker.HasMultipleServers([{ server: "https://one/A" }, { server: "https://one/a" }]))
        end function

        @it("keeps different schemes distinct")
        function _()
            m.assertTrue(AccountPicker.HasMultipleServers([{ server: "http://one" }, { server: "https://one" }]))
        end function

    end class

end namespace
