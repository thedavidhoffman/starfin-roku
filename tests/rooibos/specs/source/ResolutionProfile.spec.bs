namespace tests

    @suite("Resolution profile helpers")
    class ResolutionProfileTests extends rooibos.BaseTestSuite

        @describe("ResolutionProfile selection")

        @it("reads HD and FHD profiles from the global node")
        function _()
            originalProfile = m.global.resolutionProfile
            if m.global.HasField("resolutionProfile") = false then m.global.AddField("resolutionProfile", "assocarray", false)

            m.global.resolutionProfile = { resolution: "hd" }
            m.assertEqual(ResolutionProfile.GetName(), "hd")
            m.assertTrue(ResolutionProfile.IsHd())

            m.global.resolutionProfile = { resolution: "fhd" }
            m.assertEqual(ResolutionProfile.GetName(), "fhd")
            m.assertFalse(ResolutionProfile.IsHd())

            m.global.resolutionProfile = originalProfile
        end function

        @it("defaults to FHD when no profile value is present")
        function _()
            originalProfile = m.global.resolutionProfile
            if m.global.HasField("resolutionProfile") = false then m.global.AddField("resolutionProfile", "assocarray", false)
            m.global.resolutionProfile = invalid

            m.assertEqual(ResolutionProfile.GetName(), "fhd")
            m.assertFalse(ResolutionProfile.IsHd())

            m.global.resolutionProfile = originalProfile
        end function

    end class

end namespace
