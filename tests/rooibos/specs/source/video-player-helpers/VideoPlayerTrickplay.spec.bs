namespace tests

    @suite("VideoPlayer trickplay")
    class VideoPlayerTrickplayTests extends rooibos.BaseTestSuite

        @describe("metadata validation and preview calculations")

        @it("rejects missing item identifiers and metadata (case 1)")
        function _()
            m.assertFalse(VideoPlayerTrickplay.BuildStateResult({}, "").ok)
        end function

        @it("rejects missing item identifiers and metadata (case 2)")
        function _()
            m.assertEqual(VideoPlayerTrickplay.BuildStateResult({}, "item-1").reason, "item has no Trickplay metadata")
        end function

        @it("matches item identifiers case-insensitively")
        function _()
            result = VideoPlayerTrickplay.BuildStateResult(__TrickplayItem("ITEM-1", 13, 200, 100, 4, 2), "item-1")
            m.assertTrue(result.ok)
            m.assertEqual(result.state.thumbnailCount, 13)
            m.assertEqual(result.state.tileCount, 2)
            m.assertTrue(result.state.interval = 10)
        end function

        @it("rounds tile counts up")
        function _()
            exact = VideoPlayerTrickplay.BuildStateResult(__TrickplayItem("item-1", 8, 200, 100, 4, 2), "item-1")
            extra = VideoPlayerTrickplay.BuildStateResult(__TrickplayItem("item-1", 9, 200, 100, 4, 2), "item-1")
            m.assertEqual(exact.state.tileCount, 1)
            m.assertEqual(extra.state.tileCount, 2)
        end function

        @it("enables fast replacement only below the image-area threshold")
        function _()
            below = VideoPlayerTrickplay.BuildStateResult(__TrickplayItem("i", 1, 499, 500, 4, 2), "i")
            boundary = VideoPlayerTrickplay.BuildStateResult(__TrickplayItem("i", 1, 500, 500, 4, 2), "i")
            m.assertTrue(below.state.canUseFastReplace)
            m.assertFalse(boundary.state.canUseFastReplace)
        end function

        @it("rejects invalid dimensions, grids, intervals, and counts")
        function _()
            m.assertFalse(VideoPlayerTrickplay.BuildStateResult(__TrickplayItem("i", 1, 0, 100, 4, 2), "i").ok)
            m.assertFalse(VideoPlayerTrickplay.BuildStateResult(__TrickplayItem("i", 1, 200, 100, 0, 2), "i").ok)
            item = __TrickplayItem("i", 1, 200, 100, 4, 2)
            item.Trickplay.i["200"].Interval = 0
            m.assertFalse(VideoPlayerTrickplay.BuildStateResult(item, "i").ok)
            m.assertFalse(VideoPlayerTrickplay.BuildStateResult(__TrickplayItem("i", 0, 200, 100, 4, 2), "i").ok)
        end function

        @it("calculates preview sheet coordinates and clamps positions")
        function _()
            state = VideoPlayerTrickplay.BuildStateResult(__TrickplayItem("i", 13, 200, 100, 4, 2), "i").state
            first = VideoPlayerTrickplay.BuildPreviewImage(-10, state, "uri")
            secondSheet = VideoPlayerTrickplay.BuildPreviewImage(80, state, "uri")
            final = VideoPlayerTrickplay.BuildPreviewImage(999, state, "uri")
            m.assertEqual(first.tileIndex, 0)
            m.assertEqual(first.row, 0)
            m.assertEqual(first.column, 0)
            m.assertEqual(secondSheet.tileIndex, 1)
            m.assertEqual(secondSheet.row, 0)
            m.assertEqual(secondSheet.column, 0)
            m.assertEqual(final.tileIndex, 1)
            m.assertEqual(final.row, 1)
            m.assertEqual(final.column, 0)
        end function

        @it("returns no preview for invalid state")
        function _()
            m.assertEqual(VideoPlayerTrickplay.BuildPreviewImage(0, invalid, "uri"), {})
        end function

        @it("calculates five-image scaling with fallbacks (case 1)")
        function _()
            m.assertTrue(Abs(VideoPlayerTrickplay.GetFiveImageScale(400, 15) - 1.033125) < 0.0001)
        end function

        @it("calculates five-image scaling with fallbacks (case 2)")
        function _()
            m.assertTrue(VideoPlayerTrickplay.GetFiveImageScale(0, 15) = 1.0)
        end function

        @it("calculates five-image scaling with fallbacks (case 3)")
        function _()
            m.assertTrue(VideoPlayerTrickplay.GetFiveImageScale(400, 500) = 1.0)
        end function

        @it("detects tall thumbnails (case 1)")
        function _()
            m.assertTrue(VideoPlayerTrickplay.IsTallThumbnail({ tileWidth: 100, tileHeight: 100 }))
        end function

        @it("detects tall thumbnails (case 2)")
        function _()
            m.assertFalse(VideoPlayerTrickplay.IsTallThumbnail({ tileWidth: 160, tileHeight: 90 }))
        end function

        @it("detects tall thumbnails (case 3)")
        function _()
            m.assertFalse(VideoPlayerTrickplay.IsTallThumbnail({ tileWidth: 0, tileHeight: 90 }))
        end function

        @it("applies preview layout defaults")
        function _()
            layout = VideoPlayerTrickplay.GetLayout({})
            m.assertEqual(layout.layoutWidth, 1713)
            m.assertEqual(layout.gap, 15)
            m.assertEqual(layout.tileWidth, 384)
            m.assertEqual(layout.tileHeight, 216)
            m.assertTrue(layout.largeScale = 1.2)
            m.assertTrue(layout.smallScale = 0.7)
        end function

        @it("lays out all five slots around the large center slot")
        function _()
            layout = VideoPlayerTrickplay.GetLayout({})
            positions = []
            for i = 0 to 4
                positions.Push(VideoPlayerTrickplay.GetSlotTranslation(i, layout.tileHeight * VideoPlayerTrickplay.GetSlotScale(i, layout), layout))
            end for
            m.assertTrue(positions[0][0] < positions[1][0])
            m.assertTrue(positions[1][0] < positions[2][0])
            m.assertTrue(positions[2][0] < positions[3][0])
            m.assertTrue(positions[3][0] < positions[4][0])
            m.assertEqual(positions[2][1], 3)
            m.assertEqual(VideoPlayerTrickplay.SnapMeasurement(0), 3)
        end function

    end class

    function __TrickplayItem(itemId as string, count as integer, width as integer, height as integer, columns as integer, rows as integer) as object
        widths = {}
        widths["200"] = { Width: width, Height: height, TileWidth: columns, TileHeight: rows, Interval: 10000, ThumbnailCount: count }
        trickplay = {}
        trickplay[itemId] = widths
        return { Trickplay: trickplay }
    end function

end namespace
