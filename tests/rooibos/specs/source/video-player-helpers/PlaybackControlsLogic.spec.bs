namespace tests

    @suite("Playback controls logic")
    class PlaybackControlsLogicTests extends rooibos.BaseTestSuite

        @describe("time, focus, and progress calculations")

        @it("formats negative, zero, and fractional seconds (case 1)")
        function _()
            m.assertEqual(PlaybackControlsLogic.FormatTime(-1), "0:00")
        end function

        @it("formats negative, zero, and fractional seconds (case 2)")
        function _()
            m.assertEqual(PlaybackControlsLogic.FormatTime(0), "0:00")
        end function

        @it("formats negative, zero, and fractional seconds (case 3)")
        function _()
            m.assertEqual(PlaybackControlsLogic.FormatTime(59.9), "0:59")
        end function

        @it("formats minute and hour boundaries (case 1)")
        function _()
            m.assertEqual(PlaybackControlsLogic.FormatTime(60), "1:00")
        end function

        @it("formats minute and hour boundaries (case 2)")
        function _()
            m.assertEqual(PlaybackControlsLogic.FormatTime(3599), "59:59")
        end function

        @it("formats minute and hour boundaries (case 3)")
        function _()
            m.assertEqual(PlaybackControlsLogic.FormatTime(3600), "1:00:00")
        end function

        @it("formats minute and hour boundaries (case 4)")
        function _()
            m.assertEqual(PlaybackControlsLogic.FormatTime(3661), "1:01:01")
        end function

        @it("finds the play-pause button")
        function _()
            buttons = [{ id: "back" }, { id: "playPauseButton" }, { id: "forward" }]
            m.assertEqual(PlaybackControlsLogic.GetDefaultButtonIndex(buttons), 1)
        end function

        @it("falls back to the first button (case 1)")
        function _()
            m.assertEqual(PlaybackControlsLogic.GetDefaultButtonIndex([{ id: "back" }]), 0)
        end function

        @it("falls back to the first button (case 2)")
        function _()
            m.assertEqual(PlaybackControlsLogic.GetDefaultButtonIndex([]), 0)
        end function

        @it("falls back to the first button (case 3)")
        function _()
            m.assertEqual(PlaybackControlsLogic.GetDefaultButtonIndex(invalid), 0)
        end function

        @it("clamps progress below and above duration")
        function _()
            below = PlaybackControlsLogic.GetProgress(-1, 100)
            above = PlaybackControlsLogic.GetProgress(101, 100)
            m.assertTrue(below.position = 0 and below.fraction = 0)
            m.assertTrue(above.position = 100 and above.fraction = 1)
        end function

        @it("normalizes invalid duration and position")
        function _()
            progress = PlaybackControlsLogic.GetProgress(invalid, invalid)
            m.assertTrue(progress.position = 0)
            m.assertTrue(progress.duration = 1)
            m.assertTrue(progress.fraction = 0)
        end function

    end class

end namespace
