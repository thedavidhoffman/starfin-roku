namespace tests

    @suite("VideoPlayer metadata")
    class VideoPlayerMetadataTests extends rooibos.BaseTestSuite

        @describe("classification and display metadata")

        @it("classifies episodes, movies, and videos (case 1)")
        function _()
            m.assertTrue(VideoPlayerMetadata.IsEpisode({}, { Type: "Episode" }))
        end function

        @it("classifies episodes, movies, and videos (case 2)")
        function _()
            m.assertTrue(VideoPlayerMetadata.IsEpisode({ series: { Name: "Series" } }, { Type: "Movie" }))
        end function

        @it("classifies episodes, movies, and videos (case 3)")
        function _()
            m.assertTrue(VideoPlayerMetadata.IsMovie({}, { Type: "Movie" }))
        end function

        @it("classifies episodes, movies, and videos (case 4)")
        function _()
            m.assertTrue(VideoPlayerMetadata.IsMovie({}, { Type: "Video" }))
        end function

        @it("classifies episodes, movies, and videos (case 5)")
        function _()
            m.assertTrue(VideoPlayerMetadata.IsMovie({}, { Type: "MusicVideo" }))
        end function

        @it("classifies episodes, movies, and videos (case 6)")
        function _()
            m.assertFalse(VideoPlayerMetadata.IsMovie({}, { Type: "Episode" }))
        end function

        @it("classifies episodes, movies, and videos (case 7)")
        function _()
            m.assertFalse(VideoPlayerMetadata.IsEpisode({}, invalid))
        end function

        @it("classifies music videos explicitly")
        function _()
            m.assertTrue(VideoPlayerMetadata.IsMusicVideo({ Type: "MusicVideo" }))
            m.assertFalse(VideoPlayerMetadata.IsMusicVideo({ Type: "Video" }))
        end function

        @it("formats populated music-video artists")
        function _()
            m.assertEqual(VideoPlayerMetadata.GetMusicVideoArtists({ Artists: ["Artist One", "Artist Two"] }), "Artist One, Artist Two")
        end function

        @it("omits missing and empty music-video artists")
        function _()
            m.assertEqual(VideoPlayerMetadata.GetMusicVideoArtists({}), "")
            m.assertEqual(VideoPlayerMetadata.GetMusicVideoArtists({ Artists: ["", invalid] }), "")
        end function

        @it("offers random music-video skip before five seconds")
        function _()
            m.assertTrue(VideoPlayerMetadata.ShouldShowRandomMusicVideoSkip({ Type: "MusicVideo" }, "random", "random", true, 4.99, false))
        end function

        @it("hides random music-video skip at five seconds")
        function _()
            m.assertFalse(VideoPlayerMetadata.ShouldShowRandomMusicVideoSkip({ Type: "MusicVideo" }, "random", "random", true, 5, false))
        end function

        @it("requires random queue identity and a next item for skip")
        function _()
            item = { Type: "MusicVideo" }
            m.assertFalse(VideoPlayerMetadata.ShouldShowRandomMusicVideoSkip(item, "sequential", "random", true, 1, false))
            m.assertFalse(VideoPlayerMetadata.ShouldShowRandomMusicVideoSkip(item, "random", "library", true, 1, false))
            m.assertFalse(VideoPlayerMetadata.ShouldShowRandomMusicVideoSkip(item, "random", "random", false, 1, false))
        end function

        @it("honors random music-video skip dismissal")
        function _()
            m.assertFalse(VideoPlayerMetadata.ShouldShowRandomMusicVideoSkip({ Type: "MusicVideo" }, "random", "random", true, 1, true))
        end function

        @it("uses request series title before item fallbacks")
        function _()
            request = { server: "server.local", series: { Id: "s1", Name: "Request Series" } }
            item = { Name: "Episode", SeriesName: "Item Series" }
            m.assertEqual(VideoPlayerMetadata.GetSeriesTitle(request, item), "Request Series")
            m.assertEqual(VideoPlayerMetadata.GetSeriesTitle({}, item), "Item Series")
            m.assertEqual(VideoPlayerMetadata.GetItemTitle(invalid), "Video")
        end function

        @it("formats movie year with premiere-date fallback (case 1)")
        function _()
            m.assertEqual(VideoPlayerMetadata.GetMovieText({ ProductionYear: 2025, PremiereDate: "2024-01-01" }), "2025")
        end function

        @it("formats movie year with premiere-date fallback (case 2)")
        function _()
            m.assertEqual(VideoPlayerMetadata.GetMovieText({ PremiereDate: "2024-01-01" }), "2024")
        end function

        @it("formats movie year with premiere-date fallback (case 3)")
        function _()
            m.assertEqual(VideoPlayerMetadata.GetMovieText(invalid), "")
        end function

        @it("formats complete episode metadata")
        function _()
            item = { ParentIndexNumber: 2, IndexNumber: 3, Name: "An Episode", PremiereDate: "2026-08-19T00:00:00Z", RunTimeTicks: 18000000000& }
            separator = MediaMetadata.BulletSeparator()
            expected = "S2" + separator + "E3" + separator + "An Episode" + separator + "Aug 19, 2026" + separator + "30m"
            m.assertEqual(VideoPlayerMetadata.GetEpisodeText(item), expected)
        end function

        @it("uses alternate episode-number fields and partial numbers (case 1)")
        function _()
            m.assertEqual(VideoPlayerMetadata.__GetEpisodeNumberText({ SeasonNumber: 4, EpisodeNumber: 5 }), "S4" + MediaMetadata.BulletSeparator() + "E5")
        end function

        @it("uses alternate episode-number fields and partial numbers (case 2)")
        function _()
            m.assertEqual(VideoPlayerMetadata.__GetEpisodeNumberText({ SeasonNumber: 4 }), "S4")
        end function

        @it("uses alternate episode-number fields and partial numbers (case 3)")
        function _()
            m.assertEqual(VideoPlayerMetadata.__GetEpisodeNumberText({ EpisodeNumber: 5 }), "E5")
        end function

        @it("uses alternate episode-number fields and partial numbers (case 4)")
        function _()
            m.assertEqual(VideoPlayerMetadata.__GetEpisodeNumberText({}), "")
        end function

        @it("selects and truncates aired-date fallbacks (case 1)")
        function _()
            m.assertEqual(VideoPlayerMetadata.__GetAiredDateText({ PremiereDate: "2026-08-19T12:00:00Z", AirDate: "2025-01-01" }), "2026-08-19")
        end function

        @it("selects and truncates aired-date fallbacks (case 2)")
        function _()
            m.assertEqual(VideoPlayerMetadata.__GetAiredDateText({ AirDate: "2025-01-01" }), "2025-01-01")
        end function

        @it("selects and truncates aired-date fallbacks (case 3)")
        function _()
            m.assertEqual(VideoPlayerMetadata.__GetAiredDateText({ DateCreated: "short" }), "short")
        end function

        @it("joins only non-empty metadata values")
        function _()
            separator = MediaMetadata.BulletSeparator()
            m.assertEqual(VideoPlayerMetadata.__Join(["one", "", invalid, "two"]), "one" + separator + "two")
            m.assertEqual(VideoPlayerMetadata.__Join(invalid), "")
        end function

        @it("converts runtime and clamps seconds (case 1)")
        function _()
            m.assertTrue(VideoPlayerMetadata.GetRuntimeSeconds({ RunTimeTicks: 900000000& }) = 90)
        end function

        @it("converts runtime and clamps seconds (case 2)")
        function _()
            m.assertTrue(VideoPlayerMetadata.GetRuntimeSeconds({}) = 0)
        end function

        @it("converts runtime and clamps seconds (case 3)")
        function _()
            m.assertTrue(VideoPlayerMetadata.ClampSeconds(-1, 0, 100) = 0)
        end function

        @it("converts runtime and clamps seconds (case 4)")
        function _()
            m.assertTrue(VideoPlayerMetadata.ClampSeconds(50, 0, 100) = 50)
        end function

        @it("converts runtime and clamps seconds (case 5)")
        function _()
            m.assertTrue(VideoPlayerMetadata.ClampSeconds(101, 0, 100) = 100)
        end function

        @describe("startup artwork")

        @it("uses the movie backdrop and logo")
        function _()
            item = { Id: "movie", Name: "Movie", Type: "Movie", ImageTags: { Logo: "logo" }, BackdropImageTags: ["backdrop"] }

            artwork = VideoPlayerMetadata.GetStartupArtwork({ server: "http://server", item: item }, item)

            m.assertEqual(artwork.title, "Movie")
            m.assertTrue(Instr(1, artwork.logoUrl, "/Items/movie/Images/Logo") > 0)
            m.assertTrue(Instr(1, artwork.backdropUrl, "/Items/movie/Images/Backdrop") > 0)
        end function

        @it("uses episode artwork while retaining the series logo")
        function _()
            item = { Id: "episode", Name: "Episode", Type: "Episode", ImageTags: { Primary: "episode-still" }, SeriesName: "Show", ParentLogoItemId: "parent", ParentLogoImageTag: "tag" }
            request = { server: "http://server", series: { Id: "show", Name: "Show", logoUrl: "series-logo", detailBackdropUrl: "series-backdrop" } }

            artwork = VideoPlayerMetadata.GetStartupArtwork(request, item)

            m.assertEqual(artwork.title, "Show")
            m.assertEqual(artwork.logoUrl, "series-logo")
            m.assertTrue(Instr(1, artwork.backdropUrl, "/Items/episode/Images/Primary") > 0)
        end function

        @it("uses an inherited logo without borrowing the parent backdrop")
        function _()
            item = { Id: "episode", Type: "Episode", SeriesName: "Show", ParentLogoItemId: "show", ParentLogoImageTag: "logo", ParentBackdropItemId: "show", ParentBackdropImageTags: ["backdrop"] }

            artwork = VideoPlayerMetadata.GetStartupArtwork({ server: "http://server" }, item)

            m.assertEqual(artwork.title, "Show")
            m.assertTrue(Instr(1, artwork.logoUrl, "/Items/show/Images/Logo") > 0)
            m.assertEqual(artwork.backdropUrl, "")
        end function

        @it("preserves request artwork when a response omits image tags")
        function _()
            request = { server: "http://server", item: { Id: "movie", ImageTags: { Logo: "logo" }, BackdropImageTags: ["backdrop"] } }

            artwork = VideoPlayerMetadata.GetStartupArtwork(request, { Id: "movie", Name: "Movie" })

            m.assertTrue(artwork.logoUrl <> "")
            m.assertTrue(artwork.backdropUrl <> "")
        end function

        @it("returns text and empty artwork for a title without images")
        function _()
            artwork = VideoPlayerMetadata.GetStartupArtwork({ server: "http://server" }, { Id: "movie", Name: "Movie" })

            m.assertEqual(artwork, { title: "Movie", logoUrl: "", backdropUrl: "" })
        end function

        @it("preserves the requested episode still when the response omits images")
        function _()
            request = { server: "http://server", item: { Id: "episode", Type: "Episode", ImageTags: { Primary: "still" } }, series: { Id: "show", Name: "Show", detailBackdropUrl: "series-backdrop" } }

            artwork = VideoPlayerMetadata.GetStartupArtwork(request, { Id: "episode", Type: "Episode", Name: "Episode" })

            m.assertTrue(Instr(1, artwork.backdropUrl, "/Items/episode/Images/Primary") > 0)
        end function

        @it("keeps black backing when an episode lacks its own artwork")
        function _()
            request = { server: "http://server", series: { Id: "show", Name: "Show", detailBackdropUrl: "series-backdrop" } }

            artwork = VideoPlayerMetadata.GetStartupArtwork(request, { Id: "episode", Type: "Episode", Name: "Episode" })

            m.assertEqual(artwork.backdropUrl, "")
        end function

    end class

end namespace
