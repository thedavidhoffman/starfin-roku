import "pkg:/source/MediaOptionsSession.bs"
import "pkg:/source/tests/source/MovieVersionFixture.bs"

namespace tests

    @suite("MediaOptionsSession")
    class MediaOptionsSessionTests extends rooibos.BaseTestSuite

        @describe("detail stream changes")

        @it("applies audio and subtitle changes without mutating the original state")
        function _()
            current = { audio: { streamIndex: 1 }, subtitle: { streamIndex: 3 }, subtitleOff: false }
            context = { audioOptions: [{ value: { streamIndex: 2 } }], subtitleOptions: [{ value: { streamIndex: -1 } }] }

            result = MediaOptionsSession.ApplyStreamChanges(current, context, { audioStreamIndex: 2, subtitleStreamIndex: -1 })

            m.assertEqual(result.audio.streamIndex, 2)
            m.assertInvalid(result.subtitle)
            m.assertTrue(result.subtitleOff)
            m.assertEqual(current.audio.streamIndex, 1)
            m.assertEqual(current.subtitle.streamIndex, 3)
            m.assertFalse(current.subtitleOff)
        end function

        @it("preserves stream choices when only video or chapter changes")
        function _()
            current = { audio: { streamIndex: 1 }, subtitle: invalid, subtitleOff: true }

            result = MediaOptionsSession.ApplyStreamChanges(current, {}, { videoMode: "automatic", chapter: { startPositionTicks: 0 } })

            m.assertEqual(result, current)
        end function

        @it("selects a subtitle track after an explicit Off selection")
        function _()
            current = { audio: invalid, subtitle: invalid, subtitleOff: true }
            context = { subtitleOptions: [{ value: { streamIndex: 3, label: "English" } }] }

            result = MediaOptionsSession.ApplyStreamChanges(current, context, { subtitleStreamIndex: 3 })

            m.assertEqual(result.subtitle.streamIndex, 3)
            m.assertFalse(result.subtitleOff)
            m.assertTrue(current.subtitleOff)
        end function

        @it("leaves unavailable audio unset in the display selection")
        function _()
            selection = { videoMode: "automatic", audioStreamIndex: -1, subtitleStreamIndex: -2 }

            result = MediaOptionsSession.DisplaySelection({ audioOptions: [] }, selection)

            m.assertEqual(result.audioStreamIndex, -1)
            m.assertEqual(result.subtitleStreamIndex, -2)
            m.assertEqual(selection.subtitleStreamIndex, -2)
        end function

        @it("shows automatic selection without changing pending intent")
        function _()
            context = MediaOptionsSession.Context({}, "automatic", -1, -2, [], [{ Index: 4, Language: "eng" }])
            display = MediaOptionsSession.DisplaySelection(context, context.selection)
            m.assertEqual(context.subtitleOptions[0].label, "Jellyfin Account Default")
            m.assertEqual(display.subtitleStreamIndex, -2)
            m.assertEqual(MediaOptionsSession.Changes(context.selection, display).Count(), 0)
        end function

        @it("keeps account default available after Off")
        function _()
            context = MediaOptionsSession.Context({}, "automatic", -1, -1, [], [{ Index: 4, Language: "eng" }])

            m.assertEqual(context.subtitleOptions[0].label, "Jellyfin Account Default")
            m.assertEqual(context.subtitleOptions[0].value.streamIndex, -2)
            m.assertEqual(MediaOptionsSession.DisplaySelection(context, context.selection).subtitleStreamIndex, -1)
        end function

        @it("keeps account default available after manual track")
        function _()
            context = MediaOptionsSession.Context({}, "automatic", -1, 4, [], [{ Index: 4, Language: "eng" }])

            m.assertEqual(context.subtitleOptions[0].label, "Jellyfin Account Default")
            m.assertEqual(context.subtitleOptions[0].value.streamIndex, -2)
            m.assertEqual(MediaOptionsSession.DisplaySelection(context, context.selection).subtitleStreamIndex, 4)
        end function

        @it("constructs active options with separate intent and resolved selection")
        function _()
            context = MediaOptionsSession.Context({}, "automatic", -1, -2, [], [{ Index: 4, Language: "eng" }], 4)

            m.assertEqual(context.selection.subtitleStreamIndex, -2)
            m.assertEqual(context.subtitleOptions.Count(), 2)
            m.assertEqual(context.subtitleOptions[0].value.streamIndex, -1)
            m.assertEqual(MediaOptionsSession.DisplaySelection(context, context.selection).subtitleStreamIndex, 4)
        end function

        @it("clears manual Off when returning to account default")
        function _()
            current = { audio: invalid, subtitle: invalid, subtitleOff: true }
            context = MediaOptionsSession.Context({}, "automatic", -1, -1, [], [{ Index: 4, Language: "eng" }])

            result = MediaOptionsSession.ApplyStreamChanges(current, context, { subtitleStreamIndex: -2 })

            m.assertInvalid(result.subtitle)
            m.assertFalse(result.subtitleOff)
            m.assertTrue(current.subtitleOff)
        end function

        @describe("movie version contexts")

        @it("projects selected-version metadata and retains session context")
        function _()
            original = TestMovieVersions.Context()
            versions = MovieVersions.Select(original.movieVersions, "version-2")
            selection = { mediaSourceId: "version-2", videoMode: "automatic", audioStreamIndex: -1, subtitleStreamIndex: -2 }

            result = MediaOptionsSession.ForVersion(original, versions, selection)

            m.assertEqual(result.item.Id, "movie-1")
            m.assertEqual(result.item.MediaSources[0].Id, "version-2")
            m.assertEqual(result.item.RunTimeTicks, 600000000&)
            m.assertEqual(result.chapterOptions[0].value.chapter.Name, "Director opening")
            m.assertEqual(result.audioOptions[0].value.streamIndex, 3)
            m.assertEqual(result.selection.mediaSourceId, "version-2")
            m.assertEqual(result.session, original.session)
            m.assertEqual(result.movieVersions, versions)
            m.assertEqual(original.selection.mediaSourceId, "movie-1")
        end function

        @it("clears the previous version's resolved subtitle for account default")
        function _()
            original = TestMovieVersions.Context()
            original.resolvedSubtitleStreamIndex = 2
            original.playbackInfo = { MediaSources: original.item.MediaSources }
            versions = MovieVersions.Select(original.movieVersions, "version-2")
            selection = { mediaSourceId: "version-2", videoMode: "automatic", audioStreamIndex: -1, subtitleStreamIndex: -2 }

            result = MediaOptionsSession.ForVersion(original, versions, selection)

            m.assertInvalid(result.resolvedSubtitleStreamIndex)
            m.assertInvalid(result.playbackInfo)
            m.assertEqual(result.selection.subtitleStreamIndex, -2)
            m.assertEqual(result.subtitleOptions[0].label, "Jellyfin Account Default")
            m.assertEqual(MediaOptionsSession.DisplaySelection(result, result.selection).subtitleStreamIndex, -2)
        end function

        @it("retains explicit subtitle Off for the destination version")
        function _()
            original = TestMovieVersions.Context()
            versions = MovieVersions.Select(original.movieVersions, "version-2")
            selection = { mediaSourceId: "version-2", videoMode: "automatic", audioStreamIndex: -1, subtitleStreamIndex: -1 }

            result = MediaOptionsSession.ForVersion(original, versions, selection)

            m.assertEqual(result.selection.subtitleStreamIndex, -1)
            m.assertEqual(MediaOptionsSession.DisplaySelection(result, result.selection).subtitleStreamIndex, -1)
        end function

        @it("restores the original version's resolved subtitle and playback metadata")
        function _()
            original = TestMovieVersions.Context()
            original.resolvedSubtitleStreamIndex = 2
            original.playbackInfo = { MediaSources: original.item.MediaSources }

            result = MediaOptionsSession.ForVersion(original, original.movieVersions, { mediaSourceId: "movie-1", videoMode: "automatic", audioStreamIndex: 1, subtitleStreamIndex: -2 })

            m.assertEqual(result.resolvedSubtitleStreamIndex, 2)
            m.assertEqual(result.playbackInfo, original.playbackInfo)
            m.assertEqual(MediaOptionsSession.DisplaySelection(result, result.selection).subtitleStreamIndex, 2)
        end function

    end class

end namespace
