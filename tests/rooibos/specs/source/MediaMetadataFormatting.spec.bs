namespace tests

    @suite("Media metadata helpers")
    class MediaMetadataFormattingTests extends rooibos.BaseTestSuite

        @describe("MediaMetadataFormatting.FormatRating")

        @it("rounds positive ratings to one decimal place (case 1)")
        function _()
            m.assertEqual(MediaMetadataFormatting.FormatRating(8.24), "8.2")
        end function

        @it("rounds positive ratings to one decimal place (case 2)")
        function _()
            m.assertEqual(MediaMetadataFormatting.FormatRating(8.25), "8.3")
        end function

        @it("rounds positive ratings to one decimal place (case 3)")
        function _()
            m.assertEqual(MediaMetadataFormatting.FormatRating("7.5"), "7.5")
        end function

        @it("omits invalid and non-positive ratings (case 1)")
        function _()
            m.assertEqual(MediaMetadataFormatting.FormatRating(invalid), "")
        end function

        @it("omits invalid and non-positive ratings (case 2)")
        function _()
            m.assertEqual(MediaMetadataFormatting.FormatRating(0), "")
        end function

        @it("omits invalid and non-positive ratings (case 3)")
        function _()
            m.assertEqual(MediaMetadataFormatting.FormatRating(-1), "")
        end function

        @describe("MediaMetadataFormatting.FormatRuntime")

        @it("formats runtime ticks as minutes and hours (case 1)")
        function _()
            m.assertEqual(MediaMetadataFormatting.FormatRuntime(35999999999&), "59m")
        end function

        @it("formats runtime ticks as minutes and hours (case 2)")
        function _()
            m.assertEqual(MediaMetadataFormatting.FormatRuntime(36000000000&), "1h 0m")
        end function

        @it("formats runtime ticks as minutes and hours (case 3)")
        function _()
            m.assertEqual(MediaMetadataFormatting.FormatRuntime(75000000000&), "2h 5m")
        end function

        @it("omits invalid and sub-minute runtimes (case 1)")
        function _()
            m.assertEqual(MediaMetadataFormatting.FormatRuntime(invalid), "")
        end function

        @it("omits invalid and sub-minute runtimes (case 2)")
        function _()
            m.assertEqual(MediaMetadataFormatting.FormatRuntime(599999999&), "")
        end function

        @it("omits invalid and sub-minute runtimes (case 3)")
        function _()
            m.assertEqual(MediaMetadataFormatting.FormatRuntime(0), "")
        end function

        @it("provides a non-empty bullet separator")
        function _()
            separator = MediaMetadataFormatting.BulletSeparator()
            m.assertTrue(Len(separator) > 0)
            m.assertEqual(Strings.Trim(separator) <> "", true)
        end function

        @describe("critic percentages")

        @it("formats missing critic rating")
        function _()
            m.assertEqual(MediaMetadataFormatting.NormalizeCriticRating(invalid), invalid)
        end function

        @it("formats negative critic rating")
        function _()
            m.assertEqual(MediaMetadataFormatting.NormalizeCriticRating(-1), invalid)
        end function

        @it("formats out of range critic rating")
        function _()
            m.assertEqual(MediaMetadataFormatting.NormalizeCriticRating(101), invalid)
        end function

        @it("formats malformed critic rating")
        function _()
            m.assertEqual(MediaMetadataFormatting.NormalizeCriticRating("oops"), invalid)
        end function

        @it("formats zero critic rating")
        function _()
            m.assertEqual(MediaMetadataFormatting.NormalizeCriticRating(0), 0)
        end function

        @it("formats rounded critic rating")
        function _()
            m.assertEqual(MediaMetadataFormatting.NormalizeCriticRating(82.6), 83)
        end function

    end class

end namespace
