namespace tests

    @suite("JellyfinImage")
    class JellyfinImageTests extends rooibos.BaseTestSuite

        @describe("Type")

        @it("maps Primary to the Jellyfin image type")
        function _()
            m.assertEqual(JellyfinImage.Type.Primary, "Primary")
        end function

        @it("maps Backdrop to the Jellyfin image type")
        function _()
            m.assertEqual(JellyfinImage.Type.Backdrop, "Backdrop")
        end function

        @it("maps Thumb to the Jellyfin image type")
        function _()
            m.assertEqual(JellyfinImage.Type.Thumb, "Thumb")
        end function

        @it("maps Logo to the Jellyfin image type")
        function _()
            m.assertEqual(JellyfinImage.Type.Logo, "Logo")
        end function

    end class

end namespace
