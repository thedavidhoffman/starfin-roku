namespace tests

    @suite("Next episode prompt seconds presets")
    class NextEpisodePromptSecondsTests extends rooibos.BaseTestSuite

        @describe("normalization")

        @it("preserves the 0 second preset")
        function _()
            m.assertEqual(NextEpisodePromptSeconds.Normalize("0"), "0")
        end function

        @it("preserves the 15 second preset")
        function _()
            m.assertEqual(NextEpisodePromptSeconds.Normalize("15"), "15")
        end function

        @it("preserves the 30 second preset")
        function _()
            m.assertEqual(NextEpisodePromptSeconds.Normalize("30"), "30")
        end function

        @it("preserves the 45 second preset")
        function _()
            m.assertEqual(NextEpisodePromptSeconds.Normalize("45"), "45")
        end function

        @it("preserves the 60 second preset")
        function _()
            m.assertEqual(NextEpisodePromptSeconds.Normalize("60"), "60")
        end function

        @it("preserves the 75 second preset")
        function _()
            m.assertEqual(NextEpisodePromptSeconds.Normalize("75"), "75")
        end function

        @it("preserves the 90 second preset")
        function _()
            m.assertEqual(NextEpisodePromptSeconds.Normalize("90"), "90")
        end function

        @it("preserves the 105 second preset")
        function _()
            m.assertEqual(NextEpisodePromptSeconds.Normalize("105"), "105")
        end function

        @it("preserves the 120 second preset")
        function _()
            m.assertEqual(NextEpisodePromptSeconds.Normalize("120"), "120")
        end function

        @it("disables missing values")
        function _()
            m.assertEqual(NextEpisodePromptSeconds.Normalize(invalid), "0")
        end function

        @it("disables unsupported values")
        function _()
            m.assertEqual(NextEpisodePromptSeconds.Normalize("1000"), "0")
        end function

        @it("disables small values")
        function _()
            m.assertEqual(NextEpisodePromptSeconds.Normalize("5"), "0")
        end function

        @it("disables fractional values")
        function _()
            m.assertEqual(NextEpisodePromptSeconds.Normalize("30.5"), "0")
        end function

        @it("pairs each preset value with its displayed label")
        function _()
            m.assertEqual(NextEpisodePromptSeconds.Options(), [
                { value: "0", title: "Off" }
                { value: "15", title: "15 seconds" }
                { value: "30", title: "30 seconds" }
                { value: "45", title: "45 seconds" }
                { value: "60", title: "60 seconds" }
                { value: "75", title: "75 seconds" }
                { value: "90", title: "90 seconds" }
                { value: "105", title: "105 seconds" }
                { value: "120", title: "120 seconds" }
            ])
        end function

    end class

end namespace
