namespace tests

    @suite("Media shell layout")
    class MediaShellLayoutTests extends rooibos.BaseTestSuite

        @describe("observable behavior")

        @it("normalizes supported modes")
        function _()
            m.assertEqual(MediaShellLayout.Normalize("CINEMATIC"), "cinematic")
        end function

        @it("uses the supplied default for invalid values")
        function _()
            m.assertEqual(MediaShellLayout.Normalize("unknown", "partial-screen"), "partial-screen")
        end function

        @it("rejects episode Poster")
        function _()
            m.assertEqual(MediaShellLayout.Normalize("poster", "full-screen", false), "full-screen")
        end function

        @it("retains movie Poster")
        function _()
            m.assertEqual(MediaShellLayout.Normalize("poster"), "poster")
        end function

        @it("retains movie Cinematic")
        function _()
            m.assertEqual(MediaShellLayout.Normalize("cinematic"), "cinematic")
        end function

        @describe("Series normalization")

        @it("rejects series Cinematic")
        function _()
            m.assertEqual(MediaShellLayout.NormalizeSeries("cinematic"), "partial-screen")
        end function

        @it("retains series Full Backdrop")
        function _()
            m.assertEqual(MediaShellLayout.NormalizeSeries("full-screen"), "full-screen")
        end function

        @it("retains series Poster")
        function _()
            m.assertEqual(MediaShellLayout.NormalizeSeries("poster"), "poster")
        end function

    end class

end namespace
