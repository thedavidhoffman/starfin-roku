namespace tests

    @SGNode("Dialog")
    @suite("Dialog component")
    class DialogTests extends rooibos.BaseTestSuite

        protected override function beforeEach()
            m.originalPanel = m.node.panel
            m.originalTheme = m.global.theme
            m.originalProfile = m.global.resolutionProfile
            if not m.global.hasField("resolutionProfile") then m.global.addField("resolutionProfile", "assocarray", false)
            m.global.resolutionProfile = { resolution: "fhd" }
        end function

        protected override function afterEach()
            m.node.panel = m.originalPanel
            m.global.resolutionProfile = m.originalProfile
            m.global.theme = m.originalTheme
        end function

        @describe("Dialog behavior")

        @it("retains the last ready panel through a loading replacement")
        function _()
            m.node.panel = { uri: "pkg:/images/themes/blue/fhd/dialog-panel.9.png", loadStatus: "ready" }
            'bs:disable-next-line 1140
            onPanelLoadStatusChanged()
            m.node.panel.uri = "pkg:/images/themes/black/fhd/dialog-panel.9.png"
            m.node.panel.loadStatus = "loading"

            m.global.theme = "grey"
            'bs:disable-next-line 1140
            updateTheme()

            m.assertEqual(m.node.panel.uri, "pkg:/images/themes/grey/fhd/dialog-panel.9.png")
            m.assertEqual(m.node.panel.loadingBitmapUri, "pkg:/images/themes/blue/fhd/dialog-panel.9.png")
            m.assertEqual(m.node.panel.failedBitmapUri, "pkg:/images/themes/blue/fhd/dialog-panel.9.png")
        end function

        @it("retains the last ready panel through a failed replacement")
        function _()
            m.node.panel = { uri: "pkg:/images/themes/blue/fhd/dialog-panel.9.png", loadStatus: "ready" }
            'bs:disable-next-line 1140
            onPanelLoadStatusChanged()
            m.node.panel.uri = "pkg:/images/themes/black/fhd/dialog-panel.9.png"
            m.node.panel.loadStatus = "failed"

            m.global.theme = "grey"
            'bs:disable-next-line 1140
            updateTheme()

            m.assertEqual(m.node.panel.uri, "pkg:/images/themes/grey/fhd/dialog-panel.9.png")
            m.assertEqual(m.node.panel.loadingBitmapUri, "pkg:/images/themes/blue/fhd/dialog-panel.9.png")
            m.assertEqual(m.node.panel.failedBitmapUri, "pkg:/images/themes/blue/fhd/dialog-panel.9.png")
        end function

        @it("promotes a ready replacement to the next loading placeholder")
        function _()
            m.node.panel = { uri: "pkg:/images/themes/grey/fhd/dialog-panel.9.png", loadStatus: "ready" }

            'bs:disable-next-line 1140
            onPanelLoadStatusChanged()
            m.node.panel.loadStatus = "loading"
            m.global.theme = "black"
            'bs:disable-next-line 1140
            updateTheme()

            m.assertEqual(m.node.panel.loadingBitmapUri, "pkg:/images/themes/grey/fhd/dialog-panel.9.png")
            m.assertEqual(m.node.panel.failedBitmapUri, "pkg:/images/themes/grey/fhd/dialog-panel.9.png")
        end function

        @it("does not promote an unfinished initial panel")
        function _()
            m.node.dialogImages = { lastReadyUri: "" }
            m.node.panel = { uri: "pkg:/images/themes/blue/fhd/dialog-panel.9.png", loadStatus: "loading" }
            m.global.theme = "grey"

            'bs:disable-next-line 1140
            updateTheme()

            m.assertEqual(m.node.panel.loadingBitmapUri, "")
            m.assertEqual(m.node.dialogImages.lastReadyUri, "")
        end function

        @it("keeps the ready image when the theme is unchanged")
        function _()
            m.global.theme = "blue"
            m.node.panel = { uri: "pkg:/images/themes/blue/fhd/dialog-panel.9.png", loadStatus: "ready" }

            'bs:disable-next-line 1140
            updateTheme()

            m.assertEqual(m.node.panel.uri, "pkg:/images/themes/blue/fhd/dialog-panel.9.png")
            m.assertEqual(m.node.panel.loadingBitmapUri, m.node.panel.uri)
        end function

        @it("applies blue when constructed")
        function _()
            m.global.theme = "blue"

            dialog = createObject("roSGNode", "Dialog")

            m.assertEqual(dialog.findNode("panel").uri, "pkg:/images/themes/blue/fhd/dialog-panel.9.png")
        end function

        @it("applies black when constructed")
        function _()
            m.global.theme = "black"

            dialog = createObject("roSGNode", "Dialog")

            m.assertEqual(dialog.findNode("panel").uri, "pkg:/images/themes/black/fhd/dialog-panel.9.png")
        end function

        @it("applies grey when constructed")
        function _()
            m.global.theme = "grey"

            dialog = createObject("roSGNode", "Dialog")

            m.assertEqual(dialog.findNode("panel").uri, "pkg:/images/themes/grey/fhd/dialog-panel.9.png")
        end function

        @it("switches theme without replacing content or disturbing an open dialog")
        function _()
            m.global.theme = "blue"
            m.top.contentComponentName = "DescriptionDialogContent"
            content = m.top.callFunc("getContentComponent")
            m.top.showButtons = true
            m.top.callFunc("openDialog")
            m.top.callFunc("focusSaveButton")
            panelPosition = m.node.panel.translation

            m.global.theme = "black"

            m.assertEqual(m.node.panel.uri, "pkg:/images/themes/black/fhd/dialog-panel.9.png")
            m.assertEqual(m.top.callFunc("getContentComponent"), content)
            m.assertTrue(m.node.dialog.visible)
            m.assertTrue(m.node.saveButton.hasFocus())
            m.assertEqual(m.node.panel.translation, panelPosition)
        end function

        @it("returns an existing dialog to blue")
        function _()
            m.global.theme = "grey"

            m.global.theme = "blue"

            m.assertEqual(m.node.panel.uri, "pkg:/images/themes/blue/fhd/dialog-panel.9.png")
        end function

        @it("uses the default title")
        function _()
            m.assertEqual(m.node.titleLabel.text, "Dialog")
        end function

        @it("applies configured size and position")
        function _()
            m.top.dialogWidth = 600
            m.top.dialogHeight = 400
            m.top.panelX = 100
            m.top.panelY = 50
            'bs:disable-next-line 1140
            updateDialogSize()
            m.assertEqual(m.node.panel.translation, [100.0, 50.0])
            m.assertEqual(m.node.panel.width, 600.0)
            m.assertEqual(m.node.panel.height, 400.0)
        end function

        @it("renders a configured title")
        function _()
            m.top.title = "Choose"
            'bs:disable-next-line 1140
            updateTitle()
            m.assertEqual(m.node.titleLabel.text, "Choose")
        end function

        @it("shows footer buttons when enabled")
        function _()
            m.top.showButtons = true
            'bs:disable-next-line 1140
            updateButtonVisibility()
            m.assertTrue(m.node.footer.visible)
            m.assertTrue(m.node.saveButton.visible)
            m.assertTrue(m.node.cancelButton.visible)
        end function

        @it("creates the configured content component")
        function _()
            m.top.contentComponentName = "DescriptionDialogContent"
            'bs:disable-next-line 1140
            updateContentComponent()
            'bs:disable-next-line 1140
            m.assertNotInvalid(getContentComponent())
        end function

        @it("opens the dialog")
        function _()
            'bs:disable-next-line 1140
            openDialog()
            m.assertTrue(m.node.dialog.visible)
        end function

        @it("ignores released back keys")
        function _()
            'bs:disable-next-line 1140
            openDialog()
            'bs:disable-next-line 1140
            m.assertFalse(onKeyEvent("back", false))
            m.assertTrue(m.node.dialog.visible)
        end function

        @it("closes on a pressed back key")
        function _()
            'bs:disable-next-line 1140
            openDialog()
            'bs:disable-next-line 1140
            m.assertTrue(onKeyEvent("back", true))
            m.assertFalse(m.node.dialog.visible)
            m.assertTrue(m.top.closeRequested)
        end function

        @it("uses default and configured button text")
        function _()
            m.top.saveButtonText = ""
            m.top.cancelButtonText = "Discard"

            'bs:disable-next-line 1140
            updateButtonText()

            m.assertEqual(m.node.saveButton.text, "Save")
            m.assertEqual(m.node.cancelButton.text, "Discard")
        end function

        @it("removes obsolete content when the component name is cleared")
        function _()
            m.top.contentComponentName = "DescriptionDialogContent"
            'bs:disable-next-line 1140
            updateContentComponent()
            m.assertEqual(m.node.content.getChildCount(), 1)

            m.top.contentComponentName = ""
            'bs:disable-next-line 1140
            updateContentComponent()

            m.assertEqual(m.node.content.getChildCount(), 0)
            'bs:disable-next-line 1140
            m.assertInvalid(getContentComponent())
        end function

        @it("focuses and highlights the save button")
        function _()
            m.top.showButtons = true

            'bs:disable-next-line 1140
            m.assertTrue(focusSaveButton())

            m.assertTrue(m.node.saveButton.hasFocusVisual)
            m.assertFalse(m.node.cancelButton.hasFocusVisual)
        end function

        @it("moves between footer buttons with directional keys")
        function _()
            m.top.showButtons = true
            'bs:disable-next-line 1140
            openDialog()
            'bs:disable-next-line 1140
            focusSaveButton()

            'bs:disable-next-line 1140
            m.assertTrue(onKeyEvent("right", true))
            m.assertTrue(m.node.cancelButton.hasFocusVisual)

            'bs:disable-next-line 1140
            m.assertTrue(onKeyEvent("left", true))
            m.assertTrue(m.node.saveButton.hasFocusVisual)
        end function

        @it("publishes save selection without closing the dialog")
        function _()
            m.top.showButtons = true
            'bs:disable-next-line 1140
            openDialog()
            'bs:disable-next-line 1140
            focusSaveButton()

            'bs:disable-next-line 1140
            m.assertTrue(onKeyEvent("OK", true))

            m.assertTrue(m.top.saveSelected)
            m.assertTrue(m.node.dialog.visible)
        end function

        @it("publishes cancel selection and closes the dialog")
        function _()
            m.top.showButtons = true
            'bs:disable-next-line 1140
            openDialog()
            'bs:disable-next-line 1140
            focusCancelButton()

            'bs:disable-next-line 1140
            m.assertTrue(onKeyEvent("select", true))

            m.assertTrue(m.top.cancelSelected)
            m.assertTrue(m.top.closeRequested)
            m.assertFalse(m.node.dialog.visible)
        end function

        @it("closes a buttonless dialog when content is selected")
        function _()
            m.top.showButtons = false
            m.top.closeOnContentSelected = true
            'bs:disable-next-line 1140
            openDialog()

            'bs:disable-next-line 1140
            m.assertTrue(onKeyEvent("OK", true))

            m.assertFalse(m.node.dialog.visible)
            m.assertTrue(m.top.closeRequested)
        end function

        @it("adds shared frame spacing when fitting content")
        function _()
            m.top.showButtons = false
            m.top.callFunc("fitContentHeight", 300)

            m.assertEqual(m.top.dialogHeight, 530)
        end function

        @it("reserves the shared footer when fitting content with buttons")
        function _()
            m.top.showButtons = true
            m.top.callFunc("fitContentHeight", 300)

            m.assertEqual(m.top.dialogHeight, 650)
        end function

    end class

end namespace
