import "pkg:/source/AppMessage.bs"

namespace tests

    @SGNode("OverlayHost")
    @suite("OverlayHost component")
    class OverlayHostTests extends rooibos.BaseTestSuite

        protected override function beforeEach()
            m.top.callFunc("closeOverlay", false)
            m.fixtureChildCount = m.top.getChildCount()
        end function

        @describe("OverlayHost behavior")

        @it("rejects an invalid overlay request")
        function _()
            'bs:disable-next-line 1140
            m.assertInvalid(openOverlay(invalid))
        end function

        @it("rejects a request without a component name")
        function _()
            'bs:disable-next-line 1140
            m.assertInvalid(openOverlay({}))
        end function

        @it("normalizes a single close field")
        function _()
            'bs:disable-next-line 1140
            m.assertEqual(getCloseFields({ closeField: "closeRequested" }), ["closeRequested"])
        end function

        @it("preserves multiple close fields")
        function _()
            'bs:disable-next-line 1140
            m.assertEqual(getCloseFields({ closeFields: ["cancelSelected", "closeRequested"] }), ["cancelSelected", "closeRequested"])
        end function

        @it("returns no event fields for an invalid request")
        function _()
            'bs:disable-next-line 1140
            m.assertEqual(getEventFields(invalid), [])
        end function

        @it("ignores a stale close callback without an active overlay")
        function _()
            m.top.closed = invalid

            'bs:disable-next-line 1140
            onOverlayClosed(invalid)

            m.assertInvalid(m.top.closed)
        end function

        @it("opens a description overlay")
        function _()
            initialChildCount = m.top.getChildCount()
            'bs:disable-next-line 1140
            overlay = openOverlay({ id: "description", componentName: "DescriptionDialog", title: "Overview", text: "Initial" })
            m.assertNotInvalid(overlay)
            m.assertEqual(m.top.getChildCount(), initialChildCount + 1)
            m.assertEqual(overlay.title, "Overview")
            m.assertEqual(overlay.text, "Initial")
        end function

        @it("updates the active overlay")
        function _()
            'bs:disable-next-line 1140
            overlay = openOverlay({ id: "description", componentName: "DescriptionDialog", title: "Overview", text: "Initial" })
            'bs:disable-next-line 1140
            updateOverlay({ id: "description", title: "Updated", text: "Changed" })
            m.assertEqual(overlay.title, "Updated")
            m.assertEqual(overlay.text, "Changed")
        end function

        @it("passes watched-only episode options to the media dialog")
        function _()
            request = {
                id: "mediaActions"
                componentName: "MediaActionsDialog"
                openFunction: "openMediaActions"
                closeField: "closeRequested"
                watchedOnly: true
                item: { Id: "episode-1", Name: "Episode", Type: "Episode", UserData: { Played: false } }
            }

            overlay = m.top.callFunc("openOverlay", request)

            m.assertTrue(overlay.watchedOnly)
            m.assertEqual(overlay.options.Count(), 1)
            m.assertEqual(overlay.options[0].key, "MarkAsWatched")

            overlay.callFunc("closeDialog")

            m.assertInvalid(m.top.closed.overlay.mediaActionSelected)
            m.assertEqual(m.top.closed.request.item.Id, "episode-1")
        end function

        @it("closes the active overlay")
        function _()
            'bs:disable-next-line 1140
            closeOverlay()
            initialChildCount = m.top.getChildCount()
            'bs:disable-next-line 1140
            openOverlay({ id: "description", componentName: "DescriptionDialog", title: "Overview", text: "Initial" })
            'bs:disable-next-line 1140
            closeOverlay()
            m.assertEqual(m.top.getChildCount(), initialChildCount)
        end function

        @it("cancels discovery when its overlay is removed")
        function _()
            initialChildCount = m.top.getChildCount()
            overlay = m.top.callFunc("openOverlay", { id: "serverDiscovery", componentName: "ServerDiscoveryDialog", openFunction: "openDiscovery", closeField: "closeRequested" })
            task = overlay.getChild(overlay.getChildCount() - 1)

            m.top.callFunc("closeOverlay")

            m.assertEqual(m.top.getChildCount(), initialChildCount)
            m.assertTrue(task.cancelRequested)
            m.assertInvalid(overlay.selectedServer)
        end function

        @it("routes a discovery selection through the closed payload")
        function _()
            overlay = m.top.callFunc("openOverlay", { id: "serverDiscovery", componentName: "ServerDiscoveryDialog", openFunction: "openDiscovery", closeField: "closeRequested" })
            server = { name: "NAS", address: "http://nas" }
            overlay.selectedServer = server
            overlay.callFunc("closeDialog")

            m.assertEqual(m.top.closed.request.id, "serverDiscovery")
            m.assertEqual(m.top.closed.overlay.selectedServer, server)
        end function

        @it("passes the current address into the server picker")
        function _()
            overlay = m.top.callFunc("openOverlay", { id: "serverDiscovery", componentName: "ServerDiscoveryDialog", openFunction: "openDiscovery", currentAddress: "https://nas:8097/base" })

            m.assertEqual(overlay.currentAddress, "https://nas:8097/base")
            m.top.callFunc("closeOverlay")
        end function

        @it("closes an owned keyboard when replacing the server picker")
        function _()
            overlay = m.top.callFunc("openOverlay", { id: "serverDiscovery", componentName: "ServerDiscoveryDialog", openFunction: "openDiscovery" })
            content = overlay.callFunc("getContentComponent")
            content.manualEntryRequested = true
            keyboard = m.top.getScene().dialog
            m.top.callFunc("openOverlay", { id: "description", componentName: "DescriptionDialog", title: "Replacement", text: "Details" })

            m.assertTrue(keyboard.close)
            m.assertFalse(content.keyboardActive)
            m.assertInvalid(m.top.getScene().dialog)
            m.top.callFunc("closeOverlay")
        end function

        @it("detaches retired overlay close observers")
        function _()
            old = m.top.callFunc("openOverlay", { id: "description", componentName: "DescriptionDialog", closeField: "closeRequested" })
            current = m.top.callFunc("openOverlay", { id: "description", componentName: "DescriptionDialog", closeField: "closeRequested" })
            old.closeRequested = true

            m.assertTrue(m.node.activeOverlay.isSameNode(current))
            m.top.callFunc("closeOverlay")
        end function

        @it("rejects a queued close event from a retired overlay")
        function _()
            old = m.top.callFunc("openOverlay", { id: "description", componentName: "DescriptionDialog", closeField: "closeRequested" })
            current = m.top.callFunc("openOverlay", { id: "description", componentName: "DescriptionDialog", closeField: "closeRequested" })
            'bs:disable-next-line 1140
            onOverlayClosed(m.overlayEvent(old))

            m.assertTrue(m.node.activeOverlay.isSameNode(current))
            m.top.callFunc("closeOverlay")
        end function

        @it("detaches retired overlay event observers")
        function _()
            old = m.top.callFunc("openOverlay", { id: "description", componentName: "DescriptionDialog", eventFields: ["saveSelected"] })
            current = m.top.callFunc("openOverlay", { id: "description", componentName: "DescriptionDialog", eventFields: ["saveSelected"] })
            m.top.eventRaised = invalid
            old.saveSelected = true

            m.assertInvalid(m.top.eventRaised)
            m.top.callFunc("closeOverlay")
        end function

        @it("rejects a queued event from a retired overlay")
        function _()
            old = m.top.callFunc("openOverlay", { id: "description", componentName: "DescriptionDialog", eventFields: ["saveSelected"] })
            current = m.top.callFunc("openOverlay", { id: "description", componentName: "DescriptionDialog", eventFields: ["saveSelected"] })
            m.top.eventRaised = invalid
            'bs:disable-next-line 1140
            onOverlayEventRaised(m.overlayEvent(old))

            m.assertInvalid(m.top.eventRaised)
            m.top.callFunc("closeOverlay")
        end function

        @it("continues routing events from the active overlay")
        function _()
            current = m.top.callFunc("openOverlay", { id: "description", componentName: "DescriptionDialog", eventFields: ["saveSelected"] })
            current.saveSelected = true

            m.assertEqual(m.top.eventRaised.field, "saveSelected")
            m.assertTrue(m.top.eventRaised.value)
            m.top.callFunc("closeOverlay")
        end function

        function overlayEvent(node as object) as object
            return {
                node: node
                getRoSGNode: function()
                    return m.node
                end function
                getField: function()
                    return "saveSelected"
                end function
            }
        end function

        @it("copies the unified options payload without committing it")
        function _()
            context = { item: { Id: "movie-1" }, selection: { videoMode: "automatic", audioStreamIndex: 1, subtitleStreamIndex: -1 }, audioOptions: [], subtitleOptions: [], chapterOptions: [] }
            overlay = m.top.callFunc("openOverlay", { id: "mediaOptions", componentName: "MediaOptionsDialog", openFunction: "openMediaOptions", closeField: "closeRequested", optionsContext: context })

            m.assertEqual(overlay.optionsContext, context)
            m.assertInvalid(overlay.result)
        end function

        @it("reports settings cancellation and ignores events from the detached dialog")
        function _()
            overlay = m.top.callFunc("openOverlay", { id: "settings", componentName: "SettingsDialog", eventFields: ["themePreviewRequested"], closeField: "closeRequested" })

            m.top.callFunc("closeOverlay")
            m.top.eventRaised = invalid
            overlay.themePreviewRequested = "grey"

            m.assertTrue(m.top.closed.cancelled)
            m.assertEqual(m.top.closed.request.id, "settings")
            m.assertInvalid(m.top.closed.overlay)
            m.assertInvalid(m.top.eventRaised)
        end function

        @it("passes explicit account context to the Settings owner")
        function _()
            overlay = m.top.callFunc("openOverlay", { id: "settings", componentName: "SettingsDialog", accountKey: "account", server: "https://server", token: "test-token", userId: "user" })
            m.assertEqual(overlay.server, "https://server")
            m.assertEqual(overlay.token, "test-token")
            m.assertEqual(overlay.userId, "user")
            m.assertEqual(overlay.accountKey, "account")
        end function

        @it("discards edits and reports cancellation when a media overlay is replaced")
        function _()
            context = { item: { Id: "movie-1" }, selection: { videoMode: "automatic", audioStreamIndex: 1, subtitleStreamIndex: -1 }, audioOptions: [], subtitleOptions: [], chapterOptions: [] }
            overlay = m.top.callFunc("openOverlay", { id: "mediaOptions", componentName: "MediaOptionsDialog", openFunction: "openMediaOptions", closeField: "closeRequested", optionsContext: context })
            content = overlay.callFunc("getContentComponent")
            content.findNode("categories").itemFocused = 1
            content.findNode("optionList").itemSelected = 3

            m.top.callFunc("openOverlay", { id: "description", componentName: "DescriptionDialog", title: "Overview", text: "Replacement" })

            m.assertInvalid(overlay.result)
            m.assertTrue(m.top.closed.cancelled)
            m.assertEqual(m.top.closed.request.id, "mediaOptions")
        end function

        @it("routes a home-video result after removing its overlay")
        function _()
            item = { Id: "home-1", Type: "Video", UserData: { PlaybackPositionTicks: 20000000& } }
            request = HomeVideoPlayback.CreateOverlayRequest(item, "http://server", "home")
            overlay = m.top.callFunc("openOverlay", request)
            content = overlay.callFunc("getContentComponent")

            content.findNode("toolbar").playSelected = true

            m.assertInvalid(m.node.activeOverlay)
            m.assertEqual(m.top.closed.request.sourcePage, "home")
            m.assertEqual(m.top.closed.overlay.selectedVideo.startPositionTicks, 20000000&)
        end function

        @it("passes the explicit session to the log dialog")
        function _()
            m.top.callFunc("closeOverlay", false)
            overlay = m.top.callFunc("openOverlay", { id: "logs", componentName: "LogDialog", server: "https://fixture", token: "fixture-token", userId: "fixture-user" })

            m.assertEqual(overlay.server, "https://fixture")
            m.assertEqual(overlay.token, "fixture-token")
            m.assertEqual(overlay.userId, "fixture-user")
            m.top.callFunc("closeOverlay", false)
        end function

        @it("notifies cancellation when a log dialog is replaced")
        function _()
            m.top.callFunc("closeOverlay", false)
            initialChildCount = m.top.getChildCount()
            overlay = m.top.callFunc("openOverlay", { id: "logs", componentName: "LogDialog", openFunction: "openLogs" })
            m.top.closed = invalid
            m.top.callFunc("closeOverlay")

            m.assertTrue(m.top.closed.cancelled)
            m.assertEqual(m.top.closed.request.id, "logs")
            m.assertInvalid(overlay.findNode("uploadTask").request)
            m.assertInvalid(overlay.getParent())
            m.assertEqual(m.top.getChildCount(), initialChildCount)
        end function

        @it("passes a message title through opening and updates")
        function _()
            m.top.callFunc("closeOverlay", false)
            overlay = m.top.callFunc("openOverlay", { id: "message", componentName: "MessageDialog", openFunction: "openMessage", message: "Saved", title: "Log Sent to Jellyfin" })
            m.assertEqual(overlay.title, "Log Sent to Jellyfin")

            m.top.callFunc("updateOverlay", { id: "message", message: "More information", title: "Message" })
            m.assertEqual(overlay.findNode("titleLabel").text, "Message")
            m.top.callFunc("closeOverlay", false)
        end function

        @describe("interval picker payload")

        @it("passes the selected interval to the picker")
        function _()
            'bs:disable-next-line 1140
            overlay = openOverlay({ id: "nextEpisodePromptPicker", componentName: "NextEpisodePromptDialog", value: "75", openFunction: "openPicker", closeField: "closeRequested" })

            m.assertEqual(overlay.value, "75")
            content = overlay.callFunc("getContentComponent")
            m.assertEqual(content.findNode("promptOptions").checkedItem, 5)
            'bs:disable-next-line 1140
            closeOverlay(false)
        end function

        @it("passes only the captured trailer request to the dialog")
        function _()
            request = { id: "trailers", componentName: "TrailerDialog", trailerRequest: { item: { Id: "parent" }, server: "https://server", token: "token", userId: "user" } }
            overlay = m.top.callFunc("openOverlay", request)

            m.assertEqual(overlay.trailerRequest, request.trailerRequest)
            m.top.callFunc("closeOverlay")
            m.assertEqual(m.top.getChildCount(), m.fixtureChildCount)
        end function

        @describe("active trailer teardown through the host")

        @it("stops local playback and both spinners when the host removes the dialog")
        function _()
            session = m.startLocalTrailer()

            m.top.callFunc("closeOverlay")

            m.assertEqual(m.top.getChildCount(), m.fixtureChildCount)
            m.assertInvalid(session.overlay.getParent())
            m.assertInvalid(session.player.getParent())
            m.assertEqual(session.player.findNode("video").control, "stop")
            m.assertInvalid(session.player.findNode("video").content)
            m.assertEqual(session.overlay.findNode("trailerSpinner").control, "stop")
            m.assertFalse(session.overlay.findNode("trailerSpinner").visible)
            m.assertEqual(session.player.findNode("loading").control, "stop")
            m.assertFalse(session.player.findNode("loading").visible)
            m.assertEqual(session.overlay.cleanupSessions, ["host-session"])
        end function

        @it("does not repeat local cleanup after repeated host closure and late completion")
        function _()
            session = m.startLocalTrailer()
            m.top.callFunc("closeOverlay")

            m.top.callFunc("closeOverlay")
            session.player.ended = { playbackId: session.playbackId, reason: "completed", message: "", hasStarted: true }
            session.player.findNode("video").state = "finished"

            m.assertEqual(session.overlay.cleanupSessions, ["host-session"])
            m.assertEqual(m.top.getChildCount(), m.fixtureChildCount)
            m.assertFalse(session.overlay.findNode("dialog").visible)
            m.assertFalse(session.player.visible)
        end function

        @it("cleans active local playback when another overlay replaces the trailer dialog")
        function _()
            session = m.startLocalTrailer()

            replacement = m.top.callFunc("openOverlay", { id: "description", componentName: "DescriptionDialog", title: "Replacement", text: "Details" })
            session.player.ended = { playbackId: session.playbackId, reason: "completed", message: "", hasStarted: true }

            m.assertEqual(m.top.getChildCount(), m.fixtureChildCount + 1)
            m.assertTrue(m.top.getChild(m.fixtureChildCount).isSameNode(replacement))
            m.assertInvalid(session.overlay.getParent())
            m.assertInvalid(session.player.getParent())
            m.assertEqual(session.player.findNode("video").control, "stop")
            m.assertEqual(session.player.findNode("loading").control, "stop")
            m.assertEqual(session.overlay.findNode("trailerSpinner").control, "stop")
            m.assertEqual(session.overlay.cleanupSessions, ["host-session"])

            m.top.callFunc("closeOverlay", false)
        end function

        @it("stops the discovery spinner when the host removes a loading trailer dialog")
        function _()
            m.top.callFunc("closeOverlay", false)
            overlay = m.top.callFunc("openOverlay", m.trailerRequest())
            catalogTask = overlay.findNode("TrailerCatalogTask")
            m.assertTrue(overlay.findNode("trailerSpinner").visible)

            m.top.callFunc("closeOverlay")
            catalogTask.response = { requestId: catalogTask.request.requestId, ok: true, items: [] }

            m.assertFalse(overlay.findNode("trailerSpinner").visible)
            m.assertEqual(overlay.findNode("trailerSpinner").control, "stop")
            m.assertFalse(overlay.findNode("dialog").visible)
            m.assertEqual(m.top.getChildCount(), m.fixtureChildCount)
        end function

        private function trailerRequest() as object
            return { id: "trailers", componentName: "TrailerDialogTestHarness", openFunction: "openTrailers", closeField: "closeRequested", trailerRequest: { item: { Id: "parent" }, server: "https://server", token: "token", userId: "user" } }
        end function

        private function startLocalTrailer() as object
            m.top.callFunc("closeOverlay", false)
            m.stubCall(AppMessage.Dismiss, invalid)
            overlay = m.top.callFunc("openOverlay", m.trailerRequest())
            catalogTask = overlay.findNode("TrailerCatalogTask")
            catalogTask.response = { requestId: catalogTask.request.requestId, ok: true, items: [{ key: "local:local", source: "local", item: { Id: "local" }, title: "Local", thumbnail: "" }] }
            playbackTask = overlay.findNode("VideoPlaybackInfoTask")
            playbackTask.response = { requestId: playbackTask.request.requestId, ok: true, streamUrl: "https://server/video", streamFormat: "mp4", playSessionId: "host-session" }
            player = invalid
            for each child in overlay.getChildren(-1, 0)
                if child.subtype() = "TrailerPlayback" then player = child
            end for
            m.assertNotInvalid(player)
            player.findNode("video").state = "playing"
            player.findNode("video").state = "buffering"
            m.assertEqual(player.findNode("video").control, "play")
            m.assertTrue(player.findNode("loading").visible)

            return { overlay: overlay, player: player, playbackId: playbackTask.request.requestId }
        end function

        @it("forwards the failed account identity into the reopened picker")
        function _()
            request = {
                id: "accountPicker"
                componentName: "AccountPickerDialog"
                openFunction: "openAccountPicker"
                closeField: "closeRequested"
                initialFocusAccountKey: "b"
                accounts: [{ accountKey: "a", server: "http://one", isActive: true }, { accountKey: "b", server: "http://two" }]
            }

            overlay = m.top.callFunc("openOverlay", request)
            content = overlay.callFunc("getContentComponent")

            m.assertEqual(content.findNode("verticalAccounts").jumpToItem, 1)
            m.assertTrue(content.isInFocusChain())
            m.top.callFunc("closeOverlay")
        end function

    end class

end namespace
