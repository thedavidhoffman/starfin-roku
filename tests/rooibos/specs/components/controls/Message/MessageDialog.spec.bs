namespace tests

    @SGNode("MessageDialog")
    @suite("Message dialog")
    class MessageDialogTests extends rooibos.BaseTestSuite

        @describe("presentation and dismissal")

        @it("opens a centered message with OK focused")
        function _()
            m.top.message = "Unable to load."
            m.top.callFunc("openMessage")

            m.assertEqual(m.top.title, "Message")
            m.assertEqual(m.top.dialogWidth, 800)
            m.assertEqual(m.top.dialogHeight, 420)
            m.assertEqual(m.top.findNode("panel").translation, [560.0, 330.0])
            m.assertTrue(m.top.findNode("okButton").hasFocus())
            m.assertTrue(m.top.findNode("okButton").hasFocusVisual)
        end function

        @it("closes through the acknowledgment event")
        function _()
            m.top.closeRequested = false
            m.top.callFunc("openMessage")
            m.top.findNode("okButton").buttonSelected = true

            m.assertTrue(m.top.closeRequested)
            m.assertFalse(m.top.findNode("dialog").visible)
        end function

        @it("consumes Back and uses the same close path")
        function _()
            m.top.closeRequested = false
            m.top.callFunc("openMessage")
            'bs:disable-next-line 1140
            handled = onKeyEvent("back", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.closeRequested)
            m.assertFalse(m.top.findNode("dialog").visible)
        end function

    end class

end namespace
