namespace tests

    @SGNode("ChevronFooter")
    @suite("ChevronFooter component")
    class ChevronFooterTests extends rooibos.BaseTestSuite

        @describe("ChevronFooter behavior")

        @it("renders a valid direction")
        function _()
            m.top.direction = "LEFT"
            'bs:disable-next-line 1140
            onDirectionChanged()
            m.assertTrue(m.node.chevronIcon.visible)
            m.assertEqual(m.node.chevronIcon.uri, "pkg:/images/icons/chevrons/left.png")
        end function

        @it("hides an invalid direction")
        function _()
            m.top.direction = "diagonal"
            'bs:disable-next-line 1140
            onDirectionChanged()
            m.assertFalse(m.node.chevronIcon.visible)
        end function

        @it("normalizes invalid dimensions")
        function _()
            m.top.iconWidth = 0
            m.top.iconHeight = -1
            'bs:disable-next-line 1140
            onDimensionsChanged()
            m.assertEqual(m.node.chevronIcon.width, 48.0)
            m.assertEqual(m.node.chevronIcon.height, 48.0)
        end function

    end class

end namespace
