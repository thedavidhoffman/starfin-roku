namespace tests

    @SGNode("LabelHeading")
    @suite("LabelHeading component")
    class LabelHeadingTests extends rooibos.BaseTestSuite

        @describe("LabelHeading behavior")

        @it("applies the heading text color")
        function _()
            m.assertEqual(m.top.color, Theme.Get().text.light.primary)
        end function

        @it("applies a heading font")
        function _()
            m.assertNotInvalid(m.top.font)
        end function

    end class

end namespace
