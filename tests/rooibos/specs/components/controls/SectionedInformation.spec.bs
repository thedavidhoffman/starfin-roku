namespace tests

    @SGNode("SectionedInformation")
    @suite("SectionedInformation component")
    class SectionedInformationTests extends rooibos.BaseTestSuite

        @describe("behavior")

        @it("renders section headers and value rows")
        function _()
            m.top.sections = [{ title: "Source", entries: [{ key: "Container", value: "MKV" }] }]
            sheet = m.top.findNode("propertySheet")
            m.assertTrue(m.top.findNode("propertyViewport").clippingRect[2] = 1416)
            m.assertTrue(m.top.findNode("scrollTrack").translation[0] = 1406)
            m.assertTrue(sheet.getChild(0).width = 1388)
            m.assertEqual(sheet.getChild(0).text, "SOURCE")
            m.assertEqual(sheet.getChild(2).text, "CONTAINER")
            m.assertEqual(sheet.getChild(3).text, "MKV")
            m.assertFalse(m.top.findNode("scrollThumb").visible)
        end function

        @it("scrolls overflow and clamps at the bottom")
        function _()
            m.top.sections = m.longSections()
            for i = 1 to 30
                'bs:disable-next-line 1140
                onKeyEvent("down", true)
            end for
            m.assertTrue(m.node.scrollState.offset = m.node.scrollState.contentHeight - 710)
            m.assertTrue(m.top.findNode("scrollThumb").visible)
        end function

        @it("clamps scrolling at the top")
        function _()
            m.top.sections = m.longSections()
            'bs:disable-next-line 1140
            onKeyEvent("up", true)
            m.assertTrue(m.top.findNode("propertySheet").translation[1] = 0)
        end function

        @it("resets scrolling and timers when sections change")
        function _()
            m.top.sections = m.longSections()
            'bs:disable-next-line 1140
            onKeyEvent("down", true)
            m.top.sections = []
            m.assertTrue(m.top.findNode("propertySheet").translation[1] = 0)
            m.assertEqual(m.top.findNode("propertySheet").getChildCount(), 0)
            m.assertFalse(m.top.findNode("scrollThumb").visible)
            m.assertEqual(m.top.findNode("scrollHoldDelayTimer").control, "stop")
        end function

        @it("expands wrapped values to avoid overlapping rows")
        function _()
            value = ""
            for i = 1 to 30
                value += "long directory name/"
            end for
            m.top.sections = [{ title: "Source", entries: [{ key: "Path", value: value, wrap: true }, { key: "Next", value: "After path" }] }]
            sheet = m.top.findNode("propertySheet")
            m.assertTrue(sheet.getChild(3).height > 36)
            m.assertTrue(sheet.getChild(5).translation[1] > sheet.getChild(3).translation[1] + sheet.getChild(3).height)
        end function

        @describe("scroll controls")

        @it("starts the hold timer for pressed Down")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("down", true)

            m.assertTrue(handled)
            m.assertEqual(m.top.findNode("scrollHoldDelayTimer").control, "start")
        end function

        @it("stops timers when held Down is released")
        function _()
            'bs:disable-next-line 1140
            onKeyEvent("down", true)

            'bs:disable-next-line 1140
            handled = onKeyEvent("down", false)

            m.assertTrue(handled)
            m.assertEqual(m.top.findNode("scrollHoldDelayTimer").control, "stop")
            m.assertEqual(m.top.findNode("scrollRepeatTimer").control, "stop")
        end function

        @it("consumes released Up without a held key")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("up", false)

            m.assertTrue(handled)
        end function

        @it("ignores unrelated pressed keys")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("back", true)

            m.assertFalse(handled)
        end function

        @it("repeats scrolling after the hold delay")
        function _()
            m.top.sections = m.longSections()
            'bs:disable-next-line 1140
            onKeyEvent("down", true)
            'bs:disable-next-line 1140
            onScrollHoldDelayTimerFire()
            'bs:disable-next-line 1140
            onScrollRepeatTimerFire()

            m.assertEqual(m.top.findNode("scrollRepeatTimer").control, "start")
            m.assertTrue(m.node.scrollState.offset = 216)
            'bs:disable-next-line 1140
            onKeyEvent("down", false)
        end function

        @it("stops held scrolling when focus leaves the content")
        function _()
            m.top.setFocus(true)
            'bs:disable-next-line 1140
            onKeyEvent("down", true)

            m.top.setFocus(false)
            'bs:disable-next-line 1140
            onFocusChanged()

            m.assertEqual(m.node.scrollState.heldKey, "")
            m.assertEqual(m.top.findNode("scrollHoldDelayTimer").control, "stop")
            m.assertEqual(m.top.findNode("scrollRepeatTimer").control, "stop")
        end function

        function longSections() as object
            entries = []
            for i = 1 to 40
                entries.Push({ key: "Row", value: i.ToStr() })
            end for
            return [{ title: "Long section", entries: entries }]
        end function

    end class

end namespace
