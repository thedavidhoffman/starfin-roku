namespace tests

    @SGNode("ProgressBar")
    @suite("ProgressBar component")
    class ProgressBarTests extends rooibos.BaseTestSuite

        @describe("ProgressBar behavior")

        @it("renders its default track and zero progress on construction")
        function _()
            bar = CreateObject("roSGNode", "ProgressBar")

            m.assertEqual(bar.findNode("border").width, 232.0)
            m.assertEqual(bar.findNode("border").height, 12.0)
            m.assertEqual(bar.findNode("background").width, 230.0)
            m.assertEqual(bar.findNode("fill").height, 10.0)
            m.assertEqual(bar.findNode("fill").width, 0.0)
        end function

        @it("reclamps progress when the track shrinks")
        function _()
            bar = CreateObject("roSGNode", "ProgressBar")
            bar.progressWidth = 150

            bar.barWidth = 100

            m.assertEqual(bar.findNode("background").width, 100.0)
            m.assertEqual(bar.findNode("fill").width, 100.0)
        end function

        @it("lays out the border track and fill height")
        function _()
            bar = CreateObject("roSGNode", "ProgressBar")

            bar.barWidth = 100
            bar.barHeight = 18

            m.assertEqual(bar.findNode("border").width, 102.0)
            m.assertEqual(bar.findNode("border").height, 20.0)
            m.assertEqual(bar.findNode("background").width, 100.0)
            m.assertEqual(bar.findNode("fill").height, 18.0)
        end function

        @it("expands positive progress to the minimum visible width")
        function _()
            bar = CreateObject("roSGNode", "ProgressBar")

            bar.barWidth = 100
            bar.barHeight = 10
            bar.progressWidth = 4

            m.assertEqual(bar.findNode("fill").width, 10.0)
        end function

        @it("clamps progress above the bar width")
        function _()
            bar = CreateObject("roSGNode", "ProgressBar")

            bar.barWidth = 100
            bar.progressWidth = 200

            m.assertEqual(bar.findNode("fill").width, 100.0)
        end function

        @it("clamps negative progress to zero")
        function _()
            bar = CreateObject("roSGNode", "ProgressBar")

            bar.progressWidth = -1

            m.assertEqual(bar.findNode("fill").width, 0.0)
        end function

    end class

end namespace
