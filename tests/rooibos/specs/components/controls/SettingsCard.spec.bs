namespace tests

    @SGNode("SettingsCard")
    @suite("SettingsCard component")
    class SettingsCardTests extends rooibos.BaseTestSuite

        @describe("presentation")

        @it("renders the supplied title in uppercase")
        function _()
            m.top.title = "Subtitle mode"
            m.assertEqual(m.top.findNode("heading").text, "SUBTITLE MODE")
        end function

        @it("sizes the glass and description from the card height")
        function _()
            m.top.cardHeight = 376
            m.top.description = "Description"
            m.assertEqual(m.top.findNode("background").height, 370.0)
            m.assertEqual(m.top.findNode("descriptionLabel").translation, [24.0, 330.0])
            m.assertTrue(m.top.findNode("descriptionLabel").visible)
        end function

        @it("hides an absent description")
        function _()
            m.top.description = "Description"
            m.top.description = ""
            m.assertFalse(m.top.findNode("descriptionLabel").visible)
        end function

        @it("lays out a content radio list with equal focus margins")
        function _()
            options = CreateObject("roSGNode", "RadioButtonList")
            options.translation = [0, 68]
            options.itemSize = [0, 52]
            m.top.appendChild(options)

            m.top.cardWidth = 1160
            m.top.callFunc("updateCard")

            m.assertEqual(options.translation, [56.0, 68.0])
            m.assertEqual(options.itemSize, [1048.0, 52.0])
            m.assertEqual(options.translation[0] - 32, 24.0)
            m.assertEqual(m.top.cardWidth - options.translation[0] - options.itemSize[0] - 32, 24.0)
        end function

        @it("resizes radio content when the card width changes")
        function _()
            options = CreateObject("roSGNode", "RadioButtonList")
            options.translation = [56, 64]
            options.itemSize = [1048, 44]
            m.top.appendChild(options)
            m.top.cardWidth = 1160

            m.top.cardWidth = 1040

            m.assertEqual(options.itemSize, [928.0, 44.0])
            m.assertEqual(options.translation, [56.0, 64.0])
            m.assertEqual(m.top.findNode("heading").width, 992.0)
            m.assertEqual(m.top.findNode("descriptionLabel").width, 992.0)
        end function

    end class

end namespace
