namespace tests

    @SGNode("SquareButton")
    @suite("SquareButton component")
    class SquareButtonTests extends rooibos.BaseTestSuite

        protected override function beforeEach()
            m.originalTheme = m.global.theme
            m.originalProfile = m.global.resolutionProfile
            if not m.global.hasField("resolutionProfile") then m.global.addField("resolutionProfile", "assocarray", false)
            m.global.resolutionProfile = { resolution: "fhd" }
            m.global.theme = "blue"
            m.top.itemWidth = 64
            m.top.isSelected = false
            m.top.setFocus(false)
            m.top.itemHasFocus = false
        end function

        protected override function afterEach()
            m.global.resolutionProfile = m.originalProfile
            m.global.theme = m.originalTheme
        end function

        @describe("theme rendering")

        @it("initializes with blue assets")
        function _()
            m.global.theme = "blue"

            button = createObject("roSGNode", "SquareButton")

            m.assertEqual(button.findNode("background").uri, "pkg:/images/themes/blue/square-button-background.png")
        end function

        @it("updates focused text for blue without losing focus")
        function _()
            m.top.focusable = true
            m.top.setFocus(true)

            m.global.theme = "blue"

            m.assertEqual(m.top.findNode("letterLabel").color, &h0F1A2AFF)
            m.assertTrue(m.top.findNode("focusBackground").visible)
            m.assertTrue(m.top.hasFocus())
        end function

        @it("updates a selected wide button for blue")
        function _()
            m.top.itemWidth = 120
            m.top.isSelected = true
            m.top.itemHasFocus = false

            m.global.theme = "blue"

            m.assertEqual(m.top.findNode("background").blendColor, &h092452FF)
            m.assertEqual(m.top.findNode("background").uri, "pkg:/images/buttons/fhd/primary-focused.9.png")
            m.assertEqual(m.top.findNode("letterLabel").color, &h0F1A2AFF)
            m.assertTrue(m.top.isSelected)
            m.assertTrue(m.top.findNode("selectedBackground").visible)
            m.assertEqual(m.top.findNode("selectedBackground").opacity, 0.55)
        end function

        @it("initializes with black assets")
        function _()
            m.global.theme = "black"

            button = createObject("roSGNode", "SquareButton")

            m.assertEqual(button.findNode("background").uri, "pkg:/images/themes/black/square-button-background.png")
        end function

        @it("updates focused text for black without losing focus")
        function _()
            m.top.focusable = true
            m.top.setFocus(true)

            m.global.theme = "black"

            m.assertEqual(m.top.findNode("letterLabel").color, &h121212FF)
            m.assertTrue(m.top.findNode("focusBackground").visible)
            m.assertTrue(m.top.hasFocus())
        end function

        @it("updates a selected wide button for black")
        function _()
            m.top.itemWidth = 120
            m.top.isSelected = true
            m.top.itemHasFocus = false

            m.global.theme = "black"

            m.assertEqual(m.top.findNode("background").blendColor, &h262626FF)
            m.assertEqual(m.top.findNode("background").uri, "pkg:/images/buttons/fhd/primary-focused.9.png")
            m.assertEqual(m.top.findNode("letterLabel").color, &h121212FF)
            m.assertTrue(m.top.isSelected)
            m.assertTrue(m.top.findNode("selectedBackground").visible)
            m.assertEqual(m.top.findNode("selectedBackground").opacity, 0.55)
        end function

        @it("initializes with grey assets")
        function _()
            m.global.theme = "grey"

            button = createObject("roSGNode", "SquareButton")

            m.assertEqual(button.findNode("background").uri, "pkg:/images/themes/grey/square-button-background.png")
        end function

        @it("updates focused text for grey without losing focus")
        function _()
            m.top.focusable = true
            m.top.setFocus(true)

            m.global.theme = "grey"

            m.assertEqual(m.top.findNode("letterLabel").color, &h242424FF)
            m.assertTrue(m.top.findNode("focusBackground").visible)
            m.assertTrue(m.top.hasFocus())
        end function

        @it("updates a selected wide button for grey")
        function _()
            m.top.itemWidth = 120
            m.top.isSelected = true
            m.top.itemHasFocus = false

            m.global.theme = "grey"

            m.assertEqual(m.top.findNode("background").blendColor, &h4A4A4AFF)
            m.assertEqual(m.top.findNode("background").uri, "pkg:/images/buttons/fhd/primary-focused.9.png")
            m.assertEqual(m.top.findNode("letterLabel").color, &h242424FF)
            m.assertTrue(m.top.isSelected)
            m.assertTrue(m.top.findNode("selectedBackground").visible)
            m.assertEqual(m.top.findNode("selectedBackground").opacity, 0.55)
        end function

        @it("restores square assets when a wide grey button shrinks")
        function _()
            m.global.theme = "grey"
            m.top.itemWidth = 120

            m.top.itemWidth = 64

            m.assertEqual(m.top.findNode("background").uri, "pkg:/images/themes/grey/square-button-background.png")
            m.assertEqual(m.top.findNode("background").blendColor, &hFFFFFFFF)
            m.assertEqual(m.top.findNode("focusBackground").uri, "pkg:/images/library/letter-tile-highlight.png")
        end function

        @it("uses hd assets when a black button widens")
        function _()
            m.global.resolutionProfile = { resolution: "hd" }
            m.global.theme = "black"

            m.top.itemWidth = 120

            m.assertEqual(m.top.findNode("background").uri, "pkg:/images/buttons/hd/primary-focused.9.png")
            m.assertEqual(m.top.findNode("background").blendColor, &h262626FF)
        end function

        @it("returns an existing tile to blue for an unsupported theme")
        function _()
            m.global.theme = "black"

            m.global.theme = "unknown"

            m.assertEqual(m.top.findNode("background").uri, "pkg:/images/themes/blue/square-button-background.png")
        end function

        @describe("declarative component contract")

        @it("declares the background node")
        function _()
            m.assertNotInvalid(m.top.findNode("background"))
        end function

        @it("declares the selectedBackground node")
        function _()
            m.assertNotInvalid(m.top.findNode("selectedBackground"))
        end function

        @it("declares the focusBackground node")
        function _()
            m.assertNotInvalid(m.top.findNode("focusBackground"))
        end function

        @it("declares the letterLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("letterLabel"))
        end function

        @describe("content")

        @it("renders the item title")
        function _()
            item = CreateObject("roSGNode", "ContentNode")
            item.title = "A"

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("letterLabel").text, "A")
        end function

        @it("applies a custom item width")
        function _()
            m.top.itemWidth = 120

            m.assertEqual(m.top.findNode("background").width, 120.0)
            m.assertEqual(m.top.findNode("letterLabel").width, 119.0)
        end function

        @describe("visual state")

        @it("shows the focus background while focused")
        function _()
            m.top.itemHasFocus = true

            m.assertTrue(m.top.findNode("focusBackground").visible)
        end function

        @it("shows selection without focus")
        function _()
            m.top.itemHasFocus = false
            m.top.isSelected = true

            m.assertTrue(m.top.findNode("selectedBackground").visible)
        end function

        @it("hides selection behind the focus visual")
        function _()
            m.top.isSelected = true
            m.top.itemHasFocus = true

            m.assertFalse(m.top.findNode("selectedBackground").visible)
        end function

        @it("uses the focused text color while focused")
        function _()
            m.top.itemHasFocus = true

            m.assertEqual(m.top.findNode("letterLabel").color, &h0F1A2AFF)
        end function

        @it("uses the focused text color while selected without focus")
        function _()
            m.top.itemHasFocus = false
            m.top.isSelected = true

            m.assertEqual(m.top.findNode("letterLabel").color, &h0F1A2AFF)
        end function

        @it("uses the normal text color without focus or selection")
        function _()
            m.top.itemHasFocus = false
            m.top.isSelected = false

            m.assertEqual(m.top.findNode("letterLabel").color, &hF3F7FBFF)
        end function

        @it("synchronizes the focus visual when used as a focusable button")
        function _()
            m.top.focusable = true

            m.top.setFocus(true)

            m.assertTrue(m.top.itemHasFocus)
            m.assertTrue(m.top.findNode("focusBackground").visible)
        end function

        @describe("selection keys")

        @it("selects on pressed OK")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("OK", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.buttonSelected)
        end function

        @it("selects on pressed Select")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("Select", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.buttonSelected)
        end function

        @it("ignores released keys")
        function _()
            m.top.buttonSelected = false

            'bs:disable-next-line 1140
            handled = onKeyEvent("OK", false)

            m.assertFalse(handled)
            m.assertFalse(m.top.buttonSelected)
        end function

        @it("ignores unrelated pressed keys")
        function _()
            m.top.buttonSelected = false

            'bs:disable-next-line 1140
            handled = onKeyEvent("Right", true)

            m.assertFalse(handled)
            m.assertFalse(m.top.buttonSelected)
        end function

    end class

end namespace
