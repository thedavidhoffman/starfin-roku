namespace tests

    @SGNode("SquareButton")
    @suite("SquareButton component")
    class SquareButtonTests extends rooibos.BaseTestSuite

        @describe("declarative component contract")

        @it("declares the background node")
        function _()
            m.assertNotInvalid(m.top.findNode("background"))
        end function

        @it("declares the selectedBackground node")
        function _()
            m.assertNotInvalid(m.top.findNode("selectedBackground"))
        end function

        @it("declares the focusBackground node")
        function _()
            m.assertNotInvalid(m.top.findNode("focusBackground"))
        end function

        @it("declares the letterLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("letterLabel"))
        end function

        @describe("content")

        @it("renders the item title")
        function _()
            item = CreateObject("roSGNode", "ContentNode")
            item.title = "A"

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("letterLabel").text, "A")
        end function

        @it("applies a custom item width")
        function _()
            m.top.itemWidth = 120

            m.assertEqual(m.top.findNode("background").width, 120.0)
            m.assertEqual(m.top.findNode("letterLabel").width, 119.0)
        end function

        @describe("visual state")

        @it("shows the focus background while focused")
        function _()
            m.top.itemHasFocus = true

            m.assertTrue(m.top.findNode("focusBackground").visible)
        end function

        @it("shows selection without focus")
        function _()
            m.top.itemHasFocus = false
            m.top.isSelected = true

            m.assertTrue(m.top.findNode("selectedBackground").visible)
        end function

        @it("hides selection behind the focus visual")
        function _()
            m.top.isSelected = true
            m.top.itemHasFocus = true

            m.assertFalse(m.top.findNode("selectedBackground").visible)
        end function

        @it("uses the focused text color while focused")
        function _()
            m.top.itemHasFocus = true

            m.assertEqual(m.top.findNode("letterLabel").color, &h0F1A2AFF)
        end function

        @it("uses the focused text color while selected without focus")
        function _()
            m.top.itemHasFocus = false
            m.top.isSelected = true

            m.assertEqual(m.top.findNode("letterLabel").color, &h0F1A2AFF)
        end function

        @it("uses the normal text color without focus or selection")
        function _()
            m.top.itemHasFocus = false
            m.top.isSelected = false

            m.assertEqual(m.top.findNode("letterLabel").color, &hF3F7FBFF)
        end function

        @it("synchronizes the focus visual when used as a focusable button")
        function _()
            m.top.focusable = true

            m.top.setFocus(true)

            m.assertTrue(m.top.itemHasFocus)
            m.assertTrue(m.top.findNode("focusBackground").visible)
        end function

        @describe("selection keys")

        @it("selects on pressed OK")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("OK", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.buttonSelected)
        end function

        @it("selects on pressed Select")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("Select", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.buttonSelected)
        end function

        @it("ignores released keys")
        function _()
            m.top.buttonSelected = false

            'bs:disable-next-line 1140
            handled = onKeyEvent("OK", false)

            m.assertFalse(handled)
            m.assertFalse(m.top.buttonSelected)
        end function

        @it("ignores unrelated pressed keys")
        function _()
            m.top.buttonSelected = false

            'bs:disable-next-line 1140
            handled = onKeyEvent("Right", true)

            m.assertFalse(handled)
            m.assertFalse(m.top.buttonSelected)
        end function

    end class

end namespace
