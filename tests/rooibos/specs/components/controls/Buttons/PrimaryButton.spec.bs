namespace tests

    @SGNode("PrimaryButton")
    @suite("PrimaryButton component")
    class PrimaryButtonTests extends rooibos.BaseTestSuite

        @describe("PrimaryButton behavior")

        @it("initializes XML defaults and required child nodes (case 1)")
        function _()
            m.assertEqual(m.top.buttonWidth, 300.0)
        end function

        @it("initializes XML defaults and required child nodes (case 2)")
        function _()
            m.assertEqual(m.top.buttonHeight, 56.0)
        end function

        @it("initializes XML defaults and required child nodes (case 3)")
        function _()
            m.assertEqual(m.top.textFont, "font:MediumSystemFont")
        end function

        @it("initializes XML defaults and required child nodes (case 4)")
        function _()
            m.assertEqual(m.top.textHeight, 32.0)
        end function

        @it("initializes XML defaults and required child nodes (case 5)")
        function _()
            m.assertEqual(m.top.iconGap, 12.0)
        end function

        @it("initializes XML defaults and required child nodes (case 6)")
        function _()
            m.assertNotInvalid(m.node.background)
        end function

        @it("initializes XML defaults and required child nodes (case 7)")
        function _()
            m.assertNotInvalid(m.node.iconPoster)
        end function

        @it("initializes XML defaults and required child nodes (case 8)")
        function _()
            m.assertNotInvalid(m.node.textLabel)
        end function

        @it("initializes XML defaults and required child nodes (case 9)")
        function _()
            m.assertEqual(m.node.background.uri, "pkg:/images/buttons/fhd/primary-unfocused.9.png")
        end function

        @it("updates text and text-only dimensions")
        function _()
            m.top.text = "Continue"
            m.top.buttonWidth = 240
            m.top.buttonHeight = 64
            m.top.textHeight = 30
            m.top.iconUri = ""

            'bs:disable-next-line 1140
            onTextChanged()
            'bs:disable-next-line 1140
            onDimensionsChanged()

            m.assertEqual(m.node.textLabel.text, "Continue")
            m.assertEqual(m.node.background.width, 240.0)
            m.assertEqual(m.node.background.height, 64.0)
            m.assertEqual(m.node.textLabel.height, 30.0)
            m.assertEqual(m.node.textLabel.width, 240.0)
            m.assertEqual(m.node.textLabel.translation, [0.0, 17.0])
            m.assertEqual(m.node.textLabel.horizAlign, "center")
            m.assertFalse(m.node.iconPoster.visible)
        end function

        @it("uses normal and focused icon URIs")
        function _()
            m.top.iconUri = "pkg:/images/icons/play-light.png"
            m.top.focusedIconUri = "pkg:/images/icons/play-dark.png"
            m.top.hasFocusVisual = false
            'bs:disable-next-line 1140
            onIconUriChanged()
            m.assertTrue(m.node.iconPoster.visible)
            m.assertEqual(m.node.iconPoster.uri, "pkg:/images/icons/play-light.png")

            m.top.hasFocusVisual = true
            'bs:disable-next-line 1140
            onIconUriChanged()
            m.assertEqual(m.node.iconPoster.uri, "pkg:/images/icons/play-dark.png")
            m.assertEqual(m.node.iconPoster.width, 24.0)
            m.assertEqual(m.node.iconPoster.height, 24.0)
        end function

        @it("renders focused and unfocused visual states")
        function _()
            m.top.hasFocusVisual = true
            'bs:disable-next-line 1140
            onFocusVisualChanged()
            m.assertEqual(m.node.background.uri, "pkg:/images/buttons/fhd/primary-focused.9.png")
            m.assertEqual(m.node.textLabel.color, &h0F1A2AFF)

            m.top.hasFocusVisual = false
            'bs:disable-next-line 1140
            onFocusVisualChanged()
            m.assertEqual(m.node.background.uri, "pkg:/images/buttons/fhd/primary-unfocused.9.png")
            m.assertEqual(m.node.textLabel.color, &hFFFFFFFF)
        end function

        @it("normalizes dimensions and handles selection keys")
        function _()
            m.top.buttonWidth = 0
            m.top.buttonHeight = -1
            'bs:disable-next-line 1140
            onDimensionsChanged()
            m.assertEqual(m.node.background.width, 300.0)
            m.assertEqual(m.node.background.height, 56.0)

            m.top.buttonSelected = false
            'bs:disable-next-line 1140
            m.assertFalse(onKeyEvent("OK", false))
            'bs:disable-next-line 1140
            m.assertFalse(onKeyEvent("left", true))
            m.assertFalse(m.top.buttonSelected)
            'bs:disable-next-line 1140
            m.assertTrue(onKeyEvent("OK", true))
            m.assertTrue(m.top.buttonSelected)
        end function

        @describe("measured text layout")

        @it("preserves the minimum text width for an empty label")
        function _()
            m.top.text = "Resume S3:E20"
            m.top.text = ""

            width = m.top.callFunc("getPreferredWidth", 30)

            m.assertEqual(width, 61)
        end function

        private function naturalWidth(text as string, font as dynamic) as float
            label = CreateObject("roSGNode", "Label")
            label.font = font
            label.text = text
            return label.boundingRect().width
        end function

        @it("distinguishes narrow and wide glyphs with the same character count")
        function _()
            m.top.textFont = "font:MediumSystemFont"
            m.top.text = "iiii"
            narrow = m.top.callFunc("getPreferredWidth", 30)
            m.top.text = "WWWW"
            wide = m.top.callFunc("getPreferredWidth", 30)

            m.assertTrue(wide > narrow)
            measured = m.naturalWidth("WWWW", m.node.textLabel.font)
            m.assertTrue(wide >= measured + 60)
            m.assertTrue(wide < measured + 61)
        end function

        @it("recalculates layout after changing the font")
        function _()
            m.top.buttonWidth = 600
            m.top.iconUri = "pkg:/images/icons/play-light.png"
            m.top.text = "Resume"
            m.top.textFont = "font:SmallestSystemFont"
            small = m.node.textLabel.width
            m.top.textFont = "font:LargeSystemFont"

            m.assertTrue(m.node.textLabel.width > small)
            m.assertTrue(m.node.textLabel.width >= m.naturalWidth("Resume", m.node.textLabel.font))
        end function

        @it("fits Play and its icon inside the existing button dimensions")
        function _()
            m.top.textFont = "font:SmallestSystemFont"
            m.top.buttonWidth = 120
            m.top.buttonHeight = 48
            m.top.textHeight = 26
            m.top.iconGap = 6
            m.top.contentOffsetX = 2
            m.top.iconUri = "pkg:/images/icons/play-light.png"
            m.top.text = "Play"

            measured = m.naturalWidth("Play", m.node.textLabel.font)
            m.assertTrue(measured > 0)
            m.assertTrue(m.node.textLabel.width >= measured)
            m.assertTrue(m.node.textLabel.translation[0] + m.node.textLabel.width <= 120)
            m.assertEqual(m.node.textLabel.translation[0] - m.node.iconPoster.translation[0], 30.0)
            m.assertEqual(m.node.background.width, 120.0)
        end function

        @it("fits Resume and its icon inside the existing button dimensions")
        function _()
            m.top.textFont = "font:SmallestSystemFont"
            m.top.buttonWidth = 165
            m.top.buttonHeight = 48
            m.top.textHeight = 26
            m.top.iconGap = 6
            m.top.contentOffsetX = -2
            m.top.iconUri = "pkg:/images/icons/play-light.png"
            m.top.text = "Resume"

            measured = m.naturalWidth("Resume", m.node.textLabel.font)
            m.assertTrue(measured > 0)
            m.assertTrue(m.node.textLabel.width >= measured)
            m.assertTrue(m.node.textLabel.translation[0] + m.node.textLabel.width <= 165)
            m.assertEqual(m.node.textLabel.translation[0] - m.node.iconPoster.translation[0], 30.0)
            m.assertEqual(m.node.background.width, 165.0)
        end function

        @it("fits Random and its icon inside the existing button dimensions")
        function _()
            m.top.textFont = "font:SmallestSystemFont"
            m.top.buttonWidth = 165
            m.top.buttonHeight = 48
            m.top.textHeight = 26
            m.top.iconGap = 6
            m.top.contentOffsetX = 3
            m.top.iconUri = "pkg:/images/icons/play-light.png"
            m.top.text = "Random"

            measured = m.naturalWidth("Random", m.node.textLabel.font)
            m.assertTrue(measured > 0)
            m.assertTrue(m.node.textLabel.width >= measured)
            m.assertTrue(m.node.textLabel.translation[0] + m.node.textLabel.width <= 165)
            m.assertEqual(m.node.textLabel.translation[0] - m.node.iconPoster.translation[0], 30.0)
            m.assertEqual(m.node.background.width, 165.0)
        end function

        @it("constrains genuinely oversized text without enlarging the button")
        function _()
            m.top.buttonWidth = 120
            m.top.iconUri = "pkg:/images/icons/play-light.png"
            m.top.iconGap = 6
            m.top.contentOffsetX = 0
            m.top.text = "A very long button label"

            m.assertEqual(m.node.background.width, 120.0)
            m.assertEqual(m.node.textLabel.width, 66.0)
            m.assertTrue(m.node.textLabel.translation[0] + m.node.textLabel.width <= 120)
        end function

    end class

end namespace
