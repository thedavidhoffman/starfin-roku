namespace tests

    @SGNode("HeaderButton")
    @suite("HeaderButton component")
    class HeaderButtonTests extends rooibos.BaseTestSuite

        @describe("HeaderButton behavior")

        @it("initializes XML defaults and required child nodes (case 1)")
        function _()
            m.assertEqual(m.top.buttonWidth, 300.0)
        end function

        @it("initializes XML defaults and required child nodes (case 2)")
        function _()
            m.assertEqual(m.top.buttonHeight, 56.0)
        end function

        @it("initializes XML defaults and required child nodes (case 3)")
        function _()
            m.assertEqual(m.top.textAlign, "center")
        end function

        @it("initializes XML defaults and required child nodes (case 4)")
        function _()
            m.assertEqual(m.top.headerBgColor, &h12112BFF)
        end function

        @it("initializes XML defaults and required child nodes (case 5)")
        function _()
            m.assertNotInvalid(m.node.background)
        end function

        @it("initializes XML defaults and required child nodes (case 6)")
        function _()
            m.assertNotInvalid(m.node.textLabel)
        end function

        @it("initializes XML defaults and required child nodes (case 7)")
        function _()
            m.assertEqual(m.node.background.uri, "pkg:/images/buttons/fhd/header-button-focused.9.png")
        end function

        @it("updates text and lays it out from component fields")
        function _()
            m.top.text = "Browse"
            m.top.buttonWidth = 220
            m.top.buttonHeight = 80
            m.top.textInset = 12
            m.top.textAlign = "left"

            'bs:disable-next-line 1140
            onTextChanged()
            'bs:disable-next-line 1140
            onDimensionsChanged()
            'bs:disable-next-line 1140
            onTextLayoutChanged()

            m.assertEqual(m.node.textLabel.text, "Browse")
            m.assertEqual(m.node.background.width, 220.0)
            m.assertEqual(m.node.background.height, 80.0)
            m.assertEqual(m.node.textLabel.horizAlign, "left")
            m.assertEqual(m.node.textLabel.width, 196.0)
            m.assertEqual(m.node.textLabel.translation, [12.0, 26.0])
        end function

        @it("normalizes unsupported alignment and invalid dimensions")
        function _()
            m.top.buttonWidth = 0
            m.top.buttonHeight = -1
            m.top.textAlign = "diagonal"

            'bs:disable-next-line 1140
            onDimensionsChanged()
            'bs:disable-next-line 1140
            onTextLayoutChanged()

            m.assertEqual(m.node.background.width, 300.0)
            m.assertEqual(m.node.background.height, 56.0)
            m.assertEqual(m.node.textLabel.horizAlign, "center")
        end function

        @it("centers an icon and text together when an icon is supplied")
        function _()
            m.top.text = "Account"
            m.top.buttonWidth = 194
            m.top.iconWidth = 26
            m.top.iconUri = "pkg:/images/icons/header/account.png"

            'bs:disable-next-line 1140
            onTextChanged()
            'bs:disable-next-line 1140
            onIconUriChanged()

            icon = m.node.iconPoster
            label = m.node.textLabel
            contentWidth = 26 + 10 + label.width
            m.assertTrue(icon.visible)
            m.assertEqual(icon.uri, m.top.iconUri)
            m.assertEqual(icon.width, 26.0)
            m.assertEqual(icon.height, 22.0)
            m.assertEqual(icon.translation[1], 17.0)
            m.assertEqual(label.horizAlign, "left")
            m.assertEqual(label.translation[0] - icon.translation[0], 36.0)
            m.assertTrue(Abs(icon.translation[0] - Number.ToInteger((194 - contentWidth) / 2, 0)) < 0.01)
        end function

        @it("restores text-only layout when an icon is removed")
        function _()
            m.top.text = "Browse"
            m.top.buttonWidth = 220
            m.top.textInset = 0
            m.top.iconUri = "pkg:/images/icons/header/home.png"
            m.top.iconUri = ""

            'bs:disable-next-line 1140
            onIconUriChanged()

            m.assertFalse(m.node.iconPoster.visible)
            m.assertEqual(m.node.textLabel.horizAlign, "center")
            m.assertEqual(m.node.textLabel.width, 220.0)
            m.assertEqual(m.node.textLabel.translation[0], 0.0)
        end function

        @it("left-aligns an icon and text within the configured inset")
        function _()
            m.top.buttonWidth = 260
            m.top.textInset = 18
            m.top.textAlign = "left"
            m.top.iconWidth = 25
            m.top.iconSlotWidth = 30
            m.top.iconUri = "pkg:/images/icons/header/settings.png"
            m.top.text = "Settings"

            'bs:disable-next-line 1140
            onTextChanged()
            'bs:disable-next-line 1140
            onIconUriChanged()

            m.assertTrue(Abs(m.node.iconPoster.translation[0] + m.node.iconPoster.width / 2 - 33) <= 1)
            m.assertEqual(m.node.textLabel.translation[0], 58.0)
            m.assertEqual(m.node.textLabel.horizAlign, "left")
        end function

        @it("renders focused active and inactive visual states")
        function _()
            m.top.hasFocusVisual = true
            m.top.hasActiveVisual = false
            'bs:disable-next-line 1140
            onFocusVisualChanged()
            m.assertTrue(m.node.background.visible)
            m.assertEqual(m.node.background.opacity, 1.0)
            m.assertEqual(m.node.textLabel.color, &h12112BFF)
            m.assertEqual(m.node.iconPoster.blendColor, &h12112BFF)

            m.top.hasFocusVisual = false
            m.top.hasActiveVisual = true
            'bs:disable-next-line 1140
            onFocusVisualChanged()
            m.assertTrue(m.node.background.visible)
            m.assertEqual(m.node.background.opacity, 0.58)
            m.assertEqual(m.node.textLabel.color, &h12112BFF)
            m.assertEqual(m.node.iconPoster.blendColor, &h12112BFF)

            m.top.hasActiveVisual = false
            'bs:disable-next-line 1140
            onFocusVisualChanged()
            m.assertFalse(m.node.background.visible)
            m.assertEqual(m.node.background.opacity, 1.0)
            m.assertEqual(m.node.textLabel.color, &hFFFFFFFF)
            m.assertEqual(m.node.iconPoster.blendColor, &hFFFFFFFF)
        end function

        @it("emits selection only for pressed selection keys")
        function _()
            m.top.buttonSelected = false
            'bs:disable-next-line 1140
            m.assertFalse(onKeyEvent("OK", false))
            m.assertFalse(m.top.buttonSelected)
            'bs:disable-next-line 1140
            m.assertFalse(onKeyEvent("left", true))
            m.assertFalse(m.top.buttonSelected)

            'bs:disable-next-line 1140
            m.assertTrue(onKeyEvent("OK", true))
            m.assertTrue(m.top.buttonSelected)

            m.top.buttonSelected = false
            'bs:disable-next-line 1140
            m.assertTrue(onKeyEvent("select", true))
            m.assertTrue(m.top.buttonSelected)
        end function

    end class

end namespace
