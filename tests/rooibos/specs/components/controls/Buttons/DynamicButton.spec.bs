namespace tests

    @SGNode("DynamicButton")
    @suite("DynamicButton component")
    class DynamicButtonTests extends rooibos.BaseTestSuite

        @describe("declarative component contract")

        @it("declares the background node")
        function _()
            m.assertNotInvalid(m.top.findNode("background"))
        end function

        @it("declares the iconPoster node")
        function _()
            m.assertNotInvalid(m.top.findNode("iconPoster"))
        end function

        @it("declares the textLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("textLabel"))
        end function

        @describe("content rendering")

        @it("renders button text")
        function _()
            m.top.text = "Play"

            'bs:disable-next-line 1140
            onTextChanged()

            m.assertEqual(m.node.textLabel.text, "Play")
        end function

        @it("renders the normal icon without focus")
        function _()
            m.top.hasFocusVisual = false
            m.top.icon = "pkg:/images/icons/play.png"

            'bs:disable-next-line 1140
            onIconChanged()

            m.assertEqual(m.node.iconPoster.uri, "pkg:/images/icons/play.png")
        end function

        @it("renders the focused icon when supplied")
        function _()
            m.top.focusedIcon = "pkg:/images/icons/play-dark.png"
            m.top.hasFocusVisual = true

            'bs:disable-next-line 1140
            onIconChanged()

            m.assertEqual(m.node.iconPoster.uri, "pkg:/images/icons/play-dark.png")
        end function

        @it("falls back to the normal icon when the focused icon is empty")
        function _()
            m.top.icon = "pkg:/images/icons/play.png"
            m.top.focusedIcon = ""
            m.top.hasFocusVisual = true

            'bs:disable-next-line 1140
            onIconChanged()

            m.assertEqual(m.node.iconPoster.uri, "pkg:/images/icons/play.png")
        end function

        @describe("focus visuals")

        @it("expands and reveals text with focus")
        function _()
            m.top.expandedWidth = 180
            m.top.hasFocusVisual = true

            'bs:disable-next-line 1140
            onFocusVisualChanged()

            m.assertTrue(m.node.background.width = 180)
            m.assertTrue(m.node.textLabel.visible)
        end function

        @it("uses the default expanded width when the override is non-positive")
        function _()
            m.top.expandedWidth = 0
            m.top.hasFocusVisual = true

            'bs:disable-next-line 1140
            onFocusVisualChanged()

            m.assertTrue(m.node.background.width = 168)
        end function

        @it("collapses and hides text without focus")
        function _()
            m.top.hasFocusVisual = false

            'bs:disable-next-line 1140
            onFocusVisualChanged()

            m.assertTrue(m.node.background.width = 64)
            m.assertFalse(m.node.textLabel.visible)
        end function

        @describe("measured expanded width")

        @it("clears a previous measurement when the label becomes empty")
        function _()
            m.top.icon = "pkg:/images/icons/play.png"
            m.top.expandedWidth = 64
            m.top.text = "Resume S3:E20"

            m.top.text = ""

            m.assertEqual(m.top.preferredWidth, 84)
        end function

        @it("fits the complete resume episode label using its actual font")
        function _()
            m.top.expandedWidth = 195
            m.top.text = "Resume S3:E20"
            m.top.hasFocusVisual = true
            reference = CreateObject("roSGNode", "Label")
            reference.font = m.node.textLabel.font
            reference.text = "Resume S3:E20"

            m.assertTrue(m.node.textLabel.width >= reference.boundingRect().width)
            m.assertEqual(m.node.textLabel.text, "Resume S3:E20")
            m.assertTrue(m.node.background.width = m.top.preferredWidth)
            m.assertTrue(m.top.preferredWidth > 195)
        end function

        @it("measures different glyph widths for equal length strings")
        function _()
            m.top.expandedWidth = 64
            m.top.text = "iiiiiiii"
            narrowWidth = m.top.preferredWidth

            m.top.text = "WWWWWWWW"

            m.assertTrue(m.top.preferredWidth > narrowWidth)
        end function

        @it("shrinks to the configured minimum after a long label becomes short")
        function _()
            m.top.expandedWidth = 195
            m.top.hasFocusVisual = true
            m.top.text = "Resume S123:E456"
            longWidth = m.top.preferredWidth

            m.top.text = "Play"

            m.assertTrue(longWidth > m.top.preferredWidth)
            m.assertEqual(m.top.preferredWidth, 195)
            m.assertEqual(m.node.background.width, 195.0)
        end function

        @it("updates the minimum width without changing text")
        function _()
            m.top.text = "Play"
            m.top.hasFocusVisual = true

            m.top.expandedWidth = 500

            m.assertEqual(m.top.preferredWidth, 500)
            m.assertEqual(m.node.background.width, 500.0)
        end function

        @it("keeps long labels collapsed until focused")
        function _()
            m.top.hasFocusVisual = false
            m.top.text = "Resume S123:E456"

            m.assertEqual(m.node.background.width, 64.0)
            m.assertFalse(m.node.textLabel.visible)
            m.assertTrue(m.top.preferredWidth > 195)
        end function

        @describe("selection")

        @it("emits selection for a pressed OK key")
        function _()
            m.top.buttonSelected = false

            'bs:disable-next-line 1140
            handled = onKeyEvent("OK", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.buttonSelected)
        end function

        @it("emits selection for a pressed Select key")
        function _()
            m.top.buttonSelected = false

            'bs:disable-next-line 1140
            handled = onKeyEvent("select", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.buttonSelected)
        end function

        @it("ignores released selection keys")
        function _()
            m.top.buttonSelected = false

            'bs:disable-next-line 1140
            handled = onKeyEvent("OK", false)

            m.assertFalse(handled)
            m.assertFalse(m.top.buttonSelected)
        end function

        @it("ignores unrelated pressed keys")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("left", true)

            m.assertFalse(handled)
        end function

        @describe("persistent text")

        @it("shows text without an icon when unfocused")
        function _()
            m.top.icon = ""
            m.top.focusedIcon = ""
            m.top.expandedWidth = 64
            m.top.maxWidth = 0
            m.top.alwaysShowText = true
            m.top.text = "1080p H.264"
            m.top.hasFocusVisual = false

            m.assertTrue(m.node.textLabel.visible)
            m.assertFalse(m.node.iconPoster.visible)
            m.assertEqual(m.node.textLabel.translation[0], 16.0)
            m.assertEqual(m.node.textLabel.color, &hF3F7FBFF)
        end function

        @it("keeps persistent text width on focus changes")
        function _()
            m.top.expandedWidth = 64
            m.top.maxWidth = 0
            m.top.alwaysShowText = true
            m.top.text = "1080p H.264"
            m.top.hasFocusVisual = false
            width = m.node.background.width

            m.top.hasFocusVisual = true

            m.assertEqual(m.node.background.width, width)
            m.assertEqual(m.node.textLabel.color, &h0F1A2AFF)
        end function

        @it("caps long persistent labels")
        function _()
            m.top.expandedWidth = 64
            m.top.maxWidth = 0
            m.top.alwaysShowText = true
            m.top.maxWidth = 640
            m.top.text = String(100, "W")

            m.assertEqual(m.top.preferredWidth, 640)
            m.assertEqual(m.node.background.width, 640.0)
            m.assertTrue(m.node.textLabel.width < 640)
        end function

        @it("shrinks a persistent label after metadata changes")
        function _()
            m.top.expandedWidth = 64
            m.top.maxWidth = 0
            m.top.alwaysShowText = true
            m.top.text = "4K HEVC Dolby Vision • TrueHD 7.1"
            width = m.top.preferredWidth

            m.top.text = "Media Info"

            m.assertTrue(m.top.preferredWidth < width)
            m.assertTrue(m.node.background.width = m.top.preferredWidth)
        end function

        @describe("text-only alignment")

        @it("centers unfocused text inside equal horizontal insets")
        function _()
            m.top.icon = ""
            m.top.focusedIcon = ""
            m.top.alwaysShowText = true
            m.top.text = "1080p H.264"
            m.top.hasFocusVisual = false

            label = m.node.textLabel
            m.assertEqual(label.horizAlign, "center")
            m.assertTrue(label.translation[0] = (m.node.background.width - label.width) / 2)
        end function

        @it("keeps focused text centered without changing button width")
        function _()
            m.top.icon = ""
            m.top.focusedIcon = ""
            m.top.alwaysShowText = true
            m.top.text = "1080p H.264"
            m.top.hasFocusVisual = false
            width = m.node.background.width

            m.top.hasFocusVisual = true

            m.assertEqual(m.node.textLabel.horizAlign, "center")
            m.assertEqual(m.node.background.width, width)
        end function

        @it("restores left alignment when an icon is supplied")
        function _()
            m.top.icon = ""
            m.top.focusedIcon = ""
            m.top.hasFocusVisual = true

            m.top.icon = "pkg:/images/icons/media-toolbar/play-light.png"

            m.assertEqual(m.node.textLabel.horizAlign, "left")
            m.assertEqual(m.node.textLabel.translation[0], 60.0)
        end function

    end class

end namespace
