namespace tests

    @SGNode("WatchedBadge")
    @suite("WatchedBadge component")
    class WatchedBadgeTests extends rooibos.BaseTestSuite

        protected override function beforeEach()
            m.originalStyle = m.global.watchedIndicatorStyle
        end function

        protected override function afterEach()
            m.global.watchedIndicatorStyle = m.originalStyle
        end function

        @describe("live artwork")

        @it("initializes from the current style")
        function _()
            m.global.watchedIndicatorStyle = "high-contrast"

            badge = CreateObject("roSGNode", "WatchedBadge")

            m.assertEqual(badge.uri, "pkg:/images/icons/watched-check-high-contrast.png")
        end function

        @it("updates an existing badge to high contrast")
        function _()
            m.global.watchedIndicatorStyle = "subtle"

            m.global.watchedIndicatorStyle = "high-contrast"

            m.assertEqual(m.top.uri, "pkg:/images/icons/watched-check-high-contrast.png")
        end function

        @it("returns an existing badge to subtle")
        function _()
            m.global.watchedIndicatorStyle = "high-contrast"

            m.global.watchedIndicatorStyle = "subtle"

            m.assertEqual(m.top.uri, "pkg:/images/icons/watched-check.png")
        end function

        @it("falls back for an invalid style")
        function _()
            m.global.watchedIndicatorStyle = "unknown"

            m.assertEqual(m.top.uri, "pkg:/images/icons/watched-check.png")
        end function

    end class

end namespace
