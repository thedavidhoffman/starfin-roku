namespace tests

    @SGNode("ScreensaverOverlay")
    @suite("ScreensaverOverlay component")
    class ScreensaverOverlayTests extends rooibos.BaseTestSuite

        @describe("session lifecycle")

        @it("starts the configured Starfin screensaver delay")
        function _()
            m.setSettings("bounce", "5")
            'bs:disable-next-line 1140
            startDelay()
            m.assertTrue(m.node.screensaverState.enabled)
            m.assertEqual(m.node.screensaverDelayTimer.duration.ToStr(), "300")

        end function

        @it("disables the overlay for the legacy Roku setting")
        function _()
            m.setSettings("roku", "1")
            'bs:disable-next-line 1140
            startDelay()

            m.assertFalse(m.node.screensaverState.enabled)
            m.assertEqual(m.node.screensaverState.type, "none")
            m.assertEqual(m.node.screensaverDelayTimer.control, "stop")
        end function

        @it("renders bouncing artwork when its delay fires")
        function _()
            m.setSettings("bounce", "1")
            'bs:disable-next-line 1140
            startDelay()

            'bs:disable-next-line 1140
            onScreensaverDelayTimerFired()

            m.assertEqual(m.node.screensaverLayer.getChildCount(), 1)
            m.assertEqual(m.node.screensaverLayer.getChild(0).subtype(), "Bounce")
        end function

        @it("renders Starfield when its delay fires")
        function _()
            m.setSettings("starfield", "1")
            'bs:disable-next-line 1140
            startDelay()

            'bs:disable-next-line 1140
            onScreensaverDelayTimerFired()

            m.assertEqual(m.node.screensaverLayer.getChildCount(), 1)
            m.assertEqual(m.node.screensaverLayer.getChild(0).subtype(), "Starfield")
        end function

        @it("dismisses an active screensaver and restarts its delay")
        function _()
            m.setSettings("bounce", "1")
            'bs:disable-next-line 1140
            startDelay()
            m.node.screensaverState.activeNode = true
            'bs:disable-next-line 1140
            m.assertTrue(isVisible())

            'bs:disable-next-line 1140
            wasVisible = recordActivity()

            m.assertTrue(wasVisible)
            'bs:disable-next-line 1140
            m.assertFalse(isVisible())
            m.assertTrue(m.node.screensaverState.enabled)
        end function

        @it("fully stops the session and ignores later activity")
        function _()
            m.setSettings("bounce", "1")
            'bs:disable-next-line 1140
            startDelay()
            'bs:disable-next-line 1140
            stopOverlay()

            m.assertFalse(m.node.screensaverState.enabled)

            'bs:disable-next-line 1140
            wasVisible = recordActivity()
            m.assertFalse(wasVisible)
            m.assertFalse(m.node.screensaverState.enabled)
        end function

        private sub setSettings(screensaverType as string, delay as string)
            settings = {}
            settings[SettingsStore.Key.ScreensaverType] = screensaverType
            settings[SettingsStore.Key.ScreensaverDelay] = delay
            m.node.top.settings = settings
        end sub

    end class

end namespace
