namespace tests

    @SGNode("ArtistTask")
    @suite("ArtistTask component")
    class ArtistTaskTests extends rooibos.BaseTestSuite

        @describe("request validation")

        @it("rejects an invalid request without performing network work")
        function _()
            m.node.top.request = invalid

            'bs:disable-next-line 1140
            executeRequest()

            m.assertFalse(m.node.top.response.ok)
        end function

        @it("accepts a complete request")
        function _()
            request = { artistId: "artist-id" }

            'bs:disable-next-line 1140
            m.assertInvalid(validateRequest(request))
        end function

        @it("preserves metadata HTTP failure details and artist correlation")
        function _()
            failure = { ok: false, status: 429, failureKind: "rateLimited", authExpired: false, responseText: "diagnostic body", errorMessage: "Too Many Requests" }

            'bs:disable-next-line 1140
            response = buildErrorResponse("artist-id", failure.errorMessage, failure)

            m.assertEqual(response.action, "musicArtist")
            m.assertEqual(response.artistId, "artist-id")
            m.assertEqual(response.failureKind, "rateLimited")
            m.assertEqual(response.status, 429)
            m.assertFalse(response.authExpired)
            m.assertEqual(response.responseText, "diagnostic body")
            m.assertEqual(response.errorMessage, "Too Many Requests")
        end function

    end class

end namespace
