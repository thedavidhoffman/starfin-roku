namespace tests

    @SGNode("MusicFilterOptionsTask")
    @suite("MusicFilterOptionsTask component")
    class MusicFilterOptionsTaskTests extends rooibos.BaseTestSuite

        @describe("request validation")

        @it("rejects an invalid request without performing network work")
        function _()
            m.node.top.request = invalid

            'bs:disable-next-line 1140
            executeRequest()

            m.assertFalse(m.node.top.response.ok)
        end function

        @describe("filter option construction")

        @it("deduplicates decades and sorts genres")
        function _()
            'bs:disable-next-line 1140
            result = buildFilterOptions({ Years: [1991, 1999, 2001, 0], Genres: [" Rock ", "", "Blues"] })
            m.assertEqual(result.decadeOptions.Count(), 2)
            m.assertEqual(result.decadeOptions[0].value, 1990)
            m.assertEqual(result.decadeOptions[1].value, 2000)
            m.assertEqual(result.genreOptions[0].value, "Blues")
            m.assertEqual(result.genreOptions[1].value, "Rock")
        end function

    end class

end namespace
