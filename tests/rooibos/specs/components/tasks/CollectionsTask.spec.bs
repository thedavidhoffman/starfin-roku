namespace tests

    @SGNode("CollectionsTask")
    @suite("CollectionsTask component")
    class CollectionsTaskTests extends rooibos.BaseTestSuite

        @describe("request validation")

        @it("rejects a missing request")
        function _()
            m.node.top.request = invalid

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "collections")
            m.assertEqual(response.errorMessage, "Invalid request.")
        end function

        @it("rejects a missing user ID")
        function _()
            m.node.top.request = { server: "server", token: "token", libraryId: "library" }

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "collections")
            m.assertEqual(response.errorMessage, "Invalid request userId.")
            m.assertEqual(response.libraryId, "library")
            m.assertEqual(response.mode, "load")
        end function

        @it("rejects a missing library ID")
        function _()
            m.node.top.request = { server: "server", token: "token", userId: "user" }

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "collections")
            m.assertEqual(response.errorMessage, "Invalid request libraryId.")
            m.assertEqual(response.libraryId, "")
            m.assertEqual(response.mode, "load")
        end function

        @describe("collection request options")

        @it("uses defaults and applies explicit collection options")
        function _()
            request = { fields: "", sortBy: "", sortOrder: "", recursive: true, includeItemTypes: "BoxSet" }
            'bs:disable-next-line 1140
            m.assertEqual(getFields(request), "PrimaryImageAspectRatio,SortName,Tags")
            'bs:disable-next-line 1140
            m.assertEqual(getSortBy(request), "IsFolder,SortName")
            'bs:disable-next-line 1140
            m.assertEqual(getSortOrder(request), "Ascending")
            params = {}
            'bs:disable-next-line 1140
            addOptionalQueryParams(params, request)
            m.assertTrue(params.recursive)
            m.assertEqual(params.includeItemTypes, "BoxSet")
        end function

    end class

end namespace
