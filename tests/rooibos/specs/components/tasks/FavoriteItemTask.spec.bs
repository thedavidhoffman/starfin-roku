namespace tests

    @SGNode("FavoriteItemTask")
    @suite("FavoriteItemTask component")
    class FavoriteItemTaskTests extends rooibos.BaseTestSuite

        @describe("request validation")

        @it("rejects a missing request")
        function _()
            m.node.top.request = invalid

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "")
            m.assertEqual(response.errorMessage, "Invalid request.")
        end function

        @it("rejects a missing user ID")
        function _()
            m.node.top.request = { action: "AddToFavorites", server: "server", token: "token", itemId: "item" }

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "AddToFavorites")
            m.assertEqual(response.errorMessage, "Invalid request userId.")
        end function

        @it("rejects a missing item ID")
        function _()
            m.node.top.request = { action: "AddToFavorites", server: "server", token: "token", userId: "user" }

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "AddToFavorites")
            m.assertEqual(response.errorMessage, "Invalid request itemId.")
        end function

        @it("rejects an unknown action")
        function _()
            m.node.top.request = { action: "Unknown", server: "server", token: "token", userId: "user", itemId: "item" }

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "Unknown")
            m.assertEqual(response.errorMessage, "Unknown favorite request action.")
        end function

    end class

end namespace
