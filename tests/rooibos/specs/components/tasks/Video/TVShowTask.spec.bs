            m.assertTrue(Instr(1, requestUrl, "ismissing=false") > 0)
            m.assertTrue(Instr(1, requestUrl, "fields=SeriesInfo%2CPeople%2CUserData") > 0)
            m.assertTrue(Instr(1, requestUrl, "seasonid=season") > 0)
            m.assertTrue(Instr(1, requestUrl, "limit=1") > 0)
            m.assertTrue(Instr(1, requestUrl, "startindex=0") > 0)
            m.assertEqual(result.data.People[0].Name, "Actor")
            m.assertTrue(result.data.UserData.Played)
            getGlobalAa().Delete("tvShowReplayRequest")
        end function

