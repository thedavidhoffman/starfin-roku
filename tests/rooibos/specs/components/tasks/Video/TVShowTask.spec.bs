        protected override function afterEach()
            getGlobalAa().Delete("tvShowReplay")
        end function

        sub stubReplayEpisodes(results as object)
            pagesBySeason = {}
            for each seasonId in results
                pages = results[seasonId]
                if Type(pages) <> "roArray" then pages = [pages]
                pagesBySeason[seasonId] = pages
            end for
            getGlobalAa().tvShowReplay = { results: pagesBySeason, requests: [], pages: [] }
            m.stubCall(HttpClient.Request, function(requestUrl, method, token, body, headers, displayRequest, timeoutMs)
                fixture = getGlobalAa().tvShowReplay
                fixture.requests.Push(requestUrl)
                query = {}
                for each parameter in requestUrl.Tokenize("?")[1].Tokenize("&")
                    parts = parameter.Tokenize("=")
                    query[parts[0]] = parts[1]
                end for
                startIndex = Number.ToInteger(query.startindex, 0)
                fixture.pages.Push({ seasonId: query.seasonid, startIndex: startIndex, limit: Number.ToInteger(query.limit, 0) })
                pages = fixture.results[query.seasonid]
                if Type(pages) = "roArray" then
                    if startIndex < pages.Count() then return pages[startIndex]
                end if
                return { ok: true, data: { Items: [] } }
            end function)
        end sub

        function createRequest() as object
            return { server: "http://server", token: "token", userId: "user", itemId: "series", playbackOnly: true, requestId: 11 }
        end function

        function prepareEmptyTargets() as object
            'bs:disable-next-line 1001
            m.stubCall(loadSeries, { ok: true, data: { Id: "series" } })
            'bs:disable-next-line 1001
            m.stubCall(loadSeasons, { ok: true, data: { Items: [{ Id: "season" }] } })
            'bs:disable-next-line 1001
            m.stubCall(loadResumeItem, { ok: true, data: { Items: [] } })
            'bs:disable-next-line 1001
            m.stubCall(loadUpNextItem, { ok: true, data: { Items: [] } })
            return m.createRequest()
        end function

        @describe("episode cast metadata")

        @it("requests and preserves People for the Play target")
        function _()
            getGlobalAa().tvShowCastRequest = ""
            m.stubCall(HttpClient.Request, function(requestUrl, method, token, body, headers, displayRequest, timeoutMs)
                getGlobalAa().tvShowCastRequest = requestUrl
