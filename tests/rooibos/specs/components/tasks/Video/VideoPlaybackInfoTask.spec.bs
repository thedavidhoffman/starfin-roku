        @it("builds direct video URLs without query credentials")
        function _()
            request = { server: "https://server", token: "secret", itemId: "movie-1" }
            playbackInfo = { PlaySessionId: "session-1", MediaSources: [{ Id: "source-1", Container: "mp4", SupportsDirectPlay: true }] }
            flags = { enableDirectPlay: true, enableDirectStream: true, enableTranscoding: true }

            'bs:disable-next-line 1140
            result = buildStreamInfo(request, playbackInfo, -1, -1, flags)

            m.assertTrue(result.ok)
            m.assertEqual(result.playbackMethod, "DirectPlay")
            parts = result.streamUrl.Split("?")
            parameters = LCase(parts[1]).Split("&")
            parameters.Sort()
            m.assertEqual(parts[0], "https://server/Videos/movie-1/stream")
            m.assertEqual(parameters, ["container=mp4", "mediasourceid=source-1", "playsessionid=session-1", "static=true", "subtitlestreamindex=-1"])
            m.assertTrue(Instr(1, LCase(result.streamUrl), "playsessionid=session-1") > 0)
        end function

        @describe("Resolved stream authentication")

        @it("uses the supplied HTTP path for direct movie playback")
        function _()
            request = { server: "https://server/base", token: "session-token", itemId: "movie", item: { Type: "Movie" } }
            playbackInfo = { MediaSources: [{ SupportsDirectPlay: true, Protocol: "Http", Container: "mp4", Path: "https://server/movie.mp4?ApiKey=server-token&x=a%26b#cue" }] }

            'bs:disable-next-line 1140
            stream = buildStreamInfo(request, playbackInfo, -1, -1, { enableDirectPlay: true })
            mediaRequest = JellyfinAuth.BuildMediaRequest(request.server, stream.streamUrl, request.token)

            m.assertEqual(mediaRequest.url, "https://server/movie.mp4?ApiKey=server-token&x=a%26b#cue")
            m.assertEqual(mediaRequest.headers.Count(), 1)
            m.assertEqual(stream.playbackMethod, "DirectPlay")
        end function

        @it("preserves external network-relative HLS URLs through stream selection")
        function _()
            request = { server: "https://server/base", token: "secret", itemId: "movie" }
            playbackInfo = { MediaSources: [{ Id: "source", TranscodingUrl: "//cdn.test/master.m3u8" }] }

            'bs:disable-next-line 1140
            stream = buildStreamInfo(request, playbackInfo, -1, -1, { enableDirectPlay: false, enableDirectStream: true, enableTranscoding: true })
            mediaRequest = JellyfinAuth.BuildMediaRequest(request.server, stream.streamUrl, request.token)

            m.assertTrue(stream.ok)
            m.assertEqual(mediaRequest.url, "https://cdn.test/master.m3u8")
            m.assertEqual(mediaRequest.headers.Count(), 0)
        end function

