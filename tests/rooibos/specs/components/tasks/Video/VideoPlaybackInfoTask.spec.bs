namespace tests

    @SGNode("VideoPlaybackInfoTask")
    @suite("VideoPlaybackInfoTask component")
    class VideoPlaybackInfoTaskTests extends rooibos.BaseTestSuite

        @describe("request validation")

        @it("rejects a missing request")
        function _()
            m.node.top.request = invalid

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "playbackInfo")
            m.assertEqual(response.errorMessage, "Invalid request.")
            m.assertEqual(response.requestId, -1)
        end function

        @it("rejects a missing item ID")
        function _()
            m.node.top.request = { server: "server", token: "token", requestId: 17 }

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "playbackInfo")
            m.assertEqual(response.errorMessage, "Invalid request itemId.")
            m.assertEqual(response.requestId, 17)
        end function

        @describe("playback request policy")

        @it("selects playback flags for automatic and forced modes")
        function _()
            'bs:disable-next-line 1140
            automatic = getPlaybackFlags("automatic", false, false, false)
            m.assertTrue(automatic.enableDirectPlay)
            m.assertTrue(automatic.enableDirectStream)
            m.assertTrue(automatic.enableTranscoding)
            'bs:disable-next-line 1140
            forced = getPlaybackFlags("automatic", true, false, false)
            m.assertFalse(forced.enableDirectPlay)
            m.assertFalse(forced.enableDirectStream)
            m.assertTrue(forced.enableTranscoding)
            'bs:disable-next-line 1140
            noRemux = getPlaybackFlags("transcode-no-remux", false, false, false)
            m.assertFalse(noRemux.enableDirectPlay)
            m.assertFalse(noRemux.enableDirectStream)
        end function

        @it("resolves stream indexes and leaves subtitles off until selected")
        function _()
            streams = [
                { Type: "Video", Index: 0, IsDefault: true }
                { Type: "Audio", Index: 3, IsDefault: false }
                { Type: "Audio", Index: 4, IsDefault: true }
            ]
            source = { MediaStreams: streams }
            'bs:disable-next-line 1140
            m.assertEqual(getDefaultAudioStreamIndex(source), 4)
            'bs:disable-next-line 1140
            m.assertEqual(getDefaultVideoStreamIndex(source), 0)
            'bs:disable-next-line 1140
            m.assertEqual(getResolvedAudioStreamIndex(source, 3), 3)
            'bs:disable-next-line 1140
            m.assertEqual(getMediaStreamByIndex(source, "audio", 4).Index, 4)
            source.DefaultSubtitleStreamIndex = 7
            'bs:disable-next-line 1140
            m.assertEqual(getExistingSubtitleStreamIndex(source, -2), -1)
            'bs:disable-next-line 1140
            m.assertEqual(getExistingSubtitleStreamIndex(source, -1), -1)
            'bs:disable-next-line 1140
            m.assertEqual(getExistingSubtitleStreamIndex(source, 9), -1)
            'bs:disable-next-line 1140
            m.assertEqual(getExistingSubtitleStreamIndex(source, 4), -1)
            'bs:disable-next-line 1140
            m.assertEqual(getPlaybackRequestSubtitleStreamIndex({}), -2)
            'bs:disable-next-line 1140
            m.assertEqual(getPlaybackRequestSubtitleStreamIndex({ subtitleStreamIndex: "5" }), 5)

            source.Delete("DefaultSubtitleStreamIndex")
            source.MediaStreams.Push({ Type: "Subtitle", Index: 6, IsDefault: true })
            'bs:disable-next-line 1140
            m.assertEqual(getExistingSubtitleStreamIndex(source, -2), -1)

            source.MediaStreams.Push({
                Type: "Subtitle"
                Index: 7
                Codec: "subrip"
                DeliveryMethod: "External"
                DeliveryUrl: "/Videos/item/Subtitles/7/Stream.srt"
            })
            source.DefaultSubtitleStreamIndex = 7
            'bs:disable-next-line 1140
            m.assertEqual(getExistingSubtitleStreamIndex(source, -2), -1)
            'bs:disable-next-line 1140
            m.assertEqual(getExistingSubtitleStreamIndex(source, 7), 7)
            playbackInfo = { MediaSources: [source] }
            'bs:disable-next-line 1140
            resolvedSubtitleIndex = getExistingSubtitleStreamIndex(source, 7)
            externalTrack = SubtitlePlayback.BuildExternalTrack(playbackInfo, resolvedSubtitleIndex, "https://server.test")
            m.assertEqual(externalTrack.index, 7)
            m.assertEqual(externalTrack.deliveryUrl, "https://server.test/Videos/item/Subtitles/7/Stream.srt")
        end function

        @it("converts requested audio stream indexes")
        function _()
            'bs:disable-next-line 1140
            m.assertEqual(getPlaybackRequestAudioStreamIndex({ audioStreamIndex: "5" }), 5)
            'bs:disable-next-line 1140
            m.assertEqual(getPlaybackRequestAudioStreamIndex({ audioStreamIndex: 3 }), 3)
            'bs:disable-next-line 1140
            m.assertEqual(getPlaybackRequestAudioStreamIndex(invalid), -1)
        end function

        @it("converts media stream indexes and uses the configured fallback")
        function _()
            'bs:disable-next-line 1140
            m.assertEqual(getMediaStreamIndex({ Index: "8" }, -1), 8)
            'bs:disable-next-line 1140
            m.assertEqual(getMediaStreamIndex({ Index: 4 }, -1), 4)
            'bs:disable-next-line 1140
            m.assertEqual(getMediaStreamIndex(invalid, -2), -2)
        end function

        @it("does not request subtitle burn-in when subtitles are off")
        function _()
            'bs:disable-next-line 1140
            shouldBurn = shouldAlwaysBurnSubtitleWhenTranscoding(SubtitleBurnIn.Mode.DuringTranscoding, SubtitleSelection.None)

            m.assertFalse(shouldBurn)
        end function

        @it("does not request subtitle burn-in when subtitle selection is unspecified")
        function _()
            'bs:disable-next-line 1140
            shouldBurn = shouldAlwaysBurnSubtitleWhenTranscoding(SubtitleBurnIn.Mode.DuringTranscoding, -2)

            m.assertFalse(shouldBurn)
        end function

        @it("requests subtitle burn-in during transcoding for a selected track")
        function _()
            'bs:disable-next-line 1140
            shouldBurn = shouldAlwaysBurnSubtitleWhenTranscoding(SubtitleBurnIn.Mode.DuringTranscoding, 5)

            m.assertTrue(shouldBurn)
        end function

        @it("keeps a selected subtitle external when configured")
        function _()
            'bs:disable-next-line 1140
            shouldBurn = shouldAlwaysBurnSubtitleWhenTranscoding(SubtitleBurnIn.Mode.PreferExternal, 5)

            m.assertFalse(shouldBurn)
        end function

        @it("uses encoded delivery for a selected subtitle burned into a transcode")
        function _()
            'bs:disable-next-line 1140
            isEncoded = shouldUseEncodedSubtitleDelivery(true, "Transcode", 5)

            m.assertTrue(isEncoded)
        end function

        @it("does not use encoded delivery for direct play")
        function _()
            'bs:disable-next-line 1140
            isEncoded = shouldUseEncodedSubtitleDelivery(true, "DirectPlay", 5)

            m.assertFalse(isEncoded)
        end function

        @it("does not use encoded delivery when external subtitles are preferred")
        function _()
            'bs:disable-next-line 1140
            isEncoded = shouldUseEncodedSubtitleDelivery(false, "Transcode", 5)

            m.assertFalse(isEncoded)
        end function

        @it("does not use encoded delivery when subtitles are off")
        function _()
            'bs:disable-next-line 1140
            isEncoded = shouldUseEncodedSubtitleDelivery(true, "Transcode", SubtitleSelection.None)

            m.assertFalse(isEncoded)
        end function

        @it("correlates validation failures and normalizes request values")
        function _()
            'bs:disable-next-line 1140
            m.assertEqual(getStartPositionTicks({ startPositionTicks: 55 }), 55&)
        end function

        @it("builds direct video URLs without query credentials")
        function _()
            request = { server: "https://server", token: "secret", itemId: "movie-1" }
            playbackInfo = { PlaySessionId: "session-1", MediaSources: [{ Id: "source-1", Container: "mp4", SupportsDirectPlay: true }] }
            flags = { enableDirectPlay: true, enableDirectStream: true, enableTranscoding: true }

            'bs:disable-next-line 1140
            result = buildStreamInfo(request, playbackInfo, -1, -1, flags)

            m.assertTrue(result.ok)
            m.assertEqual(result.playbackMethod, "DirectPlay")
            parts = result.streamUrl.Split("?")
            parameters = LCase(parts[1]).Split("&")
            parameters.Sort()
            m.assertEqual(parts[0], "https://server/Videos/movie-1/stream")
            m.assertEqual(parameters, ["container=mp4", "mediasourceid=source-1", "playsessionid=session-1", "static=true", "subtitlestreamindex=-1"])
            m.assertTrue(Instr(1, LCase(result.streamUrl), "playsessionid=session-1") > 0)
        end function

        @describe("Resolved stream authentication")

        @it("uses the supplied HTTP path for direct movie playback")
        function _()
            request = { server: "https://server/base", token: "session-token", itemId: "movie", item: { Type: "Movie" } }
            playbackInfo = { MediaSources: [{ SupportsDirectPlay: true, Protocol: "Http", Container: "mp4", Path: "https://server/movie.mp4?ApiKey=server-token&x=a%26b#cue" }] }

            'bs:disable-next-line 1140
            stream = buildStreamInfo(request, playbackInfo, -1, -1, { enableDirectPlay: true })
            mediaRequest = JellyfinAuth.BuildMediaRequest(request.server, stream.streamUrl, request.token)

            m.assertEqual(mediaRequest.url, "https://server/movie.mp4?ApiKey=server-token&x=a%26b#cue")
            m.assertEqual(mediaRequest.headers.Count(), 1)
            m.assertEqual(stream.playbackMethod, "DirectPlay")
        end function

        @it("preserves external network-relative HLS URLs through stream selection")
        function _()
            request = { server: "https://server/base", token: "secret", itemId: "movie" }
            playbackInfo = { MediaSources: [{ Id: "source", TranscodingUrl: "//cdn.test/master.m3u8" }] }

            'bs:disable-next-line 1140
            stream = buildStreamInfo(request, playbackInfo, -1, -1, { enableDirectPlay: false, enableDirectStream: true, enableTranscoding: true })
            mediaRequest = JellyfinAuth.BuildMediaRequest(request.server, stream.streamUrl, request.token)

            m.assertTrue(stream.ok)
            m.assertEqual(mediaRequest.url, "https://cdn.test/master.m3u8")
            m.assertEqual(mediaRequest.headers.Count(), 0)
        end function

        @it("preserves the server HLS URL including its subtitle index and authentication")
        function _()
            request = { server: "https://server", token: "secret", itemId: "movie" }
            playbackInfo = { MediaSources: [{ Id: "source", TranscodingUrl: "/master.m3u8?ApiKey=server-token&SubtitleStreamIndex=1#cue" }] }

            'bs:disable-next-line 1140
            stream = buildStreamInfo(request, playbackInfo, -1, 2, { enableDirectPlay: false, enableDirectStream: true, enableTranscoding: true })
            mediaRequest = JellyfinAuth.BuildMediaRequest(request.server, stream.streamUrl, request.token)

            m.assertTrue(stream.ok)
            m.assertEqual(mediaRequest.url, "https://server/master.m3u8?ApiKey=server-token&SubtitleStreamIndex=1#cue")
            m.assertEqual(mediaRequest.headers.Count(), 1)
        end function

        @it("preserves the base path through stream selection and authentication")
        function _()
            request = { server: "https://server/base/", token: "secret", itemId: "movie" }
            playbackInfo = { MediaSources: [{ Id: "source", TranscodingUrl: "master.m3u8?ApiKey=server-token" }] }

            'bs:disable-next-line 1140
            stream = buildStreamInfo(request, playbackInfo, -1, -2, { enableDirectPlay: false, enableDirectStream: true, enableTranscoding: true })
            mediaRequest = JellyfinAuth.BuildMediaRequest(request.server, stream.streamUrl, request.token)

            m.assertTrue(stream.ok)
            m.assertEqual(mediaRequest.url, "https://server/base/master.m3u8?ApiKey=server-token")
            m.assertEqual(mediaRequest.headers.Count(), 1)
        end function

        @it("preserves server-local Live TV URLs")
        function _()
            request = { server: "https://server/base/", token: "secret", itemId: "live", item: { Type: "TvChannel" } }
            playbackInfo = { MediaSources: [{ SupportsDirectPlay: true, Protocol: "Http", Path: "http://localhost:8096/Videos/live/stream?session=one#cue" }] }

            'bs:disable-next-line 1140
            stream = buildStreamInfo(request, playbackInfo, -1, -1, { enableDirectPlay: true })
            mediaRequest = JellyfinAuth.BuildMediaRequest(request.server, stream.streamUrl, request.token)

            m.assertTrue(stream.ok)
            m.assertEqual(mediaRequest.url, "http://localhost:8096/Videos/live/stream?session=one#cue")
            m.assertEqual(mediaRequest.headers.Count(), 0)
        end function

        @it("preserves loopback Live TV URLs")
        function _()
            request = { server: "https://server/base/", token: "secret", itemId: "live", item: { Type: "TvChannel" } }
            playbackInfo = { MediaSources: [{ SupportsDirectPlay: true, Protocol: "Http", Path: "http://127.0.0.1:8096/Videos/live/stream" }] }

            'bs:disable-next-line 1140
            stream = buildStreamInfo(request, playbackInfo, -1, -1, { enableDirectPlay: true })
            mediaRequest = JellyfinAuth.BuildMediaRequest(request.server, stream.streamUrl, request.token)

            m.assertTrue(stream.ok)
            m.assertEqual(mediaRequest.url, "http://127.0.0.1:8096/Videos/live/stream")
            m.assertEqual(mediaRequest.headers.Count(), 0)
        end function

        @it("preserves external Live TV stream destinations")
        function _()
            request = { server: "https://server/base/", token: "secret", itemId: "live", item: { Type: "TvChannel" } }
            playbackInfo = { MediaSources: [{ SupportsDirectPlay: true, Protocol: "Http", Path: "https://tuner.test/live/stream?signature=provider" }] }

            'bs:disable-next-line 1140
            stream = buildStreamInfo(request, playbackInfo, -1, -1, { enableDirectPlay: true })
            mediaRequest = JellyfinAuth.BuildMediaRequest(request.server, stream.streamUrl, request.token)

            m.assertTrue(stream.ok)
            m.assertEqual(mediaRequest.url, "https://tuner.test/live/stream?signature=provider")
            m.assertEqual(mediaRequest.headers.Count(), 0)
        end function

    end class

end namespace
