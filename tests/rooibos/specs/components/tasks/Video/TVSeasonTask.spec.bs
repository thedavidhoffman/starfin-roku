namespace tests

    @SGNode("TVSeasonTask")
    @suite("TVSeasonTask component")
    class TVSeasonTaskTests extends rooibos.BaseTestSuite

        @describe("request validation")

        @it("rejects a missing request")
        function _()
            m.node.top.request = invalid

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "tvSeason")
            m.assertEqual(response.errorMessage, "Invalid request.")
        end function

        @it("rejects a missing series ID")
        function _()
            m.node.top.request = { server: "server", token: "token", seasonId: "season", requestId: 7 }

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "tvSeason")
            m.assertEqual(response.errorMessage, "Invalid request seriesId.")
            m.assertEqual(response.seriesId, "")
            m.assertEqual(response.seasonId, "season")
            m.assertEqual(response.requestId, 7)
        end function

        @it("rejects a missing season ID")
        function _()
            m.node.top.request = { server: "server", token: "token", seriesId: "series", requestId: 8 }

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "tvSeason")
            m.assertEqual(response.errorMessage, "Invalid request seasonId.")
            m.assertEqual(response.seriesId, "series")
            m.assertEqual(response.seasonId, "")
            m.assertEqual(response.requestId, 8)
        end function

    end class

end namespace
