namespace tests

    @SGNode("ThemeAudioPlaybackInfoTask")
    @suite("ThemeAudioPlaybackInfoTask component")
    class ThemeAudioPlaybackInfoTaskTests extends rooibos.BaseTestSuite

        @describe("request validation")

        @it("rejects a missing request")
        function _()
            m.node.top.request = invalid

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "themeAudioPlaybackInfo")
            m.assertEqual(response.errorMessage, "Invalid request.")
        end function

        @it("rejects a missing item ID")
        function _()
            m.node.top.request = { server: "server", token: "token" }

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "themeAudioPlaybackInfo")
            m.assertEqual(response.errorMessage, "Invalid request itemId.")
            m.assertEqual(response.itemId, "")
        end function

        @describe("failure correlation")

        @it("includes the requested item ID on validation failures")
        function _()
            m.node.top.request = { itemId: "track-1" }

            'bs:disable-next-line 1140
            executeRequest()

            m.assertFalse(m.node.top.response.ok)
            m.assertEqual(m.node.top.response.itemId, "track-1")
        end function

        @it("uses an empty correlation ID for an invalid request")
        function _()
            m.node.top.request = invalid

            'bs:disable-next-line 1140
            executeRequest()

            m.assertFalse(m.node.top.response.ok)
            m.assertEqual(m.node.top.response.itemId, "")
        end function

        @it("builds direct and transcoded theme audio streams")
        function _()
            request = { server: "http://server", token: "secret", itemId: "song-1" }
            'bs:disable-next-line 1140
            direct = buildThemeAudioStreamInfo(request, { PlaySessionId: "play-1", MediaSources: [{ Id: "source-1", Container: "m4a" }] })
            m.assertTrue(direct.ok)
            m.assertEqual(direct.streamFormat, "mp4")
            m.assertTrue(Instr(1, direct.streamUrl, "/Audio/song-1/stream") > 0)
            'bs:disable-next-line 1140
            transcoded = buildThemeAudioStreamInfo(request, { MediaSources: [{ TranscodingUrl: "/audio/master.m3u8" }] })
            m.assertEqual(transcoded.streamUrl, "http://server/audio/master.m3u8")
            m.assertEqual(transcoded.streamFormat, "hls")
        end function

        @it("handles missing media sources")
        function _()
            'bs:disable-next-line 1140
            failure = buildThemeAudioStreamInfo({ server: "server", token: "token", itemId: "song" }, invalid)
            m.assertFalse(failure.ok)
        end function

    end class

end namespace
