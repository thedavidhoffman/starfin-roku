namespace tests

    @SGNode("VideoLibraryTask")
    @suite("VideoLibraryTask component")
    class VideoLibraryTaskTests extends rooibos.BaseTestSuite

        @describe("request validation")

        @it("rejects a missing request")
        function _()
            m.node.top.request = invalid

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "videoLibrary")
            m.assertEqual(response.errorMessage, "Invalid request.")
        end function

        @it("rejects a missing user ID")
        function _()
            m.node.top.request = { server: "server", token: "token", libraryId: "library" }

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "videoLibrary")
            m.assertEqual(response.errorMessage, "Invalid request userId.")
            m.assertEqual(response.libraryId, "library")
        end function

        @it("rejects a missing library ID")
        function _()
            m.node.top.request = { server: "server", token: "token", userId: "user" }

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "videoLibrary")
            m.assertEqual(response.errorMessage, "Invalid request libraryId.")
            m.assertEqual(response.libraryId, "")
        end function

        @describe("request timeouts")

        @it("allows movie library requests up to 120 seconds")
        function _()
            'bs:disable-next-line 1140
            timeoutMs = getVideoLibraryTimeoutMs({ collectionType: "movies" })

            m.assertEqual(timeoutMs, 120000)
        end function

        @it("allows TV library requests up to 120 seconds")
        function _()
            'bs:disable-next-line 1140
            timeoutMs = getVideoLibraryTimeoutMs({ collectionType: "tvshows" })

            m.assertEqual(timeoutMs, 120000)
        end function

        @it("keeps collection-content requests at 60 seconds")
        function _()
            'bs:disable-next-line 1140
            timeoutMs = getVideoLibraryTimeoutMs({ collectionType: "collection" })

            m.assertEqual(timeoutMs, 60000)
        end function

        @it("keeps playlist requests at 60 seconds")
        function _()
            'bs:disable-next-line 1140
            timeoutMs = getVideoLibraryTimeoutMs({ collectionType: "playlist" })

            m.assertEqual(timeoutMs, 60000)
        end function

        @it("keeps music-video requests at 60 seconds")
        function _()
            'bs:disable-next-line 1140
            timeoutMs = getVideoLibraryTimeoutMs({ collectionType: "musicvideos" })

            m.assertEqual(timeoutMs, 60000)
        end function

        @it("uses 60 seconds for an unspecified library mode")
        function _()
            'bs:disable-next-line 1140
            timeoutMs = getVideoLibraryTimeoutMs({})

            m.assertEqual(timeoutMs, 60000)
        end function

        @describe("non-alphabetic requests")

        @it("requests detailed metadata only for detailed library pages")
        function _()
            'bs:disable-next-line 1140
            standardFields = getVideoLibraryFields({ detailed: false })
            'bs:disable-next-line 1140
            detailedFields = getVideoLibraryFields({ detailed: true })

            m.assertEqual(standardFields, "SortName,ProductionYear")
            m.assertEqual(detailedFields, "SortName,ProductionYear,Overview,OfficialRating")
        end function

        @it("requests premiere dates for release-date sorting")
        function _()
            'bs:disable-next-line 1140
            standardFields = getVideoLibraryFields({ sortBy: "PremiereDate", detailed: false })
            'bs:disable-next-line 1140
            detailedFields = getVideoLibraryFields({ sortBy: "PremiereDate", detailed: true })

            m.assertEqual(standardFields, "SortName,ProductionYear,PremiereDate")
            m.assertEqual(detailedFields, "SortName,ProductionYear,PremiereDate,Overview,OfficialRating")
        end function

        @it("routes hash buckets through the synthetic non-alphabetic path")
        function _()
            'bs:disable-next-line 1140
            movieMode = getVideoLibraryRequestMode({ collectionType: "movies" }, "#")
            'bs:disable-next-line 1140
            tvMode = getVideoLibraryRequestMode({ collectionType: "tvshows" }, "#")
            'bs:disable-next-line 1140
            titleMode = getVideoLibraryRequestMode({ collectionType: "movies" }, "A")

            m.assertEqual(movieMode, "nonAlphabetic")
            m.assertEqual(tvMode, "nonAlphabetic")
            m.assertEqual(titleMode, "items")
        end function

        @it("sends release-date fallback and title fields to Jellyfin")
        function _()
            'bs:disable-next-line 1140
            releaseDateSort = getSortBy({ sortBy: "PremiereDate" })
            'bs:disable-next-line 1140
            titleSort = getSortBy({ sortBy: "SortName" })

            m.assertEqual(releaseDateSort, "PremiereDate,ProductionYear,SortName")
            m.assertEqual(titleSort, "SortName")
        end function

        @it("passes episode-added sorting to Jellyfin unchanged")
        function _()
            'bs:disable-next-line 1140
            sortBy = getSortBy({ sortBy: LibraryBrowse.SortKey.DateEpisodeAdded })

            m.assertEqual(sortBy, "DateLastContentAdded")
        end function

        @it("calculates paging from page size and total count")
        function _()
            'bs:disable-next-line 1140
            m.assertTrue(hasMorePages({ TotalRecordCount: 250 }, 100, 100, 100))
            'bs:disable-next-line 1140
            m.assertFalse(hasMorePages({ TotalRecordCount: 200 }, 100, 100, 100))
            'bs:disable-next-line 1140
            m.assertFalse(hasMorePages({ TotalRecordCount: 250 }, 100, 50, 100))
            'bs:disable-next-line 1140
            m.assertEqual(getTotalRecordCount({ TotalRecordCount: 250 }), 250)
        end function

        @it("sorts synthetic non-alphabetic pages in both directions")
        function _()
            items = [{ Name: "Zulu" }, { Name: "Alpha" }, { Name: "Middle" }]
            'bs:disable-next-line 1140
            ascending = sortNonAlphabeticItems(items, "SortName", "Ascending")
            m.assertEqual(ascending[0].Name, "Alpha")
            'bs:disable-next-line 1140
            descending = sortNonAlphabeticItems(items, "SortName", "Descending")
            m.assertEqual(descending[0].Name, "Zulu")
        end function

        @it("preserves Watched filter contract")
        function _()
            'bs:disable-next-line 1140
            result = getItemFilter({ watchStatus: "Watched", favoriteOnly: true })

            m.assertEqual(result, "IsPlayed")
        end function

        @it("preserves Unwatched filter contract")
        function _()
            'bs:disable-next-line 1140
            result = getItemFilter({ watchStatus: "Unwatched", favoriteOnly: true })

            m.assertEqual(result, "IsUnplayed")
        end function

        @it("sends IsPlayed and title direction to Jellyfin before pagination")
        function _()
            getGlobalAa().watchTaskUrls = []
            m.stubCall(HttpClient.Request, function(requestUrl, method, token, body, headers, displayRequest, timeoutMs)
                context = getGlobalAa()
                context.watchTaskUrls.Push(requestUrl)
                return { ok: true, data: { Items: [], TotalRecordCount: 0 } }
            end function)
            m.top.request = { server: "http://server", token: "token", userId: "user", libraryId: "library", includeItemTypes: "Series", collectionType: "tvshows", watchStatus: "Watched", sortBy: "SortName", sortOrder: "Descending", startsWith: "A", pageStartIndex: 100 }
            'bs:disable-next-line 1140
            executeRequest()

            requestUrl = LCase(getGlobalAa().watchTaskUrls[0])
            m.assertTrue(Instr(1, requestUrl, "filters=isplayed") > 0)
            m.assertTrue(Instr(1, requestUrl, "sortby=sortname") > 0)
            m.assertTrue(Instr(1, requestUrl, "sortorder=descending") > 0)
            m.assertTrue(Instr(1, requestUrl, "startindex=100") > 0)
            m.assertTrue(Instr(1, requestUrl, "namestartswith=a") > 0)
            m.assertTrue(Instr(1, requestUrl, "includeitemtypes=series") > 0)
            getGlobalAa().Delete("watchTaskUrls")
        end function

        @it("sends IsUnplayed and title direction to Jellyfin before pagination")
        function _()
            getGlobalAa().watchTaskUrls = []
            m.stubCall(HttpClient.Request, function(requestUrl, method, token, body, headers, displayRequest, timeoutMs)
                context = getGlobalAa()
                context.watchTaskUrls.Push(requestUrl)
                return { ok: true, data: { Items: [], TotalRecordCount: 0 } }
            end function)
            m.top.request = { server: "http://server", token: "token", userId: "user", libraryId: "library", includeItemTypes: "Series", collectionType: "tvshows", watchStatus: "Unwatched", sortBy: "SortName", sortOrder: "Descending", startsWith: "A", pageStartIndex: 100 }
            'bs:disable-next-line 1140
            executeRequest()

            requestUrl = LCase(getGlobalAa().watchTaskUrls[0])
            m.assertTrue(Instr(1, requestUrl, "filters=isunplayed") > 0)
            m.assertTrue(Instr(1, requestUrl, "sortby=sortname") > 0)
            m.assertTrue(Instr(1, requestUrl, "sortorder=descending") > 0)
            m.assertTrue(Instr(1, requestUrl, "startindex=100") > 0)
            m.assertTrue(Instr(1, requestUrl, "namestartswith=a") > 0)
            m.assertTrue(Instr(1, requestUrl, "includeitemtypes=series") > 0)
            getGlobalAa().Delete("watchTaskUrls")
        end function

        @it("does not reuse another watch status hash cache on later pages")
        function _()
            getGlobalAa().watchTaskUrls = []
            m.stubCall(HttpClient.Request, function(requestUrl, method, token, body, headers, displayRequest, timeoutMs)
                context = getGlobalAa()
                context.watchTaskUrls.Push(requestUrl)
                return { ok: true, data: { Items: [{ Id: "hash", Name: "1 title", SortName: "1 title" }], TotalRecordCount: 1 } }
            end function)
            request = { server: "http://server", token: "token", userId: "user", libraryId: "library", watchStatus: "Watched", sortBy: "SortName", sortOrder: "Ascending" }
            'bs:disable-next-line 1140
            loadNonAlphabeticPage(request, { filters: "IsPlayed" }, 0, 1)
            request.watchStatus = "Unwatched"
            'bs:disable-next-line 1140
            loadNonAlphabeticPage(request, { filters: "IsUnplayed" }, 1, 1)

            m.assertEqual(getGlobalAa().watchTaskUrls.Count(), 4)
            m.assertTrue(Instr(1, LCase(getGlobalAa().watchTaskUrls[2]), "filters=isunplayed") > 0)
            m.assertTrue(Instr(1, LCase(getGlobalAa().watchTaskUrls[3]), "filters=isunplayed") > 0)
            getGlobalAa().Delete("watchTaskUrls")
        end function

        @it("keeps existing filter behavior for unfiltered")
        function _()
            'bs:disable-next-line 1140
            result = getItemFilter({})
            m.assertEqual(result, "")
        end function

        @it("keeps existing filter behavior for IsFavorite")
        function _()
            'bs:disable-next-line 1140
            result = getItemFilter({ watchStatus: "All", favoriteOnly: true })
            m.assertEqual(result, "IsFavorite")
        end function

    end class

end namespace
