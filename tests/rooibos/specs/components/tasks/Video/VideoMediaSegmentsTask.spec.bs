namespace tests

    @SGNode("VideoMediaSegmentsTask")
    @suite("VideoMediaSegmentsTask component")
    class VideoMediaSegmentsTaskTests extends rooibos.BaseTestSuite

        @describe("request validation")

        @it("rejects a missing request")
        function _()
            m.node.top.request = invalid

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "mediaSegments")
            m.assertEqual(response.errorMessage, "Invalid request.")
        end function

        @it("rejects a missing item ID")
        function _()
            m.node.top.request = { server: "server", token: "token" }

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "mediaSegments")
            m.assertEqual(response.errorMessage, "Invalid request itemId.")
            m.assertEqual(response.itemId, "")
        end function

        @it("preserves request correlation on success")
        function _()
            m.node.top.request = { server: "http://server", token: "token", itemId: "episode-1", requestId: 42 }
            m.stubCall(HttpClient.Request, { ok: true, data: { Items: [] } })

            'bs:disable-next-line 1140
            executeRequest()

            m.assertEqual(m.node.top.response.requestId, 42)
            m.assertEqual(m.node.top.response.itemId, "episode-1")
        end function

        @it("preserves request correlation on HTTP failure")
        function _()
            m.node.top.request = { server: "http://server", token: "token", itemId: "episode-1", requestId: 42 }
            m.stubCall(HttpClient.Request, { ok: false, errorMessage: "Unavailable" })

            'bs:disable-next-line 1140
            executeRequest()

            m.assertEqual(m.node.top.response.requestId, 42)
            m.assertEqual(m.node.top.response.itemId, "episode-1")
        end function

        @it("preserves request correlation on validation failure")
        function _()
            m.node.top.request = { server: "http://server", token: "token", requestId: 42 }

            'bs:disable-next-line 1140
            executeRequest()

            m.assertFalse(m.node.top.response.ok)
            m.assertEqual(m.node.top.response.requestId, 42)
        end function

    end class

end namespace
