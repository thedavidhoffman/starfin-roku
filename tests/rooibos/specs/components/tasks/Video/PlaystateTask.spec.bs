namespace tests

    @SGNode("PlaystateTask")
    @suite("PlaystateTask component")
    class PlaystateTaskTests extends rooibos.BaseTestSuite

        @describe("HTTP timeout forwarding")

        @it("forwards the audio reporting timeout to the HTTP client")
        function _()
            m.captureTimeout()
            m.top.request = { server: "http://server", token: "token", itemId: "track", status: "start", timeoutMs: 10000 }

            'bs:disable-next-line 1140
            executeRequest()

            m.assertEqual(getGlobalAa().playstateTimeout, 10000)
            getGlobalAa().Delete("playstateTimeout")
        end function

        @it("preserves the default timeout for existing video callers")
        function _()
            m.captureTimeout()
            m.top.request = { server: "http://server", token: "token", itemId: "movie", status: "update" }

            'bs:disable-next-line 1140
            executeRequest()

            m.assertEqual(getGlobalAa().playstateTimeout, 60000)
            getGlobalAa().Delete("playstateTimeout")
        end function

        sub captureTimeout()
            getGlobalAa().playstateTimeout = invalid
            m.stubCall(HttpClient.Request, function(requestUrl, method, token, body, headers, displayRequest, timeoutMs)
                getGlobalAa().playstateTimeout = timeoutMs
                return { ok: true }
            end function)
        end sub

        @describe("position conversion")

        @it("truncates fractional position seconds before converting to ticks")
        function _()
            'bs:disable-next-line 1140
            m.assertEqual(getPositionTicks(12.9), 120000000&)
        end function

        @it("converts integer positions to ticks")
        function _()
            'bs:disable-next-line 1140
            m.assertEqual(getPositionTicks(7), 70000000&)
        end function

        @it("uses zero ticks for an invalid position")
        function _()
            'bs:disable-next-line 1140
            m.assertEqual(getPositionTicks(invalid), 0&)
        end function

        @describe("request validation")

        @it("rejects a missing request")
        function _()
            m.node.top.request = invalid

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "playstate")
            m.assertEqual(response.errorMessage, "Invalid request.")
        end function

        @it("rejects a missing item ID")
        function _()
            m.node.top.request = { server: "server", token: "token" }

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "playstate")
            m.assertEqual(response.errorMessage, "Invalid request itemId.")
        end function

        @it("rejects an invalid status")
        function _()
            m.node.top.request = { server: "server", token: "token", itemId: "item", status: "invalid" }

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "playstate")
            m.assertEqual(response.errorMessage, "Invalid playstate status.")
        end function

        @it("echoes correlation even on validation failure")
        function _()
            m.top.request = { requestId: 42 }

            'bs:disable-next-line 1140
            executeRequest()

            m.assertFalse(m.top.response.ok)
            m.assertEqual(m.top.response.requestId, 42)
        end function

    end class

end namespace
