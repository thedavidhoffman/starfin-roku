namespace tests

    @SGNode("DvdDemoTask")
    @suite("DVD scanned library task")
    class DvdDemoTaskTests extends rooibos.BaseTestSuite

        protected override function beforeEach()
            m.libraryId = "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"
            m.discId = "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb"
            m.top.request = { server: "http://server/jellyfin/", token: "test-token", requestId: 7, action: "dvdDemoCatalog", library: { id: m.libraryId, libraryPath: "Starfin/Dvd/Libraries/" + m.libraryId }, demo: { id: m.discId, manifestPath: "Starfin/Dvd/Discs/" + m.discId + "/Manifest" } }
            testState = getGlobalAa()
            testState.dvdRequests = []
            m.stubCall(HttpClient.Request, function(requestUrl, method, token, body, headers, displayRequest, timeoutMs, jsonFlags)
                testState = getGlobalAa()
                testState.dvdRequests.Push({ url: requestUrl, headers: headers })
                return testState.dvdReply
            end function)
        end function

        protected override function afterEach()
            getGlobalAa().Delete("dvdRequests")
            getGlobalAa().Delete("dvdReply")
        end function

        @describe("authenticated current contracts")

        @it("loads the library catalog with the session header and base path")
        function _()
            testState = getGlobalAa()
            testState.dvdReply = { ok: true, data: { schemaVersion: "starfin-dvd-library-catalog/1", libraries: [m.top.request.library] } }

            'bs:disable-next-line 1140
            executeRequest()

            m.assertTrue(m.top.response.ok)
            m.assertEqual(getGlobalAa().dvdRequests.Count(), 1)
            request = getGlobalAa().dvdRequests[0]
            m.assertEqual(request.url, "http://server/jellyfin/Starfin/Dvd/Libraries")
            m.assertTrue(Instr(1, request.headers.Authorization, "MediaBrowser ") = 1)
            m.assertTrue(Instr(1, request.headers.Authorization, "test-token") > 0)
        end function

        @it("loads selected library titles without fetching manifests")
        function _()
            request = m.top.request
            request.action = "dvdLibrary"
            m.top.request = request
            testState = getGlobalAa()
            testState.dvdReply = { ok: true, data: { schemaVersion: "starfin-dvd-library/1", id: m.libraryId, titles: [request.demo] } }

            'bs:disable-next-line 1140
            executeRequest()

            m.assertTrue(m.top.response.ok)
            m.assertEqual(m.top.response.payload[0].id, m.discId)
            m.assertEqual(getGlobalAa().dvdRequests.Count(), 1)
        end function

        @it("loads a native-session manifest for the selected disc")
        function _()
            request = m.top.request
            request.action = "dvdDemoLoad"
            m.top.request = request
            testState = getGlobalAa()
            testState.dvdReply = { ok: true, data: { schemaVersion: "starfin-dvd-disc/2", id: m.discId, libraryId: m.libraryId, mode: "native-session", session: { schemaVersion: "starfin-dvd-session/1", startPath: "Starfin/Dvd/Discs/" + m.discId + "/Sessions" } } }

            'bs:disable-next-line 1140
            executeRequest()

            m.assertTrue(m.top.response.ok)
            m.assertEqual(m.top.response.payload.session.schemaVersion, "starfin-dvd-session/1")
        end function

        @it("preserves expired authentication for the page")
        function _()
            testState = getGlobalAa()
            testState.dvdReply = { ok: false, status: 401, authExpired: true }

            'bs:disable-next-line 1140
            executeRequest()

            m.assertTrue(m.top.response.authExpired)
            m.assertEqual(m.top.response.requestId, 7)
        end function

        @it("reports malformed catalog data as a correlated failure")
        function _()
            testState = getGlobalAa()
            testState.dvdReply = { ok: true, data: invalid }

            'bs:disable-next-line 1140
            executeRequest()

            m.assertFalse(m.top.response.ok)
            m.assertEqual(m.top.response.requestId, 7)
        end function

    end class

end namespace
