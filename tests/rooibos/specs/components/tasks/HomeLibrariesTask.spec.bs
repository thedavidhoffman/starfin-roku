namespace tests

    @SGNode("HomeLibrariesTask")
    @suite("HomeLibrariesTask component")
    class HomeLibrariesTaskTests extends rooibos.BaseTestSuite

        @describe("request validation")

        @it("rejects a missing request")
        function _()
            m.node.top.request = invalid

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "libraries")
            m.assertEqual(response.errorMessage, "Invalid request.")
        end function

        @describe("request completion")

        @it("publishes a successful libraries payload")
        function _()
            m.node.top.request = { server: "http://server", token: "token", userId: "user" }
            m.stubCall(HttpClient.Request, { ok: true, data: { Items: [{ Id: "library" }] } })

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertTrue(response.ok)
            m.assertEqual(response.action, "libraries")
            m.assertEqual(response.server, "http://server")
            m.assertEqual(response.payload.Items[0].Id, "library")
        end function

        @it("preserves ordinary authentication failures")
        function _()
            m.node.top.request = { server: "http://server", token: "token" }
            m.stubCall(HttpClient.Request, {
                ok: false
                status: 401
                failureKind: "authenticationRequired"
                authExpired: true
                errorMessage: "Your session has expired. Please sign in again."
            })

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "libraries")
            m.assertEqual(response.status, 401)
            m.assertEqual(response.failureKind, "authenticationRequired")
            m.assertTrue(response.authExpired)
        end function

        @it("publishes a safe failure when request preparation throws")
        function _()
            m.node.top.request = { server: "http://server", token: "token" }
            m.stubCall(Url.BuildQueryString, function(values)
                throw { number: 1, message: "private preparation details" }
            end function)

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "libraries")
            m.assertEqual(response.failureKind, "unexpectedResponse")
            m.assertEqual(response.errorMessage, "Unable to load libraries.")
            m.assertInvalid(response.authExpired)
        end function

        @it("publishes a safe failure when the HTTP call throws")
        function _()
            m.node.top.request = { server: "http://server", token: "token" }
            m.stubCall(HttpClient.Request, function(requestUrl, method, token, body, headers, displayRequest, timeoutMs)
                throw { number: 1, message: "private transport details" }
            end function)

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "libraries")
            m.assertEqual(response.failureKind, "unexpectedResponse")
            m.assertEqual(response.errorMessage, "Unable to load libraries.")
            m.assertInvalid(response.authExpired)
        end function

        @it("publishes a failure when response preparation throws")
        function _()
            m.node.top.request = { server: "http://server", token: "token" }
            m.stubCall(HttpClient.Request, { ok: true, data: { Items: [] } })
            m.stubCall(TaskResponse.Success, function(request, action, payload)
                throw { number: 1, message: "private response details" }
            end function)

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "libraries")
            m.assertEqual(response.failureKind, "unexpectedResponse")
            m.assertEqual(response.errorMessage, "Unable to load libraries.")
        end function

        @it("can publish a successful response after an exception")
        function _()
            m.node.top.request = { server: "http://server", token: "token" }
            m.stubCall(HttpClient.Request, function(requestUrl, method, token, body, headers, displayRequest, timeoutMs)
                throw { number: 1, message: "fixture failure" }
            end function)

            'bs:disable-next-line 1140
            executeRequest()
            m.assertFalse(m.node.top.response.ok)

            m.stubCall(HttpClient.Request, { ok: true, data: { Items: [{ Id: "recovered" }] } })

            'bs:disable-next-line 1140
            executeRequest()

            m.assertTrue(m.node.top.response.ok)
            m.assertEqual(m.node.top.response.payload.Items[0].Id, "recovered")
        end function

    end class

end namespace
