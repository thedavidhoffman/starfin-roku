namespace tests

    @SGNode("AccountPickerDialog")
    @suite("AccountPickerDialog component")
    class AccountPickerDialogTests extends rooibos.BaseTestSuite

        @describe("dialog configuration")

        @it("configures the account picker title")
        function _()
            'bs:disable-next-line 1140
            openAccountPicker()

            m.assertEqual(m.top.title, "Switch Account")
        end function

        @it("configures the account picker dimensions")
        function _()
            'bs:disable-next-line 1140
            openAccountPicker()

            m.assertTrue(m.top.dialogWidth = 920)
            m.assertTrue(m.top.dialogHeight = 590)
        end function

        @it("uses AccountPickerContent for dialog content")
        function _()
            'bs:disable-next-line 1140
            openAccountPicker()

            m.assertEqual(m.top.contentComponentName, "AccountPickerContent")
        end function

        @it("passes accounts into the content component")
        function _()
            accounts = [{ username: "David" }]
            m.top.accounts = accounts

            'bs:disable-next-line 1140
            openAccountPicker()
            content = m.top.callFunc("getContentComponent")

            m.assertEqual(content.accounts, accounts)
        end function

        @it("sets the content width from the dialog width")
        function _()
            'bs:disable-next-line 1140
            openAccountPicker()
            content = m.top.callFunc("getContentComponent")

            m.assertEqual(content.contentWidth, 800)
        end function

        @it("opens the dialog")
        function _()
            'bs:disable-next-line 1140
            openAccountPicker()

            m.assertTrue(m.node.dialog.visible)
        end function

        @it("focuses the account picker content")
        function _()
            m.top.accounts = [{ username: "David", accountKey: "account-1", isActive: true }]

            'bs:disable-next-line 1140
            openAccountPicker()
            content = m.top.callFunc("getContentComponent")

            m.assertTrue(content.isInFocusChain())
        end function

        @describe("content events")

        @it("propagates changed accounts")
        function _()
            'bs:disable-next-line 1140
            openAccountPicker()
            content = m.top.callFunc("getContentComponent")
            remainingAccounts = [{ username: "Remaining" }]
            content.accountsChanged = remainingAccounts

            'bs:disable-next-line 1140
            onAccountsChanged()

            m.assertEqual(m.top.accounts, remainingAccounts)
        end function

        @it("marks the account list updated")
        function _()
            'bs:disable-next-line 1140
            openAccountPicker()
            content = m.top.callFunc("getContentComponent")
            content.accountsChanged = []

            'bs:disable-next-line 1140
            onAccountsChanged()

            m.assertTrue(m.top.accountsUpdated)
        end function

        @it("propagates the selected account")
        function _()
            'bs:disable-next-line 1140
            openAccountPicker()
            content = m.top.callFunc("getContentComponent")
            account = { username: "David", accountKey: "account-1" }
            content.accountSelected = account

            'bs:disable-next-line 1140
            onAccountSelected()

            m.assertEqual(m.top.selectedAccount, account)
        end function

        @it("closes after account selection")
        function _()
            'bs:disable-next-line 1140
            openAccountPicker()
            content = m.top.callFunc("getContentComponent")
            content.accountSelected = { username: "David", accountKey: "account-1" }

            'bs:disable-next-line 1140
            onAccountSelected()

            m.assertFalse(m.node.dialog.visible)
        end function

        @it("propagates sign-in selection")
        function _()
            'bs:disable-next-line 1140
            openAccountPicker()

            'bs:disable-next-line 1140
            onSignInSelected()

            m.assertTrue(m.top.signInSelected)
        end function

        @it("closes after sign-in selection")
        function _()
            'bs:disable-next-line 1140
            openAccountPicker()

            'bs:disable-next-line 1140
            onSignInSelected()

            m.assertFalse(m.node.dialog.visible)
        end function

    end class

end namespace