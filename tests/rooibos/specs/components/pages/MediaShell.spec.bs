        @it("keeps the reserved gap for a episode logo above its title")
        function _()
            m.top.backgroundDisplay = "full-screen"
            m.top.mediaContent = m.createContent("tv-episode")
            originalLogo = m.node.titleLogo
            originalState = m.node.logoState
            ' Substitute the asynchronous Poster load result, retaining production fitting.
            loadedLogo = { loadStatus: "ready", uri: "pkg:/logo.png", bitmapWidth: 400, bitmapHeight: 800 }
            m.node.titleLogo = loadedLogo
            m.node.logoState = { url: "pkg:/logo.png", mediaType: "tv-episode", fittedMediaType: "" }

            'bs:disable-next-line 1140
            onTitleLogoLoadStatusChanged()

            m.node.titleLogo = originalLogo
            m.node.logoState = originalState
            m.assertEqual(loadedLogo.width, 60)
            m.assertEqual(loadedLogo.height, 120)
            m.assertEqual(loadedLogo.translation, [0, 26])
            m.assertTrue(loadedLogo.visible)
            'bs:disable-next-line 1140
            layout = getContentLayout("tv-episode")
            m.assertEqual(layout.logoAnchorTop - loadedLogo.translation[1] - loadedLogo.height, 24)
        end function

        @describe("white metadata text")

        @it("uses white for movie metadata on both rows")
        function _()
            content = m.createContent("movie")
            content.runtimeText = "45m"
            content.communityRating = 8
            content.criticRating = 90
            m.top.mediaContent = content

            m.assertEqual(m.top.findNode("primaryInfoRow").findNode("leadingLabel").color, &hFFFFFFFF)
            m.assertEqual(m.top.findNode("secondaryInfoRow").findNode("leadingLabel").color, &hFFFFFFFF)
            m.assertEqual(m.activeMetadataRow().findNode("runtimeLabel").color, &hFFFFFFFF)
            m.assertEqual(m.activeMetadataRow().findNode("communityRatingLabel").color, &hFFFFFFFF)
            m.assertEqual(m.activeMetadataRow().findNode("criticRatingLabel").color, &hFFFFFFFF)
        end function

        @it("uses white for episode metadata on both rows")
        function _()
            content = m.createContent("tv-episode")
            content.runtimeText = "45m"
            content.communityRating = 8
            content.criticRating = 90
            m.top.mediaContent = content

            m.assertEqual(m.top.findNode("primaryInfoRow").findNode("leadingLabel").color, &hFFFFFFFF)
            m.assertEqual(m.top.findNode("secondaryInfoRow").findNode("leadingLabel").color, &hFFFFFFFF)
            m.assertEqual(m.activeMetadataRow().findNode("runtimeLabel").color, &hFFFFFFFF)
            m.assertEqual(m.activeMetadataRow().findNode("communityRatingLabel").color, &hFFFFFFFF)
            m.assertEqual(m.activeMetadataRow().findNode("criticRatingLabel").color, &hFFFFFFFF)
        end function

        @describe("metadata layout regression coverage")

        @it("uses one gap between runtime and stars without a classification")
        function _()
            content = m.createContent("movie")
            content.runtimeText = "2h 5m"
            content.communityRating = 8.3
            m.top.mediaContent = content

            runtime = m.activeMetadataRow().findNode("runtimeGroup")
            ratings = m.activeMetadataRow().findNode("ratingsGroup")
            ' Resolve the row layout before reading child translations.
            m.assertTrue(m.top.findNode("primaryInfoRow").boundingRect().width > 0)
            gap = ratings.translation[0] - runtime.translation[0] - runtime.boundingRect().width

            m.assertEqual(gap, m.top.findNode("primaryInfoRow").itemSpacings[0])
        end function

        @it("removes the classification gap when switching to an unrated movie")
        function _()
            content = m.createContent("movie")
            content.runtimeText = "2h 5m"
            content.communityRating = 8.3
            content.officialRating = "PG-13"
            m.top.mediaContent = content

            content.officialRating = ""
            m.top.mediaContent = content
            runtime = m.activeMetadataRow().findNode("runtimeGroup")
            ratings = m.activeMetadataRow().findNode("ratingsGroup")
            ' Resolve the row layout before reading child translations.
            m.assertTrue(m.top.findNode("primaryInfoRow").boundingRect().width > 0)
            gap = ratings.translation[0] - runtime.translation[0] - runtime.boundingRect().width

            m.assertEqual(gap, m.top.findNode("primaryInfoRow").itemSpacings[0])
        end function

        @it("restores the classification badge after an unrated movie")
        function _()
            content = m.createContent("movie")
            content.runtimeText = "2h 5m"
            content.communityRating = 8.3
            m.top.mediaContent = content

            content.officialRating = "PG-13"
            m.top.mediaContent = content
            badge = m.activeMetadataRow().findNode("contentRatingGroup")
            ratings = m.activeMetadataRow().findNode("ratingsGroup")
            ' Resolve the row layout before reading child translations.
            m.assertTrue(m.top.findNode("primaryInfoRow").boundingRect().width > 0)
            gap = ratings.translation[0] - badge.translation[0] - badge.boundingRect().width

            m.assertTrue(m.activeMetadataRow().findNode("contentRatingBorder").visible)
            m.assertTrue(m.activeMetadataRow().findNode("contentRatingLabel").visible)
            m.assertEqual(gap, m.top.findNode("primaryInfoRow").itemSpacings[0])
        end function

        @it("uses one gap between runtime and stars without an episode classification")
        function _()
            content = m.createContent("tv-episode")
            content.runtimeText = "2h 5m"
            content.communityRating = 8.3
            m.top.mediaContent = content

            runtime = m.activeMetadataRow().findNode("runtimeGroup")
            ratings = m.activeMetadataRow().findNode("ratingsGroup")
            ' Resolve the row layout before reading child translations.
            m.assertTrue(m.top.findNode("secondaryInfoRow").boundingRect().width > 0)
            gap = ratings.translation[0] - runtime.translation[0] - runtime.boundingRect().width

            m.assertEqual(gap, m.top.findNode("secondaryInfoRow").itemSpacings[0])
        end function

        @it("removes the classification gap when switching to an unrated episode")
        function _()
            content = m.createContent("tv-episode")
            content.runtimeText = "2h 5m"
            content.communityRating = 8.3
            content.officialRating = "PG-13"
            m.top.mediaContent = content

            content.officialRating = ""
            m.top.mediaContent = content
            runtime = m.activeMetadataRow().findNode("runtimeGroup")
            ratings = m.activeMetadataRow().findNode("ratingsGroup")
            ' Resolve the row layout before reading child translations.
            m.assertTrue(m.top.findNode("secondaryInfoRow").boundingRect().width > 0)
            gap = ratings.translation[0] - runtime.translation[0] - runtime.boundingRect().width

            m.assertEqual(gap, m.top.findNode("secondaryInfoRow").itemSpacings[0])
        end function

        @it("restores the classification badge after an unrated episode")
        function _()
            content = m.createContent("tv-episode")
            content.runtimeText = "2h 5m"
            content.communityRating = 8.3
            m.top.mediaContent = content

            content.officialRating = "PG-13"
            m.top.mediaContent = content
            badge = m.activeMetadataRow().findNode("contentRatingGroup")
            ratings = m.activeMetadataRow().findNode("ratingsGroup")
            ' Resolve the row layout before reading child translations.
            m.assertTrue(m.top.findNode("secondaryInfoRow").boundingRect().width > 0)
            gap = ratings.translation[0] - badge.translation[0] - badge.boundingRect().width

            m.assertTrue(m.activeMetadataRow().findNode("contentRatingBorder").visible)
            m.assertTrue(m.activeMetadataRow().findNode("contentRatingLabel").visible)
            m.assertEqual(gap, m.top.findNode("secondaryInfoRow").itemSpacings[0])
        end function

        @it("keeps percentage and icon consistent for 59.4")
        function _()
            content = m.createContent("movie")
            content.criticRating = 59.4
            m.top.mediaContent = content

            m.assertEqual(m.activeMetadataRow().findNode("criticRatingLabel").text, "59%")
            m.assertEqual(m.activeMetadataRow().findNode("criticRatingIcon").uri, "pkg:/images/icons/ratings/tomato-rotten.png")
        end function

        @it("keeps percentage and icon consistent for 59.6")
        function _()
            content = m.createContent("movie")
            content.criticRating = 59.6
            m.top.mediaContent = content

            m.assertEqual(m.activeMetadataRow().findNode("criticRatingLabel").text, "60%")
            m.assertEqual(m.activeMetadataRow().findNode("criticRatingIcon").uri, "pkg:/images/icons/ratings/tomato-fresh.png")
        end function

        @it("fits the complete populated row within its width")
        function _()
            content = m.createContent("movie")
            content.primaryInfoText = String(200, "W")
            content.runtimeText = "2h 5m"
            content.officialRating = "PG-13"
            content.communityRating = 8.3
            content.criticRating = 92
            m.top.mediaContent = content

            rowWidth = m.top.findNode("primaryInfoRow").boundingRect().width
            m.assertTrue(rowWidth <= 1220)
            m.assertTrue(rowWidth >= 1218)
        end function

        @it("uses XML icon dimensions and spacing when reserving row space")
        function _()
            content = m.createContent("movie")
            content.primaryInfoText = String(200, "W")
            content.runtimeText = "2h 5m"
            m.top.mediaContent = content
            initialWidth = m.top.findNode("primaryInfoRow").findNode("leadingLabel").width
            icon = m.activeMetadataRow().findNode("runtimeGroup").getChild(0)
            originalWidth = icon.width
            originalSpacing = m.activeMetadataRow().findNode("runtimeGroup").itemSpacings
            originalRowSpacing = m.top.findNode("primaryInfoRow").itemSpacings
            icon.width = originalWidth + 20
            m.activeMetadataRow().findNode("runtimeGroup").itemSpacings = [originalSpacing[0] + 5]
            m.top.findNode("primaryInfoRow").itemSpacings = [originalRowSpacing[0] + 7]
            content.title = "Updated"
            m.top.mediaContent = content
            actualWidth = m.top.findNode("primaryInfoRow").findNode("leadingLabel").width
            rowWidth = m.top.findNode("primaryInfoRow").boundingRect().width
            icon.width = originalWidth
            m.activeMetadataRow().findNode("runtimeGroup").itemSpacings = originalSpacing
            m.top.findNode("primaryInfoRow").itemSpacings = originalRowSpacing

            m.assertEqual(actualWidth, initialWidth - 32)
            m.assertTrue(rowWidth <= 1220)
        end function

        @it("restores natural metadata width after a long item")
        function _()
            content = m.createContent("movie")
            content.primaryInfoText = String(200, "W")
            content.communityRating = 8
            m.top.mediaContent = content
            longWidth = m.top.findNode("primaryInfoRow").findNode("leadingLabel").width

            content.primaryInfoText = "2026"
            m.top.mediaContent = content

            m.assertTrue(m.top.findNode("primaryInfoRow").findNode("leadingLabel").width < longWidth)
            m.assertTrue(m.top.findNode("primaryInfoRow").findNode("leadingLabel").width > 0)
            m.assertTrue(m.top.findNode("primaryInfoRow").boundingRect().width < 300)
        end function

        @it("clears episode decorations when switching to a season summary")
        function _()
            content = m.createContent("tv-episode")
            content.runtimeText = "45m"
            content.communityRating = 8
            content.criticRating = 90
            m.top.mediaContent = content

            m.top.mediaContent = m.createContent("tv-season")

            m.assertFalse(m.activeMetadataRow().findNode("runtimeGroup").visible)
            m.assertFalse(m.activeMetadataRow().findNode("ratingsGroup").visible)
            m.assertEqual(m.activeMetadataRow().findNode("ratingsGroup").getParent().id, "inactiveMetadata")
        end function

        @it("refits a loaded logo from full-screen to cinematic")
        function _()
            m.top.backgroundDisplay = "full-screen"
            m.top.mediaContent = m.createContent("movie")
            originalLogo = m.node.titleLogo
            originalState = m.node.logoState
            loadedLogo = { loadStatus: "ready", uri: "pkg:/logo.png", bitmapWidth: 400, bitmapHeight: 800 }
            m.node.titleLogo = loadedLogo
            m.node.logoState = { url: "pkg:/logo.png", mediaType: "movie", fittedMediaType: "" }
            'bs:disable-next-line 1140
            onTitleLogoLoadStatusChanged()

            m.top.backgroundDisplay = "cinematic"

            m.node.titleLogo = originalLogo
            m.node.logoState = originalState
            m.assertEqual(loadedLogo.width, 110)
            m.assertEqual(loadedLogo.height, 220)
            m.assertEqual(loadedLogo.translation, [0, 343])
            m.assertEqual(m.top.findNode("infoGroup").translation[1] - loadedLogo.translation[1] - loadedLogo.height, 40.0)
        end function

        @it("refits a loaded logo from cinematic to full-screen")
        function _()
            m.top.backgroundDisplay = "cinematic"
            m.top.mediaContent = m.createContent("movie")
            originalLogo = m.node.titleLogo
            originalState = m.node.logoState
            loadedLogo = { loadStatus: "ready", uri: "pkg:/logo.png", bitmapWidth: 400, bitmapHeight: 800 }
            m.node.titleLogo = loadedLogo
            m.node.logoState = { url: "pkg:/logo.png", mediaType: "movie", fittedMediaType: "" }
            'bs:disable-next-line 1140
            onTitleLogoLoadStatusChanged()

            m.top.backgroundDisplay = "full-screen"

            m.node.titleLogo = originalLogo
            m.node.logoState = originalState
            m.assertEqual(loadedLogo.width, 95)
            m.assertEqual(loadedLogo.height, 190)
            m.assertEqual(loadedLogo.translation, [0, 0])
            m.assertEqual(m.top.findNode("infoGroup").translation[1] - loadedLogo.translation[1] - loadedLogo.height, 40.0)
        end function

    end class

end namespace
