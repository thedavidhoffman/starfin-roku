import "pkg:/source/Char.bs"
import "pkg:/source/Number.bs"

namespace tests

    @SGNode("MediaShell")
    @suite("MediaShell component")
    class MediaShellTests extends rooibos.BaseTestSuite

        @describe("declarative component contract")

        @it("declares the mediaBackgroundFull node")
        function _()
            m.assertNotInvalid(m.top.findNode("mediaBackgroundFull"))
        end function

        @it("declares the mediaBackgroundPartialGroup node")
        function _()
            m.assertNotInvalid(m.top.findNode("mediaBackgroundPartialGroup"))
        end function

        @it("declares the mediaBackgroundPartial node")
        function _()
            m.assertNotInvalid(m.top.findNode("mediaBackgroundPartial"))
        end function

        @it("declares the contentGradient node")
        function _()
            m.assertNotInvalid(m.top.findNode("contentGradient"))
        end function

        @it("declares the contentGroup node")
        function _()
            m.assertNotInvalid(m.top.findNode("contentGroup"))
        end function

        @it("declares the titleLogo node")
        function _()
            m.assertNotInvalid(m.top.findNode("titleLogo"))
        end function

        @it("declares the logoFallbackTitleLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("logoFallbackTitleLabel"))
        end function

        @it("declares the episodeTitleLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("episodeTitleLabel"))
        end function

        @it("declares the infoGroup node")
        function _()
            m.assertNotInvalid(m.top.findNode("infoGroup"))
        end function

        @it("declares the primaryInfoLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("primaryInfoRow").findNode("leadingLabel"))
        end function

        @it("declares the secondaryInfoLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("secondaryInfoRow").findNode("leadingLabel"))
        end function

        @it("declares the overviewDescription node")
        function _()
            m.assertNotInvalid(m.top.findNode("overviewDescription"))
        end function

        @describe("shell layout")

        @it("applies content translation")
        function _()
            m.top.contentTranslation = [120, 140]

            m.assertEqual(Number.ToInteger(m.top.findNode("contentGroup").translation[0], -1), 120)
            m.assertEqual(Number.ToInteger(m.top.findNode("contentGroup").translation[1], -1), 140)
        end function

        @it("hides details when requested")
        function _()
            m.top.detailsVisible = false

            m.assertFalse(m.top.findNode("infoGroup").visible)
        end function

        @it("uses the episode detail layout")
        function _()
            m.top.backgroundDisplay = "full-screen"
            m.top.mediaContent = m.createContent("tv-episode")

            m.assertEqual(Number.ToInteger(m.top.findNode("episodeTitleLabel").translation[1], -1), 170)
            m.assertEqual(Number.ToInteger(m.top.findNode("infoGroup").translation[1], -1), 230)
        end function

        @it("uses the cinematic episode layout")
        function _()
            m.top.backgroundDisplay = "cinematic"
            m.top.mediaContent = m.createContent("tv-episode")

            m.assertEqual(Number.ToInteger(m.top.findNode("episodeTitleLabel").translation[1], -1), 527)
            m.assertEqual(Number.ToInteger(m.top.findNode("infoGroup").translation[1], -1), 603)
        end function

        @describe("background rendering")

        @it("renders a full-screen backdrop")
        function _()
            content = m.createContent("movie")
            content.backdropUrl = "http://server/backdrop.jpg"
            m.top.backgroundDisplay = "full-screen"

            m.top.mediaContent = content

            m.assertTrue(m.top.findNode("mediaBackgroundFull").visible)
            m.assertFalse(m.top.findNode("mediaBackgroundPartialGroup").visible)
            m.assertEqual(m.top.findNode("mediaBackgroundFull").uri, "http://server/backdrop.jpg")
        end function

        @it("renders a partial-screen backdrop")
        function _()
            content = m.createContent("movie")
            content.backdropUrl = "http://server/partial.jpg"
            m.top.backgroundDisplay = "partial-screen"

            m.top.mediaContent = content

            m.assertFalse(m.top.findNode("mediaBackgroundFull").visible)
            m.assertTrue(m.top.findNode("mediaBackgroundPartialGroup").visible)
        end function

        @it("clears an absent backdrop")
        function _()
            content = m.createContent("movie")
            content.backdropUrl = ""

            m.top.mediaContent = content

            m.assertFalse(m.top.findNode("mediaBackgroundFull").visible)
            m.assertFalse(m.top.findNode("mediaBackgroundPartialGroup").visible)
            m.assertEqual(m.top.findNode("mediaBackgroundFull").uri, "")
        end function

        @it("hides the content gradient for cinematic movie details")
        function _()
            m.top.castVisible = false
            m.top.backgroundDisplay = "cinematic"

            m.top.mediaContent = m.createContent("movie")

            m.assertFalse(m.top.findNode("contentGradient").visible)
        end function

        @it("shows the content gradient when cinematic cast is visible")
        function _()
            m.top.backgroundDisplay = "cinematic"
            m.top.mediaContent = m.createContent("movie")

            m.top.castVisible = true

            m.assertTrue(m.top.findNode("contentGradient").visible)
        end function

        @describe("media details")

        @it("renders a movie fallback title")
        function _()
            m.top.mediaContent = m.createContent("movie")

            m.assertTrue(m.top.findNode("logoFallbackTitleLabel").visible)
            m.assertEqual(m.top.findNode("logoFallbackTitleLabel").text, "Title")
        end function

        @it("renders the episode title separately")
        function _()
            m.top.mediaContent = m.createContent("tv-episode")

            m.assertTrue(m.top.findNode("episodeTitleLabel").visible)
            m.assertEqual(m.top.findNode("episodeTitleLabel").text, "Title")
        end function

        @it("uses logo title as the episode fallback title")
        function _()
            m.top.mediaContent = m.createContent("tv-episode")

            m.assertEqual(m.top.findNode("logoFallbackTitleLabel").text, "Series")
        end function

        @it("renders primary and secondary information")
        function _()
            m.top.mediaContent = m.createContent("movie")

            m.assertEqual(m.top.findNode("primaryInfoRow").findNode("leadingLabel").text, "Primary")
            m.assertEqual(m.top.findNode("secondaryInfoRow").findNode("leadingLabel").text, "Secondary")
        end function

        @it("collapses overview whitespace")
        function _()
            content = m.createContent("movie")
            content.overview = "First   second" + Char.NewLine + "third"

            m.top.mediaContent = content

            m.assertEqual(m.top.findNode("overviewDescription").text, "First second third")
        end function

        @it("forwards description overlay requests")
        function _()
            request = { id: "description", componentName: "DescriptionDialog" }

            m.top.findNode("overviewDescription").overlayRequested = request

            m.assertEqual(m.top.overlayRequested, request)
        end function

        @it("does not focus a non-focusable description")
        function _()
            m.top.findNode("overviewDescription").canAcceptFocus = false

            focused = m.top.callFunc("focusDescription")

            m.assertFalse(focused)
        end function

        @it("focuses an available description")
        function _()
            m.top.findNode("overviewDescription").canAcceptFocus = true

            focused = m.top.callFunc("focusDescription")

            m.assertTrue(focused)
            m.assertTrue(m.top.findNode("overviewDescription").hasFocus())
        end function

        function activeMetadataRow() as object
            if m.top.mediaContent.mediaType = "tv-episode" then return m.top.findNode("secondaryInfoRow")
            return m.top.findNode("primaryInfoRow")
        end function

        function createContent(mediaType as string) as object
            return {
                mediaType: mediaType
                title: "Title"
                logoUrl: ""
                logoTitle: "Series"
                logoPending: false
                backdropUrl: ""
                primaryInfoText: "Primary"
                secondaryInfoText: "Secondary"
                overview: "Overview"
            }
        end function

        @describe("rating metadata")

        @it("renders the community score with its star instead of a Rating prefix")
        function _()
            content = m.createContent("movie")
            content.communityRating = 8.25
            m.top.mediaContent = content

            m.assertTrue(m.activeMetadataRow().findNode("communityRatingGroup").visible)
            m.assertEqual(m.activeMetadataRow().findNode("communityRatingLabel").text, "8.3")
            m.assertEqual(m.activeMetadataRow().findNode("communityRatingGroup").getChild(0).uri, "pkg:/images/icons/ratings/rating-star.png")
            m.assertFalse(m.activeMetadataRow().findNode("criticRatingGroup").visible)
        end function

        @it("renders fresh threshold")
        function _()
            content = m.createContent("movie")
            content.criticRating = 60
            m.top.mediaContent = content

            m.assertTrue(m.activeMetadataRow().findNode("criticRatingGroup").visible)
            m.assertEqual(m.activeMetadataRow().findNode("criticRatingLabel").text, "60%")
            m.assertEqual(m.activeMetadataRow().findNode("criticRatingIcon").uri, "pkg:/images/icons/ratings/tomato-fresh.png")
            m.assertFalse(m.activeMetadataRow().findNode("communityRatingGroup").visible)
        end function

        @it("renders rotten score")
        function _()
            content = m.createContent("movie")
            content.criticRating = 59
            m.top.mediaContent = content

            m.assertTrue(m.activeMetadataRow().findNode("criticRatingGroup").visible)
            m.assertEqual(m.activeMetadataRow().findNode("criticRatingLabel").text, "59%")
            m.assertEqual(m.activeMetadataRow().findNode("criticRatingIcon").uri, "pkg:/images/icons/ratings/tomato-rotten.png")
            m.assertFalse(m.activeMetadataRow().findNode("communityRatingGroup").visible)
        end function

        @it("renders zero critic score")
        function _()
            content = m.createContent("movie")
            content.criticRating = 0
            m.top.mediaContent = content

            m.assertTrue(m.activeMetadataRow().findNode("criticRatingGroup").visible)
            m.assertEqual(m.activeMetadataRow().findNode("criticRatingLabel").text, "0%")
            m.assertEqual(m.activeMetadataRow().findNode("criticRatingIcon").uri, "pkg:/images/icons/ratings/tomato-rotten.png")
            m.assertFalse(m.activeMetadataRow().findNode("communityRatingGroup").visible)
        end function

        @it("renders maximum critic score")
        function _()
            content = m.createContent("movie")
            content.criticRating = 100
            m.top.mediaContent = content

            m.assertTrue(m.activeMetadataRow().findNode("criticRatingGroup").visible)
            m.assertEqual(m.activeMetadataRow().findNode("criticRatingLabel").text, "100%")
            m.assertEqual(m.activeMetadataRow().findNode("criticRatingIcon").uri, "pkg:/images/icons/ratings/tomato-fresh.png")
            m.assertFalse(m.activeMetadataRow().findNode("communityRatingGroup").visible)
        end function

        @it("clears ratings when the next item has none")
        function _()
            content = m.createContent("movie")
            content.communityRating = 8
            content.criticRating = 85
            m.top.mediaContent = content

            m.top.mediaContent = m.createContent("movie")

            m.assertFalse(m.activeMetadataRow().findNode("ratingsGroup").visible)
            m.assertEqual(m.activeMetadataRow().findNode("communityRatingLabel").text, "")
            m.assertEqual(m.activeMetadataRow().findNode("criticRatingLabel").text, "")
            m.assertEqual(m.activeMetadataRow().findNode("criticRatingIcon").uri, "")
        end function

        @it("places episode ratings beside secondary metadata")
        function _()
            content = m.createContent("tv-episode")
            content.communityRating = 8
            content.criticRating = 90
            m.top.mediaContent = content

            m.assertEqual(m.activeMetadataRow().findNode("ratingsGroup").getParent().id, "secondaryInfoRow")
            m.assertTrue(m.activeMetadataRow().findNode("communityRatingGroup").visible)
            m.assertTrue(m.activeMetadataRow().findNode("criticRatingGroup").visible)
        end function

        @it("moves ratings back to the primary row for movies")
        function _()
            m.top.mediaContent = m.createContent("tv-episode")
            content = m.createContent("movie")
            content.communityRating = 8
            m.top.mediaContent = content

            m.assertEqual(m.activeMetadataRow().findNode("ratingsGroup").getParent().id, "primaryInfoRow")
        end function

        @it("hides an empty metadata label beside ratings")
        function _()
            content = m.createContent("movie")
            content.primaryInfoText = ""
            content.communityRating = 8
            m.top.mediaContent = content

            m.assertFalse(m.top.findNode("primaryInfoRow").findNode("leadingLabel").visible)
            m.assertTrue(m.activeMetadataRow().findNode("ratingsGroup").visible)
        end function

        @it("reserves space for ratings beside long metadata")
        function _()
            content = m.createContent("movie")
            content.primaryInfoText = String(200, "W")
            content.communityRating = 8
            content.criticRating = 90
            m.top.mediaContent = content

            m.assertTrue(m.top.findNode("primaryInfoRow").findNode("leadingLabel").width < 1220)
            m.assertTrue(m.top.findNode("primaryInfoRow").findNode("leadingLabel").width > 0)
            m.assertTrue(m.activeMetadataRow().findNode("communityRatingGroup").visible)
            m.assertTrue(m.activeMetadataRow().findNode("criticRatingGroup").visible)
        end function

        @it("hides invalid critic data while retaining a community score")
        function _()
            content = m.createContent("movie")
            content.communityRating = 8
            content.criticRating = 101
            m.top.mediaContent = content

            m.assertFalse(m.activeMetadataRow().findNode("criticRatingGroup").visible)
            m.assertTrue(m.activeMetadataRow().findNode("communityRatingGroup").visible)
        end function

        @describe("runtime and content rating styling")

        @it("shows runtime with a clock and no bullet prefix")
        function _()
            content = m.createContent("movie")
            content.runtimeText = "2h 5m"
            m.top.mediaContent = content

            m.assertTrue(m.activeMetadataRow().findNode("runtimeGroup").visible)
            m.assertEqual(m.activeMetadataRow().findNode("runtimeLabel").text, "2h 5m")
            m.assertEqual(m.activeMetadataRow().findNode("runtimeGroup").getChild(0).uri, "pkg:/images/icons/ratings/runtime-clock.png")
        end function

        @it("frames the content rating with a padded rounded border")
        function _()
            content = m.createContent("movie")
            content.officialRating = "PG-13"
            m.top.mediaContent = content

            m.assertTrue(m.activeMetadataRow().findNode("contentRatingGroup").visible)
            m.assertEqual(m.activeMetadataRow().findNode("contentRatingLabel").text, "PG-13")
            m.assertEqual(m.activeMetadataRow().findNode("contentRatingLabel").translation, [8.0, 3.0])
            m.assertEqual(m.activeMetadataRow().findNode("contentRatingBorder").uri, "pkg:/images/icons/ratings/content-rating-border.9.png")
            m.assertEqual(m.activeMetadataRow().findNode("contentRatingBorder").width, m.activeMetadataRow().findNode("contentRatingLabel").width + 16)
        end function

        @it("clears runtime and the rating badge for an item without them")
        function _()
            content = m.createContent("movie")
            content.runtimeText = "2h"
            content.officialRating = "R"
            m.top.mediaContent = content

            m.top.mediaContent = m.createContent("movie")

            m.assertFalse(m.activeMetadataRow().findNode("runtimeGroup").visible)
            m.assertFalse(m.activeMetadataRow().findNode("contentRatingGroup").visible)
            m.assertEqual(m.activeMetadataRow().findNode("runtimeLabel").text, "")
            m.assertEqual(m.activeMetadataRow().findNode("contentRatingLabel").text, "")
        end function

        @it("moves runtime to the episode metadata row")
        function _()
            content = m.createContent("tv-episode")
            content.runtimeText = "45m"
            m.top.mediaContent = content

            m.assertEqual(m.activeMetadataRow().findNode("runtimeGroup").getParent().id, "secondaryInfoRow")
            m.assertTrue(m.activeMetadataRow().findNode("runtimeGroup").visible)
        end function

        @it("caps unusually long content ratings")
        function _()
            content = m.createContent("movie")
            content.officialRating = String(100, "W")
            m.top.mediaContent = content

            m.assertEqual(m.activeMetadataRow().findNode("contentRatingLabel").width, 180.0)
            m.assertEqual(m.activeMetadataRow().findNode("contentRatingBorder").width, 196.0)
        end function

        @describe("loaded logo spacing")

        @it("keeps the reserved gap for a tall movie logo")
        function _()
            m.top.backgroundDisplay = "full-screen"
            m.top.mediaContent = m.createContent("movie")
            originalLogo = m.node.titleLogo
            originalState = m.node.logoState
            ' Substitute the asynchronous Poster load result, retaining production fitting.
            loadedLogo = { loadStatus: "ready", uri: "pkg:/logo.png", bitmapWidth: 400, bitmapHeight: 800 }
            m.node.titleLogo = loadedLogo
            m.node.logoState = { url: "pkg:/logo.png", mediaType: "movie", fittedMediaType: "" }

            'bs:disable-next-line 1140
            onTitleLogoLoadStatusChanged()

            m.node.titleLogo = originalLogo
            m.node.logoState = originalState
            m.assertEqual(loadedLogo.width, 95)
            m.assertEqual(loadedLogo.height, 190)
            m.assertEqual(loadedLogo.translation, [0, 0])
            m.assertTrue(loadedLogo.visible)
            'bs:disable-next-line 1140
            layout = getContentLayout("movie")
            m.assertEqual(layout.logoAnchorTop - loadedLogo.translation[1] - loadedLogo.height, 40)
        end function

        @it("keeps the reserved gap for a wide movie logo")
        function _()
            m.top.backgroundDisplay = "full-screen"
            m.top.mediaContent = m.createContent("movie")
            originalLogo = m.node.titleLogo
            originalState = m.node.logoState
            ' Substitute the asynchronous Poster load result, retaining production fitting.
            loadedLogo = { loadStatus: "ready", uri: "pkg:/logo.png", bitmapWidth: 1200, bitmapHeight: 200 }
            m.node.titleLogo = loadedLogo
            m.node.logoState = { url: "pkg:/logo.png", mediaType: "movie", fittedMediaType: "" }

            'bs:disable-next-line 1140
            onTitleLogoLoadStatusChanged()

            m.node.titleLogo = originalLogo
            m.node.logoState = originalState
            m.assertEqual(loadedLogo.width, 600)
            m.assertEqual(loadedLogo.height, 100)
            m.assertEqual(loadedLogo.translation, [0, 90])
            m.assertTrue(loadedLogo.visible)
            'bs:disable-next-line 1140
            layout = getContentLayout("movie")
            m.assertEqual(layout.logoAnchorTop - loadedLogo.translation[1] - loadedLogo.height, 40)
        end function

