namespace tests

    @SGNode("Movie")
    @suite("Movie component")
    class MovieTests extends rooibos.BaseTestSuite

        protected override function beforeEach()
            m.node.state.request = m.createRequest()
            m.node.state.item = m.createMovie()
            m.node.state.focusArea = "toolbar"
            m.node.state.layout.isCinematic = false
            m.node.state.layout.isFromLibrary = false
            m.node.state.selectedStreams = { audio: invalid, subtitle: invalid, subtitleOff: false }
            m.top.settings = {}
            m.top.playSelected = invalid
            m.top.selectedPerson = invalid
            m.top.overlayRequested = invalid
            m.top.closeRequested = false
        end function
        @describe("declarative component contract")

        @it("declares the mediaShell node")
        function _()
            m.assertNotInvalid(m.top.findNode("mediaShell"))
        end function

        @it("declares the contentGroup node")
        function _()
            m.assertNotInvalid(m.top.findNode("contentGroup"))
        end function

        @it("declares the mediaToolbar node")
        function _()
            m.assertNotInvalid(m.top.findNode("mediaToolbar"))
        end function

        @it("declares the previousNextButton node")
        function _()
            m.assertNotInvalid(m.top.findNode("previousNextButton"))
        end function

        @it("declares the cast node")
        function _()
            m.assertNotInvalid(m.top.findNode("cast"))
        end function

        @it("declares the chevronFooter node")
        function _()
            m.assertNotInvalid(m.top.findNode("chevronFooter"))
        end function

        @it("declares the streamOptions node")
        function _()
            m.assertNotInvalid(m.top.findNode("streamOptions"))
        end function

        @it("declares the movieTask node")
        function _()
            m.assertNotInvalid(m.top.findNode("movieTask"))
        end function

        @it("declares the alternate movieTask node")
        function _()
            m.assertNotInvalid(m.top.findNode("movieTaskAlternate"))
        end function

        @it("declares the themeSongsTask node")
        function _()
            m.assertNotInvalid(m.top.findNode("themeSongsTask"))
        end function

        @it("declares the watchedTask node")
        function _()
            m.assertNotInvalid(m.top.findNode("watchedTask"))
        end function

        @describe("movie rendering")

        @it("renders movie identity and overview")
        function _()
            'bs:disable-next-line 1140
            renderMovie(m.createMovie())

            content = m.top.findNode("mediaShell").mediaContent
            m.assertEqual(content.mediaType, "movie")
            m.assertEqual(content.title, "Movie")
            m.assertEqual(content.overview, "Overview")
        end function

        @it("renders stream and chapter counts")
        function _()
            item = m.createMovie()
            item.MediaStreams = [{ Type: "Audio", Index: 1 }, { Type: "Subtitle", Index: 2 }]
            item.Chapters = [{ Name: "Chapter", StartPositionTicks: 0 }]

            'bs:disable-next-line 1140
            renderMovie(item)

            toolbar = m.top.findNode("mediaToolbar")
            m.assertEqual(toolbar.audioStreamCount, 1)
            m.assertEqual(toolbar.subtitleStreamCount, 1)
            m.assertEqual(toolbar.chapterCount, 1)
        end function

        @it("renders watched and resume state")
        function _()
            item = m.createMovie()
            item.UserData = { Played: true, PlaybackPositionTicks: 20000000 }

            'bs:disable-next-line 1140
            renderMovie(item)

            toolbar = m.top.findNode("mediaToolbar")
            m.assertTrue(toolbar.isWatched)
            m.assertEqual(toolbar.resumePositionSeconds, 2)
        end function

        @it("applies the standard layout")
        function _()
            m.node.state.layout.isCinematic = false

            'bs:disable-next-line 1140
            applyCinematicLayout()

            m.assertTrue(m.top.findNode("mediaShell").detailsVisible)
            m.assertTrue(m.top.findNode("mediaToolbar").visible)
            m.assertEqual(m.top.findNode("chevronFooter").direction, "")
        end function

        @it("applies cinematic details layout without cast focus")
        function _()
            m.node.state.layout.isCinematic = true
            m.node.state.focusArea = "toolbar"

            'bs:disable-next-line 1140
            applyCinematicLayout()

            m.assertTrue(m.top.findNode("mediaShell").detailsVisible)
            m.assertFalse(m.top.findNode("mediaShell").castVisible)
            m.assertEqual(m.top.findNode("mediaToolbar").translation[1], 948.0)
        end function

        @describe("library browse state")

        @it("enables previous and next within loaded bounds")
        function _()
            'bs:disable-next-line 1140
            applyLibraryBrowseState({ index: 1, loadedCount: 3, totalCount: 3 })

            control = m.top.findNode("previousNextButton")
            m.assertTrue(control.hasPrevious)
            m.assertTrue(control.hasNext)
        end function

        @it("disables previous at the beginning")
        function _()
            'bs:disable-next-line 1140
            applyLibraryBrowseState({ index: 0, loadedCount: 3, totalCount: 3 })

            m.assertFalse(m.top.findNode("previousNextButton").hasPrevious)
        end function

        @it("disables next at the loaded end")
        function _()
            'bs:disable-next-line 1140
            applyLibraryBrowseState({ index: 2, loadedCount: 3, totalCount: 3 })

            m.assertFalse(m.top.findNode("previousNextButton").hasNext)
        end function

        @it("uses playable neighbor indexes supplied by the library")
        function _()
            'bs:disable-next-line 1140
            applyLibraryBrowseState({ index: 4, previousIndex: 1, nextIndex: 7, loadedCount: 10, totalCount: 10 })

            'bs:disable-next-line 1140
            onPreviousLibraryItemSelected()
            m.assertEqual(m.top.libraryBrowseRequested.targetIndex, 1)

            'bs:disable-next-line 1140
            onNextLibraryItemSelected()
            m.assertEqual(m.top.libraryBrowseRequested.targetIndex, 7)
        end function

        @it("disables a direction without a playable neighbor")
        function _()
            'bs:disable-next-line 1140
            applyLibraryBrowseState({ index: 4, previousIndex: -1, nextIndex: -1, loadedCount: 10, totalCount: 10 })

            m.assertFalse(m.top.findNode("previousNextButton").hasPrevious)
            m.assertFalse(m.top.findNode("previousNextButton").hasNext)
        end function

        @describe("playback selection")

        @it("omits an explicit start position for normal play")
        function _()
            m.node.state.item.UserData = { Played: false, PlaybackPositionTicks: 500 }

            'bs:disable-next-line 1140
            selection = buildPlaySelection(invalid)

            m.assertEqual(selection.itemId, "movie-1")
            m.assertInvalid(selection.startPositionTicks)
        end function

        @it("builds a restart selection at zero")
        function _()
            'bs:disable-next-line 1140
            selection = buildPlaySelection(0)

            m.assertEqual(selection.startPositionTicks, 0)
        end function

        @it("applies selected audio stream index")
        function _()
            m.node.state.selectedStreams.audio = { streamIndex: 3 }
            selection = {}

            'bs:disable-next-line 1140
            applySelectedStreamsToPlaySelection(selection)

            m.assertEqual(selection.audioStreamIndex, 3)
        end function

        @it("applies subtitle Off as index minus one")
        function _()
            m.node.state.selectedStreams.subtitleOff = true
            selection = {}

            'bs:disable-next-line 1140
            applySelectedStreamsToPlaySelection(selection)

            m.assertEqual(selection.subtitleStreamIndex, -1)
        end function

        @describe("watched and progress updates")

        @it("marks an item watched and clears progress")
        function _()
            item = m.createMovie()
            item.UserData = { Played: false, PlaybackPositionTicks: 500, PlayedPercentage: 50 }

            'bs:disable-next-line 1140
            updateItemWatchedState(item, true)

            m.assertTrue(item.UserData.Played)
            m.assertEqual(item.UserData.PlaybackPositionTicks, 0)
            m.assertEqual(item.UserData.PlayedPercentage, 0)
        end function

        @it("stores unfinished playback progress")
        function _()
            item = m.createMovie()
            item.RunTimeTicks = 1000

            'bs:disable-next-line 1140
            updateItemPlaybackProgress(item, { isFinished: false, positionTicks: 250, durationTicks: 1000 })

            m.assertFalse(item.UserData.Played)
            m.assertEqual(item.UserData.PlaybackPositionTicks.ToStr(), "250")
            m.assertEqual(item.UserData.PlayedPercentage, 25.0)
        end function

        @it("marks finished playback watched")
        function _()
            item = m.createMovie()

            'bs:disable-next-line 1140
            updateItemPlaybackProgress(item, { isFinished: true, positionTicks: 900, durationTicks: 1000 })

            m.assertTrue(item.UserData.Played)
            m.assertEqual(item.UserData.PlaybackPositionTicks, 0)
        end function

        @describe("events and lifecycle")

        @it("coalesces rapid movie loads and starts the newest request after a stale response")
        function _()
            firstRequest = m.createRequest()
            firstRequest.itemId = "movie-1"
            secondRequest = m.createRequest()
            secondRequest.itemId = "movie-2"
            thirdRequest = m.createRequest()
            thirdRequest.itemId = "movie-3"

            m.node.state.detailsLoad = LatestRequestLifecycle.Create()
            LatestRequestLifecycle.Queue(m.node.state.detailsLoad, firstRequest)
            LatestRequestLifecycle.TakeNext(m.node.state.detailsLoad)
            LatestRequestLifecycle.Queue(m.node.state.detailsLoad, secondRequest)
            LatestRequestLifecycle.Queue(m.node.state.detailsLoad, thirdRequest)
            m.node.state.detailsTaskPool.nextIndex = 1
            completedTask = {
                response: { ok: true, action: "movie", itemId: "movie-1", requestId: 1, payload: m.createMovie() }
            }

            'bs:disable-next-line 1140
            handleMovieResponse(completedTask)

            m.assertEqual(m.node.state.detailsLoad.active.request.itemId, "movie-3")
            m.assertInvalid(m.node.state.detailsLoad.pending)
            m.assertEqual(m.node.movieTaskAlternate.request.itemId, "movie-3")
            m.assertEqual(m.node.movieTaskAlternate.control, "run")
        end function

        @it("does not let an unrelated response release the active movie request")
        function _()
            m.node.movieTaskAlternate.control = "stop"
            m.node.movieTaskAlternate.request = invalid
            activeRequest = m.createRequest()
            activeRequest.itemId = "movie-2"
            pendingRequest = m.createRequest()
            pendingRequest.itemId = "movie-3"
            m.node.state.detailsLoad = LatestRequestLifecycle.Create()
            LatestRequestLifecycle.Queue(m.node.state.detailsLoad, activeRequest)
            LatestRequestLifecycle.TakeNext(m.node.state.detailsLoad)
            LatestRequestLifecycle.Queue(m.node.state.detailsLoad, pendingRequest)
            unrelatedTask = {
                response: { ok: true, action: "movie", itemId: "movie-1", requestId: 99, payload: m.createMovie() }
            }

            'bs:disable-next-line 1140
            handleMovieResponse(unrelatedTask)

            m.assertEqual(m.node.state.detailsLoad.active.request.itemId, "movie-2")
            m.assertEqual(m.node.state.detailsLoad.pending.request.itemId, "movie-3")
            m.assertInvalid(m.node.movieTaskAlternate.request)
        end function

        @it("routes MediaShell overlays with movie source")
        function _()
            m.top.findNode("mediaShell").overlayRequested = { id: "description" }

            'bs:disable-next-line 1140
            onMediaShellOverlayRequested()

            m.assertEqual(m.top.overlayRequested.id, "description")
            m.assertEqual(m.top.overlayRequested.sourcePage, "movie")
        end function

        @it("adds movie source identity to cast selection")
        function _()
            m.top.findNode("cast").selectedPerson = { itemId: "person-1" }

            'bs:disable-next-line 1140
            onCastPersonSelected()

            m.assertEqual(m.top.selectedPerson.sourceItemType, "movie")
            m.assertEqual(m.top.selectedPerson.sourceItemId, "movie-1")
        end function

        @it("deactivation stops all page tasks")
        function _()
            m.top.callFunc("deactivate")

            m.assertEqual(m.top.findNode("movieTask").control, "stop")
            m.assertEqual(m.top.findNode("movieTaskAlternate").control, "stop")
            m.assertEqual(m.top.findNode("themeSongsTask").control, "stop")
            m.assertEqual(m.top.findNode("watchedTask").control, "stop")
        end function

        @it("Back requests close")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("back", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.closeRequested)
        end function

        @it("ignores released keys")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("back", false)

            m.assertFalse(handled)
        end function

        function createRequest() as object
            return { server: "http://server", token: "token", userId: "user", itemId: "movie-1", playbackQueue: [], playbackQueueIndex: 0, settings: {} }
        end function

        function createMovie() as object
            return { Id: "movie-1", Name: "Movie", Type: "Movie", Overview: "Overview", ImageTags: {}, BackdropImageTags: [], People: [], Genres: [], MediaStreams: [], Chapters: [], UserData: { Played: false, PlaybackPositionTicks: 0 }, RunTimeTicks: 1000 }
        end function
    end class

end namespace
