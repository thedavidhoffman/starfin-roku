        @describe("media summary readiness")

        @it("hides initial content until details complete")
        function _()
            m.node.state.request = invalid
            m.node.state.mediaInfoPending = true
            m.node.state.selectedStreams = { audio: invalid, subtitle: invalid, subtitleOff: false }
            m.node.mediaToolbar.mediaType = "movie"
            m.node.state.detailsLoad = LatestRequestLifecycle.Create()
            LatestRequestLifecycle.Queue(m.node.state.detailsLoad, { itemId: "item-1" })
            LatestRequestLifecycle.TakeNext(m.node.state.detailsLoad)

            'bs:disable-next-line 1140
            renderMovie({ MediaStreams: [{ Type: "Video", Codec: "h264" }] }, true)

            m.assertEqual(m.node.mediaToolbar.mediaInfoText, "")
            m.assertFalse(m.node.mediaToolbar.findNode("mediaInfoButton").visible)
        end function

        @it("reveals metadata from the current details response")
        function _()
            m.node.state.request = invalid
            m.node.state.mediaInfoPending = true
            m.node.state.selectedStreams = { audio: invalid, subtitle: invalid, subtitleOff: false }
            m.node.mediaToolbar.mediaType = "movie"
            m.node.state.detailsLoad = LatestRequestLifecycle.Create()
            LatestRequestLifecycle.Queue(m.node.state.detailsLoad, { itemId: "item-1" })
            LatestRequestLifecycle.TakeNext(m.node.state.detailsLoad)
            task = { response: { ok: true, action: "movie", itemId: "item-1", requestId: 1, payload: { Id: "item-1", Type: "Movie", MediaStreams: [{ Type: "Video", Codec: "h264" }] } } }

            'bs:disable-next-line 1140
            handleMovieResponse(task)

            m.assertFalse(m.node.state.mediaInfoPending)
            m.assertEqual(m.node.mediaToolbar.mediaInfoText, "H.264")
            m.assertTrue(m.node.mediaToolbar.findNode("mediaInfoButton").visible)
        end function

        @it("reveals the fallback only after details complete")
        function _()
            m.node.state.request = invalid
            m.node.state.mediaInfoPending = true
            m.node.state.selectedStreams = { audio: invalid, subtitle: invalid, subtitleOff: false }
            m.node.mediaToolbar.mediaType = "movie"
            m.node.state.detailsLoad = LatestRequestLifecycle.Create()
            LatestRequestLifecycle.Queue(m.node.state.detailsLoad, { itemId: "item-1" })
            LatestRequestLifecycle.TakeNext(m.node.state.detailsLoad)
            task = { response: { ok: true, action: "movie", itemId: "item-1", requestId: 1, payload: { Id: "item-1", Type: "Movie" } } }

            'bs:disable-next-line 1140
            handleMovieResponse(task)

            m.assertFalse(m.node.state.mediaInfoPending)
            m.assertEqual(m.node.mediaToolbar.mediaInfoText, "Media Info")
            m.assertTrue(m.node.mediaToolbar.findNode("mediaInfoButton").visible)
        end function

        @it("ignores unrelated completion while media info is pending")
