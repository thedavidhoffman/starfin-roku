import "pkg:/source/Number.bs"

namespace tests

    @SGNode("LetterGutterButton")
    @suite("LetterGutterButton component")
    class LetterGutterButtonTests extends rooibos.BaseTestSuite

        @describe("declarative component contract")

        @it("has no background")
        function _()
            m.assertInvalid(m.top.findNode("background"))
        end function

        @it("declares the aLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("aLabel"))
        end function

        @it("declares the dashLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("dashLabel"))
        end function

        @it("declares the zLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("zLabel"))
        end function

        @describe("layout")

        @it("uses vertical label positions by default")
        function _()
            m.assertEqual(m.top.findNode("aLabel").translation, [0.0, 18.0])
            m.assertEqual(m.top.findNode("dashLabel").translation, [0.0, 52.0])
            m.assertEqual(m.top.findNode("zLabel").translation, [0.0, 86.0])
            m.assertEqual(m.top.findNode("aLabel").width, 42.0)
        end function

        @it("remains transparent with light labels when focused")
        function _()
            m.top.setFocus(true)

            m.assertTrue(m.top.focused)
            m.assertInvalid(m.top.findNode("background"))
            m.assertEqual(m.top.findNode("aLabel").color, &hF3F7FBFF)
            m.assertEqual(m.top.findNode("dashLabel").color, &hB9C7D6FF)
            m.assertEqual(m.top.findNode("zLabel").color, &hF3F7FBFF)
        end function

        @it("repositions labels in horizontal mode")
        function _()
            m.top.layoutMode = "horizontal"

            m.assertEqual(Number.ToInteger(m.top.findNode("aLabel").translation[0], -1), 18)
            m.assertEqual(Number.ToInteger(m.top.findNode("aLabel").translation[1], -1), 8)
            m.assertEqual(Number.ToInteger(m.top.findNode("dashLabel").translation[0], -1), 53)
            m.assertEqual(Number.ToInteger(m.top.findNode("zLabel").translation[0], -1), 88)
        end function

        @describe("selection keys")

        @it("selects on pressed OK")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("OK", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.buttonSelected)
        end function

        @it("selects on pressed Select")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("Select", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.buttonSelected)
        end function

        @it("selects on pressed Left")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("Left", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.buttonSelected)
        end function

        @it("ignores released keys")
        function _()
            m.top.buttonSelected = false

            'bs:disable-next-line 1140
            handled = onKeyEvent("OK", false)

            m.assertFalse(handled)
            m.assertFalse(m.top.buttonSelected)
        end function

        @it("ignores unrelated pressed keys")
        function _()
            m.top.buttonSelected = false

            'bs:disable-next-line 1140
            handled = onKeyEvent("Right", true)

            m.assertFalse(handled)
            m.assertFalse(m.top.buttonSelected)
        end function

    end class

end namespace
