namespace tests

    @SGNode("VideoToolbar")
    @suite("VideoToolbar component")
    class VideoToolbarTests extends rooibos.BaseTestSuite

        @describe("declarative component contract")

        @it("declares the toolbarItems node")
        function _()
            m.assertNotInvalid(m.top.findNode("toolbarItems"))
        end function

        @it("declares the resumeButton node")
        function _()
            m.assertNotInvalid(m.top.findNode("resumeButton"))
        end function

        @it("declares the restartButton node")
        function _()
            m.assertNotInvalid(m.top.findNode("restartButton"))
        end function

        @it("declares the playButton node")
        function _()
            m.assertNotInvalid(m.top.findNode("playButton"))
        end function

        @it("declares the randomPlayButton node")
        function _()
            m.assertNotInvalid(m.top.findNode("randomPlayButton"))
        end function

        @it("declares the allEpisodesButton node")
        function _()
            m.assertNotInvalid(m.top.findNode("allEpisodesButton"))
        end function

        @it("declares the markWatchedButton node")
        function _()
            m.assertNotInvalid(m.top.findNode("markWatchedButton"))
        end function

        @it("declares the markUnwatchedButton node")
        function _()
            m.assertNotInvalid(m.top.findNode("markUnwatchedButton"))
        end function

        @it("declares the mediaInfoButton node")
        function _()
            m.assertNotInvalid(m.top.findNode("mediaInfoButton"))
        end function

        @it("declares the seriesButton node")
        function _()
            m.assertNotInvalid(m.top.findNode("seriesButton"))
        end function

        @it("declares the seasonButton node")
        function _()
            m.assertNotInvalid(m.top.findNode("seasonButton"))
        end function

        @describe("button visibility")

        @it("shows Play when no resume action exists")
        function _()
            m.top.resumePositionSeconds = 0
            m.top.resumeItem = invalid

            m.assertTrue(m.top.findNode("playButton").visible)
            m.assertFalse(m.top.findNode("resumeButton").visible)
        end function

        @it("shows Resume when progress exists")
        function _()
            m.top.resumePositionSeconds = 30

            m.assertTrue(m.top.findNode("resumeButton").visible)
            m.assertFalse(m.top.findNode("playButton").visible)
        end function

        @it("shows Restart when progress exists and restart is supported")
        function _()
            m.top.supportsRestart = true
            m.top.resumePositionSeconds = 30

            m.assertTrue(m.top.findNode("restartButton").visible)
        end function

        @it("hides Restart when restart is unsupported")
        function _()
            m.top.supportsRestart = false
            m.top.resumePositionSeconds = 30

            m.assertFalse(m.top.findNode("restartButton").visible)
        end function

        @it("shows Mark as Watched for unwatched media")
        function _()
            m.top.supportsWatchedActions = true
            m.top.isWatched = false

            m.assertTrue(m.top.findNode("markWatchedButton").visible)
            m.assertFalse(m.top.findNode("markUnwatchedButton").visible)
        end function

        @it("shows Mark as Unwatched for watched media")
        function _()
            m.top.supportsWatchedActions = true
            m.top.isWatched = true

            m.assertFalse(m.top.findNode("markWatchedButton").visible)
            m.assertTrue(m.top.findNode("markUnwatchedButton").visible)
        end function

        @it("shows item navigation for episodes")
        function _()
            m.top.supportsItemNavigation = true
            m.top.mediaType = "tv-episode"

            m.assertTrue(m.top.findNode("seriesButton").visible)
            m.assertTrue(m.top.findNode("seasonButton").visible)
        end function

        @it("renders episode context in the play label")
        function _()
            m.top.resumePositionSeconds = 0
            m.top.resumeItem = invalid

            m.top.playItem = { ParentIndexNumber: 2, IndexNumber: 4 }

            m.assertEqual(m.top.findNode("playButton").text, "Play S2:E4")
        end function

        @describe("focus and keyboard behavior")

        @it("activates and focuses the first visible button")
        function _()
            m.top.resumePositionSeconds = 0
            m.top.resumeItem = invalid

            m.top.callFunc("activate")

            m.assertTrue(m.top.findNode("playButton").hasFocus())
            m.assertTrue(m.top.findNode("playButton").hasFocusVisual)
        end function

        @it("moves focus right")
        function _()
            m.top.mediaType = "movie"
            m.top.isWatched = false
            m.top.resumePositionSeconds = 0
            m.top.callFunc("activate")

            'bs:disable-next-line 1140
            handled = onKeyEvent("right", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.findNode("markWatchedButton").hasFocus())
        end function

        @it("clamps focus at the first button when moving left")
        function _()
            m.top.resumePositionSeconds = 0
            m.top.callFunc("activate")

            'bs:disable-next-line 1140
            handled = onKeyEvent("left", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.findNode("playButton").hasFocus())
        end function

        @it("emits downward focus exit")
        function _()
            m.top.focusExitDown = false

            'bs:disable-next-line 1140
            handled = onKeyEvent("down", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.focusExitDown)
        end function

        @it("emits upward focus exit when supported")
        function _()
            m.top.supportsFocusExitUp = true
            m.top.focusExitUp = false

            'bs:disable-next-line 1140
            handled = onKeyEvent("up", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.focusExitUp)
        end function

        @it("ignores upward focus exit when unsupported")
        function _()
            m.top.supportsFocusExitUp = false

            'bs:disable-next-line 1140
            handled = onKeyEvent("up", true)

            m.assertFalse(handled)
        end function

        @it("ignores released keys")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("right", false)

            m.assertFalse(handled)
        end function

        @describe("measured button layout")

        @it("fits resume episode text and positions Restart after the expanded button")
        function _()
            m.top.resumePositionSeconds = 40
            m.top.supportsRestart = true
            m.top.resumeItem = { ParentIndexNumber: 3, IndexNumber: 20 }
            m.top.callFunc("activate")
            resume = m.top.findNode("resumeButton")
            restart = m.top.findNode("restartButton")
            label = resume.findNode("textLabel")
            reference = CreateObject("roSGNode", "Label")
            reference.font = label.font
            reference.text = "Resume S3:E20"

            m.assertEqual(label.text, "Resume S3:E20")
            m.assertTrue(label.width >= reference.boundingRect().width)
            m.assertEqual(restart.translation[0], resume.findNode("background").width + 12)
        end function

        @it("relayouts siblings when the focused button text changes directly")
        function _()
            m.top.resumePositionSeconds = 40
            m.top.supportsRestart = true
            m.top.resumeItem = { ParentIndexNumber: 3, IndexNumber: 20 }
            m.top.callFunc("activate")
            resume = m.top.findNode("resumeButton")
            restart = m.top.findNode("restartButton")
            previousX = restart.translation[0]

            resume.text = "Resume S123:E456"

            m.assertTrue(restart.translation[0] > previousX)
            m.assertEqual(restart.translation[0], resume.findNode("background").width + 12)
            m.assertTrue(resume.hasFocus())
        end function

        @it("shrinks sibling spacing when focused episode context is removed")
        function _()
            m.top.resumePositionSeconds = 40
            m.top.supportsRestart = true
            m.top.resumeItem = { ParentIndexNumber: 123, IndexNumber: 456 }
            m.top.callFunc("activate")
            restart = m.top.findNode("restartButton")
            previousX = restart.translation[0]

            m.top.resumeItem = {}

            m.assertTrue(restart.translation[0] < previousX)
            m.assertEqual(restart.translation[0], 207.0)
            m.assertTrue(m.top.findNode("resumeButton").hasFocus())
        end function

        @it("fits a multi-digit play episode label")
        function _()
            m.top.resumePositionSeconds = 0
            m.top.resumeItem = invalid
            m.top.playItem = { ParentIndexNumber: 123, IndexNumber: 456 }
            m.top.callFunc("activate")
            label = m.top.findNode("playButton").findNode("textLabel")
            reference = CreateObject("roSGNode", "Label")
            reference.font = label.font
            reference.text = "Play S123:E456"

            m.assertEqual(label.text, "Play S123:E456")
            m.assertTrue(label.width >= reference.boundingRect().width)
        end function

        @it("collapses the measured button when focus moves to Restart")
        function _()
            m.top.resumePositionSeconds = 40
            m.top.supportsRestart = true
            m.top.resumeItem = { ParentIndexNumber: 3, IndexNumber: 20 }
            m.top.callFunc("activate")

            'bs:disable-next-line 1140
            onKeyEvent("right", true)

            resume = m.top.findNode("resumeButton")
            restart = m.top.findNode("restartButton")
            m.assertEqual(resume.findNode("background").width, 64.0)
            m.assertFalse(resume.findNode("textLabel").visible)
            m.assertEqual(restart.translation[0], 76.0)
            m.assertTrue(restart.hasFocus())
        end function

        @it("keeps all buttons compact when the toolbar is deactivated")
        function _()
            m.top.resumePositionSeconds = 40
            m.top.supportsRestart = true
            m.top.resumeItem = { ParentIndexNumber: 3, IndexNumber: 20 }
            m.top.callFunc("activate")

            m.top.callFunc("deactivate")

            m.assertEqual(m.top.findNode("resumeButton").findNode("background").width, 64.0)
            m.assertEqual(m.top.findNode("restartButton").translation[0], 76.0)
        end function

        @describe("button events")

        @it("emits play selection")
        function _()
            m.top.playSelected = false

            m.top.findNode("playButton").buttonSelected = true

            m.assertTrue(m.top.playSelected)
        end function

        @it("emits restart selection")
        function _()
            m.top.restartSelected = false

            m.top.findNode("restartButton").buttonSelected = true

            m.assertTrue(m.top.restartSelected)
        end function

        @it("emits random play selection")
        function _()
            m.top.randomPlaySelected = false

            m.top.findNode("randomPlayButton").buttonSelected = true

            m.assertTrue(m.top.randomPlaySelected)
        end function

        @it("emits all episodes selection")
        function _()
            m.top.allEpisodesSelected = false

            m.top.findNode("allEpisodesButton").buttonSelected = true

            m.assertTrue(m.top.allEpisodesSelected)
        end function

        @it("emits mark watched selection")
        function _()
            m.top.markAsWatchedSelected = false

            m.top.findNode("markWatchedButton").buttonSelected = true

            m.assertTrue(m.top.markAsWatchedSelected)
        end function

        @it("emits mark unwatched selection")
        function _()
            m.top.markAsUnwatchedSelected = false

            m.top.findNode("markUnwatchedButton").buttonSelected = true

            m.assertTrue(m.top.markAsUnwatchedSelected)
        end function

        @it("emits series selection")
        function _()
            m.top.seriesSelected = false

            m.top.findNode("seriesButton").buttonSelected = true

            m.assertTrue(m.top.seriesSelected)
        end function

        @it("emits season selection")
        function _()
            m.top.seasonSelected = false

            m.top.findNode("seasonButton").buttonSelected = true

            m.assertTrue(m.top.seasonSelected)
        end function

        @it("emits media info selection")
        function _()
            m.top.mediaInfoSelected = false

            m.top.findNode("mediaInfoButton").buttonSelected = true

            m.assertTrue(m.top.mediaInfoSelected)
        end function

        @describe("unavailable playback")

        @it("hides playback actions even when old resume data exists")
        function _()
            m.top.resumePositionSeconds = 30
            m.top.resumeItem = { Id: "episode-1" }
            m.top.supportsRandomPlay = true
            m.top.supportsPlayback = false

            m.assertFalse(m.node.playButton.visible)
            m.assertFalse(m.node.resumeButton.visible)
            m.assertFalse(m.node.restartButton.visible)
            m.assertFalse(m.node.randomPlayButton.visible)

            m.top.supportsPlayback = true
            m.top.supportsRandomPlay = false
            m.top.resumePositionSeconds = 0
            m.top.resumeItem = invalid
        end function

        @it("transfers focused Play to the available watched action")
        function _()
            m.top.supportsPlayback = true
            m.top.supportsWatchedActions = true
            m.top.isWatched = false
            m.top.resumePositionSeconds = 0
            m.top.resumeItem = invalid
            m.top.callFunc("resetFocus")

            m.top.supportsPlayback = false

            m.assertTrue(m.node.markWatchedButton.isInFocusChain())
            m.assertEqual(m.node.focusState.focusedButtonId, "markWatchedButton")
            m.top.supportsPlayback = true
        end function

        @it("focuses the unwatched action by identity without Play")
        function _()
            m.top.supportsWatchedActions = true
            m.top.supportsPlayback = false
            m.top.isWatched = true

            m.top.callFunc("focusWatchedAction")

            m.assertTrue(m.node.markUnwatchedButton.isInFocusChain())
            m.assertEqual(m.node.focusState.focusedButtonId, "markUnwatchedButton")
            m.top.supportsPlayback = true
        end function

        @it("does not steal external focus when playback is disabled")
        function _()
            m.top.callFunc("deactivate")
            sibling = CreateObject("roSGNode", "Group")
            m.top.getScene().appendChild(sibling)
            sibling.setFocus(true)

            m.top.supportsPlayback = false

            m.assertTrue(sibling.hasFocus())
            m.top.supportsPlayback = true
            m.top.getScene().removeChild(sibling)
        end function

        @it("restores Play when playback becomes available")
        function _()
            m.top.resumePositionSeconds = 0
            m.top.resumeItem = invalid
            m.top.supportsPlayback = false
            m.top.supportsPlayback = true
            m.assertTrue(m.node.playButton.visible)
        end function

        @describe("media summary")

        @it("places episode media info after season navigation")
        function _()
            m.top.mediaInfoText = "1080p H.264"
            m.top.mediaType = "tv-episode"

            m.assertEqual(m.node.focusState.buttons.Peek().id, "mediaInfoButton")
            m.assertTrue(m.node.mediaInfoButton.translation[0] > m.node.seasonButton.translation[0])
        end function

        @it("places movie media info last")
        function _()
            m.top.mediaInfoText = "1080p H.264"
            m.top.mediaType = "movie"

            m.assertEqual(m.node.focusState.buttons.Peek().id, "mediaInfoButton")
        end function

        @it("keeps media summary visible when deactivated")
        function _()
            m.top.mediaType = "movie"
            m.top.mediaInfoText = "1080p H.264 • AC3 5.1"
            m.top.callFunc("deactivate")

            button = m.top.findNode("mediaInfoButton")
            m.assertTrue(button.findNode("textLabel").visible)
            m.assertEqual(button.text, "1080p H.264 • AC3 5.1")
            m.assertTrue(button.findNode("background").width = button.preferredWidth)
        end function

        @it("navigates to and retains the final media info button")
        function _()
            m.top.mediaInfoText = "1080p H.264"
            m.top.mediaType = "tv-episode"
            m.top.callFunc("activate")
            for i = 0 to 20
                'bs:disable-next-line 1140
                onKeyEvent("right", true)
            end for

            m.assertTrue(m.node.mediaInfoButton.hasFocus())
            m.top.callFunc("deactivate")
            m.top.callFunc("activate")
            m.assertTrue(m.node.mediaInfoButton.hasFocus())
        end function

        @it("lays out buttons without overlap for the full episode toolbar")
        function _()
            m.top.mediaType = "tv-episode"
            m.top.resumePositionSeconds = 40
            m.top.mediaInfoText = "4K HEVC Dolby Vision • TrueHD 7.1"
            m.top.callFunc("activate")

            previousEnd = 0.0
            for each button in m.node.focusState.buttons
                m.assertTrue(button.translation[0] >= previousEnd)
                previousEnd = button.translation[0] + button.findNode("background").width + 12
            end for
            m.assertTrue(previousEnd <= 1728)
        end function

        @describe("media summary readiness")

        @it("hides unresolved media info from rendering and navigation")
        function _()
            m.top.mediaType = "movie"
            m.top.mediaInfoText = ""

            m.assertFalse(m.node.mediaInfoButton.visible)
            for each button in m.node.focusState.buttons
                m.assertTrue(button.id <> "mediaInfoButton")
            end for
        end function

        @it("reveals resolved text without moving action focus")
        function _()
            m.top.mediaType = "movie"
            m.top.mediaInfoText = ""
            m.top.callFunc("resetFocus")
            focusedId = m.node.focusState.focusedButtonId

            m.top.mediaInfoText = "1080p H.264"

            m.assertTrue(m.node.mediaInfoButton.visible)
            m.assertEqual(m.node.mediaInfoButton.text, "1080p H.264")
            m.assertEqual(m.node.focusState.buttons.Peek().id, "mediaInfoButton")
            m.assertEqual(m.node.focusState.focusedButtonId, focusedId)
        end function

        @it("allows a resolved fallback label")
        function _()
            m.top.mediaType = "movie"
            m.top.mediaInfoText = "Media Info"

            m.assertTrue(m.node.mediaInfoButton.visible)
            m.assertEqual(m.node.mediaInfoButton.text, "Media Info")
        end function

        @it("recovers focus when a new load hides the selected summary")
        function _()
            m.top.mediaType = "movie"
            m.top.mediaInfoText = "1080p H.264"
            'bs:disable-next-line 1140
            focusButton(m.node.focusState.buttons.Count() - 1)

            m.top.mediaInfoText = ""

            m.assertFalse(m.node.mediaInfoButton.visible)
            m.assertTrue(m.node.focusState.buttons[0].hasFocus())
        end function

        @describe("unified media options")

        @it("shows the cog with the persistent summary")
        function _()
            m.top.mediaType = "movie"
            m.top.mediaInfoText = "1080p HEVC • AAC 5.1"
            button = m.top.findNode("mediaInfoButton")

            m.assertTrue(button.visible)
            m.assertTrue(button.alwaysShowText)
            m.assertEqual(button.icon, "pkg:/images/icons/media-toolbar/cog-light.png")
            m.assertTrue(button.findNode("textLabel").visible)
        end function

        @describe("persistent resume and restart labels")

        @it("keeps both labels and button positions stable when focus moves")
        function _()
            m.top.resumePositionSeconds = 30
            m.top.alwaysShowResumeRestartText = true
            m.top.callFunc("resetFocus")
            m.top.callFunc("activate")
            restartX = m.node.restartButton.translation[0]

            'bs:disable-next-line 1140
            onKeyEvent("right", true)

            m.assertTrue(m.node.resumeButton.findNode("textLabel").visible)
            m.assertTrue(m.node.restartButton.findNode("textLabel").visible)
            m.assertEqual(m.node.restartButton.translation[0], restartX)
            m.assertTrue(restartX >= m.node.resumeButton.preferredWidth)
            m.assertTrue(m.node.restartButton.hasFocusVisual)
            m.assertFalse(m.node.resumeButton.hasFocusVisual)
        end function

        @it("restores focus-driven labels when the option is disabled")
        function _()
            m.top.alwaysShowResumeRestartText = true
            m.top.resumePositionSeconds = 30
            m.top.callFunc("resetFocus")
            m.top.callFunc("activate")

            m.top.alwaysShowResumeRestartText = false

            m.assertTrue(m.node.resumeButton.findNode("textLabel").visible)
            m.assertFalse(m.node.restartButton.findNode("textLabel").visible)
        end function

    end class

end namespace
