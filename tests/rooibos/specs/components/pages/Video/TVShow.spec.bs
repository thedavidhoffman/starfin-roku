        @it("cancels pending random work on deactivation while retaining the cached queue")
        function _()
            m.prepareWatchedAction()
            m.node.pageState.randomRequest = { nextRequestId: 4, pendingRequestId: 4 }
            m.node.pageState.randomQueueLoading = true
            m.node.pageState.randomPlaybackQueue = [{ itemId: "cached" }]
            m.stubCall(Spinner.Hide, invalid)

            m.top.callFunc("deactivate")

            m.assertInvalid(m.node.pageState.randomRequest.pendingRequestId)
            m.assertEqual(m.node.pageState.randomRequest.nextRequestId, 4)
            m.assertFalse(m.node.pageState.randomQueueLoading)
            m.assertEqual(m.node.randomPlaybackTask.control, "stop")
            m.assertEqual(m.node.pageState.randomPlaybackQueue[0].itemId, "cached")
        end function

        @it("cancels pending random work and clears the cached queue on a new load")
        function _()
            m.prepareWatchedAction()
            m.node.pageState.randomRequest = { nextRequestId: 4, pendingRequestId: 4 }
            m.node.pageState.randomQueueLoading = true
            m.node.pageState.randomPlaybackQueue = [{ itemId: "cached" }]
            m.stubCall(Spinner.Hide, invalid)
            m.stubCall(Spinner.Show, invalid)
            request = m.createRequest()
            request.item = m.createSeries()

            m.top.loadRequest = request

            m.assertInvalid(m.node.pageState.randomRequest.pendingRequestId)
            m.assertEqual(m.node.pageState.randomRequest.nextRequestId, 4)
            m.assertFalse(m.node.pageState.randomQueueLoading)
            m.assertEqual(m.node.randomPlaybackTask.control, "stop")
            m.assertInvalid(m.node.pageState.randomPlaybackQueue)
        end function

        sub prepareWatchedAction()
            m.top.findNode("videoToolbar").visible = true
            AsyncLifecycle.Begin(m.node.pageState.lifecycle, "series-1")
            task = CreateObject("roSGNode", "Node")
            task.addFields({ request: {}, response: {}, control: "stop" })
            m.node.watchedTask = task
            refresher = CreateObject("roSGNode", "AggregateRefreshTestDouble")
            m.node.episodeCountRefresh = refresher
            m.stubCall(AppMessage.Dismiss, invalid)
        end sub

        function watchedResponse(ok as boolean) as object
            pending = m.node.pageState.watched.pending
            return { ok: ok, itemId: pending.itemId, action: pending.action, requestId: pending.requestId, errorMessage: "Unavailable" }
        end function

        sub beginPendingPlay()
            AsyncLifecycle.Begin(m.node.pageState.lifecycle, "series-1")
            'bs:disable-next-line 1140
            invalidatePlaybackTargets()
            'bs:disable-next-line 1140
            onVideoToolbarPlaySelected()
        end sub

        function refreshResponse(requestId as integer) as object
            episode = m.createEpisode("next-episode")
            return { action: "tvShow", requestId: requestId, ok: true, payload: { resumeItem: invalid, upNextItem: episode, playItem: episode, playbackQueue: [{ itemId: episode.Id, item: episode }], playbackQueueIndex: 0 } }
        end function

        function createRequest() as object
            return { server: "http://server", token: "token", userId: "user", itemId: "series-1", settings: {} }
        end function

        function createSeries() as object
            return { Id: "series-1", Name: "Series", Type: "Series", Overview: "Overview", ImageTags: {}, BackdropImageTags: [], People: [], Genres: [] }
        end function

        function createSeason(id as string, name as string) as object
            return { Id: id, Name: name, Type: "Season", ImageTags: {}, BackdropImageTags: [], UserData: { Played: false, UnplayedItemCount: 1 } }
        end function

        function createEpisode(id as string) as object
            return { Id: id, Name: id, Type: "Episode", SeasonId: "season-1", SeasonName: "Season 1", UserData: { Played: false, PlaybackPositionTicks: 0 } }
        end function

        @describe("episode count metadata")

        @it("omits direct child counts while retaining year and status")
        function _()
            item = m.createSeries()
            item.ChildCount = 3
            item.ProductionYear = 2020
            item.Status = "Continuing"

            'bs:disable-next-line 1140
            renderSeries(item, true)

            content = m.top.findNode("mediaShell").mediaContent
            m.assertEqual(Instr(1, content.primaryInfoText, "episodes"), 0)
            m.assertTrue(Instr(1, content.primaryInfoText, "2020") > 0)
            m.assertTrue(Instr(1, content.primaryInfoText, "Continuing") > 0)
        end function

        @it("uses recursive episode counts instead of direct child counts")
        function _()
            item = m.createSeries()
            item.ChildCount = 3
            item.RecursiveItemCount = 24

            'bs:disable-next-line 1140
            renderSeries(item)

            content = m.top.findNode("mediaShell").mediaContent
            m.assertEqual(content.primaryInfoText, "24 episodes")
        end function

        @it("adds episode counts when complete series metadata arrives")
        function _()
            item = m.createSeries()
            'bs:disable-next-line 1140
            renderSeries(item, true)
            m.assertEqual(m.top.findNode("mediaShell").mediaContent.primaryInfoText, "")

            item.RecursiveItemCount = 24
            'bs:disable-next-line 1140
            renderSeries(item, false)

            m.assertEqual(m.top.findNode("mediaShell").mediaContent.primaryInfoText, "24 episodes")
        end function

        @describe("rating metadata")

        @it("passes both scores to the shell without the Rating text")
        function _()
            item = m.createSeries()
            item.CommunityRating = 8
            item.CriticRating = 90
            'bs:disable-next-line 1140
            renderSeries(item)

            content = m.top.findNode("mediaShell").mediaContent
            m.assertEqual(content.communityRating, 8)
            m.assertEqual(content.criticRating, 90)
            m.assertEqual(Instr(1, content.primaryInfoText, "Rating"), 0)
        end function

        @it("passes styled metadata separately from bullet-delimited text")
        function _()
            item = m.createSeries()
            item.OfficialRating = "TV-14"
            'bs:disable-next-line 1140
            renderSeries(item)

            content = m.top.findNode("mediaShell").mediaContent
            m.assertEqual(content.officialRating, "TV-14")
            m.assertEqual(Instr(1, content.primaryInfoText, "TV-14"), 0)
        end function

        @describe("independent series layout")

        @it("renders Full Backdrop after a live independent series setting change")
        function _()
            shell = m.top.findNode("mediaShell")
            shell.mediaContent = { mediaType: "tv-show", title: "Series", backdropUrl: "http://server/backdrop.jpg" }

            m.top.settings = { "tv-series-shell-layout": "full-screen", "movie-shell-layout": "partial-screen" }

            m.assertEqual(shell.backgroundDisplay, "full-screen")
            m.assertTrue(shell.findNode("mediaBackgroundFull").visible)
            m.assertFalse(shell.findNode("mediaBackgroundPartialGroup").visible)
            m.assertTrue(m.top.findNode("cast").displayEnabled)
        end function

        @it("switches live from Full Backdrop to Corner Backdrop")
        function _()
            shell = m.top.findNode("mediaShell")
            shell.mediaContent = { mediaType: "tv-show", title: "Series", backdropUrl: "http://server/backdrop.jpg" }
            m.top.settings = { "tv-series-shell-layout": "full-screen" }

            m.top.settings = { "tv-series-shell-layout": "partial-screen" }

            m.assertEqual(shell.backgroundDisplay, "partial-screen")
            m.assertFalse(shell.findNode("mediaBackgroundFull").visible)
            m.assertTrue(shell.findNode("mediaBackgroundPartialGroup").visible)
        end function

        @it("restores the standard season grid when changing Poster to Full Backdrop")
        function _()
            m.top.settings = { "tv-series-shell-layout": "poster" }

            m.top.settings = { "tv-series-shell-layout": "full-screen" }

            m.assertEqual(m.top.findNode("mediaShell").backgroundDisplay, "full-screen")
            m.assertEqual(m.top.findNode("seasonsGrid").numColumns, 8)
            m.assertEqual(m.top.findNode("seasonsGrid").itemSize, [207.0, 381.0])
            m.assertTrue(m.top.findNode("cast").displayEnabled)
            m.assertTrue(m.top.findNode("videoToolbar").supportsFocusExitUp)
        end function

        @it("uses series Poster independently of the movie choice")
        function _()
            m.top.settings = { "tv-series-shell-layout": "poster", "movie-shell-layout": "full-screen" }
            'bs:disable-next-line 1140
            onSettingsChanged()

            m.assertEqual(m.top.findNode("mediaShell").backgroundDisplay, "poster")
            m.assertFalse(m.top.findNode("cast").displayEnabled)
        end function

        @it("recovers toolbar focus when Poster removes description focus")
        function _()
            m.node.pageState.focusArea = "description"
            m.top.settings = { "tv-series-shell-layout": "poster" }
            'bs:disable-next-line 1140
            onSettingsChanged()

            m.assertEqual(m.node.pageState.focusArea, "videoToolbar")
        end function

        @describe("layout and focus reconciliation")

        @it("preserves the cast position when an unrelated setting changes")
        function _()
            m.top.settings = { "tv-series-shell-layout": "partial-screen", "theme": "blue" }
            m.node.cast.people = [{ Id: "person", Name: "Person" }]
            'bs:disable-next-line 1140
            focusCast()

            m.top.settings = { "tv-series-shell-layout": "partial-screen", "theme": "grey" }

            m.assertEqual(m.node.pageState.focusArea, "cast")
            m.assertEqual(m.top.findNode("contentGroup").translation, [96.0, -397.0])
            m.assertEqual(m.top.findNode("videoToolbar").translation, [0.0, 926.0])
            m.assertTrue(m.node.cast.isInFocusChain())
        end function

        @it("preserves cast focus when changing between backdrop layouts")
        function _()
            m.top.settings = { "tv-series-shell-layout": "partial-screen" }
            m.node.cast.people = [{ Id: "person", Name: "Person" }]
            'bs:disable-next-line 1140
            focusCast()

            m.top.settings = { "tv-series-shell-layout": "full-screen" }

            m.assertEqual(m.node.pageState.focusArea, "cast")
            m.assertEqual(m.top.findNode("contentGroup").translation, [96.0, -397.0])
            m.assertEqual(m.top.findNode("videoToolbar").translation, [0.0, 926.0])
            m.assertTrue(m.node.cast.isInFocusChain())
            m.assertEqual(m.top.findNode("mediaShell").backgroundDisplay, "full-screen")
        end function

        @it("recovers season focus and the default content position when Poster removes cast")
        function _()
            m.top.settings = { "tv-series-shell-layout": "partial-screen" }
            m.node.pageState.seasons = [m.createSeason("season-1", "Season 1")]
            'bs:disable-next-line 1140
            renderSeasons(m.node.pageState.seasons)
            m.node.cast.people = [{ Id: "person", Name: "Person" }]
            'bs:disable-next-line 1140
            focusCast()

            m.top.settings = { "tv-series-shell-layout": "poster" }

            m.assertEqual(m.node.pageState.focusArea, "seasons")
            m.assertEqual(m.top.findNode("contentGroup").translation, [96.0, 0.0])
            m.assertTrue(m.node.seasonsGrid.isInFocusChain())
            m.assertFalse(m.node.cast.displayEnabled)
        end function

        @describe("Poster season positioning")

        @it("centers 1 season cards")
        function _()
            m.top.settings = { "tv-series-shell-layout": "poster" }

            'bs:disable-next-line 1140
            renderSeasons([m.createSeason("season-1", "Season 1")])

            m.assertEqual(m.node.seasonsGrid.translation, [664.0, 375.0])
        end function

        @it("centers 2 season cards")
        function _()
            m.top.settings = { "tv-series-shell-layout": "poster" }

            'bs:disable-next-line 1140
            renderSeasons([m.createSeason("season-1", "Season 1"), m.createSeason("season-2", "Season 2")])

            m.assertEqual(m.node.seasonsGrid.translation, [452.0, 375.0])
        end function

        @it("centers 3 season cards")
        function _()
            m.top.settings = { "tv-series-shell-layout": "poster" }

            'bs:disable-next-line 1140
            renderSeasons([m.createSeason("season-1", "Season 1"), m.createSeason("season-2", "Season 2"), m.createSeason("season-3", "Season 3")])

            m.assertEqual(m.node.seasonsGrid.translation, [240.0, 375.0])
        end function

        @it("retains the existing four-season alignment")
        function _()
            m.top.settings = { "tv-series-shell-layout": "poster" }

            'bs:disable-next-line 1140
            renderSeasons([m.createSeason("season-1", "Season 1"), m.createSeason("season-2", "Season 2"), m.createSeason("season-3", "Season 3"), m.createSeason("season-4", "Season 4")])

            m.assertEqual(m.node.seasonsGrid.translation, [28.0, 375.0])
        end function

        @it("restores standard season positioning when leaving Poster")
        function _()
            m.node.pageState.seasons = [m.createSeason("season-1", "Season 1")]
            m.top.settings = { "tv-series-shell-layout": "poster" }

            m.top.settings = { "tv-series-shell-layout": "partial-screen" }

            m.assertEqual(m.node.seasonsGrid.translation, [0.0, 630.0])
            m.assertEqual(m.node.seasonsGrid.itemSize, [207.0, 381.0])
            m.assertFalse(m.node.seasonsGrid.content.getChild(0).posterLayout)
        end function

        @describe("aggregate count responses")

        @it("updates season data and current season cards from server totals")
        function _()
            season = m.createSeason("season-1", "Season 1")
            season.UserData.UnplayedItemCount = 200
            m.node.pageState.seasons = [season]
            'bs:disable-next-line 1140
            renderSeasons(m.node.pageState.seasons)
            grid = m.top.findNode("seasonsGrid")

            AsyncLifecycle.Begin(m.node.pageState.lifecycle, "series-1")
            m.node.episodeCountRefresh.response = { ok: true, payload: [{ Id: "season-1", Type: "Season", UserData: { UnplayedItemCount: 2 } }] }
            'bs:disable-next-line 1140
            onEpisodeCountsRefreshed()

            m.assertEqual(m.node.pageState.seasons[0].UserData.UnplayedItemCount, 2)
            m.assertEqual(grid.content.getChild(0).raw.UserData.UnplayedItemCount, 2)
        end function

        function shortcutResponse(seasons as object, enabled = true as boolean) as object
            request = m.createRequest()
            request.item = m.createSeries()
            request.settings[SettingsStore.Key.SkipSingleSeasonSeries] = (enabled ? "on" : "off")
            m.top.loadRequest = request
            m.node.pageState.detailsLoad = LatestRequestLifecycle.Create()
            'bs:disable-next-line 1140
            onLoadRequestChanged()
            entry = m.node.pageState.detailsLoad.active
            skipSeriesPage = false
            if enabled and seasons.Count() = 1 then skipSeriesPage = Strings.ToString(seasons[0].Id) <> ""
            return { ok: true, action: "tvShow", requestId: entry.request.requestId, payload: { series: m.createSeries(), seasons: { Items: seasons }, skipSeriesPage: skipSeriesPage } }
        end function

        @describe("single-season shortcut")

        @it("keeps series visuals hidden while resolving an enabled shortcut")
        function _()
            response = m.shortcutResponse([m.createSeason("season-1", "Season 1")])

            m.assertEqual(m.top.opacity, 0.0)
            m.assertTrue(m.node.pageState.detailsLoad.active.request.skipSingleSeason)
            m.assertInvalid(m.top.selectedSeason)
        end function

        @it("opens the only regular season")
        function _()
            response = m.shortcutResponse([m.createSeason("season-1", "Season 1")], true)

            'bs:disable-next-line 1140
            handleTVShowResponse(response)

            m.assertEqual(m.top.selectedSeason.seasonId, "season-1")
            m.assertTrue(m.top.selectedSeason.skipSeriesPage)
            m.assertEqual(m.top.selectedSeason.seriesId, "series-1")
        end function

        @it("opens a Specials-only series")
        function _()
            response = m.shortcutResponse([{ Id: "specials", Name: "Specials", IndexNumber: 0 }], true)

            'bs:disable-next-line 1140
            handleTVShowResponse(response)

            m.assertEqual(m.top.selectedSeason.seasonId, "specials")
            m.assertTrue(m.top.selectedSeason.skipSeriesPage)
            m.assertEqual(m.top.selectedSeason.seriesId, "series-1")
        end function

        @it("keeps Season 1 plus Specials on the series page")
        function _()
            response = m.shortcutResponse([{ Id: "specials", IndexNumber: 0 }, m.createSeason("season-1", "Season 1")], true)

            'bs:disable-next-line 1140
            handleTVShowResponse(response)

            m.assertInvalid(m.top.selectedSeason)
            m.assertEqual(m.top.opacity, 1.0)
            m.assertTrue(m.node.pageState.seriesLoaded)
        end function

        @it("keeps multiple regular seasons on the series page")
        function _()
            response = m.shortcutResponse([m.createSeason("season-1", "Season 1"), m.createSeason("season-2", "Season 2")], true)

            'bs:disable-next-line 1140
            handleTVShowResponse(response)

            m.assertInvalid(m.top.selectedSeason)
            m.assertEqual(m.top.opacity, 1.0)
            m.assertTrue(m.node.pageState.seriesLoaded)
        end function

        @it("keeps an empty series on the series page")
        function _()
            response = m.shortcutResponse([], true)

            'bs:disable-next-line 1140
            handleTVShowResponse(response)

            m.assertInvalid(m.top.selectedSeason)
            m.assertEqual(m.top.opacity, 1.0)
            m.assertTrue(m.node.pageState.seriesLoaded)
        end function

        @it("keeps a season without an ID on the series page")
        function _()
            response = m.shortcutResponse([{ Name: "Season 1" }], true)

            'bs:disable-next-line 1140
            handleTVShowResponse(response)

            m.assertInvalid(m.top.selectedSeason)
            m.assertEqual(m.top.opacity, 1.0)
            m.assertTrue(m.node.pageState.seriesLoaded)
        end function

        @it("keeps the series page when the setting is Off")
        function _()
            response = m.shortcutResponse([m.createSeason("season-1", "Season 1")], false)

            'bs:disable-next-line 1140
            handleTVShowResponse(response)

            m.assertInvalid(m.top.selectedSeason)
            m.assertEqual(m.top.opacity, 1.0)
            m.assertTrue(m.node.pageState.seriesLoaded)
        end function

        @it("restores the series surface when loading fails")
        function _()
            response = m.shortcutResponse([])
            response.ok = false
            response.errorMessage = "Unavailable"
            m.stubCall(AppMessage.Show, invalid)

            'bs:disable-next-line 1140
            handleTVShowResponse(response)

            m.assertInvalid(m.top.selectedSeason)
            m.assertEqual(m.top.opacity, 1.0)
        end function

        @it("ignores a shortcut response after deactivation")
        function _()
            response = m.shortcutResponse([m.createSeason("season-1", "Season 1")])
            'bs:disable-next-line 1140
            deactivate()

            'bs:disable-next-line 1140
            handleTVShowResponse(response)

            m.assertInvalid(m.top.selectedSeason)
        end function

        @it("ignores the superseded series response")
        function _()
            response = m.shortcutResponse([m.createSeason("season-1", "Season 1")])
            LatestRequestLifecycle.Queue(m.node.pageState.detailsLoad, m.createRequest())

            'bs:disable-next-line 1140
            handleTVShowResponse(response)

            m.assertInvalid(m.top.selectedSeason)
        end function

        @it("does not redirect again for a repeated response")
        function _()
            response = m.shortcutResponse([m.createSeason("season-1", "Season 1")])
            'bs:disable-next-line 1140
            handleTVShowResponse(response)
            m.top.selectedSeason = invalid

            'bs:disable-next-line 1140
            handleTVShowResponse(response)

            m.assertInvalid(m.top.selectedSeason)
        end function

    end class

end namespace
