            'bs:disable-next-line 1140
            showEpisodeAtQueueIndex(1)
            m.assertInvalid(m.node.loadRequest)
        end function

        @it("resolves current series and season identities using documented precedence")
        function _()
            m.node.state.request = {
                seriesId: "request-series"
                series: { Id: "series-object", Name: "Series" }
                seasonId: "request-season"
                season: invalid
                seasons: []
            }
            m.node.state.itemContent = {
                raw: { SeriesId: "item-series", SeasonId: "item-season", SeasonName: "Season 4" }
            }

            'bs:disable-next-line 1140
            m.assertEqual(getCurrentSeriesId(), "item-series")
            'bs:disable-next-line 1140
            m.assertEqual(getCurrentSeasonId(), "request-season")
            'bs:disable-next-line 1140
            selection = getCurrentSeasonSelection()
            m.assertEqual(selection.seriesId, "item-series")
            m.assertEqual(selection.seasonId, "request-season")
            m.assertEqual(selection.season.Name, "Season 4")
        end function

        @it("retains cast focus after a valid person selection")
        function _()
