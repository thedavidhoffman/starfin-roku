namespace tests

    @SGNode("TVEpisode")
    @suite("TVEpisode component")
    class TVEpisodeTests extends rooibos.BaseTestSuite

        @describe("season details")

        @it("formats season metadata using the real media type")
        function _()
            season = { itemType: "Season", raw: { Type: "Season", IndexNumber: 3, ChildCount: 8, ProductionYear: 2025 } }
            'bs:disable-next-line 1140
            m.assertEqual(getEpisodePositionText(season), "Season 3")
            'bs:disable-next-line 1140
            m.assertEqual(getSecondaryMetadataText(season), "8 episodes" + MediaMetadata.BulletSeparator() + "2025")
            'bs:disable-next-line 1140
            m.assertEqual(getMediaShellType(season), "tv-season")
        end function

        @it("plays the first episode from a season summary")
        function _()
            episode = { Id: "episode-1", Type: "Episode", UserData: {} }
            m.node.state.request = { server: "http://server", itemId: "season-1", series: { Id: "series-1", Name: "Series" }, playbackQueueScope: "series", playbackQueue: [{ itemId: "episode-1", item: episode, season: { Id: "season-1" }, startPositionTicks: 0 }] }
            'bs:disable-next-line 1140
            selection = buildPlaySelection({ Id: "season-1", Type: "Season" })
            m.assertEqual(selection.itemId, "episode-1")
            m.assertEqual(selection.item.Type, "Episode")
            m.assertEqual(selection.playbackQueueIndex, 0)
        end function

        @it("does not create a play target for an empty season")
        function _()
            m.node.state.request = { itemId: "season-1", playbackQueue: [] }
            'bs:disable-next-line 1140
            m.assertInvalid(buildPlaySelection({ Id: "season-1", Type: "Season" }))
        end function

        @it("keeps season watched actions from replacing the playable episode")
        function _()
            episode = { Id: "episode-1", Type: "Episode", UserData: { Played: false } }
            m.node.state.request = { server: "http://server", series: { Id: "series-1" }, playbackQueueScope: "series", playbackQueue: [{ itemId: "episode-1", item: episode, season: { Id: "season-1" }, startPositionTicks: 0 }] }
            season = { itemId: "season-1", itemType: "Season", raw: { Id: "season-1", Type: "Season", ChildCount: 1, UserData: { UnplayedItemCount: 1 } } }
            'bs:disable-next-line 1140
            updateItemWatchedState(season, true)
            m.assertEqual(season.raw.UserData.UnplayedItemCount, 0)
            m.assertEqual(m.node.state.playSelection.itemId, "episode-1")
            m.assertEqual(m.node.state.playSelection.item.Type, "Episode")
            m.assertTrue(m.node.state.playSelection.item.UserData.Played)
        end function

        @it("uses the known season count when marked unwatched")
        function _()
            m.node.state.request = invalid
            m.node.state.playSelection = invalid
            season = { itemId: "season-1", itemType: "Season", raw: { ChildCount: 8, UserData: { UnplayedItemCount: 0 } } }
            'bs:disable-next-line 1140
            updateItemWatchedState(season, false)
            m.assertEqual(season.raw.UserData.UnplayedItemCount, 8)
        end function

        @describe("local helper responsibilities")

        @it("formats episode rendering metadata")
        function _()
            episode = {
                itemType: "Episode"
                raw: { Type: "Episode", ParentIndexNumber: 2, IndexNumber: 10 }
            }

            'bs:disable-next-line 1140
            m.assertEqual(getEpisodePositionText(episode), "Season 2" + MediaMetadata.BulletSeparator() + "Episode 10")
        end function

        @it("applies a loaded series queue to episode navigation")
        function _()
            queue = [
                { itemId: "s2e10", item: { Id: "s2e10", Type: "Episode" }, season: { Id: "season-2" } }
                { itemId: "s3e1", item: { Id: "s3e1", Type: "Episode" }, season: { Id: "season-3" } }
                { itemId: "s3e2", item: { Id: "s3e2", Type: "Episode" }, season: { Id: "season-3" } }
            ]
            m.node.state.layout.isCinematic = true
            m.node.state.request = {
                item: queue[1].item
                playbackQueue: invalid
                playbackQueueIndex: invalid
            }

            'bs:disable-next-line 1140
            applyPlaybackQueueDetails({
                playbackQueue: queue
                playbackQueueIndex: 1
                playbackQueueScope: "series"
                season: queue[1].season
            })

            m.assertEqual(m.node.state.episodeBrowse.index, 1)
            m.assertEqual(m.node.state.episodeBrowse.count, 3)
            m.assertTrue(m.node.previousNextButton.hasPrevious)
            m.assertTrue(m.node.previousNextButton.hasNext)
            'bs:disable-next-line 1140
            m.assertTrue(canShowEpisodeBrowse())
        end function

        @it("disables navigation at series queue boundaries")
        function _()
            m.node.state.layout.isCinematic = true
            m.node.state.request = {
                item: { Id: "first", Type: "Episode" }
                playbackQueue: [{ itemId: "first" }, { itemId: "last" }]
                playbackQueueIndex: 0
                playbackQueueScope: "series"
            }

            'bs:disable-next-line 1140
            updateEpisodeBrowseState()
            m.assertFalse(m.node.previousNextButton.hasPrevious)
            m.assertTrue(m.node.previousNextButton.hasNext)

            m.node.state.request.playbackQueueIndex = 1
            'bs:disable-next-line 1140
            updateEpisodeBrowseState()
            m.assertTrue(m.node.previousNextButton.hasPrevious)
            m.assertFalse(m.node.previousNextButton.hasNext)
        end function

        @it("keeps episode navigation hidden when a reused page leaves cinematic mode")
        function _()
            m.node.state.layout.isCinematic = true
            m.node.state.request = {
                item: { Id: "second", Type: "Episode" }
                playbackQueue: [{ itemId: "first" }, { itemId: "second" }]
                playbackQueueIndex: 1
                playbackQueueScope: "series"
            }

            'bs:disable-next-line 1140
            updateEpisodeBrowseState()
            m.assertTrue(m.node.previousNextButton.visible)

            settings = {}
            settings[SettingsStore.Key.MediaShellBackground] = "full-screen"
            'bs:disable-next-line 1140
            applyMediaShellBackgroundSetting(settings)
            'bs:disable-next-line 1140
            updateEpisodeBrowseState()

            m.assertFalse(m.node.state.layout.isCinematic)
            m.assertFalse(m.node.previousNextButton.visible)
        end function

