        @it("routes up through a focusable description before episode browsing")
        function _()
            description = m.node.mediaShell.findNode("overviewDescription")
            description.canAcceptFocus = true
            m.node.previousNextButton.displayEnabled = true
            m.node.previousNextButton.hasNext = true
            m.node.state.focusArea = "toolbar"

            'bs:disable-next-line 1140
            m.assertTrue(onKeyEvent("up", true))
            m.assertEqual(m.node.state.focusArea, "description")
            'bs:disable-next-line 1140
            m.assertTrue(onKeyEvent("up", true))
            m.assertEqual(m.node.state.focusArea, "episodeBrowse")
            'bs:disable-next-line 1140
            m.assertTrue(onKeyEvent("down", true))
            m.assertEqual(m.node.state.focusArea, "description")
            'bs:disable-next-line 1140
            m.assertTrue(onKeyEvent("down", true))
            m.assertEqual(m.node.state.focusArea, "toolbar")
            'bs:disable-next-line 1140
            m.assertFalse(onKeyEvent("back", false))
            'bs:disable-next-line 1140
            m.assertTrue(onKeyEvent("back", true))
        end function

        @it("routes up directly to episode browsing when description cannot focus")
        function _()
            description = m.node.mediaShell.findNode("overviewDescription")
            description.canAcceptFocus = false
