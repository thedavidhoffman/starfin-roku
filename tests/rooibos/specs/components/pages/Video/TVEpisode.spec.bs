        @it("preserves selected audio through metadata rendering")
        function _()
            item = { MediaStreams: [{ Type: "Video", Width: 1920, Codec: "h264" }, { Type: "Audio", Index: 2, Codec: "ac3", Channels: 6, IsDefault: true }, { Type: "Audio", Index: 4, Codec: "aac", Channels: 2 }] }
