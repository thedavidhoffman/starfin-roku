import "pkg:/source/MediaCardContent.bs"
import "pkg:/source/DateTime.bs"
import "pkg:/source/MediaMetadataFormatting.bs"
import "pkg:/source/Number.bs"

import "pkg:/source/VideoCardGridLayout.bs"

namespace tests

    @SGNode("VideoMediaCard")
    @suite("VideoMediaCard component")
    class VideoMediaCardTests extends rooibos.BaseTestSuite

        protected override function beforeEach()
            m.originalCountMode = m.global.showUnwatchedEpisodeCount
            m.global.showUnwatchedEpisodeCount = "off"
        end function

        protected override function afterEach()
            m.global.showUnwatchedEpisodeCount = m.originalCountMode
        end function

        @describe("declarative component contract")

        @it("declares the contentGroup node")
        function _()
            m.assertNotInvalid(m.top.findNode("contentGroup"))
        end function

        @it("declares the posterMask node")
        function _()
            m.assertNotInvalid(m.top.findNode("posterMask"))
        end function

        @it("declares the poster node")
        function _()
            m.assertNotInvalid(m.top.findNode("poster"))
        end function

        @it("declares the masked artwork background")
        function _()
            m.assertNotInvalid(m.top.findNode("artworkBackground"))
        end function

        @it("declares the progressBar node")
        function _()
            m.assertNotInvalid(m.top.findNode("progressBar"))
        end function

        @it("declares the watchedIndicator node")
        function _()
            m.assertNotInvalid(m.top.findNode("watchedIndicator"))
        end function

        @it("declares the title node")
        function _()
            m.assertNotInvalid(m.top.findNode("title"))
        end function

        @it("declares the metadataLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("metadataLabel"))
        end function

        @describe("fresh component observers")

        @it("renders content on a fresh component")
        function _()
            component = CreateObject("roSGNode", "VideoMediaCard")
            item = m.createItem({ Type: "Movie", Name: "Fresh movie", UserData: {} })
            item.imageAspect = "thumbnail"

            component.itemContent = item

            m.assertEqual(component.findNode("presentation").subtype(), "VideoThumbnailCard")
            m.assertEqual(component.findNode("title").text, "Fresh movie")
            m.assertEqual(component.findNode("presentation").itemContent, item)
        end function

        @describe("media rendering")

        @it("renders a movie title")
        function _()
            item = m.createItem({ Type: "Movie", Name: "Movie", UserData: {} })

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("title").text, "Movie")
        end function

        @it("renders an episode series name as the title")
        function _()
            item = m.createItem({ Type: "Episode", Name: "Episode", SeriesName: "Series", UserData: {} })

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("title").text, "Series")
        end function

        @it("renders a movie production year")
        function _()
            item = m.createItem({ Type: "Movie", Name: "Movie", ProductionYear: 2024, UserData: {} })

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("metadataLabel").text, "2024")
        end function

        @it("renders a photo capture date instead of its parent folder")
        function _()
            item = m.createItem({
                Type: "Photo"
                Name: "IMG_0001.jpg"
                PremiereDate: "2022-08-14T15:30:00Z"
                DateCreated: "2022-08-15T00:00:00Z"
                Album: "Vacation"
                UserData: {}
            })
            item.AddFields({ line2: { text: "Aug 14, 2022" + MediaMetadataFormatting.BulletSeparator() + DateTime.ToLocalShortTime("2022-08-14T15:30:00Z"), style: MediaCard.TextStyle.Muted }, detailMetadata: invalid })

            m.top.itemContent = item

            expected = "Aug 14, 2022" + MediaMetadataFormatting.BulletSeparator() + DateTime.ToLocalShortTime("2022-08-14T15:30:00Z")
            m.assertEqual(m.top.findNode("metadataLabel").text, expected)
        end function

        @it("falls back to the photo created date when capture premiere date is absent")
        function _()
            item = m.createItem({ Type: "Photo", Name: "IMG_0001.jpg", DateCreated: "2022-08-15T00:00:00Z", Album: "Vacation", UserData: {} })
            item.AddFields({ line2: { text: "Aug 15, 2022" + MediaMetadataFormatting.BulletSeparator() + DateTime.ToLocalShortTime("2022-08-15T00:00:00Z"), style: MediaCard.TextStyle.Muted }, detailMetadata: invalid })

            m.top.itemContent = item

            expected = "Aug 15, 2022" + MediaMetadataFormatting.BulletSeparator() + DateTime.ToLocalShortTime("2022-08-15T00:00:00Z")
            m.assertEqual(m.top.findNode("metadataLabel").text, expected)
        end function

        @it("leaves photo metadata blank when no capture date is available")
        function _()
            item = m.createItem({ Type: "Photo", Name: "IMG_0001.jpg", Album: "Vacation", UserData: {} })
            item.AddFields({ line2: { text: "", style: MediaCard.TextStyle.Muted }, detailMetadata: invalid })

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("metadataLabel").text, "")
        end function

        @it("renders the immediate item count for a home media folder")
        function _()
            item = m.createItem({ Type: "Folder", Name: "Vacation", ChildCount: 24, UserData: {} })
            item.AddFields({ line2: { text: "24 items", style: MediaCard.TextStyle.Muted }, detailMetadata: invalid })

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("metadataLabel").text, "24 items")
        end function

        @it("renders a singular item count for a photo album")
        function _()
            item = m.createItem({ Type: "PhotoAlbum", Name: "Vacation", ChildCount: 1, UserData: {} })
            item.AddFields({ line2: { text: "1 item", style: MediaCard.TextStyle.Muted }, detailMetadata: invalid })

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("metadataLabel").text, "1 item")
        end function

        @it("renders an empty item count for an empty folder")
        function _()
            item = m.createItem({ Type: "Folder", Name: "Empty", ChildCount: 0, UserData: {} })
            item.AddFields({ line2: { text: "0 items", style: MediaCard.TextStyle.Muted }, detailMetadata: invalid })

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("metadataLabel").text, "0 items")
        end function

        @it("hides internal folder types when child count is unavailable")
        function _()
            item = m.createItem({ Type: "PhotoAlbum", Name: "Vacation", UserData: {} })
            item.AddFields({ line2: { text: "", style: MediaCard.TextStyle.Muted }, detailMetadata: invalid })

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("metadataLabel").text, "")
        end function

        @it("renders episode season and number metadata")
        function _()
            item = m.createItem({ Type: "Episode", Name: "Pilot", SeriesName: "Series", ParentIndexNumber: 1, IndexNumber: 2, UserData: {} })

            m.top.itemContent = item

            metadata = m.top.findNode("metadataLabel").text
            m.assertTrue(Instr(1, metadata, "S1") > 0)
            m.assertTrue(Instr(1, metadata, "E2 - Pilot") > 0)
        end function

        @it("renders supplied artwork")
        function _()
            item = m.createItem({ Type: "Movie", Name: "Movie", UserData: {} })
            item.HDPosterUrl = "http://server/poster.jpg"

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("poster").uri, "http://server/poster.jpg")
        end function

        @it("preserves photo artwork aspect ratio when requested")
        function _()
            item = m.createItem({ Type: "Photo", Name: "Photo", UserData: {} })
            item.fitArtwork = true

            m.top.itemContent = item

            m.assertEqual(LCase(m.top.findNode("poster").loadDisplayMode), "scaletofit")
        end function

        @it("shows the artwork background only when explicitly requested")
        function _()
            item = m.createItem({ Type: "Photo", Name: "Photo", UserData: {} })
            item.showArtworkBackground = true

            m.top.itemContent = item

            m.assertTrue(m.top.findNode("artworkBackground").visible)
            m.assertEqual(m.top.findNode("artworkBackground").uri, "pkg:/images/media-card/photo-artwork-background.png")
            m.assertEqual(LCase(m.top.findNode("artworkBackground").loadDisplayMode), "scaletofill")
        end function

        @it("clears the artwork background when a card is recycled for video")
        function _()
            photo = m.createItem({ Type: "Photo", Name: "Photo", UserData: {} })
            photo.showArtworkBackground = true
            m.top.itemContent = photo

            video = m.createItem({ Type: "Video", Name: "Video", UserData: {} })
            m.top.itemContent = video

            m.assertFalse(m.top.findNode("artworkBackground").visible)
        end function

        @it("fills the standard mask for ordinary video artwork")
        function _()
            item = m.createItem({ Type: "Video", Name: "Video", UserData: {} })

            m.top.itemContent = item

            m.assertEqual(LCase(m.top.findNode("poster").loadDisplayMode), "scaletozoom")
        end function

        @it("uses a poster placeholder for missing poster artwork")
        function _()
            item = m.createItem({ Type: "Movie", Name: "Movie", UserData: {} })

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("poster").uri, "pkg:/images/media-card/poster-placeholder-252x378.png")
        end function

        @it("uses a thumbnail placeholder for missing thumbnail artwork")
        function _()
            item = m.createItem({ Type: "Movie", Name: "Movie", UserData: {} })
            item.imageAspect = "thumbnail"

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("poster").uri, "pkg:/images/media-card/thumbnail-placeholder-441x249.png")
        end function

        @it("hides metadata when requested")
        function _()
            item = m.createItem({ Type: "Movie", Name: "Movie", UserData: {} })
            item.line2 = invalid
            item.detailMetadata = invalid

            m.top.itemContent = item

            m.assertFalse(m.top.findNode("metadataLabel").visible)
        end function

        @it("hides detailed metadata when requested")
        function _()
            item = m.createItem({ Type: "Movie", Name: "Movie", UserData: {} })
            item.imageAspect = "detailed"
            item.line2 = invalid
            item.detailMetadata = invalid

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("presentation").subtype(), "VideoDetailedCard")
            m.assertFalse(m.top.findNode("metadataLabel").visible)
        end function

        @describe("card layouts")

        @it("applies poster dimensions by default")
        function _()
            m.top.itemContent = m.createItem({ Type: "Movie", Name: "Movie", UserData: {} })

            m.assertEqual(m.top.findNode("presentation").subtype(), "VideoPosterCard")
            m.assertEqual(Number.ToInteger(m.top.findNode("poster").width, -1), 252)
            m.assertEqual(Number.ToInteger(m.top.findNode("poster").height, -1), 378)
        end function

        @it("applies thumbnail dimensions")
        function _()
            item = m.createItem({ Type: "Movie", Name: "Movie", UserData: {} })
            item.imageAspect = "thumbnail"

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("presentation").subtype(), "VideoThumbnailCard")
            m.assertEqual(Number.ToInteger(m.top.findNode("poster").width, -1), 441)
            m.assertEqual(Number.ToInteger(m.top.findNode("poster").height, -1), 249)
            m.assertEqual(Number.ToInteger(m.top.findNode("artworkBackground").width, -1), 441)
            m.assertEqual(Number.ToInteger(m.top.findNode("artworkBackground").height, -1), 249)
        end function

        @it("applies responsive poster dimensions from the resolved card layout")
        function _()
            item = m.createItem({ Type: "Movie", Name: "Movie", UserData: {} })
            item.imageAspect = "poster"
            item.addFields({ cardLayout: VideoCardGridLayout.GetSpec("poster", "items", 3) })

            m.top.itemContent = item

            m.assertEqual(Number.ToInteger(m.top.findNode("poster").width, -1), 537)
            m.assertEqual(Number.ToInteger(m.top.findNode("poster").height, -1), 806)
            m.assertEqual(Number.ToInteger(m.top.findNode("progressBar").barWidth, -1), 519)
            m.assertTrue(Instr(1, m.top.findNode("posterMask").maskUri, "poster-3-col-mask.png") > 0)
        end function

        @it("hides poster metadata in the three-column layout")
        function _()
            item = m.createItem({ Type: "Movie", Name: "Movie", ProductionYear: 2026, UserData: {} })
            item.imageAspect = "poster"
            item.addFields({ cardLayout: VideoCardGridLayout.GetSpec("poster", "items", 3) })

            m.top.itemContent = item

            m.assertTrue(m.top.findNode("title").visible)
            m.assertFalse(m.top.findNode("metadataLabel").visible)
        end function

        @it("keeps poster metadata in layouts with more than three columns")
        function _()
            item = m.createItem({ Type: "Movie", Name: "Movie", ProductionYear: 2026, UserData: {} })
            item.imageAspect = "poster"
            item.addFields({ cardLayout: VideoCardGridLayout.GetSpec("poster", "items", 4) })

            m.top.itemContent = item

            m.assertTrue(m.top.findNode("metadataLabel").visible)
        end function

        @it("applies responsive thumbnail dimensions from the resolved card layout")
        function _()
            item = m.createItem({ Type: "Movie", Name: "Movie", UserData: {} })
            item.imageAspect = "thumbnail"
            item.addFields({ cardLayout: VideoCardGridLayout.GetSpec("thumbnail", "items", 2) })

            m.top.itemContent = item

            m.assertEqual(Number.ToInteger(m.top.findNode("poster").width, -1), 906)
            m.assertEqual(Number.ToInteger(m.top.findNode("poster").height, -1), 510)
            m.assertEqual(Number.ToInteger(m.top.findNode("progressBar").barWidth, -1), 888)
            m.assertTrue(Instr(1, m.top.findNode("posterMask").maskUri, "thumbnail-2-col-mask.png") > 0)
        end function

        @it("keeps thumbnail metadata in the three-column layout")
        function _()
            item = m.createItem({ Type: "Movie", Name: "Movie", ProductionYear: 2026, UserData: {} })
            item.imageAspect = "thumbnail"
            item.addFields({ cardLayout: VideoCardGridLayout.GetSpec("thumbnail", "items", 3) })

            m.top.itemContent = item

            m.assertTrue(m.top.findNode("metadataLabel").visible)
            m.assertEqual(m.top.findNode("metadataLabel").text, "2026")
        end function

        @it("switches from detailed presentation back to poster")
        function _()
            detailedItem = m.createItem({ Type: "Movie", Name: "Detailed", Overview: "Overview", UserData: {} })
            detailedItem.imageAspect = "detailed"
            m.top.itemContent = detailedItem

            m.assertEqual(m.top.findNode("presentation").subtype(), "VideoDetailedCard")

            posterItem = m.createItem({ Type: "Movie", Name: "Poster", UserData: {} })
            m.top.itemContent = posterItem

            m.assertEqual(m.top.findNode("presentation").subtype(), "VideoPosterCard")
            m.assertEqual(Number.ToInteger(m.top.findNode("poster").width, -1), 252)
        end function

        @describe("playback state")

        @it("shows the watched indicator for played media")
        function _()
            item = m.createItem({ Type: "Movie", Name: "Movie", UserData: { Played: true } })

            m.top.itemContent = item

            m.assertTrue(m.top.findNode("watchedIndicator").visible)
        end function

        @it("shows progress for partially played media")
        function _()
            item = m.createItem({ Type: "Movie", Name: "Movie", UserData: { Played: false, PlayedPercentage: 50 } })

            m.top.itemContent = item

            m.assertTrue(m.top.findNode("progressBar").visible)
            m.assertTrue(m.top.findNode("progressBar").progressWidth > 0)
        end function

        @it("renders fractional progress from playback ticks")
        function _()
            raw = {
                Type: "Movie"
                Name: "Movie"
                RunTimeTicks: 1000
                UserData: { Played: false, PlaybackPositionTicks: 250 }
            }
            item = m.createItem(raw)

            m.top.itemContent = item

            m.assertTrue(m.top.findNode("progressBar").visible)
            progressBar = m.top.findNode("progressBar")
            m.assertTrue(progressBar.progressWidth = int(progressBar.barWidth * 0.25))
        end function

        @it("hides progress for played media")
        function _()
            item = m.createItem({ Type: "Movie", Name: "Movie", UserData: { Played: true, PlayedPercentage: 50 } })

            m.top.itemContent = item

            m.assertFalse(m.top.findNode("progressBar").visible)
        end function

        @it("hides watched state for music videos")
        function _()
            item = m.createItem({ Type: "MusicVideo", Name: "Song", UserData: { Played: true } })

            m.top.itemContent = item

            m.assertFalse(m.top.findNode("watchedIndicator").visible)
        end function

        @it("hides playback progress for music videos")
        function _()
            item = m.createItem({ Type: "MusicVideo", Name: "Song", UserData: { Played: false, PlayedPercentage: 50 } })

            m.top.itemContent = item

            m.assertFalse(m.top.findNode("progressBar").visible)
            m.assertEqual(Number.ToInteger(m.top.findNode("progressBar").progressWidth, -1), 0)
        end function

        @it("shows progress state for Home Media videos")
        function _()
            item = m.createItem({ Type: "Video", Name: "Home Video", UserData: { Played: false, PlayedPercentage: 50 } })
            item.AddFields({ showWatchedIndicator: false })

            m.top.itemContent = item

            m.assertTrue(m.top.findNode("progressBar").visible)
            m.assertTrue(m.top.findNode("progressBar").progressWidth > 0)
        end function

        @it("hides watched state for Home Media folders")
        function _()
            item = m.createItem({ Type: "Folder", Name: "Folder", UserData: { Played: true } })
            item.AddFields({ tracksPlaybackProgress: false })

            m.top.itemContent = item

            m.assertFalse(m.top.findNode("watchedIndicator").visible)
        end function

        @it("restores watched state when a Home Media card is recycled for an ordinary video")
        function _()
            homeVideo = m.createItem({ Type: "Video", Name: "Home Video", UserData: { Played: true } })
            homeVideo.AddFields({ showWatchedIndicator: false })
            m.top.itemContent = homeVideo

            ordinaryVideo = m.createItem({ Type: "Video", Name: "Video", UserData: { Played: true } })
            m.top.itemContent = ordinaryVideo

            m.assertTrue(m.top.findNode("watchedIndicator").visible)
        end function

        @it("restores progress rendering when a music-video card is recycled")
        function _()
            musicVideo = m.createItem({ Type: "MusicVideo", Name: "Song", UserData: { Played: true, PlayedPercentage: 50 } })
            m.top.itemContent = musicVideo

            movie = m.createItem({ Type: "Movie", Name: "Movie", UserData: { Played: false, PlayedPercentage: 50 } })
            m.top.itemContent = movie

            m.assertFalse(m.top.findNode("watchedIndicator").visible)
            m.assertTrue(m.top.findNode("progressBar").visible)
        end function

        @it("restores watched rendering for an episode after recycling")
        function _()
            m.top.itemContent = m.createItem({ Type: "MusicVideo", Name: "Song", UserData: { Played: true } })

            m.top.itemContent = m.createItem({ Type: "Episode", Name: "Episode", UserData: { Played: true } })

            m.assertTrue(m.top.findNode("watchedIndicator").visible)
        end function

        @it("restores progress rendering for an ordinary video after recycling")
        function _()
            m.top.itemContent = m.createItem({ Type: "MusicVideo", Name: "Song", UserData: { PlayedPercentage: 50 } })

            m.top.itemContent = m.createItem({ Type: "Video", Name: "Video", UserData: { Played: false, PlayedPercentage: 50 } })

            m.assertTrue(m.top.findNode("progressBar").visible)
        end function

        function createItem(raw as object) as object
            item = CreateObject("roSGNode", "ContentNode")
            item.AddFields(MediaCardContent.Build(raw, true, false))
            item.addFields({ raw: raw, imageAspect: "poster", fitArtwork: false, showArtworkBackground: false })
            return item
        end function

        @it("hides home video watched badges without suppressing tracking")
        function _()
            item = m.createItem({ Type: "Video", Name: "Home Video", UserData: { Played: true } })
            item.AddFields({ showWatchedIndicator: false })

            m.top.itemContent = item

            m.assertFalse(m.top.findNode("watchedIndicator").visible)
            m.assertFalse(m.top.findNode("progressBar").visible)
        end function

        @it("uses the current watched indicator style")
        function _()
            originalStyle = m.global.watchedIndicatorStyle

            m.global.watchedIndicatorStyle = "high-contrast"

            m.assertEqual(m.top.findNode("watchedIndicator").findNode("watchedCheck").uri, "pkg:/images/icons/watched-check-high-contrast.png")
            m.global.watchedIndicatorStyle = originalStyle
        end function

        @describe("series count rendering")

        @it("renders remaining episodes on a series card")
        function _()
            m.global.showUnwatchedEpisodeCount = "subtle"

            m.top.itemContent = m.createItem({ Type: "Series", Name: "Series", UserData: { Played: false, UnplayedItemCount: 200 } })

            m.assertTrue(m.top.findNode("watchedIndicator").visible)
            m.assertEqual(m.top.findNode("watchedIndicator").findNode("countLabel").text, "200")
            m.assertEqual(m.top.findNode("watchedIndicator").data, { eligible: true, isWatched: false, unplayedCount: 200, width: 42, height: 42 })
        end function

        @it("updates an existing card when raw user data is replaced")
        function _()
            m.global.showUnwatchedEpisodeCount = "subtle"
            item = m.createItem({ Type: "Series", UserData: { UnplayedItemCount: 200 } })
            m.top.itemContent = item

            item.raw = { Type: "Series", UserData: { UnplayedItemCount: 2 } }

            m.assertEqual(m.top.findNode("watchedIndicator").findNode("countLabel").text, "2")
        end function

        @it("keeps individual episodes as watched checks")
        function _()
            m.global.showUnwatchedEpisodeCount = "subtle"

            m.top.itemContent = m.createItem({ Type: "Episode", UserData: { Played: true, UnplayedItemCount: 200 } })

            m.assertTrue(m.top.findNode("watchedIndicator").findNode("watchedCheck").visible)
            m.assertFalse(m.top.findNode("watchedIndicator").findNode("countGroup").visible)
        end function

        @it("suppresses count badges when the content policy hides indicators")
        function _()
            m.global.showUnwatchedEpisodeCount = "subtle"
            item = m.createItem({ Type: "Series", UserData: { UnplayedItemCount: 200 } })
            item.AddFields({ showWatchedIndicator: false })

            m.top.itemContent = item

            m.assertFalse(m.top.findNode("watchedIndicator").visible)
        end function

        @it("detaches the old content observer when a card is recycled")
        function _()
            m.global.showUnwatchedEpisodeCount = "subtle"
            original = m.createItem({ Type: "Series", UserData: { UnplayedItemCount: 200 } })
            replacement = m.createItem({ Type: "Series", UserData: { UnplayedItemCount: 2 } })
            m.top.itemContent = original
            m.top.itemContent = replacement

            original.raw = { Type: "Series", UserData: { UnplayedItemCount: 99 } }

            m.assertEqual(m.top.findNode("watchedIndicator").findNode("countLabel").text, "2")
        end function

        @it("clears an old count when content is removed")
        function _()
            m.global.showUnwatchedEpisodeCount = "subtle"
            m.top.itemContent = m.createItem({ Type: "Series", UserData: { UnplayedItemCount: 200 } })

            m.top.itemContent = invalid

            m.assertFalse(m.top.findNode("watchedIndicator").visible)
            m.assertEqual(m.top.findNode("watchedIndicator").data, { eligible: false, isWatched: false, unplayedCount: -1, width: 42, height: 42 })
        end function

        @describe("explicit text lines")

        @it("renders supplied text independently of the raw item")
        function _()
            card = CreateObject("roSGNode", "VideoMediaCard")
            item = m.createItem({ Name: "Raw name", ProductionYear: 1999 })
            item.line1 = { text: "Supplied title", style: MediaCard.TextStyle.Primary }
            item.line2 = { text: "as Character", style: MediaCard.TextStyle.Secondary }
            item.AddFields({ line3: { text: "2008", style: MediaCard.TextStyle.Muted } })

            card.itemContent = item

            m.assertEqual(card.findNode("title").text, "Supplied title")
            m.assertEqual(card.findNode("metadataLabel").text, "as Character")
            m.assertEqual(card.findNode("line3").text, "2008")
            m.assertTrue(card.findNode("line3").visible)
            m.assertEqual(card.findNode("metadataLabel").color, &hD8E2ECFF)
            m.assertEqual(card.findNode("line3").color, &hB9C7D6FF)
        end function

        @it("scrolls primary and secondary styles only on the focused card")
        function _()
            card = CreateObject("roSGNode", "VideoMediaCard")
            item = m.createItem({ Name: "Title" })
            item.line2 = { text: "as Character", style: MediaCard.TextStyle.Secondary }
            item.AddFields({ line3: { text: "2008", style: MediaCard.TextStyle.Muted } })
            card.itemContent = item

            card.itemHasFocus = true

            m.assertEqual(card.findNode("title").repeatCount, -1.0)
            m.assertEqual(card.findNode("metadataLabel").repeatCount, -1.0)
            m.assertEqual(card.findNode("line3").repeatCount, 0.0)
        end function

        @it("resets both scrolling lines when focus leaves")
        function _()
            card = CreateObject("roSGNode", "VideoMediaCard")
            item = m.createItem({ Name: "Title" })
            item.line2 = { text: "as Character", style: MediaCard.TextStyle.Secondary }
            card.itemContent = item
            card.itemHasFocus = true

            card.itemHasFocus = false

            m.assertEqual(card.findNode("title").repeatCount, 0.0)
            m.assertEqual(card.findNode("metadataLabel").repeatCount, 0.0)
        end function

        @it("keeps emphasis tied to style rather than line position")
        function _()
            card = CreateObject("roSGNode", "VideoMediaCard")
            item = m.createItem({ Name: "Title" })
            item.line2 = { text: "Year", style: MediaCard.TextStyle.Muted }
            item.AddFields({ line3: { text: "Credit", style: MediaCard.TextStyle.Secondary } })
            card.itemContent = item

            card.itemHasFocus = true

            m.assertEqual(card.findNode("metadataLabel").repeatCount, 0.0)
            m.assertEqual(card.findNode("line3").repeatCount, -1.0)
            m.assertEqual(card.findNode("line3").color, &hD8E2ECFF)
        end function

        @it("clears the third line when recycled for two lines")
        function _()
            card = CreateObject("roSGNode", "VideoMediaCard")
            first = m.createItem({ Name: "First" })
            first.AddFields({ line3: { text: "2008", style: MediaCard.TextStyle.Muted } })
            card.itemContent = first

            card.itemContent = m.createItem({ Name: "Second", ProductionYear: 2020 })

            m.assertFalse(card.findNode("line3").visible)
            m.assertEqual(card.findNode("line3").text, "")
            m.assertEqual(card.findNode("metadataLabel").text, "2020")
            m.assertEqual(card.findNode("metadataLabel").translation, [0.0, 429.0])
        end function

        @it("preserves focus scrolling when switching presentation")
        function _()
            card = CreateObject("roSGNode", "VideoMediaCard")
            card.itemContent = m.createItem({ Name: "Poster" })
            card.itemHasFocus = true
            nextItem = m.createItem({ Name: "Episode" })
            nextItem.imageAspect = "thumbnail"

            card.itemContent = nextItem

            m.assertEqual(card.findNode("presentation").subtype(), "VideoThumbnailCard")
            m.assertEqual(card.findNode("title").repeatCount, -1.0)
        end function

        @it("clears text and stops scrolling when content is removed")
        function _()
            card = CreateObject("roSGNode", "VideoMediaCard")
            card.itemContent = m.createItem({ Name: "Title" })
            card.itemHasFocus = true

            card.itemContent = invalid

            m.assertEqual(card.findNode("title").text, "")
            m.assertFalse(card.findNode("title").visible)
            m.assertEqual(card.findNode("title").repeatCount, 0.0)
        end function

        @describe("three-line spacing")

        @it("uses equal text steps on poster credits")
        function _()
            card = CreateObject("roSGNode", "VideoMediaCard")
            item = m.createItem({ Name: "Title" })
            item.line2 = { text: "as Character", style: MediaCard.TextStyle.Secondary }
            item.AddFields({ line3: { text: "2008", style: MediaCard.TextStyle.Muted } })

            card.itemContent = item

            m.assertEqual(card.findNode("title").translation, [0.0, 390.0])
            m.assertEqual(card.findNode("metadataLabel").translation, [0.0, 420.0])
            m.assertEqual(card.findNode("line3").translation, [0.0, 450.0])
            m.assertEqual(card.findNode("title").height, 30.0)
            m.assertEqual(card.findNode("metadataLabel").height, 30.0)
            m.assertEqual(card.findNode("line3").height, 30.0)
        end function

        @it("uses equal text steps on episode credits")
        function _()
            card = CreateObject("roSGNode", "VideoMediaCard")
            item = m.createItem({ Name: "Episode" })
            item.imageAspect = "thumbnail"
            item.line2 = { text: "as Character", style: MediaCard.TextStyle.Secondary }
            item.AddFields({ line3: { text: "1982", style: MediaCard.TextStyle.Muted } })

            card.itemContent = item

            m.assertEqual(card.findNode("title").translation, [0.0, 261.0])
            m.assertEqual(card.findNode("metadataLabel").translation, [0.0, 291.0])
            m.assertEqual(card.findNode("line3").translation, [0.0, 321.0])
        end function

        @it("places the year directly below the title when an episode role is empty")
        function _()
            card = CreateObject("roSGNode", "VideoMediaCard")
            item = m.createItem({ Name: "Simon and Simon" })
            item.imageAspect = "thumbnail"
            item.line2 = { text: "", style: MediaCard.TextStyle.Secondary }
            item.AddFields({ line3: { text: "1982", style: MediaCard.TextStyle.Muted } })

            card.itemContent = item
            card.itemHasFocus = true

            m.assertFalse(card.findNode("metadataLabel").visible)
            m.assertEqual(card.findNode("line3").translation, [0.0, 291.0])
            m.assertEqual(card.findNode("line3").text, "1982")
            m.assertEqual(card.findNode("line3").repeatCount, 0.0)
            m.assertEqual(card.findNode("line3").color, &hB9C7D6FF)
        end function

        @it("collapses an omitted poster role without resizing artwork")
        function _()
            card = CreateObject("roSGNode", "VideoMediaCard")
            item = m.createItem({ Name: "Title" })
            item.line2 = invalid
            item.AddFields({ line3: { text: "2008", style: MediaCard.TextStyle.Muted } })

            card.itemContent = item

            m.assertFalse(card.findNode("metadataLabel").visible)
            m.assertEqual(card.findNode("line3").translation, [0.0, 420.0])
            m.assertEqual(card.findNode("poster").height, 378.0)
        end function

        @it("restores role spacing when a card is recycled after a missing role")
        function _()
            card = CreateObject("roSGNode", "VideoMediaCard")
            missing = m.createItem({ Name: "First" })
            missing.line2 = { text: " ", style: MediaCard.TextStyle.Secondary }
            missing.AddFields({ line3: { text: "2008", style: MediaCard.TextStyle.Muted } })
            card.itemContent = missing
            m.assertEqual(card.findNode("line3").translation, [0.0, 420.0])
            replacement = m.createItem({ Name: "Next" })
            replacement.line2 = { text: "as Character", style: MediaCard.TextStyle.Secondary }
            replacement.AddFields({ line3: { text: "2010", style: MediaCard.TextStyle.Muted } })

            card.itemContent = replacement

            m.assertTrue(card.findNode("metadataLabel").visible)
            m.assertEqual(card.findNode("metadataLabel").translation, [0.0, 420.0])
            m.assertEqual(card.findNode("line3").translation, [0.0, 450.0])
        end function

        @describe("final presentation focus")

        @it("does not scroll a secondary line hidden by the poster presentation")
        function _()
            card = CreateObject("roSGNode", "VideoMediaCard")
            item = m.createItem({ Name: "Title" })
            item.line2 = { text: "Secondary text", style: MediaCard.TextStyle.Secondary }
            item.AddFields({ cardLayout: VideoCardGridLayout.GetSpec("poster", "items", 3) })
            card.itemHasFocus = true

            card.itemContent = item

            m.assertFalse(card.findNode("metadataLabel").visible)
            m.assertEqual(card.findNode("metadataLabel").repeatCount, 0.0)
            m.assertEqual(card.findNode("title").repeatCount, -1.0)
        end function

    end class

end namespace
