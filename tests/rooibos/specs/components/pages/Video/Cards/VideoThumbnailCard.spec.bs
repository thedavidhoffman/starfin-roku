import "pkg:/source/Number.bs"

namespace tests

    @SGNode("VideoThumbnailCard")
    @suite("VideoThumbnailCard component")
    class VideoThumbnailCardTests extends rooibos.BaseTestSuite

        @describe("thumbnail presentation")

        @it("renders thumbnail artwork and two title lines when metadata is hidden")
        function _()
            content = m.createContent({ Type: "Movie", Name: "Movie", UserData: {} })
            content.showMetadata = false

            m.top.itemContent = content

            m.assertEqual(Number.ToInteger(m.top.findNode("poster").width, -1), 441)
            m.assertEqual(Number.ToInteger(m.top.findNode("poster").height, -1), 249)
            m.assertEqual(Number.ToInteger(m.top.findNode("title").numLines, -1), 2)
            m.assertFalse(m.top.findNode("metadataLabel").visible)
        end function

        function createContent(raw as object) as object
            content = CreateObject("roSGNode", "ContentNode")
            content.addFields({ raw: raw, showMetadata: true, fitArtwork: false, showArtworkBackground: false, tracksPlaybackProgress: true })
            return content
        end function

    end class

end namespace
