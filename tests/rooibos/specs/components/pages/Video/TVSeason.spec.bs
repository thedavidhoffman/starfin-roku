        function _()
            m.assertNotInvalid(m.top.findNode("tvSeasonTaskAlternate"))
        end function

        @describe("season rendering and navigation")

        @it("renders series and season identity")
        function _()
            'bs:disable-next-line 1140
            renderSeason(m.node.pageState.season)

            m.assertEqual(m.top.findNode("logoBanner").title, "Series")
            m.assertEqual(m.top.findNode("seasonLabel").text, "Season 1")
        end function

        @it("renders previous and next season availability")
        function _()
            m.node.pageState.previousSeason = m.createSeason("season-0", "Season 0")
            m.node.pageState.nextSeason = m.createSeason("season-2", "Season 2")

            'bs:disable-next-line 1140
            renderSeason(m.node.pageState.season)

            nav = m.top.findNode("seasonNav")
            m.assertTrue(nav.hasPrevious)
            m.assertTrue(nav.hasNext)
        end function

        @it("hides season navigation in All Episodes mode")
        function _()
            m.node.pageState.allEpisodes = true
            m.node.pageState.previousSeason = m.createSeason("season-0", "Season 0")
            m.node.pageState.nextSeason = m.createSeason("season-2", "Season 2")

            'bs:disable-next-line 1140
            renderSeason(m.node.pageState.season)

            nav = m.top.findNode("seasonNav")
            m.assertFalse(nav.hasPrevious)
            m.assertFalse(nav.hasNext)
        end function

        @it("finds the previous relative season")
        function _()
            seasons = [m.createSeason("season-1", "Season 1"), m.createSeason("season-2", "Season 2")]
            m.node.pageState.seasons = seasons

            'bs:disable-next-line 1140
            season = getRelativeSeason(seasons[1], -1)

            m.assertEqual(season.Id, "season-1")
        end function

        @it("returns invalid beyond the season range")
        function _()
            seasons = [m.createSeason("season-1", "Season 1")]
            m.node.pageState.seasons = seasons

            'bs:disable-next-line 1140
            season = getRelativeSeason(seasons[0], 1)

            m.assertInvalid(season)
        end function

        @it("builds an adjacent season load request")
        function _()
            season = m.createSeason("season-2", "Season 2")
            m.node.pageState.seasons = [m.node.pageState.season, season]

            'bs:disable-next-line 1140
            request = buildSeasonLoadRequest(season)

            m.assertEqual(request.seasonId, "season-2")
            m.assertTrue(request.keepSeasonNavFocus)
        end function

        @it("optimistically renders season navigation while clearing stale episodes")
        function _()
            seasons = [m.createSeason("season-1", "Season 1"), m.createSeason("season-2", "Season 2"), m.createSeason("season-3", "Season 3")]
            request = m.createRequest()
            request.seasonId = "season-2"
            request.season = seasons[1]
            request.seasons = seasons
            request.keepSeasonNavFocus = true
            m.node.pageState.episodes = [m.createEpisode("episode-1")]
            'bs:disable-next-line 1140
            renderEpisodes(m.node.pageState.episodes)
            LatestRequestLifecycle.Queue(m.node.pageState.detailsLoad, m.createRequest())
            LatestRequestLifecycle.TakeNext(m.node.pageState.detailsLoad)
            m.top.loadRequest = request

            loadingSpinner = m.top.getScene().findNode("loadingSpinner")
            m.assertEqual(m.top.findNode("seasonLabel").text, "Season 2")
            m.assertTrue(m.top.findNode("seasonNav").hasPrevious)
            m.assertTrue(m.top.findNode("seasonNav").hasNext)
            m.assertFalse(m.top.findNode("episodesList").visible)
            m.assertEqual(m.top.findNode("episodesList").content.getChildCount(), 0)
            m.assertEqual(loadingSpinner.showDelay, 2.0)
            m.assertEqual(loadingSpinner.control, "start")
        end function

        @describe("episode rendering and lookup")

        @it("renders horizontal episode content")
        function _()
            episodes = [m.createEpisode("episode-1"), m.createEpisode("episode-2")]
            m.node.pageState.episodes = episodes

            'bs:disable-next-line 1140
            renderEpisodes(episodes)

            list = m.top.findNode("episodesList")
            m.assertTrue(list.visible)
            m.assertEqual(list.content.getChild(0).getChildCount(), 2)
            m.assertEqual(list.content.getChild(0).getChild(0).itemId, "episode-1")
        end function

        @it("renders vertical episode content")
        function _()
            episodes = [m.createEpisode("episode-1"), m.createEpisode("episode-2")]
            m.node.pageState.episodes = episodes
            m.node.pageState.episodeListScroll = "vertical"

            'bs:disable-next-line 1140
            renderEpisodes(episodes)

            grid = m.top.findNode("episodesGrid")
            m.assertTrue(grid.visible)
            m.assertEqual(grid.content.getChildCount(), 2)
            m.assertEqual(grid.content.getChild(0).itemId, "episode-1")
        end function

        @it("hides episode content when the season has no episodes")
        function _()
            'bs:disable-next-line 1140
            renderEpisodes([])

            m.assertFalse(m.top.findNode("episodesList").visible)
            m.assertEqual(m.top.findNode("episodesList").content.getChild(0).getChildCount(), 0)
        end function

        @it("finds a rendered horizontal episode by id")
        function _()
            m.node.pageState.episodes = [m.createEpisode("episode-1"), m.createEpisode("episode-2")]
            'bs:disable-next-line 1140
            renderEpisodes(m.node.pageState.episodes)

            'bs:disable-next-line 1140
            index = getItemContentIndex("episode-2")

            m.assertEqual(index, 1)
        end function

        @it("returns minus one for a missing episode id")
        function _()
            m.node.pageState.episodes = [m.createEpisode("episode-1")]
            'bs:disable-next-line 1140
            renderEpisodes(m.node.pageState.episodes)

            'bs:disable-next-line 1140
            index = getItemContentIndex("missing")

            m.assertEqual(index, -1)
        end function

        @it("focuses the requested episode in the horizontal list")
        function _()
            m.node.pageState.episodes = [m.createEpisode("episode-1"), m.createEpisode("episode-2")]
            'bs:disable-next-line 1140
            renderEpisodes(m.node.pageState.episodes)

            'bs:disable-next-line 1140
            focused = focusInitialEpisode("episode-2")

            m.assertTrue(focused)
            m.assertEqual(m.top.findNode("episodesList").jumpToRowItem, [0, 1])
            m.assertEqual(m.top.findNode("episodesList").rowItemFocused, [0, 1])
        end function

        @it("focuses the requested episode in the vertical grid")
        function _()
            m.node.pageState.episodeListScroll = "vertical"
            m.node.pageState.episodes = [m.createEpisode("episode-1"), m.createEpisode("episode-2")]
            'bs:disable-next-line 1140
            renderEpisodes(m.node.pageState.episodes)

            'bs:disable-next-line 1140
            focused = focusInitialEpisode("episode-2")

            m.assertTrue(focused)
            m.assertEqual(m.top.findNode("episodesGrid").jumpToItem, 1)
            m.assertEqual(m.top.findNode("episodesGrid").itemFocused, 1)
        end function

        @it("focuses the episode after All Episodes season spacers")
        function _()
            m.node.pageState.allEpisodes = true
            m.node.pageState.episodeListScroll = "vertical"
            first = m.createEpisode("episode-1")
            second = m.createEpisode("episode-2")
            second.SeasonId = "season-2"
            second.ParentIndexNumber = 2
            m.node.pageState.episodes = [first, second]
            'bs:disable-next-line 1140
            renderEpisodes(m.node.pageState.episodes)

            'bs:disable-next-line 1140
            focused = focusInitialEpisode("episode-2")

            grid = m.top.findNode("episodesGrid")
            m.assertTrue(focused)
            m.assertEqual(grid.itemFocused, m.node.layout.episodeGridColumns)
            m.assertEqual(grid.content.getChild(grid.itemFocused).itemId, "episode-2")
            m.assertEqual(grid.content.getChild(1).itemType, "LayoutSpacer")
        end function

        @it("falls back to normal episode focus when the requested ID is missing")
        function _()
            m.node.pageState.episodes = [m.createEpisode("episode-1")]
            'bs:disable-next-line 1140
            renderEpisodes(m.node.pageState.episodes)

            'bs:disable-next-line 1140
            focused = focusInitialEpisode("missing")

            m.assertFalse(focused)
            m.assertEqual(m.node.pageState.focusArea, "episodes")
            m.assertTrue(m.top.findNode("episodesList").hasFocus())
        end function

        @it("publishes failure instead of readiness when the requested episode is missing")
        function _()
            collector = CreateObject("roSGNode", "LogService")
            m.node.log = new Logger("TVSeason", collector)
            m.top.initialFocusEpisodeId = "missing"
            m.top.ready = false
            m.top.loadFailed = ""
            requestId = LatestRequestLifecycle.Queue(m.node.pageState.detailsLoad, m.createRequest())
            LatestRequestLifecycle.TakeNext(m.node.pageState.detailsLoad)
            response = {
                action: "tvSeason"
                ok: true
                requestId: requestId
                payload: {
                    season: { Id: "season-1" }
                    seasons: { Items: [] }
                    episodes: { Items: [m.createEpisode("episode-1")] }
                }
            }
            task = CreateObject("roSGNode", "Group")
            task.addField("response", "assocarray", false)
            task.response = response

            'bs:disable-next-line 1140
            handleTVSeasonResponse(task)

            m.assertFalse(m.top.ready)
            m.assertEqual(m.top.loadFailed, "The requested episode is unavailable in this season.")
            entries = collector.callFunc("getSnapshot")
            m.assertEqual(entries.Count(), 1)
            m.assertTrue(Instr(1, entries[0], "Season load failed: The requested episode is unavailable in this season.") > 0)
            m.assertEqual(Instr(1, entries[0], "Viewing season"), 0)
        end function

        @it("publishes a load failure for the current season request")
        function _()
            m.top.loadFailed = ""
            requestId = LatestRequestLifecycle.Queue(m.node.pageState.detailsLoad, m.createRequest())
            LatestRequestLifecycle.TakeNext(m.node.pageState.detailsLoad)
            task = CreateObject("roSGNode", "Group")
            task.addField("response", "assocarray", false)
            task.response = {
                action: "tvSeason"
                ok: false
                requestId: requestId
                errorMessage: "Season unavailable."
            }
            getGlobalAa().seasonFailureMessage = ""
            m.stubCall(AppMessage.Show, m.captureFailureMessage)
            Spinner.Show()
            logCount = m.collector.callFunc("getSnapshot").Count()

            'bs:disable-next-line 1140
            handleTVSeasonResponse(task)

            m.assertEqual(m.top.getScene().findNode("loadingSpinner").control, "stop")
            m.assertEqual(getGlobalAa().seasonFailureMessage, "Season unavailable.")
            m.assertEqual(m.top.loadFailed, "Season unavailable.")
            entries = m.collector.callFunc("getSnapshot")
            m.assertEqual(entries.Count(), logCount + 1)
            m.assertTrue(Instr(1, entries[entries.Count() - 1], "[TVSeason] Activity: Season load failed: Season unavailable.") > 0)
        end function

