            m.assertNotInvalid(m.node.pageState.detailsLoad.active)
            m.assertFalse(m.top.ready)
            m.assertEqual(m.collector.callFunc("getSnapshot").Count(), logCount)
        end function

        @it("renders and ends loading for the current season response")
        function _()
            request = m.createRequest()
            LatestRequestLifecycle.Queue(m.node.pageState.detailsLoad, request)
            LatestRequestLifecycle.TakeNext(m.node.pageState.detailsLoad)
            episode = m.createEpisode("episode-2")
            completedTask = {
                response: {
                    ok: true
                    action: "tvSeason"
                    seasonId: "season-1"
                    requestId: 1
                    payload: { season: request.season, seasons: invalid, episodes: [episode] }
                }
            }
            Spinner.Show()
            logCount = m.collector.callFunc("getSnapshot").Count()

            'bs:disable-next-line 1140
            handleTVSeasonResponse(completedTask)

            m.assertEqual(m.node.pageState.episodes.Count(), 1)
            m.assertEqual(m.node.pageState.episodes[0].Id, "episode-2")
            m.assertTrue(m.top.findNode("episodesList").visible)
            m.assertEqual(m.top.getScene().findNode("loadingSpinner").control, "stop")
            m.assertNotInvalid(m.node.pageState.detailsLoad.active)
            entries = m.collector.callFunc("getSnapshot")
            m.assertEqual(entries.Count(), logCount + 1)
            m.assertTrue(Instr(1, entries[entries.Count() - 1], "[TVSeason] Activity: Viewing season " + Char.DoubleQuote + "Series - Season 1" + Char.DoubleQuote + "; episodes=1") > 0)
        end function

        @it("releases the active request only after terminal completion")
        function _()
            request = m.createRequest()
