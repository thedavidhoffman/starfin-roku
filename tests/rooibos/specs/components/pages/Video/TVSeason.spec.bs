namespace tests

    @SGNode("TVSeason")
    @suite("TVSeason component")
    class TVSeasonTests extends rooibos.BaseTestSuite

        protected override function beforeEach()
            m.node.pageState.request = m.createRequest()
            m.node.pageState.season = m.createSeason("season-1", "Season 1")
            m.node.pageState.seasons = [m.node.pageState.season]
            m.node.pageState.previousSeason = invalid
            m.node.pageState.nextSeason = invalid
            m.node.pageState.episodes = []
            m.node.pageState.episodesLoaded = true
            m.node.pageState.episodeListScroll = "horizontal"
            m.node.pageState.allEpisodes = false
            m.node.pageState.focusArea = "episodes"
            m.node.pageState.detailsLoad = LatestRequestLifecycle.Create()
            m.node.pageState.detailsTaskPool.nextIndex = 0
            m.top.selectedEpisodeDetails = invalid
            m.top.seasonWatchedStateChanged = invalid
            m.top.closeRequested = false
            scene = m.node.top.getScene()
            if scene.findNode("loadingSpinner") = invalid then
                loadingSpinnerNode = CreateObject("roSGNode", "Spinner")
                loadingSpinnerNode.id = "loadingSpinner"
                scene.appendChild(loadingSpinnerNode)
            end if
            scene.findNode("loadingSpinner").control = "stop"
        end function
        @describe("declarative component contract")

        @it("declares the logoBanner node")
        function _()
            m.assertNotInvalid(m.top.findNode("logoBanner"))
        end function

        @it("declares the seasonLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("seasonLabel"))
        end function

        @it("declares the seasonNav node")
        function _()
            m.assertNotInvalid(m.top.findNode("seasonNav"))
        end function

        @it("declares the episodesList node")
        function _()
            m.assertNotInvalid(m.top.findNode("episodesList"))
        end function

        @it("declares the episodesGrid node")
        function _()
            m.assertNotInvalid(m.top.findNode("episodesGrid"))
        end function

        @it("declares the leftChevron node")
        function _()
            m.assertNotInvalid(m.top.findNode("leftChevron"))
        end function

        @it("declares the rightChevron node")
        function _()
            m.assertNotInvalid(m.top.findNode("rightChevron"))
        end function

        @it("declares the tvSeasonTask node")
        function _()
            m.assertNotInvalid(m.top.findNode("tvSeasonTask"))
        end function

        @it("declares the alternate tvSeasonTask node")
        function _()
            m.assertNotInvalid(m.top.findNode("tvSeasonTaskAlternate"))
        end function

        @describe("season rendering and navigation")

        @it("renders series and season identity")
        function _()
            'bs:disable-next-line 1140
            renderSeason(m.node.pageState.season)

            m.assertEqual(m.top.findNode("logoBanner").title, "Series")
            m.assertEqual(m.top.findNode("seasonLabel").text, "Season 1")
        end function

        @it("renders previous and next season availability")
        function _()
            m.node.pageState.previousSeason = m.createSeason("season-0", "Season 0")
            m.node.pageState.nextSeason = m.createSeason("season-2", "Season 2")

            'bs:disable-next-line 1140
            renderSeason(m.node.pageState.season)

            nav = m.top.findNode("seasonNav")
            m.assertTrue(nav.hasPrevious)
            m.assertTrue(nav.hasNext)
        end function

        @it("hides season navigation in All Episodes mode")
        function _()
            m.node.pageState.allEpisodes = true
            m.node.pageState.previousSeason = m.createSeason("season-0", "Season 0")
            m.node.pageState.nextSeason = m.createSeason("season-2", "Season 2")

            'bs:disable-next-line 1140
            renderSeason(m.node.pageState.season)

            nav = m.top.findNode("seasonNav")
            m.assertFalse(nav.hasPrevious)
            m.assertFalse(nav.hasNext)
        end function

        @it("finds the previous relative season")
        function _()
            seasons = [m.createSeason("season-1", "Season 1"), m.createSeason("season-2", "Season 2")]
            m.node.pageState.seasons = seasons

            'bs:disable-next-line 1140
            season = getRelativeSeason(seasons[1], -1)

            m.assertEqual(season.Id, "season-1")
        end function

        @it("returns invalid beyond the season range")
        function _()
            seasons = [m.createSeason("season-1", "Season 1")]
            m.node.pageState.seasons = seasons

            'bs:disable-next-line 1140
            season = getRelativeSeason(seasons[0], 1)

            m.assertInvalid(season)
        end function

        @it("builds an adjacent season load request")
        function _()
            season = m.createSeason("season-2", "Season 2")
            m.node.pageState.seasons = [m.node.pageState.season, season]

            'bs:disable-next-line 1140
            request = buildSeasonLoadRequest(season)

            m.assertEqual(request.seasonId, "season-2")
            m.assertTrue(request.keepSeasonNavFocus)
        end function

        @it("optimistically renders season navigation while clearing stale episodes")
        function _()
            seasons = [m.createSeason("season-1", "Season 1"), m.createSeason("season-2", "Season 2"), m.createSeason("season-3", "Season 3")]
            request = m.createRequest()
            request.seasonId = "season-2"
            request.season = seasons[1]
            request.seasons = seasons
            request.keepSeasonNavFocus = true
            m.node.pageState.episodes = [m.createEpisode("episode-1")]
            'bs:disable-next-line 1140
            renderEpisodes(m.node.pageState.episodes)
            LatestRequestLifecycle.Queue(m.node.pageState.detailsLoad, m.createRequest())
            LatestRequestLifecycle.TakeNext(m.node.pageState.detailsLoad)
            m.top.loadRequest = request

            loadingSpinner = m.top.getScene().findNode("loadingSpinner")
            m.assertEqual(m.top.findNode("seasonLabel").text, "Season 2")
            m.assertTrue(m.top.findNode("seasonNav").hasPrevious)
            m.assertTrue(m.top.findNode("seasonNav").hasNext)
            m.assertFalse(m.top.findNode("episodesList").visible)
            m.assertEqual(m.top.findNode("episodesList").content.getChildCount(), 0)
            m.assertEqual(loadingSpinner.showDelay, 2.0)
            m.assertEqual(loadingSpinner.control, "start")
        end function

        @describe("episode rendering and lookup")

        @it("renders horizontal episode content")
        function _()
            episodes = [m.createEpisode("episode-1"), m.createEpisode("episode-2")]
            m.node.pageState.episodes = episodes

            'bs:disable-next-line 1140
            renderEpisodes(episodes)

            list = m.top.findNode("episodesList")
            m.assertTrue(list.visible)
            m.assertEqual(list.content.getChild(0).getChildCount(), 3)
        end function

        @it("renders vertical episode content")
        function _()
            episodes = [m.createEpisode("episode-1"), m.createEpisode("episode-2")]
            m.node.pageState.episodes = episodes
            m.node.pageState.episodeListScroll = "vertical"

            'bs:disable-next-line 1140
            renderEpisodes(episodes)

            grid = m.top.findNode("episodesGrid")
            m.assertTrue(grid.visible)
            m.assertEqual(grid.content.getChildCount(), 3)
        end function

        @it("renders the season summary when episodes are empty")
        function _()
            'bs:disable-next-line 1140
            renderEpisodes([])

            m.assertTrue(m.top.findNode("episodesList").visible)
            m.assertEqual(m.top.findNode("episodesList").content.getChild(0).getChildCount(), 1)
        end function

        @it("finds a rendered horizontal episode by id")
        function _()
            m.node.pageState.episodes = [m.createEpisode("episode-1"), m.createEpisode("episode-2")]
            'bs:disable-next-line 1140
            renderEpisodes(m.node.pageState.episodes)

            'bs:disable-next-line 1140
            index = getEpisodeContentIndex("episode-2")

            m.assertEqual(index, 2)
        end function

        @it("returns minus one for a missing episode id")
        function _()
            m.node.pageState.episodes = [m.createEpisode("episode-1")]
            'bs:disable-next-line 1140
            renderEpisodes(m.node.pageState.episodes)

            'bs:disable-next-line 1140
            index = getEpisodeContentIndex("missing")

            m.assertEqual(index, -1)
        end function

        @it("shows right overflow at the beginning")
        function _()
            m.node.pageState.episodes = m.createEpisodes(5)
            'bs:disable-next-line 1140
            renderEpisodes(m.node.pageState.episodes)
            m.top.findNode("episodesList").rowItemFocused = [0, 0]

            'bs:disable-next-line 1140
            overflow = getEpisodeOverflowState()

            m.assertFalse(overflow.left)
            m.assertTrue(overflow.right)
        end function

        @it("shows left overflow at the end")
        function _()
            m.node.pageState.episodes = m.createEpisodes(5)
            'bs:disable-next-line 1140
            renderEpisodes(m.node.pageState.episodes)
            m.top.findNode("episodesList").rowItemFocused = [0, 5]

            'bs:disable-next-line 1140
            overflow = getEpisodeOverflowState()

            m.assertTrue(overflow.left)
            m.assertFalse(overflow.right)
        end function

        @describe("playback and watched state")

        @it("builds a series-scoped playback queue")
        function _()
            episodes = [m.createEpisode("episode-1"), m.createEpisode("episode-2")]

            'bs:disable-next-line 1140
            queue = buildPlaybackQueue(episodes)

            m.assertEqual(queue.Count(), 2)
            m.assertEqual(queue[0].itemId, "episode-1")
            m.assertEqual(queue[0].season.Id, "season-1")
        end function

        @it("builds episode playback selection with queue position")
        function _()
            m.node.pageState.episodes = [m.createEpisode("episode-1"), m.createEpisode("episode-2")]
            'bs:disable-next-line 1140
            renderEpisodes(m.node.pageState.episodes)
            node = m.top.findNode("episodesList").content.getChild(0).getChild(2)

            'bs:disable-next-line 1140
            selection = buildEpisodePlaySelection(node)

            m.assertEqual(selection.itemId, "episode-2")
            m.assertEqual(selection.playbackQueueIndex, 1)
            m.assertEqual(selection.playbackQueueScope, "series")
        end function

        @it("marks an episode watched and decrements season unplayed count")
        function _()
            episode = m.createEpisode("episode-1")
            m.node.pageState.episodes = [episode]
            m.node.pageState.season.UserData.UnplayedItemCount = 1

            'bs:disable-next-line 1140
            season = updateEpisodeWatchedState("episode-1", true)

            m.assertTrue(episode.UserData.Played)
            m.assertEqual(season.UserData.UnplayedItemCount, 0)
        end function

        @it("marks a whole season watched")
        function _()
            m.node.pageState.episodes = [m.createEpisode("episode-1"), m.createEpisode("episode-2")]

            'bs:disable-next-line 1140
            season = updateEpisodeWatchedState("season-1", true)

            m.assertTrue(season.UserData.Played)
            m.assertTrue(m.node.pageState.episodes[0].UserData.Played)
            m.assertTrue(m.node.pageState.episodes[1].UserData.Played)
        end function

        @it("stores unfinished episode progress")
        function _()
            episode = m.createEpisode("episode-1")
            episode.RunTimeTicks = 1000

            'bs:disable-next-line 1140
            updateItemPlaybackProgress(episode, { isFinished: false, positionTicks: 250, durationTicks: 1000 })

            m.assertEqual(episode.UserData.PlaybackPositionTicks.ToStr(), "250")
            m.assertEqual(episode.UserData.PlayedPercentage, 25.0)
        end function

        @it("publishes season watched state")
        function _()
            m.node.pageState.season.UserData.UnplayedItemCount = 0

            'bs:disable-next-line 1140
            notifySeasonWatchedStateChanged(m.node.pageState.season)

            m.assertEqual(m.top.seasonWatchedStateChanged.seasonId, "season-1")
            m.assertTrue(m.top.seasonWatchedStateChanged.isWatched)
        end function

        @describe("focus and lifecycle")

        @it("coalesces rapid season loads and starts the newest request after a stale response")
        function _()
            firstRequest = m.createRequest()
            secondRequest = m.createRequest()
            secondRequest.seasonId = "season-2"
            thirdRequest = m.createRequest()
            thirdRequest.seasonId = "season-3"

            LatestRequestLifecycle.Queue(m.node.pageState.detailsLoad, firstRequest)
            LatestRequestLifecycle.TakeNext(m.node.pageState.detailsLoad)
            LatestRequestLifecycle.Queue(m.node.pageState.detailsLoad, secondRequest)
            LatestRequestLifecycle.Queue(m.node.pageState.detailsLoad, thirdRequest)
            m.node.pageState.detailsTaskPool.nextIndex = 1
            completedTask = {
                response: { ok: true, action: "tvSeasonComplete", seasonId: "season-1", requestId: 1 }
            }
            Spinner.Show()

            'bs:disable-next-line 1140
            handleTVSeasonResponse(completedTask)

            m.assertEqual(m.node.pageState.detailsLoad.active.request.seasonId, "season-3")
            m.assertInvalid(m.node.pageState.detailsLoad.pending)
            m.assertEqual(m.node.tvSeasonTaskAlternate.request.seasonId, "season-3")
            m.assertEqual(m.node.tvSeasonTaskAlternate.control, "run")
            m.assertEqual(m.top.getScene().findNode("loadingSpinner").control, "start")
        end function

        @it("preserves the optimistic season label when series metadata arrives first")
        function _()
            m.node.pageState.request.seriesMetadataPending = true
            m.node.pageState.episodesLoaded = false
            m.top.findNode("seasonLabel").text = "Season 1"
            seriesTask = {
                response: {
                    ok: true
                    action: "tvSeasonSeries"
                    seasonId: "season-1"
                    requestId: 1
                    payload: { Id: "series-1", Name: "Series" }
                }
            }
            AsyncLifecycle.Begin(m.node.pageState.lifecycle, "season-1")

            'bs:disable-next-line 1140
            handleTVSeasonResponse(seriesTask)

            m.assertEqual(m.top.findNode("seasonLabel").text, "Season 1")
        end function

        @it("renders and ends loading for the current season response")
        function _()
            request = m.createRequest()
            LatestRequestLifecycle.Queue(m.node.pageState.detailsLoad, request)
            LatestRequestLifecycle.TakeNext(m.node.pageState.detailsLoad)
            episode = m.createEpisode("episode-2")
            completedTask = {
                response: {
                    ok: true
                    action: "tvSeason"
                    seasonId: "season-1"
                    requestId: 1
                    payload: { season: request.season, seasons: invalid, episodes: [episode] }
                }
            }
            Spinner.Show()

            'bs:disable-next-line 1140
            handleTVSeasonResponse(completedTask)

            m.assertEqual(m.node.pageState.episodes.Count(), 1)
            m.assertEqual(m.node.pageState.episodes[0].Id, "episode-2")
            m.assertTrue(m.top.findNode("episodesList").visible)
            m.assertEqual(m.top.getScene().findNode("loadingSpinner").control, "stop")
            m.assertNotInvalid(m.node.pageState.detailsLoad.active)
        end function

        @it("releases the active request only after terminal completion")
        function _()
            request = m.createRequest()
            LatestRequestLifecycle.Queue(m.node.pageState.detailsLoad, request)
            LatestRequestLifecycle.TakeNext(m.node.pageState.detailsLoad)
            completedTask = {
                response: { ok: true, action: "tvSeasonComplete", seasonId: "season-1", requestId: 1 }
            }

            'bs:disable-next-line 1140
            handleTVSeasonResponse(completedTask)

            m.assertInvalid(m.node.pageState.detailsLoad.active)
        end function

        @it("does not let an unrelated response release the active season request")
        function _()
            activeRequest = m.createRequest()
            pendingRequest = m.createRequest()
            pendingRequest.seasonId = "season-2"
            LatestRequestLifecycle.Queue(m.node.pageState.detailsLoad, activeRequest)
            LatestRequestLifecycle.TakeNext(m.node.pageState.detailsLoad)
            LatestRequestLifecycle.Queue(m.node.pageState.detailsLoad, pendingRequest)
            unrelatedTask = {
                response: { ok: true, action: "tvSeason", seasonId: "season-9", requestId: 99, payload: {} }
            }

            'bs:disable-next-line 1140
            handleTVSeasonResponse(unrelatedTask)

            m.assertEqual(m.node.pageState.detailsLoad.active.request.seasonId, "season-1")
            m.assertEqual(m.node.pageState.detailsLoad.pending.request.seasonId, "season-2")
        end function

        @it("focuses episode content when available")
        function _()
            m.node.pageState.episodes = [m.createEpisode("episode-1")]
            'bs:disable-next-line 1140
            renderEpisodes(m.node.pageState.episodes)

            m.top.callFunc("activate")

            m.assertTrue(m.top.findNode("episodesList").hasFocus())
        end function

        @it("deactivation stops both season tasks")
        function _()
            m.top.callFunc("deactivate")

            m.assertEqual(m.top.findNode("tvSeasonTask").control, "stop")
            m.assertEqual(m.top.findNode("tvSeasonTaskAlternate").control, "stop")
        end function

        @it("Back requests close")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("back", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.closeRequested)
        end function

        @it("ignores released keys")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("back", false)

            m.assertFalse(handled)
        end function

        function createRequest() as object
            series = { Id: "series-1", Name: "Series", Type: "Series", ImageTags: {} }
            return { server: "http://server", token: "token", userId: "user", seriesId: "series-1", seasonId: "season-1", series: series, season: m.createSeason("season-1", "Season 1"), seasons: [], nextSeason: invalid }
        end function

        function createSeason(id as string, name as string) as object
            return { Id: id, Name: name, Type: "Season", SeriesId: "series-1", UserData: { Played: false, UnplayedItemCount: 1 }, ImageTags: {}, BackdropImageTags: [] }
        end function

        function createEpisode(id as string) as object
            return { Id: id, Name: id, Type: "Episode", SeriesId: "series-1", SeriesName: "Series", SeasonId: "season-1", SeasonName: "Season 1", ParentIndexNumber: 1, IndexNumber: 1, Overview: "Overview", UserData: { Played: false, PlaybackPositionTicks: 0 }, ImageTags: {}, BackdropImageTags: [] }
        end function

        function createEpisodes(count as integer) as object
            episodes = []
            for i = 1 to count
                episodes.Push(m.createEpisode("episode-" + i.ToStr()))
            end for
            return episodes
        end function
    end class

end namespace
