            m.assertTrue(handled)
            m.assertTrue(m.top.hasFocus())
            m.assertFalse(m.node.seasonNav.isInFocusChain())
            m.assertFalse(m.node.episodesList.isInFocusChain())
            m.assertFalse(m.node.episodesGrid.isInFocusChain())
        end function

        @it("allows Back after releasing retained list focus while loading")
        function _()
