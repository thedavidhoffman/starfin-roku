        @it("preserves explicitly selected season navigation during loading")
        function _()
            m.preparePendingSeasonFocus()
            'bs:disable-next-line 1140
            focusSeasonNav()

            'bs:disable-next-line 1140
            handleTVSeasonPrimaryResponse(m.pendingSeasonResponse)

            m.assertTrue(m.node.seasonNav.isInFocusChain())
            m.assertEqual(m.node.pageState.focusArea, "seasonNav")
