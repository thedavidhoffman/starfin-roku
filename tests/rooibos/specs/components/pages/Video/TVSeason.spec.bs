            m.assertInvalid(m.node.pageState.detailsLoad.active)
        end function

        @it("does not let an unrelated response release the active season request")
        function _()
            activeRequest = m.createRequest()
            pendingRequest = m.createRequest()
            pendingRequest.seasonId = "season-2"
            LatestRequestLifecycle.Queue(m.node.pageState.detailsLoad, activeRequest)
            LatestRequestLifecycle.TakeNext(m.node.pageState.detailsLoad)
            LatestRequestLifecycle.Queue(m.node.pageState.detailsLoad, pendingRequest)
            unrelatedTask = {
                response: { ok: true, action: "tvSeason", seasonId: "season-9", requestId: 99, payload: {} }
            }

            'bs:disable-next-line 1140
            handleTVSeasonResponse(unrelatedTask)

            m.assertEqual(m.node.pageState.detailsLoad.active.request.seasonId, "season-1")
            m.assertEqual(m.node.pageState.detailsLoad.pending.request.seasonId, "season-2")
        end function

