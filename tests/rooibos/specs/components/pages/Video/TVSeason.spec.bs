        function preparePendingSeasonFocus()
            m.top.initialFocusEpisodeId = ""
            m.node.pageState.episodesLoaded = false
            m.node.pageState.seasons = [m.node.pageState.season, m.createSeason("season-2", "Season 2")]
            'bs:disable-next-line 1140
            clearEpisodes()
            'bs:disable-next-line 1140
            updateAdjacentSeasons()
            'bs:disable-next-line 1140
            renderSeason(m.node.pageState.season)
            request = m.createRequest()
            LatestRequestLifecycle.Queue(m.node.pageState.detailsLoad, request)
            entry = LatestRequestLifecycle.TakeNext(m.node.pageState.detailsLoad)
            m.pendingSeasonResponse = { ok: true, action: "tvSeason", seasonId: "season-1", requestId: entry.request.requestId, payload: { season: m.node.pageState.season, episodes: [m.createEpisode("episode-1")] } }
        end function

