        @describe("focus and lifecycle")

        @it("coalesces rapid season loads and starts the newest request after a stale response")
        function _()
            firstRequest = m.createRequest()
            secondRequest = m.createRequest()
            secondRequest.seasonId = "season-2"
            thirdRequest = m.createRequest()
            thirdRequest.seasonId = "season-3"

            LatestRequestLifecycle.Queue(m.node.pageState.detailsLoad, firstRequest)
            LatestRequestLifecycle.TakeNext(m.node.pageState.detailsLoad)
            LatestRequestLifecycle.Queue(m.node.pageState.detailsLoad, secondRequest)
            LatestRequestLifecycle.Queue(m.node.pageState.detailsLoad, thirdRequest)
            m.node.pageState.detailsTaskPool.nextIndex = 1
            completedTask = {
                response: { ok: true, action: "tvSeasonComplete", seasonId: "season-1", requestId: 1 }
            }
            Spinner.Show()

            'bs:disable-next-line 1140
            handleTVSeasonResponse(completedTask)

            m.assertEqual(m.node.pageState.detailsLoad.active.request.seasonId, "season-3")
            m.assertInvalid(m.node.pageState.detailsLoad.pending)
            m.assertEqual(m.node.tvSeasonTaskAlternate.request.seasonId, "season-3")
            m.assertEqual(m.node.tvSeasonTaskAlternate.control, "run")
            m.assertEqual(m.top.getScene().findNode("loadingSpinner").control, "start")
        end function

        @it("preserves the optimistic season label when series metadata arrives first")
        function _()
            m.node.pageState.request.seriesMetadataPending = true
            m.node.pageState.episodesLoaded = false
            m.top.findNode("seasonLabel").text = "Season 1"
            series = { Id: "series-2", Name: "Returned Series" }
            seriesTask = {
                response: {
                    ok: true
                    action: "tvSeasonSeries"
                    seasonId: "season-1"
                    requestId: 1
                    payload: series
                }
            }
            AsyncLifecycle.Begin(m.node.pageState.lifecycle, "season-1")

            'bs:disable-next-line 1140
            handleTVSeasonResponse(seriesTask)

            m.assertEqual(m.top.findNode("seasonLabel").text, "Season 1")
            m.assertFalse(m.node.pageState.request.seriesMetadataPending)
            m.assertEqual(m.node.pageState.request.series.Id, "series-2")
            m.assertEqual(m.node.pageState.request.series.Name, "Returned Series")
        end function

        @it("dispatches seasons responses to adjacent-season handling")
        function _()
            request = m.createRequest()
            m.node.pageState.request = request
            m.node.pageState.season = request.season
            seasonsTask = {
                response: {
                    ok: true
                    action: "tvSeasonSeasons"
                    seasonId: "season-1"
                    requestId: 1
                    payload: { Items: [request.season, m.createSeason("season-2", "Season 2")] }
                }
            }
            AsyncLifecycle.Begin(m.node.pageState.lifecycle, "season-1")

            'bs:disable-next-line 1140
            handleTVSeasonResponse(seasonsTask)

            m.assertEqual(m.node.pageState.seasons.Count(), 2)
            m.assertEqual(m.node.pageState.nextSeason.Id, "season-2")
        end function

        @it("rejects unknown response actions")
        function _()
            request = m.createRequest()
            LatestRequestLifecycle.Queue(m.node.pageState.detailsLoad, request)
            LatestRequestLifecycle.TakeNext(m.node.pageState.detailsLoad)
            unknownTask = {
                response: { ok: true, action: "tvSeasonUnknown", seasonId: "season-1", requestId: 1, payload: {} }
            }
            logCount = m.collector.callFunc("getSnapshot").Count()

            'bs:disable-next-line 1140
