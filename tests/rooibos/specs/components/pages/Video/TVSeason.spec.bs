        @it("ignores released keys")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("back", false)

            m.assertFalse(handled)
        end function

        function createRequest() as object
            series = { Id: "series-1", Name: "Series", Type: "Series", ImageTags: {} }
            return { server: "http://server", token: "token", userId: "user", seriesId: "series-1", seasonId: "season-1", series: series, season: m.createSeason("season-1", "Season 1"), seasons: [], nextSeason: invalid }
        end function

        function createSeason(id as string, name as string) as object
            return { Id: id, Name: name, Type: "Season", SeriesId: "series-1", UserData: { Played: false, UnplayedItemCount: 1 }, ImageTags: {}, BackdropImageTags: [] }
        end function

        function createEpisode(id as string) as object
            return { Id: id, Name: id, Type: "Episode", SeriesId: "series-1", SeriesName: "Series", SeasonId: "season-1", SeasonName: "Season 1", ParentIndexNumber: 1, IndexNumber: 1, Overview: "Overview", UserData: { Played: false, PlaybackPositionTicks: 0 }, ImageTags: {}, BackdropImageTags: [] }
        end function

        function createEpisodes(count as integer) as object
            episodes = []
            for i = 1 to count
                episodes.Push(m.createEpisode("episode-" + i.ToStr()))
            end for
            return episodes
        end function
        private sub captureFailureMessage(message as string)
            getGlobalAa().seasonFailureMessage = message
        end sub

        @describe("retained child focus while loading")

        @it("releases a hidden horizontal list on a production season node")
        function _()
            m.assertProductionLoadingFocus("episodesList")
        end function

        @it("releases a hidden vertical list on a production season node")
        function _()
            m.assertProductionLoadingFocus("episodesGrid")
        end function

        function assertProductionLoadingFocus(listId as string)
            page = CreateObject("roSGNode", "TVSeason")
            scene = m.top.getScene()
            scene.appendChild(page)
            list = page.findNode(listId)
            list.visible = true
            list.setFocus(true)
            hadListFocus = list.hasFocus()
            list.visible = false

            page.callFunc("activate")

            pageFocused = page.hasFocus()
            listFocused = list.isInFocusChain()
            page.callFunc("deactivate")
            scene.removeChild(page)

            m.assertTrue(hadListFocus, "The production list must own focus before loading")
            m.assertTrue(pageFocused, "The production page must own focus while loading")
            m.assertFalse(listFocused, "The hidden list must leave the focus chain")
        end function

        @it("moves Down from season navigation to page focus while loading")
        function _()
            m.preparePendingSeasonFocus()
            'bs:disable-next-line 1140
            focusSeasonNav()

            'bs:disable-next-line 1140
