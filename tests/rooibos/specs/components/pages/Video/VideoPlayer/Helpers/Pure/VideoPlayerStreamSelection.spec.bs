namespace tests

    @suite("VideoPlayer stream selection")
    class VideoPlayerStreamSelectionTests extends rooibos.BaseTestSuite

        @describe("stream filtering and selection")

        @it("filters mixed streams case-insensitively")
        function _()
            item = { MediaStreams: [{ Index: 1, Type: "Audio" }, invalid, { Index: 2, Type: "SUBTITLE" }, { Index: 3, Type: "Video" }] }
            audio = VideoPlayerStreamSelection_GetAudioStreams(item)
            subtitles = VideoPlayerStreamSelection_GetSubtitleStreams(item)
            m.assertEqual(audio.Count(), 1)
            m.assertEqual(audio[0].Index, 1)
            m.assertEqual(subtitles.Count(), 1)
            m.assertEqual(subtitles[0].Index, 2)
        end function

        @it("handles missing media streams (case 1)")
        function _()
            m.assertEqual(VideoPlayerStreamSelection_GetAudioStreams(invalid), [])
        end function

        @it("handles missing media streams (case 2)")
        function _()
            m.assertEqual(VideoPlayerStreamSelection_GetSubtitleStreams({}), [])
        end function

    end class

end namespace
