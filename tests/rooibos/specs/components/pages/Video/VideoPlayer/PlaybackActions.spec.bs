        protected function startSegmentRequest() as integer
            m.node.mediaSegments.resolved = false
            m.node.mediaSegmentsTask = {}
            'bs:disable-next-line 1140
            loadMediaSegments({ payload: { MediaSources: [{ HasSegments: true }] } })
            return m.node.mediaSegmentsTask.request.requestId
        end function

        @describe("segment request ownership")

        @it("ignores a successful response after reset")
        function _()
            m.prepareEpisodeFallback()
            requestId = m.startSegmentRequest()
            'bs:disable-next-line 1140
            resetMediaSegments()

            m.node.mediaSegmentsTask.response = { ok: true, requestId: requestId, itemId: "episode-1", segments: [] }
            'bs:disable-next-line 1140
            onMediaSegmentsResponse()

            m.assertFalse(m.node.mediaSegments.resolved)
            m.assertFalse(m.node.mediaSegments.pending)
        end function

        @it("ignores a successful response after cancellation while preserving cached state")
        function _()
            m.prepareEpisodeFallback()
            requestId = m.startSegmentRequest()
            m.node.mediaSegments.fallbackDismissedItemId = "episode-1"
            'bs:disable-next-line 1140
            cancelMediaSegmentsLoad()

            m.node.mediaSegmentsTask.response = { ok: true, requestId: requestId, itemId: "episode-1", segments: [] }
            'bs:disable-next-line 1140
            onMediaSegmentsResponse()

            m.assertFalse(m.node.mediaSegments.resolved)
            m.assertEqual(m.node.mediaSegments.fallbackDismissedItemId, "episode-1")
        end function

        @it("ignores an old same-item response and accepts the replacement request")
        function _()
            m.prepareEpisodeFallback()
            oldId = m.startSegmentRequest()
            'bs:disable-next-line 1140
            resetMediaSegments()
            currentId = m.startSegmentRequest()

            m.node.mediaSegmentsTask.response = { ok: true, requestId: oldId, itemId: "episode-1", segments: [] }
            'bs:disable-next-line 1140
            onMediaSegmentsResponse()

            m.assertFalse(m.node.mediaSegments.resolved)
            m.assertTrue(m.node.mediaSegments.pending)
            m.assertTrue(currentId > oldId)

            m.node.mediaSegmentsTask.response = { ok: true, requestId: currentId, itemId: "episode-1", segments: [] }
            'bs:disable-next-line 1140
            onMediaSegmentsResponse()

            m.assertTrue(m.node.mediaSegments.resolved)
            m.assertFalse(m.node.mediaSegments.pending)
        end function

        @it("ignores duplicate responses after resolution")
        function _()
            m.prepareEpisodeFallback()
            requestId = m.startSegmentRequest()
            m.node.mediaSegmentsTask.response = { ok: true, requestId: requestId, itemId: "episode-1", segments: [] }
            'bs:disable-next-line 1140
            onMediaSegmentsResponse()

            m.node.mediaSegmentsTask.response = { ok: true, requestId: requestId, itemId: "episode-1", segments: [{ Type: "Outro", StartTicks: 5700000000&, EndTicks: 6000000000& }] }
            'bs:disable-next-line 1140
            onMediaSegmentsResponse()

            m.assertEqual(m.node.mediaSegments.outros.Count(), 0)
        end function

        @it("returns official outro metadata without modifying the stored range")
        function _()
            m.prepareEpisodeFallback()
            m.node.mediaSegments.outros = [{ startSeconds: 570.0, endSeconds: 600.0 }]

            'bs:disable-next-line 1140
            activeOutro = getActiveOfficialOutroSegment(575)

            m.assertEqual(activeOutro, { startSeconds: 570.0, endSeconds: 600.0, isFallback: false })
            m.assertEqual(m.node.mediaSegments.outros[0], { startSeconds: 570.0, endSeconds: 600.0 })
            activeOutro.endSeconds = 590
            m.assertTrue(m.node.mediaSegments.outros[0].endSeconds = 600)
        end function

        protected function capturePromptLogs()
            m.promptLogCollector = CreateObject("roSGNode", "LogService")
            m.node.log = new Logger("VideoPlayer", m.promptLogCollector)
        end function

        protected function promptLogs() as object
            entries = []
            for each entry in m.promptLogCollector.callFunc("getSnapshot")
                if Instr(1, entry, "Playback action ") > 0 then entries.Push(entry)
            end for
            return entries
        end function

        @describe("prompt logging")

        @it("logs intro display")
        function _()
            m.prepareEpisodeFallback()
            m.node.mediaSegments.intros = [{ startSeconds: 530.0, endSeconds: 560.0 }]
