namespace tests

    @SGNode("VideoPlayer")
    @suite("VideoPlayer playback actions")
    class VideoPlayerPlaybackActionsTests extends rooibos.BaseTestSuite

        protected override function beforeEach()
            m.node.mediaSegmentsTask = m.top.findNode("mediaSegmentsTask")
            scene = m.node.top.getScene()
            if scene.findNode("loadingSpinner") = invalid then
                spinnerNode = CreateObject("roSGNode", "Spinner")
                spinnerNode.id = "loadingSpinner"
                scene.appendChild(spinnerNode)
            end if
            m.top.playRequest = {
                server: "http://server"
                token: "token"
                userId: "user"
                itemId: "music-video-1"
                item: { Id: "music-video-1", Type: "MusicVideo", Name: "First" }
                subtitleBurnInMode: "automatic"
            }
            activeItem = { Id: "music-video-1", Type: "MusicVideo", Name: "First" }
            m.node.activePlayback = {
                request: m.top.playRequest
                session: {
                    server: "http://server"
                    token: "token"
                    userId: "user"
                    itemId: "music-video-1"
                }
                playSessionId: "session"
                mediaSourceId: ""
                liveStreamId: ""
                playMethod: "DirectPlay"
                canSeek: true
                context: { item: activeItem, series: invalid, season: invalid }
                queue: {
                    items: [
                        { itemId: "music-video-1", item: activeItem, startPositionTicks: 0 }
                        { itemId: "music-video-2", item: { Id: "music-video-2", Type: "MusicVideo", Name: "Second" }, startPositionTicks: 0 }
                    ]
                    index: 0
                    mode: "random"
                    scope: "random"
                }
            }
            m.node.playback.phase = "active"
            m.node.playbackAction.pendingCompletion = invalid
            m.node.playbackAction.itemId = "music-video-1"
            m.node.playbackAction.mode = PlaybackAction.Mode.None
            m.node.playbackAction.randomSkipDismissed = false
            m.node.playbackAction.musicVideoMetadataDismissed = false
        end function

        @describe("music-video presentation and queue actions")

        @it("renders the random queue action as Skip")
        function _()
            'bs:disable-next-line 1140
            showPlaybackActionButton(PlaybackAction.Mode.RandomSkip, "Skip")

            m.assertTrue(m.node.playbackActionButton.visible)
            m.assertEqual(m.node.playbackActionButton.text, "Skip")
            m.assertEqual(m.node.playbackAction.mode, PlaybackAction.Mode.RandomSkip)
        end function

        @it("shows music-video metadata at the bottom left before five seconds")
        function _()
            'bs:disable-next-line 1140
            updateMusicVideoIntroMetadata(m.node.activePlayback.context.item, 4.99)

            m.assertTrue(m.node.musicVideoIntroMetadata.visible)
            m.assertEqual(m.node.musicVideoTitleLabel.text, "First")
            m.assertEqual(Number.ToInteger(m.node.musicVideoTitleLabel.translation[0], -1), 103)
            titleBottom = Number.ToInteger(m.node.musicVideoTitleLabel.translation[1], 0) + Number.ToInteger(m.node.musicVideoTitleLabel.height, 0)
            buttonBottom = Number.ToInteger(m.node.playbackActionButton.translation[1], 0) + Number.ToInteger(m.node.playbackActionButton.buttonHeight, 0)
            m.assertEqual(titleBottom, buttonBottom)
        end function

        @it("shows artists above the introductory music-video title")
        function _()
            item = { Id: "music-video-1", Type: "MusicVideo", Name: "First", Artists: ["Artist One", "Artist Two"] }

            'bs:disable-next-line 1140
            updateMusicVideoIntroMetadata(item, 1)

            m.assertEqual(m.node.musicVideoArtistLabel.text, "Artist One, Artist Two")
            m.assertEqual(m.node.musicVideoTitleLabel.text, "First")
            m.assertTrue(Number.ToInteger(m.node.musicVideoArtistLabel.translation[1], 0) < Number.ToInteger(m.node.musicVideoTitleLabel.translation[1], 0))
        end function

        @it("omits the introductory artist line when artists are absent")
        function _()
            'bs:disable-next-line 1140
            updateMusicVideoIntroMetadata(m.node.activePlayback.context.item, 1)

            m.assertEqual(m.node.musicVideoArtistLabel.text, "")
            m.assertEqual(m.node.musicVideoTitleLabel.text, "First")
        end function

        @it("hides introductory music-video metadata at five seconds")
        function _()
            'bs:disable-next-line 1140
            updateMusicVideoIntroMetadata(m.node.activePlayback.context.item, 1)

            'bs:disable-next-line 1140
            updateMusicVideoIntroMetadata(m.node.activePlayback.context.item, 5)

            m.assertFalse(m.node.musicVideoIntroMetadata.visible)
        end function

        @it("shows the introductory presentation through the canonical update while playing")
        function _()
            m.node.videoPlayer = { state: "playing" }
            m.node.playback.isSeeking = false
            m.node.overlay.area = "none"

            'bs:disable-next-line 1140
            updatePlaybackActionButton(1)

            m.assertTrue(m.node.musicVideoIntroMetadata.visible)
            m.assertTrue(m.node.playbackActionButton.visible)
            m.assertEqual(m.node.playbackAction.mode, PlaybackAction.Mode.RandomSkip)
        end function

        @it("temporarily suppresses and restores the introductory presentation around controls")
        function _()
            m.node.videoPlayer = { state: "playing" }
            m.node.playback.isSeeking = false
            m.node.overlay.area = "controls"

            'bs:disable-next-line 1140
            updatePlaybackActionButton(1)

            m.assertFalse(m.node.musicVideoIntroMetadata.visible)
            m.assertFalse(m.node.playbackActionButton.visible)

            m.node.overlay.area = "none"

            'bs:disable-next-line 1140
            updatePlaybackActionButton(1)

            m.assertTrue(m.node.musicVideoIntroMetadata.visible)
            m.assertTrue(m.node.playbackActionButton.visible)
        end function

        @it("expires the introductory presentation through the canonical update at five seconds")
        function _()
            m.node.videoPlayer = { state: "playing" }
            m.node.playback.isSeeking = false
            m.node.overlay.area = "none"

            'bs:disable-next-line 1140
            updatePlaybackActionButton(1)

            'bs:disable-next-line 1140
            updatePlaybackActionButton(5)

            m.assertFalse(m.node.musicVideoIntroMetadata.visible)
            m.assertFalse(m.node.playbackActionButton.visible)
        end function

        @it("renders artists above the music-video title")
        function _()
            item = { Id: "music-video-1", Type: "MusicVideo", Name: "Video Title", Artists: ["Artist One", "Artist Two"] }

            'bs:disable-next-line 1140
            updatePlaybackControlsMetadata({}, item)

            m.assertTrue(m.node.playbackControls.musicVideoMetadata)
            m.assertEqual(m.node.playbackControls.subtitle, "Artist One, Artist Two")
            m.assertEqual(m.node.playbackControls.title, "Video Title")
        end function

        @it("renders only the title when music-video artists are absent")
        function _()
            item = { Id: "music-video-1", Type: "MusicVideo", Name: "Video Title" }

            'bs:disable-next-line 1140
            updatePlaybackControlsMetadata({}, item)

            m.assertEqual(m.node.playbackControls.subtitle, "")
            m.assertEqual(m.node.playbackControls.title, "Video Title")
        end function

        @it("dismisses random Skip for the current item")
        function _()
            'bs:disable-next-line 1140
            showPlaybackActionButton(PlaybackAction.Mode.RandomSkip, "Skip")
            'bs:disable-next-line 1140
            updateMusicVideoIntroMetadata(m.node.activePlayback.context.item, 1)

            'bs:disable-next-line 1140
            dismissPlaybackAction()

            m.assertTrue(m.node.playbackAction.randomSkipDismissed)
            m.assertTrue(m.node.playbackAction.musicVideoMetadataDismissed)
            m.assertFalse(m.node.playbackActionButton.visible)
            m.assertFalse(m.node.musicVideoIntroMetadata.visible)
        end function

        @it("resets random Skip dismissal for the next item")
        function _()
            m.node.playbackAction.randomSkipDismissed = true

            'bs:disable-next-line 1140
            resetPlaybackActionsForItem("music-video-2")

            m.assertFalse(m.node.playbackAction.randomSkipDismissed)
            m.assertFalse(m.node.playbackAction.musicVideoMetadataDismissed)
            m.assertEqual(m.node.playbackAction.itemId, "music-video-2")
        end function

        @it("advances to the next random queue item when Skip is selected")
        function _()
            m.node.playbackAction.mode = PlaybackAction.Mode.RandomSkip

            'bs:disable-next-line 1140
            onPlaybackActionSelected()

            m.assertEqual(m.top.playRequest.itemId, "music-video-2")
            m.assertEqual(m.top.playRequest.playbackQueueIndex, 1)
            m.assertEqual(m.top.playRequest.playbackQueueMode, "random")
            m.assertEqual(m.top.playRequest.playbackQueueScope, "random")
        end function

        @it("dismisses music-video metadata before selecting Skip Intro")
        function _()
            m.node.playbackAction.mode = PlaybackAction.Mode.SkipIntro
            m.node.mediaSegments.activeEndSeconds = 3
            m.node.musicVideoIntroMetadata.visible = true
            m.node.playbackActionButton.visible = true
            m.node.videoPlayer = { seek: 0, control: "" }

            'bs:disable-next-line 1140
            onPlaybackActionSelected()

            m.assertTrue(m.node.playbackAction.musicVideoMetadataDismissed)
            m.assertFalse(m.node.musicVideoIntroMetadata.visible)
            m.assertFalse(m.node.playbackActionButton.visible)
            m.assertEqual(m.node.playback.position, 3)
        end function

        @it("shows Skip Credits for an active outro with Show Up Next")
        function _()
            m.node.activePlayback.context.item = { Id: "movie-1", Type: "Movie", Name: "Movie" }
            m.node.activePlayback.request.nextItemPlayback = NextItemPlayback.Mode.ShowUpNext
            m.node.activePlayback.queue.mode = "sequential"
            m.node.activePlayback.queue.scope = "playlist"
            m.node.mediaSegments.intros = []
            m.node.mediaSegments.outros = [{ startSeconds: 30.0, endSeconds: 60.0 }]
            m.node.videoPlayer = { state: "playing" }
            m.node.playback.isSeeking = false
            m.node.overlay.area = "none"

            'bs:disable-next-line 1140
            updatePlaybackActionButton(35)

            m.assertTrue(m.node.playbackActionButton.visible)
            m.assertEqual(m.node.playbackActionButton.text, "Skip Credits")
            m.assertEqual(m.node.playbackAction.mode, PlaybackAction.Mode.SkipCredits)
        end function

        @it("shows Play Next for immediate next-item playback")
        function _()
            m.node.activePlayback.context.item = { Id: "movie-1", Type: "Movie", Name: "Movie" }
            m.node.activePlayback.request.nextItemPlayback = NextItemPlayback.Mode.PlayNextImmediately
            m.node.activePlayback.queue.mode = "sequential"
            m.node.activePlayback.queue.scope = "playlist"
            m.node.mediaSegments.intros = []
            m.node.mediaSegments.outros = [{ startSeconds: 30.0, endSeconds: 60.0 }]
            m.node.videoPlayer = { state: "playing" }
            m.node.playback.isSeeking = false
            m.node.overlay.area = "none"

            'bs:disable-next-line 1140
            updatePlaybackActionButton(35)

            m.assertEqual(m.node.playbackActionButton.text, "Play Next")
            m.assertEqual(m.node.playbackAction.mode, PlaybackAction.Mode.PlayNext)
        end function

        @it("does not show an outro action without a next item")
        function _()
            m.node.activePlayback.context.item = { Id: "movie-1", Type: "Movie", Name: "Movie" }
            m.node.activePlayback.queue.items = [m.node.activePlayback.queue.items[0]]
            m.node.mediaSegments.intros = []
            m.node.mediaSegments.outros = [{ startSeconds: 30.0, endSeconds: 60.0 }]
            m.node.videoPlayer = { state: "playing" }
            m.node.playback.isSeeking = false
            m.node.overlay.area = "none"

            'bs:disable-next-line 1140
            updatePlaybackActionButton(35)

            m.assertFalse(m.node.playbackActionButton.visible)
        end function

        @it("dismisses the active outro action for its current range")
        function _()
            m.node.playbackAction.mode = PlaybackAction.Mode.SkipCredits
            m.node.mediaSegments.activeEndSeconds = 60

            'bs:disable-next-line 1140
            dismissPlaybackAction()

            m.assertEqual(m.node.mediaSegments.outroDismissedEndSeconds, 60)
            m.assertFalse(m.node.playbackActionButton.visible)
        end function

        @it("completes the current item before immediate Play Next")
        function _()
            currentItem = { Id: "movie-1", Type: "Movie", Name: "First", UserData: {} }
            nextItem = { Id: "movie-2", Type: "Movie", Name: "Second", UserData: {} }
            m.node.activePlayback.context.item = currentItem
            m.node.activePlayback.session.itemId = "movie-1"
            m.node.activePlayback.request.item = currentItem
            m.node.activePlayback.request.tracksPlaybackProgress = true
            m.node.activePlayback.request.nextItemPlayback = NextItemPlayback.Mode.PlayNextImmediately
            m.node.activePlayback.queue.items = [
                { itemId: "movie-1", item: currentItem, startPositionTicks: 0 }
                { itemId: "movie-2", item: nextItem, startPositionTicks: 0 }
            ]
            m.node.activePlayback.queue.index = 0
            m.node.activePlayback.queue.mode = "sequential"
            m.node.activePlayback.queue.scope = "playlist"
            m.node.playback.duration = 100
            m.node.playback.position = 80
            m.node.playback.hasEmittedFinalProgress = false
            m.node.playbackAction.mode = PlaybackAction.Mode.PlayNext

            'bs:disable-next-line 1140
            onPlaybackActionSelected()

            m.assertTrue(m.top.playbackProgressChanged.isFinished)
            m.assertTrue(currentItem.UserData.Played)
            m.assertNotInvalid(m.node.playbackAction.pendingCompletion)
            m.assertEqual(m.node.playbackCompletionTask.request.action, "MarkAsWatched")
            m.assertEqual(m.node.playbackCompletionTask.request.itemId, "movie-1")
            m.assertNotEqual(m.top.playRequest.itemId, "movie-2")

            m.node.playbackCompletionTask.response = { ok: true, action: "MarkAsWatched", itemId: "movie-1" }

            m.assertEqual(m.top.playRequest.itemId, "movie-2")
            m.assertEqual(m.top.playRequest.nextItemPlayback, NextItemPlayback.Mode.PlayNextImmediately)
        end function

        @it("completes the current item before opening Up Next")
        function _()
            currentItem = { Id: "movie-1", Type: "Movie", Name: "First", UserData: {} }
            nextItem = { Id: "movie-2", Type: "Movie", Name: "Second", UserData: {} }
            m.node.activePlayback.context.item = currentItem
            m.node.activePlayback.session.itemId = "movie-1"
            m.node.activePlayback.request.item = currentItem
            m.node.activePlayback.request.tracksPlaybackProgress = true
            m.node.activePlayback.request.nextItemPlayback = NextItemPlayback.Mode.ShowUpNext
            m.node.activePlayback.queue.items = [
                { itemId: "movie-1", item: currentItem, startPositionTicks: 0 }
                { itemId: "movie-2", item: nextItem, startPositionTicks: 0 }
            ]
            m.node.activePlayback.queue.index = 0
            m.node.activePlayback.queue.mode = "sequential"
            m.node.activePlayback.queue.scope = "playlist"
            m.node.playback.duration = 100
            m.node.playback.position = 80
            m.node.playback.hasEmittedFinalProgress = false
            m.node.playbackAction.mode = PlaybackAction.Mode.SkipCredits

            'bs:disable-next-line 1140
            onPlaybackActionSelected()

            m.assertTrue(m.top.playbackProgressChanged.isFinished)
            m.assertTrue(currentItem.UserData.Played)
            m.assertNotInvalid(m.node.playbackAction.pendingCompletion)
            m.assertInvalid(m.top.upNextRequested)

            m.node.playbackCompletionTask.response = { ok: true, action: "MarkAsWatched", itemId: "movie-1" }

            m.assertEqual(m.top.upNextRequested.nextItem.itemId, "movie-2")
            m.assertEqual(m.top.upNextRequested.nextItemPlayback, NextItemPlayback.Mode.ShowUpNext)
            m.assertTrue(m.top.closeRequested)
        end function

        @it("ignores a stale watched response while completion is pending")
        function _()
            m.node.activePlayback.session.itemId = "music-video-1"
            m.node.activePlayback.request.tracksPlaybackProgress = true
            m.node.activePlayback.request.nextItemPlayback = NextItemPlayback.Mode.PlayNextImmediately
            m.node.playback.duration = 100
            m.node.playbackAction.mode = PlaybackAction.Mode.PlayNext

            'bs:disable-next-line 1140
            onPlaybackActionSelected()

            m.node.playbackCompletionTask.response = { ok: true, action: "MarkAsWatched", itemId: "stale-item" }

            m.assertNotInvalid(m.node.playbackAction.pendingCompletion)
            m.assertNotEqual(m.top.playRequest.itemId, "music-video-2")
        end function

        @it("closes playback when the next item disappears before completion is confirmed")
        function _()
            m.node.activePlayback.session.itemId = "music-video-1"
            m.node.activePlayback.request.tracksPlaybackProgress = true
            m.node.activePlayback.request.nextItemPlayback = NextItemPlayback.Mode.PlayNextImmediately
            m.node.playback.duration = 100
            m.node.playbackAction.mode = PlaybackAction.Mode.PlayNext

            'bs:disable-next-line 1140
            onPlaybackActionSelected()
            m.node.activePlayback.queue.items = [m.node.activePlayback.queue.items[0]]

            m.node.playbackCompletionTask.response = { ok: true, action: "MarkAsWatched", itemId: "music-video-1" }

            m.assertInvalid(m.node.playbackAction.pendingCompletion)
            m.assertTrue(m.top.closeRequested)
        end function

        @it("continues after a matching watched failure")
        function _()
            m.node.activePlayback.session.itemId = "music-video-1"
            m.node.activePlayback.request.tracksPlaybackProgress = true
            m.node.activePlayback.request.nextItemPlayback = NextItemPlayback.Mode.PlayNextImmediately
            m.node.playback.duration = 100
            m.node.playbackAction.mode = PlaybackAction.Mode.PlayNext

            'bs:disable-next-line 1140
            onPlaybackActionSelected()

            m.node.playbackCompletionTask.response = { ok: false, action: "MarkAsWatched", itemId: "music-video-1", errorMessage: "failed" }

            m.assertInvalid(m.node.playbackAction.pendingCompletion)
            m.assertEqual(m.top.playRequest.itemId, "music-video-2")
        end function

        @it("cancels a pending watched completion when playback stops")
        function _()
            m.node.activePlayback.session.itemId = "music-video-1"
            m.node.activePlayback.request.tracksPlaybackProgress = true
            m.node.playback.duration = 100
            m.node.playbackAction.mode = PlaybackAction.Mode.PlayNext

            'bs:disable-next-line 1140
            onPlaybackActionSelected()

            'bs:disable-next-line 1140
            cancelPlaybackActionCompletion()
            m.node.playbackCompletionTask.response = { ok: true, action: "MarkAsWatched", itemId: "music-video-1" }

            m.assertInvalid(m.node.playbackAction.pendingCompletion)
            m.assertEqual(m.node.playbackCompletionTask.control, "stop")
            m.assertNotEqual(m.top.playRequest.itemId, "music-video-2")
        end function

        @it("ignores repeated action selections while completion is pending")
        function _()
            m.node.activePlayback.session.itemId = "music-video-1"
            m.node.activePlayback.request.tracksPlaybackProgress = true
            m.node.playback.duration = 100
            m.node.playbackAction.mode = PlaybackAction.Mode.PlayNext

            'bs:disable-next-line 1140
            onPlaybackActionSelected()
            firstRequest = m.node.playbackCompletionTask.request

            m.node.playbackAction.mode = PlaybackAction.Mode.PlayNext
            'bs:disable-next-line 1140
            onPlaybackActionSelected()

            m.assertEqual(m.node.playbackCompletionTask.request, firstRequest)
            m.assertNotInvalid(m.node.playbackAction.pendingCompletion)
        end function

        @it("ignores a duplicate watched response after continuation")
        function _()
            m.node.activePlayback.session.itemId = "music-video-1"
            m.node.activePlayback.request.tracksPlaybackProgress = true
            m.node.activePlayback.request.nextItemPlayback = NextItemPlayback.Mode.PlayNextImmediately
            m.node.playback.duration = 100
            m.node.playbackAction.mode = PlaybackAction.Mode.PlayNext

            'bs:disable-next-line 1140
            onPlaybackActionSelected()
            response = { ok: true, action: "MarkAsWatched", itemId: "music-video-1" }
            m.node.playbackCompletionTask.response = response
            continuedItemId = m.top.playRequest.itemId

            m.node.playbackCompletionTask.response = response

            m.assertInvalid(m.node.playbackAction.pendingCompletion)
            m.assertEqual(m.top.playRequest.itemId, continuedItemId)
        end function

        @describe("series artwork across queue transitions")

        @it("retains loaded series artwork in the Up Next request")
        function _()
            m.node.activePlayback.context.series = { Id: "show", Name: "Show", metadataLoaded: true, logoUrl: "http://server/logo.png" }
            m.node.activePlayback.queue.items[1].series = { Id: "show", Name: "Show" }

            'bs:disable-next-line 1140
            requested = requestUpNextAutoPlay()

            m.assertTrue(requested)
            m.assertEqual(m.top.upNextRequested.series.logoUrl, "http://server/logo.png")
            page = CreateObject("roSGNode", "TVEpisodeUpNextAutoPlay")
            page.autoPlayRequest = m.top.upNextRequested
            m.assertEqual(page.findNode("logoBanner").logoUrl, "http://server/logo.png")
        end function

        @it("retains loaded artwork when advancing directly to the next episode")
        function _()
            m.node.activePlayback.context.series = { Id: "show", Name: "Show", ImageTags: { Logo: "logo-tag" } }
            nextItem = m.node.activePlayback.queue.items[1]
            nextItem.series = { Id: "show", Name: "Show" }

            'bs:disable-next-line 1140
            request = buildQueuePlaybackRequest(nextItem, 1)

            m.assertEqual(request.series.ImageTags.Logo, "logo-tag")
        end function

        @it("does not borrow artwork from a different show")
        function _()
            m.node.activePlayback.context.series = { Id: "other", Name: "Other", metadataLoaded: true, logoUrl: "other-logo" }
            nextItem = { series: { Id: "show", Name: "Show" } }

            'bs:disable-next-line 1140
            series = getQueueItemSeries(nextItem)

            m.assertEqual(series, nextItem.series)
        end function

        @it("preserves confirmed missing artwork on the incoming series")
        function _()
            m.node.activePlayback.context.series = { Id: "show", Name: "Show", metadataLoaded: true, logoUrl: "old-logo" }
            nextItem = { series: { Id: "show", Name: "Show", metadataLoaded: true, logoUrl: "" } }

            'bs:disable-next-line 1140
            series = getQueueItemSeries(nextItem)

            m.assertEqual(series.logoUrl, "")
        end function

        @it("preserves explicit playlist context even when series data is absent")
        function _()
            m.node.activePlayback.context.series = { Id: "show", Name: "Show", metadataLoaded: true, logoUrl: "show-logo" }

            'bs:disable-next-line 1140
            series = getQueueItemSeries({ hasPlaybackContext: true, series: invalid })

            m.assertInvalid(series)
        end function

        protected function prepareEpisodeFallback() as object
            item = { Id: "episode-1", Type: "Episode", UserData: {} }
            nextItem = { Id: "episode-2", Type: "Episode", UserData: {} }
            m.node.activePlayback.context.item = item
            m.node.activePlayback.session.itemId = item.Id
            m.node.activePlayback.request.itemId = item.Id
            m.node.activePlayback.request.item = item
            m.node.activePlayback.request.nextEpisodePromptSeconds = "60"
            m.node.activePlayback.request.nextItemPlayback = "show-up-next"
            m.node.activePlayback.queue = {
                items: [
                    { itemId: item.Id, item: item, startPositionTicks: 0 }
                    { itemId: nextItem.Id, item: nextItem, startPositionTicks: 0 }
                ]
                index: 0
                mode: "sequential"
                scope: "playlist"
            }
            'bs:disable-next-line 1140
            initMediaSegments()
            m.node.mediaSegments.itemId = item.Id
            m.node.mediaSegments.resolved = true
            m.node.playback.duration = 600
            m.node.playback.position = 540
            m.node.videoPlayer = { state: "playing", duration: 600 }
            m.node.playback.phase = "active"
            m.node.playback.isSeeking = false
            m.node.overlay.area = "none"
            return item
        end function

        @describe("prompt lifecycle visibility")

        @it("hides the prompt during stopped playback despite a playing Video node")
        function _()
            m.prepareEpisodeFallback()
            'bs:disable-next-line 1140
            updatePlaybackActionButton(540)
            m.assertTrue(m.node.playbackActionButton.visible)
            m.capturePromptLogs()
            m.node.playback.phase = "stopped"

            'bs:disable-next-line 1140
            updatePlaybackActionButton(540)
            'bs:disable-next-line 1140
            updatePlaybackActionButton(541)

            m.assertFalse(m.node.playbackActionButton.visible)
            m.assertEqual(m.node.playbackAction.mode, "none")
            m.assertEqual(m.promptLogs().Count(), 0)
        end function

        @it("hides the prompt during resolving playback despite a playing Video node")
        function _()
            m.prepareEpisodeFallback()
            'bs:disable-next-line 1140
            updatePlaybackActionButton(540)
            m.assertTrue(m.node.playbackActionButton.visible)
            m.capturePromptLogs()
