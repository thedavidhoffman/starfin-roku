        @it("emits video options selection")
        function _()
            m.top.videoOptionsPressed = false
            m.top.skipBackEnabled = true
            m.top.skipForwardEnabled = true

            m.top.findNode("videoButton").buttonSelected = true

            m.assertTrue(m.top.videoOptionsPressed)
        end function
        @it("emits playback info selection")
        function _()
            m.top.playbackInfoPressed = false
            m.top.skipBackEnabled = true
            m.top.skipForwardEnabled = true

            m.top.findNode("playbackInfoButton").buttonSelected = true

            m.assertTrue(m.top.playbackInfoPressed)
        end function
        @it("emits skip back selection")
        function _()
            m.top.skipBackPressed = false
            m.top.skipBackEnabled = true
            m.top.skipForwardEnabled = true

            m.top.findNode("skipBackButton").buttonSelected = true

            m.assertTrue(m.top.skipBackPressed)
        end function
        @it("emits skip forward selection")
        function _()
            m.top.skipForwardPressed = false
            m.top.skipBackEnabled = true
            m.top.skipForwardEnabled = true

            m.top.findNode("skipForwardButton").buttonSelected = true

            m.assertTrue(m.top.skipForwardPressed)
        end function
        @it("emits last five seconds selection")
        function _()
            m.top.last5Pressed = false
            m.top.skipBackEnabled = true
            m.top.skipForwardEnabled = true

            m.top.findNode("last5Button").buttonSelected = true

            m.assertTrue(m.top.last5Pressed)
        end function

    end class

end namespace
