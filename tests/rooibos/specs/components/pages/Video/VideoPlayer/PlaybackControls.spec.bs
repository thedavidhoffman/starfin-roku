import "pkg:/source/Number.bs"
import "pkg:/source/DateTime.bs"

namespace tests

    @SGNode("PlaybackControls")
    @suite("PlaybackControls component")
    class PlaybackControlsTests extends rooibos.BaseTestSuite

        protected override function afterEach()
            m.top.callFunc("deactivate")
            getGlobalAa().Delete("finishTimeTestNow")
        end function

        @describe("estimated finish time")

        @it("calculates completion from the remaining duration")
        function _()
            m.stubCall(DateTime.ToIsoOffset, m.fixedTimeOffset)
            m.prepareFinishTime()

            m.assertEqual(m.top.findNode("finishTimeLabel").text, "Ends at " + DateTime.ToLocalShortTime("2026-09-17T18:10:00Z"))
        end function

        @it("clamps a negative position")
        function _()
            m.stubCall(DateTime.ToIsoOffset, m.fixedTimeOffset)
            m.prepareFinishTime()

            m.top.position = -20
            m.assertEqual(m.top.findNode("finishTimeLabel").text, "Ends at " + DateTime.ToLocalShortTime("2026-09-17T18:20:00Z"))
        end function

        @it("clamps a position beyond the duration")
        function _()
            m.stubCall(DateTime.ToIsoOffset, m.fixedTimeOffset)
            m.prepareFinishTime()

            m.top.position = 1500
            m.assertEqual(m.top.findNode("finishTimeLabel").text, "Ends at " + DateTime.ToLocalShortTime("2026-09-17T18:00:00Z"))
        end function

        @it("hides an unknown duration and stops its timer")
        function _()
            m.stubCall(DateTime.ToIsoOffset, m.fixedTimeOffset)
            m.prepareFinishTime()

            m.top.duration = 0
            m.assertFalse(m.top.findNode("finishTimeLabel").visible)
            m.assertEqual(m.top.findNode("finishTimeLabel").text, "")
            m.assertEqual(m.top.findNode("finishTimeTimer").control, "stop")
        end function

        @it("hides a negative duration")
        function _()
            m.stubCall(DateTime.ToIsoOffset, m.fixedTimeOffset)
            m.prepareFinishTime()

            m.top.duration = -1
            m.assertFalse(m.top.findNode("finishTimeLabel").visible)
        end function

        @it("starts the timer with visible valid controls")
        function _()
            m.stubCall(DateTime.ToIsoOffset, m.fixedTimeOffset)
            m.prepareFinishTime()

            m.assertEqual(m.top.findNode("finishTimeTimer").control, "start")
            m.assertEqual(Number.ToInteger(m.top.findNode("finishTimeTimer").duration, 0), 1)
        end function

        @it("advances the estimate while paused without changing focus")
        function _()
            m.stubCall(DateTime.ToIsoOffset, m.fixedTimeOffset)
            m.prepareFinishTime()

            m.top.isPlaying = false
            getGlobalAa().finishTimeTestNow = "2026-09-17T18:02:00Z"
            'bs:disable-next-line 1140
            updateFinishTime()
            m.assertEqual(m.top.findNode("finishTimeLabel").text, "Ends at " + DateTime.ToLocalShortTime("2026-09-17T18:12:00Z"))
            m.assertTrue(m.top.findNode("playPauseButton").hasFocus())
        end function

        @it("stops refreshing when hidden during pause")
        function _()
            m.stubCall(DateTime.ToIsoOffset, m.fixedTimeOffset)
            m.prepareFinishTime()

            m.top.isPlaying = false
            m.top.visible = false
            previous = m.top.findNode("finishTimeLabel").text
            getGlobalAa().finishTimeTestNow = "2026-09-17T19:00:00Z"
            'bs:disable-next-line 1140
            updateFinishTime()
            m.assertEqual(m.top.findNode("finishTimeTimer").control, "stop")
            m.assertEqual(m.top.findNode("finishTimeLabel").text, previous)
        end function

        @it("recalculates immediately when reopened")
        function _()
            m.stubCall(DateTime.ToIsoOffset, m.fixedTimeOffset)
            m.prepareFinishTime()

            m.top.visible = false
            getGlobalAa().finishTimeTestNow = "2026-09-17T19:00:00Z"
            m.top.visible = true
            m.assertEqual(m.top.findNode("finishTimeLabel").text, "Ends at " + DateTime.ToLocalShortTime("2026-09-17T19:10:00Z"))
            m.assertEqual(m.top.findNode("finishTimeTimer").control, "start")
        end function

        @it("stops the timer on deactivation before the fade completes")
        function _()
            m.stubCall(DateTime.ToIsoOffset, m.fixedTimeOffset)
            m.prepareFinishTime()

            m.top.callFunc("deactivate")
            m.assertTrue(m.top.visible)
            m.assertEqual(m.top.findNode("finishTimeTimer").control, "stop")
        end function

        @it("uses the seek preview")
        function _()
            m.stubCall(DateTime.ToIsoOffset, m.fixedTimeOffset)
            m.prepareFinishTime()

            m.top.previewPosition = 900
            m.top.isSeeking = true
            m.assertEqual(m.top.findNode("finishTimeLabel").text, "Ends at " + DateTime.ToLocalShortTime("2026-09-17T18:05:00Z"))
        end function

        @it("restores actual position after seek cancellation")
        function _()
            m.stubCall(DateTime.ToIsoOffset, m.fixedTimeOffset)
            m.prepareFinishTime()

            m.top.previewPosition = 900
            m.top.isSeeking = true
            m.top.isSeeking = false
            m.assertEqual(m.top.findNode("finishTimeLabel").text, "Ends at " + DateTime.ToLocalShortTime("2026-09-17T18:10:00Z"))
        end function

        @it("uses the committed seek position")
        function _()
            m.stubCall(DateTime.ToIsoOffset, m.fixedTimeOffset)
            m.prepareFinishTime()

            m.top.isSeeking = true
            m.top.previewPosition = 900
            m.top.position = 900
            m.top.isSeeking = false
            m.assertEqual(m.top.findNode("finishTimeLabel").text, "Ends at " + DateTime.ToLocalShortTime("2026-09-17T18:05:00Z"))
        end function

        @it("replaces the estimate for a new title duration")
        function _()
            m.stubCall(DateTime.ToIsoOffset, m.fixedTimeOffset)
            m.prepareFinishTime()

            m.top.duration = 3600
            m.top.position = 0
            m.assertEqual(m.top.findNode("finishTimeLabel").text, "Ends at " + DateTime.ToLocalShortTime("2026-09-17T19:00:00Z"))
        end function

        @it("formats the finish estimate across noon")
        function _()
            m.stubCall(DateTime.ToIsoOffset, m.fixedTimeOffset)
            m.prepareFinishTime()
            utc = CreateObject("roDateTime")
            utc.FromISO8601String("2026-09-17T11:59:00Z")
            local = CreateObject("roDateTime")
            local.FromISO8601String("2026-09-17T11:59:00Z")
            local.ToLocalTime()
            offset = local.AsSeconds() - utc.AsSeconds()
            utc.FromSeconds(utc.AsSeconds() - offset)
            getGlobalAa().finishTimeTestNow = utc.ToISOString()
            m.top.position = 1080

            m.assertEqual(m.top.findNode("finishTimeLabel").text, "Ends at 12:01 PM")
        end function

        @it("formats the finish estimate across midnight")
        function _()
            m.stubCall(DateTime.ToIsoOffset, m.fixedTimeOffset)
            m.prepareFinishTime()
            utc = CreateObject("roDateTime")
            utc.FromISO8601String("2026-09-17T23:59:00Z")
            local = CreateObject("roDateTime")
            local.FromISO8601String("2026-09-17T23:59:00Z")
            local.ToLocalTime()
            offset = local.AsSeconds() - utc.AsSeconds()
            utc.FromSeconds(utc.AsSeconds() - offset)
            getGlobalAa().finishTimeTestNow = utc.ToISOString()
            m.top.position = 1080

            m.assertEqual(m.top.findNode("finishTimeLabel").text, "Ends at 12:01 AM")
        end function

        private sub prepareFinishTime()
            getGlobalAa().finishTimeTestNow = "2026-09-17T18:00:00Z"
            m.top.visible = true
            m.top.isSeeking = false
            m.top.duration = 1200
            m.top.position = 600
            m.top.callFunc("resetFocus")
            m.top.callFunc("activate")
        end sub

        private function fixedTimeOffset(seconds as integer) as string
            date = CreateObject("roDateTime")
            date.FromISO8601String(getGlobalAa().finishTimeTestNow)
            date.FromSeconds(date.AsSeconds() + seconds)
            return date.ToISOString()
        end function

