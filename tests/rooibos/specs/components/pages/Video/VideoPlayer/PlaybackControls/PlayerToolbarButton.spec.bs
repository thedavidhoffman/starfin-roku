namespace tests

    @SGNode("PlayerToolbarButton")
    @suite("PlayerToolbarButton component")
    class PlayerToolbarButtonTests extends rooibos.BaseTestSuite

        protected override function beforeEach()
            m.top.setFields({ text: "", maxWidth: 600, enabled: true, hasFocusVisual: false })
        end function

        @describe("declarative component contract")

        @it("declares the iconPoster node")
        function _()
            m.assertNotInvalid(m.top.findNode("iconPoster"))
        end function

        @describe("icon rendering")

        @it("renders the configured icon without focus")
        function _()
            m.top.hasFocusVisual = false
            m.top.icon = "pkg:/images/icons/play.png"

            'bs:disable-next-line 1140
            render()

            m.assertEqual(m.top.findNode("iconPoster").uri, "pkg:/images/icons/play.png")
        end function

        @it("renders the focused icon with a focus visual")
        function _()
            m.top.focusedIcon = "pkg:/images/icons/play-dark.png"
            m.top.hasFocusVisual = true

            'bs:disable-next-line 1140
            render()

            m.assertEqual(m.top.findNode("iconPoster").uri, "pkg:/images/icons/play-dark.png")
        end function

        @it("dims the icon when disabled")
        function _()
            m.top.hasFocusVisual = true
            m.top.enabled = false

            'bs:disable-next-line 1140
            render()

            m.assertEqual(m.top.findNode("iconPoster").opacity, 0.35)
        end function

        @it("clears the focus visual when disabled")
        function _()
            m.top.hasFocusVisual = true
            m.top.enabled = false

            'bs:disable-next-line 1140
            render()

            m.assertFalse(m.top.hasFocusVisual)
        end function

        @it("restores full opacity when enabled")
        function _()
            m.top.enabled = true

            'bs:disable-next-line 1140
            render()

            m.assertEqual(m.top.findNode("iconPoster").opacity, 1.0)
        end function

        @describe("selection")

        @it("emits selection for a pressed OK key")
        function _()
            m.top.enabled = true
            m.top.buttonSelected = false

            'bs:disable-next-line 1140
            handled = onKeyEvent("OK", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.buttonSelected)
        end function

        @it("emits selection for a pressed Select key")
        function _()
            m.top.enabled = true
            m.top.buttonSelected = false

            'bs:disable-next-line 1140
            handled = onKeyEvent("select", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.buttonSelected)
        end function

        @it("ignores released selection keys")
        function _()
            m.top.enabled = true
            m.top.buttonSelected = false

            'bs:disable-next-line 1140
            handled = onKeyEvent("OK", false)

            m.assertFalse(handled)
            m.assertFalse(m.top.buttonSelected)
        end function

        @it("swallows selection keys while disabled")
        function _()
            m.top.enabled = false
            m.top.buttonSelected = false

            'bs:disable-next-line 1140
            handled = onKeyEvent("OK", true)

            m.assertTrue(handled)
            m.assertFalse(m.top.buttonSelected)
        end function

        @it("ignores unrelated pressed keys")
        function _()
            m.top.enabled = true

            'bs:disable-next-line 1140
            handled = onKeyEvent("left", true)

            m.assertFalse(handled)
        end function

        @describe("summary presentation")

        @it("keeps the summary white and visible with a larger cog")
        function _()
            m.top.setFields({ text: "4K HEVC", icon: "pkg:/images/icons/media-toolbar/cog-light.png", focusedIcon: "pkg:/images/icons/media-toolbar/cog-focused.png" })

            m.assertEqual(m.top.findNode("textLabel").text, "4K HEVC")
            m.assertTrue(m.top.findNode("textLabel").visible)
            m.assertEqual(m.top.findNode("textLabel").color, &hFFFFFFFF)
            m.assertEqual(m.top.findNode("iconPoster").width, 48.0)
            m.assertEqual(m.top.findNode("textLabel").translation, [75.0, 23.0])
            m.assertEqual(m.top.findNode("background").height, 75.0)
        end function

        @it("inverts the whole pill without changing its width or summary")
        function _()
            m.top.setFields({ text: "4K HEVC", icon: "pkg:/images/icons/media-toolbar/cog-light.png", focusedIcon: "pkg:/images/icons/media-toolbar/cog-focused.png" })

            width = m.top.preferredWidth

            m.top.hasFocusVisual = true

            m.assertEqual(m.top.preferredWidth, width)
            m.assertTrue(Instr(1, m.top.findNode("background").uri, "playback-summary-focused.9.png") > 0)
            m.assertTrue(m.top.findNode("background").width = width)
            m.assertEqual(m.top.findNode("textLabel").color, &h0F1A2AFF)
            m.assertEqual(m.top.findNode("iconPoster").uri, "pkg:/images/icons/media-toolbar/cog-focused.png")
            m.assertTrue(m.top.findNode("textLabel").visible)
        end function

        @it("caps long summaries and restores the width for shorter text")
        function _()
            m.top.setFields({ text: "4K HEVC", icon: "pkg:/images/icons/media-toolbar/cog-light.png", focusedIcon: "pkg:/images/icons/media-toolbar/cog-focused.png" })

            m.top.text = String(150, "W")
            m.assertEqual(m.top.preferredWidth, 600)
            m.assertEqual(m.top.findNode("textLabel").width, 497.0)

            m.top.text = "HD"

            m.assertTrue(m.top.preferredWidth < 600)
            m.assertTrue(m.top.preferredWidth >= 150)
        end function

        @it("emits selection on OK")
        function _()
            m.top.setFields({ text: "4K HEVC", icon: "pkg:/images/icons/media-toolbar/cog-light.png", focusedIcon: "pkg:/images/icons/media-toolbar/cog-focused.png" })

            m.top.buttonSelected = false

            'bs:disable-next-line 1140
            handled = onKeyEvent("OK", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.buttonSelected)
        end function

        @it("does not select on a key release")
        function _()
            m.top.setFields({ text: "4K HEVC", icon: "pkg:/images/icons/media-toolbar/cog-light.png", focusedIcon: "pkg:/images/icons/media-toolbar/cog-focused.png" })

            m.top.buttonSelected = false

            'bs:disable-next-line 1140
            handled = onKeyEvent("OK", false)

            m.assertFalse(handled)
            m.assertFalse(m.top.buttonSelected)
        end function

        @it("disables selection and restores unfocused colors")
        function _()
            m.top.setFields({ text: "4K HEVC", icon: "pkg:/images/icons/media-toolbar/cog-light.png", focusedIcon: "pkg:/images/icons/media-toolbar/cog-focused.png" })

            m.top.hasFocusVisual = true
            m.top.buttonSelected = false
            m.top.enabled = false

            'bs:disable-next-line 1140
            handled = onKeyEvent("OK", true)

            m.assertTrue(handled)
            m.assertFalse(m.top.buttonSelected)
            m.assertTrue(Instr(1, m.top.findNode("background").uri, "playback-summary-unfocused.9.png") > 0)
        end function

        @it("restores white text and cog after focus leaves")
        function _()
            m.top.setFields({ text: "4K HEVC", icon: "pkg:/images/icons/media-toolbar/cog-light.png", focusedIcon: "pkg:/images/icons/media-toolbar/cog-focused.png" })

            m.top.hasFocusVisual = true

            m.top.hasFocusVisual = false

            m.assertEqual(m.top.findNode("textLabel").color, &hFFFFFFFF)
            m.assertEqual(m.top.findNode("iconPoster").uri, "pkg:/images/icons/media-toolbar/cog-light.png")
            m.assertTrue(Instr(1, m.top.findNode("background").uri, "playback-summary-unfocused.9.png") > 0)
        end function

        @it("restores circle geometry when summary text is removed")
        function _()
            m.top.text = "4K HEVC"

            m.top.text = ""

            m.assertEqual(m.top.preferredWidth, 75)
            m.assertEqual(m.top.findNode("iconPoster").translation, [0.0, 0.0])
            m.assertEqual(m.top.findNode("iconPoster").width, 75.0)
            m.assertEqual(m.top.findNode("iconPoster").height, 75.0)
            m.assertFalse(m.top.findNode("background").visible)
            m.assertFalse(m.top.findNode("textLabel").visible)
        end function

    end class

end namespace
