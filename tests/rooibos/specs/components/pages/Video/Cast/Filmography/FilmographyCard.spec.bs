namespace tests

    @SGNode("FilmographyCard")
    @suite("FilmographyCard component")
    class FilmographyCardTests extends rooibos.BaseTestSuite

        @describe("declarative component contract")

        @it("declares the dateLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("dateLabel"))
        end function

        @it("declares the titleLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("titleLabel"))
        end function

        @it("declares the characterLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("characterLabel"))
        end function

        @describe("credit rendering")

        @it("renders release date and title")
        function _()
            item = m.createItem("2025", "Feature", "")

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("dateLabel").text, "2025")
            m.assertEqual(m.top.findNode("titleLabel").text, "Feature")
        end function

        @it("prefixes a character name with as")
        function _()
            item = m.createItem("2025", "Feature", "Captain")

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("characterLabel").text, "as Captain")
        end function

        @it("clears labels when item content is removed")
        function _()
            m.top.itemContent = m.createItem("2025", "Feature", "Captain")

            m.top.itemContent = invalid

            m.assertEqual(m.top.findNode("dateLabel").text, "")
            m.assertEqual(m.top.findNode("titleLabel").text, "")
            m.assertEqual(m.top.findNode("characterLabel").text, "")
        end function

        @describe("focus styling")

        @it("uses primary styling when focused")
        function _()
            initialColor = m.top.findNode("dateLabel").color

            m.top.itemHasFocus = true

            m.assertNotEqual(m.top.findNode("dateLabel").color, initialColor)
        end function

        @it("restores unfocused styling when focus is lost")
        function _()
            m.top.itemHasFocus = true
            focusedColor = m.top.findNode("dateLabel").color

            m.top.itemHasFocus = false

            m.assertNotEqual(m.top.findNode("dateLabel").color, focusedColor)
        end function

        function createItem(releaseDate as string, title as string, character as string) as object
            item = CreateObject("roSGNode", "ContentNode")
            item.addFields({ releaseDate: releaseDate, character: character })
            item.title = title
            return item
        end function

    end class

end namespace
