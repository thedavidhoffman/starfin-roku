namespace tests

    @SGNode("CastItem")
    @suite("CastItem component")
    class CastItemTests extends rooibos.BaseTestSuite

        @describe("fresh component observers")

        @it("renders content on a fresh component")
        function _()
            component = CreateObject("roSGNode", "CastItem")
            item = m.createItem("Fresh actor", "Character", "http://server/person.jpg")

            component.itemContent = item

            m.assertEqual(component.findNode("nameLabel").text, "Fresh actor")
            m.assertEqual(component.findNode("detailsLabel").text, "Character")
            m.assertEqual(component.findNode("poster").uri, "http://server/person.jpg")
        end function

        @describe("focused text scrolling")

        @it("keeps both labels idle on a fresh component")
        function _()
            component = CreateObject("roSGNode", "CastItem")

            m.assertEqual(component.findNode("nameLabel").repeatCount, 0)
            m.assertEqual(component.findNode("detailsLabel").repeatCount, 0)
        end function

        @it("enables native overflow scrolling for both labels when focused")
        function _()
            component = CreateObject("roSGNode", "CastItem")
            component.itemContent = m.createItem("An actor with a very long name", "A character with a very long name", "")

            component.itemHasFocus = true

            m.assertEqual(component.findNode("nameLabel").subtype(), "ScrollingLabel")
            m.assertEqual(component.findNode("detailsLabel").subtype(), "ScrollingLabel")
            m.assertEqual(component.findNode("nameLabel").maxWidth, 207)
            m.assertEqual(component.findNode("detailsLabel").maxWidth, 207)
            m.assertEqual(component.findNode("nameLabel").repeatCount, -1)
            m.assertEqual(component.findNode("detailsLabel").repeatCount, -1)
        end function

        @it("disables scrolling for both labels when focus leaves")
        function _()
            component = CreateObject("roSGNode", "CastItem")
            component.itemHasFocus = true

            component.itemHasFocus = false

            m.assertEqual(component.findNode("nameLabel").repeatCount, 0)
            m.assertEqual(component.findNode("detailsLabel").repeatCount, 0)
        end function

        @it("enables scrolling again when focus returns")
        function _()
            component = CreateObject("roSGNode", "CastItem")
            component.itemHasFocus = true
            component.itemHasFocus = false

            component.itemHasFocus = true

            m.assertEqual(component.findNode("nameLabel").repeatCount, -1)
            m.assertEqual(component.findNode("detailsLabel").repeatCount, -1)
        end function

        @it("updates both texts while retaining focused scrolling")
        function _()
            component = CreateObject("roSGNode", "CastItem")
            component.itemContent = m.createItem("Original actor", "Original character", "")
            component.itemHasFocus = true

            component.itemContent = m.createItem("Replacement actor", "Replacement character", "")

            m.assertEqual(component.findNode("nameLabel").text, "Replacement actor")
            m.assertEqual(component.findNode("detailsLabel").text, "Replacement character")
            m.assertEqual(component.findNode("nameLabel").repeatCount, -1)
            m.assertEqual(component.findNode("detailsLabel").repeatCount, -1)
        end function

        @it("keeps replacement text idle when unfocused")
        function _()
            component = CreateObject("roSGNode", "CastItem")
            component.itemContent = m.createItem("Original actor", "Original character", "")

            component.itemContent = m.createItem("Replacement actor", "", "")

            m.assertEqual(component.findNode("nameLabel").text, "Replacement actor")
            m.assertEqual(component.findNode("detailsLabel").text, "")
            m.assertEqual(component.findNode("nameLabel").repeatCount, 0)
            m.assertEqual(component.findNode("detailsLabel").repeatCount, 0)
        end function

        @describe("declarative component contract")

        @it("declares the posterMask node")
        function _()
            m.assertNotInvalid(m.top.findNode("posterMask"))
        end function

        @it("declares the poster node")
        function _()
            m.assertNotInvalid(m.top.findNode("poster"))
        end function

        @it("declares the nameLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("nameLabel"))
        end function

        @it("declares the detailsLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("detailsLabel"))
        end function

        @describe("item rendering")

        @it("renders the cast member name")
        function _()
            item = m.createItem("Actor", "Character", "http://server/person.jpg")

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("nameLabel").text, "Actor")
        end function

        @it("renders cast details")
        function _()
            item = m.createItem("Actor", "Character", "")

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("detailsLabel").text, "Character")
        end function

        @it("renders and shows a supplied cast image")
        function _()
            item = m.createItem("Actor", "", "http://server/person.jpg")

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("poster").uri, "http://server/person.jpg")
            m.assertTrue(m.top.findNode("poster").visible)
        end function

        @it("hides the poster when the cast image is missing")
        function _()
            item = m.createItem("Actor", "", "")

            m.top.itemContent = item

            m.assertFalse(m.top.findNode("poster").visible)
        end function

        function createItem(title as string, description as string, imageUrl as string) as object
            item = CreateObject("roSGNode", "ContentNode")
            item.title = title
            item.description = description
            item.HDPosterUrl = imageUrl
            return item
        end function

    end class

end namespace
