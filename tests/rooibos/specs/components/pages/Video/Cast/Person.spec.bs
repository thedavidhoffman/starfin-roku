namespace tests

    @SGNode("Person")
    @suite("Person component")
    class PersonTests extends rooibos.BaseTestSuite

        protected override function beforeEach()
            m.node.pageState.request = { server: "http://server", token: "token", userId: "user", itemId: "person-1" }
            m.node.pageState.person = m.createPerson()
            m.node.pageState.filmography = invalid
            m.node.pageState.focusArea = "person"
            m.top.settings = { "tmdb-api-key": "" }
            m.top.selectedMovie = invalid
            m.top.selectedSeries = invalid
            m.top.selectedEpisode = invalid
            m.top.selectedFilmography = invalid
            m.top.overlayRequested = invalid
            m.top.closeRequested = false
            'bs:disable-next-line 1140
            clearRelated()
        end function

        @describe("declarative component contract")

        @it("declares the bioGroup node")
        function _()
            m.assertNotInvalid(m.top.findNode("bioGroup"))
        end function

        @it("leaves the biography background transparent")
