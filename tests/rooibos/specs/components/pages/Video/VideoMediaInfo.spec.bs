namespace tests

    @SGNode("VideoMediaInfo")
    @suite("VideoMediaInfo component")
    class VideoMediaInfoTests extends rooibos.BaseTestSuite

        @describe("declarative component contract")

        @it("declares the backdrop node")
        function _()
            m.assertNotInvalid(m.top.findNode("backdrop"))
        end function

        @it("declares the leftChevron node")
        function _()
            m.assertNotInvalid(m.top.findNode("leftChevron"))
        end function

        @it("declares the rightChevron node")
        function _()
            m.assertNotInvalid(m.top.findNode("rightChevron"))
        end function

        @it("declares the contentGroup node")
        function _()
            m.assertNotInvalid(m.top.findNode("contentGroup"))
        end function

        @it("declares the headerLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("headerLabel"))
        end function

        @it("declares the sourceCard node")
        function _()
            m.assertNotInvalid(m.top.findNode("sourceCard"))
        end function

        @it("declares the sourceTitleLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("sourceTitleLabel"))
        end function

        @it("declares the sourceTextLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("sourceTextLabel"))
        end function

        @it("declares the slot0Card node")
        function _()
            m.assertNotInvalid(m.top.findNode("slot0Card"))
        end function

        @it("declares the slot1Card node")
        function _()
            m.assertNotInvalid(m.top.findNode("slot1Card"))
        end function

        @it("declares the slot2Card node")
        function _()
            m.assertNotInvalid(m.top.findNode("slot2Card"))
        end function

        @describe("media source rendering")

        @it("renders the media source name as the header")
        function _()
            m.top.item = m.createItem(1)

            m.assertEqual(m.top.findNode("headerLabel").text, "Source One")
        end function

        @it("renders source container and size")
        function _()
            m.top.item = m.createItem(1)

            summary = m.top.findNode("sourceTitleLabel").text
            m.assertTrue(Instr(1, summary, "MKV") > 0)
            m.assertTrue(Instr(1, summary, "1.0 GiB") > 0)
        end function

        @it("renders the source path")
        function _()
            m.top.item = m.createItem(1)

            m.assertEqual(m.top.findNode("sourceTextLabel").text, "/media/movie.mkv")
        end function

        @it("renders a no-source fallback")
        function _()
            m.top.item = { Name: "Movie", MediaSources: [] }

            m.assertEqual(m.top.findNode("sourceTextLabel").text, "No media source details available.")
        end function

        @describe("stream cards")

        @it("renders a video stream card")
        function _()
            m.top.item = m.createItem(1)

            m.assertEqual(m.top.findNode("slot0Card").title, "Main Video")
            m.assertTrue(Instr(1, m.top.findNode("slot0Card").summary, "1920x1080") > 0)
        end function

        @it("renders an audio stream card")
        function _()
            m.top.item = m.createItem(1)

            m.assertEqual(m.top.findNode("slot1Card").title, "English Audio")
            m.assertTrue(Instr(1, m.top.findNode("slot1Card").summary, "6 ch") > 0)
        end function

        @it("renders a no-subtitle card when subtitles are absent")
        function _()
            m.top.item = m.createItem(1)

            m.assertEqual(m.top.findNode("slot2Card").title, "Subtitles")
            m.assertEqual(m.top.findNode("slot2Card").summary, "No subtitle stream")
        end function

        @it("hides unused slots when only the subtitle fallback exists")
        function _()
            item = { Name: "Movie", MediaSources: [{ Name: "Source", MediaStreams: [] }] }

            m.top.item = item

            m.assertEqual(m.top.findNode("slot0Card").title, "Subtitles")
            m.assertEqual(m.top.findNode("slot0Card").summary, "No subtitle stream")
        end function

        @describe("pagination and lifecycle")

        @it("opens and focuses media information")
        function _()
            m.top.item = m.createItem(4)

            m.top.callFunc("openVideoMediaInfo")

            m.assertTrue(m.top.hasFocus())
        end function

        @it("shows the right chevron when more than three cards exist")
        function _()
            m.top.item = m.createItem(4)

            m.assertTrue(m.top.findNode("rightChevron").visible)
            m.assertFalse(m.top.findNode("leftChevron").visible)
        end function

        @it("pages right through stream cards")
        function _()
            m.top.item = m.createItem(4)
            initialTitle = m.top.findNode("slot0Card").title

            'bs:disable-next-line 1140
            handled = onKeyEvent("right", true)

            m.assertTrue(handled)
            m.assertNotEqual(m.top.findNode("slot0Card").title, initialTitle)
            m.assertTrue(m.top.findNode("leftChevron").visible)
        end function

        @it("pages left after moving right")
        function _()
            m.top.item = m.createItem(4)
            initialTitle = m.top.findNode("slot0Card").title
            'bs:disable-next-line 1140
            onKeyEvent("right", true)

            'bs:disable-next-line 1140
            handled = onKeyEvent("left", true)

            m.assertTrue(handled)
            m.assertEqual(m.top.findNode("slot0Card").title, initialTitle)
        end function

        @it("ignores Left at the first page")
        function _()
            m.top.item = m.createItem(4)

            'bs:disable-next-line 1140
            handled = onKeyEvent("left", true)

            m.assertFalse(handled)
        end function

        @it("requests close for pressed Back")
        function _()
            m.top.closeRequested = false

            'bs:disable-next-line 1140
            handled = onKeyEvent("back", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.closeRequested)
        end function

        @it("ignores released keys")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("right", false)

            m.assertFalse(handled)
        end function

        function createItem(audioCount as integer) as object
            streams = [
                { Type: "Video", DisplayTitle: "Main Video", Width: 1920, Height: 1080, Codec: "h264", RealFrameRate: 24, BitRate: 5000000, BitDepth: 8, IsAnamorphic: false, IsInterlaced: false }
            ]
            for i = 1 to audioCount
                streams.Push({ Type: "Audio", DisplayTitle: "English Audio " + i.ToStr(), Channels: 6, ChannelLayout: "5.1", Codec: "aac", Language: "eng", BitRate: 192000, SampleRate: 48000, IsDefault: i = 1, IsForced: false, IsExternal: false })
            end for
            if audioCount = 1 then streams[1].DisplayTitle = "English Audio"
            return {
                Name: "Movie"
                MediaSources: [{ Name: "Source One", Container: "MKV", Size: 1073741824, Path: "/media/movie.mkv", MediaStreams: streams }]
            }
        end function

    end class

end namespace
