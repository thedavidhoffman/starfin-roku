namespace tests

    @SGNode("VideoMediaInfoCard")
    @suite("VideoMediaInfoCard component")
    class VideoMediaInfoCardTests extends rooibos.BaseTestSuite

        @describe("declarative component contract")

        @it("declares the cardBackground node")
        function _()
            m.assertNotInvalid(m.top.findNode("cardBackground"))
        end function

        @it("declares the accentBar node")
        function _()
            m.assertNotInvalid(m.top.findNode("accentBar"))
        end function

        @it("declares the titleLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("titleLabel"))
        end function

        @it("declares the summaryLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("summaryLabel"))
        end function

        @it("declares the detailsLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("detailsLabel"))
        end function

        @describe("card rendering")

        @it("renders the card title")
        function _()
            m.top.title = "Video"

            m.assertEqual(m.top.findNode("titleLabel").text, "Video")
        end function

        @it("renders the card summary")
        function _()
            m.top.summary = "H.264"

            m.assertEqual(m.top.findNode("summaryLabel").text, "H.264")
        end function

        @it("renders card details")
        function _()
            m.top.details = "1920 x 1080"

            m.assertEqual(m.top.findNode("detailsLabel").text, "1920 x 1080")
        end function

        @it("applies a supplied accent color")
        function _()
            m.top.accentColor = &h112233FF

            m.assertEqual(m.top.findNode("accentBar").color, &h112233FF)
        end function

        @it("uses the default accent color for zero")
        function _()
            m.top.accentColor = 0

            m.assertEqual(m.top.findNode("accentBar").color, &h6EC6FFFF)
        end function

        @it("applies a supplied summary color")
        function _()
            m.top.summaryColor = &h445566FF

            m.assertEqual(m.top.findNode("summaryLabel").color, &h445566FF)
        end function
    end class

end namespace
