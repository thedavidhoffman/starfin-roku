namespace tests

    @SGNode("VideoMediaInfoDialog")
    @suite("VideoMediaInfoDialog component")
    class VideoMediaInfoDialogTests extends rooibos.BaseTestSuite

        @describe("behavior")

        @it("opens the shared frame and focuses content")
        function _()
            m.top.item = { Name: "Test Movie" }
            m.top.callFunc("openVideoMediaInfo")
            content = m.top.callFunc("getContentComponent")
            m.assertEqual(m.top.title, "Media Information")
            m.assertTrue(m.top.dialogWidth = 1200)
            m.assertTrue(m.top.dialogHeight = 940)
            m.assertEqual(content.subtype(), "VideoMediaInfoContent")
            m.assertEqual(content.item.Name, "Test Movie")
            m.assertTrue(content.isInFocusChain())
            m.assertTrue(m.top.findNode("dialog").visible)
        end function

        @it("updates metadata while open")
        function _()
            m.top.callFunc("openVideoMediaInfo")
            m.top.item = { Name: "Replacement" }
            content = m.top.callFunc("getContentComponent")
            m.assertEqual(content.sections[0].entries[0].value, "Replacement")
        end function

        @it("closes on Back through the shared event")
        function _()
            m.top.callFunc("openVideoMediaInfo")
            m.top.closeRequested = false
            'bs:disable-next-line 1140
            handled = onKeyEvent("back", true)
            m.assertTrue(handled)
            m.assertTrue(m.top.closeRequested)
            m.assertFalse(m.top.findNode("dialog").visible)
        end function

        @it("reopens with current metadata")
        function _()
            m.top.callFunc("closeDialog")
            m.top.item = { Name: "Next Movie" }
            m.top.callFunc("openVideoMediaInfo")
            content = m.top.callFunc("getContentComponent")
            m.assertEqual(content.item.Name, "Next Movie")
            m.assertTrue(content.isInFocusChain())
        end function


    end class

end namespace
