        @it("preserves resume progress when recovery is exhausted")
        function _()
            m.preparePrematureFinish(2160, 4370)
            m.node.recovery.originalMode = PlaybackMode.Mode.TranscodeNoRemux
            m.node.recovery.effectiveMode = PlaybackMode.Mode.TranscodeNoRemux
            m.node.recovery.sameModeRetryUsed = true
            m.stubCall(AppMessage.Show, m.captureRequestFailureMessage)

            'bs:disable-next-line 1140
            onVideoStateChanged()
            m.node.videoPlayer.position = 0
            m.node.videoPlayer.state = "stopped"
            'bs:disable-next-line 1140
            onVideoPositionChanged()
            'bs:disable-next-line 1140
            onVideoStateChanged()

            m.assertEqual(m.node.playstateTask.request.position, 2160.0)
            m.assertEqual(m.node.activePlayback.context.item.UserData.PlaybackPositionTicks, 21600000000&)
            m.assertFalse(m.top.playbackProgressChanged.isFinished)
            m.assertTrue(m.top.playbackFailed <> "")
            m.assertInvalid(m.top.upNextRequested)
        end function

        @it("allows normal completion at the thirty second tolerance boundary")
        function _()
            m.preparePrematureFinish(4340, 4370)

            'bs:disable-next-line 1140
            onVideoStateChanged()

            m.assertTrue(m.top.playbackProgressChanged.isFinished)
            m.assertEqual(m.node.playstateTask.request.position, 4370.0)
