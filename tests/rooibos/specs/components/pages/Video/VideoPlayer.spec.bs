        private function prepareActivityPlayback(state as string, previousState as string) as object
            collector = CreateObject("roSGNode", "LogService")
            m.node.log = new Logger("VideoPlayer", collector)
            item = { Id: "movie-1", Name: "Alien", Type: "Movie", UserData: {} }
            request = {
                itemId: "movie-1"
                item: item
                videoMode: PlaybackMode.Mode.Automatic
                subtitleBurnInMode: "Automatic"
                startPositionTicks: 0
            }
            m.node.activePlayback.request = request
            m.node.activePlayback.context.item = item
            m.node.activePlayback.playMethod = "Transcode"
            m.node.activePlayback.session.itemId = "movie-1"
            m.node.playbackDiagnostics.lastState = previousState
            m.node.videoPlayer = {
                state: state
                position: 10
                duration: 120
                control: ""
                seek: 0
                errorStr: ""
                bufferingStatus: { percentage: 0 }
            }
            return collector
        end function

        private function getActivityEntries(collector as object) as object
            activities = []
            for each entry in collector.callFunc("getSnapshot")
                if Instr(1, entry, "Activity:") > 0 then activities.Push(entry)
            end for
            return activities
        end function

        @describe("Media request authentication")

        @it("passes server subtitle URLs to content alongside the playback header")
        function _()
            playbackInfo = { MediaSources: [{ MediaStreams: [{ Type: "Subtitle", Index: 4, DeliveryMethod: "External", DeliveryUrl: "/sub.srt?ApiKey=server-token&x=a%26b#cue" }] }] }
            tracks = SubtitlePlayback.BuildExternalTracks(playbackInfo, "http://server/base")
            response = { streamUrl: "http://server/master.m3u8?ApiKey=server-token", streamFormat: "hls", subtitleDeliveryMethod: "external", externalSubtitleTracks: tracks, externalSubtitleTrack: tracks[0] }
            request = { server: "http://server/base", token: "session-token", userId: "user" }

            'bs:disable-next-line 1140
            content = buildVideoContent(response, request, { Name: "Movie" }, 0)

            m.assertEqual(content.url, "http://server/master.m3u8?ApiKey=server-token")
            m.assertEqual(content.SubtitleTracks[0].TrackName, "http://server/base/sub.srt?ApiKey=server-token&x=a%26b#cue")
            m.assertEqual(m.node.streamOptions.pendingExternalSubtitleUrl, "http://server/base/sub.srt?ApiKey=server-token&x=a%26b#cue")
            m.assertEqual(content.HttpHeaders.Count(), 1)
            m.assertEqual(content.HttpHeaders, [TestMediaAuthentication.ExpectedHeader("session-token", "user")])
        end function

        @it("authenticates direct video without query credentials")
        function _()
            response = { streamUrl: "http://server/Videos/movie/stream?Static=true", streamFormat: "mp4", subtitleDeliveryMethod: "none" }
            request = { server: "http://server", token: "fresh", userId: "user" }

            'bs:disable-next-line 1140
            content = buildVideoContent(response, request, { Name: "Movie" }, 12)

            m.assertEqual(content.url, "http://server/Videos/movie/stream?Static=true")
            m.assertEqual(content.HttpHeaders.Count(), 1)
            m.assertTrue(content.PlayStart = 12)
            m.assertEqual(content.HttpHeaders, [TestMediaAuthentication.ExpectedHeader("fresh", "user")])
        end function

        @it("preserves the supplied HLS URL and attaches the session header")
        function _()
            response = { streamUrl: "http://server/master.m3u8?ApiKey=server-token#f", streamFormat: "hls", subtitleDeliveryMethod: "none" }
            request = { server: "http://server", token: "fresh", userId: "user" }

            'bs:disable-next-line 1140
            content = buildVideoContent(response, request, { Name: "Movie" }, 12)

            m.assertEqual(content.url, "http://server/master.m3u8?ApiKey=server-token#f")
            m.assertEqual(content.HttpHeaders.Count(), 1)
            m.assertTrue(content.PlayStart = 12)
            m.assertEqual(content.HttpHeaders, [TestMediaAuthentication.ExpectedHeader("fresh", "user")])
        end function

        @it("does not send session credentials to external Live TV")
        function _()
            response = { streamUrl: "https://tuner.test/live?signature=provider", streamFormat: "hls", subtitleDeliveryMethod: "none" }
            request = { server: "http://server", token: "fresh", userId: "user" }

            'bs:disable-next-line 1140
            content = buildVideoContent(response, request, { Name: "Movie" }, 12)

            m.assertEqual(content.url, "https://tuner.test/live?signature=provider")
            m.assertEqual(content.HttpHeaders.Count(), 0)
            m.assertTrue(content.PlayStart = 12)
        end function

        @it("successive external video content replaces previous authentication")
        function _()
            request = { server: "http://server", token: "fresh", userId: "user" }
            response = { streamUrl: "http://server/stream", streamFormat: "hls", subtitleDeliveryMethod: "none" }
            'bs:disable-next-line 1140
            first = buildVideoContent(response, request, { Name: "Movie" }, 0)
            m.assertEqual(first.HttpHeaders, [TestMediaAuthentication.ExpectedHeader("fresh", "user")])
            request.token = "fresh"
            response.streamUrl = "https://tuner.test/stream?ApiKey=provider"
            'bs:disable-next-line 1140
            second = buildVideoContent(response, request, { Name: "Movie" }, 0)
            m.assertEqual(second.url, "https://tuner.test/stream?ApiKey=provider")
            m.assertEqual(second.HttpHeaders, [])
        end function

        @it("successive missing-token video content replaces previous authentication")
        function _()
            request = { server: "http://server", token: "fresh", userId: "user" }
            response = { streamUrl: "http://server/stream", streamFormat: "hls", subtitleDeliveryMethod: "none" }
            'bs:disable-next-line 1140
            first = buildVideoContent(response, request, { Name: "Movie" }, 0)
            m.assertEqual(first.HttpHeaders, [TestMediaAuthentication.ExpectedHeader("fresh", "user")])
            request.token = ""
            response.streamUrl = "http://server/stream"
            'bs:disable-next-line 1140
            second = buildVideoContent(response, request, { Name: "Movie" }, 0)
            m.assertEqual(second.url, "http://server/stream")
            m.assertEqual(second.HttpHeaders, [])
        end function

        @it("successive new-session video content replaces previous authentication")
        function _()
            request = { server: "http://server", token: "fresh", userId: "user" }
            response = { streamUrl: "http://server/stream", streamFormat: "hls", subtitleDeliveryMethod: "none" }
            'bs:disable-next-line 1140
            first = buildVideoContent(response, request, { Name: "Movie" }, 0)
            m.assertEqual(first.HttpHeaders, [TestMediaAuthentication.ExpectedHeader("fresh", "user")])
            request.token = "replacement"
            response.streamUrl = "http://server/stream"
            'bs:disable-next-line 1140
            second = buildVideoContent(response, request, { Name: "Movie" }, 0)
            m.assertEqual(second.url, "http://server/stream")
            m.assertEqual(second.HttpHeaders, [TestMediaAuthentication.ExpectedHeader("replacement", "user")])
        end function

        @it("displays the request failure after playback recovery is exhausted")
        function _()
            getGlobalAa().requestFailureMessage = ""
            m.stubCall(AppMessage.Show, m.captureRequestFailureMessage)
            m.node.playback.requestId = 6
            m.node.pendingPlaybackRequest = { requestId: 6, itemId: "failed-item" }
            m.node.recovery.originalMode = PlaybackMode.Mode.TranscodeNoRemux
            m.node.recovery.effectiveMode = PlaybackMode.Mode.TranscodeNoRemux
            m.node.recovery.sameModeRetryUsed = true
            m.node.playbackInfoTask = { response: { ok: false, requestId: 6, status: 403, failureKind: "accessDenied", errorMessage: "Forbidden" } }

            'bs:disable-next-line 1140
            onPlaybackInfoResponse()

            m.assertEqual(m.top.playbackFailed, "Unable to play this item. The server denied access.")
            m.assertEqual(getGlobalAa().requestFailureMessage, m.top.playbackFailed)
        end function

        private sub captureRequestFailureMessage(message as string)
            getGlobalAa().requestFailureMessage = message
        end sub

        @describe("combined media options commit")

        @it("pauses when opening and supplies source options and playback diagnostics")
        function _()
            m.prepareOptions({})
            m.node.mediaOptions.pendingCommit = invalid
            m.node.playback.startupPending = false
            m.node.streamOptions.audioStreams = []
            m.node.streamOptions.subtitleStreams = []
            'bs:disable-next-line 1140
            onMediaOptionsPressed()

            m.assertEqual(m.node.videoPlayer.control, "pause")
            m.assertEqual(m.top.overlayRequested.id, "mediaOptions")
            m.assertEqual(m.top.overlayRequested.optionsContext.playbackInfo.itemId, "movie-1")
            m.assertTrue(m.node.mediaOptions.session.wasPlaying)
        end function

        @it("combines all selections into one correlated restart")
        function _()
            m.prepareOptions({ videoMode: "transcode-no-remux", audioStreamIndex: 3, subtitleStreamIndex: -1, chapter: { startPositionTicks: 600000000, startPositionSeconds: 60 } })
            previousRequestId = m.node.playback.requestId
            'bs:disable-next-line 1140
            onMediaOptionsApplyTimerFire()

            m.assertEqual(m.node.playback.requestId, previousRequestId + 1)
            m.assertEqual(m.top.playRequest.videoMode, "transcode-no-remux")
            m.assertEqual(m.top.playRequest.audioStreamIndex, 3)
            m.assertEqual(m.top.playRequest.subtitleStreamIndex, -1)
            m.assertTrue(m.top.playRequest.startPositionTicks = 600000000)
        end function

