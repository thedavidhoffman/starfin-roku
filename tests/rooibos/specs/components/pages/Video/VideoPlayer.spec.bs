        private function prepareActivityPlayback(state as string, previousState as string) as object
            collector = CreateObject("roSGNode", "LogService")
            m.node.log = new Logger("VideoPlayer", collector)
            item = { Id: "movie-1", Name: "Alien", Type: "Movie", UserData: {} }
            request = {
                itemId: "movie-1"
                item: item
                videoMode: PlaybackMode.Mode.Automatic
                subtitleBurnInMode: "Automatic"
                startPositionTicks: 0
            }
            m.node.activePlayback.request = request
            m.node.activePlayback.context.item = item
            m.node.activePlayback.playMethod = "Transcode"
            m.node.activePlayback.session.itemId = "movie-1"
            m.node.playbackDiagnostics.lastState = previousState
            m.node.videoPlayer = {
                state: state
                position: 10
                duration: 120
                control: ""
                seek: 0
                errorStr: ""
                bufferingStatus: { percentage: 0 }
            }
            return collector
        end function

        private function getActivityEntries(collector as object) as object
            activities = []
            for each entry in collector.callFunc("getSnapshot")
                if Instr(1, entry, "Activity:") > 0 then activities.Push(entry)
            end for
            return activities
        end function

        @describe("Premature completion")

        @it("recovers a halfway ending without completing or advancing the episode")
        function _()
            m.preparePrematureFinish(2160, 4370)
            m.node.activePlayback.queue.items = [{ itemId: "movie-1", item: m.node.activePlayback.context.item }, { itemId: "episode-2", item: { Id: "episode-2", Type: "Episode" } }]
            m.node.activePlayback.queue.index = 0

            'bs:disable-next-line 1140
            onVideoStateChanged()

            m.assertEqual(m.node.playstateTask.request.status, "stop")
            m.assertEqual(m.node.playstateTask.request.position, 2160.0)
            m.assertEqual(m.top.playRequest.startPositionTicks, 21600000000&)
            m.assertFalse(m.top.playbackProgressChanged.isFinished)
            m.assertEqual(m.top.playbackProgressChanged.positionTicks, 21600000000&)
            m.assertFalse(m.node.activePlayback.context.item.UserData.Played)
            m.assertInvalid(m.top.upNextRequested)
            m.assertFalse(m.top.closeRequested)
        end function

        @it("still opens Up Next after a genuine ending")
        function _()
            m.preparePrematureFinish(4370, 4370)
            m.node.activePlayback.queue.items = [{ itemId: "movie-1", item: m.node.activePlayback.context.item }, { itemId: "episode-2", item: { Id: "episode-2", Type: "Episode" } }]
            m.node.activePlayback.queue.index = 0

            'bs:disable-next-line 1140
            onVideoStateChanged()

            m.assertTrue(m.top.playbackProgressChanged.isFinished)
            m.assertEqual(m.top.upNextRequested.nextItem.itemId, "episode-2")
            m.assertTrue(m.top.closeRequested)
        end function

        @it("recovers from a restored start before any playing position arrives")
        function _()
            m.preparePrematureFinish(0, 4370)
            'bs:disable-next-line 1140
            resetPlaybackForStart(m.node.activePlayback.context.item, 2160)
            m.node.playback.hasReportedStart = false

            'bs:disable-next-line 1140
            onVideoStateChanged()

            m.assertEqual(m.top.playRequest.startPositionTicks, 21600000000&)
            m.assertFalse(m.top.playbackProgressChanged.isFinished)
            m.assertInvalid(m.node.playstateTask.request)
        end function

        @it("uses metadata even when the stream reports a truncated duration")
