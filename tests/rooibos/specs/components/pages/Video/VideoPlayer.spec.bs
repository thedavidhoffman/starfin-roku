        private sub prepareRecoveryTransition()
            m.preparePrematureFinish(2200, 4370)
            m.node.activePlayback.request.server = "http://server"
            m.node.activePlayback.request.token = "token"
            m.node.activePlayback.request.userId = "user"
            m.node.videoPlayer.state = "error"
            m.node.videoPlayer.errorStr = "buffer loop exception"
            m.node.recovery.originalMode = PlaybackMode.Mode.Automatic
            m.node.recovery.effectiveMode = PlaybackMode.Mode.TranscodeAllowRemux
            m.node.recovery.sameModeRetryUsed = true
            m.node.playbackInfoTask = { control: "", request: invalid, response: invalid }
            'bs:disable-next-line 1140
            onVideoStateChanged()
        end sub

        private sub acceptRecoveryContent()
            request = m.node.pendingPlaybackRequest
            m.node.playbackInfoTask.response = { ok: true, requestId: request.requestId, item: request.item, playSessionId: "recovered-session", startPositionTicks: 22000000000&, streamUrl: "http://server/video.m3u8", streamFormat: "hls", audioStreamIndex: 1, subtitleStreamIndex: -1, subtitleDeliveryMethod: "none" }
            'bs:disable-next-line 1140
            onPlaybackInfoResponse()
        end sub

        private sub preparePrematureFinish(position as float, runtime as float)
            m.prepareActivityPlayback("finished", "playing")
            m.top.unobserveField("playRequest")
            m.top.playRequest = invalid
            m.top.upNextRequested = invalid
            m.top.playbackFailed = ""
            m.top.playbackProgressChanged = invalid
            m.node.activePlayback.context.item.Type = "Episode"
            m.node.activePlayback.context.item.RunTimeTicks = runtime * 10000000.0
            m.node.playback.duration = runtime
            m.node.playback.position = position
            m.node.playback.prematureFinish = false
            m.node.videoPlayer.position = 0
            m.node.recovery.lastSafePosition = position
            m.node.recovery.sameModeRetryUsed = false
            m.node.pendingPlaybackRequest = invalid
        end sub

        @describe("Media request authentication")

        @it("passes server subtitle URLs to content alongside the playback header")
        function _()
            playbackInfo = { MediaSources: [{ MediaStreams: [{ Type: "Subtitle", Index: 4, DeliveryMethod: "External", DeliveryUrl: "/sub.srt?ApiKey=server-token&x=a%26b#cue" }] }] }
            tracks = SubtitlePlayback.BuildExternalTracks(playbackInfo, "http://server/base")
            response = { streamUrl: "http://server/master.m3u8?ApiKey=server-token", streamFormat: "hls", subtitleDeliveryMethod: "external", externalSubtitleTracks: tracks, externalSubtitleTrack: tracks[0] }
            request = { server: "http://server/base", token: "session-token", userId: "user" }

            'bs:disable-next-line 1140
            content = buildVideoContent(response, request, { Name: "Movie" }, 0)

            m.assertEqual(content.url, "http://server/master.m3u8?ApiKey=server-token")
            m.assertEqual(content.SubtitleTracks[0].TrackName, "http://server/base/sub.srt?ApiKey=server-token&x=a%26b#cue")
            m.assertEqual(m.node.streamOptions.pendingExternalSubtitleUrl, "http://server/base/sub.srt?ApiKey=server-token&x=a%26b#cue")
            m.assertEqual(content.HttpHeaders.Count(), 1)
            m.assertEqual(content.HttpHeaders, [TestMediaAuthentication.ExpectedHeader("session-token", "user")])
        end function

        @it("authenticates direct video without query credentials")
        function _()
            response = { streamUrl: "http://server/Videos/movie/stream?Static=true", streamFormat: "mp4", subtitleDeliveryMethod: "none" }
            request = { server: "http://server", token: "fresh", userId: "user" }

            'bs:disable-next-line 1140
            content = buildVideoContent(response, request, { Name: "Movie" }, 12)

            m.assertEqual(content.url, "http://server/Videos/movie/stream?Static=true")
            m.assertEqual(content.HttpHeaders.Count(), 1)
            m.assertTrue(content.PlayStart = 12)
            m.assertEqual(content.HttpHeaders, [TestMediaAuthentication.ExpectedHeader("fresh", "user")])
        end function

        @it("preserves the supplied HLS URL and attaches the session header")
        function _()
            response = { streamUrl: "http://server/master.m3u8?ApiKey=server-token#f", streamFormat: "hls", subtitleDeliveryMethod: "none" }
            request = { server: "http://server", token: "fresh", userId: "user" }

            'bs:disable-next-line 1140
            content = buildVideoContent(response, request, { Name: "Movie" }, 12)

            m.assertEqual(content.url, "http://server/master.m3u8?ApiKey=server-token#f")
            m.assertEqual(content.HttpHeaders.Count(), 1)
            m.assertTrue(content.PlayStart = 12)
            m.assertEqual(content.HttpHeaders, [TestMediaAuthentication.ExpectedHeader("fresh", "user")])
        end function

        @it("does not send session credentials to external Live TV")
        function _()
            response = { streamUrl: "https://tuner.test/live?signature=provider", streamFormat: "hls", subtitleDeliveryMethod: "none" }
            request = { server: "http://server", token: "fresh", userId: "user" }

            'bs:disable-next-line 1140
            content = buildVideoContent(response, request, { Name: "Movie" }, 12)

            m.assertEqual(content.url, "https://tuner.test/live?signature=provider")
            m.assertEqual(content.HttpHeaders.Count(), 0)
            m.assertTrue(content.PlayStart = 12)
        end function

        @it("successive external video content replaces previous authentication")
        function _()
            request = { server: "http://server", token: "fresh", userId: "user" }
            response = { streamUrl: "http://server/stream", streamFormat: "hls", subtitleDeliveryMethod: "none" }
            'bs:disable-next-line 1140
            first = buildVideoContent(response, request, { Name: "Movie" }, 0)
            m.assertEqual(first.HttpHeaders, [TestMediaAuthentication.ExpectedHeader("fresh", "user")])
            request.token = "fresh"
            response.streamUrl = "https://tuner.test/stream?ApiKey=provider"
            'bs:disable-next-line 1140
            second = buildVideoContent(response, request, { Name: "Movie" }, 0)
            m.assertEqual(second.url, "https://tuner.test/stream?ApiKey=provider")
            m.assertEqual(second.HttpHeaders, [])
        end function

        @it("successive missing-token video content replaces previous authentication")
        function _()
            request = { server: "http://server", token: "fresh", userId: "user" }
            response = { streamUrl: "http://server/stream", streamFormat: "hls", subtitleDeliveryMethod: "none" }
            'bs:disable-next-line 1140
            first = buildVideoContent(response, request, { Name: "Movie" }, 0)
            m.assertEqual(first.HttpHeaders, [TestMediaAuthentication.ExpectedHeader("fresh", "user")])
            request.token = ""
            response.streamUrl = "http://server/stream"
            'bs:disable-next-line 1140
            second = buildVideoContent(response, request, { Name: "Movie" }, 0)
            m.assertEqual(second.url, "http://server/stream")
            m.assertEqual(second.HttpHeaders, [])
        end function

        @it("successive new-session video content replaces previous authentication")
        function _()
            request = { server: "http://server", token: "fresh", userId: "user" }
            response = { streamUrl: "http://server/stream", streamFormat: "hls", subtitleDeliveryMethod: "none" }
            'bs:disable-next-line 1140
            first = buildVideoContent(response, request, { Name: "Movie" }, 0)
            m.assertEqual(first.HttpHeaders, [TestMediaAuthentication.ExpectedHeader("fresh", "user")])
            request.token = "replacement"
            response.streamUrl = "http://server/stream"
            'bs:disable-next-line 1140
            second = buildVideoContent(response, request, { Name: "Movie" }, 0)
            m.assertEqual(second.url, "http://server/stream")
            m.assertEqual(second.HttpHeaders, [TestMediaAuthentication.ExpectedHeader("replacement", "user")])
        end function

        @it("displays the request failure after playback recovery is exhausted")
        function _()
            m.node.playback.phase = "resolving"
            getGlobalAa().requestFailureMessage = ""
            m.stubCall(AppMessage.Show, m.captureRequestFailureMessage)
            m.node.playback.requestId = 6
            m.node.pendingPlaybackRequest = { requestId: 6, itemId: "failed-item" }
            m.node.recovery.originalMode = PlaybackMode.Mode.TranscodeNoRemux
            m.node.recovery.effectiveMode = PlaybackMode.Mode.TranscodeNoRemux
            m.node.recovery.sameModeRetryUsed = true
            m.node.playbackInfoTask = { response: { ok: false, requestId: 6, status: 403, failureKind: "accessDenied", errorMessage: "Forbidden" } }

            'bs:disable-next-line 1140
            onPlaybackInfoResponse()

            m.assertEqual(m.top.playbackFailed, "Unable to play this item. The server denied access.")
            m.assertEqual(getGlobalAa().requestFailureMessage, m.top.playbackFailed)
        end function

        private sub captureRequestFailureMessage(message as string)
            getGlobalAa().requestFailureMessage = message
        end sub

        @describe("combined media options commit")

        @it("pauses when opening and supplies source options and playback diagnostics")
        function _()
            m.prepareOptions({})
            m.node.mediaOptions.pendingCommit = invalid
            m.node.playback.startupPending = false
            m.node.streamOptions.audioStreams = []
            m.node.streamOptions.subtitleStreams = []
            'bs:disable-next-line 1140
            onMediaOptionsPressed()

            m.assertEqual(m.node.videoPlayer.control, "pause")
            m.assertEqual(m.top.overlayRequested.id, "mediaOptions")
            m.assertEqual(m.top.overlayRequested.optionsContext.playbackInfo.itemId, "movie-1")
            m.assertTrue(m.node.mediaOptions.session.wasPlaying)
        end function

        @it("combines all selections into one correlated restart")
        function _()
            m.prepareOptions({ videoMode: "transcode-no-remux", audioStreamIndex: 3, subtitleStreamIndex: -1, chapter: { startPositionTicks: 600000000, startPositionSeconds: 60 } })
            previousRequestId = m.node.playback.requestId
            'bs:disable-next-line 1140
            onMediaOptionsApplyTimerFire()

            m.assertEqual(m.node.playback.requestId, previousRequestId + 1)
            m.assertEqual(m.top.playRequest.videoMode, "transcode-no-remux")
            m.assertEqual(m.top.playRequest.audioStreamIndex, 3)
            m.assertEqual(m.top.playRequest.subtitleStreamIndex, -1)
            m.assertTrue(m.top.playRequest.startPositionTicks = 600000000)
        end function

        @it("does not publish requested audio before a response is accepted")
        function _()
            m.prepareOptions({ audioStreamIndex: 3 })
            'bs:disable-next-line 1140
            onMediaOptionsApplyTimerFire()

            m.assertEqual(m.node.activePlayback.audioStreamIndex, 1)
            m.assertEqual(m.node.activePlayback.request.audioStreamIndex, 1)
        end function

        @it("preserves the captured position without a chapter selection")
        function _()
            m.prepareOptions({ audioStreamIndex: 3 })
            'bs:disable-next-line 1140
            onMediaOptionsApplyTimerFire()

            m.assertTrue(m.top.playRequest.startPositionTicks = 100000000)
        end function

        @it("requests paused startup when options were opened while paused")
        function _()
            m.prepareOptions({ audioStreamIndex: 3 }, false)
            'bs:disable-next-line 1140
            onMediaOptionsApplyTimerFire()

            m.assertTrue(m.top.playRequest.startPaused)
        end function

        @it("resumes unchanged playback without a restart")
        function _()
            m.prepareOptions({})
            previousRequestId = m.node.playback.requestId
            'bs:disable-next-line 1140
            onMediaOptionsApplyTimerFire()

            m.assertEqual(m.node.videoPlayer.control, "resume")
            m.assertEqual(m.node.playback.requestId, previousRequestId)
            m.assertTrue(m.top.findNode("playbackControls").findNode("mediaOptionsButton").hasFocus())
        end function

        @it("keeps unchanged paused playback paused")
        function _()
            m.prepareOptions({}, false)
            'bs:disable-next-line 1140
            onMediaOptionsApplyTimerFire()

            m.assertEqual(m.node.videoPlayer.control, "pause")
        end function

        @it("seeks a chapter locally without a restart")
        function _()
            m.prepareOptions({ chapter: { label: "Next", startPositionTicks: 600000000, startPositionSeconds: 60 } })
            previousRequestId = m.node.playback.requestId
            'bs:disable-next-line 1140
            onMediaOptionsApplyTimerFire()

            m.assertTrue(m.node.videoPlayer.seek = 60)
            m.assertEqual(m.node.playback.requestId, previousRequestId)
            m.assertEqual(m.node.videoPlayer.control, "resume")
        end function

        @it("turns off external subtitles locally and commits accepted state")
        function _()
            m.prepareOptions({ subtitleStreamIndex: -1 })
            previousRequestId = m.node.playback.requestId
            'bs:disable-next-line 1140
            onMediaOptionsApplyTimerFire()

            m.assertEqual(m.node.activePlayback.subtitleStreamIndex, -1)
            m.assertEqual(m.node.activePlayback.request.subtitleStreamIndex, -1)
            m.assertEqual(m.node.pendingPlaybackRequest.subtitleStreamIndex, -1)
            m.assertEqual(m.node.videoPlayer.globalCaptionMode, "Off")
            m.assertEqual(m.node.playback.requestId, previousRequestId)
        end function

        @it("restarts to remove burned-in subtitles")
        function _()
            m.prepareOptions({ subtitleStreamIndex: -1 })
            m.node.streamOptions.activeSubtitleDeliveryMethod = "encode"
            previousRequestId = m.node.playback.requestId
            'bs:disable-next-line 1140
            onMediaOptionsApplyTimerFire()

            m.assertEqual(m.node.playback.requestId, previousRequestId + 1)
            m.assertEqual(m.top.playRequest.subtitleStreamIndex, -1)
        end function

        @it("switches external subtitles with the unchanged server delivery URL")
        function _()
            m.prepareOptions({ subtitleStreamIndex: 4 })
            playbackInfo = { MediaSources: [{ MediaStreams: [{ Type: "Subtitle", Index: 4, DeliveryMethod: "External", DeliveryUrl: "/sub.srt?ApiKey=server-token#cue" }] }] }
            m.node.streamOptions.externalSubtitleTracks = SubtitlePlayback.BuildExternalTracks(playbackInfo, "http://server")
            m.node.videoPlayer.availableSubtitleTracks = [{ TrackName: "#EXT-X-MEDIA:http://server/sub.srt?ApiKey=server-token#cue" }]
            previousRequestId = m.node.playback.requestId
            'bs:disable-next-line 1140
            onMediaOptionsApplyTimerFire()

            m.assertEqual(m.node.videoPlayer.subtitleTrack, "#EXT-X-MEDIA:http://server/sub.srt?ApiKey=server-token#cue")
            m.assertEqual(m.node.videoPlayer.globalCaptionMode, "On")
            m.assertEqual(m.node.activePlayback.request.subtitleStreamIndex, 4)
            m.assertEqual(m.node.playback.requestId, previousRequestId)
        end function

        @it("rejects an older playback generation")
        function _()
            m.prepareOptions({ audioStreamIndex: 3 })
            m.node.playback.requestId += 1
            previousRequestId = m.node.playback.requestId
            'bs:disable-next-line 1140
            onMediaOptionsApplyTimerFire()

            m.assertEqual(m.node.playback.requestId, previousRequestId)
            m.assertEqual(m.node.videoPlayer.control, "")
        end function

        @it("ignores a repeated commit timer")
        function _()
            m.prepareOptions({ audioStreamIndex: 3 })
            'bs:disable-next-line 1140
            onMediaOptionsApplyTimerFire()
            previousRequestId = m.node.playback.requestId
            'bs:disable-next-line 1140
            onMediaOptionsApplyTimerFire()

            m.assertEqual(m.node.playback.requestId, previousRequestId)
        end function

        @it("discards pending changes during teardown")
        function _()
            m.prepareOptions({ audioStreamIndex: 3 })
            m.top.callFunc("stopForRemoval")

            m.assertInvalid(m.node.mediaOptions.pendingCommit)
            m.assertInvalid(m.node.mediaOptions.session)
            m.assertEqual(m.node.mediaOptionsApplyTimer.control, "stop")
        end function

        @it("ignores changes when the active session is unavailable")
        function _()
            m.prepareOptions({ audioStreamIndex: 3 })
            m.node.activePlayback = invalid
            previousRequestId = m.node.playback.requestId
            'bs:disable-next-line 1140
            onMediaOptionsApplyTimerFire()

            m.assertEqual(m.node.playback.requestId, previousRequestId)
        end function

        @it("preserves paused startup and focus through recovery after resolution")
        function _()
            m.prepareOptions({}, false)
            request = PlaybackRequest.WithChanges(m.node.activePlayback.request, { requestId: m.node.playback.requestId, server: "http://server", token: "token", userId: "user", item: { Id: "movie-1", Type: "Movie", RunTimeTicks: 1200000000 }, videoMode: "automatic", startPaused: true, restoreMediaOptionsFocus: true })
            response = { requestId: request.requestId, item: request.item, startPositionTicks: 0, streamUrl: "http://server/video.mp4", streamFormat: "mp4", audioStreamIndex: 3, subtitleStreamIndex: -1, subtitleDeliveryMethod: "none" }
            m.node.pendingPlaybackRequest = request
            'bs:disable-next-line 1140
            applyPlaybackResponse(response, request)
            m.node.recovery.originalMode = PlaybackMode.Mode.Automatic
            m.node.recovery.effectiveMode = PlaybackMode.Mode.Automatic
            m.node.recovery.sameModeRetryUsed = false

            'bs:disable-next-line 1140
            handled = handlePlaybackRecoveryFailure("videoError", "Startup failed")

            m.assertTrue(handled)
            m.assertTrue(m.top.playRequest.startPaused)
            m.assertTrue(m.top.playRequest.restoreMediaOptionsFocus)
            m.assertEqual(m.top.playRequest.audioStreamIndex, 3)
            m.assertEqual(m.top.playRequest.subtitleStreamIndex, -1)

            recovered = m.node.pendingPlaybackRequest
            response.requestId = recovered.requestId
            'bs:disable-next-line 1140
            applyPlaybackResponse(response, recovered)
            'bs:disable-next-line 1140
            restorePlaybackStartupState()

            m.assertEqual(m.node.videoPlayer.control, "pause")
            m.assertTrue(m.top.findNode("playbackControls").findNode("mediaOptionsButton").hasFocus())
            m.assertFalse(m.node.activePlayback.request.startPaused)
            m.assertFalse(m.node.pendingPlaybackRequest.restoreMediaOptionsFocus)
        end function

        @it("does not reapply startup pause after it has been consumed")
        function _()
            m.prepareOptions({})
            m.node.activePlayback.request.startPaused = true
            'bs:disable-next-line 1140
            restorePlaybackStartupState()
            m.node.videoPlayer.control = "resume"

            'bs:disable-next-line 1140
            restorePlaybackStartupState()

            m.assertEqual(m.node.videoPlayer.control, "resume")
        end function

        @it("does not let a repeated subtitle notification undo Off")
        function _()
            m.prepareOptions({ subtitleStreamIndex: -1 })
            m.node.streamOptions.pendingExternalSubtitleUrl = "http://server/old.srt"
            m.node.videoPlayer.availableSubtitleTracks = [{ TrackName: "http://server/old.srt" }]
            'bs:disable-next-line 1140
            onMediaOptionsApplyTimerFire()

            'bs:disable-next-line 1140
            onAvailableSubtitleTracksChanged()

            m.assertEqual(m.node.videoPlayer.globalCaptionMode, "Off")
            m.assertEqual(m.node.videoPlayer.subtitleTrack, "")
            m.assertEqual(m.node.streamOptions.pendingExternalSubtitleUrl, "")
        end function

        @it("does not let a repeated subtitle notification undo a newer track")
        function _()
            m.prepareOptions({ subtitleStreamIndex: 4 })
            m.node.streamOptions.pendingExternalSubtitleUrl = "http://server/old.srt"
            m.node.streamOptions.externalSubtitleTracks = [{ index: 4, deliveryUrl: "http://server/new.srt" }]
            m.node.videoPlayer.availableSubtitleTracks = [{ TrackName: "http://server/old.srt" }, { TrackName: "http://server/new.srt" }]
            'bs:disable-next-line 1140
            onMediaOptionsApplyTimerFire()

            'bs:disable-next-line 1140
            onAvailableSubtitleTracksChanged()

            m.assertEqual(m.node.videoPlayer.subtitleTrack, "http://server/new.srt")
            m.assertEqual(m.node.activePlayback.subtitleStreamIndex, 4)
        end function

        @it("consumes deferred subtitle application once its track becomes available")
        function _()
            m.prepareOptions({})
            m.node.streamOptions.pendingExternalSubtitleUrl = "http://server/old.srt"
            m.node.videoPlayer.availableSubtitleTracks = []
            'bs:disable-next-line 1140
            onAvailableSubtitleTracksChanged()
            m.assertEqual(m.node.streamOptions.pendingExternalSubtitleUrl, "http://server/old.srt")

            m.node.videoPlayer.availableSubtitleTracks = [{ TrackName: "http://server/old.srt" }]
            'bs:disable-next-line 1140
            onAvailableSubtitleTracksChanged()

            m.assertEqual(m.node.videoPlayer.subtitleTrack, "http://server/old.srt")
            m.assertEqual(m.node.streamOptions.pendingExternalSubtitleUrl, "")
        end function

        private sub prepareOptions(changes as object, wasPlaying = true as boolean)
            m.prepareActivityPlayback("playing", "playing")
            m.node.activePlayback.itemId = "movie-1"
            m.node.activePlayback.requestId = m.node.playback.requestId
            m.node.activePlayback.audioStreamIndex = 1
            m.node.activePlayback.subtitleStreamIndex = 2
            m.node.activePlayback.request.audioStreamIndex = 1
            m.node.activePlayback.request.subtitleStreamIndex = 2
            m.node.streamOptions.activeSubtitleDeliveryMethod = "external"
            m.node.streamOptions.externalSubtitleTracks = []
            m.node.videoPlayer.availableSubtitleTracks = []
            m.node.playback.duration = 120
            m.node.playback.position = 10
            m.node.playbackInfoTask = { request: invalid, control: "" }
            m.node.mediaOptions.session = invalid
            m.node.mediaOptions.pendingCommit = {
                session: {
                    requestId: m.node.playback.requestId
                    itemId: "movie-1"
                    position: 10
                    wasPlaying: wasPlaying
                    context: { subtitleOptions: [{ value: { streamIndex: -1, label: "Off" } }, { value: { streamIndex: 4, label: "English" } }] }
                }
                changes: changes
            }
        end sub

        @it("clears a cancelled opening without committing or stealing focus")
        function _()
            m.prepareOptions({})
            session = m.node.mediaOptions.pendingCommit.session
            session.context.generation = 9
            m.node.mediaOptions.session = session
            m.node.mediaOptions.pendingCommit = invalid

            m.top.callFunc("handleStreamOptionsOverlayClosed", { request: { optionsContext: { generation: 9 } }, overlay: invalid, cancelled: true })

            m.assertInvalid(m.node.mediaOptions.session)
            m.assertInvalid(m.node.mediaOptions.pendingCommit)
            m.assertEqual(m.node.videoPlayer.control, "resume")
        end function

        @it("rejects an old dialog close without clearing the new opening")
        function _()
            m.prepareOptions({})
            session = m.node.mediaOptions.pendingCommit.session
            session.context.generation = 9
            m.node.mediaOptions.session = session
            m.node.mediaOptions.pendingCommit = invalid

            m.top.callFunc("handleStreamOptionsOverlayClosed", { request: { optionsContext: { generation: 8 } }, overlay: { result: { audioStreamIndex: 3 } } })

            m.assertNotInvalid(m.node.mediaOptions.session)
            m.assertInvalid(m.node.mediaOptions.pendingCommit)
        end function

    end class

end namespace
