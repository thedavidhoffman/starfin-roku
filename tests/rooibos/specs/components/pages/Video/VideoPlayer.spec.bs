import "pkg:/source/tests/source/MediaAuthentication.bs"
import "pkg:/source/Char.bs"

namespace tests

    @SGNode("VideoPlayer")
    @suite("VideoPlayer component")
    class VideoPlayerTests extends rooibos.BaseTestSuite

        protected override function beforeEach()
            m.node.playback.hasReportedStart = true
            m.node.playback.hasEmittedFinalProgress = false
            m.node.activePlayback = {
                request: { itemId: "movie-1" }
                context: { item: { Id: "movie-1" }, series: invalid, season: invalid }
                queue: { items: [], index: -1, mode: "sequential", scope: "" }
                session: {
                    server: "http://server"
                    token: "token"
                    itemId: "movie-1"
                }
                playSessionId: "old-session"
                mediaSourceId: "source-1"
                liveStreamId: ""
                playMethod: "Transcode"
                canSeek: true
            }
            m.node.playstateTask = { request: invalid, control: "" }
            m.top.closeRequested = false
            m.top.findNode("playbackControls").visible = false
            m.top.findNode("playbackActionButton").visible = false
            m.top.findNode("musicVideoIntroMetadata").visible = false
        end function

        @describe("Playback restoration")

        @it("returns the accepted active request before a newer pending request")
        function _()
            m.node.activePlayback.request = { itemId: "active-item" }
            m.node.pendingPlaybackRequest = { itemId: "pending-item" }

            'bs:disable-next-line 1140
            request = getRestorePlaybackRequest()

            m.assertEqual(request.itemId, "active-item")
        end function

        @it("returns the pending request when playback has not become active")
        function _()
            m.node.activePlayback = invalid
            m.node.pendingPlaybackRequest = { itemId: "pending-item" }

            'bs:disable-next-line 1140
            request = getRestorePlaybackRequest()

            m.assertEqual(request.itemId, "pending-item")
        end function

        @describe("Playback request correlation")

        @it("adds correlation to a pending snapshot without mutating the input request")
        function _()
            request = { itemId: "movie-2", item: { Id: "movie-2" } }
            m.top.playRequest = request

            'bs:disable-next-line 1140
            onPlayRequestChanged()

            m.assertInvalid(request.requestId)
            m.assertEqual(m.node.pendingPlaybackRequest.itemId, "movie-2")
            m.assertTrue(m.node.pendingPlaybackRequest.requestId > 0)
        end function

        @it("ignores a stale response without replacing active playback")
        function _()
            m.node.playback.requestId = 4
            m.node.activePlayback.request = { itemId: "active-item" }
            m.node.playbackInfoTask = { response: { ok: true, requestId: 3 } }

            'bs:disable-next-line 1140
            onPlaybackInfoResponse()

            m.assertEqual(m.node.activePlayback.request.itemId, "active-item")
        end function

        @it("constructs active playback from a matching request and response")
        function _()
            item = { Id: "movie-2", Type: "Movie", UserData: {} }
            request = {
                requestId: 5
                server: "http://server"
                token: "token"
                userId: "user"
                itemId: "movie-2"
                item: item
                playbackQueue: []
                playbackQueueIndex: -1
            }
            response = {
                requestId: 5
                item: item
                playSessionId: "session-2"
                mediaSourceId: "source-2"
                playMethod: "DirectPlay"
                canSeek: true
            }

            'bs:disable-next-line 1140
            applyPlaybackSessionState(response, request, item)

            m.assertEqual(m.node.activePlayback.requestId, 5)
            m.assertEqual(m.node.activePlayback.session.itemId, "movie-2")
            m.assertEqual(m.node.activePlayback.playSessionId, "session-2")
            m.assertEqual(m.node.activePlayback.mediaSourceId, "source-2")
        end function

        @it("preserves accepted playback when a matching response fails")
        function _()
            m.node.playback.requestId = 6
            m.node.pendingPlaybackRequest = { requestId: 6, itemId: "failed-item" }
            m.node.playbackInfoTask = { response: { ok: false, requestId: 6, errorMessage: "Failed" } }

            'bs:disable-next-line 1140
            onPlaybackInfoResponse()

            m.assertEqual(m.node.activePlayback.session.itemId, "movie-1")
            m.assertEqual(m.node.activePlayback.playSessionId, "old-session")
        end function

        @it("uses the accepted request for active playback readers")
        function _()
            m.node.activePlayback.request = { itemId: "active-item" }
            m.node.pendingPlaybackRequest = { itemId: "rejected-item" }

            'bs:disable-next-line 1140
            request = getAcceptedOrPendingPlaybackRequest()

            m.assertEqual(request.itemId, "active-item")
        end function

        @describe("Back navigation")

        @it("stops for controller removal without requesting navigation")
        function _()
            m.top.callFunc("stopForRemoval")

            m.assertEqual(m.top.findNode("videoPlayer").control, "stop")
            m.assertFalse(m.node.playback.hasReportedStart)
            m.assertFalse(m.top.closeRequested)
            m.assertEqual(m.node.playstateTask.request.status, "stop")
            m.assertEqual(m.node.playstateTask.request.itemId, "movie-1")
            m.assertEqual(m.node.playstateTask.control, "run")
        end function

        @it("stops and closes immediately without waiting for a stop response")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("back", true)

            m.assertTrue(handled)
            m.assertEqual(m.top.findNode("videoPlayer").control, "stop")
            m.assertFalse(m.node.playback.hasReportedStart)
            m.assertTrue(m.top.closeRequested)
            m.assertEqual(m.node.playstateTask.request.status, "stop")
            m.assertEqual(m.node.playstateTask.request.itemId, "movie-1")
            m.assertEqual(m.node.playstateTask.request.playSessionId, "old-session")
            m.assertEqual(m.node.playstateTask.request.mediaSourceId, "source-1")
            m.assertEqual(m.node.playstateTask.request.playMethod, "Transcode")
            m.assertTrue(m.node.playstateTask.request.canSeek)
            m.assertEqual(m.node.playstateTask.control, "run")
        end function

        @describe("Navigation suspension")

        @it("records that playing video should resume after navigation")
        function _()
            m.node.videoPlayer = { state: "playing", control: "" }

            m.top.callFunc("suspendForNavigation")

            m.assertTrue(m.node.overlay.resumeAfterNavigation)
            m.assertEqual(m.node.videoPlayer.control, "pause")
        end function

        @it("does not resume video that was already paused before navigation")
        function _()
            m.node.videoPlayer = { state: "paused", control: "" }

            m.top.callFunc("suspendForNavigation")

            m.assertFalse(m.node.overlay.resumeAfterNavigation)
            m.assertEqual(m.node.videoPlayer.control, "pause")
        end function

        @it("records cast visibility before navigation")
        function _()
            m.node.videoPlayer = { state: "playing", control: "" }
            m.node.overlay.area = "cast"

            m.top.callFunc("suspendForNavigation")

            m.assertTrue(m.node.overlay.restoreCastAfterNavigation)
        end function

        @it("resumes prior playback and clears navigation restoration flags")
        function _()
            m.node.videoPlayer = { state: "paused", control: "" }
            m.node.overlay.resumeAfterNavigation = true
            m.node.overlay.restoreCastAfterNavigation = false

            m.top.callFunc("restoreAfterNavigation")

            m.assertEqual(m.node.videoPlayer.control, "resume")
            m.assertFalse(m.node.overlay.resumeAfterNavigation)
            m.assertFalse(m.node.overlay.restoreCastAfterNavigation)
        end function

        @it("restores cast visibility after navigation")
        function _()
            m.node.videoPlayer = { state: "paused", control: "" }
            m.node.cast.hasItems = true
            m.node.overlay.resumeAfterNavigation = false
            m.node.overlay.restoreCastAfterNavigation = true

            m.top.callFunc("restoreAfterNavigation")

            m.assertTrue(m.node.cast.visible)
            m.assertEqual(m.node.overlay.area, "cast")
            m.assertFalse(m.node.overlay.restoreCastAfterNavigation)
        end function

        @describe("activity logging")

        @it("logs initial playback once across repeated playing notifications")
        function _()
            collector = m.prepareActivityPlayback("playing", "buffering")
            m.node.playback.hasReportedStart = false

            'bs:disable-next-line 1140
            onVideoStateChanged()
            'bs:disable-next-line 1140
            onVideoStateChanged()

            activities = m.getActivityEntries(collector)
            m.assertEqual(activities.Count(), 1)
            m.assertTrue(Instr(1, activities[0], "Playing " + Char.DoubleQuote + "Alien" + Char.DoubleQuote + " using Transcode") > 0)
        end function

        @it("logs pause, resume, and manual stop once per state transition")
        function _()
            collector = m.prepareActivityPlayback("paused", "playing")

            'bs:disable-next-line 1140
            onVideoStateChanged()
            'bs:disable-next-line 1140
            onVideoStateChanged()
            m.node.videoPlayer.state = "playing"
            'bs:disable-next-line 1140
            onVideoStateChanged()
            m.node.videoPlayer.state = "stopped"
            'bs:disable-next-line 1140
            onVideoStateChanged()

            activities = m.getActivityEntries(collector)
            m.assertEqual(activities.Count(), 3)
            m.assertTrue(Instr(1, activities[0], "Paused " + Char.DoubleQuote + "Alien" + Char.DoubleQuote) > 0)
            m.assertTrue(Instr(1, activities[1], "Resumed " + Char.DoubleQuote + "Alien" + Char.DoubleQuote) > 0)
            m.assertTrue(Instr(1, activities[2], "Stopped " + Char.DoubleQuote + "Alien" + Char.DoubleQuote) > 0)
        end function

        @it("logs a Back-key stop once through the subsequent stopped notification")
        function _()
