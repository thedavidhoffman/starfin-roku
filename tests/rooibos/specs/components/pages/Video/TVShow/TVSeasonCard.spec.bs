namespace tests

    @SGNode("TVSeasonCard")
    @suite("TVSeasonCard component")
    class TVSeasonCardTests extends rooibos.BaseTestSuite

        protected override function beforeEach()
            m.originalCountMode = m.global.showUnwatchedEpisodeCount
            m.global.showUnwatchedEpisodeCount = "off"
        end function

        protected override function afterEach()
            m.global.showUnwatchedEpisodeCount = m.originalCountMode
        end function

        @describe("fresh component observers")

        @it("renders content on a fresh component")
        function _()
            component = CreateObject("roSGNode", "TVSeasonCard")
            item = m.createSeason("Fresh season", "2024", 8, "")
            item.addFields({ posterLayout: true })
            item.raw = { UserData: { UnplayedItemCount: 0 } }

            component.itemContent = item

            m.assertEqual(component.findNode("title").text, "Fresh season")
            m.assertEqual(component.findNode("poster").width, 400.0)
            m.assertTrue(component.findNode("watchedIndicator").visible)
        end function

        @it("observes watched changes on a fresh component")
        function _()
            component = CreateObject("roSGNode", "TVSeasonCard")
            item = m.createSeason("Season 1", "2024", 8, "")
            item.raw = { UserData: { UnplayedItemCount: 2 } }
            component.itemContent = item

            item.raw = { UserData: { UnplayedItemCount: 0 } }

            m.assertTrue(component.findNode("watchedIndicator").visible)
        end function

        @describe("declarative component contract")

        @it("declares the seasonPosterMask node")
        function _()
            m.assertNotInvalid(m.top.findNode("seasonPosterMask"))
        end function

        @it("declares the placeholder node")
        function _()
            m.assertNotInvalid(m.top.findNode("placeholder"))
        end function

        @it("declares the poster node")
        function _()
            m.assertNotInvalid(m.top.findNode("poster"))
        end function

        @it("declares the watchedIndicator node")
        function _()
            m.assertNotInvalid(m.top.findNode("watchedIndicator"))
        end function

        @it("declares the title node")
        function _()
            m.assertNotInvalid(m.top.findNode("title"))
        end function

        @it("declares the year node")
        function _()
            m.assertNotInvalid(m.top.findNode("year"))
        end function

        @describe("season rendering")

        @it("renders the season title")
        function _()
            item = m.createSeason("Season 1", "2024", 8, "http://server/season.jpg")

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("title").text, "Season 1")
        end function

        @it("renders year and plural episode count")
        function _()
            item = m.createSeason("Season 1", "2024", 8, "")

            m.top.itemContent = item

            m.assertTrue(Instr(1, m.top.findNode("year").text, "2024") > 0)
            m.assertTrue(Instr(1, m.top.findNode("year").text, "8 eps.") > 0)
        end function

        @it("renders a singular episode count")
        function _()
            item = m.createSeason("Season 1", "", 1, "")

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("year").text, "1 ep.")
        end function

        @it("shows supplied poster artwork")
        function _()
            item = m.createSeason("Season 1", "", 1, "http://server/season.jpg")

            m.top.itemContent = item

            m.assertTrue(m.top.findNode("poster").visible)
            m.assertFalse(m.top.findNode("placeholder").visible)
            m.assertEqual(m.top.findNode("poster").uri, "http://server/season.jpg")
        end function

        @it("shows placeholder artwork when poster artwork is missing")
        function _()
            item = m.createSeason("Season 1", "", 1, "")

            m.top.itemContent = item

            m.assertFalse(m.top.findNode("poster").visible)
            m.assertTrue(m.top.findNode("placeholder").visible)
        end function

        @it("shows the watched indicator for a fully watched season")
        function _()
            item = m.createSeason("Season 1", "", 1, "")
            item.raw = { UserData: { UnplayedItemCount: 0 } }

            m.top.itemContent = item

            m.assertTrue(m.top.findNode("watchedIndicator").visible)
        end function

        @it("hides the watched indicator for an unfinished season")
        function _()
            item = m.createSeason("Season 1", "", 1, "")
            item.raw = { UserData: { UnplayedItemCount: 2 } }

            m.top.itemContent = item

            m.assertFalse(m.top.findNode("watchedIndicator").visible)
        end function

        @it("updates the watched badge on a same-season replacement in Poster mode")
        function _()
            original = m.createSeason("Season 1", "2024", 8, "")
            original.addFields({ posterLayout: false })
            original.raw = { UserData: { UnplayedItemCount: 2 } }
            m.top.itemContent = original
            replacement = m.createSeason("Season 1", "2024", 8, "")
            replacement.addFields({ posterLayout: true })
            replacement.raw = { UserData: { UnplayedItemCount: 2 } }
            m.top.itemContent = replacement

            replacement.raw = { UserData: { UnplayedItemCount: 0 } }

            m.assertTrue(m.top.findNode("watchedIndicator").visible)

            replacement.raw = { UserData: { UnplayedItemCount: 1 } }

            m.assertFalse(m.top.findNode("watchedIndicator").visible)
        end function

        @it("updates the watched badge on a same-season replacement in backdrop mode")
        function _()
            original = m.createSeason("Season 1", "2024", 8, "")
            original.addFields({ posterLayout: true })
            original.raw = { UserData: { UnplayedItemCount: 2 } }
            m.top.itemContent = original
            replacement = m.createSeason("Season 1", "2024", 8, "")
            replacement.addFields({ posterLayout: false })
            replacement.raw = { UserData: { UnplayedItemCount: 2 } }
            m.top.itemContent = replacement

            replacement.raw = { UserData: { UnplayedItemCount: 0 } }

            m.assertTrue(m.top.findNode("watchedIndicator").visible)

            replacement.raw = { UserData: { UnplayedItemCount: 1 } }

            m.assertFalse(m.top.findNode("watchedIndicator").visible)
        end function

        @it("clears the watched badge when season content is removed")
        function _()
            item = m.createSeason("Season 1", "2024", 8, "")
            item.raw = { UserData: { UnplayedItemCount: 0 } }
            m.top.itemContent = item

            m.top.itemContent = invalid
            item.raw = { UserData: { UnplayedItemCount: 1 } }

            m.assertFalse(m.top.findNode("watchedIndicator").visible)
            m.assertEqual(m.top.findNode("watchedIndicator").data, { eligible: false, isWatched: false, unplayedCount: -1, width: 42, height: 42 })
        end function

        function createSeason(title as string, year as string, episodeCount as integer, imageUrl as string) as object
            item = CreateObject("roSGNode", "ContentNode")
            item.addFields({ itemId: "season-1", seasonYear: year, episodeCount: episodeCount, raw: {} })
            item.title = title
            item.HDPosterUrl = imageUrl
            return item
        end function

        @it("uses the current watched indicator style")
        function _()
            originalStyle = m.global.watchedIndicatorStyle

            m.global.watchedIndicatorStyle = "high-contrast"

            m.assertEqual(m.top.findNode("watchedIndicator").findNode("watchedCheck").uri, "pkg:/images/icons/watched-check-high-contrast.png")
            m.global.watchedIndicatorStyle = originalStyle
        end function

        @describe("Poster presentation")

        @it("renders the large poster with its dedicated mask and metadata positions")
        function _()
            item = m.createSeason("Season 1", "2024", 8, "http://server/season.jpg")
            item.addFields({ posterLayout: true })

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("poster").width, 400.0)
            m.assertEqual(m.top.findNode("poster").height, 603.0)
            m.assertTrue(Instr(1, m.top.findNode("seasonPosterMask").maskUri, "/season-poster-large-mask.png") > 0)
            m.assertEqual(m.top.findNode("title").translation, [0.0, 618.0])
            m.assertEqual(m.top.findNode("year").translation, [0.0, 648.0])
            m.assertEqual(m.top.findNode("title").text, "Season 1")
        end function

        @it("uses a large placeholder when Poster artwork is missing")
        function _()
            item = m.createSeason("Season 1", "2024", 8, "")
            item.addFields({ posterLayout: true })

            m.top.itemContent = item

            m.assertTrue(m.top.findNode("placeholder").visible)
            m.assertFalse(m.top.findNode("poster").visible)
            m.assertEqual(m.top.findNode("placeholder").width, 400.0)
            m.assertEqual(m.top.findNode("placeholder").height, 603.0)
        end function

        @it("restores standard poster geometry when the card leaves Poster mode")
        function _()
            largeItem = m.createSeason("Season 1", "2024", 8, "http://server/season.jpg")
            largeItem.addFields({ posterLayout: true })
            m.top.itemContent = largeItem
            standardItem = m.createSeason("Season 1", "2024", 8, "http://server/season.jpg")
            standardItem.addFields({ posterLayout: false })

            m.top.itemContent = standardItem

            m.assertEqual(m.top.findNode("poster").width, 207.0)
            m.assertEqual(m.top.findNode("poster").height, 312.0)
            m.assertTrue(Instr(1, m.top.findNode("seasonPosterMask").maskUri, "/season-poster-mask.png") > 0)
            m.assertEqual(m.top.findNode("title").translation, [0.0, 327.0])
            m.assertEqual(m.top.findNode("year").translation, [0.0, 357.0])
        end function

        @describe("remaining season counts")

        @it("shows the remaining season count and updates at zero")
        function _()
            m.global.showUnwatchedEpisodeCount = "subtle"
            component = CreateObject("roSGNode", "TVSeasonCard")
            item = m.createSeason("Season 1", "2024", 8, "")
            item.raw = { Type: "Season", UserData: { UnplayedItemCount: 8 } }

            component.itemContent = item

            m.assertEqual(component.findNode("watchedIndicator").findNode("countLabel").text, "8")
            m.assertEqual(component.findNode("watchedIndicator").data, { eligible: true, isWatched: false, unplayedCount: 8, width: 42, height: 42 })

            item.raw = { Type: "Season", UserData: { UnplayedItemCount: 0 } }

            m.assertTrue(component.findNode("watchedIndicator").findNode("watchedCheck").visible)
            m.assertFalse(component.findNode("watchedIndicator").findNode("countGroup").visible)
            m.assertEqual(component.findNode("watchedIndicator").data, { eligible: true, isWatched: true, unplayedCount: 0, width: 42, height: 42 })
        end function

        @it("retains the right inset in the large season layout")
        function _()
            m.global.showUnwatchedEpisodeCount = "subtle"
            item = m.createSeason("Season 1", "2024", 200, "")
            item.raw = { Type: "Season", UserData: { UnplayedItemCount: 200 } }
            item.addFields({ posterLayout: true })

            m.top.itemContent = item

            badge = m.top.findNode("watchedIndicator")
            m.assertEqual(badge.translation, [346.0, 9.0])
            m.assertTrue(abs(badge.findNode("countGroup").translation[0] + (badge.findNode("countBackground").width * badge.findNode("countBackground").scale[0]) - 42.0) < 0.001)
        end function

    end class

end namespace
