namespace tests

    @SGNode("HomeVideoPlaybackDialog")
    @suite("Home video playback dialog")
    class HomeVideoPlaybackDialogTests extends rooibos.BaseTestSuite

        protected override function beforeEach()
            m.top.selectedVideo = invalid
            m.top.closeRequested = false
            m.top.item = { Id: "home-1", Type: "Video", UserData: { PlaybackPositionTicks: 20000000& } }
            m.top.callFunc("openPlayback")
        end function

        @describe("dialog lifecycle")

        @it("closes after publishing the toolbar selection")
        function _()
            content = m.top.callFunc("getContentComponent")
            content.findNode("toolbar").restartSelected = true

            m.assertTrue(m.top.closeRequested)
            m.assertEqual(m.top.selectedVideo.startPositionTicks, 0&)
            m.assertFalse(m.top.findNode("dialog").visible)
        end function

        @it("cancels without a selection or progress mutation")
        function _()
            m.top.callFunc("closeDialog")

            m.assertTrue(m.top.closeRequested)
            m.assertInvalid(m.top.selectedVideo)
            m.assertEqual(m.top.item.UserData.PlaybackPositionTicks, 20000000&)
        end function

    end class

end namespace
