namespace tests

    @SGNode("DvdPlayer")
    @suite("DVD menu proof of concept")
    class DvdPlayerTests extends rooibos.BaseTestSuite

        protected override function beforeEach()
            m.top.callFunc("deactivate")
            m.node.session = { server: "http://server/jellyfin", token: "test-token", userId: "user" }
            m.node.loading.active = true
            m.node.menu = { manifest: m.fixture(), screen: "", title: 6, chapter: 1, featureAudio: 1, audio: 1, subtitles: false, infoText: false, history: [], focused: 0 }
            'bs:disable-next-line 1001
            m.stubCall(menuMediaRequest, { url: "pkg:/images/channel-fhd.png", headers: { Authorization: "MediaBrowser Token=test" } })
        end function

        protected override function afterEach()
            m.top.callFunc("deactivate")
        end function

        function fixture() as object
            buttons = [
                { number: 1, group: 1, x: 360, y: 120, width: 180, height: 48, right: 2, down: 2, left: 99, up: 2 }
                { number: 2, group: 1, x: 360, y: 180, width: 180, height: 48, left: 1, up: 1, right: 1, down: 1 }
                { number: 3, group: 2, x: 0, y: 0, width: 10, height: 10 }
            ]
            asset = { id: "menu", titleSet: 2, image: "Starfin/Dvd/Demos/robots-of-death-special-edition/Assets/menu.jpg", navigation: [{ forcedSelect: 2, buttons: buttons }] }
            chapters = [{ number: 1, pgc: 1, program: 1, startSecondsInPgc: 0 }, { number: 2, pgc: 1, program: 2, startSecondsInPgc: 60 }]
            titleSet = { number: 2, menuVideo: { width: 720, height: 480, aspectRatio: "4:3" }, audio: [{ number: 1 }, { number: 2 }], programChains: [{ number: 1, audioMappings: [{ trackNumber: 1 }, { trackNumber: 2 }] }] }
            extraSet = { number: 3, audio: [{ number: 1 }], programChains: [{ number: 1, audioMappings: [{ trackNumber: 1 }] }] }
            screens = {
                home: { assetId: "menu", buttons: { "1": { action: "select", title: 6, chapter: 2 }, "2": { action: "navigate", screen: "subtitles" } } }
                "subtitles-off": { assetId: "menu", buttons: { "1": { action: "subtitles", enabled: true }, "2": { action: "navigate", screen: "home" } } }
                "subtitles-on": { assetId: "menu", buttons: { "1": { action: "subtitles", enabled: false }, "2": { action: "navigate", screen: "home" } } }
                audio1: { assetId: "menu", buttons: { "1": { action: "audio", track: 2 }, "2": { action: "resume" } } }
                audio2: { assetId: "menu", buttons: { "1": { action: "audio", track: 1 }, "2": { action: "resume" } } }
                "extras2-off": { assetId: "menu", buttons: { "1": { action: "infoText", enabled: true }, "2": { action: "navigate", screen: "home" } } }
                "extras2-on": { assetId: "menu", buttons: { "1": { action: "infoText", enabled: false }, "2": { action: "navigate", screen: "home" } } }
            }
            return { initialScreen: "home", disc: { ifoSha256: "fixture", menuAssets: [asset], titleSets: [titleSet, extraSet], titles: [{ number: 6, titleSet: 2, titleWithinSet: 5, pgcs: [1], chapters: chapters }, { number: 7, titleSet: 3, titleWithinSet: 1, pgcs: [1], chapters: chapters }], reviewedInterpretation: { episodes: [], specialFeatures: [] } }, menuMap: { screens: screens } }
        end function

        @describe("initial DVD loading artwork")

        function startupDisc() as object
            return { startupArtwork: {
                metadataId: "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa", size: [309, 464], columns: 5
                path: "Starfin/Dvd/Images/Titles/aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa/Poster?tag=artwork"
            } }
        end function

        @it("loads the selected poster through the configured server base path")
        function _()
            m.node.session.demo = m.startupDisc()

            'bs:disable-next-line 1140
            beginStartupArtwork()

            m.assertTrue(m.node.startupArtwork.poster <> invalid)
            m.assertTrue(Instr(1, m.node.startupArtwork.poster.uri, "http://server/jellyfin/Starfin/Dvd/Images/Titles/") = 1)
            m.assertTrue(Instr(1, m.node.startupArtwork.poster.uri, "?tag=artwork&width=") > 0)
            expectedWidth = "309"
            if ResolutionProfile.IsHd() then expectedWidth = "206"
            m.assertTrue(Instr(1, m.node.startupArtwork.poster.uri, "?tag=artwork&width=" + expectedWidth) > 0)
            m.assertEqual(m.node.startupArtwork.poster.width, 309)
            m.assertEqual(m.node.startupArtwork.poster.height, 464)
            m.assertEqual(m.node.startupArtwork.mask.scale, [1.5, 1.5])
            m.assertEqual(m.node.startupArtwork.mask.translation, [728.25, 192])
            m.assertEqual(m.node.startupArtwork.poster.opacity, 0.65)
            m.assertTrue(Instr(1, m.node.startupArtwork.mask.maskUri, "poster-5-col-mask.png") > 0)
            m.assertFalse(m.node.startupArtwork.host.visible)
        end function

        @it("keeps a plain background when the selected disc has no poster")
        function _()
            m.node.session.demo = { metadataId: "" }

            'bs:disable-next-line 1140
            beginStartupArtwork()

            m.assertEqual(m.node.startupArtwork.poster, invalid)
            m.assertFalse(m.node.startupArtwork.host.visible)
        end function

        @it("releases startup artwork when the menu becomes ready")
        function _()
            m.pendingMenuSnapshot()
            m.node.session.demo = m.startupDisc()
            'bs:disable-next-line 1140
            beginStartupArtwork()
            poster = m.node.startupArtwork.poster
            m.node.native.state = "menu"

            'bs:disable-next-line 1140
            revealMenuBackground()

            m.assertEqual(m.node.startupArtwork.poster, invalid)
            m.assertEqual(poster.uri, "")
            m.assertFalse(m.node.startupArtwork.host.visible)
        end function

        @it("ignores failures from an artwork request replaced by a new launch")
        function _()
            m.node.session.demo = m.startupDisc()
            'bs:disable-next-line 1140
            beginStartupArtwork()
            getGlobalAa().oldDvdStartupPoster = m.node.startupArtwork.poster
            'bs:disable-next-line 1140
            beginStartupArtwork()
            currentPoster = m.node.startupArtwork.poster
            event = { getRoSGNode: function()
                return getGlobalAa().oldDvdStartupPoster
            end function, getData: function()
                return "failed"
            end function }

            'bs:disable-next-line 1140
            onStartupPosterStatus(event)

            m.assertTrue(m.node.startupArtwork.poster.isSameNode(currentPoster))
            getGlobalAa().Delete("oldDvdStartupPoster")
        end function

        @describe("menu readiness during preparation")

        function pendingMenuSnapshot() as object
            m.node.loading.failed = false
            m.node.native.state = "preparingPlayback"
            m.node.native.revision = 6
            m.node.native.snapshot = { state: "preparingPlayback", revision: 6 }
            m.node.nodes.host.visible = true
            snapshot = { state: "menu", revision: 7, menu: {
                assetId: "menu", imagePath: "menu.jpg", aspectRatio: "4:3", sourceWidth: 720, sourceHeight: 480
                selectedButton: 1, buttons: [{ id: 1, x: 100, y: 100, width: 100, height: 40 }]
            } }
            'bs:disable-next-line 1140
            renderScreen(snapshot.menu)
            ' Readiness is supplied explicitly by each case, not an asynchronous image load.
            m.node.rendering.image.unobserveField("loadStatus")
            m.node.rendering.previewStarted = true
            return snapshot
        end function

        @it("keeps unresolved menu navigation free of a playback spinner")
        function _()
            snapshot = m.pendingMenuSnapshot()
            'bs:disable-next-line 1140
            startPreview()
            'bs:disable-next-line 1140
            applySnapshot(snapshot)
            background = m.node.rendering.root

            'bs:disable-next-line 1140
            applySnapshot({ state: "starting", revision: 8 })

            m.assertTrue(m.node.nodes.host.visible)
            m.assertTrue(m.node.rendering.root.isSameNode(background))
            m.assertFalse(m.node.presentation.loading)
            m.assertFalse(m.node.presentation.spinnerRunning)
        end function

        @it("shows preparation immediately over a retained menu")
        function _()
            snapshot = m.pendingMenuSnapshot()
            'bs:disable-next-line 1140
            startPreview()
            'bs:disable-next-line 1140
            applySnapshot(snapshot)
            background = m.node.rendering.root

            'bs:disable-next-line 1140
            applySnapshot({ state: "preparingPlayback", revision: 8 })

            m.assertTrue(m.node.nodes.host.visible)
            m.assertTrue(m.node.rendering.root.isSameNode(background))
            m.assertTrue(m.node.presentation.loading)
            m.assertTrue(m.node.presentation.spinnerRunning)
            m.assertEqual(m.node.playback.video, invalid)
        end function

        @it("shows preparation after an unresolved navigation response")
        function _()
            snapshot = m.pendingMenuSnapshot()
            'bs:disable-next-line 1140
            startPreview()
            'bs:disable-next-line 1140
            applySnapshot(snapshot)
            'bs:disable-next-line 1140
            applySnapshot({ state: "starting", revision: 8 })

            'bs:disable-next-line 1140
            applySnapshot({ state: "preparingPlayback", revision: 9 })

            m.assertTrue(m.node.presentation.spinnerRunning)
        end function

        @it("reveals a static background that became ready during preparation")
        function _()
            snapshot = m.pendingMenuSnapshot()
            background = m.node.rendering.root

            'bs:disable-next-line 1140
            startPreview()

            m.assertTrue(m.node.rendering.backgroundReady)
            m.assertTrue(m.node.rendering.waitingForReveal)

            'bs:disable-next-line 1140
            applySnapshot(snapshot)

            m.assertTrue(m.node.rendering.root.isSameNode(background))
            m.assertFalse(m.node.rendering.waitingForReveal)
            m.assertFalse(m.node.nodes.menuStartupCover.visible)
            m.assertFalse(m.node.presentation.spinnerRunning)
            m.assertTrue(m.node.rendering.buttons["1"].getChild(0).visible)
        end function

        @it("reveals fallback after a preview fails during preparation")
        function _()
            snapshot = m.pendingMenuSnapshot()
            m.node.rendering.asset.previewVideo = "menu.mp4"
            retained = m.node.nodes.host.createChild("Group")
            m.node.rendering.retainedRoot = retained

            'bs:disable-next-line 1140
            failPreview()

            m.assertTrue(m.node.rendering.backgroundReady)
            m.assertTrue(m.node.rendering.waitingForReveal)
            m.assertTrue(m.node.rendering.retainedRoot.isSameNode(retained))

            'bs:disable-next-line 1140
            applySnapshot(snapshot)

            m.assertFalse(m.node.rendering.waitingForReveal)
            m.assertEqual(m.node.rendering.retainedRoot, invalid)
            m.assertTrue(m.node.rendering.image.visible)
            m.assertFalse(m.node.presentation.spinnerRunning)
        end function

        @it("does not reuse readiness for a replacement background")
        function _()
            snapshot = m.pendingMenuSnapshot()
            'bs:disable-next-line 1140
            startPreview()
            snapshot.menu.imagePath = "replacement.jpg"

            'bs:disable-next-line 1140
            applySnapshot(snapshot)

            m.assertFalse(m.node.rendering.backgroundReady)
            m.assertTrue(m.node.rendering.waitingForReveal)
            m.assertTrue(m.node.presentation.spinnerRunning)
        end function

        @it("discards deferred readiness during cleanup")
        function _()
            m.pendingMenuSnapshot()
            'bs:disable-next-line 1140
            startPreview()

            m.top.callFunc("deactivate")

            m.assertFalse(m.node.rendering.backgroundReady)
            m.assertFalse(m.node.rendering.waitingForReveal)
            m.assertFalse(m.node.nodes.menuStartupCover.visible)
        end function

        @describe("measured DVD title progress")

        function measuredSnapshot() as object
            m.node.loading.active = true
            m.node.loading.failed = false
            m.node.resume.closing = false
            m.node.session.demo = { id: "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa" }
            m.node.playback.id = "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb"
            m.node.playback.failed = false
            m.node.playback.video = CreateObject("roSGNode", "Video")
            m.node.native.state = "playing"
            return {
                capabilities: { titleTimeline: true, titleTimelineVersion: 2 }
                playback: {
                    playbackId: "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb", titleIdentity: { discId: "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa", titleNumber: 3 }, durationSeconds: 200
                    titleTimeline: { status: "available", mapping: { type: "piecewise", ranges: [
                        { outputStartSeconds: 0, outputEndSeconds: 2, titleStartSeconds: 100, titleEndSeconds: 102 }
                    ] } }
                }
            }
        end function

        @it("derives presentation from the current video and measured mapping")
        function _()
            m.node.native.snapshot = m.measuredSnapshot()

            'bs:disable-next-line 1140
            result = getTimelinePresentation()

            m.assertEqual(result.available, true)
            m.assertEqual(result.elapsed, 100)
            m.assertEqual(result.duration, 200)
        end function

        @it("rejects a measured snapshot belonging to replaced playback")
        function _()
            snapshot = m.measuredSnapshot()
            snapshot.playback.playbackId = "cccccccc-cccc-cccc-cccc-cccccccccccc"
            m.node.native.snapshot = snapshot

            'bs:disable-next-line 1140
            result = getTimelinePresentation()

            m.assertEqual(result.available, false)
            m.assertEqual(result.reason, "playback-id-mismatch")
        end function

        @it("retains linear timeline support for older servers")
        function _()
            snapshot = m.measuredSnapshot()
            snapshot.playback.titleTimeline.mapping = { type: "linear", titleOffsetSeconds: 50 }
            m.node.native.snapshot = snapshot

            'bs:disable-next-line 1140
            result = getTimelinePresentation()

            m.assertEqual(result.available, true)
            m.assertEqual(result.elapsed, 50)
        end function

        @it("refreshes same-revision timeline without replacing video or controls")
        function _()
            fresh = m.measuredSnapshot()
            fresh.revision = 7
            fresh.state = "playing"
            m.node.native.revision = 7
            m.node.native.inFlight = { requestId: "pending", action: "progress" }
            video = m.node.playback.video
            m.node.nodes.controls.visible = true
            fresh.playback.titleTimeline.mapping.ranges[0].titleStartSeconds = 110
            fresh.playback.titleTimeline.mapping.ranges[0].titleEndSeconds = 112

            'bs:disable-next-line 1140
            applySnapshot(fresh)

            m.assertEqual(m.node.nodes.controls.timeline.elapsed, 110)
            m.assertTrue(m.node.playback.video.isSameNode(video))
            m.assertTrue(m.node.nodes.controls.visible)
            m.assertEqual(m.node.native.inFlight.requestId, "pending")
        end function

        @it("does not replace the player's timeline with an older revision")
        function _()
            snapshot = m.measuredSnapshot()
            snapshot.revision = 6
            snapshot.state = "playing"
            m.node.native.revision = 7
            m.node.nodes.controls.timeline = { available: true, elapsed: 120, duration: 200 }

            'bs:disable-next-line 1140
            applySnapshot(snapshot)

            m.assertEqual(m.node.nodes.controls.timeline.elapsed, 120)
            m.assertEqual(m.node.native.revision, 7)
        end function

        @it("reports an actual mapping gap as unavailable after refresh")
        function _()
            snapshot = m.measuredSnapshot()
            snapshot.revision = 7
            snapshot.state = "playing"
            snapshot.playback.titleTimeline.mapping.ranges[0].outputStartSeconds = 1
            m.node.native.revision = 7

            'bs:disable-next-line 1140
            applySnapshot(snapshot)

            m.assertFalse(m.node.nodes.controls.timeline.available)
            m.assertEqual(m.node.nodes.controls.timeline.reason, "unmapped-position")
        end function

        @it("rejects the previous timeline when resume creates a new playback identity")
        function _()
            m.node.native.snapshot = m.measuredSnapshot()
            m.node.playback.id = "cccccccc-cccc-cccc-cccc-cccccccccccc"

            'bs:disable-next-line 1140
            result = getTimelinePresentation()

            m.assertFalse(result.available)
            m.assertEqual(result.reason, "playback-id-mismatch")
        end function

        @it("maps continuous output across a source timestamp reset")
        function _()
            ranges = [
                { outputStartSeconds: 0, outputEndSeconds: 2, titleStartSeconds: 100, titleEndSeconds: 102 }
                { outputStartSeconds: 2, outputEndSeconds: 4, titleStartSeconds: 102, titleEndSeconds: 104 }
            ]

            'bs:disable-next-line 1140
            m.assertEqual(measuredTitlePosition(ranges, 3, 200), 103)
        end function

        @it("preserves a one-tick output interval late in playback")
        function _()
            ranges = ParseJson("[{" + Chr(34) + "outputStartSeconds" + Chr(34) + ":600.0," + Chr(34) + "outputEndSeconds" + Chr(34) + ":600.000011111111," + Chr(34) + "titleStartSeconds" + Chr(34) + ":1000.0," + Chr(34) + "titleEndSeconds" + Chr(34) + ":1000.04}]", "d")

            'bs:disable-next-line 1140
            result = measuredTitlePosition(ranges, 600.0000055555555#, 2000.0#)

            m.assertTrue(result > 1000.019# and result < 1000.021#)
        end function

        @it("keeps other coverage available when a range is only one tick wide")
        function _()
            ranges = [
                { outputStartSeconds: 600.0#, outputEndSeconds: 600.000011111111#, titleStartSeconds: 1000.0#, titleEndSeconds: 1000.04# }
                { outputStartSeconds: 601.0#, outputEndSeconds: 603.0#, titleStartSeconds: 1001.0#, titleEndSeconds: 1003.0# }
            ]

            'bs:disable-next-line 1140
            m.assertEqual(measuredTitlePosition(ranges, 602.0#, 2000.0#), 1002.0#)
        end function

        @it("holds authored position for a duplicated output frame")
        function _()
            ranges = [{ outputStartSeconds: 2, outputEndSeconds: 3, titleStartSeconds: 102, titleEndSeconds: 102 }]

            'bs:disable-next-line 1140
            m.assertEqual(measuredTitlePosition(ranges, 2.5, 200), 102)
        end function

        @it("leaves unknown gaps unavailable")
        function _()
            ranges = [
                { outputStartSeconds: 0, outputEndSeconds: 1, titleStartSeconds: 100, titleEndSeconds: 101 }
                { outputStartSeconds: 2, outputEndSeconds: 3, titleStartSeconds: 102, titleEndSeconds: 103 }
            ]

            'bs:disable-next-line 1140
            m.assertEqual(measuredTitlePosition(ranges, 1.5, 200), invalid)
        end function

        @it("does not extrapolate beyond published coverage")
        function _()
            ranges = [{ outputStartSeconds: 0, outputEndSeconds: 1, titleStartSeconds: 100, titleEndSeconds: 101 }]

            'bs:disable-next-line 1140
            m.assertEqual(measuredTitlePosition(ranges, 2, 200), invalid)
        end function

        @it("rejects overlapping ranges even when the position matches")
        function _()
            ranges = [
                { outputStartSeconds: 0, outputEndSeconds: 2, titleStartSeconds: 100, titleEndSeconds: 102 }
                { outputStartSeconds: 1, outputEndSeconds: 3, titleStartSeconds: 101, titleEndSeconds: 103 }
            ]

            'bs:disable-next-line 1140
            m.assertEqual(measuredTitlePosition(ranges, 1.5, 200), invalid)
        end function

        @describe("geometry and focus")

        @it("fits anamorphic source coordinates into the centered 4:3 display")
        function _()
            'bs:disable-next-line 1140
            goScreen("home")

            m.assertEqual(m.node.rendering.rect.x, 240)
            m.assertEqual(m.node.rendering.rect.width, 1440)
            m.assertEqual(m.node.rendering.buttons["1"].translation, [720, 270])
            m.assertEqual(m.node.rendering.buttons["1"].getChild(0).getChild(0).width, 360)
            m.assertEqual(m.node.rendering.buttons.Count(), 2)
            m.assertEqual(m.node.menu.focused, 2)
        end function

        @it("fits 16:9 into a 720p viewport without letterboxing")
        function _()
            'bs:disable-next-line 1140
            rect = fitMenuRect({ width: 720, height: 480, aspectRatio: "16:9" }, 1280, 720)

            m.assertEqual(rect.width, 1280)
            m.assertEqual(rect.height, 720)
            m.assertEqual(rect.x, 0)
        end function

        @it("follows the mapped neighbor and highlights its hotspot")
        function _()
            'bs:disable-next-line 1140
            goScreen("home", 1)

            'bs:disable-next-line 1140
            onKeyEvent("right", true)

            m.assertEqual(m.node.menu.focused, 2)
            m.assertTrue(m.node.rendering.buttons["2"].hasFocus())
            m.assertTrue(m.node.rendering.buttons["2"].getChild(0).visible)
            m.assertFalse(m.node.rendering.buttons["1"].getChild(0).visible)
        end function

        @it("ignores an unavailable directional target")
        function _()
            'bs:disable-next-line 1140
            goScreen("home", 1)

            'bs:disable-next-line 1140
            onKeyEvent("left", true)

            m.assertEqual(m.node.menu.focused, 1)
        end function

        @describe("menu actions and state")

        @it("OK opens the mapped submenu")
        function _()
            'bs:disable-next-line 1140
            goScreen("home", 2)

            'bs:disable-next-line 1140
            onKeyEvent("OK", true)

            m.assertEqual(m.node.menu.screen, "subtitles-off")
            m.assertEqual(m.node.menu.history, ["home"])
        end function

        @it("subtitle toggles change artwork without pushing history")
        function _()
            'bs:disable-next-line 1140
            goScreen("subtitles", 1)

            'bs:disable-next-line 1140
            onKeyEvent("OK", true)

            m.assertTrue(m.node.menu.subtitles)
            m.assertEqual(m.node.menu.screen, "subtitles-on")
            m.assertEqual(m.node.menu.history.Count(), 0)
            m.assertEqual(m.node.menu.focused, 1)
        end function

        @it("Back resolves historical toggle screens against current intent")
        function _()
            m.node.menu.history = ["subtitles-off"]
            m.node.menu.subtitles = true
            'bs:disable-next-line 1140
            goScreen("home", 1, false)

            'bs:disable-next-line 1140
            onKeyEvent("back", true)

            m.assertEqual(m.node.menu.screen, "subtitles-on")
        end function

        @it("Back from the root requests closure")
        function _()
            m.top.closeRequested = false
            'bs:disable-next-line 1140
            goScreen("home")

            'bs:disable-next-line 1140
            onKeyEvent("back", true)

            m.assertTrue(m.top.closeRequested)
        end function

        @it("extras retain their own audio while preserving feature preference")
        function _()
            m.node.menu.featureAudio = 2
            'bs:disable-next-line 1140
            m.assertTrue(selectTitle(7, 1))

            m.assertEqual(m.node.menu.audio, 1)
            m.assertEqual(m.node.menu.featureAudio, 2)

            'bs:disable-next-line 1140
            selectTitle(6, 1)

            m.assertEqual(m.node.menu.audio, 2)
        end function

        @it("unavailable preferred audio falls back to the first declared track")
        function _()
            m.node.menu.featureAudio = 3

            'bs:disable-next-line 1140
            selectTitle(6, 1)

            m.assertEqual(m.node.menu.audio, 1)
            m.assertEqual(m.node.menu.featureAudio, 3)
        end function

        @it("invalid chapters do not change the selected title")
        function _()
            'bs:disable-next-line 1140
            m.assertFalse(selectTitle(7, 99))

            m.assertEqual(m.node.menu.title, 6)
            m.assertEqual(m.node.menu.chapter, 1)
        end function

        @it("selection payload preserves unresolved subtitle intent and chapter mapping")
        function _()
            m.node.menu.subtitles = true
            m.node.menu.infoText = true
            'bs:disable-next-line 1140
            selectTitle(6, 2)

            'bs:disable-next-line 1140
            request = selectionRequest()

            m.assertEqual(request.schemaVersion, "starfin-dvd-selection/0.2-preview")
            m.assertEqual(request.chapterNumber, 2)
            m.assertEqual(request.program, 2)
            m.assertEqual(request.approximateStartSecondsInPgc, 60)
            m.assertInvalid(request.subtitleTrackNumber)
            m.assertEqual(request.subtitleMappingStatus, "unresolved")
            m.assertTrue(request.requestedInfoTextEnabled)
            m.assertEqual(request.mode, "preview-only")
        end function

        @it("content selection displays the playback-unavailable acknowledgment")
        function _()
            m.stubCall(AppMessage.Show, sub(message, title)
                getGlobalAa().dvdMessage = message
            end sub)
            'bs:disable-next-line 1140
            goScreen("home", 1)

            'bs:disable-next-line 1140
            onKeyEvent("OK", true)

            m.assertEqual(m.node.rendering.selection.chapterNumber, 2)
            m.assertTrue(Instr(1, getGlobalAa().dvdMessage, "Playback unavailable") > 0)
            m.assertTrue(m.node.rendering.awaitingMessage)
        end function

        @describe("asynchronous lifecycle")

        @it("a fresh page accepts session data assigned before activation")
        function _()
            page = m.top.createChild("DvdPlayer")
            page.loadRequest = { server: "http://server/base", token: "fixture-token", userId: "fixture-user" }

            page.callFunc("activate")
            request = page.taskCreated.request
            page.callFunc("deactivate")
            m.top.removeChild(page)

            m.assertEqual(request.server, "http://server/base")
            m.assertEqual(request.token, "fixture-token")
            m.assertEqual(request.userId, "fixture-user")
            m.assertEqual(request.requestId, 1)
        end function

        @it("an accepted manifest resets selection and opens the initial screen")
        function _()
            getGlobalAa().dvdManifest = m.fixture()
            m.node.menu.subtitles = true
            m.node.menu.featureAudio = 2
            AsyncLifecycle.Begin(m.node.loading.lifecycle, 5)
            event = { getData: function()
                return { requestId: 5, action: "dvdDemoLoad", ok: true, payload: getGlobalAa().dvdManifest }
            end function }

            'bs:disable-next-line 1140
            onDemoResponse(event)

            m.assertEqual(m.node.menu.screen, "home")
            m.assertEqual(m.node.menu.title, 6)
            m.assertEqual(m.node.menu.chapter, 1)
            m.assertEqual(m.node.menu.featureAudio, 1)
            m.assertFalse(m.node.menu.subtitles)
            m.assertEqual(m.node.loading.phase, "ready")
        end function

        @it("preview errors leave the original artwork and focused hotspot intact")
        function _()
            'bs:disable-next-line 1140
            goScreen("home", 1)
            m.installPreview()
            event = { getData: function()
                return "error"
            end function, getRoSGNode: function()
                return getGlobalAa().dvdPreviewNode
            end function }

            'bs:disable-next-line 1140
            onPreviewState(event)

            m.assertInvalid(m.node.rendering.video)
            m.assertNotInvalid(m.node.rendering.image)
            m.assertTrue(m.node.rendering.image.visible)
            m.assertTrue(m.node.rendering.buttons["1"].hasFocus())
        end function

        @it("a preview timeout removes only the preview")
        function _()
            'bs:disable-next-line 1140
            goScreen("home", 1)
            m.installPreview()
            getGlobalAa().dvdPreviewTimer = m.node.rendering.timer
            event = { getRoSGNode: function()
                return getGlobalAa().dvdPreviewTimer
            end function }

            'bs:disable-next-line 1140
            onPreviewTimeout(event)

            m.assertInvalid(m.node.rendering.video)
            m.assertInvalid(m.node.rendering.timer)
            m.assertEqual(m.node.loading.phase, "ready")
        end function

        @it("a playing notification alone keeps the still until position advances")
        function _()
            'bs:disable-next-line 1140
            goScreen("home", 1)
            m.installPreview()
            event = { getData: function()
                return "playing"
            end function, getRoSGNode: function()
                return getGlobalAa().dvdPreviewNode
            end function }

            'bs:disable-next-line 1140
            onPreviewState(event)

            m.assertTrue(m.node.rendering.video.visible)
            m.assertTrue(m.node.rendering.image.visible)
            m.assertTrue(m.node.rendering.buttons["1"].hasFocus())
        end function

        @it("preview startup enables native looping")
        function _()
            'bs:disable-next-line 1140
            goScreen("home", 1)
            m.node.rendering.asset.previewVideo = "Starfin/Dvd/Demos/robots-of-death-special-edition/Assets/menu.mp4"
            content = CreateObject("roSGNode", "ContentNode")
            m.stubCall(JellyfinAuth.CreateContent, content)

            'bs:disable-next-line 1140
            startPreview()

            m.assertNotInvalid(m.node.rendering.video)
            m.assertTrue(m.node.rendering.video.loop)
            m.assertTrue(m.node.rendering.video.mute)
        end function

        @it("loop completion retains the player and content while showing the still")
        function _()
            'bs:disable-next-line 1140
            goScreen("home", 1)
            m.installPreview()
            video = m.node.rendering.video
            timer = m.node.rendering.timer
            content = CreateObject("roSGNode", "ContentNode")
            video.content = content
            m.node.rendering.image.visible = false
            event = { getData: function()
                return "finished"
            end function, getRoSGNode: function()
                return getGlobalAa().dvdPreviewNode
            end function }

            'bs:disable-next-line 1140
            onPreviewState(event)

            m.assertTrue(m.node.rendering.video.isSameNode(video))
            m.assertTrue(m.node.rendering.video.content.isSameNode(content))
            m.assertTrue(m.node.rendering.timer.isSameNode(timer))
            m.assertTrue(m.node.rendering.image.visible)
            m.assertTrue(video.visible)
            m.assertTrue(m.node.rendering.buttons["1"].hasFocus())
        end function

        @it("loop buffering retains the player and displays the still")
        function _()
            'bs:disable-next-line 1140
            goScreen("home", 1)
            m.installPreview()
            video = m.node.rendering.video
            m.node.rendering.image.visible = false
            event = { getData: function()
                return "buffering"
            end function, getRoSGNode: function()
                return getGlobalAa().dvdPreviewNode
            end function }

            'bs:disable-next-line 1140
            onPreviewState(event)

            m.assertTrue(m.node.rendering.video.isSameNode(video))
            m.assertTrue(m.node.rendering.image.visible)
            m.assertTrue(video.visible)
        end function

        @it("the still is layered above the preview and below the hotspots")
        function _()
            'bs:disable-next-line 1140
            goScreen("home", 1)

            m.assertEqual(m.node.rendering.root.getChild(0).id, "previewHost")
            m.assertEqual(m.node.rendering.root.getChild(1).id, "menuImage")
            m.assertEqual(m.node.rendering.root.getChild(2).id, "hotspots")
        end function

        @it("forward playback progress uncovers the preview")
        function _()
            'bs:disable-next-line 1140
            goScreen("home", 1)
            m.installPreview()
            m.node.rendering.preview.playing = true
            'bs:disable-next-line 1140
            updatePreviewPosition(0, 12)

            'bs:disable-next-line 1140
            updatePreviewPosition(0.2, 12)

            m.assertFalse(m.node.rendering.image.visible)
            m.assertFalse(m.node.rendering.preview.covered)
        end function

        @it("the still covers EOF without a buffering or finished notification")
        function _()
            'bs:disable-next-line 1140
            goScreen("home", 1)
            m.installPreview()
            m.node.rendering.preview.playing = true
            'bs:disable-next-line 1140
            updatePreviewPosition(10, 12)
            'bs:disable-next-line 1140
            updatePreviewPosition(10.2, 12)

            'bs:disable-next-line 1140
            updatePreviewPosition(11.3, 12)

            m.assertTrue(m.node.rendering.image.visible)
            m.assertTrue(m.node.rendering.preview.awaitingWrap)
            m.assertTrue(m.node.rendering.buttons["1"].hasFocus())
        end function

        @it("a native loop stays covered until position wraps and then advances")
        function _()
            'bs:disable-next-line 1140
            goScreen("home", 1)
            m.installPreview()
            m.node.rendering.preview.playing = true
            'bs:disable-next-line 1140
            updatePreviewPosition(11.3, 12)
            'bs:disable-next-line 1140
            updatePreviewPosition(0, 12)
            m.assertTrue(m.node.rendering.image.visible)

            'bs:disable-next-line 1140
            updatePreviewPosition(0.2, 12)

            m.assertFalse(m.node.rendering.image.visible)
            m.assertFalse(m.node.rendering.preview.awaitingWrap)
            m.assertTrue(m.node.rendering.video.isSameNode(getGlobalAa().dvdPreviewNode))
        end function

        @it("repeated position notifications do not uncover the still")
        function _()
            'bs:disable-next-line 1140
            goScreen("home", 1)
            m.installPreview()
            m.node.rendering.preview.playing = true
            'bs:disable-next-line 1140
            updatePreviewPosition(0.2, 12)

            'bs:disable-next-line 1140
            updatePreviewPosition(0.2, 12)

            m.assertTrue(m.node.rendering.image.visible)
        end function

        @it("an obsolete preview cannot stop the current screen's video")
        function _()
            'bs:disable-next-line 1140
            goScreen("home", 1)
            m.installPreview()
            getGlobalAa().dvdOldPreview = CreateObject("roSGNode", "Video")
            event = { getData: function()
                return "error"
            end function, getRoSGNode: function()
                return getGlobalAa().dvdOldPreview
            end function }

            'bs:disable-next-line 1140
            onPreviewState(event)

            m.assertNotInvalid(m.node.rendering.video)
        end function

        @it("acknowledgment focus return releases the modal guard and retains hotspot focus")
        function _()
            'bs:disable-next-line 1140
            goScreen("home", 1)
            m.node.rendering.awaitingMessage = true
            m.node.rendering.lostFocus = true

            'bs:disable-next-line 1140
            onFocusChanged()

            m.assertFalse(m.node.rendering.awaitingMessage)
            m.assertTrue(m.node.rendering.buttons["1"].hasFocus())
        end function

        @it("a current failed request shows a retryable error")
        function _()
            AsyncLifecycle.Begin(m.node.loading.lifecycle, 5)
            event = { getData: function()
                return { requestId: 5, action: "dvdDemoLoad", ok: false, errorMessage: "Unavailable" }
            end function }

            'bs:disable-next-line 1140
            onDemoResponse(event)

            m.assertEqual(m.node.loading.phase, "failed")
            m.assertTrue(Instr(1, m.top.findNode("status").text, "OK to retry") > 0)
        end function

        @it("stale request generations cannot replace the active menu")
        function _()
            AsyncLifecycle.Begin(m.node.loading.lifecycle, 5)
            'bs:disable-next-line 1140
            goScreen("home", 1)
            event = { getData: function()
                return { requestId: 4, action: "dvdDemoLoad", ok: false, errorMessage: "old failure" }
            end function }

            'bs:disable-next-line 1140
            onDemoResponse(event)

            m.assertEqual(m.node.loading.phase, "ready")
            m.assertEqual(m.node.menu.screen, "home")
        end function

        @it("deactivation removes rendered nodes and revokes request ownership")
        function _()
            'bs:disable-next-line 1140
            goScreen("home")
            AsyncLifecycle.Begin(m.node.loading.lifecycle, 5)

            m.top.callFunc("deactivate")

            m.assertEqual(m.top.findNode("menuHost").getChildCount(), 0)
            m.assertFalse(m.node.loading.lifecycle.isActive)
            m.assertFalse(m.node.loading.active)
            m.assertFalse(m.top.visible)
        end function

        function installPreview()
            m.node.rendering.video = m.node.rendering.previewHost.createChild("Video")
            m.node.rendering.timer = m.node.rendering.previewHost.createChild("Timer")
            m.node.rendering.preview = { covered: true, awaitingWrap: false, lastPosition: -1.0, playing: false }
            getGlobalAa().dvdPreviewNode = m.node.rendering.video
        end function

    end class

end namespace
