namespace tests

    @SGNode("DvdPlayer")
    @suite("DVD native playback")
    class DvdPlayerTests extends rooibos.BaseTestSuite

        protected override function beforeEach()
            m.top.callFunc("deactivate")
            m.node.session = { server: "http://server/jellyfin", token: "test-token", userId: "user" }
            m.node.loading.active = true
            m.node.menu = { manifest: { id: "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa" }, focused: 0 }
            m.node.resume.closing = false
            m.node.resume.prompting = false
            m.node.loading.failed = false
            m.node.native.navigating = false
            m.node.native.state = ""
            m.node.native.snapshot = invalid
            m.node.native.revision = -1
            m.top.closeRequested = false
            m.top.authenticationRequired = invalid
        end function

        protected override function afterEach()
            m.top.callFunc("deactivate")
        end function

        @describe("native recovery")

        function responseEvent(source as object, data as object) as object
            return { source: source, data: data, getRoSGNode: function()
                return m.source
            end function, getData: function()
                return m.data
            end function }
        end function

        @it("Back exits content when no previous menu is available")
        function _()
            m.node.native.state = "playing"
            m.node.native.snapshot = { state: "playing", capabilities: { returnToLastMenu: true }, transport: { canReturnToLastMenu: false } }

            'bs:disable-next-line 1140
            onKeyEvent("back", true)

            m.assertTrue(m.top.closeRequested)
        end function

        @it("Back preserves the session while a command is pending")
        function _()
            m.node.native.state = "playing"
            m.node.native.inFlight = { action: "progress" }

            'bs:disable-next-line 1140
            onKeyEvent("back", true)

            m.assertFalse(m.top.closeRequested)
        end function

        @it("Back returns to the last menu when supported")
        function _()
            task = m.top.createChild("DvdSessionTask")
            m.node.native.task = task
            m.node.native.state = "playing"
            m.node.native.snapshot = { state: "playing", capabilities: { returnToLastMenu: true }, transport: { canReturnToLastMenu: true } }

            'bs:disable-next-line 1140
            onKeyEvent("back", true)

            m.assertFalse(m.top.closeRequested)
            m.assertEqual(task.command.action, "returnToLastMenu")
        end function

        @it("expired manifest authentication requests shell recovery")
        function _()
            task = m.top.createChild("DvdDemoTask")
            m.node.loading.task = task
            event = m.responseEvent(task, { requestId: m.node.loading.generation, ok: false, authExpired: true })

            'bs:disable-next-line 1140
            onDemoResponse(event)

            m.assertTrue(m.top.authenticationRequired.response.authExpired)
            m.assertEqual(m.top.authenticationRequired.request.token, "test-token")
            m.assertFalse(m.node.loading.active)
        end function

        @it("expired native session authentication requests shell recovery")
        function _()
            task = m.top.createChild("DvdSessionTask")
            m.node.native.task = task
            event = m.responseEvent(task, { requestId: m.node.native.requestId, action: "closed", authExpired: true })

            'bs:disable-next-line 1140
            onSessionResponse(event)

            m.assertTrue(m.top.authenticationRequired.response.authExpired)
            m.assertFalse(m.node.loading.active)
        end function

        @it("expired filter authentication requests shell recovery")
        function _()
            task = m.top.createChild("DvdFiltersTask")
            m.node.filters.task = task
            event = m.responseEvent(task, { requestId: m.node.filters.serial, kind: "catalog", ok: false, authExpired: true })

            'bs:disable-next-line 1140
            onFiltersResponse(event)

            m.assertTrue(m.top.authenticationRequired.response.authExpired)
            m.assertFalse(m.node.loading.active)
        end function

        @it("a rejected catalog uses the load failure path despite available capability")
        function _()
            task = m.top.createChild("DvdFiltersTask")
            m.node.filters.task = task
            m.node.filters.capability = "available"
            event = m.responseEvent(task, { requestId: m.node.filters.serial, kind: "catalog", ok: true, status: 200, data: { capabilities: { videoFilters: { state: "available" } } } })

            'bs:disable-next-line 1140
            onFiltersResponse(event)

            m.assertTrue(m.node.filters.discovery.failed)
            m.assertEqual(m.node.filters.discovery.retryKind, "")
            'bs:disable-next-line 1140
            m.assertFalse(filterEntryVisible())
        end function

        @describe("initial DVD loading artwork")

        function startupDisc() as object
            return { startupArtwork: {
                metadataId: "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa", size: [309, 464], columns: 5
                path: "Starfin/Dvd/Images/Titles/aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa/Poster?tag=artwork"
            } }
        end function

        @it("loads the selected poster through the configured server base path")
        function _()
            m.node.session.demo = m.startupDisc()

            'bs:disable-next-line 1140
            beginStartupArtwork()

            m.assertTrue(m.node.startupArtwork.poster <> invalid)
            m.assertTrue(Instr(1, m.node.startupArtwork.poster.uri, "http://server/jellyfin/Starfin/Dvd/Images/Titles/") = 1)
            m.assertTrue(Instr(1, m.node.startupArtwork.poster.uri, "?tag=artwork&width=") > 0)
            expectedWidth = "309"
            if ResolutionProfile.IsHd() then expectedWidth = "206"
            m.assertTrue(Instr(1, m.node.startupArtwork.poster.uri, "?tag=artwork&width=" + expectedWidth) > 0)
            m.assertEqual(m.node.startupArtwork.poster.width, 309.0)
            m.assertEqual(m.node.startupArtwork.poster.height, 464.0)
            m.assertEqual(m.node.startupArtwork.mask.scale, [1.5, 1.5])
            m.assertEqual(m.node.startupArtwork.mask.translation, [728.25, 192.0])
            m.assertEqual(m.node.startupArtwork.poster.opacity, 0.65)
            m.assertTrue(Instr(1, m.node.startupArtwork.mask.maskUri, "poster-5-col-mask.png") > 0)
            m.assertFalse(m.node.startupArtwork.host.visible)
        end function

        @it("keeps a plain background when the selected disc has no poster")
        function _()
            m.node.session.demo = { metadataId: "" }

            'bs:disable-next-line 1140
            beginStartupArtwork()

            m.assertEqual(m.node.startupArtwork.poster, invalid)
            m.assertFalse(m.node.startupArtwork.host.visible)
        end function

        @it("releases startup artwork when the menu becomes ready")
        function _()
            m.pendingMenuSnapshot()
            m.node.session.demo = m.startupDisc()
            'bs:disable-next-line 1140
            beginStartupArtwork()
            poster = m.node.startupArtwork.poster
            m.node.native.state = "menu"

            'bs:disable-next-line 1140
            revealMenuBackground()

            m.assertEqual(m.node.startupArtwork.poster, invalid)
            m.assertEqual(poster.uri, "")
            m.assertFalse(m.node.startupArtwork.host.visible)
        end function

        @it("ignores failures from an artwork request replaced by a new launch")
        function _()
            m.node.session.demo = m.startupDisc()
            'bs:disable-next-line 1140
            beginStartupArtwork()
            getGlobalAa().oldDvdStartupPoster = m.node.startupArtwork.poster
            'bs:disable-next-line 1140
            beginStartupArtwork()
            currentPoster = m.node.startupArtwork.poster
            event = { getRoSGNode: function()
                return getGlobalAa().oldDvdStartupPoster
            end function, getData: function()
                return "failed"
            end function }

            'bs:disable-next-line 1140
            onStartupPosterStatus(event)

            m.assertTrue(m.node.startupArtwork.poster.isSameNode(currentPoster))
            getGlobalAa().Delete("oldDvdStartupPoster")
        end function

        @describe("menu readiness during preparation")

        function pendingMenuSnapshot() as object
            m.node.loading.failed = false
            m.node.native.state = "preparingPlayback"
            m.node.native.revision = 6
            m.node.native.snapshot = { state: "preparingPlayback", revision: 6 }
            m.node.nodes.host.visible = true
            snapshot = { state: "menu", revision: 7, menu: {
                assetId: "menu", imagePath: "Starfin/Dvd/Discs/aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa/Assets/generation/menu.jpg", aspectRatio: "4:3", sourceWidth: 720, sourceHeight: 480
                selectedButton: 1, buttons: [{ id: 1, x: 100, y: 100, width: 100, height: 40 }]
            } }
            'bs:disable-next-line 1140
            renderScreen(snapshot.menu)
            ' Readiness is supplied explicitly by each case, not an asynchronous image load.
            m.node.rendering.image.unobserveField("loadStatus")
            m.node.rendering.previewStarted = true
            return snapshot
        end function

        @it("keeps unresolved menu navigation free of a playback spinner")
        function _()
            snapshot = m.pendingMenuSnapshot()
            'bs:disable-next-line 1140
            startPreview()
            'bs:disable-next-line 1140
            applySnapshot(snapshot)
            background = m.node.rendering.root

            'bs:disable-next-line 1140
            applySnapshot({ state: "starting", revision: 8 })

            m.assertTrue(m.node.nodes.host.visible)
            m.assertTrue(m.node.rendering.root.isSameNode(background))
            m.assertFalse(m.node.presentation.loading)
            m.assertFalse(m.node.presentation.spinnerRunning)
        end function

        @it("shows preparation immediately over a retained menu")
        function _()
            snapshot = m.pendingMenuSnapshot()
            'bs:disable-next-line 1140
            startPreview()
            'bs:disable-next-line 1140
            applySnapshot(snapshot)
            background = m.node.rendering.root

            'bs:disable-next-line 1140
            applySnapshot({ state: "preparingPlayback", revision: 8 })

            m.assertTrue(m.node.nodes.host.visible)
            m.assertTrue(m.node.rendering.root.isSameNode(background))
            m.assertTrue(m.node.presentation.loading)
            m.assertTrue(m.node.presentation.spinnerRunning)
            m.assertEqual(m.node.playback.video, invalid)
        end function

        @it("shows preparation after an unresolved navigation response")
        function _()
            snapshot = m.pendingMenuSnapshot()
            'bs:disable-next-line 1140
            startPreview()
            'bs:disable-next-line 1140
            applySnapshot(snapshot)
            'bs:disable-next-line 1140
            applySnapshot({ state: "starting", revision: 8 })

            'bs:disable-next-line 1140
            applySnapshot({ state: "preparingPlayback", revision: 9 })

            m.assertTrue(m.node.presentation.spinnerRunning)
        end function

        @it("reveals a static background that became ready during preparation")
        function _()
            snapshot = m.pendingMenuSnapshot()
            background = m.node.rendering.root

            'bs:disable-next-line 1140
            startPreview()

            m.assertTrue(m.node.rendering.backgroundReady)
            m.assertTrue(m.node.rendering.waitingForReveal)

            'bs:disable-next-line 1140
            applySnapshot(snapshot)

            m.assertTrue(m.node.rendering.root.isSameNode(background))
            m.assertFalse(m.node.rendering.waitingForReveal)
            m.assertFalse(m.node.nodes.menuStartupCover.visible)
            m.assertFalse(m.node.presentation.spinnerRunning)
            m.assertTrue(m.node.rendering.buttons["1"].getChild(0).visible)
        end function

        @it("reveals fallback after a preview fails during preparation")
        function _()
            snapshot = m.pendingMenuSnapshot()
            m.node.rendering.asset.previewVideo = "menu.mp4"
            retained = m.node.nodes.host.createChild("Group")
            m.node.rendering.retainedRoot = retained

            'bs:disable-next-line 1140
            failPreview()

            m.assertTrue(m.node.rendering.backgroundReady)
            m.assertTrue(m.node.rendering.waitingForReveal)
            m.assertTrue(m.node.rendering.retainedRoot.isSameNode(retained))

            'bs:disable-next-line 1140
            applySnapshot(snapshot)

            m.assertFalse(m.node.rendering.waitingForReveal)
            m.assertEqual(m.node.rendering.retainedRoot, invalid)
            m.assertTrue(m.node.rendering.image.visible)
            m.assertFalse(m.node.presentation.spinnerRunning)
        end function

        @it("does not reuse readiness for a replacement background")
        function _()
            snapshot = m.pendingMenuSnapshot()
            'bs:disable-next-line 1140
            startPreview()
            snapshot.menu.imagePath = "Starfin/Dvd/Discs/aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa/Assets/generation/replacement.jpg"

            'bs:disable-next-line 1140
            applySnapshot(snapshot)

            m.assertFalse(m.node.rendering.backgroundReady)
            m.assertTrue(m.node.rendering.waitingForReveal)
            m.assertTrue(m.node.presentation.spinnerRunning)
        end function

        @it("discards deferred readiness during cleanup")
        function _()
            m.pendingMenuSnapshot()
            'bs:disable-next-line 1140
            startPreview()

            m.top.callFunc("deactivate")

            m.assertFalse(m.node.rendering.backgroundReady)
            m.assertFalse(m.node.rendering.waitingForReveal)
            m.assertFalse(m.node.nodes.menuStartupCover.visible)
        end function

        @describe("native menu navigation")

        @it("moves normal focus locally without submitting a command")
        function _()
            snapshot = m.pendingMenuSnapshot()
            snapshot.menu.buttons[0].right = 2
            snapshot.menu.buttons.Push({ id: 2, x: 220, y: 100, width: 100, height: 40, left: 1 })
            'bs:disable-next-line 1140
            startPreview()
            'bs:disable-next-line 1140
            applySnapshot(snapshot)
            task = m.top.createChild("DvdSessionTask")
            m.node.native.task = task
            background = m.node.rendering.root

            'bs:disable-next-line 1140
            navigateMenu("right")

            m.assertEqual(m.node.menu.focused, 2)
            m.assertInvalid(task.command)
            m.assertTrue(m.node.rendering.root.isSameNode(background))
        end function

        @it("submits auto-action selection with current revision and no rectangle")
        function _()
            snapshot = m.pendingMenuSnapshot()
            snapshot.menu.buttons[0].right = 2
            snapshot.menu.buttons.Push({ id: 2, x: 220, y: 100, width: 21, height: 21, autoAction: true })
            'bs:disable-next-line 1140
            startPreview()
            'bs:disable-next-line 1140
            applySnapshot(snapshot)
            task = m.top.createChild("DvdSessionTask")
            m.node.native.task = task

            'bs:disable-next-line 1140
            navigateMenu("right")

            m.assertEqual(task.command.action, "button")
            m.assertEqual(task.command.button, 2)
            m.assertEqual(task.command.revision, 7)
            m.assertFalse(m.node.rendering.buttons["2"].getChild(0).visible)
        end function

        @describe("measured DVD title progress")

        function measuredSnapshot() as object
            m.node.loading.active = true
            m.node.loading.failed = false
            m.node.resume.closing = false
            m.node.session.demo = { id: "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa" }
            m.node.playback.id = "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb"
            m.node.playback.failed = false
            m.node.playback.video = CreateObject("roSGNode", "Video")
            m.node.native.state = "playing"
            snapshot = {
                capabilities: { titleTimeline: true, titleTimelineVersion: 2 }
                playback: {
                    playbackId: "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb", titleIdentity: { discId: "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa", titleNumber: 3 }, durationSeconds: 200
                    titleTimeline: { status: "available", mapping: { type: "piecewise", ranges: [
                        { outputStartSeconds: 0, outputEndSeconds: 2, titleStartSeconds: 100, titleEndSeconds: 102 }
                    ] } }
                }
            }
            return ParseJson(FormatJson(snapshot), "d")
        end function

        @it("accepts boxed integer timeline values")
        function _()
            identity = { titleNumber: 3 }

            'bs:disable-next-line 1140
            m.assertEqual(timelineNumber(identity.titleNumber), 3.0#)
        end function

        @it("rejects numeric strings as timeline values")
        function _()
            'bs:disable-next-line 1140
            m.assertInvalid(timelineNumber("3"))
        end function

        @it("rejects missing timeline values")
        function _()
            'bs:disable-next-line 1140
            m.assertInvalid(timelineNumber(invalid))
        end function

        @it("derives presentation from the current video and measured mapping")
        function _()
            m.node.native.snapshot = m.measuredSnapshot()

            'bs:disable-next-line 1140
            result = getTimelinePresentation()

            m.assertEqual(result.available, true)
            m.assertTrue(result.elapsed = 100)
            m.assertTrue(result.duration = 200)
        end function

        @it("rejects a measured snapshot belonging to replaced playback")
        function _()
            snapshot = m.measuredSnapshot()
            snapshot.playback.playbackId = "cccccccc-cccc-cccc-cccc-cccccccccccc"
            m.node.native.snapshot = snapshot

            'bs:disable-next-line 1140
            result = getTimelinePresentation()

            m.assertEqual(result.available, false)
            m.assertEqual(result.reason, "playback-id-mismatch")
        end function

        @it("retains linear timeline support for older servers")
        function _()
            snapshot = m.measuredSnapshot()
            snapshot.playback.titleTimeline.mapping = { type: "linear", titleOffsetSeconds: 50 }
            m.node.native.snapshot = snapshot

            'bs:disable-next-line 1140
            result = getTimelinePresentation()

            m.assertEqual(result.available, true)
            m.assertTrue(result.elapsed = 50)
        end function

        @it("refreshes same-revision timeline without replacing video or controls")
        function _()
            fresh = m.measuredSnapshot()
            fresh.revision = 7
            fresh.state = "playing"
            m.node.native.revision = 7
            m.node.native.inFlight = { requestId: "pending", action: "progress" }
            video = m.node.playback.video
            m.node.nodes.controls.visible = true
            fresh.playback.titleTimeline.mapping.ranges[0].titleStartSeconds = 110
            fresh.playback.titleTimeline.mapping.ranges[0].titleEndSeconds = 112

            'bs:disable-next-line 1140
            applySnapshot(fresh)

            m.assertTrue(m.node.nodes.controls.timeline.elapsed = 110)
            m.assertTrue(m.node.playback.video.isSameNode(video))
            m.assertTrue(m.node.nodes.controls.visible)
            m.assertEqual(m.node.native.inFlight.requestId, "pending")
        end function

        @it("does not replace the player's timeline with an older revision")
        function _()
            snapshot = m.measuredSnapshot()
            snapshot.revision = 6
            snapshot.state = "playing"
            m.node.native.revision = 7
            m.node.nodes.controls.timeline = { available: true, elapsed: 120, duration: 200 }

            'bs:disable-next-line 1140
            applySnapshot(snapshot)

            m.assertEqual(m.node.nodes.controls.timeline.elapsed, 120)
            m.assertEqual(m.node.native.revision, 7)
        end function

        @it("reports an actual mapping gap as unavailable after refresh")
        function _()
            snapshot = m.measuredSnapshot()
            snapshot.revision = 7
            snapshot.state = "playing"
            snapshot.playback.titleTimeline.mapping.ranges[0].outputStartSeconds = 1
            m.node.native.revision = 7

            'bs:disable-next-line 1140
            applySnapshot(snapshot)

            m.assertFalse(m.node.nodes.controls.timeline.available)
            m.assertEqual(m.node.nodes.controls.timeline.reason, "unmapped-position")
        end function

        @it("rejects the previous timeline when resume creates a new playback identity")
        function _()
            m.node.native.snapshot = m.measuredSnapshot()
            m.node.playback.id = "cccccccc-cccc-cccc-cccc-cccccccccccc"

            'bs:disable-next-line 1140
            result = getTimelinePresentation()

            m.assertFalse(result.available)
            m.assertEqual(result.reason, "playback-id-mismatch")
        end function

        @it("maps continuous output across a source timestamp reset")
        function _()
            ranges = [
                { outputStartSeconds: 0, outputEndSeconds: 2, titleStartSeconds: 100, titleEndSeconds: 102 }
                { outputStartSeconds: 2, outputEndSeconds: 4, titleStartSeconds: 102, titleEndSeconds: 104 }
            ]

            'bs:disable-next-line 1140
            m.assertEqual(measuredTitlePosition(ranges, 3, 200), 103.0#)
        end function

        @it("preserves a one-tick output interval late in playback")
        function _()
            ranges = ParseJson("[{" + Chr(34) + "outputStartSeconds" + Chr(34) + ":600.0," + Chr(34) + "outputEndSeconds" + Chr(34) + ":600.000011111111," + Chr(34) + "titleStartSeconds" + Chr(34) + ":1000.0," + Chr(34) + "titleEndSeconds" + Chr(34) + ":1000.04}]", "d")

            'bs:disable-next-line 1140
            result = measuredTitlePosition(ranges, 600.0000055555555#, 2000.0#)

            m.assertTrue(result > 1000.019# and result < 1000.021#)
        end function

        @it("keeps other coverage available when a range is only one tick wide")
        function _()
            ranges = [
                { outputStartSeconds: 600.0#, outputEndSeconds: 600.000011111111#, titleStartSeconds: 1000.0#, titleEndSeconds: 1000.04# }
                { outputStartSeconds: 601.0#, outputEndSeconds: 603.0#, titleStartSeconds: 1001.0#, titleEndSeconds: 1003.0# }
            ]

            'bs:disable-next-line 1140
            m.assertEqual(measuredTitlePosition(ranges, 602.0#, 2000.0#), 1002.0#)
        end function

        @it("holds authored position for a duplicated output frame")
        function _()
            ranges = [{ outputStartSeconds: 2, outputEndSeconds: 3, titleStartSeconds: 102, titleEndSeconds: 102 }]

            'bs:disable-next-line 1140
            m.assertEqual(measuredTitlePosition(ranges, 2.5, 200), 102.0#)
        end function

        @it("leaves unknown gaps unavailable")
        function _()
            ranges = [
                { outputStartSeconds: 0, outputEndSeconds: 1, titleStartSeconds: 100, titleEndSeconds: 101 }
                { outputStartSeconds: 2, outputEndSeconds: 3, titleStartSeconds: 102, titleEndSeconds: 103 }
            ]

            'bs:disable-next-line 1140
            m.assertEqual(measuredTitlePosition(ranges, 1.5, 200), invalid)
        end function

        @it("does not extrapolate beyond published coverage")
        function _()
            ranges = [{ outputStartSeconds: 0, outputEndSeconds: 1, titleStartSeconds: 100, titleEndSeconds: 101 }]

            'bs:disable-next-line 1140
            m.assertEqual(measuredTitlePosition(ranges, 2, 200), invalid)
        end function

        @it("rejects overlapping ranges even when the position matches")
        function _()
            ranges = [
                { outputStartSeconds: 0, outputEndSeconds: 2, titleStartSeconds: 100, titleEndSeconds: 102 }
                { outputStartSeconds: 1, outputEndSeconds: 3, titleStartSeconds: 101, titleEndSeconds: 103 }
            ]

            'bs:disable-next-line 1140
            m.assertEqual(measuredTitlePosition(ranges, 1.5, 200), invalid)
        end function

    end class

end namespace
