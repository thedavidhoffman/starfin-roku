namespace tests

    @SGNode("LibraryColumnButton")
    @suite("LibraryColumnButton component")
    class LibraryColumnButtonTests extends rooibos.BaseTestSuite

        @describe("letter tile presentation")

        @it("renders its numeric content with the Letter Grid visual")
        function _()
            content = CreateObject("roSGNode", "ContentNode")
            content.title = "6"

            m.top.itemContent = content

            m.assertEqual(m.top.findNode("letterLabel").text, "6")
            m.assertEqual(m.top.findNode("background").uri, "pkg:/images/library/letter-tile-background.png")
        end function

        @it("shows the selected tile visual")
        function _()
            m.top.isSelected = true

            m.assertTrue(m.top.findNode("selectedBackground").visible)
        end function

        @it("shows the focus tile visual while focused")
        function _()
            m.top.setFocus(true)

            m.assertTrue(m.top.findNode("focusBackground").visible)
        end function

    end class

end namespace
