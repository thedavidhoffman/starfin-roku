namespace tests

    @SGNode("NextEpisodePromptContent")
    @suite("Next episode prompt content")
    class NextEpisodePromptContentTests extends rooibos.BaseTestSuite

        @describe("picker selection")

        @it("selects the 0 second preset")
        function _()
            content = CreateObject("roSGNode", "NextEpisodePromptContent")
            content.callFunc("configure", "0")

            content.findNode("promptOptions").itemSelected = 0

            m.assertEqual(content.selectedValue, "0")
        end function

        @it("selects the 15 second preset")
        function _()
            content = CreateObject("roSGNode", "NextEpisodePromptContent")
            content.callFunc("configure", "0")

            content.findNode("promptOptions").itemSelected = 1

            m.assertEqual(content.selectedValue, "15")
        end function

        @it("selects the 30 second preset")
        function _()
            content = CreateObject("roSGNode", "NextEpisodePromptContent")
            content.callFunc("configure", "0")

            content.findNode("promptOptions").itemSelected = 2

            m.assertEqual(content.selectedValue, "30")
        end function

        @it("selects the 45 second preset")
        function _()
            content = CreateObject("roSGNode", "NextEpisodePromptContent")
            content.callFunc("configure", "0")

            content.findNode("promptOptions").itemSelected = 3

            m.assertEqual(content.selectedValue, "45")
        end function

        @it("selects the 60 second preset")
        function _()
            content = CreateObject("roSGNode", "NextEpisodePromptContent")
            content.callFunc("configure", "0")

            content.findNode("promptOptions").itemSelected = 4

            m.assertEqual(content.selectedValue, "60")
        end function

        @it("selects the 75 second preset")
        function _()
            content = CreateObject("roSGNode", "NextEpisodePromptContent")
            content.callFunc("configure", "0")

            content.findNode("promptOptions").itemSelected = 5

            m.assertEqual(content.selectedValue, "75")
        end function

        @it("selects the 90 second preset")
        function _()
            content = CreateObject("roSGNode", "NextEpisodePromptContent")
            content.callFunc("configure", "0")

            content.findNode("promptOptions").itemSelected = 6

            m.assertEqual(content.selectedValue, "90")
        end function

        @it("selects the 105 second preset")
        function _()
            content = CreateObject("roSGNode", "NextEpisodePromptContent")
            content.callFunc("configure", "0")

            content.findNode("promptOptions").itemSelected = 7

            m.assertEqual(content.selectedValue, "105")
        end function

        @it("selects the 120 second preset")
        function _()
            content = CreateObject("roSGNode", "NextEpisodePromptContent")
            content.callFunc("configure", "0")

            content.findNode("promptOptions").itemSelected = 8

            m.assertEqual(content.selectedValue, "120")
        end function

        @it("restores the configured selection")
        function _()
            content = CreateObject("roSGNode", "NextEpisodePromptContent")

            content.callFunc("configure", "75")

            m.assertEqual(content.findNode("promptOptions").checkedItem, 5)
            m.assertEqual(content.findNode("promptOptions").content.getChildCount(), 9)
        end function

    end class

end namespace
