namespace tests

    @SGNode("NextEpisodePromptDialog")
    @suite("Next episode prompt dialog")
    class NextEpisodePromptDialogTests extends rooibos.BaseTestSuite

        @describe("picker results")

        @it("closes with the selected value")
        function _()
            dialog = CreateObject("roSGNode", "NextEpisodePromptDialog")
            m.top.appendChild(dialog)
            dialog.value = "60"
            dialog.callFunc("openPicker")
            content = dialog.callFunc("getContentComponent")

            content.findNode("promptOptions").itemSelected = 5

            m.assertEqual(dialog.selectedValue, "75")
            m.assertTrue(dialog.closeRequested)
            m.top.removeChild(dialog)
        end function

        @it("cancels without a selected value")
        function _()
            dialog = CreateObject("roSGNode", "NextEpisodePromptDialog")
            m.top.appendChild(dialog)
            dialog.value = "60"
            dialog.callFunc("openPicker")

            dialog.callFunc("closeDialog")

            m.assertEqual(dialog.selectedValue, "")
            m.assertTrue(dialog.closeRequested)
            m.top.removeChild(dialog)
        end function

    end class

end namespace
