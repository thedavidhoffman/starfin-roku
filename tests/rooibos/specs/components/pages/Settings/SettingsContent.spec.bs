import "pkg:/source/Char.bs"
namespace tests

    @SGNode("SettingsContent")
    @suite("SettingsContent component")
    class SettingsContentTests extends rooibos.BaseTestSuite

        protected override function beforeEach()
            m.originalMigrationComplete = m.global.settingsMigrationComplete
            m.global.settingsMigrationComplete = false
            m.stubCall(SettingsMigration.Migrate, true)
        end function

        protected override function afterEach()
            m.global.settingsMigrationComplete = m.originalMigrationComplete
        end function

        @describe("theme preference")

        @it("does not preview while moving focus")
        function _()
            m.top.themePreviewRequested = ""

            m.node.settingsControls.themeOptions.itemFocused = 2

            m.assertEqual(m.top.themePreviewRequested, "")
        end function

        @it("does not preview while loading saved values")
        function _()
            m.top.themePreviewRequested = ""
            m.top.accountKey = ""

            m.top.callFunc("loadSettingsValues")

            m.assertEqual(m.top.themePreviewRequested, "")
        end function

        @it("places all four themes in the Theme category with Blue selected by default")
        function _()
            m.top.accountKey = ""
            m.top.callFunc("loadSettingsValues")
            options = m.node.settingsControls.themeOptions

            m.assertEqual(options.checkedItem, 0)
            m.assertEqual(options.content.getChildCount(), 4)
            m.assertEqual(options.content.getChild(0).title, "Blue gradient")
            m.assertEqual(options.content.getChild(1).title, "Black gradient")
            m.assertEqual(options.content.getChild(2).title, "Grey gradient")
            m.assertEqual(options.content.getChild(3).title, "Pure Black")
            m.assertEqual(options.numRows, 4)
            m.assertEqual(m.top.findNode("themeCard").cardHeight, 292.0)
            m.assertEqual(m.top.findNode("watchedIndicatorCard").translation, [0.0, 308.0])
            m.assertEqual(m.node.categoryControls[2], [options, m.node.settingsControls.watchedIndicatorOptions, m.node.settingsControls.showUnwatchedEpisodeCountOptions])
            m.assertEqual(options.getParent(), m.top.findNode("themeCard"))
        end function

        @it("includes selected blue in save values")
        function _()
            m.node.settingsControls.themeOptions.itemSelected = 0
            'bs:disable-next-line 1140
            onThemeSelected()

            m.assertEqual(m.top.callFunc("getSettingsValues")[SettingsStore.Key.Theme], "blue")
            m.assertEqual(m.top.themePreviewRequested, "blue")
            m.assertEqual(m.node.settingsControls.themeOptions.checkedItem, 0)
        end function

        @it("restores the blue selection")
        function _()
            'bs:disable-next-line 1140
            setThemeOption("blue")

            m.assertEqual(m.node.settingsControls.themeOptions.checkedItem, 0)
            m.assertEqual(m.node.settingsControls.themeOptions.jumpToItem, 0)
        end function

        @it("includes selected black in save values")
        function _()
            m.node.settingsControls.themeOptions.itemSelected = 1
            'bs:disable-next-line 1140
            onThemeSelected()

            m.assertEqual(m.top.callFunc("getSettingsValues")[SettingsStore.Key.Theme], "black")
            m.assertEqual(m.top.themePreviewRequested, "black")
            m.assertEqual(m.node.settingsControls.themeOptions.checkedItem, 1)
        end function

        @it("restores the black selection")
        function _()
            'bs:disable-next-line 1140
            setThemeOption("black")

            m.assertEqual(m.node.settingsControls.themeOptions.checkedItem, 1)
            m.assertEqual(m.node.settingsControls.themeOptions.jumpToItem, 1)
        end function

        @it("includes selected grey in save values")
        function _()
            m.node.settingsControls.themeOptions.itemSelected = 2
            'bs:disable-next-line 1140
            onThemeSelected()

            m.assertEqual(m.top.callFunc("getSettingsValues")[SettingsStore.Key.Theme], "grey")
            m.assertEqual(m.top.themePreviewRequested, "grey")
            m.assertEqual(m.node.settingsControls.themeOptions.checkedItem, 2)
        end function

        @it("restores the grey selection")
        function _()
            'bs:disable-next-line 1140
            setThemeOption("grey")

            m.assertEqual(m.node.settingsControls.themeOptions.checkedItem, 2)
            m.assertEqual(m.node.settingsControls.themeOptions.jumpToItem, 2)
        end function

        @it("discards an unsaved theme on reload")
        function _()
            m.top.accountKey = ""
            m.node.settingsControls.themeOptions.itemSelected = 2
            'bs:disable-next-line 1140
            onThemeSelected()

            m.top.callFunc("loadSettingsValues")

            m.assertEqual(m.node.settingsControls.themeOptions.checkedItem, 0)
            m.assertEqual(m.top.callFunc("getSettingsValues")[SettingsStore.Key.Theme], "blue")
        end function

        @it("moves down from the episode card to Theme music")
        function _()
            'bs:disable-next-line 1140
            showCategory(1)
            'bs:disable-next-line 1140
            focusCategoryControl(2, 2)

            'bs:disable-next-line 1140
            handled = onKeyEvent("down", true)

            m.assertTrue(handled)
            m.assertTrue(m.node.settingsControls.themeMusicOptions.isInFocusChain())
        end function

        @it("moves up from Theme music back to the episode card")
        function _()
            'bs:disable-next-line 1140
            showCategory(1)
            'bs:disable-next-line 1140
            focusCategoryControl(2, 2)
            'bs:disable-next-line 1140
            onKeyEvent("down", true)

            'bs:disable-next-line 1140
            handled = onKeyEvent("up", true)

            m.assertTrue(handled)
            m.assertTrue(m.node.settingsControls.episodeShellLayoutOptions.isInFocusChain())
        end function

        @it("moves focus from account badge options to the API-key field")
        function _()
            'bs:disable-next-line 1140
            showCategory(m.node.categoryState.deviceOffset)
            'bs:disable-next-line 1140
            focusCategoryControl(0, 1)

            'bs:disable-next-line 1140
            handled = onKeyEvent("down", true)

            m.assertTrue(handled)
            m.assertTrue(m.node.settingsControls.tmdbApiKeyInput.isInFocusChain())
            m.assertTrue(m.node.settingsControls.tmdbApiKeyInput.hasFocusVisual)
        end function

        @it("moves focus from the API-key field back to account badge options")
        function _()
            'bs:disable-next-line 1140
            showCategory(m.node.categoryState.deviceOffset)
            'bs:disable-next-line 1140
            focusCategoryControl(0, 1)
            'bs:disable-next-line 1140
            focusCategoryControl(1, invalid)

            'bs:disable-next-line 1140
            handled = onKeyEvent("up", true)

            m.assertTrue(handled)
            m.assertTrue(m.node.settingsControls.displayAccountBadgeOptions.isInFocusChain())
            m.assertEqual(m.node.focusState.controlIndex, 0)
            m.assertFalse(m.node.settingsControls.tmdbApiKeyInput.hasFocusVisual)
        end function

        @it("loads the complete normalized settings snapshot")
        function _()
            expected = SettingsStore.Load(m.top.accountKey)

            m.top.callFunc("loadSettingsValues")

            m.assertEqual(m.node.settingsState.values, expected)
            m.assertEqual(m.top.callFunc("getSettingsValues"), expected)
        end function

        @it("opens the Theme category and focuses its options")
        function _()
            m.node.userCategoryList.itemSelected = 2
            'bs:disable-next-line 1140
            onUserCategorySelected()

            m.assertTrue(m.top.findNode("themePanel").visible)
            m.assertFalse(m.top.findNode("mediaShellPanel").visible)
            m.assertTrue(m.node.settingsControls.themeOptions.isInFocusChain())
        end function

        @describe("season summary preference")

        @it("loads enabled by default between scroll and episode images")
        function _()
            m.top.accountKey = "rooibos-summary-default"
            m.top.callFunc("loadSettingsValues")
            m.assertEqual(m.node.settingsControls.showSeasonSummaryCardOptions.checkedItem, 1)
            m.assertEqual(m.node.categoryControls[6][1], m.node.settingsControls.showSeasonSummaryCardOptions)
            m.assertEqual(m.top.findNode("tvSummaryCard").title, "Show season summary card in TV episode list")
        end function

        @it("includes an edited Off preference in save values")
        function _()
            m.node.settingsControls.showSeasonSummaryCardOptions.itemSelected = 0
            'bs:disable-next-line 1140
            onShowSeasonSummaryCardSelected()
            values = m.top.callFunc("getSettingsValues")
            m.assertEqual(values[SettingsStore.Key.ShowSeasonSummaryCard], "off")
        end function

        @it("includes an edited On preference in save values")
        function _()
            m.node.settingsControls.showSeasonSummaryCardOptions.itemSelected = 1
            'bs:disable-next-line 1140
            onShowSeasonSummaryCardSelected()
            values = m.top.callFunc("getSettingsValues")
            m.assertEqual(values[SettingsStore.Key.ShowSeasonSummaryCard], "on")
        end function

        @it("discards an unsaved preference when settings reload")
        function _()
            m.top.accountKey = "rooibos-summary-cancel"
            m.top.callFunc("loadSettingsValues")
            m.node.settingsControls.showSeasonSummaryCardOptions.itemSelected = 0
            'bs:disable-next-line 1140
            onShowSeasonSummaryCardSelected()

            m.top.callFunc("loadSettingsValues")
            m.assertEqual(m.node.settingsControls.showSeasonSummaryCardOptions.checkedItem, 1)
            m.assertEqual(SettingsStore.Load(m.top.accountKey)[SettingsStore.Key.ShowSeasonSummaryCard], "on")
        end function

        @describe("Home episode image preference")

        @it("loads disabled by default and includes the control in TV navigation")
        function _()
            m.top.accountKey = "rooibos-episode-images-default"
            m.top.callFunc("loadSettingsValues")
            m.assertEqual(m.node.settingsControls.homeEpisodeImagesOptions.checkedItem, 0)
            m.assertEqual(m.node.categoryControls[6][2], m.node.settingsControls.homeEpisodeImagesOptions)
            options = m.node.settingsControls.homeEpisodeImagesOptions.content
            m.assertEqual(options.getChild(0).title, "Series artwork")
            m.assertEqual(options.getChild(1).title, "Episode thumbnail with logo")
            m.assertEqual(options.getChild(2).title, "Episode thumbnail without logo")
        end function

        @it("stores an edited off selection in dialog values")
        function _()
            m.node.settingsControls.homeEpisodeImagesOptions.itemSelected = 0
            'bs:disable-next-line 1140
            onHomeEpisodeImagesSelected()
            values = m.top.callFunc("getSettingsValues")
            m.assertEqual(values[SettingsStore.Key.HomeEpisodeImages], "series")
            m.assertEqual(m.node.settingsControls.homeEpisodeImagesOptions.checkedItem, 0)
        end function

        @it("stores an edited on selection in dialog values")
        function _()
            m.node.settingsControls.homeEpisodeImagesOptions.itemSelected = 1
            'bs:disable-next-line 1140
            onHomeEpisodeImagesSelected()
            values = m.top.callFunc("getSettingsValues")
            m.assertEqual(values[SettingsStore.Key.HomeEpisodeImages], "episode-with-logo")
        end function

        @describe("category and panel setup")

        @it("initializes every settings category and matching panel")
        function _()
            deviceTitles = ["General", "Video", "Advanced"]
            userTitles = ["Libraries", "Media shell", "Theme", "Playback", "Subtitles", "Credits", "TV", "Screensaver"]

            m.assertEqual(m.node.categoryPanels.Count(), deviceTitles.Count() + userTitles.Count())
            m.assertEqual(m.node.categoryControls.Count(), deviceTitles.Count() + userTitles.Count())
            m.assertEqual(m.node.deviceCategoryList.content.getChildCount(), deviceTitles.Count())
            m.assertEqual(m.node.userCategoryList.content.getChildCount(), userTitles.Count())
            for i = 0 to deviceTitles.Count() - 1
                m.assertEqual(m.node.deviceCategoryList.content.getChild(i).title, deviceTitles[i])
            end for
            for i = 0 to userTitles.Count() - 1
                m.assertEqual(m.node.userCategoryList.content.getChild(i).title, userTitles[i])
            end for
        end function

        @it("builds subtitle burn-in options in display order")
        function _()
            options = m.node.settingsControls.subtitleBurnInOptions.content
            m.assertEqual(options.getChildCount(), 3)
            m.assertEqual(options.getChild(0).title, "During transcoding")
            m.assertEqual(options.getChild(1).title, "Prefer external subtitles")
            m.assertEqual(options.getChild(2).title, "Always burn in")
        end function

        @it("stores artwork grid changes in settings state")
        function _()
            m.node.settingsControls.librarySettingsGrid.selectionChanged = {
                settingKey: SettingsStore.Key.CollectionCardsLayout
                value: "detailed;2"
            }

            m.assertEqual(m.node.settingsState.values[SettingsStore.Key.CollectionCardsLayout], "detailed;2")
            m.assertEqual(m.node.settingsState.values[SettingsStore.Key.CollectionItemsLayout], "poster;6")
        end function

        @it("describes the focused Next item playback option")
        function _()
            m.node.settingsControls.nextItemPlaybackOptions.itemFocused = 1
            'bs:disable-next-line 1140
            onNextItemPlaybackFocused()

            m.assertTrue(Instr(1, m.node.nextItemPlaybackCard.description, "starts the next item immediately") > 0)
            m.assertTrue(Instr(1, m.node.nextItemPlaybackCard.description, "Up Next") > 0)

            m.node.settingsControls.nextItemPlaybackOptions.itemFocused = 0
            'bs:disable-next-line 1140
            onNextItemPlaybackFocused()

            m.assertTrue(Instr(1, m.node.nextItemPlaybackCard.description, "15-second countdown") > 0)
            m.assertEqual(Instr(1, m.node.nextItemPlaybackCard.description, "credits"), 0)
        end function

        @it("builds and stores Next item playback options")
        function _()
            options = m.node.settingsControls.nextItemPlaybackOptions.content
            m.assertEqual(options.getChild(0).title, "Show " + Char.DoubleQuote + "Up Next" + Char.DoubleQuote)
            m.assertEqual(options.getChild(1).title, "Play next immediately")

            m.node.settingsControls.nextItemPlaybackOptions.itemSelected = 1
            'bs:disable-next-line 1140
            onNextItemPlaybackSelected()

            m.assertEqual(m.node.settingsState.values[SettingsStore.Key.NextItemPlayback], NextItemPlayback.Mode.PlayNextImmediately)
        end function

        @it("loads all artwork values into the grid")
        function _()
            m.node.settingsState.values = SettingsStore.Defaults()
            m.node.settingsState.values[SettingsStore.Key.MusicVideosLayout] = "thumbnail;3"

            'bs:disable-next-line 1140
            selections = getLibrarySettingsValues()

            m.assertEqual(selections.Count(), 8)
            m.assertEqual(selections[SettingsStore.Key.MusicVideosLayout], "thumbnail;3")
            m.assertEqual(selections[SettingsStore.Key.HomeVideosLayout], "poster;6")
        end function

        @it("maps and stores subtitle burn-in modes")
        function _()
            'bs:disable-next-line 1140
            setSubtitleBurnInOption(SubtitleBurnIn.Mode.Always)
            m.assertEqual(m.node.settingsControls.subtitleBurnInOptions.checkedItem, 2)

            m.node.settingsControls.subtitleBurnInOptions.itemSelected = 1
            'bs:disable-next-line 1140
            onSubtitleBurnInSelected()
            m.assertEqual(m.node.settingsState.values[SettingsStore.Key.SubtitleBurnInMode], SubtitleBurnIn.Mode.PreferExternal)
        end function

        @it("updates the subtitle description for the focused option")
        function _()
            m.node.settingsControls.subtitleBurnInOptions.itemFocused = 2
            'bs:disable-next-line 1140
            onSubtitleBurnInFocused()
            m.assertTrue(Instr(1, m.node.subtitleBurnInCard.description, "most reliable synchronization") > 0)
        end function

        @it("shows only the selected category panel")
        function _()
            resetIndex = m.node.categoryState.resetIndex

            'bs:disable-next-line 1140
            showCategory(resetIndex)

            m.assertEqual(m.node.focusState.categoryIndex, resetIndex)
            for i = 0 to m.node.categoryPanels.Count() - 1
                m.assertEqual(m.node.categoryPanels[i].visible, i = resetIndex)
            end for
        end function

        @it("updates the panel explicitly when crossing category-list boundaries")
        function _()
            lastUserIndex = m.node.categoryState.lastUserIndex
            deviceOffset = m.node.categoryState.deviceOffset
            m.node.userCategoryList.jumpToItem = lastUserIndex
            m.node.userCategoryList.setFocus(true)
            'bs:disable-next-line 1140
            handled = onKeyEvent("down", true)
            m.assertTrue(handled)
            m.assertEqual(m.node.focusState.categoryIndex, deviceOffset)
            m.assertTrue(m.node.categoryPanels[deviceOffset].visible)

            m.node.deviceCategoryList.jumpToItem = 0
            m.node.deviceCategoryList.setFocus(true)
            'bs:disable-next-line 1140
            handled = onKeyEvent("up", true)
            m.assertTrue(handled)
            m.assertEqual(m.node.focusState.categoryIndex, lastUserIndex)
            m.assertTrue(m.node.categoryPanels[lastUserIndex].visible)
        end function

        @it("Up from the first user category wraps to the last device category")
        function _()
            m.node.userCategoryList.jumpToItem = 0
            m.node.userCategoryList.setFocus(true)

            'bs:disable-next-line 1140
            handled = onKeyEvent("up", true)

            lastCategory = m.node.categoryState.deviceOffset + m.node.categoryState.deviceCount - 1
            m.assertTrue(handled)
            m.assertTrue(m.node.deviceCategoryList.isInFocusChain())
            m.assertEqual(m.node.deviceCategoryList.itemFocused, m.node.categoryState.deviceCount - 1)
            m.assertEqual(m.node.focusState.categoryIndex, lastCategory)
            m.assertTrue(m.node.categoryPanels[lastCategory].visible)
            m.assertFalse(m.node.categoryPanels[0].visible)
        end function

        @it("Down from the last device category wraps to the first user category")
        function _()
            m.node.deviceCategoryList.jumpToItem = m.node.categoryState.deviceCount - 1
            m.node.deviceCategoryList.setFocus(true)

            'bs:disable-next-line 1140
            handled = onKeyEvent("down", true)

            m.assertTrue(handled)
            m.assertTrue(m.node.userCategoryList.isInFocusChain())
            m.assertEqual(m.node.userCategoryList.itemFocused, 0)
            m.assertEqual(m.node.focusState.categoryIndex, 0)
            m.assertTrue(m.node.categoryPanels[0].visible)
            m.assertFalse(m.node.categoryPanels[m.node.categoryPanels.Count() - 1].visible)
        end function

        @describe("screensaver settings")

        @it("builds screensaver type and delay options in display order")
        function _()
            typeOptions = m.node.settingsControls.screensaverTypeOptions.content
            delayOptions = m.node.settingsControls.screensaverDelayOptions.content

            m.assertEqual(typeOptions.getChildCount(), 3)
            m.assertEqual(typeOptions.getChild(0).title, "None")
            m.assertEqual(typeOptions.getChild(1).title, "Bouncing artwork")
            m.assertEqual(typeOptions.getChild(2).title, "Starfield")
            m.assertEqual(delayOptions.getChildCount(), 4)
            m.assertEqual(delayOptions.getChild(0).title, "1 minute")
            m.assertEqual(delayOptions.getChild(1).title, "5 minutes")
            m.assertEqual(delayOptions.getChild(2).title, "15 minutes")
            m.assertEqual(delayOptions.getChild(3).title, "30 minutes")
        end function

        @it("maps stored screensaver types to their checked options")
        function _()
            'bs:disable-next-line 1140
            setScreensaverTypeOption("roku")
            m.assertEqual(m.node.settingsControls.screensaverTypeOptions.checkedItem, 0)

            'bs:disable-next-line 1140
            setScreensaverTypeOption("bounce")
            m.assertEqual(m.node.settingsControls.screensaverTypeOptions.checkedItem, 1)

            'bs:disable-next-line 1140
            setScreensaverTypeOption("starfield")
            m.assertEqual(m.node.settingsControls.screensaverTypeOptions.checkedItem, 2)

            'bs:disable-next-line 1140
            setScreensaverTypeOption("unknown")
            m.assertEqual(m.node.settingsControls.screensaverTypeOptions.checkedItem, 0)
        end function

        @it("maps stored delays to their checked options with a one-minute fallback")
        function _()
            values = ["1", "5", "15", "30"]
            for i = 0 to values.Count() - 1
                'bs:disable-next-line 1140
                setScreensaverDelayOption(values[i])
                m.assertEqual(m.node.settingsControls.screensaverDelayOptions.checkedItem, i)
            end for

            'bs:disable-next-line 1140
            setScreensaverDelayOption("unsupported")
            m.assertEqual(m.node.settingsControls.screensaverDelayOptions.checkedItem, 0)
        end function

        @it("stores selected screensaver type and delay values")
        function _()
            m.node.settingsControls.screensaverTypeOptions.itemSelected = 1
            'bs:disable-next-line 1140
            onScreensaverTypeSelected()
            m.assertEqual(m.node.settingsState.values[SettingsStore.Key.ScreensaverType], "bounce")

            m.node.settingsControls.screensaverTypeOptions.itemSelected = 2
            'bs:disable-next-line 1140
            onScreensaverTypeSelected()
            m.assertEqual(m.node.settingsState.values[SettingsStore.Key.ScreensaverType], "starfield")

            m.node.settingsControls.screensaverTypeOptions.itemSelected = 0
            'bs:disable-next-line 1140
            onScreensaverTypeSelected()
            m.assertEqual(m.node.settingsState.values[SettingsStore.Key.ScreensaverType], "none")

            m.node.settingsControls.screensaverDelayOptions.itemSelected = 3
            'bs:disable-next-line 1140
            onScreensaverDelaySelected()
            m.assertEqual(m.node.settingsState.values[SettingsStore.Key.ScreensaverDelay], "30")
        end function

        @it("includes screensaver values in settings output")
        function _()
            m.node.settingsState.values = SettingsStore.Defaults()
            m.node.settingsState.values[SettingsStore.Key.ScreensaverType] = "starfield"
            m.node.settingsState.values[SettingsStore.Key.ScreensaverDelay] = "15"

            'bs:disable-next-line 1140
            settings = getSettingsValues()

            m.assertEqual(settings[SettingsStore.Key.ScreensaverType], "starfield")
            m.assertEqual(settings[SettingsStore.Key.ScreensaverDelay], "15")
            m.assertEqual(settings[SettingsStore.Key.TvLibraryLayout], "poster;6")
            m.assertEqual(settings[SettingsStore.Key.VideoStreamingMode], PlaybackMode.Mode.Automatic)
            m.assertEqual(settings[SettingsStore.Key.SubtitleBurnInMode], SubtitleBurnIn.Mode.DuringTranscoding)
        end function

        @describe("reset confirmation")

        @it("switches between reset confirmation and normal reset controls")
        function _()
            resetIndex = m.node.categoryState.resetIndex
            m.node.focusState.categoryIndex = resetIndex

            'bs:disable-next-line 1140
            onResetStarfinSelected()
            m.assertTrue(m.node.resetStarfinState.confirmationVisible)
            m.assertFalse(m.node.settingsControls.resetStarfinButton.visible)
            m.assertTrue(m.node.resetStarfinState.confirmationGroup.visible)
            m.assertEqual(m.node.categoryControls[resetIndex].Count(), 2)

            'bs:disable-next-line 1140
            onAbortResetSelected()
            m.assertFalse(m.node.resetStarfinState.confirmationVisible)
            m.assertTrue(m.node.settingsControls.resetStarfinButton.visible)
            m.assertFalse(m.node.resetStarfinState.confirmationGroup.visible)
            m.assertEqual(m.node.categoryControls[resetIndex].Count(), 1)

            ' The Abort selection event can continue bubbling after focus returns
            ' to the non-list Reset Starfin button.
            'bs:disable-next-line 1140
            m.assertFalse(onKeyEvent("OK", true))
        end function

        @it("includes the no-logo preference in save values")
        function _()
            m.node.settingsControls.homeEpisodeImagesOptions.itemSelected = 2

            'bs:disable-next-line 1140
            onHomeEpisodeImagesSelected()

            values = m.top.callFunc("getSettingsValues")
            m.assertEqual(values[SettingsStore.Key.HomeEpisodeImages], "episode-without-logo")
            m.assertEqual(m.node.settingsControls.homeEpisodeImagesOptions.checkedItem, 2)
        end function

        @it("selects the saved series option")
        function _()
            'bs:disable-next-line 1140
            setHomeEpisodeImagesOption("series")

            m.assertEqual(m.node.settingsControls.homeEpisodeImagesOptions.checkedItem, 0)
            m.assertEqual(m.node.settingsControls.homeEpisodeImagesOptions.jumpToItem, 0)
        end function

        @it("selects the saved episode-with-logo option")
        function _()
            'bs:disable-next-line 1140
            setHomeEpisodeImagesOption("episode-with-logo")

            m.assertEqual(m.node.settingsControls.homeEpisodeImagesOptions.checkedItem, 1)
            m.assertEqual(m.node.settingsControls.homeEpisodeImagesOptions.jumpToItem, 1)
        end function

        @it("selects the saved episode-without-logo option")
        function _()
            'bs:disable-next-line 1140
            setHomeEpisodeImagesOption("episode-without-logo")

            m.assertEqual(m.node.settingsControls.homeEpisodeImagesOptions.checkedItem, 2)
            m.assertEqual(m.node.settingsControls.homeEpisodeImagesOptions.jumpToItem, 2)
        end function

        @it("falls back to series for an unsupported value")
        function _()
            'bs:disable-next-line 1140
            setHomeEpisodeImagesOption("unknown")

            m.assertEqual(m.node.settingsControls.homeEpisodeImagesOptions.checkedItem, 0)
            m.assertEqual(m.node.settingsControls.homeEpisodeImagesOptions.jumpToItem, 0)
        end function

        @describe("next episode prompt seconds")

        @it("shows every preset with Off selected by default")
        function _()
            m.top.accountKey = ""
            m.top.callFunc("loadSettingsValues")
            options = m.node.settingsControls.nextEpisodePromptSecondsOptions

            m.assertEqual(options.checkedItem, 0)
            m.assertEqual(options.getParent().title, "Show next episode prompt")
            m.assertEqual(m.top.findNode("nextEpisodePromptCard").description, "When Jellyfin hasn’t identified where an episode’s closing credits begin, show the next episode prompt this long before the episode ends.")
            m.assertEqual(options.numRows, 9)
            m.assertEqual(options.content.getChildCount(), 9)
            titles = ["Off", "15 seconds", "30 seconds", "45 seconds", "60 seconds", "75 seconds", "90 seconds", "105 seconds", "120 seconds"]
            for i = 0 to titles.Count() - 1
                m.assertEqual(options.content.getChild(i).title, titles[i])
            end for
            m.assertEqual(m.node.userCategoryList.numRows, 8)
            m.assertEqual(m.node.deviceCategoryList.translation, [38.0, 522.0])
        end function

        @it("saves the 0 second preset")
        function _()
            m.node.settingsControls.nextEpisodePromptSecondsOptions.itemSelected = 0
