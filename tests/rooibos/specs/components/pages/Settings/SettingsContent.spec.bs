        @it("uses matching card heights and original spacing on separate pages")
        function _()
            movie = m.top.findNode("movieShellLayoutCard")
            music = m.top.findNode("musicShellLayoutCard")
            series = m.top.findNode("seriesShellLayoutCard")
            episode = m.top.findNode("episodeShellLayoutCard")
            themeMusic = m.top.findNode("themeMusicCard")

            m.assertEqual(movie.cardHeight, 292.0)
            m.assertEqual(music.cardHeight, movie.cardHeight)
            m.assertEqual(series.cardHeight, 240.0)
            m.assertEqual(episode.cardHeight, series.cardHeight)
            m.assertEqual(series.translation, [0.0, 308.0])
            m.assertEqual(episode.translation, [588.0, 308.0])
            m.assertEqual(themeMusic.translation, [0.0, 0.0])
            m.assertEqual(themeMusic.cardHeight, 188.0)
            m.assertEqual(movie.headingY, 24.0)
            m.assertEqual(m.top.findNode("movieShellLayoutOptions").translation, [56.0, 68.0])
            m.assertEqual(movie.title, "Movie Layout")
            m.assertEqual(music.title, "Music Layout")
            m.assertEqual(series.title, "TV Series Layout")
            m.assertEqual(episode.title, "TV Episode Layout")
            m.assertEqual(themeMusic.title, "Theme music")
        end function

