            m.assertEqual(controls, [m.top.findNode("tvEpisodeListDisplayOptions"), m.top.findNode("showSeasonSummaryCardOptions"), m.top.findNode("homeEpisodeImagesOptions")])
            m.assertEqual(m.top.findNode("tvScrollCard").translation, [0.0, 0.0])
            m.assertEqual(m.top.findNode("tvSummaryCard").translation, [0.0, 204.0])
            m.assertEqual(m.top.findNode("tvArtworkCard").translation, [0.0, 408.0])
            m.assertInvalid(m.top.findNode("tvPageNumber"))
        end function

        @it("places the two badge cards side by side in Theme")
        function _()
            watched = m.top.findNode("watchedIndicatorCard")
            count = m.top.findNode("unwatchedEpisodeCountCard")
            options = m.top.findNode("showUnwatchedEpisodeCountOptions")

            m.assertTrue(watched.cardWidth < count.cardWidth)
            m.assertEqual(watched.cardWidth + count.cardWidth + 16, 1160.0)
            m.assertEqual(count.translation, [watched.cardWidth + 16, 308.0])
            m.assertEqual(count.getParent(), m.top.findNode("themePanel"))
            m.assertEqual(options.content.getChildCount(), 3)
            m.assertEqual(options.content.getChild(0).title, "Off")
            m.assertEqual(options.content.getChild(1).title, "Subtle")
            m.assertEqual(options.content.getChild(2).title, "High contrast")
        end function

