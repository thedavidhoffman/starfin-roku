        @it("leaves equal space after the headings in the two badge cards")
        function _()
            watched = m.top.findNode("watchedIndicatorCard")
            count = m.top.findNode("unwatchedEpisodeCountCard")
            measurement = CreateObject("roSGNode", "Label")
            heading = watched.findNode("heading")
            measurement.font = heading.font
            measurement.text = heading.text
            watchedMargin = watched.cardWidth - heading.translation[0] - measurement.boundingRect().width
            heading = count.findNode("heading")
            measurement.font = heading.font
            measurement.text = heading.text
            countMargin = count.cardWidth - heading.translation[0] - measurement.boundingRect().width

            m.assertEqual(watchedMargin, countMargin)
            m.assertTrue(watchedMargin >= 24)
        end function

    end class

end namespace
