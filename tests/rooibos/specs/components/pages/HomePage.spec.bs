        @it("removes an empty row")
        function _()
            'bs:disable-next-line 1140
            addRow("nextUp", "Next Up", [{ Id: "episode-1", Type: "Episode", ImageTags: {} }])
            'bs:disable-next-line 1140
            addRow("nextUp", "Next Up", [])

            m.assertFalse(m.node.homeState.rows.DoesExist("nextUp"))
        end function

        @it("renders rows in configured order")
        function _()
            'bs:disable-next-line 1140
            addRow("nextUp", "Next Up", [{ Id: "episode-1", Type: "Episode", ImageTags: {} }])
            'bs:disable-next-line 1140
            addRow("libraries", "My Media", [m.createLibrary("movies-1", "movies")])

            'bs:disable-next-line 1140
            renderRows(false)

            m.assertEqual(m.top.findNode("shelvesGroup").getChildCount(), 2)
            m.assertEqual(m.top.findNode("shelvesGroup").getChild(0).rowContent.rowKey, "libraries")
            m.assertEqual(m.top.findNode("shelvesGroup").getChild(1).rowContent.rowKey, "nextUp")
        end function

        @it("filters Next Up items already represented by item id")
        function _()
            m.node.homeState.playbackRows.continueWatchingItems = [{ Id: "episode-1", SeriesId: "series-1" }]
            m.node.homeState.playbackRows.nextUpItems = [{ Id: "episode-1" }, { Id: "episode-2", SeriesId: "series-2" }]

            'bs:disable-next-line 1140
            items = getFilteredNextUpItems()

            m.assertEqual(items.Count(), 1)
            m.assertEqual(items[0].Id, "episode-2")
        end function

        @it("filters Next Up items already represented by series id")
        function _()
            m.node.homeState.playbackRows.continueWatchingItems = [{ Id: "episode-1", SeriesId: "series-1" }]
            m.node.homeState.playbackRows.nextUpItems = [{ Id: "episode-2", SeriesId: "series-1" }, { Id: "episode-3", SeriesId: "series-2" }]

            'bs:disable-next-line 1140
            items = getFilteredNextUpItems()

            m.assertEqual(items.Count(), 1)
            m.assertEqual(items[0].Id, "episode-3")
        end function

        @describe("refresh lifecycle")

        @it("adds the current generation and session identity to task requests")
        function _()
            m.node.homeState.queryId = 7
            m.node.homeState.sessionKey = "account-1"

            'bs:disable-next-line 1140
            request = buildHomeTaskRequest(m.node.homeState.request)

            m.assertEqual(request.homeQueryId, 7)
            m.assertEqual(request.homeSessionKey, "account-1")
        end function

        @it("accepts only the currently owned task for the active refresh")
        function _()
            task = CreateObject("roSGNode", "HomeLibrariesTask")
            task.request = { homeQueryId: 7, homeSessionKey: "account-1" }
            m.top.appendChild(task)
            m.node.tasks.libraries = task
            m.node.homeState.queryId = 7
            m.node.homeState.sessionKey = "account-1"

            'bs:disable-next-line 1140
            current = isCurrentHomeTask(task, "libraries")

            m.assertTrue(current)
            'bs:disable-next-line 1140
            cleanupHomeTasks()
        end function

        @it("rejects a task from an earlier refresh generation")
        function _()
            task = CreateObject("roSGNode", "HomeLibrariesTask")
            task.request = { homeQueryId: 6, homeSessionKey: "account-1" }
            m.top.appendChild(task)
            m.node.tasks.libraries = task
            m.node.homeState.queryId = 7
            m.node.homeState.sessionKey = "account-1"

            'bs:disable-next-line 1140
            current = isCurrentHomeTask(task, "libraries")

            m.assertFalse(current)
            'bs:disable-next-line 1140
            cleanupHomeTasks()
        end function

        @it("does not complete the active refresh from a stale response")
        function _()
            task = CreateObject("roSGNode", "ContinueWatchingTask")
            task.request = { homeQueryId: 6, homeSessionKey: "account-1" }
            task.observeField("response", "onSectionResponse")
            m.top.appendChild(task)
            m.node.tasks.continueWatching = task
            m.node.homeState.queryId = 7
            m.node.homeState.sessionKey = "account-1"
            m.node.homeState.refresh.pendingCore = { continueWatching: true }

            task.response = { ok: true, action: "continueWatching", payload: { Items: [{ Id: "stale-item" }] } }

            m.assertTrue(m.node.homeState.refresh.pendingCore.DoesExist("continueWatching"))
            m.assertEqual(m.node.homeState.playbackRows.continueWatchingItems.Count(), 0)
            'bs:disable-next-line 1140
            cleanupHomeTasks()
        end function

        @it("rejects a task from an earlier account session")
        function _()
            task = CreateObject("roSGNode", "HomeLibrariesTask")
            task.request = { homeQueryId: 7, homeSessionKey: "account-1" }
            m.top.appendChild(task)
            m.node.tasks.libraries = task
            m.node.homeState.queryId = 7
            m.node.homeState.sessionKey = "account-2"

            'bs:disable-next-line 1140
            current = isCurrentHomeTask(task, "libraries")

            m.assertFalse(current)
            'bs:disable-next-line 1140
            cleanupHomeTasks()
        end function

        @it("removes superseded core and latest-media tasks")
        function _()
            coreTask = CreateObject("roSGNode", "HomeLibrariesTask")
            coreTask.id = "ownedCoreTask"
            latestTask = CreateObject("roSGNode", "LatestMediaTask")
            latestTask.id = "ownedLatestTask"
            m.top.appendChild(coreTask)
            m.top.appendChild(latestTask)
            m.node.tasks.libraries = coreTask
            m.node.homeState.latestTasks = [latestTask]

            'bs:disable-next-line 1140
            cleanupHomeTasks()

            m.assertInvalid(m.top.findNode("ownedCoreTask"))
            m.assertInvalid(m.top.findNode("ownedLatestTask"))
            m.assertEqual(m.node.tasks.Count(), 0)
            m.assertEqual(m.node.homeState.latestTasks.Count(), 0)
        end function

        @describe("focus and keyboard behavior")

        @it("moves down to the next shelf")
        function _()
            m.renderTwoRows()

            'bs:disable-next-line 1140
            handled = onKeyEvent("down", true)

            m.assertTrue(handled)
            m.assertEqual(m.node.homeState.focusedShelfIndex, 1)
        end function

        @it("emits upward focus exit from the first shelf")
        function _()
            m.renderTwoRows()
            m.top.focusExitUp = false

            'bs:disable-next-line 1140
            handled = onKeyEvent("up", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.focusExitUp)
        end function

        @it("does not move below the last shelf")
        function _()
            m.renderTwoRows()
            'bs:disable-next-line 1140
            focusShelf(1)

            'bs:disable-next-line 1140
            handled = onKeyEvent("down", true)

            m.assertFalse(handled)
            m.assertEqual(m.node.homeState.focusedShelfIndex, 1)
        end function

        @it("ignores released keys")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("up", false)

            m.assertFalse(handled)
        end function

        function captureStatusMessage(message)
            capture = getGlobalAa().homeStatusCapture
            capture.message = message
            capture.writes += 1
        end function

        function captureStatusClear()
            capture = getGlobalAa().homeStatusCapture
            capture.message = ""
            capture.clears += 1
        end function

        function createControlledHomeTask(action, componentName, responseHandler, request)
            task = CreateObject("roSGNode", "Group")
            task.addFields({ request: {}, response: {}, control: "" })
            context = getGlobalAa().homeTestContext
            context.top.appendChild(task)
            context.tasks[action] = task
            task.observeField("response", responseHandler)
            controlledRequest = {}
            controlledRequest.Append(request)
            controlledRequest.homeQueryId = context.homeState.queryId
            controlledRequest.homeSessionKey = context.homeState.sessionKey
            task.request = controlledRequest
        end function

        function startPermissionRefresh(permissions as dynamic)
            m.node.homeState.request.permissions = permissions
            m.top.ready = false
            'bs:disable-next-line 1140
            refreshHomeData(true)
        end function

        function finishOtherHomeRows()
            for each action in ["libraries", "continueWatching", "continueListening", "nextUp"]
                items = []
                if action = "continueWatching" then items = [{ Id: "movie", Name: "Fixture", Type: "Movie", ImageTags: {} }]
                m.node.tasks[action].response = { ok: true, action: action, payload: { Items: items } }
            end for
        end function

        function renderTwoRows()
            'bs:disable-next-line 1140
            addRow("libraries", "My Media", [m.createLibrary("movies-1", "movies")])
            'bs:disable-next-line 1140
            addRow("nextUp", "Next Up", [{ Id: "episode-1", Type: "Episode", ImageTags: {} }])
            'bs:disable-next-line 1140
            renderRows(false)
            m.node.homeState.focusedShelfIndex = 0
        end function

        function createLibrary(id as string, collectionType as string) as object
            return { Id: id, Name: id, Type: "CollectionFolder", CollectionType: collectionType, ImageTags: {}, BackdropImageTags: [] }
        end function

        @it("combines refresh failures after the last core response")
        function _()
            m.stubCall(AppMessage.Show, m.captureStatusMessage)
            'bs:disable-next-line 1001
            m.stubCall(runHomeTask, m.createControlledHomeTask)
            m.startPermissionRefresh({ canAccessLiveTv: false })
            m.node.tasks.continueWatching.response = { ok: false, action: "continueWatching", failureKind: "accessDenied" }
            m.node.tasks.nextUp.response = { ok: false, action: "nextUp", failureKind: "timeout" }
            m.assertEqual(getGlobalAa().homeStatusCapture.writes, 0)
            m.node.tasks.libraries.response = { ok: true, action: "libraries", payload: { Items: [] } }
            m.node.tasks.continueListening.response = { ok: true, action: "continueListening", payload: { Items: [] } }

            m.assertTrue(m.top.ready)
            m.assertEqual(getGlobalAa().homeStatusCapture.writes, 1)
            m.assertEqual(getGlobalAa().homeStatusCapture.message, "Unable to load Continue Watching. The server denied access." + Chr(10) + Chr(10) + "Unable to load Next Up. The server took too long to respond.")
        end function

        @describe("refresh message presentation lifecycle")

        @it("discards collected and late core failures after leaving Home while rows finish loading")
        function _()
            m.stubCall(AppMessage.Show, m.captureStatusMessage)
            'bs:disable-next-line 1001
            m.stubCall(runHomeTask, m.createControlledHomeTask)
            m.startPermissionRefresh({ canAccessLiveTv: false })
            m.node.tasks.nextUp.response = { ok: false, action: "nextUp", failureKind: "timeout" }

            m.top.callFunc("suppressRefreshMessages")
            m.node.tasks.continueListening.response = { ok: false, action: "continueListening", failureKind: "timeout" }
            m.node.tasks.continueWatching.response = { ok: true, action: "continueWatching", payload: { Items: [{ Id: "movie", Name: "Fixture", Type: "Movie", ImageTags: {} }] } }
            m.node.tasks.libraries.response = { ok: true, action: "libraries", payload: { Items: [] } }

            m.assertTrue(m.top.ready)
            m.assertTrue(m.node.homeState.rows.DoesExist("continueWatching"))
            m.assertEqual(m.node.homeState.refresh.messages.Count(), 0)
            m.assertEqual(getGlobalAa().homeStatusCapture.writes, 0)
        end function

        @it("discards a late Recently Added failure after leaving Home")
        function _()
            m.stubCall(AppMessage.Show, m.captureStatusMessage)
            task = CreateObject("roSGNode", "LatestMediaTask")
            task.request = { homeQueryId: m.node.homeState.queryId, homeSessionKey: m.node.homeState.sessionKey, parentId: "movies" }
            m.node.homeState.latestLibraries = { movies: { name: "Movies" } }
            m.node.homeState.latestTasks = [task]
            m.top.appendChild(task)
            task.observeField("response", "onDynamicLatestMediaResponse")

            m.top.callFunc("suppressRefreshMessages")
            task.response = { ok: false, action: "latestMedia", failureKind: "serverError" }

            m.assertEqual(m.node.homeState.latestTasks.Count(), 0)
            m.assertEqual(m.node.homeState.refresh.messages.Count(), 0)
            m.assertEqual(getGlobalAa().homeStatusCapture.writes, 0)
        end function

        @it("permits messages from a new refresh after an outgoing refresh was suppressed")
        function _()
            m.stubCall(AppMessage.Show, m.captureStatusMessage)
            'bs:disable-next-line 1001
            m.stubCall(runHomeTask, m.createControlledHomeTask)
            m.top.callFunc("suppressRefreshMessages")

            m.startPermissionRefresh({ canAccessLiveTv: false })
            m.node.tasks.continueWatching.response = { ok: false, action: "continueWatching", failureKind: "timeout" }
            for each action in ["nextUp", "continueListening", "libraries"]
                m.node.tasks[action].response = { ok: true, action: action, payload: { Items: [] } }
            end for

            m.assertEqual(getGlobalAa().homeStatusCapture.writes, 1)
            m.assertEqual(getGlobalAa().homeStatusCapture.message, "Unable to load Continue Watching. The server took too long to respond.")
        end function

    end class

end namespace
