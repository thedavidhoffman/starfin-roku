        function startFocusRefresh(blocking as boolean)
            m.top.ready = false
            'bs:disable-next-line 1001
            m.stubCall(runHomeTask, m.createControlledHomeTask)
            m.node.homeState.request.permissions = { canAccessLiveTv: false }
            'bs:disable-next-line 1140
            refreshHomeData(blocking)
            if blocking = false then m.top.callFunc("focusHome")
        end function

