namespace tests

    @SGNode("HomePage")
    @suite("HomePage component")
    class HomePageTests extends rooibos.BaseTestSuite

        protected override function beforeEach()
            m.focusTestSurface = invalid
            m.top.visible = true
            m.node.homeState.request = { server: "http://server", token: "token", userId: "user" }
            m.node.homeState.rows = {}
            m.node.homeState.sectionItems = {}
            m.node.homeState.latestLibraries = {}
            m.node.homeState.sync = HomeRefresh.Create()
            m.node.homeState.sync.active = true
            m.top.settings = { "home-episode-images": "episode-with-logo" }
            m.node.homeState.episodeImageMode = "episode-with-logo"
            m.node.homeState.refresh = { blocking: false, ownsSpinner: false, pendingCore: {}, messages: [] }
            m.node.homeState.sectionItems.continueWatching = []
            m.node.homeState.sectionItems.nextUp = []
            m.node.homeState.focusedShelfIndex = 0
            m.node.homeState.playbackOverlay = { open: false, returnTarget: invalid }
            m.top.overlayRequested = invalid
            m.top.selectedLibrary = invalid
            m.top.selectedHomeMediaLibrary = invalid
            m.top.selectedHomeMediaVideo = invalid
            m.top.selectedHomeMediaPhoto = invalid

            scene = m.top.getScene()
            getGlobalAa().homeTestContext = m.node
            getGlobalAa().homeStatusCapture = { message: "", writes: 0, clears: 0 }
            if scene.findNode("loadingSpinner") = invalid then
                loadingSpinnerNode = CreateObject("roSGNode", "Spinner")
                loadingSpinnerNode.id = "loadingSpinner"
                scene.appendChild(loadingSpinnerNode)
            end if
        end function

        protected override function afterEach()
            'bs:disable-next-line 1140
            cleanupHomeTasks()
            Spinner.HideBlocking()
            if m.focusTestSurface <> invalid then m.top.getScene().removeChild(m.focusTestSurface)
            getGlobalAa().Delete("homeTestContext")
            getGlobalAa().Delete("homeStatusCapture")
        end function

        @describe("Home episode artwork")

        @it("uses episode stills for continueWatching when on")
        function _()
            m.top.settings = { "home-episode-images": "episode-with-logo" }
            item = { Id: "episode", Type: "Episode", ImageTags: { Primary: "still" }, ParentThumbItemId: "series", ParentThumbImageTag: "thumb", ParentLogoItemId: "series", ParentLogoImageTag: "logo" }
            'bs:disable-next-line 1140
            row = buildRowContent("continueWatching", "Row", [item])
            m.assertTrue(Instr(1, row.getChild(0).HDPosterUrl, "/episode/Images/Primary") > 0)
            m.assertTrue(Instr(1, row.getChild(0).logoOverlayUrl, "/series/Images/Logo?tag=logo") > 0)
        end function

        @it("uses series artwork for continueWatching when off")
        function _()
            m.top.settings = { "home-episode-images": "series" }
            item = { Id: "episode", Type: "Episode", ImageTags: { Primary: "still" }, ParentThumbItemId: "series", ParentThumbImageTag: "thumb", ParentLogoItemId: "series", ParentLogoImageTag: "logo" }
            'bs:disable-next-line 1140
            row = buildRowContent("continueWatching", "Row", [item])
            m.assertTrue(Instr(1, row.getChild(0).HDPosterUrl, "/series/Images/Thumb") > 0)
            m.assertEqual(row.getChild(0).logoOverlayUrl, "")
        end function

        @it("uses episode stills for nextUp when on")
        function _()
            m.top.settings = { "home-episode-images": "episode-with-logo" }
            item = { Id: "episode", Type: "Episode", ImageTags: { Primary: "still" }, ParentThumbItemId: "series", ParentThumbImageTag: "thumb", ParentLogoItemId: "series", ParentLogoImageTag: "logo" }
            'bs:disable-next-line 1140
            row = buildRowContent("nextUp", "Row", [item])
            m.assertTrue(Instr(1, row.getChild(0).HDPosterUrl, "/episode/Images/Primary") > 0)
            m.assertTrue(Instr(1, row.getChild(0).logoOverlayUrl, "/series/Images/Logo?tag=logo") > 0)
        end function

        @it("uses series artwork for nextUp when off")
        function _()
            m.top.settings = { "home-episode-images": "series" }
            item = { Id: "episode", Type: "Episode", ImageTags: { Primary: "still" }, ParentThumbItemId: "series", ParentThumbImageTag: "thumb", ParentLogoItemId: "series", ParentLogoImageTag: "logo" }
            'bs:disable-next-line 1140
            row = buildRowContent("nextUp", "Row", [item])
            m.assertTrue(Instr(1, row.getChild(0).HDPosterUrl, "/series/Images/Thumb") > 0)
            m.assertEqual(row.getChild(0).logoOverlayUrl, "")
        end function

        @it("falls back to series artwork without an episode still")
        function _()
            item = { Id: "episode", Type: "Episode", ImageTags: {}, ParentThumbItemId: "series", ParentThumbImageTag: "thumb", ParentLogoItemId: "series", ParentLogoImageTag: "logo" }
            'bs:disable-next-line 1140
            row = buildRowContent("nextUp", "Row", [item])
            m.assertTrue(Instr(1, row.getChild(0).HDPosterUrl, "/series/Images/Thumb") > 0)
            m.assertEqual(row.getChild(0).logoOverlayUrl, "")
        end function

        @it("leaves movie artwork unchanged")
        function _()
            item = { Id: "movie", Type: "Movie", ImageTags: { Primary: "poster", Thumb: "thumb" } }
            'bs:disable-next-line 1140
            row = buildRowContent("continueWatching", "Row", [item])
            m.assertTrue(Instr(1, row.getChild(0).HDPosterUrl, "/movie/Images/Thumb") > 0)
            m.assertEqual(row.getChild(0).logoOverlayUrl, "")
        end function

        @it("does not alter other Home rows")
        function _()
            m.top.settings = { "home-episode-images": "series" }
            item = { Id: "episode", Type: "Episode", ImageTags: { Primary: "still" }, ParentThumbItemId: "series", ParentThumbImageTag: "thumb", ParentLogoItemId: "series", ParentLogoImageTag: "logo" }
            'bs:disable-next-line 1140
            row = buildRowContent("libraries", "Row", [item])
            m.assertTrue(Instr(1, row.getChild(0).HDPosterUrl, "/episode/Images/Primary") > 0)
            m.assertEqual(row.getChild(0).logoOverlayUrl, "")
        end function

        @it("updates existing nodes without rebuilding shelves or starting requests")
        function _()
            item = { Id: "episode", Type: "Episode", ImageTags: { Primary: "still" }, ParentThumbItemId: "series", ParentThumbImageTag: "thumb", ParentLogoItemId: "series", ParentLogoImageTag: "logo" }
            'bs:disable-next-line 1140
            addRow("nextUp", "Next Up", [item])
            'bs:disable-next-line 1140
            renderRows()
            shelf = m.node.homeState.shelfNodes[0]
            row = m.node.homeState.rows.nextUp
            child = row.getChild(0)
            queryId = m.node.homeState.queryId
            taskCount = m.node.tasks.Count()

            m.top.settings = { "home-episode-images": "series" }

            m.assertTrue(m.node.homeState.shelfNodes[0].isSameNode(shelf))
            m.assertTrue(m.node.homeState.rows.nextUp.isSameNode(row))
            m.assertTrue(row.getChild(0).isSameNode(child))
            m.assertTrue(Instr(1, child.HDPosterUrl, "/series/Images/Thumb") > 0)
            m.assertEqual(child.logoOverlayUrl, "")
            m.assertEqual(m.node.homeState.queryId, queryId)
            m.assertEqual(m.node.tasks.Count(), taskCount)
        end function

        @it("uses the latest preference for a pending response")
        function _()
            'bs:disable-next-line 1001
            m.stubCall(runHomeTask, m.createControlledHomeTask)
            m.startPermissionRefresh({ canAccessLiveTv: false })
            m.top.settings = { "home-episode-images": "series" }
            m.node.tasks.nextUp.response = { ok: true, action: "nextUp", payload: { Items: [{ Id: "episode", Type: "Episode", ImageTags: { Primary: "still" }, ParentThumbItemId: "series", ParentThumbImageTag: "thumb", ParentLogoItemId: "series", ParentLogoImageTag: "logo" }] } }
            m.assertTrue(Instr(1, m.node.homeState.rows.nextUp.getChild(0).HDPosterUrl, "/series/Images/Thumb") > 0)
        end function

        @it("replaces the previous account image preference")
        function _()
            m.top.settings = { "home-episode-images": "episode-with-logo" }
            m.top.settings = {}
            item = { Id: "episode", Type: "Episode", ImageTags: { Primary: "still" }, ParentThumbItemId: "series", ParentThumbImageTag: "thumb", ParentLogoItemId: "series", ParentLogoImageTag: "logo" }
            'bs:disable-next-line 1140
            row = buildRowContent("nextUp", "Row", [item])
            m.assertTrue(Instr(1, row.getChild(0).HDPosterUrl, "/series/Images/Thumb") > 0)
            m.assertEqual(row.getChild(0).logoOverlayUrl, "")
        end function

        @it("ignores unrelated settings changes")
        function _()
            'bs:disable-next-line 1140
            addRow("nextUp", "Next Up", [{ Id: "episode", Type: "Episode", ImageTags: { Primary: "still" } }])
            child = m.node.homeState.rows.nextUp.getChild(0)
            before = child.HDPosterUrl
            m.top.settings = { "home-episode-images": "episode-with-logo", "theme-music": "on" }
            m.assertEqual(child.HDPosterUrl, before)
            m.assertTrue(m.node.homeState.rows.nextUp.getChild(0).isSameNode(child))
        end function

