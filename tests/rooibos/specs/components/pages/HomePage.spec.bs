        @it("routes home media libraries separately from video libraries")
        function _()
            item = m.createLibrary("home-media-1", "homevideos")

            'bs:disable-next-line 1140
            selectHomeItem(item)

            m.assertEqual(m.top.selectedHomeMediaLibrary.libraryId, "home-media-1")
