        @it("does not swallow expired authentication")
        function _()
            m.stubCall(AppMessage.Show, m.captureStatusMessage)
            m.stubCall(AppMessage.Dismiss, m.captureStatusClear)

            response = { ok: false, action: "liveTvOnNow", status: 401, errorMessage: "Visible failure", authExpired: true }

            'bs:disable-next-line 1140
            ignored = handleHomeResponseFailure(response)
            'bs:disable-next-line 1140
            publishHomeRefreshMessages()

            m.assertTrue(ignored)
            m.assertEqual(getGlobalAa().homeStatusCapture.message, "Visible failure")
        end function

        @it("ignores Live TV denial from a stale generation")
        function _()
            m.stubCall(AppMessage.Show, m.captureStatusMessage)
            m.stubCall(AppMessage.Dismiss, m.captureStatusClear)

            'bs:disable-next-line 1001
            m.stubCall(runHomeTask, m.createControlledHomeTask)
            m.startPermissionRefresh({ canAccessLiveTv: true })
            m.node.homeState.queryId += 1

            m.node.tasks.liveTvOnNow.response = { ok: false, action: "liveTvOnNow", status: 403, failureKind: "accessDenied", errorMessage: "Forbidden" }

            m.assertTrue(m.node.homeState.refresh.pendingCore.DoesExist("liveTvOnNow"))
            m.assertFalse(m.top.ready)
            m.assertEqual(getGlobalAa().homeStatusCapture.message, "")
        end function

        @it("ignores Live TV denial from a stale account")
        function _()
            m.stubCall(AppMessage.Show, m.captureStatusMessage)
            m.stubCall(AppMessage.Dismiss, m.captureStatusClear)

            'bs:disable-next-line 1001
            m.stubCall(runHomeTask, m.createControlledHomeTask)
            m.startPermissionRefresh({ canAccessLiveTv: true })
            m.node.homeState.sessionKey = "another-account"

            m.node.tasks.liveTvOnNow.response = { ok: false, action: "liveTvOnNow", status: 403, failureKind: "accessDenied", errorMessage: "Forbidden" }

            m.assertTrue(m.node.homeState.refresh.pendingCore.DoesExist("liveTvOnNow"))
            m.assertFalse(m.top.ready)
            m.assertEqual(getGlobalAa().homeStatusCapture.message, "")
        end function

        @it("uses the owned request to name a failed Recently Added library")
        function _()
            m.stubCall(AppMessage.Show, m.captureStatusMessage)
            task = CreateObject("roSGNode", "LatestMediaTask")
            task.request = { homeQueryId: m.node.homeState.queryId, homeSessionKey: m.node.homeState.sessionKey, parentId: "movies" }
            m.node.homeState.latestLibraries = { movies: { name: "Movies" } }
            m.node.homeState.latestTasks = [task]
            m.top.appendChild(task)
            task.observeField("response", "onDynamicLatestMediaResponse")

            task.response = { ok: false, action: "latestMedia", status: 500, failureKind: "serverError", errorMessage: "Raw server error" }

            m.assertEqual(getGlobalAa().homeStatusCapture.message, "Unable to load Recently Added in Movies. The server encountered an error.")
            m.assertEqual(m.node.homeState.latestTasks.Count(), 0)
        end function

        @it("names the library when Recently Added fails")
        function _()
            'bs:disable-next-line 1140
            message = getHomeErrorMessage({ action: "latestMedia", status: 500, failureKind: "serverError" }, "Movies")

            m.assertEqual(message, "Unable to load Recently Added in Movies. The server encountered an error.")
        end function

        @it("explains request timeouts")
        function _()
            'bs:disable-next-line 1140
            message = getHomeErrorMessage({ action: "nextUp", status: 0, failureKind: "timeout", errorMessage: "Technical wording can change." }, "")

            m.assertEqual(message, "Unable to load Next Up. The server took too long to respond.")
        end function

        @it("explains gateway timeouts")
        function _()
            'bs:disable-next-line 1140
            message = getHomeErrorMessage({ action: "nextUp", status: 504, failureKind: "timeout" }, "")

            m.assertEqual(message, "Unable to load Next Up. The server took too long to respond.")
        end function

        @it("explains connection failures")
        function _()
            'bs:disable-next-line 1140
            message = getHomeErrorMessage({ action: "continueListening", status: -7, failureKind: "connectionFailed" }, "")

            m.assertEqual(message, "Unable to load Continue Listening. Couldn't connect to the server.")
        end function

        @it("uses safe wording for unknown failures")
        function _()
            'bs:disable-next-line 1140
            message = getHomeErrorMessage({ action: "nextUp", status: 400, failureKind: "futureKind", errorMessage: "<html>secret server details</html>" }, "")

            m.assertEqual(message, "Unable to load Next Up. The app received an unexpected response from the server.")
        end function

        @describe("Recently Added exclusions")

        @it("excludes selected libraries from latest tasks while retaining My Media")
        function _()
            m.node.homeState.request.homePreferences = { latestItemsExcludes: ["home", "music"] }
            libraries = [m.createLibrary("home", "homevideos"), m.createLibrary("music", "musicvideos"), m.createLibrary("movies", "movies")]
            'bs:disable-next-line 1140
            addRow("libraries", "My Media", libraries)

            'bs:disable-next-line 1140
            queueLatestMediaRows(libraries)

            m.assertEqual(m.node.homeState.latestLibraries.Count(), 1)
            m.assertTrue(m.node.homeState.latestLibraries.DoesExist("movies"))
            m.assertEqual(m.node.homeState.rowOrder, ["libraries", "continueWatching", "continueListening", "nextUp", "latest:movies", "liveTvOnNow"])
            m.assertEqual(m.node.homeState.rows.libraries.getChildCount(), 3)
        end function

        @it("loads all eligible latest libraries when preferences are missing")
        function _()
            'bs:disable-next-line 1140
            queueLatestMediaRows([m.createLibrary("home", "homevideos"), m.createLibrary("music", "musicvideos")])

            m.assertEqual(m.node.homeState.latestLibraries.Count(), 2)
        end function

        @it("replaces excluded libraries when the account preferences change")
        function _()
            libraries = [m.createLibrary("home", "homevideos"), m.createLibrary("music", "musicvideos")]
            m.node.homeState.request.homePreferences = { latestItemsExcludes: ["home"] }
            'bs:disable-next-line 1140
            queueLatestMediaRows(libraries)
            m.node.homeState.request.homePreferences = { latestItemsExcludes: ["music"] }

            'bs:disable-next-line 1140
            queueLatestMediaRows(libraries)

            m.assertTrue(m.node.homeState.latestLibraries.DoesExist("home"))
            m.assertFalse(m.node.homeState.latestLibraries.DoesExist("music"))
        end function

        @describe("declarative component contract")

        @it("declares the contentGroup node")
        function _()
            m.assertNotInvalid(m.top.findNode("contentGroup"))
        end function

        @it("declares the shelfViewport node")
        function _()
            m.assertNotInvalid(m.top.findNode("shelfViewport"))
        end function

        @it("declares the shelvesGroup node")
        function _()
            m.assertNotInvalid(m.top.findNode("shelvesGroup"))
        end function

        @it("declares the shelvesAnimation node")
        function _()
            m.assertNotInvalid(m.top.findNode("shelvesAnimation"))
        end function

        @it("declares the shelvesTranslation node")
        function _()
            m.assertNotInvalid(m.top.findNode("shelvesTranslation"))
        end function

        @it("declares the dynamic task registration field")
        function _()
            m.assertTrue(m.top.hasField("taskCreated"))
        end function

        @it("publishes readiness after core refresh work completes")
        function _()
            collector = CreateObject("roSGNode", "LogService")
            m.node.log = new Logger("HomePage", collector)
            m.top.ready = false
            m.node.homeState.refresh = { blocking: true, pendingCore: {}, messages: [] }

            'bs:disable-next-line 1140
            finishBlockingRefreshIfReady()

            m.assertTrue(m.top.ready)
            entries = collector.callFunc("getSnapshot")
            m.assertEqual(entries.Count(), 1)
            m.assertTrue(Instr(1, entries[0], "[HomePage] Activity: Viewing home; sections=") > 0)
        end function

        @describe("selection routing")

        @it("routes collection libraries")
        function _()
            item = m.createLibrary("collection-1", "boxsets")

            'bs:disable-next-line 1140
            selectHomeItem(item)

            m.assertEqual(m.top.selectedCollections.libraryId, "collection-1")
        end function

        @it("routes Live TV libraries")
        function _()
            item = m.createLibrary("live-1", "livetv")

            'bs:disable-next-line 1140
            selectHomeItem(item)

            m.assertEqual(m.top.selectedLiveTV.libraryId, "live-1")
        end function

        @it("routes music libraries")
        function _()
            item = m.createLibrary("music-1", "music")

            'bs:disable-next-line 1140
            selectHomeItem(item)

            m.assertEqual(m.top.selectedMusicLibrary.libraryId, "music-1")
