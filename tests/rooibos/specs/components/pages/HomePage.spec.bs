        @it("plays generic Home videos immediately without progress")
        function _()
            item = { Id: "home-1", Type: "Video" }
            'bs:disable-next-line 1140
            selectHomeItem(item)

            m.assertEqual(m.top.selectedHomeMediaVideo.itemId, "home-1")
            m.assertInvalid(m.top.overlayRequested)
        end function

        @it("prompts for latest home videos with progress")
        function _()
            item = { Id: "home-1", Type: "Video", UserData: { PlaybackPositionTicks: 20000000& } }
            'bs:disable-next-line 1140
            selectHomeMediaItem(item)

            m.assertEqual(m.top.overlayRequested.item.Id, "home-1")
            m.assertInvalid(m.top.selectedHomeMediaVideo)
        end function

        @it("keeps explicit zero in the Home overlay result")
        function _()
            selection = { itemId: "home-1", item: { Id: "home-1", UserData: { PlaybackPositionTicks: 20000000& } }, startPositionTicks: 0& }
            m.top.callFunc("handlePlaybackOverlayClosed", selection)

            m.assertEqual(PlaybackProgress.GetTicksFromSelection(m.top.selectedHomeMediaVideo), 0&)
        end function

        @it("cancels a Home video dialog without launching playback")
        function _()
            m.top.callFunc("handlePlaybackOverlayClosed", invalid)

            m.assertInvalid(m.top.selectedHomeMediaVideo)
        end function

        @it("hides Continue Watching video badges independently of progress")
        function _()
            item = { Id: "home-1", Type: "Video", UserData: { PlayedPercentage: 25 } }
            'bs:disable-next-line 1140
            content = buildRowContent("continueWatching", "Continue Watching", [item])

            m.assertFalse(content.getChild(0).showWatchedIndicator)
            m.assertInvalid(content.getChild(0).tracksPlaybackProgress)
        end function

        @it("restores the selected video by identity after Home shelves rebuild")
        function _()
            m.node.homeState.rowOrder = ["libraries", "continueWatching"]
            item = { Id: "home-2", Type: "Video", UserData: { PlaybackPositionTicks: 20000000& } }
            'bs:disable-next-line 1140
            addRow("continueWatching", "Continue Watching", [{ Id: "home-1", Type: "Video" }, item])
            'bs:disable-next-line 1140
            renderRows()
            'bs:disable-next-line 1140
            selectHomeItem(item)
            m.focusTestSurface = CreateObject("roSGNode", "Group")
            m.top.getScene().appendChild(m.focusTestSurface)
            m.focusTestSurface.setFocus(true)

            ' Change both the shelf index and the item index while the dialog is open.
            'bs:disable-next-line 1140
            addRow("libraries", "Libraries", [{ Id: "library", Type: "CollectionFolder" }])
            'bs:disable-next-line 1140
            addRow("continueWatching", "Continue Watching", [item, { Id: "home-1", Type: "Video" }])
            'bs:disable-next-line 1140
            renderRows()

            m.assertFalse(m.node.homeState.shelfNodes[1].isInFocusChain())
            m.top.callFunc("handlePlaybackOverlayClosed", invalid)

            m.assertEqual(m.node.homeState.focusedShelfIndex, 1)
            shelf = m.node.homeState.shelfNodes[1]
            m.assertTrue(shelf.isInFocusChain())
            m.assertEqual(shelf.findNode("items").jumpToRowItem, [0, 0])
            m.assertInvalid(m.top.selectedHomeMediaVideo)
        end function

        @it("falls back to an available shelf if the originating row disappears")
        function _()
            m.node.homeState.rowOrder = ["libraries", "continueWatching"]
            'bs:disable-next-line 1140
            addRow("libraries", "Libraries", [{ Id: "library", Type: "CollectionFolder" }])
            'bs:disable-next-line 1140
            renderRows()
            m.node.homeState.playbackOverlay = { open: true, returnTarget: { rowKey: "removed", itemId: "home-1" } }

            m.top.callFunc("handlePlaybackOverlayClosed", invalid)

            m.assertTrue(m.node.homeState.shelfNodes[0].isInFocusChain())
            m.assertInvalid(m.node.homeState.playbackOverlay.returnTarget)
        end function

        @describe("root page Back handling")

        @it("Back from the first Home item requests exit confirmation")
        function _()
            shelf = m.createRemotePlayShelf()
            shelf.callFunc("activate", "first")
            m.top.backSelected = false
            m.top.focusExitUp = false

            'bs:disable-next-line 1140
            handled = onKeyEvent("back", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.backSelected)
            m.assertTrue(shelf.isInFocusChain())
            m.assertEqual(shelf.callFunc("getFocusedItem").Id, "first")
            m.assertFalse(m.top.focusExitUp)
            m.assertInvalid(m.top.overlayRequested)
            m.top.removeChild(shelf)
            m.node.homeState.shelfNodes = []
        end function

        @it("Back from the second Home item requests exit confirmation")
        function _()
            shelf = m.createRemotePlayShelf()
            shelf.callFunc("activate", "second")
            m.top.backSelected = false
            m.top.focusExitUp = false

            'bs:disable-next-line 1140
            handled = onKeyEvent("back", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.backSelected)
            m.assertTrue(shelf.isInFocusChain())
            m.assertEqual(shelf.callFunc("getFocusedItem").Id, "second")
            m.assertFalse(m.top.focusExitUp)
            m.assertInvalid(m.top.overlayRequested)
            m.top.removeChild(shelf)
            m.node.homeState.shelfNodes = []
        end function

        @it("Back on empty Home requests exit confirmation")
        function _()
            m.node.homeState.shelfNodes = []
            m.top.setFocus(true)
            m.top.backSelected = false
            m.top.focusExitUp = false

            'bs:disable-next-line 1140
            m.assertTrue(onKeyEvent("back", true))

            m.assertTrue(m.top.backSelected)
            m.assertTrue(m.top.hasFocus())
            m.assertFalse(m.top.focusExitUp)
            m.assertInvalid(m.top.overlayRequested)
        end function

        @it("Back release does not request navigation")
        function _()
            m.top.backSelected = false
            m.top.focusExitUp = false

            'bs:disable-next-line 1140
            m.assertFalse(onKeyEvent("back", false))
            m.assertFalse(m.top.backSelected)

            m.assertFalse(m.top.focusExitUp)
            m.assertInvalid(m.top.overlayRequested)
        end function

        @describe("remote Play")

        @it("plays the focused shelf media")
        function _()
            shelf = m.createRemotePlayShelf()

            'bs:disable-next-line 1140
            handled = onKeyEvent("play", true)

            m.assertTrue(handled)
            m.assertEqual(m.top.playbackSelected.itemId, "second")
            m.top.removeChild(shelf)
            m.node.homeState.shelfNodes = []
        end function

        @it("ignores Play release on a focused playable shelf")
        function _()
            shelf = m.createRemotePlayShelf()

            'bs:disable-next-line 1140
            m.assertFalse(onKeyEvent("play", false))
            m.assertInvalid(m.top.playbackSelected)
            m.top.removeChild(shelf)
            m.node.homeState.shelfNodes = []
        end function

        @it("does not play during a blocking Home refresh")
        function _()
            shelf = m.createRemotePlayShelf()

            m.node.homeState.refresh.blocking = true
            'bs:disable-next-line 1140
            m.assertFalse(onKeyEvent("play", true))
            m.assertInvalid(m.top.playbackSelected)
            m.top.removeChild(shelf)
            m.node.homeState.shelfNodes = []
        end function

        @it("does not play a library shelf")
        function _()
            shelf = m.createRemotePlayShelf()

            shelf.rowContent.rowKey = "libraries"
            'bs:disable-next-line 1140
            m.assertFalse(onKeyEvent("play", true))
            m.assertInvalid(m.top.playbackSelected)
            m.top.removeChild(shelf)
            m.node.homeState.shelfNodes = []
        end function

        @it("does not play when Home shelf focus has moved away")
        function _()
            shelf = m.createRemotePlayShelf()

            shelf.findNode("items").setFocus(false)
            m.top.setFocus(true)
            m.assertFalse(shelf.isInFocusChain())
            'bs:disable-next-line 1140
            m.assertFalse(onKeyEvent("play", true))
            m.assertInvalid(m.top.playbackSelected)
            m.top.removeChild(shelf)
            m.node.homeState.shelfNodes = []
        end function

        @it("restores the exact Home shelf item after Play")
        function _()
            shelf = m.createRemotePlayShelf()

            'bs:disable-next-line 1140
            m.assertTrue(onKeyEvent("play", true))
            m.assertEqual(m.top.playbackSelected.itemId, "second")
            m.assertEqual(m.node.homeState.playbackOverlay.returnTarget, { rowKey: "movies", itemId: "second" })
            shelf.findNode("items").jumpToRowItem = [0, 0]
            m.top.setFocus(true)

            m.top.callFunc("focusHome")

            m.assertEqual(shelf.findNode("items").rowItemFocused, [0, 1])
            m.assertEqual(shelf.callFunc("getFocusedItem").Id, "second")
            m.assertTrue(shelf.isInFocusChain())
            m.top.removeChild(shelf)
            m.node.homeState.shelfNodes = []
        end function

        private function createRemotePlayShelf() as object
            shelf = CreateObject("roSGNode", "HomeShelf")
            row = CreateObject("roSGNode", "ContentNode")
            row.addFields({ rowKey: "movies" })
            row.createChild("ContentNode").addFields({ raw: { Id: "first", Type: "Movie" } })
            row.createChild("ContentNode").addFields({ raw: { Id: "second", Type: "Movie" } })
            shelf.rowContent = row
            m.top.appendChild(shelf)
            m.node.homeState.shelfNodes = [shelf]
            m.node.homeState.focusedShelfIndex = 0
            m.node.homeState.shelfPositions = []
            shelf.callFunc("activate", "second")
            m.top.playbackSelected = invalid
            return shelf
        end function

        @describe("aggregate count responses")

        @it("updates a shelf count without rebuilding the shelf")
        function _()
            row = CreateObject("roSGNode", "ContentNode")
            child = row.createChild("ContentNode")
            child.addFields({ raw: { Id: "series", Type: "Series", UserData: { UnplayedItemCount: 200 } } })
            shelf = CreateObject("roSGNode", "HomeShelf")
            shelf.rowContent = row
            m.node.homeState.shelfNodes = [shelf]

            m.node.episodeCountRefresh.response = { ok: true, payload: [{ Id: "series", Type: "Series", UserData: { UnplayedItemCount: 2 } }] }

            m.assertEqual(child.raw.UserData.UnplayedItemCount, 2)
            m.assertTrue(m.node.homeState.shelfNodes[0].isSameNode(shelf))
        end function

        @describe("canonical media reconciliation")

        @it("invalidates eligible non-music shelves for an unwatched item absent from retained cards")
        function _()
            m.top.callFunc("deactivate")
            m.node.homeState.latestLibraries = {
                movies: { id: "movies", collectionType: "movies" }
                mixed: { id: "mixed", collectionType: "" }
                music: { id: "music", collectionType: "music" }
            }
            'bs:disable-next-line 1140
            addRow("latest:movies", "Movies", [{ Id: "other-movie", Type: "Movie" }])

            m.top.callFunc("recordMediaChange", { itemId: "hidden-movie", itemType: "Movie", action: "watched", value: false })

            m.assertTrue(HomeRefresh.NeedsRefresh(m.node.homeState.sync, "latest:movies", true))
            m.assertTrue(HomeRefresh.NeedsRefresh(m.node.homeState.sync, "latest:mixed", true))
            m.assertFalse(HomeRefresh.NeedsRefresh(m.node.homeState.sync, "latest:music", true))
            m.assertEqual(m.node.homeState.sectionItems["latest:movies"][0].Id, "other-movie")
        end function

        @it("invalidates a grouped TV shelf after progress changes an unlisted episode")
        function _()
            m.top.callFunc("deactivate")
            m.node.homeState.latestLibraries = { tv: { id: "tv", collectionType: "tvshows" } }
            'bs:disable-next-line 1140
            addRow("latest:tv", "TV", [{ Id: "series", Type: "Series" }])

            m.top.callFunc("recordMediaChange", { itemId: "episode", itemType: "Episode", action: "progress", isFinished: true })

            m.assertTrue(HomeRefresh.NeedsRefresh(m.node.homeState.sync, "latest:tv", true))
            m.assertEqual(m.node.homeState.sectionItems["latest:tv"][0].Id, "series")
        end function

        @it("does not invalidate unrelated Latest shelves for an absent favorite change")
        function _()
            m.top.callFunc("deactivate")
            m.node.homeState.latestLibraries = { movies: { id: "movies", collectionType: "movies" } }

            m.top.callFunc("recordMediaChange", { itemId: "hidden-movie", itemType: "Movie", action: "favorite", value: true })

            m.assertFalse(HomeRefresh.NeedsRefresh(m.node.homeState.sync, "latest:movies", true))
        end function

        @it("does not invalidate unrelated video shelves for audio progress")
        function _()
            m.top.callFunc("deactivate")
            m.node.homeState.latestLibraries = { movies: { id: "movies", collectionType: "movies" } }

            m.top.callFunc("recordMediaChange", { itemId: "track", itemType: "Audio", action: "progress", positionTicks: 100000000 })

            m.assertFalse(HomeRefresh.NeedsRefresh(m.node.homeState.sync, "latest:movies", true))
            m.assertTrue(HomeRefresh.NeedsRefresh(m.node.homeState.sync, "continueListening", true))
        end function

        @it("updates every retained occurrence of a watched item while inactive")
        function _()
            m.top.callFunc("deactivate")
            'bs:disable-next-line 1140
            addRow("latest:movies", "Movies", [{ Id: "movie", Type: "Movie", UserData: { Played: false } }])
            'bs:disable-next-line 1140
            addRow("continueWatching", "Resume", [{ Id: "movie", Type: "Movie", UserData: { Played: false } }])

            m.top.callFunc("recordMediaChange", { itemId: "movie", itemType: "Movie", action: "watched", value: true })

            m.assertTrue(m.node.homeState.sectionItems["latest:movies"][0].UserData.Played)
            m.assertTrue(m.node.homeState.rows["latest:movies"].getChild(0).raw.UserData.Played)
            m.assertTrue(m.node.homeState.rows.continueWatching.getChild(0).raw.UserData.Played)
            m.assertTrue(HomeRefresh.NeedsRefresh(m.node.homeState.sync, "nextUp", true))
        end function

        @it("a departing refresh cannot acknowledge a subsequent mutation")
        function _()
            m.startFocusRefresh(true)
            captured = m.node.tasks.continueWatching.request.homeRevision
            m.top.callFunc("deactivate")
            m.top.callFunc("recordMediaChange", { itemId: "movie", action: "watched", value: true })

            m.finishOtherHomeRows()

            m.assertEqual(m.node.homeState.sync.applied.continueWatching, captured)
            m.assertTrue(HomeRefresh.NeedsRefresh(m.node.homeState.sync, "continueWatching", true))
            m.assertFalse(m.top.visible)
        end function

        @it("an older response retains a newer accepted favorite")
        function _()
            m.startFocusRefresh(false)
            m.top.callFunc("recordMediaChange", { itemId: "episode", action: "favorite", value: true })

            m.node.tasks.nextUp.response = { ok: true, action: "nextUp", payload: { Items: [{ Id: "episode", Type: "Episode", UserData: { IsFavorite: false } }] } }

            m.assertTrue(m.node.homeState.rows.nextUp.getChild(0).raw.UserData.IsFavorite)
        end function

        @it("keeps blocking loading between first and final responses")
        function _()
            m.startFocusRefresh(true)

            m.node.tasks.continueWatching.response = { ok: true, action: "continueWatching", payload: { Items: [{ Id: "movie", Type: "Movie" }] } }

            m.assertEqual(m.top.getScene().findNode("loadingSpinner").control, "start")
            m.assertFalse(m.top.visible)
            m.finishOtherHomeRows()
            m.assertEqual(m.top.getScene().findNode("loadingSpinner").control, "stop")
            m.assertTrue(m.top.visible)
        end function

        @it("retains a failed section without automatic retries")
        function _()
            m.stubCall(AppMessage.Show, m.captureStatusMessage)
            m.startFocusRefresh(false)
            m.finishOtherHomeRows()
            m.top.callFunc("deactivate")
            m.top.callFunc("recordMediaChange", { itemId: "movie", action: "watched", value: true })
            m.top.callFunc("activate")
            failedTask = m.node.tasks.continueWatching

            failedTask.response = { ok: false, action: "continueWatching" }
            m.node.tasks.nextUp.response = { ok: true, action: "nextUp", payload: { Items: [] } }

            m.assertTrue(m.node.tasks.continueWatching.isSameNode(failedTask))
            m.assertTrue(m.node.homeState.rows.DoesExist("continueWatching"))
            m.assertTrue(HomeRefresh.NeedsRefresh(m.node.homeState.sync, "continueWatching", true))
        end function

        @it("retries a failed section on the next activation")
        function _()
            m.stubCall(AppMessage.Show, m.captureStatusMessage)
            m.startFocusRefresh(false)
            m.node.tasks.continueListening.response = { ok: false, action: "continueListening" }
            failedTask = m.node.tasks.continueListening
            m.node.tasks.continueWatching.response = { ok: true, action: "continueWatching", payload: { Items: [] } }
            m.node.tasks.nextUp.response = { ok: true, action: "nextUp", payload: { Items: [] } }
            m.node.tasks.libraries.response = { ok: true, action: "libraries", payload: { Items: [] } }

            m.top.callFunc("activate")

            m.assertFalse(m.node.tasks.continueListening.isSameNode(failedTask))
        end function

        @it("audiobook progress requires listening rather than video snapshots")
        function _()
            m.top.callFunc("deactivate")
            m.node.homeState.sync.required = {}

            m.top.callFunc("recordMediaChange", { itemId: "book", itemType: "AudioBook", action: "progress", positionTicks: 120000000 })

            m.assertTrue(m.node.homeState.sync.required.DoesExist("continueListening"))
            m.assertFalse(m.node.homeState.sync.required.DoesExist("continueWatching"))
            m.assertFalse(m.node.homeState.sync.required.DoesExist("nextUp"))
        end function

        @it("settling an older audio report does not replay its progress over a newer stop")
        function _()
            m.top.callFunc("deactivate")
            'bs:disable-next-line 1140
            addRow("continueListening", "Listening", [{ Id: "track", Type: "Audio", UserData: {} }])
            m.top.callFunc("recordMediaChange", { itemId: "track", itemType: "Audio", action: "progress", positionTicks: 100000000, reportId: "one", reportState: "pending" })
            m.top.callFunc("recordMediaChange", { itemId: "track", itemType: "Audio", action: "progress", positionTicks: 200000000, reportId: "two", reportState: "pending" })

            m.top.callFunc("recordMediaChange", { itemId: "track", itemType: "Audio", action: "progress", positionTicks: 100000000, reportId: "one", reportState: "saved" })

            m.assertEqual(Number.ToInteger(m.node.homeState.sectionItems.continueListening[0].UserData.PlaybackPositionTicks, 0), 200000000)
            m.assertTrue(m.node.homeState.sync.pendingReports.DoesExist("two"))
        end function

        @it("reconciles overlapping watched and progress changes in accepted order")
        function _()
            m.top.callFunc("deactivate")
            revision = m.node.homeState.sync.revision
            m.top.callFunc("recordMediaChange", { itemId: "movie", action: "watched", value: true })
            m.top.callFunc("recordMediaChange", { itemId: "movie", action: "progress", positionTicks: 200000000, isFinished: false })

            'bs:disable-next-line 1140
            items = reconcileHomeSnapshot([{ Id: "movie", Type: "Movie", UserData: {} }], revision)

            m.assertEqual(Number.ToInteger(items[0].UserData.PlaybackPositionTicks, 0), 200000000)
            m.assertFalse(items[0].UserData.Played)
        end function

        @it("ignores media changes from another account")
        function _()
            revision = m.node.homeState.sync.revision

            m.top.callFunc("recordMediaChange", { accountKey: "other", itemId: "movie", action: "watched", value: true })

            m.assertEqual(m.node.homeState.sync.revision, revision)
        end function

    end class

end namespace
