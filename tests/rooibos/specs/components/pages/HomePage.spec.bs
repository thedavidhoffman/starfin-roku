        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("up", false)

            m.assertFalse(handled)
        end function

        function captureStatusMessage(message, title = "Message")
            capture = getGlobalAa().homeStatusCapture
            capture.message = message
            capture.writes += 1
        end function

        function captureStatusClear()
            capture = getGlobalAa().homeStatusCapture
            capture.message = ""
            capture.clears += 1
        end function

        function createControlledHomeTask(action, componentName, responseHandler, request)
            task = CreateObject("roSGNode", "Group")
            task.addFields({ request: {}, response: {}, control: "" })
            context = getGlobalAa().homeTestContext
            context.top.appendChild(task)
            context.tasks[action] = task
            task.observeField("response", responseHandler)
            controlledRequest = {}
            controlledRequest.Append(request)
            controlledRequest.homeRevision = context.homeState.sync.revision
            context.homeState.sync.attempted[action] = controlledRequest.homeRevision
            controlledRequest.homeQueryId = context.homeState.queryId
            controlledRequest.homeSessionKey = context.homeState.sessionKey
            task.request = controlledRequest
        end function

        function startPermissionRefresh(permissions as dynamic)
            m.node.homeState.request.permissions = permissions
            m.top.ready = false
            'bs:disable-next-line 1140
            refreshHomeData(true)
        end function

        function finishOtherHomeRows()
            for each action in ["libraries", "continueWatching", "continueListening", "nextUp"]
                items = []
                if action = "continueWatching" then items = [{ Id: "movie", Name: "Fixture", Type: "Movie", ImageTags: {} }]
                m.node.tasks[action].response = { ok: true, action: action, payload: { Items: items } }
            end for
        end function

        function renderTwoRows()
            'bs:disable-next-line 1140
            addRow("libraries", "My Media", [m.createLibrary("movies-1", "movies")])
            'bs:disable-next-line 1140
            addRow("nextUp", "Next Up", [{ Id: "episode-1", Type: "Episode", ImageTags: {} }])
            'bs:disable-next-line 1140
            renderRows()
            m.node.homeState.focusedShelfIndex = 0
        end function

        function createLibrary(id as string, collectionType as string) as object
            return { Id: id, Name: id, Type: "CollectionFolder", CollectionType: collectionType, ImageTags: {}, BackdropImageTags: [] }
        end function

        @it("combines refresh failures after the last core response")
        function _()
            m.stubCall(AppMessage.Show, m.captureStatusMessage)
            'bs:disable-next-line 1001
            m.stubCall(runHomeTask, m.createControlledHomeTask)
            m.startPermissionRefresh({ canAccessLiveTv: false })
            m.node.tasks.continueWatching.response = { ok: false, action: "continueWatching", failureKind: "accessDenied" }
            m.node.tasks.nextUp.response = { ok: false, action: "nextUp", failureKind: "timeout" }
            m.assertEqual(getGlobalAa().homeStatusCapture.writes, 0)
            m.node.tasks.libraries.response = { ok: true, action: "libraries", payload: { Items: [] } }
            m.node.tasks.continueListening.response = { ok: true, action: "continueListening", payload: { Items: [] } }

            m.assertTrue(m.top.ready)
            m.assertEqual(getGlobalAa().homeStatusCapture.writes, 1)
            m.assertEqual(getGlobalAa().homeStatusCapture.message, "Unable to load Continue Watching. The server denied access." + Chr(10) + Chr(10) + "Unable to load Next Up. The server took too long to respond.")
        end function

        @describe("refresh message presentation lifecycle")

        @it("discards collected and late core failures after leaving Home while rows finish loading")
        function _()
            m.stubCall(AppMessage.Show, m.captureStatusMessage)
            'bs:disable-next-line 1001
            m.stubCall(runHomeTask, m.createControlledHomeTask)
            m.startPermissionRefresh({ canAccessLiveTv: false })
            m.node.tasks.nextUp.response = { ok: false, action: "nextUp", failureKind: "timeout" }

            m.top.callFunc("suppressRefreshMessages")
            m.node.tasks.continueListening.response = { ok: false, action: "continueListening", failureKind: "timeout" }
            m.node.tasks.continueWatching.response = { ok: true, action: "continueWatching", payload: { Items: [{ Id: "movie", Name: "Fixture", Type: "Movie", ImageTags: {} }] } }
            m.node.tasks.libraries.response = { ok: true, action: "libraries", payload: { Items: [] } }

            m.assertTrue(m.top.ready)
            m.assertTrue(m.node.homeState.rows.DoesExist("continueWatching"))
            m.assertEqual(m.node.homeState.refresh.messages.Count(), 0)
            m.assertEqual(getGlobalAa().homeStatusCapture.writes, 0)
        end function

        @it("discards a late Recently Added failure after leaving Home")
        function _()
            m.stubCall(AppMessage.Show, m.captureStatusMessage)
            task = CreateObject("roSGNode", "LatestMediaTask")
            task.request = { homeQueryId: m.node.homeState.queryId, homeSessionKey: m.node.homeState.sessionKey, parentId: "movies" }
            m.node.homeState.latestLibraries = { movies: { name: "Movies" } }
            m.node.homeState.latestTasks = [task]
            m.top.appendChild(task)
            task.observeField("response", "onDynamicLatestMediaResponse")

            m.top.callFunc("suppressRefreshMessages")
            task.response = { ok: false, action: "latestMedia", failureKind: "serverError" }

            m.assertEqual(m.node.homeState.latestTasks.Count(), 0)
            m.assertEqual(m.node.homeState.refresh.messages.Count(), 0)
            m.assertEqual(getGlobalAa().homeStatusCapture.writes, 0)
        end function

        @it("permits messages from a new refresh after an outgoing refresh was suppressed")
        function _()
            m.stubCall(AppMessage.Show, m.captureStatusMessage)
            'bs:disable-next-line 1001
            m.stubCall(runHomeTask, m.createControlledHomeTask)
            m.top.callFunc("suppressRefreshMessages")

            m.startPermissionRefresh({ canAccessLiveTv: false })
            m.node.tasks.continueWatching.response = { ok: false, action: "continueWatching", failureKind: "timeout" }
            for each action in ["nextUp", "continueListening", "libraries"]
                m.node.tasks[action].response = { ok: true, action: action, payload: { Items: [] } }
            end for

            m.assertEqual(getGlobalAa().homeStatusCapture.writes, 1)
            m.assertEqual(getGlobalAa().homeStatusCapture.message, "Unable to load Continue Watching. The server took too long to respond.")
        end function

