            'bs:disable-next-line 1140
            content = buildRowContent("latest:home-media-1", "Recently Added", [{ Id: "photo-1", Type: "Photo", ImageTags: {} }])

            m.assertFalse(content.getChild(0).tracksPlaybackProgress)
        end function

        @it("leaves ordinary latest videos on the default progress policy")
        function _()
            m.node.homeState.latestLibraries["videos-1"] = { id: "videos-1", collectionType: "movies" }

            'bs:disable-next-line 1140
            content = buildRowContent("latest:videos-1", "Recently Added", [{ Id: "video-1", Type: "Video", ImageTags: {} }])

            m.assertInvalid(content.getChild(0).tracksPlaybackProgress)
