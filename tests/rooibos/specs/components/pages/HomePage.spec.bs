        @it("routes latest home media videos directly to playback")
        function _()
            item = { Id: "video-1", Type: "Video" }

            'bs:disable-next-line 1140
            selectHomeMediaLatestItem(item)

            m.assertEqual(m.top.selectedHomeMediaVideo.itemId, "video-1")
            m.assertFalse(m.top.selectedHomeMediaVideo.tracksPlaybackProgress)
            m.assertInvalid(m.top.selectedMovie)
        end function

        @it("routes latest home media photos to the photo viewer")
        function _()
            item = { Id: "photo-1", Type: "Photo", ParentId: "folder-1" }

            'bs:disable-next-line 1140
            selectHomeMediaLatestItem(item)

            m.assertEqual(m.top.selectedHomeMediaPhoto.items.Count(), 1)
            m.assertEqual(m.top.selectedHomeMediaPhoto.sourceFolderId, "folder-1")
        end function

        @it("routes music video libraries by collection type")
        function _()
            item = m.createLibrary("music-videos-1", "musicvideos")

            'bs:disable-next-line 1140
            selectHomeItem(item)

            m.assertEqual(m.top.selectedLibrary.libraryId, "music-videos-1")
            m.assertEqual(m.top.selectedLibrary.collectionType, "musicvideos")
        end function

        @it("routes episodes")
        function _()
