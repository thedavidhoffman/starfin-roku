namespace tests

    @SGNode("HomePage")
    @suite("HomePage component")
    class HomePageTests extends rooibos.BaseTestSuite

        protected override function beforeEach()
            m.node.homeState.request = { server: "http://server", token: "token", userId: "user" }
            m.node.homeState.rows = {}
            m.top.settings = { "home-episode-images": "on" }
            m.node.homeState.episodeImagesEnabled = true
            m.node.homeState.refresh = { blocking: false, pendingCore: {}, messages: [] }
            m.node.homeState.playbackRows.continueWatchingItems = []
            m.node.homeState.playbackRows.nextUpItems = []
            m.node.homeState.focusedShelfIndex = 0
            m.top.overlayRequested = invalid
            m.top.selectedLibrary = invalid
            m.top.selectedHomeMediaLibrary = invalid
            m.top.selectedHomeMediaVideo = invalid
            m.top.selectedHomeMediaPhoto = invalid

            scene = m.top.getScene()
            getGlobalAa().homeTestContext = m.node
            getGlobalAa().homeStatusCapture = { message: "", writes: 0, clears: 0 }
            if scene.findNode("loadingSpinner") = invalid then
                loadingSpinnerNode = CreateObject("roSGNode", "Spinner")
                loadingSpinnerNode.id = "loadingSpinner"
                scene.appendChild(loadingSpinnerNode)
            end if
        end function

        protected override function afterEach()
            'bs:disable-next-line 1140
            cleanupHomeTasks()
            Spinner.HideBlocking()
            getGlobalAa().Delete("homeTestContext")
            getGlobalAa().Delete("homeStatusCapture")
        end function

        @describe("Home episode artwork")

        @it("uses episode stills for continueWatching when on")
        function _()
            m.top.settings = { "home-episode-images": "on" }
            item = { Id: "episode", Type: "Episode", ImageTags: { Primary: "still" }, ParentThumbItemId: "series", ParentThumbImageTag: "thumb" }
            'bs:disable-next-line 1140
            row = buildRowContent("continueWatching", "Row", [item])
            m.assertTrue(Instr(1, row.getChild(0).HDPosterUrl, "/episode/Images/Primary") > 0)
        end function

        @it("uses series artwork for continueWatching when off")
        function _()
            m.top.settings = { "home-episode-images": "off" }
            item = { Id: "episode", Type: "Episode", ImageTags: { Primary: "still" }, ParentThumbItemId: "series", ParentThumbImageTag: "thumb" }
            'bs:disable-next-line 1140
            row = buildRowContent("continueWatching", "Row", [item])
            m.assertTrue(Instr(1, row.getChild(0).HDPosterUrl, "/series/Images/Thumb") > 0)
        end function

        @it("uses episode stills for nextUp when on")
        function _()
            m.top.settings = { "home-episode-images": "on" }
            item = { Id: "episode", Type: "Episode", ImageTags: { Primary: "still" }, ParentThumbItemId: "series", ParentThumbImageTag: "thumb" }
            'bs:disable-next-line 1140
            row = buildRowContent("nextUp", "Row", [item])
            m.assertTrue(Instr(1, row.getChild(0).HDPosterUrl, "/episode/Images/Primary") > 0)
        end function

        @it("uses series artwork for nextUp when off")
        function _()
            m.top.settings = { "home-episode-images": "off" }
            item = { Id: "episode", Type: "Episode", ImageTags: { Primary: "still" }, ParentThumbItemId: "series", ParentThumbImageTag: "thumb" }
            'bs:disable-next-line 1140
            row = buildRowContent("nextUp", "Row", [item])
            m.assertTrue(Instr(1, row.getChild(0).HDPosterUrl, "/series/Images/Thumb") > 0)
        end function

        @it("falls back to series artwork without an episode still")
        function _()
            item = { Id: "episode", Type: "Episode", ImageTags: {}, ParentThumbItemId: "series", ParentThumbImageTag: "thumb" }
            'bs:disable-next-line 1140
            row = buildRowContent("nextUp", "Row", [item])
            m.assertTrue(Instr(1, row.getChild(0).HDPosterUrl, "/series/Images/Thumb") > 0)
        end function

        @it("leaves movie artwork unchanged")
        function _()
            item = { Id: "movie", Type: "Movie", ImageTags: { Primary: "poster", Thumb: "thumb" } }
            'bs:disable-next-line 1140
            row = buildRowContent("continueWatching", "Row", [item])
            m.assertTrue(Instr(1, row.getChild(0).HDPosterUrl, "/movie/Images/Thumb") > 0)
        end function

        @it("does not alter other Home rows")
        function _()
            m.top.settings = { "home-episode-images": "off" }
            item = { Id: "episode", Type: "Episode", ImageTags: { Primary: "still" }, ParentThumbItemId: "series", ParentThumbImageTag: "thumb" }
            'bs:disable-next-line 1140
            row = buildRowContent("libraries", "Row", [item])
            m.assertTrue(Instr(1, row.getChild(0).HDPosterUrl, "/episode/Images/Primary") > 0)
        end function

        @it("updates existing nodes without rebuilding shelves or starting requests")
        function _()
            item = { Id: "episode", Type: "Episode", ImageTags: { Primary: "still" }, ParentThumbItemId: "series", ParentThumbImageTag: "thumb" }
            'bs:disable-next-line 1140
            addRow("nextUp", "Next Up", [item])
            'bs:disable-next-line 1140
            renderRows(false)
            shelf = m.node.homeState.shelfNodes[0]
            row = m.node.homeState.rows.nextUp
            child = row.getChild(0)
            queryId = m.node.homeState.queryId
            taskCount = m.node.tasks.Count()

            m.top.settings = { "home-episode-images": "off" }

            m.assertTrue(m.node.homeState.shelfNodes[0].isSameNode(shelf))
            m.assertTrue(m.node.homeState.rows.nextUp.isSameNode(row))
            m.assertTrue(row.getChild(0).isSameNode(child))
            m.assertTrue(Instr(1, child.HDPosterUrl, "/series/Images/Thumb") > 0)
            m.assertEqual(m.node.homeState.queryId, queryId)
            m.assertEqual(m.node.tasks.Count(), taskCount)
        end function

        @it("uses the latest preference for a pending response")
        function _()
            'bs:disable-next-line 1001
            m.stubCall(runHomeTask, m.createControlledHomeTask)
            m.startPermissionRefresh({ canAccessLiveTv: false })
            m.top.settings = { "home-episode-images": "off" }
            m.node.tasks.nextUp.response = { ok: true, action: "nextUp", payload: { Items: [{ Id: "episode", Type: "Episode", ImageTags: { Primary: "still" }, ParentThumbItemId: "series", ParentThumbImageTag: "thumb" }] } }
            m.assertTrue(Instr(1, m.node.homeState.rows.nextUp.getChild(0).HDPosterUrl, "/series/Images/Thumb") > 0)
        end function

        @it("replaces the previous account image preference")
        function _()
            m.top.settings = { "home-episode-images": "on" }
            m.top.settings = {}
            item = { Id: "episode", Type: "Episode", ImageTags: { Primary: "still" }, ParentThumbItemId: "series", ParentThumbImageTag: "thumb" }
            'bs:disable-next-line 1140
            row = buildRowContent("nextUp", "Row", [item])
            m.assertTrue(Instr(1, row.getChild(0).HDPosterUrl, "/series/Images/Thumb") > 0)
        end function

        @it("ignores unrelated settings changes")
        function _()
            'bs:disable-next-line 1140
            addRow("nextUp", "Next Up", [{ Id: "episode", Type: "Episode", ImageTags: { Primary: "still" } }])
            child = m.node.homeState.rows.nextUp.getChild(0)
            before = child.HDPosterUrl
            m.top.settings = { "home-episode-images": "on", "theme-music": "on" }
            m.assertEqual(child.HDPosterUrl, before)
            m.assertTrue(m.node.homeState.rows.nextUp.getChild(0).isSameNode(child))
        end function

        @describe("Live TV permission and denied responses")

        @it("finishes Home without a Live TV task when permission is denied")
        function _()
            m.stubCall(AppMessage.Show, m.captureStatusMessage)
            m.stubCall(AppMessage.Dismiss, m.captureStatusClear)

            'bs:disable-next-line 1001
            m.stubCall(runHomeTask, m.createControlledHomeTask)
            m.startPermissionRefresh({ canAccessLiveTv: false })

            m.assertFalse(m.node.tasks.DoesExist("liveTvOnNow"))
            m.assertFalse(m.node.homeState.refresh.pendingCore.DoesExist("liveTvOnNow"))
            m.assertEqual(m.node.tasks.Count(), 4)
            m.finishOtherHomeRows()

            m.assertTrue(m.top.ready)
            m.assertTrue(m.top.visible)
            m.assertEqual(m.top.getScene().findNode("loadingSpinner").control, "stop")
            m.assertEqual(m.top.findNode("shelvesGroup").getChildCount(), 1)
            m.assertEqual(getGlobalAa().homeStatusCapture.message, "")
        end function

        @it("finishes Home without a Live TV task when permission is missing")
        function _()
            m.stubCall(AppMessage.Show, m.captureStatusMessage)
            m.stubCall(AppMessage.Dismiss, m.captureStatusClear)

            'bs:disable-next-line 1001
            m.stubCall(runHomeTask, m.createControlledHomeTask)
            m.startPermissionRefresh(invalid)

            m.assertFalse(m.node.tasks.DoesExist("liveTvOnNow"))
            m.assertFalse(m.node.homeState.refresh.pendingCore.DoesExist("liveTvOnNow"))
            m.assertEqual(m.node.tasks.Count(), 4)
            m.finishOtherHomeRows()

            m.assertTrue(m.top.ready)
            m.assertTrue(m.top.visible)
            m.assertEqual(m.top.getScene().findNode("loadingSpinner").control, "stop")
            m.assertEqual(m.top.findNode("shelvesGroup").getChildCount(), 1)
            m.assertEqual(getGlobalAa().homeStatusCapture.message, "")
        end function

        @it("loads On Now when Live TV permission is granted")
        function _()
            m.stubCall(AppMessage.Show, m.captureStatusMessage)
            m.stubCall(AppMessage.Dismiss, m.captureStatusClear)

            'bs:disable-next-line 1001
            m.stubCall(runHomeTask, m.createControlledHomeTask)
            m.startPermissionRefresh({ canAccessLiveTv: true })
            m.assertTrue(m.node.tasks.DoesExist("liveTvOnNow"))
            m.assertTrue(m.node.tasks.liveTvOnNow.request.permissions.canAccessLiveTv)

            m.node.tasks.liveTvOnNow.response = { ok: true, action: "liveTvOnNow", payload: { Items: [{ Id: "program", Name: "Fixture", Type: "Program", ImageTags: {} }] } }
            m.finishOtherHomeRows()

            m.assertTrue(m.top.ready)
            m.assertTrue(m.node.homeState.rows.DoesExist("liveTvOnNow"))
            m.assertEqual(m.top.findNode("shelvesGroup").getChildCount(), 2)
        end function

        @it("omits a denied On Now row when its 403 arrives first")
        function _()
            m.stubCall(AppMessage.Show, m.captureStatusMessage)
            m.stubCall(AppMessage.Dismiss, m.captureStatusClear)

            'bs:disable-next-line 1001
            m.stubCall(runHomeTask, m.createControlledHomeTask)
            m.startPermissionRefresh({ canAccessLiveTv: true })

            getGlobalAa().homeStatusCapture.message = "Unrelated message"
            getGlobalAa().homeStatusCapture.writes = 0
            getGlobalAa().homeStatusCapture.clears = 0

            m.node.tasks.liveTvOnNow.response = { ok: false, action: "liveTvOnNow", status: 403, failureKind: "accessDenied", errorMessage: "Forbidden" }

            m.assertEqual(getGlobalAa().homeStatusCapture.message, "Unrelated message")
            m.assertEqual(getGlobalAa().homeStatusCapture.writes, 0)
            m.assertEqual(getGlobalAa().homeStatusCapture.clears, 0)
            m.assertFalse(m.top.ready)
            m.assertEqual(m.top.getScene().findNode("loadingSpinner").control, "start")
            m.finishOtherHomeRows()
            m.assertTrue(m.top.ready)
            m.assertTrue(m.top.visible)
            m.assertFalse(m.node.homeState.rows.DoesExist("liveTvOnNow"))
            m.assertEqual(m.top.findNode("shelvesGroup").getChildCount(), 1)
            m.assertEqual(m.top.getScene().findNode("loadingSpinner").control, "stop")
        end function

        @it("omits a denied On Now row when its 403 arrives last")
        function _()
            m.stubCall(AppMessage.Show, m.captureStatusMessage)
            m.stubCall(AppMessage.Dismiss, m.captureStatusClear)

            'bs:disable-next-line 1001
            m.stubCall(runHomeTask, m.createControlledHomeTask)
            m.startPermissionRefresh({ canAccessLiveTv: true })
            m.finishOtherHomeRows()
            getGlobalAa().homeStatusCapture.message = "Unrelated message"
            getGlobalAa().homeStatusCapture.writes = 0
            getGlobalAa().homeStatusCapture.clears = 0

            m.node.tasks.liveTvOnNow.response = { ok: false, action: "liveTvOnNow", status: 403, failureKind: "accessDenied", errorMessage: "Forbidden" }

            m.assertEqual(getGlobalAa().homeStatusCapture.message, "Unrelated message")
            m.assertEqual(getGlobalAa().homeStatusCapture.writes, 0)
            m.assertEqual(getGlobalAa().homeStatusCapture.clears, 0)

            m.assertTrue(m.top.ready)
            m.assertTrue(m.top.visible)
            m.assertFalse(m.node.homeState.rows.DoesExist("liveTvOnNow"))
            m.assertEqual(m.top.findNode("shelvesGroup").getChildCount(), 1)
            m.assertEqual(m.top.getScene().findNode("loadingSpinner").control, "stop")
        end function

        @it("retains other Live TV errors")
        function _()
            m.stubCall(AppMessage.Show, m.captureStatusMessage)
            m.stubCall(AppMessage.Dismiss, m.captureStatusClear)

            response = { ok: false, action: "liveTvOnNow", status: 500, failureKind: "serverError", errorMessage: "Visible failure" }

            'bs:disable-next-line 1140
            ignored = handleHomeResponseFailure(response)
            'bs:disable-next-line 1140
            publishHomeRefreshMessages()

            m.assertTrue(ignored)
            m.assertEqual(getGlobalAa().homeStatusCapture.message, "Unable to load On Now. The server encountered an error.")
        end function

        @it("retains non Live TV permission errors")
        function _()
            m.stubCall(AppMessage.Show, m.captureStatusMessage)
            m.stubCall(AppMessage.Dismiss, m.captureStatusClear)

            response = { ok: false, action: "continueWatching", status: 403, failureKind: "accessDenied", errorMessage: "Visible failure" }

