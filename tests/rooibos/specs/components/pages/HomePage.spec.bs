namespace tests

    @SGNode("HomePage")
    @suite("HomePage component")
    class HomePageTests extends rooibos.BaseTestSuite

        protected override function beforeEach()
            m.node.homeState.request = { server: "http://server", token: "token", userId: "user" }
            m.node.homeState.rows = {}
            m.node.homeState.playbackRows.continueWatchingItems = []
            m.node.homeState.playbackRows.nextUpItems = []
            m.node.homeState.focusedShelfIndex = 0
            m.top.overlayRequested = invalid
            m.top.selectedLibrary = invalid
            m.top.selectedHomeMediaLibrary = invalid
            m.top.selectedHomeMediaVideo = invalid
            m.top.selectedHomeMediaPhoto = invalid

            scene = m.top.getScene()
            if scene.findNode("loadingSpinner") = invalid then
                loadingSpinnerNode = CreateObject("roSGNode", "Spinner")
                loadingSpinnerNode.id = "loadingSpinner"
                scene.appendChild(loadingSpinnerNode)
            end if
        end function
        @describe("declarative component contract")

        @it("declares the contentGroup node")
        function _()
            m.assertNotInvalid(m.top.findNode("contentGroup"))
        end function

        @it("declares the shelfViewport node")
        function _()
            m.assertNotInvalid(m.top.findNode("shelfViewport"))
        end function

        @it("declares the shelvesGroup node")
        function _()
            m.assertNotInvalid(m.top.findNode("shelvesGroup"))
        end function

        @it("declares the shelvesAnimation node")
        function _()
            m.assertNotInvalid(m.top.findNode("shelvesAnimation"))
        end function

        @it("declares the shelvesTranslation node")
        function _()
            m.assertNotInvalid(m.top.findNode("shelvesTranslation"))
        end function

        @it("declares the dynamic task registration field")
        function _()
            m.assertTrue(m.top.hasField("taskCreated"))
        end function

        @describe("selection routing")

        @it("routes collection libraries")
        function _()
            item = m.createLibrary("collection-1", "boxsets")

            'bs:disable-next-line 1140
            selectHomeItem(item)

            m.assertEqual(m.top.selectedCollections.libraryId, "collection-1")
        end function

        @it("routes Live TV libraries")
        function _()
            item = m.createLibrary("live-1", "livetv")

            'bs:disable-next-line 1140
            selectHomeItem(item)

            m.assertEqual(m.top.selectedLiveTV.libraryId, "live-1")
        end function

        @it("routes music libraries")
        function _()
            item = m.createLibrary("music-1", "music")

            'bs:disable-next-line 1140
            selectHomeItem(item)

            m.assertEqual(m.top.selectedMusicLibrary.libraryId, "music-1")
        end function

        @it("routes media libraries")
        function _()
            item = m.createLibrary("movies-1", "movies")

            'bs:disable-next-line 1140
            selectHomeItem(item)

            m.assertEqual(m.top.selectedLibrary.libraryId, "movies-1")
        end function

        @it("routes home media libraries separately from video libraries")
        function _()
            item = m.createLibrary("home-media-1", "homevideos")

            'bs:disable-next-line 1140
            selectHomeItem(item)

            m.assertEqual(m.top.selectedHomeMediaLibrary.libraryId, "home-media-1")
            m.assertInvalid(m.top.selectedLibrary)
        end function

        @it("routes latest home media videos directly to playback")
        function _()
            item = { Id: "video-1", Type: "Video" }

            'bs:disable-next-line 1140
            selectHomeMediaLatestItem(item)

            m.assertEqual(m.top.selectedHomeMediaVideo.itemId, "video-1")
            m.assertFalse(m.top.selectedHomeMediaVideo.tracksPlaybackProgress)
            m.assertInvalid(m.top.selectedMovie)
        end function

        @it("routes latest home media photos to the photo viewer")
        function _()
            item = { Id: "photo-1", Type: "Photo", ParentId: "folder-1" }

            'bs:disable-next-line 1140
            selectHomeMediaLatestItem(item)

            m.assertEqual(m.top.selectedHomeMediaPhoto.items.Count(), 1)
            m.assertEqual(m.top.selectedHomeMediaPhoto.sourceFolderId, "folder-1")
        end function

        @it("routes music video libraries by collection type")
        function _()
            item = m.createLibrary("music-videos-1", "musicvideos")

            'bs:disable-next-line 1140
            selectHomeItem(item)

            m.assertEqual(m.top.selectedLibrary.libraryId, "music-videos-1")
            m.assertEqual(m.top.selectedLibrary.collectionType, "musicvideos")
        end function

        @it("routes episodes")
        function _()
            item = { Id: "episode-1", Type: "Episode" }

            'bs:disable-next-line 1140
            selectHomeItem(item)

            m.assertEqual(m.top.selectedEpisode.itemId, "episode-1")
        end function

        @it("routes movies")
        function _()
            item = { Id: "movie-1", Type: "Movie" }

            'bs:disable-next-line 1140
            selectHomeItem(item)

            m.assertEqual(m.top.selectedMovie.itemId, "movie-1")
        end function

        @it("routes series")
        function _()
            item = { Id: "series-1", Type: "Series" }

            'bs:disable-next-line 1140
            selectHomeItem(item)

            m.assertEqual(m.top.selectedSeries.itemId, "series-1")
        end function

        @it("routes music-row selections as albums")
        function _()
            item = { Id: "album-1", Type: "MusicAlbum" }

            'bs:disable-next-line 1140
            selectHomeAlbum(item)

            m.assertEqual(m.top.selectedAlbum.itemId, "album-1")
        end function

        @it("ignores selections without an id")
        function _()
            m.top.selectedMovie = invalid

            'bs:disable-next-line 1140
            selectHomeItem({ Type: "Movie" })

            m.assertInvalid(m.top.selectedMovie)
        end function

        @describe("row rendering")

        @it("renders valid items into row content")
        function _()
            'bs:disable-next-line 1140
            content = buildRowContent("continueWatching", "Continue Watching", [{ Id: "movie-1", Type: "Movie", ImageTags: {} }])

            m.assertEqual(content.title, "Continue Watching")
            m.assertEqual(content.getChildCount(), 1)
            m.assertTrue(content.getChild(0).showMetadata)
        end function

        @it("hides metadata for library cards")
        function _()
            'bs:disable-next-line 1140
            content = buildRowContent("libraries", "My Media", [m.createLibrary("movies-1", "movies")])

            m.assertFalse(content.getChild(0).showMetadata)
            m.assertEqual(content.getChild(0).imageAspect, "thumbnail")
        end function

        @it("disables playback progress presentation for Home Media latest videos")
        function _()
            m.node.homeState.latestLibraries["home-media-1"] = { id: "home-media-1", collectionType: "homevideos" }

            'bs:disable-next-line 1140
            content = buildRowContent("latest:home-media-1", "Recently Added", [{ Id: "video-1", Type: "Video", ImageTags: {} }])

            m.assertFalse(content.getChild(0).tracksPlaybackProgress)
        end function

        @it("disables playback progress presentation for Home Media latest folders")
        function _()
            m.node.homeState.latestLibraries["home-media-1"] = { id: "home-media-1", collectionType: "homevideos" }

            'bs:disable-next-line 1140
            content = buildRowContent("latest:home-media-1", "Recently Added", [{ Id: "folder-1", Type: "Folder", ImageTags: {} }])

            m.assertFalse(content.getChild(0).tracksPlaybackProgress)
        end function

        @it("disables playback progress presentation for Home Media latest photos")
        function _()
            m.node.homeState.latestLibraries["home-media-1"] = { id: "home-media-1", collectionType: "homevideos" }

            'bs:disable-next-line 1140
            content = buildRowContent("latest:home-media-1", "Recently Added", [{ Id: "photo-1", Type: "Photo", ImageTags: {} }])

            m.assertFalse(content.getChild(0).tracksPlaybackProgress)
        end function

        @it("leaves ordinary latest videos on the default progress policy")
        function _()
            m.node.homeState.latestLibraries["videos-1"] = { id: "videos-1", collectionType: "movies" }

            'bs:disable-next-line 1140
            content = buildRowContent("latest:videos-1", "Recently Added", [{ Id: "video-1", Type: "Video", ImageTags: {} }])

            m.assertInvalid(content.getChild(0).tracksPlaybackProgress)
        end function

        @it("removes an empty row")
        function _()
            'bs:disable-next-line 1140
            addRow("nextUp", "Next Up", [{ Id: "episode-1", Type: "Episode", ImageTags: {} }])
            'bs:disable-next-line 1140
            addRow("nextUp", "Next Up", [])

            m.assertFalse(m.node.homeState.rows.DoesExist("nextUp"))
        end function

        @it("renders rows in configured order")
        function _()
            'bs:disable-next-line 1140
            addRow("nextUp", "Next Up", [{ Id: "episode-1", Type: "Episode", ImageTags: {} }])
            'bs:disable-next-line 1140
            addRow("libraries", "My Media", [m.createLibrary("movies-1", "movies")])

            'bs:disable-next-line 1140
            renderRows(false)

            m.assertEqual(m.top.findNode("shelvesGroup").getChildCount(), 2)
            m.assertEqual(m.top.findNode("shelvesGroup").getChild(0).rowContent.rowKey, "libraries")
            m.assertEqual(m.top.findNode("shelvesGroup").getChild(1).rowContent.rowKey, "nextUp")
        end function

        @it("filters Next Up items already represented by item id")
        function _()
            m.node.homeState.playbackRows.continueWatchingItems = [{ Id: "episode-1", SeriesId: "series-1" }]
            m.node.homeState.playbackRows.nextUpItems = [{ Id: "episode-1" }, { Id: "episode-2", SeriesId: "series-2" }]

            'bs:disable-next-line 1140
            items = getFilteredNextUpItems()

            m.assertEqual(items.Count(), 1)
            m.assertEqual(items[0].Id, "episode-2")
        end function

        @it("filters Next Up items already represented by series id")
        function _()
            m.node.homeState.playbackRows.continueWatchingItems = [{ Id: "episode-1", SeriesId: "series-1" }]
            m.node.homeState.playbackRows.nextUpItems = [{ Id: "episode-2", SeriesId: "series-1" }, { Id: "episode-3", SeriesId: "series-2" }]

            'bs:disable-next-line 1140
            items = getFilteredNextUpItems()

            m.assertEqual(items.Count(), 1)
            m.assertEqual(items[0].Id, "episode-3")
        end function

        @describe("refresh lifecycle")

        @it("adds the current generation and session identity to task requests")
        function _()
            m.node.homeState.queryId = 7
            m.node.homeState.sessionKey = "account-1"

            'bs:disable-next-line 1140
            request = buildHomeTaskRequest(m.node.homeState.request)

            m.assertEqual(request.homeQueryId, 7)
            m.assertEqual(request.homeSessionKey, "account-1")
        end function

        @it("accepts only the currently owned task for the active refresh")
        function _()
            task = CreateObject("roSGNode", "HomeLibrariesTask")
            task.request = { homeQueryId: 7, homeSessionKey: "account-1" }
            m.top.appendChild(task)
            m.node.tasks.libraries = task
            m.node.homeState.queryId = 7
            m.node.homeState.sessionKey = "account-1"

            'bs:disable-next-line 1140
            current = isCurrentHomeTask(task, "libraries")

            m.assertTrue(current)
            'bs:disable-next-line 1140
            cleanupHomeTasks()
        end function

        @it("rejects a task from an earlier refresh generation")
        function _()
            task = CreateObject("roSGNode", "HomeLibrariesTask")
            task.request = { homeQueryId: 6, homeSessionKey: "account-1" }
            m.top.appendChild(task)
            m.node.tasks.libraries = task
            m.node.homeState.queryId = 7
            m.node.homeState.sessionKey = "account-1"

            'bs:disable-next-line 1140
            current = isCurrentHomeTask(task, "libraries")

            m.assertFalse(current)
            'bs:disable-next-line 1140
            cleanupHomeTasks()
        end function

        @it("does not complete the active refresh from a stale response")
        function _()
            task = CreateObject("roSGNode", "ContinueWatchingTask")
            task.request = { homeQueryId: 6, homeSessionKey: "account-1" }
            task.observeField("response", "onSectionResponse")
            m.top.appendChild(task)
            m.node.tasks.continueWatching = task
            m.node.homeState.queryId = 7
            m.node.homeState.sessionKey = "account-1"
            m.node.homeState.refresh.pendingCore = { continueWatching: true }

            task.response = { ok: true, action: "continueWatching", payload: { Items: [{ Id: "stale-item" }] } }

            m.assertTrue(m.node.homeState.refresh.pendingCore.DoesExist("continueWatching"))
            m.assertEqual(m.node.homeState.playbackRows.continueWatchingItems.Count(), 0)
            'bs:disable-next-line 1140
            cleanupHomeTasks()
        end function

        @it("rejects a task from an earlier account session")
        function _()
            task = CreateObject("roSGNode", "HomeLibrariesTask")
            task.request = { homeQueryId: 7, homeSessionKey: "account-1" }
            m.top.appendChild(task)
            m.node.tasks.libraries = task
            m.node.homeState.queryId = 7
            m.node.homeState.sessionKey = "account-2"

            'bs:disable-next-line 1140
            current = isCurrentHomeTask(task, "libraries")

            m.assertFalse(current)
            'bs:disable-next-line 1140
            cleanupHomeTasks()
        end function

        @it("removes superseded core and latest-media tasks")
        function _()
            coreTask = CreateObject("roSGNode", "HomeLibrariesTask")
            coreTask.id = "ownedCoreTask"
            latestTask = CreateObject("roSGNode", "LatestMediaTask")
            latestTask.id = "ownedLatestTask"
            m.top.appendChild(coreTask)
            m.top.appendChild(latestTask)
            m.node.tasks.libraries = coreTask
            m.node.homeState.latestTasks = [latestTask]

            'bs:disable-next-line 1140
            cleanupHomeTasks()

            m.assertInvalid(m.top.findNode("ownedCoreTask"))
            m.assertInvalid(m.top.findNode("ownedLatestTask"))
            m.assertEqual(m.node.tasks.Count(), 0)
            m.assertEqual(m.node.homeState.latestTasks.Count(), 0)
        end function

        @describe("focus and keyboard behavior")

        @it("moves down to the next shelf")
        function _()
            m.renderTwoRows()

            'bs:disable-next-line 1140
            handled = onKeyEvent("down", true)

            m.assertTrue(handled)
            m.assertEqual(m.node.homeState.focusedShelfIndex, 1)
        end function

        @it("emits upward focus exit from the first shelf")
        function _()
            m.renderTwoRows()
            m.top.focusExitUp = false

            'bs:disable-next-line 1140
            handled = onKeyEvent("up", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.focusExitUp)
        end function

        @it("does not move below the last shelf")
        function _()
            m.renderTwoRows()
            'bs:disable-next-line 1140
            focusShelf(1)

            'bs:disable-next-line 1140
            handled = onKeyEvent("down", true)

            m.assertFalse(handled)
            m.assertEqual(m.node.homeState.focusedShelfIndex, 1)
        end function

        @it("ignores released keys")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("up", false)

            m.assertFalse(handled)
        end function

        function renderTwoRows()
            'bs:disable-next-line 1140
            addRow("libraries", "My Media", [m.createLibrary("movies-1", "movies")])
            'bs:disable-next-line 1140
            addRow("nextUp", "Next Up", [{ Id: "episode-1", Type: "Episode", ImageTags: {} }])
            'bs:disable-next-line 1140
            renderRows(false)
            m.node.homeState.focusedShelfIndex = 0
        end function

        function createLibrary(id as string, collectionType as string) as object
            return { Id: id, Name: id, Type: "CollectionFolder", CollectionType: collectionType, ImageTags: {}, BackdropImageTags: [] }
        end function
    end class

end namespace
