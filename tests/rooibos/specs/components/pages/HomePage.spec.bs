        @describe("row rendering")

        @it("renders valid items into row content")
        function _()
            'bs:disable-next-line 1140
            content = buildRowContent("continueWatching", "Continue Watching", [{ Id: "movie-1", Type: "Movie", ImageTags: {} }])

            m.assertEqual(content.title, "Continue Watching")
            m.assertEqual(content.getChildCount(), 1)
            m.assertTrue(content.getChild(0).showMetadata)
        end function

        @it("hides metadata for library cards")
        function _()
            'bs:disable-next-line 1140
            content = buildRowContent("libraries", "My Media", [m.createLibrary("movies-1", "movies")])

            m.assertFalse(content.getChild(0).showMetadata)
            m.assertEqual(content.getChild(0).imageAspect, "thumbnail")
        end function

        @it("disables playback progress presentation for Home Media latest videos")
        function _()
