namespace tests

    @SGNode("LiveTV")
    @suite("LiveTV component")
    class LiveTVTests extends rooibos.BaseTestSuite

        protected override function beforeEach()
            m.node.liveTvState.request = { server: "http://server", token: "token", userId: "user" }
            m.node.liveTvState.isLoading = false
            m.node.liveTvState.hasLoaded = false
            m.node.liveTvState.genres = {}
            m.top.playSelected = invalid
            m.top.closeRequested = false
            m.top.findNode("guideGrid").content = CreateObject("roSGNode", "ContentNode")
        end function
        @describe("declarative component contract")

        @it("declares the previewBg node")
        function _()
            m.assertNotInvalid(m.top.findNode("previewBg"))
        end function

        @it("declares the titleLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("titleLabel"))
        end function

        @it("declares the previewGroup node")
        function _()
            m.assertNotInvalid(m.top.findNode("previewGroup"))
        end function

        @it("declares the previewTextGroup node")
        function _()
            m.assertNotInvalid(m.top.findNode("previewTextGroup"))
        end function

        @it("declares the programTitle node")
        function _()
            m.assertNotInvalid(m.top.findNode("programTitle"))
        end function

        @it("declares the programMetaGroup node")
        function _()
            m.assertNotInvalid(m.top.findNode("programMetaGroup"))
        end function

        @it("declares the programTime node")
        function _()
            m.assertNotInvalid(m.top.findNode("programTime"))
        end function

        @it("declares the programDuration node")
        function _()
            m.assertNotInvalid(m.top.findNode("programDuration"))
        end function

        @it("declares the programChannel node")
        function _()
            m.assertNotInvalid(m.top.findNode("programChannel"))
        end function

        @it("declares the programEpisode node")
        function _()
            m.assertNotInvalid(m.top.findNode("programEpisode"))
        end function

        @it("declares the programOverview node")
        function _()
            m.assertNotInvalid(m.top.findNode("programOverview"))
        end function

        @it("declares the programImage node")
        function _()
            m.assertNotInvalid(m.top.findNode("programImage"))
        end function

        @it("declares the emptyPreviewGroup node")
        function _()
            m.assertNotInvalid(m.top.findNode("emptyPreviewGroup"))
        end function

        @it("declares the emptyPreviewTitle node")
        function _()
            m.assertNotInvalid(m.top.findNode("emptyPreviewTitle"))
        end function

        @it("declares the emptyPreviewMessage node")
        function _()
            m.assertNotInvalid(m.top.findNode("emptyPreviewMessage"))
        end function

        @it("declares the guideGrid node")
        function _()
            m.assertNotInvalid(m.top.findNode("guideGrid"))
        end function

        @it("declares the channelsTask node")
        function _()
            m.assertNotInvalid(m.top.findNode("channelsTask"))
        end function

        @it("declares the scheduleBatchTimer node")
        function _()
            m.assertNotInvalid(m.top.findNode("scheduleBatchTimer"))
        end function

        @describe("guide rendering")

        @it("builds guide channels with title and identity")
        function _()
            'bs:disable-next-line 1140
            content = buildGuideChannels([m.createChannel("channel-1", "7", "News")])

            m.assertEqual(content.getChildCount(), 1)
            m.assertEqual(content.getChild(0).Title, "7 News")
            m.assertEqual(content.getChild(0).channelId, "channel-1")
        end function

        @it("declares the dynamic task registration field")
        function _()
            m.assertTrue(m.top.hasField("taskCreated"))
        end function

        @it("ignores channels without an id")
        function _()
            'bs:disable-next-line 1140
            content = buildGuideChannels([{ Name: "Invalid" }])

            m.assertEqual(content.getChildCount(), 0)
        end function

        @it("renders a channel image URL when a primary tag exists")
        function _()
            channel = m.createChannel("channel-1", "7", "News")
            channel.ImageTags = { Primary: "tag" }

            'bs:disable-next-line 1140
            content = buildGuideChannels([channel])

            m.assertTrue(Instr(1, content.getChild(0).HDPosterUrl, "channel-1") > 0)
        end function

        @it("adds valid schedule programs to their channel")
        function _()
            grid = m.top.findNode("guideGrid")
            'bs:disable-next-line 1140
            grid.content = buildGuideChannels([m.createChannel("channel-1", "7", "News")])
            program = m.createProgram("program-1", "channel-1")

            'bs:disable-next-line 1140
            addSchedulePrograms([program])

            m.assertEqual(grid.content.getChild(0).getChildCount(), 1)
            m.assertEqual(grid.content.getChild(0).getChild(0).Title, "Program")
        end function

        @it("ignores schedule programs for unknown channels")
        function _()
            grid = m.top.findNode("guideGrid")
            'bs:disable-next-line 1140
            grid.content = buildGuideChannels([m.createChannel("channel-1", "7", "News")])

            'bs:disable-next-line 1140
            addSchedulePrograms([m.createProgram("program-1", "missing")])

            m.assertEqual(grid.content.getChild(0).getChildCount(), 0)
        end function

        @describe("preview rendering")

        @it("renders program preview fields")
        function _()
            program = CreateObject("roSGNode", "ContentNode")
            program.Title = "Movie"
            program.Description = "Overview"
            program.PlayDuration = 3600
            program.AddFields({ channelName: "Channel", episodeTitle: "Pilot", startDate: "", endDate: "", channelImage: "channel.png", raw: invalid })

            'bs:disable-next-line 1140
            renderProgramPreview(program)

            m.assertTrue(m.top.findNode("previewGroup").visible)
            m.assertEqual(m.top.findNode("programTitle").text, "Movie")
            m.assertEqual(m.top.findNode("programDuration").text, "1h 0m")
            m.assertEqual(m.top.findNode("programChannel").text, "Channel")
            m.assertEqual(m.top.findNode("programEpisode").text, "Pilot")
        end function

        @it("renders channel fallback preview")
        function _()
            channel = CreateObject("roSGNode", "ContentNode")
            channel.Title = "News"
            channel.HDPosterUrl = "channel.png"

            'bs:disable-next-line 1140
            renderChannelPreview(channel)

            m.assertEqual(m.top.findNode("programTitle").text, "News")
            m.assertEqual(m.top.findNode("programOverview").text, "No schedule information")
            m.assertEqual(m.top.findNode("programImage").uri, "channel.png")
        end function

        @it("renders an empty preview message")
        function _()
            'bs:disable-next-line 1140
            showEmptyPreview("No channels", "Nothing available")

            m.assertFalse(m.top.findNode("previewGroup").visible)
            m.assertTrue(m.top.findNode("emptyPreviewGroup").visible)
            m.assertEqual(m.top.findNode("emptyPreviewTitle").text, "No channels")
            m.assertEqual(m.top.findNode("emptyPreviewMessage").text, "Nothing available")
        end function

        @it("formats season and episode identity")
        function _()
            program = { raw: { ParentIndexNumber: 2, IndexNumber: 3 }, episodeTitle: "Title" }

            'bs:disable-next-line 1140
            text = getProgramEpisodeText(program)

            m.assertEqual(text, "S2 E3  |  Title")
        end function

        @describe("playback payloads")

        @it("builds program playback data")
        function _()
            program = CreateObject("roSGNode", "ContentNode")
            program.Title = "Program"
            program.AddFields({ channelName: "News", raw: { Id: "program-1" } })

            'bs:disable-next-line 1140
            item = buildPlaybackItem(program, "channel-1")

            m.assertEqual(item.Id, "channel-1")
            m.assertEqual(item.Name, "News")
            m.assertEqual(item.Type, "TvChannel")
            m.assertEqual(item.CurrentProgram.Id, "program-1")
        end function

        @it("builds channel playback data without a program")
        function _()
            channel = CreateObject("roSGNode", "ContentNode")
            channel.Title = "News"
            channel.AddFields({ raw: { Id: "channel-1" } })

            'bs:disable-next-line 1140
            item = buildChannelPlaybackItem(channel, "channel-1")

            m.assertEqual(item.Id, "channel-1")
            m.assertInvalid(item.CurrentProgram)
        end function

        @it("joins valid channel ids")
        function _()
            'bs:disable-next-line 1140
            ids = getChannelIds([m.createChannel("one", "1", "One"), { Name: "Missing" }, m.createChannel("two", "2", "Two")])

            m.assertEqual(ids, "one,two")
        end function

        @describe("lifecycle and keyboard behavior")

        @it("focuses the guide when loaded")
        function _()
            m.node.liveTvState.hasLoaded = true

            m.top.callFunc("activate")

            m.assertTrue(m.top.findNode("guideGrid").hasFocus())
        end function

        @it("deactivation stops loading and batching")
        function _()
            m.node.liveTvState.isLoading = true
            m.node.liveTvState.schedule.backgroundLoading = true
            m.top.findNode("scheduleBatchTimer").control = "start"

            m.top.callFunc("deactivate")

            m.assertFalse(m.node.liveTvState.isLoading)
            m.assertFalse(m.node.liveTvState.schedule.backgroundLoading)
            m.assertEqual(m.top.findNode("scheduleBatchTimer").control, "stop")
        end function

        @it("removes an owned dynamic schedule task when stopped")
        function _()
            task = CreateObject("roSGNode", "LiveTvScheduleTask")
            task.id = "ownedScheduleTask"
            m.top.appendChild(task)
            m.node.scheduleTask = task

            'bs:disable-next-line 1140
            stopScheduleTask()

            m.assertInvalid(m.node.scheduleTask)
            m.assertInvalid(m.top.findNode("ownedScheduleTask"))
        end function

        @it("Back deactivates and requests close")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("back", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.closeRequested)
        end function

        @it("ignores unrelated pressed keys")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("up", true)

            m.assertFalse(handled)
        end function

        @it("ignores released keys")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("back", false)

            m.assertFalse(handled)
        end function

        function createChannel(id as string, channelNumber as string, name as string) as object
            return { Id: id, Number: channelNumber, Name: name, ImageTags: {} }
        end function

        function createProgram(id as string, channelId as string) as object
            return {
                Id: id
                ChannelId: channelId
                Name: "Program"
                Overview: "Overview"
                StartDate: "2026-08-24T12:00:00Z"
                EndDate: "2026-08-24T13:00:00Z"
                IsLive: false
                IsRepeat: false
                Genres: []
                GenreItems: []
                Tags: []
                ImageTags: {}
                BackdropImageTags: []
            }
        end function
    end class

end namespace
