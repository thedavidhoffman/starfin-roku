namespace tests

    @SGNode("DvdPosterCard")
    @suite("DVD poster labels")
    class DvdPosterCardTests extends rooibos.BaseTestSuite

        @describe("contained text and focus")

        @it("bounds both labels to the poster width while retaining full text")
        function _()
            content = CreateObject("roSGNode", "ContentNode")
            content.title = "A long DVD title that must not overlap its neighboring card"
            content.addFields({ caption: "A long secondary label", posterPath: "", metadataId: "" })
            m.top.itemContent = content

            'bs:disable-next-line 1140
            renderCard()

            m.assertEqual(m.node.nodes.title.maxWidth, 252.0)
            m.assertEqual(m.node.nodes.caption.maxWidth, 252.0)
            m.assertEqual(m.node.nodes.title.text, content.title)
        end function

        @it("starts scrolling on focus and stops on blur")
        function _()
            m.top.itemHasFocus = true
            'bs:disable-next-line 1140
            updateFocus()

            m.assertEqual(m.node.nodes.title.repeatCount, -1)
            m.assertEqual(m.node.nodes.caption.repeatCount, -1)

            m.top.itemHasFocus = false
            'bs:disable-next-line 1140
            updateFocus()

            m.assertEqual(m.node.nodes.title.repeatCount, 0)
            m.assertEqual(m.node.nodes.caption.repeatCount, 0)
        end function

    end class

end namespace
