namespace tests

    @SGNode("LogUploadConfirmationDialog")
    @suite("LogUploadConfirmationDialog component")
    class LogUploadConfirmationDialogTests extends rooibos.BaseTestSuite

        @describe("confirmation behavior")

        @it("opens with Cancel focused")
        function _()
            m.top.callFunc("openConfirmation")
            m.assertTrue(m.top.callFunc("getContentComponent").findNode("cancel").hasFocus())
            m.assertFalse(m.top.sendConfirmed)
        end function

        @it("closes with the confirmed decision")
        function _()
            m.top.callFunc("openConfirmation")
            m.top.callFunc("getContentComponent").decision = true
            m.assertTrue(m.top.sendConfirmed)
            m.assertTrue(m.top.closeRequested)
        end function

        @it("closes on cancel without consenting")
        function _()
            m.top.callFunc("openConfirmation")
            m.top.callFunc("getContentComponent").decision = false
            m.assertFalse(m.top.sendConfirmed)
            m.assertTrue(m.top.closeRequested)
        end function

    end class

end namespace
