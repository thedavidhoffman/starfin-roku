namespace tests

    @SGNode("LogUploadConfirmationContent")
    @suite("LogUploadConfirmationContent component")
    class LogUploadConfirmationContentTests extends rooibos.BaseTestSuite

        @describe("confirmation behavior")

        @it("moves right to Send")
        function _()
            m.top.callFunc("focusCancel")
            'bs:disable-next-line 1140
            onKeyEvent("right", true)
            m.assertTrue(m.top.findNode("send").hasFocus())
        end function

        @it("moves left to Cancel")
        function _()
            m.top.findNode("send").setFocus(true)
            'bs:disable-next-line 1140
            onKeyEvent("left", true)
            m.assertTrue(m.top.findNode("cancel").hasFocus())
        end function

        @it("Back cancels the request")
        function _()
            m.top.decision = true
            'bs:disable-next-line 1140
            onKeyEvent("back", true)
            m.assertFalse(m.top.decision)
        end function

        @it("Send emits consent")
        function _()
            m.top.decision = false
            m.top.findNode("send").buttonSelected = true
            m.assertTrue(m.top.decision)
        end function

    end class

end namespace
