        function createPlaybackReturnRecorder() as object
            return {
                visible: false
                calls: []
                isSameNode: function(other as object) as boolean
                    return false
                end function
                isSubtype: function(componentName as string) as boolean
                    return false
                end function
                getParent: function() as object
                    return {}
                end function
                callFunc: function(name as string, payload = invalid as dynamic) as dynamic
                    m.calls.Push({ name: name, payload: payload })
                    return invalid
                end function
            }
        end function

