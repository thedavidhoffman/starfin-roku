import "pkg:/source/Char.bs"

namespace tests

    @SGNode("MainSceneTestHarness")
    @suite("MainScene component")
    class MainSceneTests extends rooibos.BaseTestSuite

        protected override function beforeEach()
            m.originalTheme = m.global.theme
            m.originalWatchedStyle = m.global.watchedIndicatorStyle
            m.originalCountMode = m.global.showUnwatchedEpisodeCount
            m.node.homePage = m.top.findNode("homePage")
            m.node.authController = m.top.findNode("authController")
            'bs:disable-next-line 1140
            resetDynamicPages()
            m.node.session = {
                server: "http://server"
                token: "token"
                userId: "user"
                accountKey: "account-1"
            }
            m.node.settings = SettingsStore.Defaults()
            m.node.performanceBeaconState = PerformanceBeacon.Create()
            m.node.deepLinkNavigation = {
                destinationId: -1
                destinationType: ""
                launchAwaitingDestination: false
                fallbackMessage: ""
                seasonDestinationId: -1
                seasonPage: invalid
            }
            m.node.homePage.visible = false
            m.node.header.visible = false
            m.node.playbackController.playRequest = invalid
            m.node.playbackController.playerOpened = false
            m.node.playbackController.selectedPerson = invalid
            m.node.playbackController.closed = invalid
        end function

        protected override function afterEach()
            m.global.theme = m.originalTheme
            m.global.watchedIndicatorStyle = m.originalWatchedStyle
            m.global.showUnwatchedEpisodeCount = m.originalCountMode
        end function

        @describe("Settings failure confirmation routing")

        @it("opens the confirmation without replacing Settings")
        function _()
            owner = m.node.overlayHost.callFunc("openOverlay", { id: "settings", componentName: "SettingsDialog", openFunction: "openSettings" })
            'bs:disable-next-line 1140
            routeSettingsSaveFailure({ kind: "open", requestId: 17, message: "Rejected" })

            m.assertTrue(owner.isSameNode(m.node.overlayHost.getChild(0)))
            confirmation = m.node.confirmationOverlayHost.getChild(0)
            m.assertEqual(confirmation.message, "Rejected")
            m.assertEqual(m.node.settingsConfirmation.requestId, 17)
            m.assertTrue(confirmation.callFunc("getContentComponent").findNode("keepEditing").isInFocusChain())

            'bs:disable-next-line 1140
            clearSettingsConfirmation()
            m.node.overlayHost.callFunc("closeOverlay", false)
        end function

        @it("ignores a dismissal from an obsolete confirmation request")
        function _()
            m.node.settingsConfirmation = { owner: invalid, requestId: 18 }
            'bs:disable-next-line 1140
            routeSettingsSaveFailure({ kind: "dismiss", requestId: 17 })
            m.assertEqual(m.node.settingsConfirmation.requestId, 18)
        end function

        @it("matching dismissal clears confirmation ownership")
        function _()
            m.node.settingsConfirmation = { owner: invalid, requestId: 18 }
            'bs:disable-next-line 1140
            routeSettingsSaveFailure({ kind: "dismiss", requestId: 18 })
            m.assertInvalid(m.node.settingsConfirmation.owner)
            m.assertEqual(m.node.settingsConfirmation.requestId, -1)
            m.assertEqual(m.node.confirmationOverlayHost.getChildCount(), 0)
        end function

        @describe("media options routing")

        @it("recognizes the shared media options overlay")
        function _()
            'bs:disable-next-line 1140
            m.assertTrue(isStreamOptionsOverlayRequest({ id: "mediaOptions" }))
        end function

        @it("does not recognize retired audio overlay requests")
        function _()
            'bs:disable-next-line 1140
            m.assertFalse(isStreamOptionsOverlayRequest({ id: "audioOptions" }))
        end function

        @it("forwards cancelled media options to the owning movie page")
        function _()
            owner = {
                received: invalid
                callFunc: function(name as string, closed as object) as dynamic
                    m.received = { name: name, closed: closed }
                    return invalid
                end function
            }
            m.node.moviePage = owner
            closed = { request: { id: "mediaOptions", sourcePage: "movie" }, overlay: invalid, cancelled: true }

            'bs:disable-next-line 1140
            navHandleStreamOptionsOverlayClosed(closed)

            m.assertEqual(owner.received, { name: "handleStreamOptionsOverlayClosed", closed: closed })
            m.node.moviePage = invalid
        end function

        @describe("session permission forwarding")

        @it("routes discovery selection and refreshes accounts for the chosen server")
        function _()
            controller = {
                lastServer: ""
                callFunc: function(name as string, server as string) as object
                    m.lastServer = server
                    return []
                end function
            }
            m.node.authController = controller
            m.node.login.visible = true
            m.node.login.usernameValue = "old-user"
            m.node.login.passwordValue = "old-password"

            'bs:disable-next-line 1140
            authHandleDiscoveryClosed({ overlay: { selectedServer: { address: "http://discovered:8097" } } })

            m.assertEqual(m.node.login.serverValue, "http://discovered:8097")
            m.assertEqual(controller.lastServer, "http://discovered:8097")
            m.assertEqual(m.node.login.savedAccounts, [])
            m.assertEqual(m.node.login.passwordValue, "")
        end function

        @it("ignores discovery results after leaving login")
        function _()
            m.node.login.visible = false
            previous = m.node.login.serverValue

            'bs:disable-next-line 1140
            authHandleDiscoveryClosed({ overlay: { selectedServer: { address: "http://late" } } })

            m.assertEqual(m.node.login.serverValue, previous)
        end function

        @it("passes runtime Live TV permissions to page load requests")
        function _()
            m.node.session = { server: "https://server", token: "token", userId: "user", accountKey: "server/user", permissions: { canAccessLiveTv: false }, homePreferences: { latestItemsExcludes: ["home"] } }

            'bs:disable-next-line 1140
            request = buildSessionLoadRequest()

            m.assertEqual(request.permissions, { canAccessLiveTv: false })
            m.assertEqual(request.homePreferences, { latestItemsExcludes: ["home"] })
            m.assertEqual(request.userId, "user")
        end function

