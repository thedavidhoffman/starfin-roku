        @it("applies deferred settings after restoring the retained video library")
        function _()
            retainedVideoLibraryPage = CreateObject("roSGNode", "VideoLibrary")
            retainedVideoLibraryPage.settings = SettingsStore.Defaults()
            activeCollectionPage = CreateObject("roSGNode", "VideoLibrary")
            m.node.dynamicPageHost.appendChild(retainedVideoLibraryPage)
            m.node.dynamicPageHost.appendChild(activeCollectionPage)
            m.node.videoLibraryNavigation.parentPage = retainedVideoLibraryPage
            m.node.videoLibraryNavigation.settingsDirty = true
            m.node.videoLibraryPage = activeCollectionPage
            m.node.settings[SettingsStore.Key.MovieLibraryLayout] = "thumbnail;4"

            'bs:disable-next-line 1140
            videoLibraryHandleCloseRequested()

            m.assertEqual(retainedVideoLibraryPage.settings[SettingsStore.Key.MovieLibraryLayout], "thumbnail;4")
            m.assertFalse(m.node.videoLibraryNavigation.settingsDirty)
        end function

        @describe("application startup")

        @it("completes a normal launch when Home reports ready")
        function _()
            'bs:disable-next-line 1140
            deepLinkHandleHomeReady()

            m.assertTrue(m.node.performanceBeaconState.launchComplete)
        end function

        @it("keeps a cold launch gated while its destination is pending")
        function _()
            m.node.deepLinkNavigation.launchAwaitingDestination = true

            'bs:disable-next-line 1140
            deepLinkHandleHomeReady()

            m.assertFalse(m.node.performanceBeaconState.launchComplete)
        end function

        @it("completes a cold playback launch only when playback reports ready")
        function _()
            m.node.deepLinkController.callFunc("submitInput", { contentId: "", mediaType: "movie" }, true)
            destinationId = m.node.deepLinkController.destinationRequested.destinationId
            m.node.deepLinkNavigation.destinationId = destinationId
            m.node.deepLinkNavigation.destinationType = DeepLink.DestinationType.Playback
            m.node.deepLinkNavigation.launchAwaitingDestination = true

            'bs:disable-next-line 1140
            deepLinkHandlePlaybackReady()

            m.assertEqual(m.node.deepLinkNavigation.destinationId, -1)
            m.assertTrue(m.node.performanceBeaconState.launchComplete)
        end function

        @it("shows a fallback message and completes its cold launch from Home readiness")
        function _()
            m.node.deepLinkController.callFunc("submitInput", { contentId: "", mediaType: "movie" }, true)
            destinationId = m.node.deepLinkController.destinationRequested.destinationId
            m.node.deepLinkNavigation.destinationId = destinationId
            m.node.deepLinkNavigation.destinationType = DeepLink.DestinationType.HomeFallback
            m.node.deepLinkNavigation.launchAwaitingDestination = true
            m.node.deepLinkNavigation.fallbackMessage = "Unable to open that item."

            'bs:disable-next-line 1140
            deepLinkHandleHomeReady()

            m.assertEqual(m.node.deepLinkNavigation.fallbackMessage, "")
            m.assertTrue(m.node.performanceBeaconState.launchComplete)
        end function

        @it("selects one nonblocking refresh for a clean Home fallback")
        function _()
            m.node.homeRefreshState.playbackRowsDirty = false
            homePage = m.node.homePage
            recorder = m.createHomePageCallRecorder()
            m.node.homePage = recorder

            'bs:disable-next-line 1140
            showHome(true)

            m.node.homePage = homePage
            m.assertEqual(recorder.calls, ["activate"])
        end function

        @it("selects one blocking refresh for a dirty Home fallback")
        function _()
            m.node.homeRefreshState.playbackRowsDirty = true
            homePage = m.node.homePage
            recorder = m.createHomePageCallRecorder()
            m.node.homePage = recorder

            'bs:disable-next-line 1140
            showHome(true)

            m.node.homePage = homePage
            m.assertEqual(recorder.calls, ["activateBlocking"])
        end function

        @it("tracks authentication dialog performance beacons through its MainScene handlers")
        function _()
            'bs:disable-next-line 1140
            beginPerformanceDialog()

            m.assertTrue(m.node.performanceBeaconState.dialogOpen)

            'bs:disable-next-line 1140
            completePerformanceDialog()

            m.assertFalse(m.node.performanceBeaconState.dialogOpen)
        end function

        @it("preserves a cold deep link when a saved login account is selected")
        function _()
            m.node.session = invalid
            m.node.authenticatedContent.visible = false
            m.node.deepLinkController.callFunc("submitInput", { contentId: "movie-1", mediaType: "movie" }, true)

            'bs:disable-next-line 1140
            authHandleAccountPickerClosed({
                request: { source: "login" }
                overlay: { selectedAccount: { accountKey: "account-2" } }
            })
            m.node.deepLinkController.callFunc("updateSession", {
                server: "http://server"
                token: "token"
                userId: "user"
                accountKey: "account-2"
            })

            resolverRequest = m.node.deepLinkController.findNode("resolverTask").request
            m.assertEqual(resolverRequest.contentId, "movie-1")
            m.assertEqual(m.node.authController.switchAccountRequest.accountKey, "account-2")
        end function

        @it("pairs the authentication dialog interval after a saved session expires")
        function _()
            m.node.authController.sessionExpired = {
                message: "Please sign in again."
                server: "http://server"
                username: "user"
                clearRuntimeSession: true
            }

            m.assertTrue(m.node.performanceBeaconState.dialogOpen)

            m.node.authController.authenticatedSession = {
                accountKey: "account-1"
                server: "http://server"
                token: "token"
                userId: "user"
            }

            m.assertFalse(m.node.performanceBeaconState.dialogOpen)
        end function

        @it("replaces active playback with a deep-linked season")
        function _()
            m.openPlayback("movie-1")
            destinationId = m.publishSeasonDestination()

            m.assertEqual(m.node.playbackController.getChildCount(), 0)
            m.assertNotInvalid(m.node.deepLinkNavigation.seasonPage)
            m.assertEqual(m.node.deepLinkNavigation.seasonDestinationId, destinationId)
        end function

        @it("ignores readiness from a superseded season page")
        function _()
            m.publishSeasonDestination()
            supersededPage = m.node.deepLinkNavigation.seasonPage
            currentDestinationId = m.publishSeasonDestination()

            supersededPage.ready = true

            m.assertEqual(m.node.deepLinkNavigation.destinationId, currentDestinationId)
            m.assertTrue(m.node.deepLinkNavigation.launchAwaitingDestination)
        end function

        @it("completes only readiness from the current season page")
        function _()
            m.publishSeasonDestination()

            m.node.deepLinkNavigation.seasonPage.ready = true

            m.assertEqual(m.node.deepLinkNavigation.destinationId, -1)
            m.assertTrue(m.node.performanceBeaconState.launchComplete)
        end function

        @it("routes a current season failure to Home fallback")
        function _()
            m.publishSeasonDestination()

            m.node.deepLinkNavigation.seasonPage.loadFailed = "Season unavailable."

            m.assertEqual(m.node.deepLinkController.destinationRequested.type, DeepLink.DestinationType.HomeFallback)
            m.assertEqual(m.node.deepLinkController.destinationRequested.message, "Season unavailable.")
        end function

        @it("routes a current season close before readiness to Home fallback")
        function _()
            m.publishSeasonDestination()

            m.node.deepLinkNavigation.seasonPage.closeRequested = true

            m.assertEqual(m.node.deepLinkController.destinationRequested.type, DeepLink.DestinationType.HomeFallback)
            m.assertEqual(m.node.deepLinkController.destinationRequested.message, "The launch request was cancelled.")

            m.node.homePage.ready = true

            m.assertEqual(m.node.deepLinkNavigation.destinationId, -1)
            m.assertTrue(m.node.performanceBeaconState.launchComplete)
        end function

        @it("ignores failure from a superseded season page")
        function _()
            m.publishSeasonDestination()
            supersededPage = m.node.deepLinkNavigation.seasonPage
            currentDestinationId = m.publishSeasonDestination()

            supersededPage.loadFailed = "Old failure."

            m.assertEqual(m.node.deepLinkNavigation.destinationId, currentDestinationId)
            m.assertEqual(m.node.deepLinkController.destinationRequested.destinationId, currentDestinationId)
        end function

        @it("routes a player close before deep-link readiness to Home fallback")
        function _()
            m.publishPlaybackDestination()

            m.node.playbackController.closed = {
                restorePlayRequest: invalid
                upNextRequest: invalid
            }

            m.assertEqual(m.node.deepLinkController.destinationRequested.type, DeepLink.DestinationType.HomeFallback)
            m.assertEqual(m.node.deepLinkController.destinationRequested.message, "The launch request was cancelled.")

            m.node.homePage.ready = true

            m.assertEqual(m.node.deepLinkNavigation.destinationId, -1)
            m.assertTrue(m.node.performanceBeaconState.launchComplete)
        end function

        @it("routes Quick Connect requests from Login to AuthController")
        function _()
            request = { server: "https://server" }
            m.node.authController = m.createQuickConnectAuthControllerMock()

            m.node.login.quickConnectRequested = request

            m.assertEqual(m.node.authController.quickConnectRequest, request)
        end function

        @it("forwards Quick Connect presentation state to Login")
        function _()
            state = { phase: "waiting", code: "ABC123", message: "Approve this code." }
            m.node.authController = m.createQuickConnectAuthControllerMock()

            m.node.authController.quickConnectState = state
            'bs:disable-next-line 1140
            authHandleQuickConnectState()

            m.assertEqual(m.node.login.quickConnectState, state)
        end function

        @it("routes Quick Connect cancellation to AuthController")
        function _()
            m.node.authController = m.createQuickConnectAuthControllerMock()

            m.node.login.quickConnectCancelled = true

            m.assertTrue(m.node.authController.quickConnectCancelRequested)
        end function

        function createQuickConnectAuthControllerMock() as object
            controller = CreateObject("roSGNode", "Group")
            controller.addField("quickConnectRequest", "assocarray", false)
            controller.addField("quickConnectCancelRequested", "boolean", false)
            controller.addField("quickConnectState", "assocarray", false)
            return controller
        end function

        @it("copies the saved session into Login")
        function _()
            m.node.appLifecycle.started = false
            savedSession = {
                server: "http://server"
                token: "token"
                userId: "user"
            }
            m.node.authController = m.createAuthControllerMock(savedSession)

            'bs:disable-next-line 1140
            startApp()

            m.assertEqual(m.node.login.savedSession, savedSession)
        end function

        @it("requests session resume")
        function _()
            m.node.appLifecycle.started = false
            m.node.authController = m.createAuthControllerMock(invalid)

            'bs:disable-next-line 1140
            startApp()

            m.assertTrue(m.node.authController.resumeRequested)
        end function

        @it("does not start the application more than once")
        function _()
            m.node.appLifecycle.started = false
            m.node.authController = m.createAuthControllerMock(invalid)
            'bs:disable-next-line 1140
            startApp()
            m.node.authController.resumeRequested = false

            'bs:disable-next-line 1140
            startApp()

            m.assertFalse(m.node.authController.resumeRequested)
        end function

        function createAuthControllerMock(savedSession as dynamic) as object
            controller = CreateObject("roSGNode", "Group")
            controller.addField("savedSession", "assocarray", false)
            controller.addField("resumeRequested", "boolean", false)
            controller.savedSession = savedSession
            return controller
        end function

        function openPlayback(itemId as string)
            m.node.playbackController.playRequest = {
                server: m.node.session.server
                token: m.node.session.token
                userId: m.node.session.userId
                itemId: itemId
                item: { Id: itemId, Type: "Movie", Name: "Movie" }
            }
        end function

        function createHomePageCallRecorder() as object
            return {
                visible: false
                calls: []
                callFunc: function(name as string) as dynamic
                    m.calls.Push(name)
                    return invalid
                end function
            }
        end function

        function publishSeasonDestination() as integer
            m.node.deepLinkNavigation.launchAwaitingDestination = true
            m.node.deepLinkController.callFunc("submitInput", { contentId: "", mediaType: "movie" }, true)
            destinationId = m.node.deepLinkController.destinationRequested.destinationId
            m.node.deepLinkController.destinationRequested = {
                destinationId: destinationId
                isColdLaunch: true
                type: DeepLink.DestinationType.Season
                series: { Id: "series-1" }
                season: { Id: "season-1" }
                initialFocusEpisodeId: "episode-1"
            }
            return destinationId
        end function

        function publishPlaybackDestination() as integer
            m.node.deepLinkNavigation.launchAwaitingDestination = true
            m.node.deepLinkController.callFunc("submitInput", { contentId: "", mediaType: "movie" }, true)
            destinationId = m.node.deepLinkController.destinationRequested.destinationId
            m.node.deepLinkNavigation.destinationId = destinationId
            m.node.deepLinkNavigation.destinationType = DeepLink.DestinationType.Playback
            return destinationId
        end function

    end class

end namespace
