        @describe("video library routing")

        @it("uses music video items for music video libraries")
        function _()
            'bs:disable-next-line 1140
            includeItemTypes = getVideoLibraryIncludeItemTypes("musicvideos")

            m.assertEqual(includeItemTypes, "MusicVideo")
        end function

        @it("launches selected music videos from the video library")
        function _()
            m.node.session = {
                server: "http://server"
                token: "token"
                userId: "user"
            }
            m.node.settings = {}
            page = CreateObject("roSGNode", "VideoLibrary")
            page.visible = true
            page.selectedVideo = {
                itemId: "music-video-1"
                item: { Id: "music-video-1", Type: "MusicVideo", Name: "Music Video" }
            }
            m.node.videoLibraryPage = page
            m.node.dynamicPageHost.appendChild(page)

            'bs:disable-next-line 1140
            videoLibraryHandleVideoSelected()

            m.assertFalse(page.visible)
            m.assertTrue(m.node.playbackController.callFunc("hasPlayer"))
            m.assertEqual(m.node.playbackController.playRequest.itemId, "music-video-1")
            m.assertEqual(m.node.dynamicPageHost.getChildCount(), 1)
        end function

        @it("opens grouped collections in collection-content mode")
        function _()
            parentPage = CreateObject("roSGNode", "VideoLibrary")
            parentPage.visible = true
            parentPage.selectedCollection = {
                itemId: "collection-1"
                item: { Id: "collection-1", Type: "BoxSet", Name: "Grouped Collection" }
                libraryIndex: 4
            }
            m.node.videoLibraryPage = parentPage
            m.node.dynamicPageHost.appendChild(parentPage)

            'bs:disable-next-line 1140
            videoLibraryHandleCollectionSelected()

            m.assertEqual(m.node.videoLibraryPage.loadRequest.libraryId, "collection-1")
            m.assertEqual(m.node.videoLibraryPage.loadRequest.collectionType, "collection")
            m.assertEqual(m.node.videoLibraryPage.loadRequest.includeItemTypes, "Movie,Series")
            m.assertEqual(m.node.videoLibraryPage.loadRequest.title, "Grouped Collection")
        end function

        @it("retains and hides the originating video library")
        function _()
            parentPage = CreateObject("roSGNode", "VideoLibrary")
            parentPage.visible = true
            parentPage.selectedCollection = {
                itemId: "collection-1"
                item: { Id: "collection-1", Type: "BoxSet", Name: "Grouped Collection" }
            }
            m.node.videoLibraryPage = parentPage
            m.node.dynamicPageHost.appendChild(parentPage)

            'bs:disable-next-line 1140
            videoLibraryHandleCollectionSelected()

            m.assertEqual(m.node.videoLibraryNavigation.parentPage, parentPage)
            m.assertFalse(parentPage.visible)
            m.assertEqual(m.node.dynamicPageHost.getChildCount(), 2)
        end function

        @it("restores the originating video library when collection contents close")
        function _()
            parentPage = CreateObject("roSGNode", "VideoLibrary")
            parentPage.visible = true
            parentItems = CreateObject("roSGNode", "ContentNode")
            for i = 0 to 4
                parentItems.createChild("ContentNode")
            end for
            parentGrid = parentPage.findNode("itemsGrid")
            parentGrid.content = parentItems
            parentGrid.jumpToItem = 4
            parentGrid.setFocus(true)
            parentPage.selectedCollection = {
                itemId: "collection-1"
                item: { Id: "collection-1", Type: "BoxSet", Name: "Grouped Collection" }
            }
            m.node.videoLibraryPage = parentPage
            m.node.dynamicPageHost.appendChild(parentPage)
            'bs:disable-next-line 1140
            videoLibraryHandleCollectionSelected()

            'bs:disable-next-line 1140
            videoLibraryHandleCloseRequested()

            m.assertEqual(m.node.videoLibraryPage, parentPage)
            m.assertInvalid(m.node.videoLibraryNavigation.parentPage)
            m.assertTrue(parentPage.visible)
            m.assertEqual(m.node.dynamicPageHost.getChildCount(), 1)
            m.assertEqual(parentGrid.itemFocused, 4)
            m.assertTrue(parentGrid.isInFocusChain())
        end function

        @it("clears a retained video library during dynamic reset")
        function _()
            parentPage = CreateObject("roSGNode", "VideoLibrary")
            childPage = CreateObject("roSGNode", "VideoLibrary")
            m.node.videoLibraryNavigation.parentPage = parentPage
            m.node.videoLibraryPage = childPage
            m.node.dynamicPageHost.appendChild(parentPage)
            m.node.dynamicPageHost.appendChild(childPage)

            'bs:disable-next-line 1140
            resetDynamicPages()

            m.assertInvalid(m.node.videoLibraryNavigation.parentPage)
            m.assertInvalid(m.node.videoLibraryPage)
            m.assertEqual(m.node.dynamicPageHost.getChildCount(), 0)
        end function

        @describe("music library routing")

        @it("focuses the filter row immediately after selecting decade browse")
        function _()
            page = CreateObject("roSGNode", "MusicLibraryPageTestDouble")
            page.deferFocus = false
            m.node.musicLibraryPage = page

            'bs:disable-next-line 1140
            musicLibraryHandleSortOverlayClosed({ overlay: { sortSelected: { optionKey: "Decade" } } })

            m.assertEqual(page.appliedSelection.optionKey, "Decade")
            m.assertTrue(page.filterFocusRequested)
            m.assertFalse(page.browseFocusRequested)
        end function

        @it("defers browse button focus while a foreground music reload starts")
        function _()
            page = CreateObject("roSGNode", "MusicLibraryPageTestDouble")
            page.deferFocus = true
            m.node.musicLibraryPage = page

            'bs:disable-next-line 1140
            musicLibraryHandleSortOverlayClosed({ overlay: { sortSelected: { optionKey: "Favorites" } } })

            m.assertEqual(page.appliedSelection.optionKey, "Favorites")
            m.assertFalse(page.filterFocusRequested)
            m.assertFalse(page.browseFocusRequested)
        end function

        @describe("playback controller integration")

        @it("observes authentication failures from tasks in an opened player")
        function _()
            m.openPlayback("movie-1")
            task = m.node.playbackController.findNode("playbackInfoTask")
            task.request = { token: "token" }

            task.response = {
                authExpired: true
                errorMessage: "Session expired"
            }

            request = m.node.authController.expireActiveSessionRequested
            m.assertNotInvalid(request)
            m.assertEqual(request.accountKey, "account-1")
            m.assertEqual(request.message, "Session expired")
        end function

        @it("opens Person from playback and records playback as its source")
        function _()
            m.openPlayback("movie-1")

            m.node.playbackController.selectedPerson = {
                itemId: "person-1"
                item: { Id: "person-1", Name: "Person" }
            }

            m.assertNotInvalid(m.node.personPage)
            m.assertTrue(m.node.personPage.visible)
            m.assertTrue(m.node.personSource.playback)
            m.assertFalse(m.node.playbackController.callFunc("isPlayerVisible"))
        end function

        @it("restores playback and clears its source when Person closes")
        function _()
            m.openPlayback("movie-1")
            m.node.playbackController.selectedPerson = {
                itemId: "person-1"
                item: { Id: "person-1", Name: "Person" }
            }

            m.node.personPage.closeRequested = true

            m.assertInvalid(m.node.personPage)
            m.assertTrue(m.node.playbackController.callFunc("isPlayerVisible"))
            m.assertFalse(m.node.personSource.playback)
            m.assertInvalid(m.node.personSource.moviePage)
            m.assertInvalid(m.node.personSource.tvShowPage)
            m.assertInvalid(m.node.personSource.tvSeasonPage)
            m.assertInvalid(m.node.personSource.tvEpisodePage)
        end function

        @it("restores the underlying surface from a player close payload")
        function _()
            m.node.homePage.visible = false

            m.node.playbackController.closed = {
                restorePlayRequest: { itemId: "movie-1" }
                upNextRequest: invalid
            }

            m.assertTrue(m.node.homePage.visible)
            m.assertTrue(m.node.header.visible)
            m.assertInvalid(m.node.pendingUpNextAutoPlayRequest)
        end function

        @it("opens up-next autoplay from a player close payload")
        function _()
            request = {
                currentItem: { itemId: "episode-1", title: "Finished" }
                nextItem: { itemId: "episode-2", title: "Next" }
                series: { title: "Series" }
            }

            m.node.playbackController.closed = {
                restorePlayRequest: { itemId: "episode-1" }
                upNextRequest: request
            }

            m.assertNotInvalid(m.node.tvEpisodeUpNextAutoPlayPage)
            m.assertEqual(m.node.tvEpisodeUpNextAutoPlayPage.autoPlayRequest, request)
            m.assertFalse(m.node.homePage.visible)
            m.assertFalse(m.node.header.visible)
            m.assertInvalid(m.node.pendingUpNextAutoPlayRequest)
        end function

        @it("restores playlist focus when up-next autoplay is cancelled")
        function _()
            playlistPage = CreateObject("roSGNode", "Playlists")
            playlistPage.settings = m.node.settings
            playlistContent = CreateObject("roSGNode", "ContentNode")
            for i = 0 to 2
                playlistContent.createChild("ContentNode").title = "Playlist item " + i.ToStr()
            end for
            playlistPage.findNode("itemsGrid").content = playlistContent
            playlistPage.visible = false
            m.node.dynamicPageHost.appendChild(playlistPage)
            m.node.videoLibraryPage = playlistPage

            restoreRequest = {
                playbackQueue: [{ hasPlaybackContext: true, playlistItemIndex: 2 }]
                playbackQueueIndex: 0
                playbackQueueScope: "playlist"
            }
            m.node.pendingUpNextAutoPlayRequest = {
                nextItem: { itemId: "next-item" }
            }

            'bs:disable-next-line 1140
            opened = showTVEpisodeUpNextAutoPlayPage(restoreRequest)
            m.assertTrue(opened)

            'bs:disable-next-line 1140
            tvEpisodeUpNextHandleCancelSelected()

            m.assertInvalid(m.node.tvEpisodeUpNextAutoPlayPage)
            m.assertInvalid(m.node.tvEpisodeUpNextRestorePlayRequest)
            m.assertTrue(playlistPage.visible)
            m.assertTrue(m.node.header.visible)
            m.assertEqual(playlistPage.findNode("itemsGrid").itemFocused, 2)
            m.assertTrue(playlistPage.findNode("itemsGrid").isInFocusChain())
        end function

        @it("removes playback and clears navigation state during a dynamic reset")
        function _()
            m.openPlayback("movie-1")
            page = CreateObject("roSGNode", "Group")
            m.node.dynamicPageHost.appendChild(page)
            m.node.personSource.playback = true
            m.node.personSource.moviePage = page

            'bs:disable-next-line 1140
            resetDynamicPages()

            m.assertFalse(m.node.playbackController.callFunc("hasPlayer"))
            m.assertEqual(m.node.dynamicPageHost.getChildCount(), 0)
            m.assertFalse(m.node.personSource.playback)
            m.assertInvalid(m.node.personSource.moviePage)
        end function

        @describe("construction")

        @it("does not start the application during construction")
        function _()
            m.assertFalse(m.node.appLifecycle.started)
            m.assertFalse(m.node.authController.resumeRequested)
        end function

        @describe("settings propagation")

        @it("fans saved artwork settings out to active library pages")
        function _()
            collectionsPage = CreateObject("roSGNode", "Group")
            collectionsPage.addField("settings", "assocarray", false)
            videoLibraryPage = CreateObject("roSGNode", "Group")
            videoLibraryPage.addField("settings", "assocarray", false)
            homeMediaLibraryPage = CreateObject("roSGNode", "Group")
            homeMediaLibraryPage.addField("settings", "assocarray", false)
            m.node.collectionsPage = collectionsPage
            m.node.videoLibraryPage = videoLibraryPage
            m.node.homeMediaLibraryPage = homeMediaLibraryPage
            savedSettings = SettingsStore.Defaults()
            savedSettings[SettingsStore.Key.CollectionCardsLayout] = "detailed;2"
            savedSettings[SettingsStore.Key.MusicVideosLayout] = "thumbnail;4"
            savedSettings[SettingsStore.Key.HomeVideosLayout] = "poster;5"

            'bs:disable-next-line 1140
            applySettingsFromOverlay({ settingsSaved: true, savedSettings: savedSettings })

            m.assertEqual(collectionsPage.settings[SettingsStore.Key.CollectionCardsLayout], "detailed;2")
            m.assertEqual(videoLibraryPage.settings[SettingsStore.Key.MusicVideosLayout], "thumbnail;4")
            m.assertEqual(homeMediaLibraryPage.settings[SettingsStore.Key.HomeVideosLayout], "poster;5")
        end function

        @it("defers saved settings for a retained video library")
        function _()
            retainedVideoLibraryPage = CreateObject("roSGNode", "Group")
            retainedVideoLibraryPage.addField("settings", "assocarray", false)
            m.node.videoLibraryNavigation.parentPage = retainedVideoLibraryPage
            savedSettings = SettingsStore.Defaults()
            savedSettings[SettingsStore.Key.MovieLibraryLayout] = "thumbnail;4"

            'bs:disable-next-line 1140
            applySettingsFromOverlay({ settingsSaved: true, savedSettings: savedSettings })

            m.assertInvalid(retainedVideoLibraryPage.settings)
            m.assertTrue(m.node.videoLibraryNavigation.settingsDirty)
        end function

        @it("applies deferred settings after restoring the retained video library")
        function _()
            retainedVideoLibraryPage = CreateObject("roSGNode", "VideoLibrary")
            retainedVideoLibraryPage.settings = SettingsStore.Defaults()
            activeCollectionPage = CreateObject("roSGNode", "VideoLibrary")
            m.node.dynamicPageHost.appendChild(retainedVideoLibraryPage)
            m.node.dynamicPageHost.appendChild(activeCollectionPage)
            m.node.videoLibraryNavigation.parentPage = retainedVideoLibraryPage
            m.node.videoLibraryNavigation.settingsDirty = true
            m.node.videoLibraryPage = activeCollectionPage
            m.node.settings[SettingsStore.Key.MovieLibraryLayout] = "thumbnail;4"

            'bs:disable-next-line 1140
            videoLibraryHandleCloseRequested()

            m.assertEqual(retainedVideoLibraryPage.settings[SettingsStore.Key.MovieLibraryLayout], "thumbnail;4")
            m.assertFalse(m.node.videoLibraryNavigation.settingsDirty)
        end function

        @describe("application startup")

        @it("routes Quick Connect requests from Login to AuthController")
        function _()
            request = { server: "https://server" }
            m.node.authController = m.createQuickConnectAuthControllerMock()

            m.node.login.quickConnectRequested = request

            m.assertEqual(m.node.authController.quickConnectRequest, request)
        end function

        @it("forwards Quick Connect presentation state to Login")
        function _()
            state = { phase: "waiting", code: "ABC123", message: "Approve this code." }
            m.node.authController = m.createQuickConnectAuthControllerMock()

            m.node.authController.quickConnectState = state
            'bs:disable-next-line 1140
            authHandleQuickConnectState()

            m.assertEqual(m.node.login.quickConnectState, state)
        end function

        @it("routes Quick Connect cancellation to AuthController")
        function _()
            m.node.authController = m.createQuickConnectAuthControllerMock()

            m.node.login.quickConnectCancelled = true

            m.assertTrue(m.node.authController.quickConnectCancelRequested)
        end function

        function createQuickConnectAuthControllerMock() as object
            controller = CreateObject("roSGNode", "Group")
            controller.addField("quickConnectRequest", "assocarray", false)
            controller.addField("quickConnectCancelRequested", "boolean", false)
            controller.addField("quickConnectState", "assocarray", false)
            return controller
        end function

        @it("copies the saved session into Login")
        function _()
            m.node.appLifecycle.started = false
            savedSession = {
                server: "http://server"
                token: "token"
                userId: "user"
            }
            m.node.authController = m.createAuthControllerMock(savedSession)

            'bs:disable-next-line 1140
            startApp()

            m.assertEqual(m.node.login.savedSession, savedSession)
        end function

        @it("requests session resume")
        function _()
            m.node.appLifecycle.started = false
            m.node.authController = m.createAuthControllerMock(invalid)

            'bs:disable-next-line 1140
            startApp()

            m.assertTrue(m.node.authController.resumeRequested)
        end function

        @it("does not start the application more than once")
        function _()
            m.node.appLifecycle.started = false
            m.node.authController = m.createAuthControllerMock(invalid)
            'bs:disable-next-line 1140
            startApp()
            m.node.authController.resumeRequested = false

            'bs:disable-next-line 1140
            startApp()

            m.assertFalse(m.node.authController.resumeRequested)
        end function

        function createAuthControllerMock(savedSession as dynamic) as object
            controller = CreateObject("roSGNode", "Group")
            controller.addField("savedSession", "assocarray", false)
            controller.addField("resumeRequested", "boolean", false)
            controller.savedSession = savedSession
            return controller
        end function

        function openPlayback(itemId as string)
            m.node.playbackController.playRequest = {
                server: m.node.session.server
                token: m.node.session.token
                userId: m.node.session.userId
                itemId: itemId
                item: { Id: itemId, Type: "Movie", Name: "Movie" }
            }
        end function

    end class

end namespace
