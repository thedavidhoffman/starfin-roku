        end function

        @it("declares the homePage node")
        function _()
            m.assertNotInvalid(m.top.findNode("homePage"))
        end function

        @it("declares the dynamicPageHost node")
        function _()
            m.assertNotInvalid(m.top.findNode("dynamicPageHost"))
        end function

        @it("declares the themeAudioController node")
        function _()
            m.assertNotInvalid(m.top.findNode("themeAudioController"))
        end function

        @it("declares the statusLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("statusLabel"))
        end function

        @it("declares the header node")
        function _()
            m.assertNotInvalid(m.top.findNode("header"))
        end function

        @it("declares the overlayHost node")
        function _()
            m.assertNotInvalid(m.top.findNode("overlayHost"))
        end function

        @it("declares the loadingSpinner node")
        function _()
            m.assertNotInvalid(m.top.findNode("loadingSpinner"))
        end function

        @it("declares the authController node")
        function _()
            m.assertNotInvalid(m.top.findNode("authController"))
        end function

