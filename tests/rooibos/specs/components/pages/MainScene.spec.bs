        function openSettingsForMessageOverlap()
            m.top.visible = true
            m.node.overlayHost.callFunc("openOverlay", { id: "settings", componentName: "SettingsDialog", openFunction: "openSettings", accountKey: "" })
        end function

        function startMessageOverlapBlocker()
            m.node.loadingSpinner.blockInteraction = true
            m.node.loadingSpinner.showDelay = 2
            m.node.loadingSpinner.control = "start"
            m.node.loadingSpinner.setFocus(true)
        end function

        function openOverlapMessage()
            'bs:disable-next-line 1140
            showMessage("Unrelated background failure")
            'bs:disable-next-line 1140
            onMessageOpenTimer()
        end function

        function cleanupMessageOverlap()
            m.node.loadingSpinner.blockInteraction = false
            m.node.loadingSpinner.control = "stop"
            'bs:disable-next-line 1140
            clearSettingsConfirmation()
            m.node.overlayHost.callFunc("closeOverlay")
        end function

        @it("defers opening and combines distinct messages without replacing an existing overlay")
        function _()
            m.node.overlayHost.callFunc("openOverlay", { id: "settings", componentName: "SettingsDialog", openFunction: "openSettings", accountKey: "" })
            existing = m.node.overlayHost.getChild(0)
            'bs:disable-next-line 1140
            showMessage("First failure")
            'bs:disable-next-line 1140
            showMessage("First failure")
            'bs:disable-next-line 1140
            showMessage("Second failure")

            m.assertEqual(m.node.messageOverlayHost.getChildCount(), 0)
            'bs:disable-next-line 1140
            onMessageOpenTimer()

            m.assertEqual(m.node.messageOverlayHost.getChildCount(), 1)
            m.assertEqual(m.node.messageState.overlay.message, "First failure" + Chr(10) + Chr(10) + "Second failure")
            m.assertTrue(m.node.overlayHost.getChild(0).isSameNode(existing))
            'bs:disable-next-line 1140
            dismissMessage()
        end function

        @it("appends to the open message without replacing its dialog")
        function _()
            'bs:disable-next-line 1140
            showMessage("First failure")
            'bs:disable-next-line 1140
            onMessageOpenTimer()
            original = m.node.messageState.overlay
            'bs:disable-next-line 1140
            showMessage("Second failure")

            m.assertTrue(m.node.messageState.overlay.isSameNode(original))
            m.assertEqual(original.message, "First failure" + Chr(10) + Chr(10) + "Second failure")
            'bs:disable-next-line 1140
            dismissMessage()
        end function

