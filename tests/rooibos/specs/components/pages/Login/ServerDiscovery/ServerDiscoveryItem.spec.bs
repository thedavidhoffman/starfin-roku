
namespace tests

    @SGNode("ServerDiscoveryItem")
    @suite("ServerDiscoveryItem component")
    class ServerDiscoveryItemTests extends rooibos.BaseTestSuite

        @describe("fresh component observers")

        @it("renders content on a fresh component")
        function _()
            component = CreateObject("roSGNode", "ServerDiscoveryItem")
            item = CreateObject("roSGNode", "ContentNode")
            item.title = "Fresh server"
            item.description = "http://server:8096"
            item.addFields({ listFocused: true })

            component.itemContent = item

            m.assertEqual(component.findNode("name").text, "Fresh server")
            m.assertEqual(component.findNode("address").text, "http://server:8096")
        end function

        @it("observes focus changes on a fresh component")
        function _()
            component = CreateObject("roSGNode", "ServerDiscoveryItem")
            component.focusPercent = 1

            m.assertEqual(component.findNode("name").color, &h0F1A2AFF)
            m.assertEqual(component.findNode("address").color, &h0F1A2AFF)
        end function

        @it("observes list focus changes on a fresh component")
        function _()
            component = CreateObject("roSGNode", "ServerDiscoveryItem")
            item = CreateObject("roSGNode", "ContentNode")
            item.addFields({ listFocused: true })
            component.itemContent = item
            component.focusPercent = 1

            item.listFocused = false

            m.assertEqual(component.findNode("name").color, &hF3F7FBFF)
            m.assertEqual(component.findNode("address").color, &hC8D2DEFF)
        end function

        @describe("observable behavior")

        @it("renders the advertised name and address")
        function _()
            item = CreateObject("roSGNode", "ContentNode")
            item.title = "NAS"
            item.description = "https://nas:8097/jellyfin"
            m.top.itemContent = item

            m.assertEqual(m.top.findNode("name").text, "NAS")
            m.assertEqual(m.top.findNode("address").text, "https://nas:8097/jellyfin")
        end function

        @it("uses dark text on the focused row")
        function _()
            m.top.focusPercent = 1

            m.assertEqual(m.top.findNode("name").color, &h0F1A2AFF)
            m.assertEqual(m.top.findNode("address").color, &h0F1A2AFF)
        end function

        @it("restores light text after losing focus")
        function _()
            m.top.focusPercent = 1
            m.top.focusPercent = 0

            m.assertEqual(m.top.findNode("name").color, &hF3F7FBFF)
            m.assertEqual(m.top.findNode("address").color, &hC8D2DEFF)
        end function

        @it("clears focused text styling when the list loses focus")
        function _()
            item = CreateObject("roSGNode", "ContentNode")
            item.addFields({ listFocused: true })
            m.top.itemContent = item
            m.top.focusPercent = 1
            item.listFocused = false

            m.assertEqual(m.top.findNode("name").color, &hF3F7FBFF)
            m.assertEqual(m.top.findNode("address").color, &hC8D2DEFF)
        end function

        @it("renders manual entry as a centered single line with a separator")
        function _()
            item = CreateObject("roSGNode", "ContentNode")
            item.title = "Enter server address manually"
            item.addFields({ manualEntry: true, showSeparator: true })
            m.top.itemContent = item

            m.assertEqual(m.top.findNode("name").text, "Enter server address manually")
            m.assertEqual(m.top.findNode("name").translation, [20.0, 28.0])
            m.assertFalse(m.top.findNode("address").visible)
            m.assertTrue(m.top.findNode("separator").visible)
        end function

    end class

end namespace
