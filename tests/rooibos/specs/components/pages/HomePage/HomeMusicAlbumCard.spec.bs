namespace tests

    @SGNode("HomeMusicAlbumCard")
    @suite("HomeMusicAlbumCard component")
    class HomeMusicAlbumCardTests extends rooibos.BaseTestSuite

        @describe("fresh component observers")

        @it("renders content on a fresh component")
        function _()
            component = CreateObject("roSGNode", "HomeMusicAlbumCard")
            item = CreateObject("roSGNode", "ContentNode")
            item.addFields({ primaryLabel: "Fresh artist", secondaryLabel: "Fresh album" })
            item.HDPosterUrl = "http://server/album.jpg"

            component.itemContent = item

            m.assertEqual(component.findNode("artistLabel").text, "Fresh artist")
            m.assertEqual(component.findNode("albumLabel").text, "Fresh album")
            m.assertEqual(component.findNode("albumArtwork").uri, "http://server/album.jpg")
        end function

        @it("observes replacement content on a fresh component")
        function _()
            component = CreateObject("roSGNode", "HomeMusicAlbumCard")
            first = CreateObject("roSGNode", "ContentNode")
            first.addFields({ primaryLabel: "First artist", secondaryLabel: "First album" })
            component.itemContent = first
            replacement = CreateObject("roSGNode", "ContentNode")
            replacement.addFields({ primaryLabel: "Second artist", secondaryLabel: "Second album" })

            component.itemContent = replacement

            m.assertEqual(component.findNode("artistLabel").text, "Second artist")
            m.assertEqual(component.findNode("albumLabel").text, "Second album")
        end function

        @describe("declarative component contract")

        @it("declares the contentGroup node")
        function _()
            m.assertNotInvalid(m.top.findNode("contentGroup"))
        end function

        @it("declares the artistLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("artistLabel"))
        end function

        @it("declares the albumMask node")
        function _()
            m.assertNotInvalid(m.top.findNode("albumMask"))
        end function

        @it("declares the albumArtwork node")
        function _()
            m.assertNotInvalid(m.top.findNode("albumArtwork"))
        end function

        @it("declares the albumLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("albumLabel"))
        end function

        @it("declares the yearLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("yearLabel"))
        end function

    end class

end namespace
