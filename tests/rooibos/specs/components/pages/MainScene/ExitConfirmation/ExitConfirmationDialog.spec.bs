namespace tests

    @SGNode("ExitConfirmationDialog")
    @suite("ExitConfirmationDialog component")
    class ExitConfirmationDialogTests extends rooibos.BaseTestSuite

        @describe("confirmation behavior")

        @it("opens with Exit focused")
        function _()
            m.top.callFunc("openConfirmation")

            m.assertTrue(m.top.callFunc("getContentComponent").findNode("exit").hasFocus())
            m.assertFalse(m.top.exitConfirmed)
        end function

        @it("closes with the confirmed decision")
        function _()
            m.top.callFunc("openConfirmation")

            m.top.callFunc("getContentComponent").decision = true

            m.assertTrue(m.top.exitConfirmed)
            m.assertTrue(m.top.closeRequested)
        end function

        @it("closes on cancel without confirming exit")
        function _()
            m.top.callFunc("openConfirmation")

            m.top.callFunc("getContentComponent").decision = false

            m.assertFalse(m.top.exitConfirmed)
            m.assertTrue(m.top.closeRequested)
        end function

        @it("Back dismisses without confirming exit")
        function _()
            m.top.callFunc("openConfirmation")

            'bs:disable-next-line 1140
            onKeyEvent("back", true)

            m.assertFalse(m.top.exitConfirmed)
            m.assertTrue(m.top.closeRequested)
        end function

        @it("restores default focus to Exit")
        function _()
            m.top.callFunc("openConfirmation")
            content = m.top.callFunc("getContentComponent")
            content.callFunc("focusCancel")

            m.top.callFunc("focusContent")

            m.assertTrue(content.findNode("exit").hasFocus())
            m.assertTrue(content.findNode("exit").hasFocusVisual)
            m.assertFalse(content.findNode("cancel").hasFocusVisual)
        end function

    end class

end namespace
