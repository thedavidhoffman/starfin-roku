namespace tests

    @SGNode("ExitConfirmationContent")
    @suite("ExitConfirmationContent component")
    class ExitConfirmationContentTests extends rooibos.BaseTestSuite

        @describe("confirmation behavior")

        @it("moves right to Exit")
        function _()
            m.top.callFunc("focusCancel")

            'bs:disable-next-line 1140
            onKeyEvent("right", true)

            m.assertTrue(m.top.findNode("exit").hasFocus())
        end function

        @it("moves left to Cancel")
        function _()
            m.top.findNode("exit").setFocus(true)

            'bs:disable-next-line 1140
            onKeyEvent("left", true)

            m.assertTrue(m.top.findNode("cancel").hasFocus())
        end function

        @it("Back cancels the request")
        function _()
            m.top.decision = true

            'bs:disable-next-line 1140
            onKeyEvent("back", true)

            m.assertFalse(m.top.decision)
        end function

        @it("Exit emits confirmation")
        function _()
            m.top.decision = false

            m.top.findNode("exit").buttonSelected = true

            m.assertTrue(m.top.decision)
        end function

        @it("Cancel emits a negative decision")
        function _()
            m.top.decision = true

            m.top.findNode("cancel").buttonSelected = true

            m.assertFalse(m.top.decision)
        end function

        @it("ignores Back key release")
        function _()
            m.top.decision = true

            'bs:disable-next-line 1140
            m.assertFalse(onKeyEvent("back", false))

            m.assertTrue(m.top.decision)
        end function

    end class

end namespace
