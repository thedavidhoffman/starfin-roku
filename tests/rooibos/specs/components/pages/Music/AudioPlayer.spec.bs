import "pkg:/source/tests/source/MediaAuthentication.bs"
import "pkg:/source/Char.bs"

namespace tests

    @SGNode("AudioPlayer")
    @suite("AudioPlayer screensaver lifecycle")
    class AudioPlayerScreensaverTests extends rooibos.BaseTestSuite

        protected override function beforeEach()
            m.node.top = m.top
        end function

        protected override function afterEach()
            m.node.top = m.top
        end function

        @describe("standalone audio selection")

        @it("resumes a standalone Continue Listening item without requesting album tracks")
        function _()
            m.configureSelection()
            m.top.loadRequest = { server: "https://server", token: "fresh", userId: "user", albumId: "track", item: { Id: "track", Name: "Track", Type: "Audio", UserData: { PlaybackPositionTicks: 120000000 } }, settings: SettingsStore.Defaults() }

            m.assertEqual(m.node.playerState.tracks.Count(), 1)
            m.assertEqual(m.node.playerState.tracks[0].Id, "track")
            m.assertEqual(m.node.playerState.currentIndex, 0)
            m.assertEqual(m.node.playerState.restartPosition, 12.0)
            m.assertInvalid(m.node.playerState.tracksLoad.lifecycle.active)
        end function

        @it("resumes a standalone audiobook without requesting album tracks")
        function _()
            m.configureSelection()
            m.top.loadRequest = { server: "https://server", token: "fresh", userId: "user", albumId: "track", item: { Id: "track", Name: "Track", Type: "AudioBook", UserData: { PlaybackPositionTicks: 120000000 } }, settings: SettingsStore.Defaults() }

            m.assertEqual(m.node.playerState.tracks.Count(), 1)
            m.assertEqual(m.node.playerState.tracks[0].Id, "track")
            m.assertEqual(m.node.playerState.currentIndex, 0)
            m.assertEqual(m.node.playerState.restartPosition, 12.0)
            m.assertInvalid(m.node.playerState.tracksLoad.lifecycle.active)
        end function

        @it("starts an audio item without saved progress at zero")
        function _()
            m.configureSelection()
            m.top.loadRequest = { server: "https://server", token: "fresh", userId: "user", albumId: "new-track", item: { Id: "new-track", Name: "Track", Type: "Audio" }, settings: SettingsStore.Defaults() }

            m.assertEqual(m.node.playerState.restartPosition, 0.0)
            m.assertEqual(m.node.playerState.tracks[0].Id, "new-track")
        end function

        @describe("background composition")

        @it("shows the scene background beneath album art and dimming")
        function _()
            backdrop = m.top.getChild(0)
            dimming = m.top.getChild(1)

            m.assertEqual(backdrop.id, "backdrop")
            m.assertEqual(backdrop.opacity, 0.18)
            m.assertTrue(dimming.isSubtype("Rectangle"))
            m.assertEqual(dimming.color, &h00000066)
        end function

        @describe("playback state changes")

        @it("suppresses the native Roku screensaver while playing")
        function _()
            m.configurePlayer("playing", "bounce")

            'bs:disable-next-line 1140
            onPlayerStateChanged()

            m.assertTrue(m.node.player.disableScreenSaver)
            m.assertFalse(m.node.playerState.changingTrack)
        end function

        @it("suppresses the native Roku screensaver without starting a Starfin overlay")
        function _()
            m.configurePlayer("playing", "none")

            'bs:disable-next-line 1140
            onPlayerStateChanged()

            m.assertTrue(m.node.player.disableScreenSaver)
            m.assertEqual(m.node.screensaverOverlay.findNode("screensaverDelayTimer").control, "stop")
        end function

        @it("restores Roku screensaver behavior while paused and resumes custom mode")
        function _()
            m.configurePlayer("playing", "starfield")
            'bs:disable-next-line 1140
            onPlayerStateChanged()

            m.node.player.state = "paused"
            'bs:disable-next-line 1140
            onPlayerStateChanged()
            m.assertFalse(m.node.player.disableScreenSaver)

            m.node.player.state = "playing"
            'bs:disable-next-line 1140
            onPlayerStateChanged()
            m.assertTrue(m.node.player.disableScreenSaver)
        end function

        @it("logs pause and resume once per playback state transition")
        function _()
            collector = CreateObject("roSGNode", "LogService")
            m.node.log = new Logger("AudioPlayer", collector)
            m.configurePlayer("playing", "none")
            m.node.playerState.tracks = [{ Id: "track-1", Name: "Track One" }]
            m.node.playerState.currentIndex = 0

            'bs:disable-next-line 1140
            onPlayerStateChanged()
            m.node.player.state = "paused"
            'bs:disable-next-line 1140
            onPlayerStateChanged()
            'bs:disable-next-line 1140
            onPlayerStateChanged()
            m.node.player.state = "playing"
            'bs:disable-next-line 1140
            onPlayerStateChanged()

            entries = collector.callFunc("getSnapshot")
            activityEntries = []
            for each entry in entries
                if Instr(1, entry, "Activity:") > 0 then activityEntries.Push(entry)
            end for
            m.assertEqual(activityEntries.Count(), 3)
            m.assertTrue(Instr(1, activityEntries[0], "Playing track " + Char.DoubleQuote + "Track One" + Char.DoubleQuote) > 0)
            m.assertTrue(Instr(1, activityEntries[1], "Paused track " + Char.DoubleQuote + "Track One" + Char.DoubleQuote) > 0)
            m.assertTrue(Instr(1, activityEntries[2], "Resumed track " + Char.DoubleQuote + "Track One" + Char.DoubleQuote) > 0)
        end function

        @it("preserves an active screensaver through a successful track transition")
        function _()
            m.configurePlayer("finished", "bounce")
            m.node.playerState.tracks = [{ Id: "track-1" }, { Id: "track-2" }]
            m.node.playerState.currentIndex = 0
            m.node.screensaverOverlay.callFunc("startDelay")
            m.node.player.disableScreenSaver = true
            m.node.playerState.playbackLoad.nodes[0] = { request: invalid, control: "" }

            'bs:disable-next-line 1140
            onPlayerStateChanged()

            m.assertTrue(m.node.playerState.changingTrack)
            m.assertEqual(m.node.playerState.currentIndex, 1)
            m.assertTrue(m.node.player.disableScreenSaver)
        end function

        @it("keeps the audio player open after the final album track finishes")
        function _()
            m.configurePlayer("finished", "none")
            m.node.playerState.tracks = [{ Id: "track-1" }]
            m.node.playerState.currentIndex = 0
            m.top.closeRequested = false
            m.top.visible = true

            'bs:disable-next-line 1140
            onPlayerStateChanged()

            m.assertFalse(m.top.closeRequested)
            m.assertTrue(m.top.visible)
            m.assertEqual(m.node.playerState.currentIndex, 0)
            m.assertFalse(m.node.playerState.changingTrack)
        end function

        @it("ends the screensaver session on final completion and playback errors")
        function _()
            m.configurePlayer("finished", "bounce")
            m.node.playerState.tracks = [{ Id: "track-1" }]
            m.node.playerState.currentIndex = 0
            m.node.player.disableScreenSaver = true

            'bs:disable-next-line 1140
            onPlayerStateChanged()
            m.assertFalse(m.node.player.disableScreenSaver)

            m.node.player.state = "error"
            m.node.player.disableScreenSaver = true
            m.node.screensaverOverlay.callFunc("startDelay")
            'bs:disable-next-line 1140
            onPlayerStateChanged()
            m.assertFalse(m.node.player.disableScreenSaver)
        end function

        @it("ends the session when playback information fails or has no URL")
        function _()
            m.configurePlaybackInfoResponse({ ok: false, itemId: "track-1" })
            'bs:disable-next-line 1140
            onPlaybackInfoResponse()
            m.assertStoppedScreensaverSession()

            m.configurePlaybackInfoResponse({ ok: true, itemId: "track-1", streamUrl: "" })
            'bs:disable-next-line 1140
            onPlaybackInfoResponse()
            m.assertStoppedScreensaverSession()
        end function

        @it("ignores stale playback information without cancelling the current transition")
        function _()
            m.configurePlaybackInfoResponse({ ok: false, itemId: "old-track" })

            'bs:disable-next-line 1140
            onPlaybackInfoResponse()

            m.assertTrue(m.node.playerState.changingTrack)
            m.assertTrue(m.node.player.disableScreenSaver)
        end function

        @it("ignores uncorrelated playback information without cancelling the current transition")
        function _()
            m.configurePlaybackInfoResponse({ ok: false, errorMessage: "Uncorrelated failure" })

            'bs:disable-next-line 1140
            onPlaybackInfoResponse()

            m.assertTrue(m.node.playerState.changingTrack)
            m.assertTrue(m.node.player.disableScreenSaver)
        end function

        @it("restores Roku screensaver behavior when deactivated")
        function _()
            m.configurePlayer("playing", "bounce")
            m.node.player.disableScreenSaver = true
            m.node.screensaverOverlay.callFunc("startDelay")
            m.node.playerState.tracksLoad.nodes[0] = { control: "run" }
            m.node.playerState.playbackLoad.nodes[0] = { control: "run" }

            'bs:disable-next-line 1140
            deactivate()

            m.assertFalse(m.node.player.disableScreenSaver)
            m.assertEqual(m.node.player.control, "stop")
        end function

        @it("resumes paused playback")
        function _()
            m.configurePlayer("paused", "bounce")

            'bs:disable-next-line 1140
            togglePlayback()

            m.assertEqual(m.node.player.control, "resume")
        end function

        @it("requests a fresh stream when restarting stopped playback")
        function _()
            m.configurePlayer("playing", "bounce")
            m.node.player.position = 42.0
            m.node.playerState.tracks = [{ Id: "track-1", Name: "Track" }]
            m.node.playerState.currentIndex = 0
            m.node.playerState.playbackLoad.nodes[0] = { request: invalid, control: "" }

            'bs:disable-next-line 1140
            onPlaybackProgressChanged()
            m.node.player.state = "stopped"
            m.node.player.position = 0.0
            'bs:disable-next-line 1140
            onPlaybackProgressChanged()

            'bs:disable-next-line 1140
            togglePlayback()

            m.assertEqual(m.node.playerState.playbackLoad.nodes[0].request.itemId, "track-1")
            m.assertEqual(m.node.playerState.restartPosition, 42.0)
        end function

        @it("updates the recovery position when seeking to the beginning")
        function _()
            m.configurePlayer("paused", "bounce")
            m.node.player.position = 7.0
            m.node.playerState.lastPosition = 7.0
            m.node.playerState.tracks = [{ Id: "track-1", RunTimeTicks: 600000000 }]
            m.node.playerState.currentIndex = 0

            'bs:disable-next-line 1140
            seekBy(-10.0)

            m.assertEqual(m.node.playerState.lastPosition, 0)
        end function

        @it("restores the interrupted position when restarted playback begins")
        function _()
            m.configurePlayer("playing", "bounce")
            m.node.playerState.restartPosition = 42.0

            'bs:disable-next-line 1140
            onPlayerStateChanged()

            m.assertEqual(m.node.player.seek, 42.0)
            m.assertEqual(m.node.playerState.restartPosition, 0.0)
        end function

        private sub configurePlayer(state as string, screensaverType as string)
            m.node.playerState.playbackLoad = { lifecycle: LatestRequestLifecycle.Create(), nodes: [{}, {}], nextIndex: 0 }
            m.node.playerState.tracksLoad = { lifecycle: LatestRequestLifecycle.Create(), nodes: [{}, {}], nextIndex: 0 }
            settings = {}
            settings[SettingsStore.Key.ScreensaverType] = screensaverType
            settings[SettingsStore.Key.ScreensaverDelay] = "1"
            m.node.player = { state: state, control: "", disableScreenSaver: false, position: 0.0, duration: 0.0, seek: 0.0, errorCode: 0, errorMsg: "" }
            m.node.playerState.request = { settings: settings, server: "https://server", token: "fresh", userId: "user" }
            m.node.playerState.changingTrack = true
        end sub

        private sub configurePlaybackInfoResponse(response as object)
            m.configurePlayer("stopped", "bounce")
            m.node.player.disableScreenSaver = true
            m.node.playerState.tracks = [{ Id: "track-1", Name: "Track" }]
            m.node.playerState.currentIndex = 0
            request = PlaybackRequest.Create(m.node.playerState.request)
            request.itemId = "track-1"
            request.title = "Track"
            LatestRequestLifecycle.Queue(m.node.playerState.playbackLoad.lifecycle, request, request)
            LatestRequestLifecycle.TakeNext(m.node.playerState.playbackLoad.lifecycle)
            if response.itemId = "track-1" then response.requestId = 1
            response.action = "themeAudioPlaybackInfo"
            m.node.playerState.playbackLoad.nodes[0] = { response: response }
            m.node.screensaverOverlay.callFunc("startDelay")
        end sub

        private sub assertStoppedScreensaverSession()
            m.assertFalse(m.node.playerState.changingTrack)
            m.assertFalse(m.node.player.disableScreenSaver)
        end sub

        @describe("Authenticated audio content")

        @it("attaches current-session authentication for mp3 playback")
        function _()
            m.configurePlaybackInfoResponse({ ok: true, itemId: "track-1", streamUrl: "https://server/stream?ApiKey=server-token&x=1", streamFormat: "mp3" })

            'bs:disable-next-line 1140
            onPlaybackInfoResponse()

            m.assertEqual(m.node.player.content.url, "https://server/stream?ApiKey=server-token&x=1")
            m.assertEqual(m.node.player.content.HttpHeaders.Count(), 1)
            m.assertEqual(m.node.player.content.HttpHeaders, [TestMediaAuthentication.ExpectedHeader("fresh", "user")])
            m.assertEqual(m.node.player.control, "play")
        end function

        @it("attaches current-session authentication for hls playback")
        function _()
            m.configurePlaybackInfoResponse({ ok: true, itemId: "track-1", streamUrl: "https://server/stream?ApiKey=server-token&x=1", streamFormat: "hls" })

            'bs:disable-next-line 1140
            onPlaybackInfoResponse()

            m.assertEqual(m.node.player.content.url, "https://server/stream?ApiKey=server-token&x=1")
            m.assertEqual(m.node.player.content.HttpHeaders.Count(), 1)
            m.assertEqual(m.node.player.content.HttpHeaders, [TestMediaAuthentication.ExpectedHeader("fresh", "user")])
            m.assertEqual(m.node.player.control, "play")
        end function

        @it("leaves external audio URLs unauthenticated")
        function _()
            m.configurePlaybackInfoResponse({ ok: true, itemId: "track-1", streamUrl: "https://cdn.test/stream?ApiKey=provider", streamFormat: "mp3" })

            'bs:disable-next-line 1140
            onPlaybackInfoResponse()

            m.assertEqual(m.node.player.content.url, "https://cdn.test/stream?ApiKey=provider")
            m.assertEqual(m.node.player.content.HttpHeaders.Count(), 0)
        end function

        private sub configureSelection()
            m.configurePlayer("stopped", "none")
            m.node.playerState.tracks = [{ Id: "track-1", Name: "First" }, { Id: "track-2", Name: "Second" }, { Id: "track-3", Name: "Third" }]
        end sub

        private function response(requestId as integer, streamUrl = "https://server/stream?ApiKey=supplied#fragment" as string) as object
            return { requestId: requestId, action: "themeAudioPlaybackInfo", ok: true, streamUrl: streamUrl, streamFormat: "hls" }
        end function

        @it("same-item supersession rejects the first generation and starts the alternate task")
        function _()
            m.configureSelection()
            'bs:disable-next-line 1140
            playTrack(0)
            'bs:disable-next-line 1140
            playTrack(0)
            'bs:disable-next-line 1140
            handlePlaybackInfoResponse(m.response(1))
            m.assertInvalid(m.node.player.content)
            m.assertEqual(m.node.playerState.playbackLoad.nodes[1].request.requestId, 2)
            m.node.playerState.playbackLoad.nodes[1].response = m.response(2)
            'bs:disable-next-line 1140
            onAlternatePlaybackInfoResponse()
            'bs:disable-next-line 1140
            handlePlaybackInfoResponse(m.response(1, "https://old.test"))
            m.assertEqual(m.node.player.content.url, "https://server/stream?ApiKey=supplied#fragment")
        end function

        @it("rapid selections replace pending work with the final track")
        function _()
            m.configureSelection()
            'bs:disable-next-line 1140
            playTrack(0)
            'bs:disable-next-line 1140
            playTrack(1)
            'bs:disable-next-line 1140
            playTrack(2)
            'bs:disable-next-line 1140
            handlePlaybackInfoResponse(m.response(1))
            m.assertEqual(m.node.playerState.playbackLoad.nodes[1].request.itemId, "track-3")
            m.assertEqual(m.node.playerState.playbackLoad.nodes[1].request.requestId, 3)
            'bs:disable-next-line 1140
            handlePlaybackInfoResponse(m.response(3))
            m.assertEqual(m.node.player.content.title, "Third")
        end function

        @it("stale failures cannot cancel the newest screensaver transition")
        function _()
            m.configureSelection()
            m.node.player.disableScreenSaver = true
            'bs:disable-next-line 1140
            playTrack(0)
            'bs:disable-next-line 1140
            playTrack(1)
            'bs:disable-next-line 1140
            handlePlaybackInfoResponse({ requestId: 1, action: "themeAudioPlaybackInfo", ok: false })
            m.assertTrue(m.node.playerState.changingTrack)
            m.assertTrue(m.node.player.disableScreenSaver)
            m.assertEqual(m.node.playerState.playbackLoad.nodes[1].request.itemId, "track-2")
        end function

        @it("deactivation rejects late completion without resetting generations")
        function _()
            m.configureSelection()
            'bs:disable-next-line 1140
            playTrack(0)
            'bs:disable-next-line 1140
            deactivate()
            'bs:disable-next-line 1140
            handlePlaybackInfoResponse(m.response(1))
            m.assertInvalid(m.node.player.content)
            m.assertEqual(m.node.player.control, "stop")
            'bs:disable-next-line 1140
            playTrack(0)
            m.assertEqual(m.node.playerState.playbackLoad.lifecycle.active.request.requestId, 2)
        end function

        @it("content uses the session captured when its request was queued")
        function _()
            m.configureSelection()
            'bs:disable-next-line 1140
            playTrack(0)
            m.node.playerState.request.token = "later"
            m.node.playerState.request.userId = "other"
            'bs:disable-next-line 1140
            handlePlaybackInfoResponse(m.response(1))
            m.assertEqual(m.node.player.content.HttpHeaders, [TestMediaAuthentication.ExpectedHeader("fresh", "user")])
        end function

        @it("successive external content replaces previous authentication")
        function _()
            m.configureSelection()
            'bs:disable-next-line 1140
            playTrack(0)
            'bs:disable-next-line 1140
            handlePlaybackInfoResponse(m.response(1))
            m.node.playerState.request.token = "fresh"
            'bs:disable-next-line 1140
            playTrack(0)
            'bs:disable-next-line 1140
            handlePlaybackInfoResponse(m.response(2, "https://external/stream?ApiKey=provider"))
            m.assertEqual(m.node.player.content.url, "https://external/stream?ApiKey=provider")
            m.assertEqual(m.node.player.content.HttpHeaders, [])
        end function

        @it("successive missing-token content replaces previous authentication")
        function _()
            m.configureSelection()
            'bs:disable-next-line 1140
            playTrack(0)
            'bs:disable-next-line 1140
            handlePlaybackInfoResponse(m.response(1))
            m.node.playerState.request.token = ""
            'bs:disable-next-line 1140
            playTrack(0)
            'bs:disable-next-line 1140
            handlePlaybackInfoResponse(m.response(2, "https://server/stream"))
            m.assertEqual(m.node.player.content.url, "https://server/stream")
            m.assertEqual(m.node.player.content.HttpHeaders, [])
        end function

        @it("successive new-session content replaces previous authentication")
        function _()
            m.configureSelection()
            'bs:disable-next-line 1140
            playTrack(0)
            'bs:disable-next-line 1140
            handlePlaybackInfoResponse(m.response(1))
            m.node.playerState.request.token = "new-token"
