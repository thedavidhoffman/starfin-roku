            m.assertEqual(m.node.player.content.HttpHeaders, [TestMediaAuthentication.ExpectedHeader("new-token", "user")])
        end function

        private sub loadAlbum(albumId as string, token as string)
            m.node.top = { loadRequest: { server: "https://server", token: token, userId: "user", albumId: albumId, item: { Id: albumId, Name: "Album" }, settings: {} } }
            'bs:disable-next-line 1140
            onLoadRequestChanged()
        end sub

        private function albumResponse(requestId as integer) as object
            return { requestId: requestId, action: "albumTracks", ok: true, data: { Items: [{ Id: "track-1", Name: "First" }] } }
        end function

        @it("rejects late album results after same-album session replacement")
        function _()
            m.configureSelection()
            m.loadAlbum("album-1", "fresh")
            m.loadAlbum("album-1", "new-token")
            'bs:disable-next-line 1140
            handleTracksResponse(m.albumResponse(1))
            m.assertEqual(m.node.playerState.tracks.Count(), 0)
            m.assertInvalid(m.node.playerState.playbackLoad.lifecycle.active)
            m.node.playerState.tracksLoad.nodes[1].response = m.albumResponse(2)
            'bs:disable-next-line 1140
            onAlternateTracksResponse()
            m.assertEqual(m.node.playerState.playbackLoad.lifecycle.active.request.token, "new-token")
            'bs:disable-next-line 1140
            handlePlaybackInfoResponse(m.response(1))
            m.assertEqual(m.node.player.content.HttpHeaders, [TestMediaAuthentication.ExpectedHeader("new-token", "user")])
        end function

        @it("rejects late album results after album replacement")
        function _()
            m.configureSelection()
            m.loadAlbum("album-1", "fresh")
            m.loadAlbum("album-2", "new-token")
            'bs:disable-next-line 1140
            handleTracksResponse(m.albumResponse(1))
            m.assertEqual(m.node.playerState.tracks.Count(), 0)
            m.assertInvalid(m.node.playerState.playbackLoad.lifecycle.active)
            m.node.playerState.tracksLoad.nodes[1].response = m.albumResponse(2)
            'bs:disable-next-line 1140
            onAlternateTracksResponse()
            m.assertEqual(m.node.playerState.playbackLoad.lifecycle.active.request.token, "new-token")
            'bs:disable-next-line 1140
            handlePlaybackInfoResponse(m.response(1))
            m.assertEqual(m.node.player.content.HttpHeaders, [TestMediaAuthentication.ExpectedHeader("new-token", "user")])
        end function

        @it("album selection coalesces to the latest pending request in the same session")
        function _()
            m.configureSelection()
            m.loadAlbum("album-1", "fresh")
            m.loadAlbum("album-2", "fresh")
            m.loadAlbum("album-3", "fresh")
            'bs:disable-next-line 1140
            handleTracksResponse(m.albumResponse(1))
            m.assertEqual(m.node.playerState.tracks.Count(), 0)
            m.assertEqual(m.node.playerState.tracksLoad.nodes[1].request.albumId, "album-3")
            m.assertEqual(m.node.playerState.tracksLoad.nodes[1].request.requestId, 3)
            'bs:disable-next-line 1140
            handleTracksResponse(m.albumResponse(3))
            m.assertEqual(m.node.playerState.playbackLoad.lifecycle.active.request.itemId, "track-1")
        end function

        @it("stale album failure advances the latest selection without starting playback")
        function _()
            m.configureSelection()
            m.loadAlbum("album-1", "fresh")
            m.loadAlbum("album-2", "fresh")
            'bs:disable-next-line 1140
            handleTracksResponse({ action: "albumTracks", requestId: 1, ok: false })
            m.assertEqual(m.node.playerState.tracks.Count(), 0)
            m.assertInvalid(m.node.playerState.playbackLoad.lifecycle.active)
            m.assertEqual(m.node.playerState.tracksLoad.nodes[1].request.albumId, "album-2")
        end function

        @it("late album results cannot reopen deactivated playback")
        function _()
            m.configureSelection()
            m.loadAlbum("album-1", "fresh")
            'bs:disable-next-line 1140
            deactivate()
            'bs:disable-next-line 1140
            handleTracksResponse(m.albumResponse(1))
            m.assertEqual(m.node.playerState.tracks.Count(), 0)
            m.assertInvalid(m.node.playerState.playbackLoad.lifecycle.active)
        end function

        @it("pause and resume leave the outstanding request generation intact")
        function _()
            m.configureSelection()
            'bs:disable-next-line 1140
            playTrack(0)
            m.node.player.state = "playing"
            'bs:disable-next-line 1140
            togglePlayback()
            m.assertEqual(m.node.player.control, "pause")
            m.assertEqual(m.node.playerState.playbackLoad.lifecycle.active.request.requestId, 1)
            m.node.player.state = "paused"
            'bs:disable-next-line 1140
            togglePlayback()
            m.assertEqual(m.node.player.control, "resume")
            m.assertEqual(m.node.playerState.playbackLoad.lifecycle.active.request.requestId, 1)
        end function

        @describe("remote key casing")

        @it("ignores noncanonical BACK input")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("BACK", true)

            m.assertFalse(handled)
        end function

        @describe("track reporting integration")

        @it("closing playback retains its final report outside the player")
        function _()
            reporter = m.startReportedTrack()
            m.assertNotInvalid(reporter.sent)
            m.assertEqual(reporter.sent.Count(), 1)
            m.node.playerState.lastPosition = 42.0

            m.top.callFunc("deactivate")
            m.assertNotInvalid(reporter.mediaChange)
            m.assertEqual(reporter.mediaChange.reportState, "pending")
            reporter.callFunc("respond", true)

            m.assertEqual(reporter.sent[1].status, "stop")
            m.assertEqual(reporter.sent[1].position, 42.0)
            m.assertEqual(m.node.audioReporting.id, "")
            reporter.callFunc("respond", true)
            m.assertEqual(reporter.mediaChange.reportState, "saved")
            m.releaseReporter(reporter)
        end function

        @it("track completion saves its duration before advancing")
        function _()
            reporter = m.startReportedTrack()
            m.node.player.state = "finished"

            'bs:disable-next-line 1140
            onPlayerStateChanged()
            reporter.callFunc("respond", true)

            m.assertEqual(reporter.sent[1].position, 100.0)
            m.assertTrue(reporter.mediaChange.isFinished)
            m.assertEqual(m.node.playerState.currentIndex, 1)
            m.releaseReporter(reporter)
        end function

        @it("skipping a track reports the interrupted track identity")
        function _()
            reporter = m.startReportedTrack()
            m.node.playerState.lastPosition = 20.0

            'bs:disable-next-line 1140
            playNext()
            reporter.callFunc("respond", true)

            m.assertEqual(reporter.sent[1].itemId, "track-1")
            m.assertEqual(reporter.sent[1].position, 20.0)
            m.assertEqual(m.node.playerState.currentIndex, 1)
            m.releaseReporter(reporter)
        end function

        @it("pause sends an update without ending the reporting session")
        function _()
            reporter = m.startReportedTrack()
            reporter.callFunc("respond", true)
            m.node.player.state = "paused"
            m.node.playerState.lastPosition = 25.0

            'bs:disable-next-line 1140
            onPlayerStateChanged()

            m.assertEqual(reporter.sent[1].status, "update")
            m.assertTrue(reporter.sent[1].isPaused)
            m.assertNotEqual(m.node.audioReporting.id, "")
            m.releaseReporter(reporter)
        end function

        @it("periodic reporting uses the current track position")
        function _()
            reporter = m.startReportedTrack()
            reporter.callFunc("respond", true)
            m.node.playerState.lastPosition = 31.0

            'bs:disable-next-line 1140
            onAudioReportTimer()

            m.assertEqual(reporter.sent[1].status, "update")
            m.assertEqual(reporter.sent[1].position, 31.0)
            m.releaseReporter(reporter)
        end function

        @it("reports a seek only when playback reaches the requested position")
        function _()
            reporter = m.startReportedTrack()
            reporter.callFunc("respond", true)
            m.node.audioReporting.seekTarget = 40.0
            m.node.player.position = 20.0

            'bs:disable-next-line 1140
            onPlaybackProgressChanged()
            m.assertEqual(reporter.sent.Count(), 1)

            m.node.player.position = 40.0
            'bs:disable-next-line 1140
            onPlaybackProgressChanged()

            m.assertEqual(reporter.sent[1].position, 40.0)
            m.assertInvalid(m.node.audioReporting.seekTarget)
            m.releaseReporter(reporter)
        end function

        @it("passes the audiobook type into its durable reporting session")
        function _()
            reporter = m.startReportedTrack("AudioBook")

            m.assertEqual(reporter.sent[0].itemType, "AudioBook")
            m.releaseReporter(reporter)
        end function

        function startReportedTrack(itemType = "Audio" as string) as object
            m.configureSelection()
            m.node.playerState.tracks[0].Type = itemType
            m.node.playerState.tracks[0].RunTimeTicks = 1000000000
            m.node.playerState.currentIndex = 0
            m.node.playerState.request.accountKey = "account"
            m.node.audioReporting = { id: "", resolved: { playSessionId: "session", mediaSourceId: "source", playMethod: "DirectPlay", canSeek: true }, seekTarget: invalid }
            reporter = CreateObject("roSGNode", "AudioPlaybackReporterTestHarness")
            m.top.getScene().appendChild(reporter)
            m.top.reporter = reporter
            m.node.player.state = "playing"
            m.node.playerState.lastPosition = 0.0
            'bs:disable-next-line 1140
            startAudioReport()
            return reporter
        end function

        function releaseReporter(reporter as object)
            m.node.reportTimer.control = "stop"
            m.top.reporter = invalid
            m.node.audioReporting.id = ""
            m.top.getScene().removeChild(reporter)
        end function

    end class

end namespace
