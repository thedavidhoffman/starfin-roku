namespace tests

    @SGNode("MusicArtistCard")
    @suite("MusicArtistCard component")
    class MusicArtistCardTests extends rooibos.BaseTestSuite

        @describe("declarative component contract")

        @it("declares the artistMask node")
        function _()
            m.assertNotInvalid(m.top.findNode("artistMask"))
        end function

        @it("declares the artistArtwork node")
        function _()
            m.assertNotInvalid(m.top.findNode("artistArtwork"))
        end function

        @it("declares the artistLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("artistLabel"))
        end function

        @describe("item rendering")

        @it("renders the artist name")
        function _()
            item = m.createItem("Artist", "http://server/artist.jpg")

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("artistLabel").text, "Artist")
        end function

        @it("renders artist artwork")
        function _()
            item = m.createItem("Artist", "http://server/artist.jpg")

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("artistArtwork").uri, "http://server/artist.jpg")
        end function

        @it("uses the unknown artist fallback")
        function _()
            item = m.createItem("", "")

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("artistLabel").text, "Unknown Artist")
        end function

        function createItem(title as string, imageUrl as string) as object
            item = CreateObject("roSGNode", "ContentNode")
            item.title = title
            item.HDPosterUrl = imageUrl
            return item
        end function
    end class

end namespace
