namespace tests

    @SGNode("MusicArtist")
    @suite("MusicArtist component")
    class MusicArtistTests extends rooibos.BaseTestSuite

        @describe("declarative component contract")

        @it("declares the mediaShell node")
        function _()
            m.assertNotInvalid(m.top.findNode("mediaShell"))
        end function

        @it("declares the albumsRow node")
        function _()
            m.assertNotInvalid(m.top.findNode("albumsRow"))
        end function

        @it("declares the artistTask node")
        function _()
            m.assertNotInvalid(m.top.findNode("artistTask"))
        end function

        @it("declares the artistAlbumsTask node")
        function _()
            m.assertNotInvalid(m.top.findNode("artistAlbumsTask"))
        end function

        @it("displays third party request failures within the artist overview")
        function _()
            m.node.state.request = { musicBrainzArtistId: "artist-id", item: { Name: "Artist" } }
            m.node.state.lifecycle.isActive = true
            m.node.artistTask = { response: { ok: false, artistId: "artist-id", failureKind: "rateLimited", status: 429, errorMessage: "Too Many Requests" } }

            'bs:disable-next-line 1140
            onArtistResponse()

            m.assertEqual(m.top.findNode("mediaShell").mediaContent.overview, "Unable to load the artist overview. The server is receiving too many requests. Please wait a moment.")
        end function

        @describe("remote key casing")

        @it("ignores noncanonical BACK input")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("BACK", true)

            m.assertFalse(handled)
        end function

        @describe("Music backdrop preference")

        @it("applies committed Music Corner Backdrop independently")
        function _()
            m.top.settings = { "music-shell-layout": "partial-screen", "movie-shell-layout": "full-screen" }
            'bs:disable-next-line 1140
            onSettingsChanged()

            m.assertEqual(m.top.findNode("mediaShell").backgroundDisplay, "partial-screen")
        end function

        @it("ignores the movie backdrop preference")
        function _()
            m.top.settings = { "music-shell-layout": "full-screen", "movie-shell-layout": "partial-screen" }
            'bs:disable-next-line 1140
            onSettingsChanged()

            m.assertEqual(m.top.findNode("mediaShell").backgroundDisplay, "full-screen")
        end function

        @describe("remote Play")

        @it("plays the focused related media item")
        function _()
            content = CreateObject("roSGNode", "ContentNode")
            row = content.createChild("ContentNode")
            child = row.createChild("ContentNode")
            child.addFields({ raw: { Id: "media-remote", Type: "MusicAlbum" } })
            m.node.albumsRow.content = content
            m.node.albumsRow.visible = true
            m.node.albumsRow.jumpToRowItem = [0, 0]
            m.node.albumsRow.setFocus(true)
            m.top.playbackSelected = invalid

            'bs:disable-next-line 1140
            m.assertTrue(onKeyEvent("play", true))

            m.assertEqual(m.top.playbackSelected.itemId, "media-remote")
        end function

        @it("ignores Play release on the artist album row")
        function _()
            content = CreateObject("roSGNode", "ContentNode")
            row = content.createChild("ContentNode")
            row.createChild("ContentNode").addFields({ raw: { Id: "album", Type: "MusicAlbum" } })
            m.node.albumsRow.content = content
            m.node.albumsRow.visible = true
            m.node.albumsRow.jumpToRowItem = [0, 0]
            m.node.albumsRow.setFocus(true)
            m.top.playbackSelected = invalid

            'bs:disable-next-line 1140
            m.assertFalse(onKeyEvent("play", false))
            m.assertInvalid(m.top.playbackSelected)
        end function

    end class

end namespace
