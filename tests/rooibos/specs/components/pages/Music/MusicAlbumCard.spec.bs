namespace tests

    @SGNode("MusicAlbumCard")
    @suite("MusicAlbumCard component")
    class MusicAlbumCardTests extends rooibos.BaseTestSuite

        @describe("declarative component contract")

        @it("declares the contentGroup node")
        function _()
            m.assertNotInvalid(m.top.findNode("contentGroup"))
        end function

        @it("declares the albumMask node")
        function _()
            m.assertNotInvalid(m.top.findNode("albumMask"))
        end function

        @it("declares the albumArtwork node")
        function _()
            m.assertNotInvalid(m.top.findNode("albumArtwork"))
        end function

        @it("declares the artistLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("artistLabel"))
        end function

        @it("declares the albumLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("albumLabel"))
        end function

        @describe("item rendering")

        @it("renders supplied primary and secondary labels")
        function _()
            item = m.createItem()
            item.primaryLabel = "The Artist"
            item.secondaryLabel = "The Album"

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("artistLabel").text, "The Artist")
            m.assertEqual(m.top.findNode("albumLabel").text, "The Album")
        end function

        @it("renders artist and album fallback fields")
        function _()
            item = m.createItem()
            item.artistName = "Fallback Artist"
            item.title = "Fallback Album"

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("artistLabel").text, "Fallback Artist")
            m.assertEqual(m.top.findNode("albumLabel").text, "Fallback Album")
        end function

        @it("hides the secondary label for artist cards")
        function _()
            item = m.createItem()
            item.cardType = "artist"
            item.artistName = "Artist"

            m.top.itemContent = item

            m.assertFalse(m.top.findNode("albumLabel").visible)
        end function

        @it("renders supplied artwork")
        function _()
            item = m.createItem()
            item.HDPosterUrl = "http://server/album.jpg"

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("albumArtwork").uri, "http://server/album.jpg")
        end function

        @it("uses placeholder artwork when artwork is missing")
        function _()
            item = m.createItem()

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("albumArtwork").uri, "pkg:/images/music/album-placeholder-342x342.png")
        end function

        function createItem() as object
            item = CreateObject("roSGNode", "ContentNode")
            item.addFields({
                primaryLabel: ""
                secondaryLabel: ""
                artistName: ""
                cardType: ""
                raw: invalid
            })
            return item
        end function

    end class

end namespace
