namespace tests

    @SGNode("MediaActionsController")
    @suite("MediaActionsController component")
    class MediaActionsControllerTests extends rooibos.BaseTestSuite

        @describe("MediaActionsController behavior")

        @it("initializes and routes supported actions to their tasks")
        function _()
            m.assertNotInvalid(m.node.state.tasks.watched)
            m.assertNotInvalid(m.node.state.tasks.favorite)
            'bs:disable-next-line 1140
            watchedTask = getTaskForAction("MarkAsWatched")
            'bs:disable-next-line 1140
            favoriteTask = getTaskForAction("RemoveFromFavorites")
            m.assertTrue(watchedTask.isSameNode(m.node.state.tasks.watched))
            m.assertTrue(favoriteTask.isSameNode(m.node.state.tasks.favorite))
            'bs:disable-next-line 1140
            m.assertInvalid(getTaskForAction("Unsupported"))
        end function

        @it("maps media actions to state changes")
        function _()
            'bs:disable-next-line 1140
            m.assertEqual(getMediaStateResult("MarkAsWatched"), { action: "watched", value: true })
            'bs:disable-next-line 1140
            m.assertEqual(getMediaStateResult("MarkAsUnwatched"), { action: "watched", value: false })
            'bs:disable-next-line 1140
            m.assertEqual(getMediaStateResult("AddToFavorites"), { action: "favorite", value: true })
            'bs:disable-next-line 1140
            m.assertEqual(getMediaStateResult("RemoveFromFavorites"), { action: "favorite", value: false })
            'bs:disable-next-line 1140
            m.assertInvalid(getMediaStateResult("Unsupported"))
        end function

        @it("rejects unsupported action requests without starting a task")
        function _()
            m.top.actionRequest = { action: "Unsupported", itemId: "item-1" }
            'bs:disable-next-line 1140
            onActionRequestChanged()

            m.assertInvalid(m.node.state.activeRequest)
            m.assertEqual(m.top.actionFailed, {
                itemId: "item-1"
                errorMessage: "Unsupported media action."
            })
        end function

        @it("publishes correlated successful and failed task responses")
        function _()
            m.node.state.activeRequest = { action: "MarkAsWatched", itemId: "item-1" }
            successEvent = {
                data: { ok: true, action: "MarkAsWatched", itemId: "item-1" }
                getData: function() as dynamic
                    return m.data
                end function

            }
            'bs:disable-next-line 1140
            onActionTaskResponse(successEvent)
            m.assertInvalid(m.node.state.activeRequest)
            m.assertEqual(m.top.mediaStateChanged, {
                itemId: "item-1"
                action: "watched"
                value: true
            })
            m.node.state.activeRequest = { action: "AddToFavorites", itemId: "item-2" }
            failureEvent = {
                data: { ok: false, action: "AddToFavorites", itemId: "item-2", errorMessage: "Denied" }
                getData: function() as dynamic
                    return m.data
                end function

            }
            'bs:disable-next-line 1140
            onActionTaskResponse(failureEvent)
            m.assertEqual(m.top.actionFailed, { itemId: "item-2", errorMessage: "Denied" })
        end function

        @it("ignores stale responses and cancels active work")
        function _()
            request = { action: "MarkAsWatched", itemId: "current-item" }
            m.node.state.activeRequest = request
            staleEvent = {
                data: { ok: true, action: "MarkAsWatched", itemId: "stale-item" }
                getData: function() as dynamic
                    return m.data
                end function

            }
            'bs:disable-next-line 1140
            onActionTaskResponse(staleEvent)
            m.assertEqual(m.node.state.activeRequest, request)
            'bs:disable-next-line 1140
            cancelActiveAction()
            m.assertInvalid(m.node.state.activeRequest)
            m.assertEqual(m.node.state.tasks.watched.control, "stop")
            m.assertEqual(m.node.state.tasks.favorite.control, "stop")
        end function

    end class

end namespace
