namespace tests

    @suite("Array helpers")
    class ArrayTests extends rooibos.BaseTestSuite

        @describe("array inspection and joining")

        @it("counts arrays and associative arrays")
        function _()
            m.assertEqual(Arrays.GetCount([1, 2, 3]), 3)
            m.assertEqual(Arrays.GetCount({ one: 1, two: 2 }), 2)
        end function

        @it("returns zero for invalid and unsupported values")
        function _()
            m.assertEqual(Arrays.GetCount(invalid), 0)
            m.assertEqual(Arrays.GetCount("text"), 0)
        end function

        @it("recognizes associative arrays")
        function _()
            m.assertTrue(Arrays.IsAssocArray({ value: 1 }))
            m.assertFalse(Arrays.IsAssocArray([]))
            m.assertFalse(Arrays.IsAssocArray(invalid))
        end function

        @it("joins string values and handles invalid values")
        function _()
            m.assertEqual(Arrays.JoinStringValues(["one", "two", 3]), "one, two, 3")
            m.assertEqual(Arrays.JoinStringValues([]), "")
            m.assertEqual(Arrays.JoinStringValues(invalid), "")
        end function

    end class

end namespace
