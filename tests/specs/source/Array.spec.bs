namespace tests

    @suite("Array helpers")
    class ArrayTests extends rooibos.BaseTestSuite

        @describe("array inspection and joining")

        @it("counts arrays and associative arrays (case 1)")
        function _()
            m.assertEqual(Arrays.GetCount([1, 2, 3]), 3)
        end function

        @it("counts arrays and associative arrays (case 2)")
        function _()
            m.assertEqual(Arrays.GetCount({ one: 1, two: 2 }), 2)
        end function

        @it("returns zero for invalid and unsupported values (case 1)")
        function _()
            m.assertEqual(Arrays.GetCount(invalid), 0)
        end function

        @it("returns zero for invalid and unsupported values (case 2)")
        function _()
            m.assertEqual(Arrays.GetCount("text"), 0)
        end function

        @it("recognizes associative arrays (case 1)")
        function _()
            m.assertTrue(Arrays.IsAssocArray({ value: 1 }))
        end function

        @it("recognizes associative arrays (case 2)")
        function _()
            m.assertFalse(Arrays.IsAssocArray([]))
        end function

        @it("recognizes associative arrays (case 3)")
        function _()
            m.assertFalse(Arrays.IsAssocArray(invalid))
        end function

        @it("joins string values and handles invalid values (case 1)")
        function _()
            m.assertEqual(Arrays.JoinStringValues(["one", "two", 3]), "one, two, 3")
        end function

        @it("joins string values and handles invalid values (case 2)")
        function _()
            m.assertEqual(Arrays.JoinStringValues([]), "")
        end function

        @it("joins string values and handles invalid values (case 3)")
        function _()
            m.assertEqual(Arrays.JoinStringValues(invalid), "")
        end function

    end class

end namespace
