namespace tests

    @suite("Array helpers")
    class ArrayTests extends rooibos.BaseTestSuite

        @describe("array inspection and joining")

        @it("counts arrays and associative arrays")
        function _()
            m.assertEqual(Array_GetCount([1, 2, 3]), 3)
            m.assertEqual(Array_GetCount({ one: 1, two: 2 }), 2)
        end function

        @it("returns zero for invalid and unsupported values")
        function _()
            m.assertEqual(Array_GetCount(invalid), 0)
            m.assertEqual(Array_GetCount("text"), 0)
        end function

        @it("recognizes associative arrays")
        function _()
            m.assertTrue(Array_IsAssocArray({ value: 1 }))
            m.assertFalse(Array_IsAssocArray([]))
            m.assertFalse(Array_IsAssocArray(invalid))
        end function

        @it("joins string values and handles invalid values")
        function _()
            m.assertEqual(Array_JoinStringValues(["one", "two", 3]), "one, two, 3")
            m.assertEqual(Array_JoinStringValues([]), "")
            m.assertEqual(Array_JoinStringValues(invalid), "")
        end function

    end class

end namespace
