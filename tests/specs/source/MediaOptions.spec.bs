namespace tests

    @suite("Media option helpers")
    class MediaOptionsTests extends rooibos.BaseTestSuite

        @describe("media option construction and selection")

        @it("filters chapters without usable non-negative positions")
        function _()
            valid = { Name: "Valid", StartPositionTicks: 0 }
            item = { Chapters: [invalid, { Name: "Missing" }, { Name: "Negative", StartPositionTicks: -1 }, valid] }

            result = MediaOptions_GetChapters(item)
            m.assertEqual(result.Count(), 1)
            m.assertEqual(result[0].Name, "Valid")
            m.assertEqual(MediaOptions_GetChapters(invalid), [])
            m.assertEqual(MediaOptions_GetChapters({}), [])
        end function

        @it("builds subtitle options with an off choice")
        function _()
            streams = [{ Index: 4, DisplayTitle: "English SDH" }, { Language: "spa" }]
            options = MediaOptions_BuildSubtitleOptions(streams)

            m.assertEqual(options.Count(), 3)
            m.assertEqual(options[0].key, "-1")
            m.assertTrue(options[0].value.isOff)
            m.assertEqual(options[1].key, "4")
            m.assertEqual(options[1].label, "English SDH")
            m.assertEqual(options[2].key, "1")
            m.assertEqual(options[2].label, "spa")
        end function

        @it("builds audio options with source-index fallback")
        function _()
            streams = [{ sourceIndex: 7, Title: "Commentary" }, { Language: "eng" }]
            options = MediaOptions_BuildAudioOptions(streams)

            m.assertEqual(options.Count(), 2)
            m.assertEqual(options[0].key, "7")
            m.assertEqual(options[0].label, "Commentary")
            m.assertEqual(options[1].key, "1")
            m.assertEqual(options[1].label, "eng")
        end function

        @it("builds chapter options and numbers only valid chapters")
        function _()
            chapters = [
                { Name: "Opening", StartPositionTicks: 0 }
                { Name: "Invalid", StartPositionTicks: -1 }
                { StartPositionTicks: 600000000 }
            ]
            options = MediaOptions_BuildChapterOptions(chapters)

            m.assertEqual(options.Count(), 2)
            m.assertEqual(options[0].key, "0")
            m.assertEqual(options[0].label, "Opening - 0m")
            m.assertEqual(options[1].key, "600000000")
            m.assertEqual(options[1].label, "Chapter 2 - 1m")
            m.assertEqual(options[1].value.startPositionSeconds, 60)
        end function

        @it("uses subtitle and audio label fallbacks")
        function _()
            m.assertEqual(MediaOptions_GetSubtitleLabel({ Index: 3 }), "Subtitle 3")
            m.assertEqual(MediaOptions_GetSubtitleLabel({}), "Subtitle")
            m.assertEqual(MediaOptions_GetAudioLabel({ Index: 2 }), "Audio 2")
            m.assertEqual(MediaOptions_GetAudioLabel({}), "Audio Track")
        end function

        @it("prefers display title, title, then language for stream labels")
        function _()
            stream = { DisplayTitle: "Display", Title: "Title", Language: "eng" }
            m.assertEqual(MediaOptions_GetSubtitleLabel(stream), "Display")
            m.assertEqual(MediaOptions_GetAudioLabel(stream), "Display")
        end function

        @it("builds named and numbered chapter labels")
        function _()
            m.assertEqual(MediaOptions_GetChapterLabel({ Name: "Intro" }, 1, 120), "Intro - 2m")
            m.assertEqual(MediaOptions_GetChapterLabel({}, 3, 0), "Chapter 3 - 0m")
        end function

        @it("resolves stream indices in priority order")
        function _()
            m.assertEqual(MediaOptions_GetStreamIndex({ Index: 5, sourceIndex: 6 }, 1), 5)
            m.assertEqual(MediaOptions_GetStreamIndex({ sourceIndex: 6 }, 1), 6)
            m.assertEqual(MediaOptions_GetStreamIndex({}, 1), 1)
            m.assertEqual(MediaOptions_GetStreamIndex(invalid, 1), 1)
        end function

        @it("selects the current chapter key from playback position")
        function _()
            chapters = [
                { StartPositionTicks: 0 }
                { StartPositionTicks: 600000000 }
                { StartPositionTicks: 1200000000 }
            ]

            m.assertEqual(MediaOptions_GetCurrentChapterKey(chapters, 90), "600000000")
            m.assertEqual(MediaOptions_GetCurrentChapterKey(chapters, 0), "0")
            m.assertEqual(MediaOptions_GetCurrentChapterKey([], 90), "")
            m.assertEqual(MediaOptions_GetCurrentChapterKey(invalid, 90), "")
        end function

    end class

end namespace
