namespace tests

    @suite("Subtitle burn-in helpers")
    class SubtitleBurnInTests extends rooibos.BaseTestSuite

        @describe("SubtitleBurnIn.Normalize")

        @it("normalizes supported values and defaults unknown values")
        function _()
            m.assertEqual(SubtitleBurnIn.Normalize(SubtitleBurnIn.Mode.DuringTranscoding), SubtitleBurnIn.Mode.DuringTranscoding)
            m.assertEqual(SubtitleBurnIn.Normalize(SubtitleBurnIn.Mode.PreferExternal), SubtitleBurnIn.Mode.PreferExternal)
            m.assertEqual(SubtitleBurnIn.Normalize(SubtitleBurnIn.Mode.Always), SubtitleBurnIn.Mode.Always)
            m.assertEqual(SubtitleBurnIn.Normalize("UNKNOWN"), SubtitleBurnIn.Mode.DuringTranscoding)
            m.assertEqual(SubtitleBurnIn.Normalize(invalid), SubtitleBurnIn.Mode.DuringTranscoding)
        end function

    end class

end namespace
