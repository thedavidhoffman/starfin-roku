namespace tests

    @suite("Video player state helpers")
    class VideoPlayerStateTests extends rooibos.BaseTestSuite

        @describe("VideoPlayerState.Normalize")

        @it("returns the none state")
        function _()
            m.assertEqual(VideoPlayerState.Normalize(VideoPlayerState.Value.None), VideoPlayerState.Value.None)
        end function

        @it("returns the buffering state")
        function _()
            m.assertEqual(VideoPlayerState.Normalize(VideoPlayerState.Value.Buffering), VideoPlayerState.Value.Buffering)
        end function

        @it("normalizes state value casing")
        function _()
            m.assertEqual(VideoPlayerState.Normalize("PLAYING"), VideoPlayerState.Value.Playing)
        end function

        @it("returns the paused state")
        function _()
            m.assertEqual(VideoPlayerState.Normalize(VideoPlayerState.Value.Paused), VideoPlayerState.Value.Paused)
        end function

        @it("returns the stopped state")
        function _()
            m.assertEqual(VideoPlayerState.Normalize(VideoPlayerState.Value.Stopped), VideoPlayerState.Value.Stopped)
        end function

        @it("returns the finished state")
        function _()
            m.assertEqual(VideoPlayerState.Normalize(VideoPlayerState.Value.Finished), VideoPlayerState.Value.Finished)
        end function

        @it("returns the error state")
        function _()
            m.assertEqual(VideoPlayerState.Normalize(VideoPlayerState.Value.Error), VideoPlayerState.Value.Error)
        end function

        @it("falls back to none for an absent value")
        function _()
            m.assertEqual(VideoPlayerState.Normalize(invalid), VideoPlayerState.Value.None)
        end function

        @it("falls back to none for an unknown value")
        function _()
            m.assertEqual(VideoPlayerState.Normalize("FutureState"), VideoPlayerState.Value.None)
        end function

    end class

end namespace
