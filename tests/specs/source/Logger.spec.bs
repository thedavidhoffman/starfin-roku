namespace tests

    @suite("Logger formatting helpers")
    class LoggerTests extends rooibos.BaseTestSuite

        @describe("Logger pure formatting helpers")

        @it("formats JSON into indented display lines")
        function _()
            lines = Logger.__FormatJsonText("{" + Chr(34) + "Name" + Chr(34) + ":" + Chr(34) + "Starfin" + Chr(34) + "," + Chr(34) + "Values" + Chr(34) + ":[1,2]}")
            m.assertEqual(lines.Count(), 7)
            m.assertEqual(lines[0], "{")
            m.assertEqual(lines[1], "  " + Chr(34) + "Name" + Chr(34) + ": " + Chr(34) + "Starfin" + Chr(34) + ",")
            m.assertEqual(lines[2], "  " + Chr(34) + "Values" + Chr(34) + ":[")
            m.assertEqual(lines[3], "    1,")
            m.assertEqual(lines[4], "    2")
            m.assertEqual(lines[5], "  ]")
            m.assertEqual(lines[6], "}")
        end function

        @it("preserves escaped JSON string content")
        function _()
            escapedText = "A\" + Chr(34) + "B"
            jsonText = "{" + Chr(34) + "Text" + Chr(34) + ":" + Chr(34) + escapedText + Chr(34) + "}"
            lines = Logger.__FormatJsonText(jsonText)
            m.assertEqual(lines.Count(), 3)
            m.assertTrue(Instr(1, lines[1], escapedText) > 0)
        end function

        @it("trims, indents, and pads helper values")
        function _()
            m.assertEqual(Logger.__Trim(Chr(9) + " value " + Chr(13)), "value")
            m.assertEqual(Logger.__Indent(3), "      ")
            m.assertEqual(Logger.__Pad2(7), "07")
            m.assertEqual(Logger.__Pad2(12), "12")
            m.assertEqual(Logger.__Pad3(7), "007")
        end function

    end class

end namespace
