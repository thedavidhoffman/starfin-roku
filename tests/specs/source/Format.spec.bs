namespace tests

    @suite("Formatting helpers")
    class FormatTests extends rooibos.BaseTestSuite

        @describe("Format.SafeString")

        @it("converts values to strings and uses the fallback for invalid (case 1)")
        function _()
            m.assertEqual(Format.SafeString(42, "fallback"), "42")
        end function

        @it("converts values to strings and uses the fallback for invalid (case 2)")
        function _()
            m.assertEqual(Format.SafeString(false, "fallback"), "false")
        end function

        @it("converts values to strings and uses the fallback for invalid (case 3)")
        function _()
            m.assertEqual(Format.SafeString(invalid, "fallback"), "fallback")
        end function

        @describe("Format.FirstNonEmpty")

        @it("returns the first trimmed non-empty value")
        function _()
            m.assertEqual(Format.FirstNonEmpty([invalid, "  ", " first ", "second"], "fallback"), "first")
        end function

        @it("returns the fallback when no value is usable")
        function _()
            m.assertEqual(Format.FirstNonEmpty([invalid, "  "], "fallback"), "fallback")
        end function

        @describe("Format.WithCommas")

        @it("formats positive values with thousands separators (case 1)")
        function _()
            m.assertEqual(Format.WithCommas(999), "999")
        end function

        @it("formats positive values with thousands separators (case 2)")
        function _()
            m.assertEqual(Format.WithCommas(1234567), "1,234,567")
        end function

        @it("returns an empty string for invalid")
        function _()
            m.assertEqual(Format.WithCommas(invalid), "")
        end function

    end class

end namespace
