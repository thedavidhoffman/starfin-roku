namespace tests

    @suite("Playback progress helpers")
    class PlaybackProgressTests extends rooibos.BaseTestSuite

        @describe("PlaybackProgress.GetTicksFromSelection")

        @it("prefers ticks directly on a selection")
        function _()
            selection = { startPositionTicks: 30000000, item: { UserData: { PlaybackPositionTicks: 10000000 } } }

            m.assertEqual(PlaybackProgress.GetTicksFromSelection(selection), 30000000&)
        end function

        @it("falls back to progress stored on the selected item")
        function _()
            selection = { item: { UserData: { PlaybackPositionTicks: 20000000 } } }

            m.assertEqual(PlaybackProgress.GetTicksFromSelection(selection), 20000000&)
        end function

        @it("returns zero for an invalid selection")
        function _()
            m.assertEqual(PlaybackProgress.GetTicksFromSelection(invalid), 0&)
        end function

        @describe("PlaybackProgress.GetTicksFromItem")

        @it("extracts playback position ticks")
        function _()
            item = { UserData: { PlaybackPositionTicks: 40000000 } }

            m.assertEqual(PlaybackProgress.GetTicksFromItem(item), 40000000&)
        end function

        @it("returns zero when user data is missing")
        function _()
            m.assertEqual(PlaybackProgress.GetTicksFromItem({}), 0&)
        end function

        @it("returns zero for an invalid item")
        function _()
            m.assertEqual(PlaybackProgress.GetTicksFromItem(invalid), 0&)
        end function

        @describe("PlaybackProgress.TicksToSeconds")

        @it("converts ticks to whole seconds")
        function _()
            m.assertEqual(PlaybackProgress.TicksToSeconds(25999999), 2)
        end function

        @it("returns zero for zero ticks")
        function _()
            m.assertEqual(PlaybackProgress.TicksToSeconds(0), 0)
        end function

        @it("returns zero for negative ticks")
        function _()
            m.assertEqual(PlaybackProgress.TicksToSeconds(-1), 0)
        end function

        @it("returns zero for invalid ticks")
        function _()
            m.assertEqual(PlaybackProgress.TicksToSeconds(invalid), 0)
        end function

        @describe("PlaybackProgress.GetPercentage")

        @it("calculates fractional progress using floating-point division")
        function _()
            m.assertEqual(PlaybackProgress.GetPercentage(250, 1000), 25.0)
        end function

        @it("returns one hundred percent at the runtime boundary")
        function _()
            m.assertEqual(PlaybackProgress.GetPercentage(1000, 1000), 100.0)
        end function

        @it("caps progress above one hundred percent")
        function _()
            m.assertEqual(PlaybackProgress.GetPercentage(1250, 1000), 100.0)
        end function

        @it("uses duration when runtime is invalid")
        function _()
            m.assertEqual(PlaybackProgress.GetPercentage(250, invalid, 2000), 12.5)
        end function

        @it("uses duration when runtime is non-positive")
        function _()
            m.assertEqual(PlaybackProgress.GetPercentage(250, 0, 2000), 12.5)
        end function

        @it("returns zero when runtime and duration are unavailable")
        function _()
            m.assertEqual(PlaybackProgress.GetPercentage(250, invalid), 0.0)
        end function

        @it("returns zero for an invalid position")
        function _()
            m.assertEqual(PlaybackProgress.GetPercentage(invalid, 1000), 0.0)
        end function

        @it("returns zero for a zero position")
        function _()
            m.assertEqual(PlaybackProgress.GetPercentage(0, 1000), 0.0)
        end function

        @it("returns zero for a negative position")
        function _()
            m.assertEqual(PlaybackProgress.GetPercentage(-1, 1000), 0.0)
        end function

        @describe("PlaybackProgress.ApplyChangeToItem")

        @it("marks completed items played and clears their progress")
        function _()
            item = { UserData: { Played: false, PlayedPercentage: 50, PlaybackPositionTicks: 50000000 } }

            result = PlaybackProgress.ApplyChangeToItem(item, { isFinished: true })

            m.assertTrue(result)
            m.assertTrue(item.UserData.Played)
            m.assertEqual(item.UserData.PlayedPercentage, 0)
            m.assertEqual(item.UserData.PlaybackPositionTicks, 0)
        end function

        @it("updates active progress using runtime ticks")
        function _()
            item = { RunTimeTicks: 100000000 }

            result = PlaybackProgress.ApplyChangeToItem(item, { isFinished: false, positionTicks: 25000000 })

            m.assertTrue(result)
            m.assertFalse(item.UserData.Played)
            m.assertEqual(item.UserData.PlaybackPositionTicks, 25000000&)
            m.assertEqual(item.UserData.PlayedPercentage, 25.0)
        end function

        @it("uses duration fallback when applying active progress")
        function _()
            item = {}

            PlaybackProgress.ApplyChangeToItem(item, { isFinished: false, positionTicks: 25000000, durationTicks: 100000000 })

            m.assertEqual(item.UserData.PlayedPercentage, 25.0)
        end function

        @it("caps applied active progress at one hundred percent")
        function _()
            item = { RunTimeTicks: 100000000 }

            PlaybackProgress.ApplyChangeToItem(item, { isFinished: false, positionTicks: 120000000 })

            m.assertEqual(item.UserData.PlayedPercentage, 100.0)
        end function

        @it("rejects an invalid item")
        function _()
            m.assertFalse(PlaybackProgress.ApplyChangeToItem(invalid, { isFinished: false }))
        end function

        @it("rejects an invalid change")
        function _()
            m.assertFalse(PlaybackProgress.ApplyChangeToItem({}, invalid))
        end function

        @it("clears missing active progress")
        function _()
            item = { RunTimeTicks: 100000000 }

            result = PlaybackProgress.ApplyChangeToItem(item, { isFinished: false })

            m.assertTrue(result)
            m.assertEqual(item.UserData.PlaybackPositionTicks, 0&)
            m.assertEqual(item.UserData.PlayedPercentage, 0.0)
        end function

    end class

end namespace
