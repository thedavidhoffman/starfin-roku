namespace tests

    @suite("MediaPlaybackPolicy")
    class MediaPlaybackPolicyTests extends rooibos.BaseTestSuite

        @describe("TracksProgress")

        @it("does not track music videos")
        function _()
            m.assertFalse(MediaPlaybackPolicy.TracksProgress({ Type: "MusicVideo" }))
        end function

        @it("matches music videos case-insensitively")
        function _()
            m.assertFalse(MediaPlaybackPolicy.TracksProgress({ Type: "musicvideo" }))
        end function

        @it("tracks movies")
        function _()
            m.assertTrue(MediaPlaybackPolicy.TracksProgress({ Type: "Movie" }))
        end function

        @it("tracks episodes")
        function _()
            m.assertTrue(MediaPlaybackPolicy.TracksProgress({ Type: "Episode" }))
        end function

        @it("tracks ordinary and Home Media videos")
        function _()
            m.assertTrue(MediaPlaybackPolicy.TracksProgress({ Type: "Video" }))
        end function

        @it("tracks live TV channels")
        function _()
            m.assertTrue(MediaPlaybackPolicy.TracksProgress({ Type: "TvChannel" }))
        end function

        @it("tracks unknown item types")
        function _()
            m.assertTrue(MediaPlaybackPolicy.TracksProgress({ Type: "Unknown" }))
        end function

        @it("tracks items with a missing type")
        function _()
            m.assertTrue(MediaPlaybackPolicy.TracksProgress({}))
        end function

        @it("tracks missing items")
        function _()
            m.assertTrue(MediaPlaybackPolicy.TracksProgress(invalid))
        end function

    end class

end namespace
