namespace tests

    @suite("Video library filtering")
    class VideoLibraryFilterTests extends rooibos.BaseTestSuite

        @describe("decade filter")

        @it("uses production year with premiere-date fallback and sorts by year then title")
        function _()
            items = [
                { Id: "1999-z", SortName: "Zulu", ProductionYear: 1999 }
                { Id: "other", SortName: "Other", ProductionYear: 2000 }
                { Id: "1991", SortName: "Middle", PremiereDate: "1991-02-03T00:00:00.0000000Z" }
                { Id: "1999-a", SortName: "Alpha", ProductionYear: 1999 }
                { Id: "unknown", SortName: "Unknown" }
            ]

            result = VideoLibraryFilter.ByDecade(items, 1990)

            m.assertEqual(__FilterIds(result), ["1991", "1999-a", "1999-z"])
        end function

        @it("prefers production year when both year fields exist")
        function _()
            items = [
                { Id: "production-year", SortName: "Conflict", ProductionYear: 1995, PremiereDate: "2005-01-01T00:00:00.0000000Z" }
            ]

            result = VideoLibraryFilter.ByDecade(items, 1990)

            m.assertEqual(__FilterIds(result), ["production-year"])
        end function

        @describe("genre filter")

        @it("matches genres case-insensitively and sorts matching titles")
        function _()
            items = [
                { Id: "zebra", SortName: "Zebra", Genres: ["Drama", "Comedy"] }
                { Id: "other", SortName: "Other", Genres: ["Action"] }
                { Id: "alpha", SortName: "Alpha", Genres: ["COMEDY"] }
                { Id: "missing", SortName: "Missing" }
            ]

            result = VideoLibraryFilter.ByGenre(items, " comedy ")

            m.assertEqual(__FilterIds(result), ["alpha", "zebra"])
        end function

    end class

    function __FilterIds(items as object) as object
        ids = []
        for each item in items
            ids.Push(item.Id)
        end for
        return ids
    end function

end namespace
