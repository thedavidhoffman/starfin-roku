namespace tests

    @suite("Resolution-aware image assets")
    class ResolutionAssetsTests extends rooibos.BaseTestSuite

        @describe("ResolutionAssets image URIs")

        @it("builds category-specific HD image URIs")
        function _()
            originalProfile = m.global.resolutionProfile
            if m.global.HasField("resolutionProfile") = false then m.global.AddField("resolutionProfile", "assocarray", false)
            m.global.resolutionProfile = { resolution: "hd" }

            m.assertEqual(ResolutionAssets.GetButtonImageUri("button.png"), "pkg:/images/buttons/hd/button.png")
            m.assertEqual(ResolutionAssets.GetHeaderImageUri("header.png"), "pkg:/images/header/hd/header.png")
            m.assertEqual(ResolutionAssets.GetHomepageImageUri("homepage.png"), "pkg:/images/homepage/hd/homepage.png")
            m.assertEqual(ResolutionAssets.GetIconImageUri("icon.png"), "pkg:/images/icons/hd/icon.png")
            m.assertEqual(ResolutionAssets.GetMaskImageUri("mask.png"), "pkg:/images/masks/hd/mask.png")

            m.global.resolutionProfile = originalProfile
        end function

        @it("builds category-specific FHD image URIs")
        function _()
            originalProfile = m.global.resolutionProfile
            if m.global.HasField("resolutionProfile") = false then m.global.AddField("resolutionProfile", "assocarray", false)
            m.global.resolutionProfile = { resolution: "fhd" }

            m.assertEqual(ResolutionAssets.GetButtonImageUri("button.png"), "pkg:/images/buttons/fhd/button.png")
            m.assertEqual(ResolutionAssets.GetHeaderImageUri("header.png"), "pkg:/images/header/fhd/header.png")
            m.assertEqual(ResolutionAssets.GetHomepageImageUri("homepage.png"), "pkg:/images/homepage/fhd/homepage.png")
            m.assertEqual(ResolutionAssets.GetIconImageUri("icon.png"), "pkg:/images/icons/fhd/icon.png")
            m.assertEqual(ResolutionAssets.GetMaskImageUri("mask.png"), "pkg:/images/masks/fhd/mask.png")

            m.global.resolutionProfile = originalProfile
        end function

    end class

end namespace
