namespace tests

    @suite("Grid focus helpers")
    class GridFocusTests extends rooibos.BaseTestSuite

        @describe("GridFocus_GetDownTarget")

        @it("moves down by one complete row")
        function _()
            m.assertEqual(GridFocus_GetDownTarget(1, 9, 3), 4)
            m.assertEqual(GridFocus_GetDownTarget(5, 9, 3), 8)
        end function

        @it("moves to the final item when the last row is incomplete")
        function _()
            m.assertEqual(GridFocus_GetDownTarget(5, 8, 3), 7)
        end function

        @it("returns no target when already on the final row")
        function _()
            m.assertEqual(GridFocus_GetDownTarget(6, 8, 3), -1)
            m.assertEqual(GridFocus_GetDownTarget(7, 8, 3), -1)
        end function

        @it("rejects invalid grid dimensions and focus indices")
        function _()
            m.assertEqual(GridFocus_GetDownTarget(-1, 8, 3), -1)
            m.assertEqual(GridFocus_GetDownTarget(0, 0, 3), -1)
            m.assertEqual(GridFocus_GetDownTarget(0, 8, 0), -1)
        end function

    end class

end namespace
