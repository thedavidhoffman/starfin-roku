namespace tests

    @suite("Registry store")
    class RegistryStoreTests extends rooibos.BaseTestSuite

        @describe("RegistryStore.AccountSectionName")

        @it("uses the shared account registry section prefix (case 1)")
        function _()
            m.assertEqual(RegistryStore.AccountSectionName("server-user"), "STARFIN_ACCOUNT_server-user")
        end function

        @it("uses the shared account registry section prefix (case 2)")
        function _()
            m.assertEqual(RegistryStore.AccountSectionName(""), "STARFIN_ACCOUNT_")
        end function

    end class

end namespace
