namespace tests

    @suite("Encoding helpers")
    class EncodeTests extends rooibos.BaseTestSuite

        @describe("Encode.Base64")

        @it("encodes ASCII text and empty values")
        function _()
            m.assertEqual(Encode.Base64("Starfin"), "U3RhcmZpbg==")
            m.assertEqual(Encode.Base64(""), "")
        end function

        @describe("Encode.Url")

        @it("preserves URL-unreserved characters")
        function _()
            m.assertEqual(Encode.Url("AZaz09-._~"), "AZaz09-._~")
        end function

        @it("percent-encodes reserved characters with uppercase hex")
        function _()
            m.assertEqual(Encode.Url("a b/c?d=e&f"), "a%20b%2Fc%3Fd%3De%26f")
        end function

        @it("encodes percent signs instead of treating them as existing escapes")
        function _()
            m.assertEqual(Encode.Url("already%20encoded"), "already%2520encoded")
        end function

    end class

end namespace
