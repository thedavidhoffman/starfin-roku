namespace tests

    @suite("Playback mode helpers")
    class PlaybackModeTests extends rooibos.BaseTestSuite

        @describe("playback mode values and normalization")

        @it("provides every supported playback mode")
        function _()
            m.assertEqual(PlaybackMode.Mode.Automatic, "automatic")
            m.assertEqual(PlaybackMode.Mode.AutomaticNoRemux, "automatic-no-remux")
            m.assertEqual(PlaybackMode.Mode.TranscodeAllowRemux, "transcode-allow-remux")
            m.assertEqual(PlaybackMode.Mode.TranscodeNoRemux, "transcode-no-remux")
        end function

        @it("preserves supported values")
        function _()
            m.assertEqual(PlaybackMode.Normalize(PlaybackMode.Mode.Automatic), PlaybackMode.Mode.Automatic)
            m.assertEqual(PlaybackMode.Normalize(PlaybackMode.Mode.AutomaticNoRemux), PlaybackMode.Mode.AutomaticNoRemux)
            m.assertEqual(PlaybackMode.Normalize(PlaybackMode.Mode.TranscodeAllowRemux), PlaybackMode.Mode.TranscodeAllowRemux)
            m.assertEqual(PlaybackMode.Normalize(PlaybackMode.Mode.TranscodeNoRemux), PlaybackMode.Mode.TranscodeNoRemux)
        end function

        @it("uses automatic mode for invalid and unknown values")
        function _()
            m.assertEqual(PlaybackMode.Normalize(invalid), "automatic")
            m.assertEqual(PlaybackMode.Normalize("unsupported"), "automatic")
        end function

    end class

end namespace
