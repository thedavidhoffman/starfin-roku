namespace tests

    @suite("Authentication store helpers")
    class AuthStoreTests extends rooibos.BaseTestSuite

        @describe("AuthStore.BuildAccountKey")

        @it("normalizes server authorities and user IDs")
        function _()
            m.assertEqual(AuthStore.BuildAccountKey(" HTTPS://Example.COM/ ", "user-1"), "example.com/user-1")
            m.assertEqual(AuthStore.BuildAccountKey("example.com/path", "user-1"), "example.com/user-1")
            m.assertEqual(AuthStore.BuildAccountKey("example.com?api_key=secret", "user-1"), "example.com/user-1")
            m.assertEqual(AuthStore.BuildAccountKey("example.com#fragment", "user-1"), "example.com/user-1")
        end function

        @it("uses an empty user suffix for invalid IDs")
        function _()
            m.assertEqual(AuthStore.BuildAccountKey("example.com", invalid), "example.com/")
        end function

    end class

end namespace
