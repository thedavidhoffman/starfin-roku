namespace tests

    @suite("Episode sorting")
    class EpisodeSortTests extends rooibos.BaseTestSuite

        @describe("EpisodeSort_BySeriesSeasonEpisode")

        @it("sorts series titles using natural ordering")
        function _()
            items = [
                { Id: "ten", SeriesName: "Show 10", ParentIndexNumber: 1, IndexNumber: 1 }
                { Id: "two", SeriesName: "Show 2", ParentIndexNumber: 1, IndexNumber: 1 }
            ]

            m.assertEqual(__EpisodeIds(EpisodeSort_BySeriesSeasonEpisode(items)), ["two", "ten"])
        end function

        @it("sorts by season and then episode number")
        function _()
            items = [
                { Id: "s2e1", SeriesName: "Show", ParentIndexNumber: 2, IndexNumber: 1 }
                { Id: "s1e10", SeriesName: "Show", ParentIndexNumber: 1, IndexNumber: 10 }
                { Id: "s1e2", SeriesName: "Show", ParentIndexNumber: 1, IndexNumber: 2 }
            ]

            m.assertEqual(__EpisodeIds(EpisodeSort_BySeriesSeasonEpisode(items)), ["s1e2", "s1e10", "s2e1"])
        end function

        @it("uses alternate series, season, and episode fields")
        function _()
            items = [
                { Id: "second", Series: "Show", SeasonNumber: 1, EpisodeNumber: 2 }
                { Id: "first", ParentTitle: "Show", SeasonNumber: 1, EpisodeNumber: 1 }
            ]

            m.assertEqual(__EpisodeIds(EpisodeSort_BySeriesSeasonEpisode(items)), ["first", "second"])
        end function

        @it("places missing numbers after known numbers and breaks ties by name")
        function _()
            items = [
                { Id: "missing-z", SeriesName: "Show", Name: "Zebra" }
                { Id: "known", SeriesName: "Show", ParentIndexNumber: 1, IndexNumber: 1, Name: "Known" }
                { Id: "missing-a", SeriesName: "Show", Name: "Alpha" }
            ]

            m.assertEqual(__EpisodeIds(EpisodeSort_BySeriesSeasonEpisode(items)), ["known", "missing-a", "missing-z"])
        end function

        @it("returns a new collection and handles invalid input")
        function _()
            items = [{ Id: "b", SeriesName: "B" }, { Id: "a", SeriesName: "A" }]
            result = EpisodeSort_BySeriesSeasonEpisode(items)

            m.assertEqual(__EpisodeIds(result), ["a", "b"])
            m.assertEqual(__EpisodeIds(items), ["b", "a"])
            m.assertEqual(EpisodeSort_BySeriesSeasonEpisode(invalid), [])
        end function

    end class

    function __EpisodeIds(items as object) as object
        ids = []
        for each item in items
            ids.Push(item.Id)
        end for
        return ids
    end function

end namespace
