namespace tests

    @suite("Account image helpers")
    class AccountImageTests extends rooibos.BaseTestSuite

        @describe("AccountImage_GetUri")

        @it("uses the placeholder when required account fields are missing")
        function _()
            placeholder = "pkg:/images/cast/cast-placeholder-195x195.png"
            m.assertEqual(AccountImage_GetUri({}, 195, 195), placeholder)
            m.assertEqual(AccountImage_GetUri({ server: "server.local", userId: "user-1" }, 195, 195), placeholder)
        end function

        @it("builds a tagged user image URL with requested dimensions")
        function _()
            result = AccountImage_GetUri({ server: "server.local/", userId: "user-1", primaryImageTag: "tag-1" }, 144, 192)
            normalizedResult = LCase(result)

            m.assertTrue(Left(result, Len("http://server.local/Users/user-1/Images/Primary?")) = "http://server.local/Users/user-1/Images/Primary?")
            m.assertTrue(Instr(1, normalizedResult, "tag=tag-1") > 0)
            m.assertTrue(Instr(1, normalizedResult, "maxwidth=144") > 0)
            m.assertTrue(Instr(1, normalizedResult, "maxheight=192") > 0)
            m.assertTrue(Instr(1, normalizedResult, "quality=90") > 0)
            m.assertTrue(Instr(1, normalizedResult, "format=jpg") > 0)
        end function

    end class

end namespace
