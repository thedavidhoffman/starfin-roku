namespace tests

    @suite("Number helpers")
    class NumberTests extends rooibos.BaseTestSuite

        @describe("Number.ToFloat")

        @it("converts numeric strings to floats")
        function _()
            m.assertEqual(Number.ToFloat("123.75", 0.0), 123.75)
        end function

        @it("preserves float values")
        function _()
            m.assertEqual(Number.ToFloat(123.75, 0.0), 123.75)
        end function

        @it("converts integer values to floats")
        function _()
            m.assertEqual(Number.ToFloat(123, 0.0), 123.0)
        end function

        @it("returns the fallback for invalid input")
        function _()
            m.assertEqual(Number.ToFloat(invalid, 4.5), 4.5)
        end function

        @describe("Number.ToInteger")

        @it("converts numeric strings to integers")
        function _()
            m.assertEqual(Number.ToInteger("12.9", 0), 12)
        end function

        @it("rounds decimal values down to integers (case 1)")
        function _()
            m.assertEqual(Number.ToInteger(12.9, 0), 12)
        end function

        @it("rounds decimal values down to integers (case 2)")
        function _()
            m.assertEqual(Number.ToInteger(-12.9, 0), -13)
        end function

        @it("returns the fallback for invalid input")
        function _()
            m.assertEqual(Number.ToInteger(invalid, 42), 42)
        end function

        @describe("Number.FormatWithThousandsSeparator")

        @it("leaves values below one thousand unchanged")
        function _()
            m.assertEqual(Number.FormatWithThousandsSeparator(999), "999")
        end function

        @it("formats a four-digit value")
        function _()
            m.assertEqual(Number.FormatWithThousandsSeparator(1234), "1,234")
        end function

        @it("formats multiple thousands groups")
        function _()
            m.assertEqual(Number.FormatWithThousandsSeparator(123456789), "123,456,789")
        end function

        @it("preserves the sign of negative values")
        function _()
            m.assertEqual(Number.FormatWithThousandsSeparator(-1234567), "-1,234,567")
        end function

        @it("returns an empty string for invalid input")
        function _()
            m.assertEqual(Number.FormatWithThousandsSeparator(invalid), "")
        end function

    end class

end namespace
