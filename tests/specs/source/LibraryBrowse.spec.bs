namespace tests

    @suite("Library browse helpers")
    class LibraryBrowseTests extends rooibos.BaseTestSuite

        @describe("filter options")

        @it("returns empty options for an invalid payload")
        function _()
            result = LibraryBrowse.NormalizeFilterOptions(invalid)

            m.assertEqual(result, { decadeOptions: [], genreOptions: [] })
        end function

        @it("preserves valid decade and genre option arrays")
        function _()
            decades = [{ label: "1990s", value: 1990 }]
            genres = [{ label: "Drama", value: "Drama" }]

            result = LibraryBrowse.NormalizeFilterOptions({ decadeOptions: decades, genreOptions: genres })

            m.assertEqual(result.decadeOptions, decades)
            m.assertEqual(result.genreOptions, genres)
        end function

        @it("rejects malformed option collections")
        function _()
            result = LibraryBrowse.NormalizeFilterOptions({ decadeOptions: "invalid", genreOptions: {} })

            m.assertEqual(result, { decadeOptions: [], genreOptions: [] })
        end function

        @it("detects an active decade filter")
        function _()
            m.assertTrue(LibraryBrowse.IsDecadeActive(LibraryBrowse.Option.Decade))
        end function

        @it("rejects a non-decade filter")
        function _()
            m.assertFalse(LibraryBrowse.IsDecadeActive(LibraryBrowse.Option.Genre))
        end function

        @it("detects an active genre filter")
        function _()
            m.assertTrue(LibraryBrowse.IsGenreActive(LibraryBrowse.Option.Genre))
        end function

        @it("rejects an invalid genre filter")
        function _()
            m.assertFalse(LibraryBrowse.IsGenreActive(invalid))
        end function

        @it("finds exact option values")
        function _()
            options = [{ value: "Drama" }, { value: "Comedy" }]

            m.assertTrue(LibraryBrowse.ContainsOptionValue(options, "Drama"))
        end function

        @it("matches option values case-sensitively")
        function _()
            options = [{ value: "Drama" }]

            m.assertFalse(LibraryBrowse.ContainsOptionValue(options, "drama"))
        end function

        @it("rejects an empty option value")
        function _()
            options = [{ value: "Drama" }]

            m.assertFalse(LibraryBrowse.ContainsOptionValue(options, ""))
        end function

        @it("rejects invalid options")
        function _()
            m.assertFalse(LibraryBrowse.ContainsOptionValue(invalid, "Drama"))
        end function

        @describe("filter selection")

        @it("preserves a valid decade")
        function _()
            result = LibraryBrowse.ResolveDecade([{ value: 1970 }, { value: 1980 }], 1980)

            m.assertEqual(result, 1980)
        end function

        @it("falls back to the first decade")
        function _()
            result = LibraryBrowse.ResolveDecade([{ value: 1970 }, { value: 1980 }], 1960)

            m.assertEqual(result, 1970)
        end function

        @it("returns no decade when options are empty")
        function _()
            m.assertEqual(LibraryBrowse.ResolveDecade([], 1980), -1)
        end function

        @it("preserves a valid genre")
        function _()
            result = LibraryBrowse.ResolveGenre([{ value: "Comedy" }, { value: "Drama" }], "Drama")

            m.assertEqual(result, "Drama")
        end function

        @it("falls back to the first genre")
        function _()
            result = LibraryBrowse.ResolveGenre([{ value: "Comedy" }, { value: "Drama" }], "Horror")

            m.assertEqual(result, "Comedy")
        end function

        @it("returns no genre when options are empty")
        function _()
            m.assertEqual(LibraryBrowse.ResolveGenre([], "Drama"), "")
        end function

        @describe("sort selections")

        @it("preserves the video title serialized option")
        function _()
            m.assertEqual(LibraryBrowse.NormalizeVideoOption(LibraryBrowse.Option.Title), "SortName")
        end function

        @it("preserves the video release date serialized option")
        function _()
            m.assertEqual(LibraryBrowse.NormalizeVideoOption(LibraryBrowse.Option.ReleaseDate), "PremiereDate")
        end function

        @it("preserves the video date added serialized option")
        function _()
            m.assertEqual(LibraryBrowse.NormalizeVideoOption(LibraryBrowse.Option.DateAdded), "DateCreated")
        end function

        @it("preserves the video favorites serialized option")
        function _()
            m.assertEqual(LibraryBrowse.NormalizeVideoOption(LibraryBrowse.Option.Favorites), "Favorites")
        end function

        @it("preserves the video decade serialized option")
        function _()
            m.assertEqual(LibraryBrowse.NormalizeVideoOption(LibraryBrowse.Option.Decade), "Decade")
        end function

        @it("preserves the video genre serialized option")
        function _()
            m.assertEqual(LibraryBrowse.NormalizeVideoOption(LibraryBrowse.Option.Genre), "Genre")
        end function

        @it("defaults an invalid video option to title")
        function _()
            m.assertEqual(LibraryBrowse.NormalizeVideoOption("Artist"), LibraryBrowse.Option.Title)
        end function

        @it("preserves the music album serialized option")
        function _()
            m.assertEqual(LibraryBrowse.NormalizeMusicOption(LibraryBrowse.Option.Album), "Album")
        end function

        @it("preserves the music artist album serialized option")
        function _()
            m.assertEqual(LibraryBrowse.NormalizeMusicOption(LibraryBrowse.Option.ArtistAlbum), "ArtistAlbum")
        end function

        @it("preserves the music artist serialized option")
        function _()
            m.assertEqual(LibraryBrowse.NormalizeMusicOption(LibraryBrowse.Option.Artist), "Artist")
        end function

        @it("preserves the music favorites serialized option")
        function _()
            m.assertEqual(LibraryBrowse.NormalizeMusicOption(LibraryBrowse.Option.Favorites), "Favorites")
        end function

        @it("preserves the music decade serialized option")
        function _()
            m.assertEqual(LibraryBrowse.NormalizeMusicOption(LibraryBrowse.Option.Decade), "Decade")
        end function

        @it("preserves the music genre serialized option")
        function _()
            m.assertEqual(LibraryBrowse.NormalizeMusicOption(LibraryBrowse.Option.Genre), "Genre")
        end function

        @it("defaults an invalid music option to album")
        function _()
            m.assertEqual(LibraryBrowse.NormalizeMusicOption("DateCreated"), LibraryBrowse.Option.Album)
        end function

        @it("maps artist album sorting to the Jellyfin compound expression")
        function _()
            m.assertEqual(LibraryBrowse.GetMusicAlbumSortBy(LibraryBrowse.SortKey.ArtistAlbum), "AlbumArtist,SortName")
        end function

        @it("defaults music album sorting to title")
        function _()
            m.assertEqual(LibraryBrowse.GetMusicAlbumSortBy("invalid"), "SortName")
        end function

        @it("preserves descending sort order")
        function _()
            m.assertEqual(LibraryBrowse.NormalizeSortOrder(LibraryBrowse.SortOrder.Descending), "Descending")
        end function

        @it("defaults invalid sort order to ascending")
        function _()
            m.assertEqual(LibraryBrowse.NormalizeSortOrder("invalid"), "Ascending")
        end function

        @it("creates a normalized sort selection")
        function _()
            result = LibraryBrowse.CreateSortSelection(LibraryBrowse.Option.Favorites, LibraryBrowse.SortKey.Album, "Favorites", LibraryBrowse.SortOrder.Descending)

            m.assertEqual(result, {
                optionKey: LibraryBrowse.Option.Favorites
                sortKey: LibraryBrowse.SortKey.Album
                sortOrder: LibraryBrowse.SortOrder.Descending
                label: "Favorites"
            })
        end function

    end class

end namespace
