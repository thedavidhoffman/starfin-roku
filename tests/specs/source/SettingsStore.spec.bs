namespace tests

    @suite("Settings store")
    class SettingsStoreTests extends rooibos.BaseTestSuite

        @describe("SettingsStore.Key")

        @it("provides the persisted registry key values (case 1)")
        function _()
            m.assertEqual(SettingsStore.Key.TvLibraryDisplay, "tv-library-image-type")
        end function

        @it("provides the persisted registry key values (case 2)")
        function _()
            m.assertEqual(SettingsStore.Key.MovieLibraryDisplay, "movie-library-image-type")
        end function

        @it("provides the persisted registry key values (case 3)")
        function _()
            m.assertEqual(SettingsStore.Key.CollectionCardsImageType, "collection-cards-image-type")
        end function

        @it("provides the persisted registry key values (case 4)")
        function _()
            m.assertEqual(SettingsStore.Key.CollectionItemsImageType, "collection-items-image-type")
        end function

        @it("provides the persisted registry key values (case 5)")
        function _()
            m.assertEqual(SettingsStore.Key.PlaylistCardsImageType, "playlist-cards-image-type")
        end function

        @it("provides the persisted registry key values (case 6)")
        function _()
            m.assertEqual(SettingsStore.Key.PlaylistItemsImageType, "playlist-items-image-type")
        end function

        @it("provides the persisted registry key values (case 7)")
        function _()
            m.assertEqual(SettingsStore.Key.TvEpisodeListDisplay, "tv-ep-list-scroll")
        end function

        @it("provides the persisted registry key values (case 8)")
        function _()
            m.assertEqual(SettingsStore.Key.MediaShellBackground, "media-shell-background")
        end function

        @it("provides the persisted registry key values (case 9)")
        function _()
            m.assertEqual(SettingsStore.Key.ThemeMusic, "theme-music")
        end function

        @it("provides the persisted registry key values (case 10)")
        function _()
            m.assertEqual(SettingsStore.Key.ScreensaverType, "screensaver-type")
        end function

        @it("provides the persisted registry key values (case 11)")
        function _()
            m.assertEqual(SettingsStore.Key.ScreensaverDelay, "screensaver-delay")
        end function

        @it("provides the persisted registry key values (case 12)")
        function _()
            m.assertEqual(SettingsStore.Key.VideoStreamingMode, "video-streaming-mode")
        end function

        @it("provides the persisted registry key values (case 13)")
        function _()
            m.assertEqual(SettingsStore.Key.SubtitleBurnInMode, "subtitle-burn-in-mode")
        end function

        @it("provides the persisted registry key values (case 14)")
        function _()
            m.assertEqual(SettingsStore.Key.DisplayAccountBadge, "display-account-badge")
        end function

        @it("provides the persisted registry key values (case 15)")
        function _()
            m.assertEqual(SettingsStore.Key.TmdbApiKey, "tmdb-api-key")
        end function

        @describe("SettingsStore.Defaults")

        @it("indexes every default by its enum value")
        function _()
            defaults = SettingsStore.Defaults()

            m.assertEqual(defaults.Count(), 15)
            m.assertEqual(defaults[SettingsStore.Key.TvLibraryDisplay], "poster")
            m.assertEqual(defaults[SettingsStore.Key.MovieLibraryDisplay], "poster")
            m.assertEqual(defaults[SettingsStore.Key.CollectionCardsImageType], "poster")
            m.assertEqual(defaults[SettingsStore.Key.CollectionItemsImageType], "poster")
            m.assertEqual(defaults[SettingsStore.Key.PlaylistCardsImageType], "thumbnail")
            m.assertEqual(defaults[SettingsStore.Key.PlaylistItemsImageType], "thumbnail")
            m.assertEqual(defaults[SettingsStore.Key.TvEpisodeListDisplay], "vertical")
            m.assertEqual(defaults[SettingsStore.Key.MediaShellBackground], "full-screen")
            m.assertEqual(defaults[SettingsStore.Key.ThemeMusic], "off")
            m.assertEqual(defaults[SettingsStore.Key.ScreensaverType], "roku")
            m.assertEqual(defaults[SettingsStore.Key.ScreensaverDelay], "1")
            m.assertEqual(defaults[SettingsStore.Key.VideoStreamingMode], PlaybackMode.Mode.Automatic)
            m.assertEqual(defaults[SettingsStore.Key.SubtitleBurnInMode], SubtitleBurnIn.Mode.DuringTranscoding)
            m.assertEqual(defaults[SettingsStore.Key.DisplayAccountBadge], "off")
            m.assertEqual(defaults[SettingsStore.Key.TmdbApiKey], "")
        end function

        @describe("SettingsStore.AccountKeys")

        @it("contains only account-scoped setting keys")
        function _()
            m.assertEqual(SettingsStore.AccountKeys(), [
                SettingsStore.Key.TvLibraryDisplay
                SettingsStore.Key.MovieLibraryDisplay
                SettingsStore.Key.CollectionCardsImageType
                SettingsStore.Key.CollectionItemsImageType
                SettingsStore.Key.PlaylistCardsImageType
                SettingsStore.Key.PlaylistItemsImageType
                SettingsStore.Key.TvEpisodeListDisplay
                SettingsStore.Key.MediaShellBackground
                SettingsStore.Key.ThemeMusic
                SettingsStore.Key.ScreensaverType
                SettingsStore.Key.ScreensaverDelay
            ])
        end function

        @describe("SettingsStore value helpers")

        @it("reads associative-array values and applies fallbacks")
        function _()
            values = { present: "value", empty: "" }
            m.assertEqual(SettingsStore.GetValue(values, "present", "fallback"), "value")
            m.assertEqual(SettingsStore.GetValue(values, "missing", "fallback"), "fallback")
            m.assertEqual(SettingsStore.GetValue(values, "empty", "fallback"), "fallback")
            m.assertEqual(SettingsStore.GetValue(invalid, "present", "fallback"), "fallback")
        end function

        @it("uses enum-indexed defaults for missing settings")
        function _()
            settings = {}
            settings[SettingsStore.Key.ThemeMusic] = "on"

            m.assertEqual(SettingsStore.GetSettingValue(settings, SettingsStore.Key.ThemeMusic), "on")
            m.assertEqual(SettingsStore.GetSettingValue(settings, SettingsStore.Key.VideoStreamingMode), PlaybackMode.Mode.Automatic)
            m.assertEqual(SettingsStore.GetSettingValue(settings, SettingsStore.Key.SubtitleBurnInMode), SubtitleBurnIn.Mode.DuringTranscoding)
            m.assertEqual(SettingsStore.GetSettingValue(invalid, SettingsStore.Key.TvLibraryDisplay), "poster")
            m.assertEqual(SettingsStore.GetSettingValue({}, "unknown-key"), "")
        end function

        @describe("SettingsStore.IsThemeMusicEnabled")

        @it("enables theme music for on")
        function _()
            settings = {}
            settings[SettingsStore.Key.ThemeMusic] = "on"

            m.assertTrue(SettingsStore.IsThemeMusicEnabled(settings))
        end function

        @it("enables theme music case-insensitively")
        function _()
            settings = {}
            settings[SettingsStore.Key.ThemeMusic] = "ON"

            m.assertTrue(SettingsStore.IsThemeMusicEnabled(settings))
        end function

        @it("disables theme music for off")
        function _()
            settings = {}
            settings[SettingsStore.Key.ThemeMusic] = "off"

            m.assertFalse(SettingsStore.IsThemeMusicEnabled(settings))
        end function

        @it("disables theme music when settings are missing")
        function _()
            m.assertFalse(SettingsStore.IsThemeMusicEnabled(invalid))
        end function

        @it("compares effective setting values")
        function _()
            left = SettingsStore.Defaults()
            right = SettingsStore.Defaults()
            m.assertTrue(SettingsStore.AreEqual(left, right))

            right[SettingsStore.Key.ThemeMusic] = "on"
            m.assertFalse(SettingsStore.AreEqual(left, right))
            m.assertFalse(SettingsStore.AreEqual(invalid, right))
            m.assertFalse(SettingsStore.AreEqual(left, invalid))
        end function

    end class

end namespace
