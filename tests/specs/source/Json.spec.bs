namespace tests

    @suite("JSON helpers")
    class JsonTests extends rooibos.BaseTestSuite

        @describe("Json_String")

        @it("quotes strings and escapes backslashes and quotation marks")
        function _()
            quote = Chr(34)
            m.assertEqual(Json_String("C:\path"), quote + "C:\\path" + quote)
            m.assertEqual(Json_String("A" + quote + "B"), quote + "A\" + quote + "B" + quote)
        end function

        @describe("JSON pairs")

        @it("preserves field-name casing in string pairs")
        function _()
            m.assertEqual(Json_Pair("DeviceId", "roku-1"), Chr(34) + "DeviceId" + Chr(34) + ":" + Chr(34) + "roku-1" + Chr(34))
        end function

        @it("serializes boolean pairs")
        function _()
            m.assertEqual(Json_BooleanPair("Enabled", true), Chr(34) + "Enabled" + Chr(34) + ":true")
            m.assertEqual(Json_BooleanPair("Enabled", false), Chr(34) + "Enabled" + Chr(34) + ":false")
        end function

        @it("serializes number pairs")
        function _()
            m.assertEqual(Json_NumberPair("Count", 42), Chr(34) + "Count" + Chr(34) + ":42")
            m.assertEqual(Json_NumberPair("Count", invalid), Chr(34) + "Count" + Chr(34) + ":0")
        end function

        @describe("JSON collections")

        @it("serializes string arrays and invalid arrays")
        function _()
            m.assertEqual(Json_ArrayPair("Values", ["one", "two"]), Chr(34) + "Values" + Chr(34) + ":[" + Chr(34) + "one" + Chr(34) + "," + Chr(34) + "two" + Chr(34) + "]")
            m.assertEqual(Json_ArrayPair("Values", invalid), Chr(34) + "Values" + Chr(34) + ":[]")
        end function

        @it("builds nested objects from pre-serialized parts")
        function _()
            parts = [Json_Pair("Name", "Starfin"), Json_BooleanPair("Active", true)]
            result = Json_ObjectPair("Client", parts)
            m.assertEqual(result, Chr(34) + "Client" + Chr(34) + ":{" + Chr(34) + "Name" + Chr(34) + ":" + Chr(34) + "Starfin" + Chr(34) + "," + Chr(34) + "Active" + Chr(34) + ":true}")
        end function

        @it("joins parts and handles empty collections")
        function _()
            m.assertEqual(Json_JoinParts(["one", "two", "three"]), "one,two,three")
            m.assertEqual(Json_JoinParts([]), "")
            m.assertEqual(Json_JoinParts(invalid), "")
            m.assertEqual(Json_Object([]), "{}")
        end function

        @describe("Json_Number")

        @it("normalizes separators, invalid values, and exponent notation")
        function _()
            m.assertEqual(Json_Number("1,234.5"), "1234.5")
            m.assertEqual(Json_Number(invalid), "0")
            m.assertEqual(Json_Number("1.25e3"), "1250")
            m.assertEqual(Json_Number("-2.5e-2"), "-0.025")
        end function

    end class

end namespace
