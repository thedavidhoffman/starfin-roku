namespace tests

    @suite("Video card presentation helpers")
    class VideoCardPresentationTests extends rooibos.BaseTestSuite

        @describe("VideoCardPresentation.Normalize")

        @it("returns the poster presentation")
        function _()
            m.assertEqual(VideoCardPresentation.Normalize(VideoCardPresentation.Type.Poster), VideoCardPresentation.Type.Poster)
        end function

        @it("returns the thumbnail presentation")
        function _()
            m.assertEqual(VideoCardPresentation.Normalize(VideoCardPresentation.Type.Thumbnail), VideoCardPresentation.Type.Thumbnail)
        end function

        @it("returns the jumbo presentation")
        function _()
            m.assertEqual(VideoCardPresentation.Normalize(VideoCardPresentation.Type.Jumbo), VideoCardPresentation.Type.Jumbo)
        end function

        @it("returns the detailed presentation")
        function _()
            m.assertEqual(VideoCardPresentation.Normalize(VideoCardPresentation.Type.Detailed), VideoCardPresentation.Type.Detailed)
        end function

        @it("normalizes presentation value casing")
        function _()
            m.assertEqual(VideoCardPresentation.Normalize("THUMBNAIL"), VideoCardPresentation.Type.Thumbnail)
        end function

        @it("falls back to poster for an unknown value")
        function _()
            m.assertEqual(VideoCardPresentation.Normalize("unknown"), VideoCardPresentation.Type.Poster)
        end function

        @it("falls back to poster for an absent value")
        function _()
            m.assertEqual(VideoCardPresentation.Normalize(invalid), VideoCardPresentation.Type.Poster)
        end function

    end class

end namespace
