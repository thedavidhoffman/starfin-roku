namespace tests

    @suite("Library grid layout helpers")
    class LibraryGridLayoutTests extends rooibos.BaseTestSuite

        @describe("shared card and item geometry")

        @it("returns the poster card specification")
        function _()
            spec = LibraryGridLayout.GetSpec("poster", "cards")

            m.assertEqual(spec.translation, [96, 207])
            m.assertEqual(spec.itemSize, [297, 465])
            m.assertEqual(spec.itemSpacing, [-12, -12])
            m.assertEqual(spec.numColumns, 6)
            m.assertEqual(spec.numRows, 2)
            m.assertEqual(spec.focusBitmapUri, "pkg:/images/library/poster-focus-297x465.png")
            m.assertEqual(spec.artworkSize, [252, 378])
        end function

        @it("returns the poster item specification")
        function _()
            spec = LibraryGridLayout.GetSpec("poster", "items")

            m.assertEqual(spec.itemSpacing, [-12, 27])
            m.assertEqual(spec.artworkSize, [252, 378])
        end function

        @it("returns the wide card specification")
        function _()
            spec = LibraryGridLayout.GetSpec("wide", "cards")

            m.assertEqual(spec.translation, [24, 207])
            m.assertEqual(spec.itemSize, [465, 348])
            m.assertEqual(spec.itemSpacing, [0, -24])
            m.assertEqual(spec.numColumns, 4)
            m.assertEqual(spec.numRows, 3)
            m.assertEqual(spec.focusBitmapUri, "pkg:/images/library/thumbnail-focus-465x348.png")
            m.assertEqual(spec.artworkSize, [441, 249])
        end function

        @it("returns the wide item specification")
        function _()
            spec = LibraryGridLayout.GetSpec("wide", "items")

            m.assertEqual(spec.itemSpacing, [0, 12])
            m.assertEqual(spec.artworkSize, [441, 249])
        end function

        @it("returns the jumbo item specification")
        function _()
            spec = LibraryGridLayout.GetSpec("jumbo", "items")

            m.assertEqual(spec.translation, [24, 207])
            m.assertEqual(spec.itemSize, [936, 591])
            m.assertEqual(spec.itemSpacing, [0, 18])
            m.assertEqual(spec.numColumns, 2)
            m.assertEqual(spec.numRows, 2)
            m.assertEqual(spec.focusBitmapUri, "pkg:/images/library/jumbo-focus-936x591.png")
            m.assertEqual(spec.artworkSize, [882, 496])
        end function

        @it("resolves the grid cell right edge")
        function _()
            grid = { translation: [96, 207], itemSize: [297, 465], itemSpacing: [-12, 27], numColumns: 6 }

            m.assertEqual(LibraryGridLayout.GetGridRightEdge(grid), 1818)
        end function

        @it("resolves the visible poster grid right edge")
        function _()
            grid = { translation: [96, 207], itemSize: [297, 465], itemSpacing: [-12, 27], numColumns: 6 }
            spec = LibraryGridLayout.GetSpec("poster", "items")

            m.assertEqual(LibraryGridLayout.GetVisibleRightEdge(grid, spec), 1794)
        end function

        @it("resolves the visible wide grid right edge")
        function _()
            grid = { translation: [24, 207], itemSize: [465, 348], itemSpacing: [0, 12], numColumns: 4 }
            spec = LibraryGridLayout.GetSpec("wide", "items")

            m.assertEqual(LibraryGridLayout.GetVisibleRightEdge(grid, spec), 1880)
        end function

    end class

end namespace
