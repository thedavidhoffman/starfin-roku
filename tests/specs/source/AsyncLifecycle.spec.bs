namespace tests

    @suite("Async lifecycle helpers")
    class AsyncLifecycleTests extends rooibos.BaseTestSuite

        @describe("lifecycle state and response correlation")

        @it("creates inactive lifecycle state")
        function _()
            state = AsyncLifecycle.Create()
            m.assertFalse(state.isActive)
            m.assertEqual(state.activeRequestKey, "")
        end function

        @it("begins and deactivates requests")
        function _()
            state = AsyncLifecycle.Create()
            AsyncLifecycle.Begin(state, "request-1")
            m.assertTrue(state.isActive)
            m.assertEqual(state.activeRequestKey, "request-1")

            AsyncLifecycle.Deactivate(state)
            m.assertFalse(state.isActive)
            m.assertEqual(state.activeRequestKey, "")
        end function

        @it("begins requests from named source fields")
        function _()
            state = AsyncLifecycle.Create()
            AsyncLifecycle.BeginFromField(state, { itemId: "item-1" }, "itemId")
            m.assertTrue(state.isActive)
            m.assertEqual(state.activeRequestKey, "item-1")
        end function

        @it("ignores unusable begin-from-field requests")
        function _()
            state = AsyncLifecycle.Create()
            AsyncLifecycle.BeginFromField(state, invalid, "itemId")
            AsyncLifecycle.BeginFromField(state, {}, "itemId")
            AsyncLifecycle.BeginFromField(state, { itemId: "item-1" }, "")
            m.assertFalse(state.isActive)
        end function

        @it("accepts only the current active response and expected action")
        function _()
            state = AsyncLifecycle.Create()
            AsyncLifecycle.Begin(state, "item-1")

            m.assertTrue(AsyncLifecycle.IsCurrentResponse(state, { itemId: "item-1", action: "load" }, "itemId", "load"))
            m.assertFalse(AsyncLifecycle.IsCurrentResponse(state, { itemId: "item-2", action: "load" }, "itemId", "load"))
            m.assertFalse(AsyncLifecycle.IsCurrentResponse(state, { itemId: "item-1", action: "other" }, "itemId", "load"))

            AsyncLifecycle.Deactivate(state)
            m.assertFalse(AsyncLifecycle.IsCurrentResponse(state, { itemId: "item-1", action: "load" }, "itemId", "load"))
        end function

        @it("builds stable composite keys")
        function _()
            m.assertEqual(AsyncLifecycle.BuildKey(["one", 2, invalid, "four"]), "one|2||four")
            m.assertEqual(AsyncLifecycle.BuildKey([]), "")
            m.assertEqual(AsyncLifecycle.BuildKey(invalid), "")
        end function

    end class

end namespace
