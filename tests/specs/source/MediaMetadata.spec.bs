namespace tests

    @suite("Media metadata helpers")
    class MediaMetadataTests extends rooibos.BaseTestSuite

        @describe("MediaMetadata.FormatRating")

        @it("rounds positive ratings to one decimal place")
        function _()
            m.assertEqual(MediaMetadata.FormatRating(8.24), "8.2")
            m.assertEqual(MediaMetadata.FormatRating(8.25), "8.3")
            m.assertEqual(MediaMetadata.FormatRating("7.5"), "7.5")
        end function

        @it("omits invalid and non-positive ratings")
        function _()
            m.assertEqual(MediaMetadata.FormatRating(invalid), "")
            m.assertEqual(MediaMetadata.FormatRating(0), "")
            m.assertEqual(MediaMetadata.FormatRating(-1), "")
        end function

        @describe("MediaMetadata.FormatRuntime")

        @it("formats runtime ticks as minutes and hours")
        function _()
            m.assertEqual(MediaMetadata.FormatRuntime(35999999999&), "59m")
            m.assertEqual(MediaMetadata.FormatRuntime(36000000000&), "1h 0m")
            m.assertEqual(MediaMetadata.FormatRuntime(75000000000&), "2h 5m")
        end function

        @it("omits invalid and sub-minute runtimes")
        function _()
            m.assertEqual(MediaMetadata.FormatRuntime(invalid), "")
            m.assertEqual(MediaMetadata.FormatRuntime(599999999&), "")
            m.assertEqual(MediaMetadata.FormatRuntime(0), "")
        end function

        @it("provides a non-empty bullet separator")
        function _()
            separator = MediaMetadata.BulletSeparator()
            m.assertTrue(Len(separator) > 0)
            m.assertEqual(Strings.Trim(separator) <> "", true)
        end function

    end class

end namespace
