namespace tests

    @SGNode("Clock")
    @suite("Clock component")
    class ClockTests extends rooibos.BaseTestSuite

        @describe("Clock behavior")

        @it("initializes default dimensions and time text")
        function _()
            m.assertEqual(m.top.clockWidth, 160.0)
            m.assertEqual(m.top.clockHeight, 40.0)
            m.assertTrue(m.node.timeLabel.text <> "")
        end function

        @it("applies configured dimensions")
        function _()
            m.top.clockWidth = 220
            m.top.clockHeight = 50
            'bs:disable-next-line 1140
            onDimensionsChanged()
            m.assertEqual(m.node.timeLabel.width, 220.0)
            m.assertEqual(m.node.timeLabel.height, 50.0)
        end function

        @it("applies the configured color")
        function _()
            m.top.color = &h123456FF
            'bs:disable-next-line 1140
            onColorChanged()
            m.assertEqual(m.node.timeLabel.color, &h123456FF)
        end function

    end class

end namespace
