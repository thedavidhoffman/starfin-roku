namespace tests

    @SGNode("PreviousNextButton")
    @suite("PreviousNextButton component")
    class PreviousNextButtonTests extends rooibos.BaseTestSuite

        @describe("PreviousNextButton behavior")

        @it("initializes hidden with unfocused unavailable chevrons (case 1)")
        function _()
            m.assertFalse(m.top.visible)
        end function

        @it("initializes hidden with unfocused unavailable chevrons (case 2)")
        function _()
            m.assertFalse(m.top.hasPrevious)
        end function

        @it("initializes hidden with unfocused unavailable chevrons (case 3)")
        function _()
            m.assertFalse(m.top.hasNext)
        end function

        @it("initializes hidden with unfocused unavailable chevrons (case 4)")
        function _()
            m.assertNotInvalid(m.node.bg)
        end function

        @it("initializes hidden with unfocused unavailable chevrons (case 5)")
        function _()
            m.assertNotInvalid(m.node.previousChevron)
        end function

        @it("initializes hidden with unfocused unavailable chevrons (case 6)")
        function _()
            m.assertNotInvalid(m.node.nextChevron)
        end function

        @it("initializes hidden with unfocused unavailable chevrons (case 7)")
        function _()
            m.assertEqual(m.node.bg.uri, "pkg:/images/buttons/previous-next-button-unfocused.9.png")
        end function

        @it("initializes hidden with unfocused unavailable chevrons (case 8)")
        function _()
            m.assertTrue(m.node.previousChevron.visible)
        end function

        @it("initializes hidden with unfocused unavailable chevrons (case 9)")
        function _()
            m.assertTrue(m.node.nextChevron.visible)
        end function

        @it("initializes hidden with unfocused unavailable chevrons (case 10)")
        function _()
            m.assertEqual(m.node.previousChevron.opacity, 0.35)
        end function

        @it("initializes hidden with unfocused unavailable chevrons (case 11)")
        function _()
            m.assertEqual(m.node.nextChevron.opacity, 0.35)
        end function

        @it("is visible when either navigation direction is available")
        function _()
            m.top.hasPrevious = true
            'bs:disable-next-line 1140
            onAvailabilityChanged()
            m.assertTrue(m.top.visible)

            m.top.hasPrevious = false
            m.top.hasNext = true
            'bs:disable-next-line 1140
            onAvailabilityChanged()
            m.assertTrue(m.top.visible)

            m.top.hasNext = false
            'bs:disable-next-line 1140
            onAvailabilityChanged()
            m.assertFalse(m.top.visible)
        end function

        @it("stays hidden when display is disabled despite available navigation")
        function _()
            m.top.displayEnabled = false
            m.top.hasPrevious = true
            m.top.hasNext = true

            'bs:disable-next-line 1140
            onAvailabilityChanged()
            m.assertFalse(m.top.visible)

            m.top.displayEnabled = true
            'bs:disable-next-line 1140
            onAvailabilityChanged()
            m.assertTrue(m.top.visible)
        end function

        @it("renders focused and unfocused availability states")
        function _()
            m.top.hasPrevious = true
            m.top.hasNext = false

            'bs:disable-next-line 1140
            activate()
            m.assertEqual(m.node.bg.uri, "pkg:/images/buttons/previous-next-button-focused.9.png")
            m.assertEqual(m.node.previousChevron.opacity, 1.0)
            m.assertEqual(m.node.nextChevron.opacity, 0.35)

            'bs:disable-next-line 1140
            deactivate()
            m.assertEqual(m.node.bg.uri, "pkg:/images/buttons/previous-next-button-unfocused.9.png")
            m.assertEqual(m.node.previousChevron.opacity, 0.35)
            m.assertEqual(m.node.nextChevron.opacity, 0.35)
        end function

        @it("emits selection only for pressed available directions")
        function _()
            m.top.hasPrevious = false
            m.top.hasNext = false
            m.top.previousSelected = false
            m.top.nextSelected = false

            'bs:disable-next-line 1140
            m.assertFalse(onKeyEvent("left", false))
            'bs:disable-next-line 1140
            m.assertFalse(onKeyEvent("left", true))
            m.assertFalse(m.top.previousSelected)

            m.top.hasPrevious = true
            'bs:disable-next-line 1140
            m.assertTrue(onKeyEvent("left", true))
            m.assertTrue(m.top.previousSelected)
            m.assertFalse(m.top.nextSelected)

            m.top.hasNext = true
            'bs:disable-next-line 1140
            m.assertTrue(onKeyEvent("right", true))
            m.assertTrue(m.top.nextSelected)

            'bs:disable-next-line 1140
            m.assertFalse(onKeyEvent("up", true))
        end function

    end class

end namespace
