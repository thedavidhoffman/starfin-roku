namespace tests

    @SGNode("PrimaryButton")
    @suite("PrimaryButton component")
    class PrimaryButtonTests extends rooibos.BaseTestSuite

        @describe("PrimaryButton behavior")

        @it("initializes XML defaults and required child nodes")
        function _()
            m.assertEqual(m.top.buttonWidth, 300.0)
            m.assertEqual(m.top.buttonHeight, 56.0)
            m.assertEqual(m.top.textFont, "font:MediumSystemFont")
            m.assertEqual(m.top.textHeight, 32.0)
            m.assertEqual(m.top.iconGap, 12.0)
            m.assertNotInvalid(m.node.background)
            m.assertNotInvalid(m.node.iconPoster)
            m.assertNotInvalid(m.node.textLabel)
            m.assertEqual(m.node.background.uri, "pkg:/images/buttons/fhd/primary-unfocused.9.png")
        end function

        @it("updates text and text-only dimensions")
        function _()
            m.top.text = "Continue"
            m.top.buttonWidth = 240
            m.top.buttonHeight = 64
            m.top.textHeight = 30
            m.top.iconUri = ""

            'bs:disable-next-line 1140
            onTextChanged()
            'bs:disable-next-line 1140
            onDimensionsChanged()

            m.assertEqual(m.node.textLabel.text, "Continue")
            m.assertEqual(m.node.background.width, 240.0)
            m.assertEqual(m.node.background.height, 64.0)
            m.assertEqual(m.node.textLabel.height, 30.0)
            m.assertEqual(m.node.textLabel.width, 240.0)
            m.assertEqual(m.node.textLabel.translation, [0.0, 17.0])
            m.assertEqual(m.node.textLabel.horizAlign, "center")
            m.assertFalse(m.node.iconPoster.visible)
        end function

        @it("uses normal and focused icon URIs")
        function _()
            m.top.iconUri = "pkg:/images/icons/play-light.png"
            m.top.focusedIconUri = "pkg:/images/icons/play-dark.png"
            m.top.hasFocusVisual = false
            'bs:disable-next-line 1140
            onIconUriChanged()
            m.assertTrue(m.node.iconPoster.visible)
            m.assertEqual(m.node.iconPoster.uri, "pkg:/images/icons/play-light.png")

            m.top.hasFocusVisual = true
            'bs:disable-next-line 1140
            onIconUriChanged()
            m.assertEqual(m.node.iconPoster.uri, "pkg:/images/icons/play-dark.png")
            m.assertEqual(m.node.iconPoster.width, 24.0)
            m.assertEqual(m.node.iconPoster.height, 24.0)
        end function

        @it("renders focused and unfocused visual states")
        function _()
            m.top.hasFocusVisual = true
            'bs:disable-next-line 1140
            onFocusVisualChanged()
            m.assertEqual(m.node.background.uri, "pkg:/images/buttons/fhd/primary-focused.9.png")
            m.assertEqual(m.node.textLabel.color, &h0F1A2AFF)

            m.top.hasFocusVisual = false
            'bs:disable-next-line 1140
            onFocusVisualChanged()
            m.assertEqual(m.node.background.uri, "pkg:/images/buttons/fhd/primary-unfocused.9.png")
            m.assertEqual(m.node.textLabel.color, &hFFFFFFFF)
        end function

        @it("normalizes dimensions and handles selection keys")
        function _()
            m.top.buttonWidth = 0
            m.top.buttonHeight = -1
            'bs:disable-next-line 1140
            onDimensionsChanged()
            m.assertEqual(m.node.background.width, 300.0)
            m.assertEqual(m.node.background.height, 56.0)

            m.top.buttonSelected = false
            'bs:disable-next-line 1140
            m.assertFalse(onKeyEvent("OK", false))
            'bs:disable-next-line 1140
            m.assertFalse(onKeyEvent("left", true))
            m.assertFalse(m.top.buttonSelected)
            'bs:disable-next-line 1140
            m.assertTrue(onKeyEvent("OK", true))
            m.assertTrue(m.top.buttonSelected)
        end function

    end class

end namespace
