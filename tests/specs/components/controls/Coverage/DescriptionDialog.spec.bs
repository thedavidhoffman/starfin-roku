namespace tests
    @SGNode("DescriptionDialog")
    @suite("DescriptionDialog component")
    class DescriptionDialogTests extends rooibos.BaseTestSuite
        @describe("DescriptionDialog behavior")
        @it("configures description dialog dimensions and content type")
        function _()
            'bs:disable-next-line 1140
            openDescription()
            m.assertEqual(m.top.dialogWidth, 1320)
            m.assertEqual(m.top.dialogHeight, 850)
            m.assertEqual(m.top.contentComponentName, "DescriptionDialogContent")
        end function
        @it("syncs text into description content")
        function _()
            m.top.text = "Long-form details"
            'bs:disable-next-line 1140
            openDescription()
            content = m.top.callFunc("getContentComponent")
            m.assertNotInvalid(content)
            m.assertEqual(content.text, "Long-form details")
        end function
        @it("opens the dialog")
        function _()
            'bs:disable-next-line 1140
            openDescription()
            m.assertTrue(m.node.dialog.visible)
        end function
    end class
end namespace
