namespace tests
    @SGNode("StatusLabel")
    @suite("StatusLabel component")
    class StatusLabelTests extends rooibos.BaseTestSuite
        @describe("StatusLabel behavior")
        @it("shows a non-empty message")
        function _()
            'bs:disable-next-line 1140
            setMessage("Loading")
            m.assertTrue(m.top.visible)
            m.assertEqual(m.node.label.text, "Loading")
        end function
        @it("clears the current message")
        function _()
            'bs:disable-next-line 1140
            setMessage("Loading")
            'bs:disable-next-line 1140
            clearMessage()
            m.assertFalse(m.top.visible)
            m.assertEqual(m.node.label.text, "")
        end function
        @it("treats an invalid message as empty")
        function _()
            'bs:disable-next-line 1140
            setMessage(invalid)
            m.assertFalse(m.top.visible)
            m.assertEqual(m.node.label.text, "")
        end function
    end class
end namespace
