namespace tests
    @SGNode("TextInput")
    @suite("TextInput component")
    class TextInputTests extends rooibos.BaseTestSuite
        @describe("TextInput behavior")
        @it("applies the primary background theme")
        function _()
            m.assertEqual(m.node.bg.color, Theme.Get().background.primary)
            m.assertEqual(m.node.focusFramePlaceholder.color, Theme.Get().background.primary)
        end function
        @it("renders placeholder text when input is empty")
        function _()
            m.top.placeholder = "Server URL"
            m.top.text = ""
            'bs:disable-next-line 1140
            onTextChanged()
            m.assertEqual(m.node.textLabel.text, "Server URL")
        end function
        @it("renders input text instead of the placeholder")
        function _()
            m.top.placeholder = "Server URL"
            m.top.text = "example.org"
            'bs:disable-next-line 1140
            onTextChanged()
            m.assertEqual(m.node.textLabel.text, "example.org")
        end function
        @it("lays out configured dimensions")
        function _()
            m.top.fieldWidth = 300
            m.top.fieldHeight = 60
            'bs:disable-next-line 1140
            onDimensionsChanged()
            m.assertEqual(m.node.bg.width, 300.0)
            m.assertEqual(m.node.bg.height, 60.0)
            m.assertEqual(m.node.focusFrame.width, 320.0)
            m.assertEqual(m.node.focusFrame.height, 80.0)
        end function
        @it("shows the focus frame for focused visuals")
        function _()
            m.top.hasFocusVisual = true
            'bs:disable-next-line 1140
            onFocusVisualChanged()
            m.assertTrue(m.node.focusFrame.visible)
        end function
        @it("hides the focus frame for unfocused visuals")
        function _()
            m.top.hasFocusVisual = false
            'bs:disable-next-line 1140
            onFocusVisualChanged()
            m.assertFalse(m.node.focusFrame.visible)
        end function
    end class
end namespace
