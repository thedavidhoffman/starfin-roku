namespace tests

    @SGNode("OptionPickerDialog")
    @suite("OptionPickerDialog component")
    class OptionPickerDialogTests extends rooibos.BaseTestSuite

        @describe("OptionPickerDialog behavior")

        @it("uses the configured dialog title")
        function _()
            m.top.dialogTitle = "Audio"
            'bs:disable-next-line 1140
            m.assertEqual(getDialogTitle(), "Audio")
        end function

        @it("falls back to the default dialog title")
        function _()
            m.top.dialogTitle = ""
            'bs:disable-next-line 1140
            m.assertEqual(getDialogTitle(), "Options")
        end function

        @it("counts visible rows from available options")
        function _()
            m.top.options = [{ key: "1", label: "English" }, { key: "2", label: "French" }]
            'bs:disable-next-line 1140
            m.assertEqual(getVisibleRowCount(), 2)
        end function

        @it("bounds visible rows at eight")
        function _()
            m.top.options = [{}, {}, {}, {}, {}, {}, {}, {}, {}]
            'bs:disable-next-line 1140
            m.assertEqual(getVisibleRowCount(), 8)
        end function

        @it("configures dialog geometry and content type")
        function _()
            m.top.options = [{ key: "1", label: "English" }, { key: "2", label: "French" }]
            'bs:disable-next-line 1140
            configureDialog()
            m.assertEqual(m.top.dialogWidth, 720)
            m.assertEqual(m.top.dialogHeight, 312)
            m.assertEqual(m.top.contentComponentName, "OptionPickerContent")
        end function

        @it("opens with synchronized content and focuses the option list")
        function _()
            m.top.options = [{ key: "1", label: "English" }, { key: "2", label: "French" }]
            m.top.selectedKey = "2"

            m.top.callFunc("openOptions")

            'bs:disable-next-line 1140
            content = getOptionsContent()
            m.assertNotInvalid(content)
            m.assertEqual(content.callFunc("getSelectedOption").key, "2")
            m.assertTrue(m.node.dialog.visible)
            m.assertTrue(content.findNode("optionList").hasFocus())
        end function

        @it("publishes whether the final selection changed")
        function _()
            m.top.options = [{ key: "1", label: "English" }, { key: "2", label: "French" }]
            m.top.selectedKey = "1"
            m.top.callFunc("openOptions")
            'bs:disable-next-line 1140
            content = getOptionsContent()
            content.callFunc("configureOptions", { options: m.top.options, selectedKey: "2", allowDefaultSelection: true, emptyText: "", visibleRowCount: 2 })

            'bs:disable-next-line 1140
            onCloseRequested()

            m.assertEqual(m.top.selectedOption.key, "2")
            m.assertTrue(m.top.selectedOptionChanged)
        end function

        @it("closes after selection only when configured")
        function _()
            m.top.options = [{ key: "1", label: "English" }]
            m.top.closeOnSelect = false
            m.top.callFunc("openOptions")

            'bs:disable-next-line 1140
            onContentOptionSelected()
            m.assertTrue(m.node.dialog.visible)

            m.top.closeOnSelect = true
            'bs:disable-next-line 1140
            onContentOptionSelected()
            m.assertFalse(m.node.dialog.visible)
            m.assertTrue(m.top.closeRequested)
        end function

    end class

end namespace
