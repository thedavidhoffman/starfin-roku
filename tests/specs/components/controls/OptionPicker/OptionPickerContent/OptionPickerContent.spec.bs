namespace tests

    @SGNode("OptionPickerContent")
    @suite("OptionPickerContent component")
    class OptionPickerContentTests extends rooibos.BaseTestSuite

        @describe("OptionPickerContent behavior")

        @it("renders configured options")
        function _()
            'bs:disable-next-line 1140
            configureOptions({ options: [{ key: "auto", label: "Auto" }, { key: "off", label: "Off" }], selectedKey: "", allowDefaultSelection: true, emptyText: "", visibleRowCount: 2 })
            m.assertTrue(m.node.optionList.visible)
            m.assertFalse(m.node.emptyLabel.visible)
            m.assertEqual(m.node.optionList.content.getChildCount(), 2)
            m.assertEqual(m.node.optionList.numRows, 2)
        end function

        @it("checks the option matching the selected key")
        function _()
            'bs:disable-next-line 1140
            configureOptions({ options: [{ key: "auto", label: "Auto" }, { key: "off", label: "Off" }], selectedKey: "off", allowDefaultSelection: true, emptyText: "", visibleRowCount: 1 })
            m.assertEqual(m.node.optionList.checkedItem, 1)
            'bs:disable-next-line 1140
            m.assertEqual(getSelectedOption().key, "off")
        end function

        @it("updates the pending selection by index")
        function _()
            'bs:disable-next-line 1140
            configureOptions({ options: [{ key: "auto", label: "Auto" }, { key: "off", label: "Off" }], selectedKey: "off", allowDefaultSelection: true, emptyText: "", visibleRowCount: 1 })
            'bs:disable-next-line 1140
            selectOptionListIndex(0)
            'bs:disable-next-line 1140
            m.assertEqual(getSelectedOption().key, "auto")
        end function

        @it("renders configured empty-state text")
        function _()
            'bs:disable-next-line 1140
            configureOptions({ options: [], selectedKey: "", allowDefaultSelection: true, emptyText: "No tracks", visibleRowCount: 1 })
            m.assertFalse(m.node.optionList.visible)
            m.assertTrue(m.node.emptyLabel.visible)
            m.assertEqual(m.node.emptyLabel.text, "No tracks")
        end function

        @it("does not select a default option when disabled")
        function _()
            'bs:disable-next-line 1140
            configureOptions({ options: [{ key: "auto", label: "Auto" }], selectedKey: "", allowDefaultSelection: false, emptyText: "", visibleRowCount: 1 })
            m.assertEqual(m.node.optionList.checkedItem, -1)
            'bs:disable-next-line 1140
            m.assertInvalid(getSelectedOption())
        end function

        @it("normalizes a non-positive visible row count")
        function _()
            'bs:disable-next-line 1140
            configureOptions({ options: [], selectedKey: "", allowDefaultSelection: true, emptyText: "", visibleRowCount: 0 })
            m.assertEqual(m.node.optionList.numRows, 1)
        end function

    end class

end namespace
