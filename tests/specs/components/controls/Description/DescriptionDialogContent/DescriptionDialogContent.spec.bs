namespace tests

    @SGNode("DescriptionDialogContent")
    @suite("DescriptionDialogContent component")
    class DescriptionDialogContentTests extends rooibos.BaseTestSuite

        @describe("DescriptionDialogContent behavior")

        @it("syncs description text")
        function _()
            m.top.text = "Full description"
            'bs:disable-next-line 1140
            onTextChanged()
            m.assertEqual(m.node.descriptionText.text, "Full description")
        end function

        @it("focuses the description as the first field")
        function _()
            'bs:disable-next-line 1140
            focusFirstField()
            m.assertTrue(m.node.descriptionText.hasFocus())
        end function

        @it("focuses the description as the last field")
        function _()
            'bs:disable-next-line 1140
            focusLastField()
            m.assertTrue(m.node.descriptionText.hasFocus())
        end function

    end class

end namespace
