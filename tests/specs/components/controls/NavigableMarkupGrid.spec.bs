namespace tests

    @SGNode("NavigableMarkupGrid")
    @suite("NavigableMarkupGrid component")
    class NavigableMarkupGridTests extends rooibos.BaseTestSuite

        @describe("NavigableMarkupGrid behavior")

        @it("ignores released down keys")
        function _()
            'bs:disable-next-line 1140
            m.assertFalse(onKeyEvent("down", false))
        end function

        @it("ignores pressed non-down keys")
        function _()
            'bs:disable-next-line 1140
            m.assertFalse(onKeyEvent("up", true))
        end function

        @it("ignores down keys when content is absent")
        function _()
            'bs:disable-next-line 1140
            m.assertFalse(onKeyEvent("down", true))
        end function

    end class

end namespace
