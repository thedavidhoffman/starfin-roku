namespace tests

    @SGNode("Spinner")
    @suite("Spinner component")
    class SpinnerTests extends rooibos.BaseTestSuite

        @describe("Spinner behavior")

        @it("starts immediately when delay is zero")
        function _()
            m.top.showDelay = 0
            'bs:disable-next-line 1140
            startSpinner()
            m.assertTrue(m.top.visible)
            m.assertTrue(m.node.scrim.visible)
            m.assertTrue(m.node.spinner.visible)
        end function

        @it("allows input when interaction blocking is disabled")
        function _()
            m.top.blockInteraction = false
            'bs:disable-next-line 1140
            m.assertFalse(onKeyEvent("back", true))
        end function

        @it("blocks input when interaction blocking is enabled")
        function _()
            m.top.blockInteraction = true
            'bs:disable-next-line 1140
            m.assertTrue(onKeyEvent("back", true))
        end function

        @it("stops and hides the spinner")
        function _()
            m.top.showDelay = 0
            'bs:disable-next-line 1140
            startSpinner()
            'bs:disable-next-line 1140
            stopSpinner()
            m.assertFalse(m.top.visible)
            m.assertFalse(m.node.spinner.visible)
        end function

    end class

end namespace
