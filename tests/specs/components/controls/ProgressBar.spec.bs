namespace tests

    @SGNode("ProgressBar")
    @suite("ProgressBar component")
    class ProgressBarTests extends rooibos.BaseTestSuite

        @describe("ProgressBar behavior")

        @it("lays out the border track and fill height")
        function _()
            m.top.barWidth = 100
            m.top.barHeight = 10
            'bs:disable-next-line 1140
            onLayoutChanged()
            m.assertEqual(m.node.border.width, 102.0)
            m.assertEqual(m.node.border.height, 12.0)
            m.assertEqual(m.node.background.width, 100.0)
            m.assertEqual(m.node.fill.height, 10.0)
        end function

        @it("expands positive progress to the minimum visible width")
        function _()
            m.top.barWidth = 100
            m.top.barHeight = 10
            m.top.progressWidth = 4
            'bs:disable-next-line 1140
            onProgressChanged()
            m.assertEqual(m.node.fill.width, 10.0)
        end function

        @it("clamps progress above the bar width")
        function _()
            m.top.barWidth = 100
            m.top.progressWidth = 200
            'bs:disable-next-line 1140
            onProgressChanged()
            m.assertEqual(m.node.fill.width, 100.0)
        end function

        @it("clamps negative progress to zero")
        function _()
            m.top.progressWidth = -1
            'bs:disable-next-line 1140
            onProgressChanged()
            m.assertEqual(m.node.fill.width, 0.0)
        end function

    end class

end namespace
