namespace tests

    @SGNode("LabelPrimary")
    @suite("LabelPrimary component")
    class LabelPrimaryTests extends rooibos.BaseTestSuite

        @describe("LabelPrimary behavior")
        @it("applies the primary text color")
        function _()
            m.assertEqual(m.top.color, Theme.Get().text.light.primary)
        end function
    end class

end namespace
