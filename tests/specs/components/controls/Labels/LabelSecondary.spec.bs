namespace tests

    @SGNode("LabelSecondary")
    @suite("LabelSecondary component")
    class LabelSecondaryTests extends rooibos.BaseTestSuite

        @describe("LabelSecondary behavior")
        @it("applies the secondary text color")
        function _()
            m.assertEqual(m.top.color, Theme.Get().text.light.secondary)
        end function
    end class

end namespace
