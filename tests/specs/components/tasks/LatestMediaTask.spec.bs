namespace tests

    @SGNode("LatestMediaTask")
    @suite("LatestMediaTask component")
    class LatestMediaTaskTests extends rooibos.BaseTestSuite

        @describe("request validation")

        @it("rejects a missing request")
        function _()
            m.node.top.request = invalid

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "latestMedia")
            m.assertEqual(response.errorMessage, "Invalid request.")
        end function

    end class

end namespace
