namespace tests

    @SGNode("MusicLibraryTask")
    @suite("MusicLibraryTask paging")
    class MusicLibraryTaskLogicTests extends rooibos.BaseTestSuite

        @describe("album payload paging")

        @it("normalizes sorting and evaluates page boundaries")
        function _()
            'bs:disable-next-line 1140
            m.assertEqual(getAlbumSortBy({ albumSortBy: "ProductionYear,SortName" }), "ProductionYear,SortName")
            'bs:disable-next-line 1140
            m.assertEqual(getAlbumSortBy({ albumSortBy: "Unsupported" }), "SortName")
            'bs:disable-next-line 1140
            m.assertEqual(getAlbumSortOrder({ albumSortOrder: "Descending" }), "Descending")
            'bs:disable-next-line 1140
            m.assertTrue(hasMoreAlbumPages({ TotalRecordCount: 101 }, 0, 50, 50))
            'bs:disable-next-line 1140
            m.assertFalse(hasMoreAlbumPages({ TotalRecordCount: 50 }, 0, 50, 50))
            'bs:disable-next-line 1140
            m.assertFalse(hasMoreAlbumPages({ TotalRecordCount: 101 }, 0, 25, 50))
        end function

        @it("extracts array and wrapped item payloads")
        function _()
            values = [{ Id: "1" }]
            'bs:disable-next-line 1140
            m.assertEqual(getItemsFromPayload(values), values)
            'bs:disable-next-line 1140
            m.assertEqual(getItemsFromPayload({ Items: values }), values)
            'bs:disable-next-line 1140
            m.assertEqual(getAlbumTotalRecordCount({ TotalRecordCount: 12 }), 12)
        end function

    end class

end namespace
