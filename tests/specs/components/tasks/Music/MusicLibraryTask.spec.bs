namespace tests

    @SGNode("MusicLibraryTask")
    @suite("MusicLibraryTask component")
    class MusicLibraryTaskTests extends rooibos.BaseTestSuite

        @describe("request validation")

        @it("rejects a missing request")
        function _()
            m.node.top.request = invalid

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "musicLibrary")
            m.assertEqual(response.errorMessage, "Invalid request.")
        end function

        @it("rejects a missing user ID")
        function _()
            m.node.top.request = { server: "server", token: "token", libraryId: "library" }

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "musicLibrary")
            m.assertEqual(response.errorMessage, "Invalid request userId.")
            m.assertEqual(response.libraryId, "library")
            m.assertEqual(response.queryId, 0)
        end function

        @it("rejects a missing library ID")
        function _()
            m.node.top.request = { server: "server", token: "token", userId: "user" }

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "musicLibrary")
            m.assertEqual(response.errorMessage, "Invalid request libraryId.")
            m.assertEqual(response.libraryId, "")
            m.assertEqual(response.queryId, 0)
        end function

        @describe("album payload paging")

        @it("normalizes sorting and evaluates page boundaries")
        function _()
            'bs:disable-next-line 1140
            m.assertEqual(getAlbumSortBy({ albumSortBy: "ProductionYear,SortName" }), "ProductionYear,SortName")
            'bs:disable-next-line 1140
            m.assertEqual(getAlbumSortBy({ albumSortBy: "Unsupported" }), "SortName")
            'bs:disable-next-line 1140
            m.assertEqual(getAlbumSortOrder({ albumSortOrder: "Descending" }), "Descending")
            'bs:disable-next-line 1140
            m.assertTrue(hasMoreAlbumPages({ TotalRecordCount: 101 }, 0, 50, 50))
            'bs:disable-next-line 1140
            m.assertFalse(hasMoreAlbumPages({ TotalRecordCount: 50 }, 0, 50, 50))
            'bs:disable-next-line 1140
            m.assertFalse(hasMoreAlbumPages({ TotalRecordCount: 101 }, 0, 25, 50))
        end function

        @it("extracts array and wrapped item payloads")
        function _()
            values = [{ Id: "1" }]
            'bs:disable-next-line 1140
            m.assertEqual(getItemsFromPayload(values), values)
            'bs:disable-next-line 1140
            m.assertEqual(getItemsFromPayload({ Items: values }), values)
            'bs:disable-next-line 1140
            m.assertEqual(getAlbumTotalRecordCount({ TotalRecordCount: 12 }), 12)
        end function

    end class

end namespace
