namespace tests

    @SGNode("MusicArtistsTask")
    @suite("MusicArtistsTask validation")
    class MusicArtistsTaskCoverageTests extends rooibos.BaseTestSuite

        @describe("request validation")

        @it("rejects an invalid request without performing network work")
        function _()
            m.node.top.request = invalid

            'bs:disable-next-line 1140
            executeRequest()

            m.assertFalse(m.node.top.response.ok)
        end function

    end class

end namespace
