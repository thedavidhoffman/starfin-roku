namespace tests

    @SGNode("MusicArtistsTask")
    @suite("MusicArtistsTask component")
    class MusicArtistsTaskTests extends rooibos.BaseTestSuite

        @describe("request validation")

        @it("rejects an invalid request without performing network work")
        function _()
            m.node.top.request = invalid

            'bs:disable-next-line 1140
            executeRequest()

            m.assertFalse(m.node.top.response.ok)
        end function

        @describe("artist payload extraction")

        @it("extracts artist items and total counts")
        function _()
            artists = [{ Id: "artist-1" }]
            'bs:disable-next-line 1140
            m.assertEqual(getArtistItems({ Items: artists }), artists)
            'bs:disable-next-line 1140
            m.assertEqual(getArtistItems(artists), artists)
            'bs:disable-next-line 1140
            m.assertEqual(getArtistTotalRecordCount({ TotalRecordCount: 8 }), 8)
            'bs:disable-next-line 1140
            m.assertEqual(getArtistTotalRecordCount(invalid), -1)
        end function

    end class

end namespace
