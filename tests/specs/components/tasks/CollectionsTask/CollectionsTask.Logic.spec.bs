namespace tests

    @SGNode("CollectionsTask")
    @suite("CollectionsTask helpers")
    class CollectionsTaskLogicTests extends rooibos.BaseTestSuite

        @describe("collection request options")

        @it("uses defaults and applies explicit collection options")
        function _()
            request = { fields: "", sortBy: "", sortOrder: "", recursive: true, includeItemTypes: "BoxSet" }
            'bs:disable-next-line 1140
            m.assertEqual(getFields(request), "PrimaryImageAspectRatio,SortName,Tags")
            'bs:disable-next-line 1140
            m.assertEqual(getSortBy(request), "IsFolder,SortName")
            'bs:disable-next-line 1140
            m.assertEqual(getSortOrder(request), "Ascending")
            params = {}
            'bs:disable-next-line 1140
            addOptionalQueryParams(params, request)
            m.assertTrue(params.recursive)
            m.assertEqual(params.includeItemTypes, "BoxSet")
        end function

    end class

end namespace
