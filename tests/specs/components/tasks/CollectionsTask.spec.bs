namespace tests

    @SGNode("CollectionsTask")
    @suite("CollectionsTask component")
    class CollectionsTaskTests extends rooibos.BaseTestSuite

        @describe("request validation")

        @it("rejects an invalid request without performing network work")
        function _()
            m.node.top.request = invalid

            'bs:disable-next-line 1140
            executeRequest()

            m.assertFalse(m.node.top.response.ok)
        end function

        @it("accepts a complete request")
        function _()
            request = { server: "server", token: "token", userId: "user", libraryId: "library" }

            'bs:disable-next-line 1140
            m.assertInvalid(validateRequest(request))
        end function

        @describe("collection request options")

        @it("uses defaults and applies explicit collection options")
        function _()
            request = { fields: "", sortBy: "", sortOrder: "", recursive: true, includeItemTypes: "BoxSet" }
            'bs:disable-next-line 1140
            m.assertEqual(getFields(request), "PrimaryImageAspectRatio,SortName,Tags")
            'bs:disable-next-line 1140
            m.assertEqual(getSortBy(request), "IsFolder,SortName")
            'bs:disable-next-line 1140
            m.assertEqual(getSortOrder(request), "Ascending")
            params = {}
            'bs:disable-next-line 1140
            addOptionalQueryParams(params, request)
            m.assertTrue(params.recursive)
            m.assertEqual(params.includeItemTypes, "BoxSet")
        end function

    end class

end namespace
