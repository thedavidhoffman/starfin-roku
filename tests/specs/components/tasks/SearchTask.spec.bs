namespace tests

    @SGNode("SearchTask")
    @suite("SearchTask component")
    class SearchTaskTests extends rooibos.BaseTestSuite

        @describe("request validation")

        @it("rejects a missing request")
        function _()
            m.node.top.request = invalid

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "search")
            m.assertEqual(response.errorMessage, "Invalid request.")
        end function

        @it("rejects a missing user ID")
        function _()
            m.node.top.request = { server: "server", token: "token", query: "title" }

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "search")
            m.assertEqual(response.errorMessage, "Invalid request userId.")
            m.assertEqual(response.query, "title")
        end function

        @it("rejects an empty search term")
        function _()
            m.node.top.request = { server: "server", token: "token", userId: "user", query: "   " }

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "search")
            m.assertEqual(response.errorMessage, "Enter a search term.")
            m.assertEqual(response.query, "")
        end function

        @describe("search payload normalization")

        @it("normalizes payload shapes and correlates failures")
        function _()
            items = [{ Id: "item-1" }]
            'bs:disable-next-line 1140
            m.assertEqual(getPayloadItems(items), items)
            'bs:disable-next-line 1140
            m.assertEqual(getPayloadItems({ Items: items }), items)
            'bs:disable-next-line 1140
            m.assertEqual(getPayloadItems("bad"), [])
            'bs:disable-next-line 1140
            failure = withAction(invalid, { query: "  title  " })
            m.assertEqual(failure.action, "search")
            m.assertEqual(failure.query, "title")
        end function

    end class

end namespace
