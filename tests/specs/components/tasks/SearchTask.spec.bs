namespace tests

    @SGNode("SearchTask")
    @suite("SearchTask component")
    class SearchTaskTests extends rooibos.BaseTestSuite

        @describe("request validation")

        @it("rejects an invalid request without performing network work")
        function _()
            m.node.top.request = invalid

            'bs:disable-next-line 1140
            executeRequest()

            m.assertFalse(m.node.top.response.ok)
        end function

        @it("accepts a complete request")
        function _()
            request = { server: "server", token: "token", userId: "user", query: "title" }

            'bs:disable-next-line 1140
            m.assertInvalid(validateRequest(request))
        end function

        @describe("search payload normalization")

        @it("normalizes payload shapes and correlates failures")
        function _()
            items = [{ Id: "item-1" }]
            'bs:disable-next-line 1140
            m.assertEqual(getPayloadItems(items), items)
            'bs:disable-next-line 1140
            m.assertEqual(getPayloadItems({ Items: items }), items)
            'bs:disable-next-line 1140
            m.assertEqual(getPayloadItems("bad"), [])
            'bs:disable-next-line 1140
            failure = withAction(invalid, { query: "  title  " })
            m.assertEqual(failure.action, "search")
            m.assertEqual(failure.query, "title")
        end function

    end class

end namespace
