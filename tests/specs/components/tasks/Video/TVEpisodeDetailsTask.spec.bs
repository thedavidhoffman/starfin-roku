namespace tests

    @SGNode("TVEpisodeDetailsTask")
    @suite("TVEpisodeDetailsTask component")
    class TVEpisodeDetailsTaskTests extends rooibos.BaseTestSuite

        @describe("request validation")

        @it("rejects a missing request")
        function _()
            m.node.top.request = invalid

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "tvEpisodeDetails")
            m.assertEqual(response.errorMessage, "Invalid request.")
            m.assertEqual(response.requestId, -1)
        end function

        @it("rejects a missing item ID")
        function _()
            m.node.top.request = { server: "server", token: "token" }

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "tvEpisodeDetails")
            m.assertEqual(response.errorMessage, "Invalid request itemId.")
            m.assertEqual(response.itemId, "")
            m.assertEqual(response.requestId, -1)
        end function

        @it("preserves request identity on validation failures")
        function _()
            m.node.top.request = { server: "server", token: "token", requestId: 11 }

            'bs:disable-next-line 1140
            executeRequest()

            m.assertEqual(m.node.top.response.requestId, 11)
        end function

        @describe("series playback queue")

        @it("preserves per-episode season identity across season boundaries")
        function _()
            episodes = [
                { Id: "s2e9", Type: "Episode", SeasonId: "season-2", SeasonName: "Season 2", ParentIndexNumber: 2, IndexNumber: 9 }
                { Id: "s2e10", Type: "Episode", SeasonId: "season-2", SeasonName: "Season 2", ParentIndexNumber: 2, IndexNumber: 10 }
                { Id: "s3e1", Type: "Episode", SeasonId: "season-3", SeasonName: "Season 3", ParentIndexNumber: 3, IndexNumber: 1 }
            ]

            'bs:disable-next-line 1140
            queue = buildPlaybackQueueItems(episodes)

            m.assertEqual(queue.Count(), 3)
            m.assertEqual(queue[1].itemId, "s2e10")
            m.assertEqual(queue[1].season.Id, "season-2")
            m.assertEqual(queue[2].itemId, "s3e1")
            m.assertEqual(queue[2].season.Id, "season-3")
            m.assertEqual(queue[2].season.Name, "Season 3")
            'bs:disable-next-line 1140
            m.assertEqual(getPlaybackQueueIndex(queue, "s3e1"), 2)
        end function

        @it("filters invalid queue entries and preserves resume ticks")
        function _()
            episodes = [
                { Id: "episode-1", SeasonId: "season-1", UserData: { PlaybackPositionTicks: 75 } }
                { Name: "missing id" }
            ]
            'bs:disable-next-line 1140
            queue = buildPlaybackQueueItems(episodes)
            m.assertEqual(queue.Count(), 1)
            m.assertEqual(queue[0].startPositionTicks, 75&)
            'bs:disable-next-line 1140
            m.assertEqual(getPlaybackQueueIndex(queue, "missing"), 0)
        end function

        @it("derives season names")
        function _()
            'bs:disable-next-line 1140
            season = buildSeasonIdentity({ ParentIndexNumber: 4 }, "season-4")
            m.assertEqual(season.Id, "season-4")
            m.assertEqual(season.Name, "Season 4")
        end function

    end class

end namespace
