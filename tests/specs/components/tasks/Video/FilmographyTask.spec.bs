namespace tests

    @SGNode("FilmographyTask")
    @suite("FilmographyTask component")
    class FilmographyTaskTests extends rooibos.BaseTestSuite

        @describe("request validation")

        @it("rejects an invalid request without performing network work")
        function _()
            m.node.top.request = invalid

            'bs:disable-next-line 1140
            executeRequest()

            m.assertFalse(m.node.top.response.ok)
        end function

        @it("accepts a complete request")
        function _()
            request = { personId: "person", apiKey: "key" }

            'bs:disable-next-line 1140
            m.assertInvalid(validateRequest(request))
        end function

        @describe("credit transformation")

        @it("filters incomplete credits and sorts newest first")
        function _()
            payload = { cast: [
                { title: "Older", release_date: "2020-01-01", vote_average: 7 }
                { name: "Newer", first_air_date: "2024-02-02", vote_average: 8 }
                { title: "Missing date" }
            ] }
            'bs:disable-next-line 1140
            items = buildFilmographyItems(payload)
            m.assertEqual(items.Count(), 2)
            m.assertEqual(items[0].title, "Newer")
            m.assertEqual(items[0].release_date, "2024")
            m.assertEqual(items[1].title, "Older")
        end function

    end class

end namespace
