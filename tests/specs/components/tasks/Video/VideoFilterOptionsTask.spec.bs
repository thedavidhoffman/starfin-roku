namespace tests

    @SGNode("VideoFilterOptionsTask")
    @suite("VideoFilterOptionsTask component")
    class VideoFilterOptionsTaskTests extends rooibos.BaseTestSuite

        @describe("request validation")

        @it("rejects an invalid request without performing network work")
        function _()
            m.node.top.request = invalid

            'bs:disable-next-line 1140
            executeRequest()

            m.assertFalse(m.node.top.response.ok)
        end function

        @describe("filter option construction")

        @it("handles invalid data and builds sorted filter options")
        function _()
            'bs:disable-next-line 1140
            m.assertEqual(buildFilterOptions(invalid), { decadeOptions: [], genreOptions: [] })
            'bs:disable-next-line 1140
            result = buildFilterOptions({ Years: [1988, 1981], Genres: ["Drama", "Comedy"] })
            m.assertEqual(result.decadeOptions.Count(), 1)
            m.assertEqual(result.decadeOptions[0].value, 1980)
            m.assertEqual(result.genreOptions[0].value, "Comedy")
        end function

    end class

end namespace
