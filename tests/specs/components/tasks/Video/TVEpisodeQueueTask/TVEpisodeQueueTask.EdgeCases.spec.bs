namespace tests

    @SGNode("TVEpisodeQueueTask")
    @suite("TVEpisodeQueueTask edge cases")
    class TVEpisodeQueueTaskEdgeCaseTests extends rooibos.BaseTestSuite

        @describe("response normalization")

        @it("ignores malformed adjacent items")
        function _()
            episodes = [
                { SeriesId: "series" }
                { Id: "anchor", SeriesId: "series" }
                { Id: "next", SeriesId: "series" }
            ]

            'bs:disable-next-line 1140
            response = buildAdjacentResponse(episodes, "anchor")

            m.assertTrue(response.ok)
            m.assertEqual(response.payload.predecessors.Count(), 0)
            m.assertEqual(response.payload.successors.Count(), 1)
        end function

        @it("rejects a forward response without its anchor")
        function _()
            'bs:disable-next-line 1140
            response = buildForwardResponse([{ Id: "next" }], "anchor", 1)

            m.assertFalse(response.ok)
        end function

        @it("copies all correlation identity onto a response")
        function _()
            request = {
                operation: "forward"
                anchorItemId: "anchor"
                seriesId: "series"
                playbackRequestId: 12
                taskRequestId: 34
            }

            'bs:disable-next-line 1140
            response = addResponseIdentity({ ok: true }, request)

            m.assertEqual(response.operation, "forward")
            m.assertEqual(response.anchorItemId, "anchor")
            m.assertEqual(response.seriesId, "series")
            m.assertEqual(response.playbackRequestId, 12)
            m.assertEqual(response.taskRequestId, 34)
        end function

    end class

end namespace
