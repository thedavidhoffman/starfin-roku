namespace tests

    @SGNode("TVEpisodeQueueTask")
    @suite("TVEpisodeQueueTask queue resolution")
    class TVEpisodeQueueTaskLogicTests extends rooibos.BaseTestSuite

        @describe("adjacent episode resolution")

        @it("resolves both sides of a season boundary")
        function _()
            episodes = [
                { Id: "s2e21", SeriesId: "series", SeasonId: "s2" }
                { Id: "s3e1", SeriesId: "series", SeasonId: "s3" }
                { Id: "s3e2", SeriesId: "series", SeasonId: "s3" }
            ]

            'bs:disable-next-line 1140
            response = buildAdjacentResponse(episodes, "s3e1")

            m.assertTrue(response.ok)
            m.assertEqual(response.payload.predecessors[0].itemId, "s2e21")
            m.assertEqual(response.payload.successors[0].itemId, "s3e2")
            m.assertFalse(response.payload.reachedSeriesStart)
            m.assertFalse(response.payload.reachedSeriesEnd)
        end function

        @it("reports the beginning and end of a series")
        function _()
            episodes = [{ Id: "only", SeriesId: "series", SeasonId: "s1" }]

            'bs:disable-next-line 1140
            response = buildAdjacentResponse(episodes, "only")

            m.assertTrue(response.payload.reachedSeriesStart)
            m.assertTrue(response.payload.reachedSeriesEnd)
        end function

        @it("rejects a response that omits the anchor")
        function _()
            'bs:disable-next-line 1140
            response = buildAdjacentResponse([{ Id: "other" }], "anchor")

            m.assertFalse(response.ok)
        end function

        @describe("forward episode resolution")

        @it("returns successors and detects a short terminal page")
        function _()
            episodes = [{ Id: "anchor" }, { Id: "next" }]

            'bs:disable-next-line 1140
            response = buildForwardResponse(episodes, "anchor", 3)

            m.assertEqual(response.payload.successors.Count(), 1)
            m.assertEqual(response.payload.successors[0].itemId, "next")
            m.assertTrue(response.payload.reachedSeriesEnd)
        end function

        @it("does not mark a full page as terminal")
        function _()
            episodes = [{ Id: "anchor" }, { Id: "one" }, { Id: "two" }]

            'bs:disable-next-line 1140
            response = buildForwardResponse(episodes, "anchor", 2)

            m.assertFalse(response.payload.reachedSeriesEnd)
        end function

    end class

end namespace
