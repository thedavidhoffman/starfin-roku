namespace tests

    @SGNode("TrickplayPreloadTask")
    @suite("TrickplayPreloadTask helpers")
    class TrickplayPreloadTaskCoverageTests extends rooibos.BaseTestSuite

        @describe("trickplay URI construction")

        @it("builds encoded remote and stable local tile URIs")
        function _()
            request = { server: "http://server", token: "a b", itemId: "item-1", tileWidth: 320, tileCount: 3 }

            'bs:disable-next-line 1140
            m.assertEqual(getRemoteTrickplayUrl(request, 2), "http://server/Videos/item-1/Trickplay/320/2.jpg?ApiKey=a%20b")
            'bs:disable-next-line 1140
            m.assertEqual(getLocalTrickplayUri(request, 2), "tmp:/starfin-trickplay-item-1-320-2.jpg")
            'bs:disable-next-line 1140
            m.assertEqual(getTileCount(request), 3)
        end function

        @it("rejects incomplete tile requests")
        function _()
            'bs:disable-next-line 1140
            m.assertEqual(getRemoteTrickplayUrl({ server: "", token: "", itemId: "", tileWidth: 0 }, 0), "")
            'bs:disable-next-line 1140
            m.assertEqual(getTileCount(invalid), 0)
            'bs:disable-next-line 1140
            m.assertEqual(getTileWidth(invalid), 0)
        end function

    end class

end namespace
