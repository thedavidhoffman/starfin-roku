namespace tests

    @SGNode("TVShowRandomPlaybackTask")
    @suite("TVShowRandomPlaybackTask component")
    class TVShowRandomPlaybackTaskTests extends rooibos.BaseTestSuite

        @describe("request validation")

        @it("rejects a missing request")
        function _()
            m.node.top.request = invalid

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "tvShowRandomPlayback")
            m.assertEqual(response.errorMessage, "Invalid request.")
        end function

        @it("rejects a missing user ID")
        function _()
            m.node.top.request = { server: "server", token: "token", itemId: "series" }

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "tvShowRandomPlayback")
            m.assertEqual(response.errorMessage, "Invalid request userId.")
            m.assertEqual(response.itemId, "series")
        end function

        @it("rejects a missing item ID")
        function _()
            m.node.top.request = { server: "server", token: "token", userId: "user" }

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "tvShowRandomPlayback")
            m.assertEqual(response.errorMessage, "Invalid request itemId.")
            m.assertEqual(response.itemId, "")
        end function

        @describe("random playback queue construction")

        @it("builds queue entries with per-episode season identity")
        function _()
            episodes = [
                { Id: "e1", SeasonId: "s1", SeasonName: "Specials", UserData: { PlaybackPositionTicks: 25 } }
                { Id: "e2", ParentId: "s2", ParentIndexNumber: 2 }
                { Name: "invalid" }
            ]
            'bs:disable-next-line 1140
            queue = buildPlaybackQueue(episodes)
            m.assertEqual(queue.Count(), 2)
            m.assertEqual(queue[0].season.Name, "Specials")
            m.assertEqual(queue[1].season.Id, "s2")
            m.assertEqual(queue[1].season.Name, "Season 2")
        end function

    end class

end namespace
