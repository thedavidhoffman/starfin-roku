namespace tests

    @SGNode("ThemeSongsTask")
    @suite("ThemeSongsTask component")
    class ThemeSongsTaskTests extends rooibos.BaseTestSuite

        @describe("request validation")

        @it("rejects an invalid request without performing network work")
        function _()
            m.node.top.request = invalid

            'bs:disable-next-line 1140
            executeRequest()

            m.assertFalse(m.node.top.response.ok)
        end function

        @it("accepts a complete request")
        function _()
            request = { server: "server", token: "token", itemId: "item" }

            'bs:disable-next-line 1140
            m.assertInvalid(validateRequest(request))
        end function

        @describe("theme song selection")

        @it("selects the first valid theme song")
        function _()
            songs = [invalid, "not-an-item", { Id: "song-1" }, { Id: "song-2" }]
            'bs:disable-next-line 1140
            selected = getFirstThemeSongFromItems(songs)
            m.assertEqual(selected.Id, "song-1")
            'bs:disable-next-line 1140
            m.assertEqual(getThemeSongId(selected), "song-1")
            'bs:disable-next-line 1140
            m.assertInvalid(getFirstThemeSongFromItems([]))
        end function

    end class

end namespace
