namespace tests

    @SGNode("ThemeSongsTask")
    @suite("ThemeSongsTask component")
    class ThemeSongsTaskTests extends rooibos.BaseTestSuite

        @describe("request validation")

        @it("rejects a missing request")
        function _()
            m.node.top.request = invalid

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "themeSongs")
            m.assertEqual(response.errorMessage, "Invalid request.")
        end function

        @it("rejects a missing item ID")
        function _()
            m.node.top.request = { server: "server", token: "token" }

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "themeSongs")
            m.assertEqual(response.errorMessage, "Invalid request itemId.")
        end function

        @describe("theme song selection")

        @it("selects the first valid theme song")
        function _()
            songs = [invalid, "not-an-item", { Id: "song-1" }, { Id: "song-2" }]
            'bs:disable-next-line 1140
            selected = getFirstThemeSongFromItems(songs)
            m.assertEqual(selected.Id, "song-1")
            'bs:disable-next-line 1140
            m.assertEqual(getThemeSongId(selected), "song-1")
            'bs:disable-next-line 1140
            m.assertInvalid(getFirstThemeSongFromItems([]))
        end function

    end class

end namespace
