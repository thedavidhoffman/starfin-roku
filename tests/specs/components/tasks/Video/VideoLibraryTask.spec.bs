namespace tests

    @SGNode("VideoLibraryTask")
    @suite("VideoLibraryTask component")
    class VideoLibraryTaskTests extends rooibos.BaseTestSuite

        @describe("request validation")

        @it("rejects a missing request")
        function _()
            m.node.top.request = invalid

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "videoLibrary")
            m.assertEqual(response.errorMessage, "Invalid request.")
        end function

        @it("rejects a missing user ID")
        function _()
            m.node.top.request = { server: "server", token: "token", libraryId: "library" }

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "videoLibrary")
            m.assertEqual(response.errorMessage, "Invalid request userId.")
            m.assertEqual(response.libraryId, "library")
        end function

        @it("rejects a missing library ID")
        function _()
            m.node.top.request = { server: "server", token: "token", userId: "user" }

            'bs:disable-next-line 1140
            executeRequest()

            response = m.node.top.response
            m.assertFalse(response.ok)
            m.assertEqual(response.action, "videoLibrary")
            m.assertEqual(response.errorMessage, "Invalid request libraryId.")
            m.assertEqual(response.libraryId, "")
        end function

        @describe("non-alphabetic requests")

        @it("routes hash buckets through the synthetic non-alphabetic path")
        function _()
            'bs:disable-next-line 1140
            movieMode = getVideoLibraryRequestMode({ collectionType: "movies" }, "#")
            'bs:disable-next-line 1140
            tvMode = getVideoLibraryRequestMode({ collectionType: "tvshows" }, "#")
            'bs:disable-next-line 1140
            titleMode = getVideoLibraryRequestMode({ collectionType: "movies" }, "A")

            m.assertEqual(movieMode, "nonAlphabetic")
            m.assertEqual(tvMode, "nonAlphabetic")
            m.assertEqual(titleMode, "items")
        end function

        @it("calculates paging from page size and total count")
        function _()
            'bs:disable-next-line 1140
            m.assertTrue(hasMorePages({ TotalRecordCount: 250 }, 100, 100, 100))
            'bs:disable-next-line 1140
            m.assertFalse(hasMorePages({ TotalRecordCount: 200 }, 100, 100, 100))
            'bs:disable-next-line 1140
            m.assertFalse(hasMorePages({ TotalRecordCount: 250 }, 100, 50, 100))
            'bs:disable-next-line 1140
            m.assertEqual(getTotalRecordCount({ TotalRecordCount: 250 }), 250)
        end function

        @it("builds deduplicated library filters with year fallback")
        function _()
            items = [
                { ProductionYear: 1995, Genres: ["Drama", "Comedy"] }
                { PremiereDate: "1999-01-01", Genres: ["drama", "Action"] }
                { ProductionYear: 2001, Genres: [] }
            ]
            'bs:disable-next-line 1140
            options = buildFilterOptions(items)
            m.assertEqual(options.decadeOptions.Count(), 2)
            m.assertEqual(options.decadeOptions[0].value, 1990)
            m.assertEqual(options.decadeOptions[1].value, 2000)
            m.assertEqual(options.genreOptions.Count(), 3)
            'bs:disable-next-line 1140
            m.assertEqual(getItemVideoLibraryYear(items[1]), 1999)
        end function

        @it("sorts synthetic non-alphabetic pages in both directions")
        function _()
            items = [{ Name: "Zulu" }, { Name: "Alpha" }, { Name: "Middle" }]
            'bs:disable-next-line 1140
            ascending = sortNonAlphabeticItems(items, "SortName", "Ascending")
            m.assertEqual(ascending[0].Name, "Alpha")
            'bs:disable-next-line 1140
            descending = sortNonAlphabeticItems(items, "SortName", "Descending")
            m.assertEqual(descending[0].Name, "Zulu")
        end function

    end class

end namespace
