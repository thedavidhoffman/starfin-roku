namespace tests

    @SGNode("VideoLibraryTask")
    @suite("VideoLibraryTask component")
    class VideoLibraryTaskTests extends rooibos.BaseTestSuite

        @describe("non-alphabetic requests")

        @it("routes hash buckets through the synthetic non-alphabetic path")
        function _()
            'bs:disable-next-line 1140
            movieMode = getVideoLibraryRequestMode({ collectionType: "movies" }, "#")
            'bs:disable-next-line 1140
            tvMode = getVideoLibraryRequestMode({ collectionType: "tvshows" }, "#")
            'bs:disable-next-line 1140
            titleMode = getVideoLibraryRequestMode({ collectionType: "movies" }, "A")

            m.assertEqual(movieMode, "nonAlphabetic")
            m.assertEqual(tvMode, "nonAlphabetic")
            m.assertEqual(titleMode, "items")
        end function

    end class

end namespace
