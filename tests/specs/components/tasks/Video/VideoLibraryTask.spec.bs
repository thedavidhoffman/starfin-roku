namespace tests

    @SGNode("VideoLibraryTask")
    @suite("VideoLibraryTask component")
    class VideoLibraryTaskTests extends rooibos.BaseTestSuite

        @describe("non-alphabetic requests")

        @it("keeps the synthetic non-alphabetic page response")
        function _()
            response = {
                ok: true
                data: {
                    Items: [{ Id: "symbol-title" }]
                    TotalRecordCount: 1
                }
            }
            'bs:disable-next-line 1140
            m.stubCall(loadNonAlphabeticPage({}, {}, 0, 100), response)
            m.node.top.request = {
                server: "http://server"
                token: "token"
                userId: "user-1"
                libraryId: "library-1"
                collectionType: "movies"
                includeItemTypes: "Movie"
                startsWith: "#"
                pageStartIndex: 0
                queryId: 4
            }

            'bs:disable-next-line 1140
            executeRequest()

            m.assertTrue(m.node.top.response.ok)
            m.assertEqual(m.node.top.response.payload.Items[0].Id, "symbol-title")
            m.assertEqual(m.node.top.response.totalRecordCount, 1)
            m.assertEqual(m.node.top.response.queryId, 4)
        end function

    end class

end namespace
