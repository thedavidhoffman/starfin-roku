namespace tests

    @SGNode("WatchedTask")
    @suite("WatchedTask component")
    class WatchedTaskTests extends rooibos.BaseTestSuite

        @describe("request validation")

        @it("rejects an invalid request without performing network work")
        function _()
            m.node.top.request = invalid

            'bs:disable-next-line 1140
            executeRequest()

            m.assertFalse(m.node.top.response.ok)
        end function

        @it("accepts a complete request")
        function _()
            request = { action: "MarkAsWatched", server: "server", token: "token", userId: "user", itemId: "item" }

            'bs:disable-next-line 1140
            m.assertInvalid(validateRequest(request))
        end function

    end class

end namespace
