namespace tests

    @SGNode("ThemeSongsTask")
    @suite("ThemeSongsTask payload selection")
    class ThemeSongsTaskLogicTests extends rooibos.BaseTestSuite

        @describe("theme song selection")

        @it("selects the first valid theme song")
        function _()
            songs = [invalid, "not-an-item", { Id: "song-1" }, { Id: "song-2" }]
            'bs:disable-next-line 1140
            selected = getFirstThemeSongFromItems(songs)
            m.assertEqual(selected.Id, "song-1")
            'bs:disable-next-line 1140
            m.assertEqual(getThemeSongId(selected), "song-1")
            'bs:disable-next-line 1140
            m.assertInvalid(getFirstThemeSongFromItems([]))
        end function

    end class

end namespace
