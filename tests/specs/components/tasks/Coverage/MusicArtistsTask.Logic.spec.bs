namespace tests

    @SGNode("MusicArtistsTask")
    @suite("MusicArtistsTask payloads")
    class MusicArtistsTaskLogicTests extends rooibos.BaseTestSuite

        @describe("artist payload extraction")

        @it("extracts artist items and total counts")
        function _()
            artists = [{ Id: "artist-1" }]
            'bs:disable-next-line 1140
            m.assertEqual(getArtistItems({ Items: artists }), artists)
            'bs:disable-next-line 1140
            m.assertEqual(getArtistItems(artists), artists)
            'bs:disable-next-line 1140
            m.assertEqual(getArtistTotalRecordCount({ TotalRecordCount: 8 }), 8)
            'bs:disable-next-line 1140
            m.assertEqual(getArtistTotalRecordCount(invalid), -1)
        end function

    end class

end namespace

