namespace tests

    @SGNode("VideoPlaybackInfoTask")
    @suite("VideoPlaybackInfoTask helper policies")
    class VideoPlaybackInfoTaskLogicTests extends rooibos.BaseTestSuite

        @describe("playback request policy")

        @it("selects playback flags for automatic and forced modes")
        function _()
            'bs:disable-next-line 1140
            automatic = getPlaybackFlags("automatic", false, false, false)
            m.assertTrue(automatic.enableDirectPlay)
            m.assertTrue(automatic.enableDirectStream)
            m.assertTrue(automatic.enableTranscoding)
            'bs:disable-next-line 1140
            forced = getPlaybackFlags("automatic", true, false, false)
            m.assertFalse(forced.enableDirectPlay)
            m.assertFalse(forced.enableDirectStream)
            m.assertTrue(forced.enableTranscoding)
            'bs:disable-next-line 1140
            noRemux = getPlaybackFlags("transcode-no-remux", false, false, false)
            m.assertFalse(noRemux.enableDirectPlay)
            m.assertFalse(noRemux.enableDirectStream)
        end function

        @it("resolves stream indexes and defaults")
        function _()
            streams = [
                { Type: "Video", Index: 0, IsDefault: true }
                { Type: "Audio", Index: 3, IsDefault: false }
                { Type: "Audio", Index: 4, IsDefault: true }
            ]
            source = { MediaStreams: streams }
            'bs:disable-next-line 1140
            m.assertEqual(getDefaultAudioStreamIndex(source), 4)
            'bs:disable-next-line 1140
            m.assertEqual(getDefaultVideoStreamIndex(source), 0)
            'bs:disable-next-line 1140
            m.assertEqual(getResolvedAudioStreamIndex(source, 3), 3)
            'bs:disable-next-line 1140
            m.assertEqual(getMediaStreamByIndex(source, "audio", 4).Index, 4)
        end function

        @it("constructs server routes and masks sensitive query values")
        function _()
            'bs:disable-next-line 1140
            m.assertEqual(buildServerUrl("http://server", "/Videos/1/stream"), "http://server/Videos/1/stream")
            'bs:disable-next-line 1140
            m.assertEqual(getAbsoluteUrlRoutePath("https://media.example:8096/Videos/1/file.mkv?x=1"), "/Videos/1/file.mkv?x=1")
            'bs:disable-next-line 1140
            masked = maskUrl("http://server/video?api_key=secret&MediaSourceId=source-1")
            m.assertFalse(Instr(1, masked, "secret") > 0)
            m.assertTrue(Instr(1, masked, "source-1") > 0)
        end function

        @it("correlates validation failures and normalizes request values")
        function _()
            'bs:disable-next-line 1140
            m.assertEqual(getPlaybackRequestId({ requestId: 12 }), 12)
            'bs:disable-next-line 1140
            m.assertEqual(getPlaybackRequestId(invalid), -1)
            'bs:disable-next-line 1140
            m.assertEqual(getStartPositionTicks({ startPositionTicks: 55 }), 55&)
            'bs:disable-next-line 1140
            m.assertEqual(getStreamFormat("matroska"), "matroska")
            'bs:disable-next-line 1140
            m.assertEqual(getStreamFormat("mov"), "mp4")
        end function

    end class

end namespace
