namespace tests

    @SGNode("TVNextSeasonPlaybackTask")
    @suite("TVNextSeasonPlaybackTask queue selection")
    class TVNextSeasonPlaybackTaskLogicTests extends rooibos.BaseTestSuite

        @describe("next-season queue construction")

        @it("skips invalid seasons and builds resumable episode queues")
        function _()
            seasons = [{ Id: "s1" }, invalid, { Id: "s2", Name: "Season 2" }]
            'bs:disable-next-line 1140
            nextSeason = getNextSeason(seasons, "s1")
            m.assertEqual(nextSeason.Id, "s2")
            episodes = [{ Id: "e1", UserData: { PlaybackPositionTicks: 50 } }, {}, invalid]
            'bs:disable-next-line 1140
            queue = buildPlaybackQueue(episodes, nextSeason)
            m.assertEqual(queue.Count(), 1)
            m.assertEqual(queue[0].itemId, "e1")
            m.assertEqual(queue[0].season.Id, "s2")
            m.assertEqual(queue[0].startPositionTicks, 50&)
        end function

    end class

end namespace
