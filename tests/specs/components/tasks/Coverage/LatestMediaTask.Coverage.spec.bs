namespace tests

    @SGNode("LatestMediaTask")
    @suite("LatestMediaTask validation")
    class LatestMediaTaskCoverageTests extends rooibos.BaseTestSuite

        @describe("request validation")

        @it("rejects an invalid request without performing network work")
        function _()
            m.node.top.request = invalid

            'bs:disable-next-line 1140
            executeRequest()

            m.assertFalse(m.node.top.response.ok)
        end function


        @it("accepts a complete request")
        function _()
            request = { server: "server", token: "token" }

            'bs:disable-next-line 1140
            m.assertInvalid(validateRequest(request, "latestMedia"))
        end function
    end class

end namespace
