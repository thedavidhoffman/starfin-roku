        function _()
            m.assertNotInvalid(m.top.findNode("gradientBg"))
        end function

        @it("declares the login node")
        function _()
            m.assertNotInvalid(m.top.findNode("login"))
        end function

        @it("declares the authenticatedContent node")
        function _()
            m.assertNotInvalid(m.top.findNode("authenticatedContent"))
        end function

        @it("declares the homePage node")
        function _()
            m.assertNotInvalid(m.top.findNode("homePage"))
        end function

        @it("declares the dynamicPageHost node")
        function _()
            m.assertNotInvalid(m.top.findNode("dynamicPageHost"))
        end function

        @it("declares the themeAudioController node")
        function _()
            m.assertNotInvalid(m.top.findNode("themeAudioController"))
