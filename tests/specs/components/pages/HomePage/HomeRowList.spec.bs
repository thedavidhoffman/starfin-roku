namespace tests

    @SGNode("HomeRowList")
    @suite("HomeRowList component")
    class HomeRowListTests extends rooibos.BaseTestSuite

        @describe("declarative component contract")

        @it("initializes the component")
        function _()
            m.assertNotInvalid(m.top)
        end function

        @describe("keyboard navigation")

        @it("emits focus exit up when upward exit is available")
        function _()
            m.top.canFocusExitUp = true

            'bs:disable-next-line 1140
            handled = onKeyEvent("up", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.focusExitUp)
        end function

        @it("does not handle Up when upward exit is unavailable")
        function _()
            m.top.canFocusExitUp = false

            'bs:disable-next-line 1140
            handled = onKeyEvent("up", true)

            m.assertFalse(handled)
        end function

        @it("emits focus exit down when downward exit is available")
        function _()
            m.top.canFocusExitDown = true

            'bs:disable-next-line 1140
            handled = onKeyEvent("down", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.focusExitDown)
        end function

        @it("does not handle Down when downward exit is unavailable")
        function _()
            m.top.canFocusExitDown = false

            'bs:disable-next-line 1140
            handled = onKeyEvent("down", true)

            m.assertFalse(handled)
        end function

        @it("ignores released keys")
        function _()
            m.top.canFocusExitUp = true
            m.top.focusExitUp = false

            'bs:disable-next-line 1140
            handled = onKeyEvent("up", false)

            m.assertFalse(handled)
            m.assertFalse(m.top.focusExitUp)
        end function

        @it("ignores unrelated pressed keys")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("left", true)

            m.assertFalse(handled)
        end function
    end class

end namespace
