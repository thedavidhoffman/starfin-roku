namespace tests

    @SGNode("HomePage")
    @suite("HomePage component")
    class HomePageTests extends rooibos.BaseTestSuite

        @describe("declarative component contract")

        @it("declares the contentGroup node")
        function _()
            m.assertNotInvalid(m.top.findNode("contentGroup"))
        end function

        @it("declares the shelfViewport node")
        function _()
            m.assertNotInvalid(m.top.findNode("shelfViewport"))
        end function

        @it("declares the shelvesGroup node")
        function _()
            m.assertNotInvalid(m.top.findNode("shelvesGroup"))
        end function

        @it("declares the shelvesAnimation node")
        function _()
            m.assertNotInvalid(m.top.findNode("shelvesAnimation"))
        end function

        @it("declares the shelvesTranslation node")
        function _()
            m.assertNotInvalid(m.top.findNode("shelvesTranslation"))
        end function

        @it("declares the librariesTask node")
        function _()
            m.assertNotInvalid(m.top.findNode("librariesTask"))
        end function

        @it("declares the continueWatchingTask node")
        function _()
            m.assertNotInvalid(m.top.findNode("continueWatchingTask"))
        end function

        @it("declares the continueListeningTask node")
        function _()
            m.assertNotInvalid(m.top.findNode("continueListeningTask"))
        end function

        @it("declares the nextUpTask node")
        function _()
            m.assertNotInvalid(m.top.findNode("nextUpTask"))
        end function

        @it("declares the latestMediaTask node")
        function _()
            m.assertNotInvalid(m.top.findNode("latestMediaTask"))
        end function

        @it("declares the liveTvOnNowTask node")
        function _()
            m.assertNotInvalid(m.top.findNode("liveTvOnNowTask"))
        end function

    end class

end namespace
