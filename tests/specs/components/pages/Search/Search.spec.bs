namespace tests

    @SGNode("Search")
    @suite("Search component")
    class SearchTests extends rooibos.BaseTestSuite

        @describe("declarative component contract")

        @it("declares the keyboard node")
        function _()
            m.assertNotInvalid(m.top.findNode("keyboard"))
        end function

        @it("declares the searchButton node")
        function _()
            m.assertNotInvalid(m.top.findNode("searchButton"))
        end function

        @it("declares the helpLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("helpLabel"))
        end function

        @it("declares the resultsViewport node")
        function _()
            m.assertNotInvalid(m.top.findNode("resultsViewport"))
        end function

        @it("declares the resultsGroup node")
        function _()
            m.assertNotInvalid(m.top.findNode("resultsGroup"))
        end function

        @it("declares the searchTask node")
        function _()
            m.assertNotInvalid(m.top.findNode("searchTask"))
        end function

    end class

end namespace
