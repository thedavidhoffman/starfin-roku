namespace tests
    @SGNode("PlaylistPlaybackControls")
    @suite("PlaylistPlaybackControls component")
    class PlaylistPlaybackControlsTests extends rooibos.BaseTestSuite
        @describe("declarative component contract")
        @it("declares the playlistPlaybackButtons node")
        function _()
            m.assertNotInvalid(m.top.findNode("playlistPlaybackButtons"))
        end function
        @it("declares the playlistResumeButton node")
        function _()
            m.assertNotInvalid(m.top.findNode("playlistResumeButton"))
        end function
        @it("declares the playlistPlayButton node")
        function _()
            m.assertNotInvalid(m.top.findNode("playlistPlayButton"))
        end function
        @it("declares the playlistRandomButton node")
        function _()
            m.assertNotInvalid(m.top.findNode("playlistRandomButton"))
        end function
        @it("declares the singlePlaylistOpenTimer node")
        function _()
            m.assertNotInvalid(m.top.findNode("singlePlaylistOpenTimer"))
        end function
    end class
end namespace
