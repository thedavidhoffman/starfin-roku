namespace tests

    @SGNode("AudioTrackListItem")
    @suite("AudioTrackListItem component")
    class AudioTrackListItemTests extends rooibos.BaseTestSuite

        @describe("declarative component contract")

        @it("declares the background node")
        function _()
            m.assertNotInvalid(m.top.findNode("background"))
        end function

        @it("declares the numberLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("numberLabel"))
        end function

        @it("declares the titleLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("titleLabel"))
        end function

        @it("declares the durationLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("durationLabel"))
        end function

        @describe("track rendering")

        @it("renders the track number")
        function _()
            m.top.itemContent = m.createTrack("4", "Song", "3:21", false)

            m.assertEqual(m.top.findNode("numberLabel").text, "4")
        end function

        @it("renders the track title")
        function _()
            m.top.itemContent = m.createTrack("4", "Song", "3:21", false)

            m.assertEqual(m.top.findNode("titleLabel").text, "Song")
        end function

        @it("uses the untitled track fallback")
        function _()
            m.top.itemContent = m.createTrack("", "", "", false)

            m.assertEqual(m.top.findNode("titleLabel").text, "Untitled Track")
        end function

        @it("renders the track duration")
        function _()
            m.top.itemContent = m.createTrack("4", "Song", "3:21", false)

            m.assertEqual(m.top.findNode("durationLabel").text, "3:21")
        end function

        @it("highlights the current track")
        function _()
            m.top.itemContent = m.createTrack("4", "Song", "3:21", true)

            m.assertTrue(m.top.findNode("background").visible)
        end function

        @it("uses dark title text while focused")
        function _()
            m.top.itemHasFocus = true

            m.assertEqual(m.top.findNode("titleLabel").color, &h08111DFF)
        end function

        @it("uses light title text without focus")
        function _()
            m.top.itemHasFocus = false
            m.top.focusPercent = 0

            m.assertEqual(m.top.findNode("titleLabel").color, &hF3F7FBFF)
        end function

        function createTrack(trackNumber as string, title as string, duration as string, isCurrent as boolean) as object
            item = CreateObject("roSGNode", "ContentNode")
            item.addField("trackNumber", "string", false)
            item.addField("durationText", "string", false)
            item.addField("isCurrent", "boolean", false)
            item.trackNumber = trackNumber
            item.title = title
            item.durationText = duration
            item.isCurrent = isCurrent
            return item
        end function
    end class

end namespace
