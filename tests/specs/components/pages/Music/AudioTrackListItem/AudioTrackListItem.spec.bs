namespace tests

    @SGNode("AudioTrackListItem")
    @suite("AudioTrackListItem component")
    class AudioTrackListItemTests extends rooibos.BaseTestSuite

        @describe("declarative component contract")

        @it("declares the background node")
        function _()
            m.assertNotInvalid(m.top.findNode("background"))
        end function

        @it("declares the numberLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("numberLabel"))
        end function

        @it("declares the titleLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("titleLabel"))
        end function

        @it("declares the durationLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("durationLabel"))
        end function

    end class

end namespace
