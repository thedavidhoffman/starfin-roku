namespace tests
    @SGNode("MusicArtist")
    @suite("MusicArtist component")
    class MusicArtistTests extends rooibos.BaseTestSuite
        @describe("declarative component contract")
        @it("declares the mediaShell node")
        function _()
            m.assertNotInvalid(m.top.findNode("mediaShell"))
        end function
        @it("declares the albumsRow node")
        function _()
            m.assertNotInvalid(m.top.findNode("albumsRow"))
        end function
        @it("declares the artistTask node")
        function _()
            m.assertNotInvalid(m.top.findNode("artistTask"))
        end function
        @it("declares the artistAlbumsTask node")
        function _()
            m.assertNotInvalid(m.top.findNode("artistAlbumsTask"))
        end function
    end class
end namespace
