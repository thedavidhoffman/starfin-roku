namespace tests

    @SGNode("ArtistAlbumRowItem")
    @suite("ArtistAlbumRowItem component")
    class ArtistAlbumRowItemTests extends rooibos.BaseTestSuite

        @describe("declarative component contract")

        @it("declares the albumMask node")
        function _()
            m.assertNotInvalid(m.top.findNode("albumMask"))
        end function

        @it("declares the albumArtwork node")
        function _()
            m.assertNotInvalid(m.top.findNode("albumArtwork"))
        end function

        @it("declares the albumLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("albumLabel"))
        end function

        @it("declares the yearLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("yearLabel"))
        end function

        @describe("item rendering")

        @it("renders the album title")
        function _()
            item = m.createItem("Album", "2024", "http://server/album.jpg")

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("albumLabel").text, "Album")
        end function

        @it("renders the release year")
        function _()
            item = m.createItem("Album", "2024", "")

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("yearLabel").text, "2024")
        end function

        @it("renders album artwork")
        function _()
            item = m.createItem("Album", "2024", "http://server/album.jpg")

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("albumArtwork").uri, "http://server/album.jpg")
        end function

        @it("uses the untitled album fallback")
        function _()
            item = m.createItem("", "", "")

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("albumLabel").text, "Untitled Album")
        end function

        function createItem(title as string, releaseYear as string, imageUrl as string) as object
            item = CreateObject("roSGNode", "ContentNode")
            item.addField("releaseYear", "string", false)
            item.title = title
            item.releaseYear = releaseYear
            item.HDPosterUrl = imageUrl
            return item
        end function
    end class

end namespace
