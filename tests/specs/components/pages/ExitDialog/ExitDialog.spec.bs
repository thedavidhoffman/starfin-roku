namespace tests

    @SGNode("ExitDialog")
    @suite("ExitDialog component")
    class ExitDialogTests extends rooibos.BaseTestSuite

        @describe("dialog behavior")

        @it("configures the exit confirmation")
        function _()
            'bs:disable-next-line 1140
            openConfirmation()

            m.assertEqual(m.top.title, "Exit?")
            m.assertTrue(m.top.dialogWidth = 800)
            m.assertTrue(m.top.dialogHeight = 420)
            m.assertEqual(m.top.contentComponentName, "ExitDialogContent")
            m.assertEqual(m.top.saveButtonText, "Exit")
            m.assertEqual(m.top.cancelButtonText, "Cancel")
        end function

        @it("opens the confirmation dialog")
        function _()
            'bs:disable-next-line 1140
            openConfirmation()

            m.assertTrue(m.top.findNode("dialog").visible)
        end function

        @it("focuses the Exit button")
        function _()
            'bs:disable-next-line 1140
            openConfirmation()

            m.assertTrue(m.top.findNode("saveButton").isInFocusChain())
        end function

        @it("confirms exit from the save action")
        function _()
            m.top.confirmed = false
            'bs:disable-next-line 1140
            openConfirmation()

            'bs:disable-next-line 1140
            onSaveSelected()

            m.assertTrue(m.top.confirmed)
            m.assertFalse(m.top.findNode("dialog").visible)
        end function

        @it("cancels exit from a close request")
        function _()
            m.top.canceled = false
            'bs:disable-next-line 1140
            openConfirmation()

            'bs:disable-next-line 1140
            onCloseRequested()

            m.assertTrue(m.top.canceled)
            m.assertFalse(m.top.findNode("dialog").visible)
        end function

        @it("closes without emitting a confirmation event")
        function _()
            m.top.confirmed = false
            'bs:disable-next-line 1140
            openConfirmation()

            'bs:disable-next-line 1140
            closeConfirmation()

            m.assertFalse(m.top.confirmed)
            m.assertFalse(m.top.findNode("dialog").visible)
        end function

    end class

end namespace
