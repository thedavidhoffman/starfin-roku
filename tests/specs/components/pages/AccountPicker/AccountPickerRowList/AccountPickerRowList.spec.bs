namespace tests

    @SGNode("AccountPickerRowList")
    @suite("AccountPickerRowList component")
    class AccountPickerRowListTests extends rooibos.BaseTestSuite

        @describe("keyboard navigation")

        @it("emits focus exit for a pressed Down key")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("down", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.focusExitDown)
        end function

        @it("ignores a released Down key")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("down", false)

            m.assertFalse(handled)
        end function

        @it("ignores an unrelated pressed key")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("up", true)

            m.assertFalse(handled)
        end function

    end class

end namespace