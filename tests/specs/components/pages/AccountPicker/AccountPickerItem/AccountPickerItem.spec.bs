namespace tests
    @SGNode("AccountPickerItem")
    @suite("AccountPickerItem component")
    class AccountPickerItemTests extends rooibos.BaseTestSuite
        @describe("declarative component contract")
        @it("declares the posterMask node")
        function _()
            m.assertNotInvalid(m.top.findNode("posterMask"))
        end function
        @it("declares the poster node")
        function _()
            m.assertNotInvalid(m.top.findNode("poster"))
        end function
        @it("declares the nameLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("nameLabel"))
        end function
        @it("declares the statusLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("statusLabel"))
        end function
    end class
end namespace
