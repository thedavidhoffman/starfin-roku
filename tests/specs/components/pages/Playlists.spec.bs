import "pkg:/source/Number.bs"

namespace tests

    @SGNode("Playlists")
    @suite("Playlists component")
    class PlaylistsTests extends rooibos.BaseTestSuite

        protected override function beforeEach()
            m.node.pageState.request = m.createRequest("playlist")
            m.node.pageState.items = []
            m.node.pageState.allItems = []
            m.node.pageState.isLoading = false
            m.node.playlistState.navigationStack = []
            m.node.playlistState.pendingAutomaticPlaylist = invalid
            m.node.playlistState.actionFocusId = ""
            m.node.playlistState.restoreItemIndex = -1
            m.top.playbackSelected = invalid
            m.top.findNode("singlePlaylistOpenTimer").control = "stop"
        end function

        @describe("declarative component contract")

        @it("declares playlist playback controls")
        function _()
            m.assertNotInvalid(m.top.findNode("playlistPlaybackButtons"))
        end function

        @it("declares the Resume action")
        function _()
            m.assertNotInvalid(m.top.findNode("playlistResumeButton"))
        end function

        @it("declares the Play action")
        function _()
            m.assertNotInvalid(m.top.findNode("playlistPlayButton"))
        end function

        @it("declares the Random action")
        function _()
            m.assertNotInvalid(m.top.findNode("playlistRandomButton"))
        end function

        @it("hides inherited browse controls during initialization")
        function _()
            m.assertFalse(m.top.findNode("browseByButton").visible)
            m.assertFalse(m.top.findNode("sortButton").visible)
            m.assertFalse(m.top.findNode("letterGutterButton").visible)
        end function

        @describe("playlist classification and layout")

        @it("uses the playlist item setting inside a playlist")
        function _()
            m.top.settings = {
                "playlist-cards-image-type": "thumbnail"
                "playlist-items-image-type": "poster"
            }

            'bs:disable-next-line 1140
            imageAspect = specializationImageAspect()

            m.assertEqual(imageAspect, "poster")
        end function

        @it("uses the playlist card setting for the playlist library")
        function _()
            m.node.pageState.request = m.createRequest("playlists")
            m.top.settings = {
                "playlist-cards-image-type": "thumbnail"
                "playlist-items-image-type": "poster"
            }

            'bs:disable-next-line 1140
            imageAspect = specializationImageAspect()

            m.assertEqual(imageAspect, "wide")
        end function

        @it("uses jumbo for playlist cards")
        function _()
            m.node.pageState.request = m.createRequest("playlists")
            m.top.settings = { "playlist-cards-image-type": "jumbo" }

            'bs:disable-next-line 1140
            imageAspect = specializationImageAspect()

            m.assertEqual(imageAspect, "jumbo")
        end function

        @it("uses jumbo for playlist items")
        function _()
            m.top.settings = { "playlist-items-image-type": "jumbo" }

            'bs:disable-next-line 1140
            imageAspect = specializationImageAspect()

            m.assertEqual(imageAspect, "jumbo")
        end function

        @it("uses detailed for playlist items")
        function _()
            m.top.settings = { "playlist-items-image-type": "detailed" }

            'bs:disable-next-line 1140
            imageAspect = specializationImageAspect()

            m.assertEqual(imageAspect, "detailed")
        end function

        @it("uses detailed for playlist cards")
        function _()
            m.node.pageState.request = m.createRequest("playlists")
            m.top.settings = { "playlist-cards-image-type": "detailed" }

            'bs:disable-next-line 1140
            imageAspect = specializationImageAspect()

            m.assertEqual(imageAspect, "detailed")
        end function

        @it("uses playlist thumbnail artwork when available")
        function _()
            playlist = {
                Id: "playlist-1"
                ImageTags: { Primary: "primary-tag", Thumb: "thumb-tag" }
            }

            'bs:disable-next-line 1140
            imageUrl = specializationImageUrl(playlist, "wide")

            m.assertTrue(Instr(1, imageUrl, "/Images/Thumb?") > 0)
            m.assertTrue(Instr(1, imageUrl, "tag=thumb-tag") > 0)
        end function

        @it("falls back to primary artwork when a playlist has no wide artwork")
        function _()
            playlist = {
                Id: "playlist-1"
                ImageTags: { Primary: "primary-tag" }
                BackdropImageTags: []
            }

            'bs:disable-next-line 1140
            imageUrl = specializationImageUrl(playlist, "wide")

            m.assertTrue(Instr(1, imageUrl, "/Images/Primary?") > 0)
            m.assertTrue(Instr(1, imageUrl, "tag=primary-tag") > 0)
        end function

        @it("prefers backdrop artwork for jumbo playlist cards")
        function _()
            playlist = {
                Id: "playlist-1"
                ImageTags: { Primary: "primary-tag" }
                BackdropImageTags: ["backdrop-tag"]
            }

            'bs:disable-next-line 1140
            imageUrl = specializationImageUrl(playlist, "jumbo")

            m.assertTrue(Instr(1, imageUrl, "/Images/Backdrop?") > 0)
            m.assertTrue(Instr(1, imageUrl, "tag=backdrop-tag") > 0)
        end function

        @it("hides browse and sort controls for playlist cards after synchronization")
        function _()
            m.node.pageState.request = m.createRequest("playlists")

            'bs:disable-next-line 1140
            syncSortControls()

            m.assertFalse(m.top.findNode("browseByButton").visible)
            m.assertFalse(m.top.findNode("sortButton").visible)
            m.assertFalse(m.top.findNode("letterGutterButton").visible)
        end function

        @it("hides browse and sort controls for playlist items after synchronization")
        function _()
            'bs:disable-next-line 1140
            syncSortControls()

            m.assertFalse(m.top.findNode("browseByButton").visible)
            m.assertFalse(m.top.findNode("sortButton").visible)
            m.assertFalse(m.top.findNode("letterGutterButton").visible)
        end function

        @it("hides metadata on playlist card view models")
        function _()
            m.node.pageState.request = m.createRequest("playlists")

            'bs:disable-next-line 1140
            node = createVideoLibraryItemNode({ Id: "playlist-1", Type: "Playlist", Name: "Favorites" })

            m.assertFalse(node.showMetadata)
        end function

        @it("shows metadata on playlist item view models")
        function _()
            'bs:disable-next-line 1140
            node = createVideoLibraryItemNode(m.createMovie("movie-1", false, 0))

            m.assertTrue(node.showMetadata)
        end function

        @it("skips filter option loading for playlists")
        function _()
            previousQueryId = m.node.pageState.filtersQueryId

            'bs:disable-next-line 1140
            loadVideoFilterOptions()

            m.assertEqual(m.top.findNode("videoFilterOptionsTask").control, "stop")
            m.assertEqual(m.node.pageState.filtersQueryId, previousQueryId + 1)
        end function

        @it("does not persist browse or sort state for mixed playlist items")
        function _()
            request = m.createRequest("playlist")
            request.includeItemTypes = "Movie,Series,Episode,Video"

            'bs:disable-next-line 1140
            canPersist = canPersistVideoLibraryViewState(request)

            m.assertFalse(canPersist)
        end function

        @it("does not persist browse or sort state for movie-only playlist items")
        function _()
            request = m.createRequest("playlist")
            request.includeItemTypes = "Movie"

            'bs:disable-next-line 1140
            canPersist = canPersistVideoLibraryViewState(request)

            m.assertFalse(canPersist)
        end function

        @it("does not persist browse or sort state for series-only playlist items")
        function _()
            request = m.createRequest("playlist")
            request.includeItemTypes = "Series"

            'bs:disable-next-line 1140
            canPersist = canPersistVideoLibraryViewState(request)

            m.assertFalse(canPersist)
        end function

        @it("positions poster playback actions at the visible grid edge")
        function _()
            m.top.findNode("videoLibraryProgressIndicator").visible = false

            'bs:disable-next-line 1140
            applyGridLayout("poster")

            m.assertEqual(Number.ToInteger(m.top.findNode("playlistPlaybackButtons").translation[0], -1), 1320)
        end function

        @it("enables the poster progress indicator for playlist items")
        function _()
            'bs:disable-next-line 1140
            layoutMode = specializationProgressLayoutMode("poster")

            m.assertEqual(layoutMode, "poster")
        end function

        @it("hides the poster progress indicator for playlist cards")
        function _()
            m.node.pageState.request = m.createRequest("playlists")

            'bs:disable-next-line 1140
            layoutMode = specializationProgressLayoutMode("poster")

            m.assertEqual(layoutMode, "hidden")
        end function

        @it("aligns poster playback actions with the progress indicator right edge")
        function _()
            m.top.findNode("videoLibraryProgressIndicator").rightEdge = 1810
            m.top.findNode("videoLibraryProgressIndicator").visible = true

            m.assertEqual(m.top.findNode("playlistPlaybackButtons").translation, [1336, 120])
        end function

        @it("aligns poster playback actions with the grid when the progress indicator is hidden")
        function _()
            m.top.findNode("videoLibraryProgressIndicator").rightEdge = 1810
            m.top.findNode("videoLibraryProgressIndicator").visible = true
            m.top.findNode("videoLibraryProgressIndicator").visible = false

            m.assertEqual(m.top.findNode("playlistPlaybackButtons").translation, [1320, 120])
        end function

        @it("uses collection item poster geometry inside a playlist")
        function _()
            'bs:disable-next-line 1140
            applyGridLayout("poster")

            grid = m.top.findNode("itemsGrid")
            m.assertEqual(grid.translation, [96, 207])
            m.assertEqual(grid.itemSize, [297, 465])
            m.assertEqual(grid.itemSpacing, [-12, 27])
            m.assertEqual(grid.numColumns, 6)
            m.assertEqual(grid.numRows, 2)
            m.assertEqual(grid.focusBitmapUri, "pkg:/images/library/poster-focus-297x465.png")
        end function

        @it("uses collection card poster spacing for the playlist library")
        function _()
            m.node.pageState.request = m.createRequest("playlists")

            'bs:disable-next-line 1140
            applyGridLayout("poster")

            m.assertEqual(m.top.findNode("itemsGrid").itemSpacing, [-12, -12])
        end function

        @it("positions wide playback actions at the wide right edge")
        function _()
            'bs:disable-next-line 1140
            applyGridLayout("wide")

            m.assertEqual(Number.ToInteger(m.top.findNode("playlistPlaybackButtons").translation[0], -1), 1406)
        end function

        @it("uses collection item thumbnail spacing inside a playlist")
        function _()
            'bs:disable-next-line 1140
            applyGridLayout("wide")

            m.assertEqual(m.top.findNode("itemsGrid").itemSpacing, [0, 12])
        end function

        @it("uses collection card thumbnail spacing for the playlist library")
        function _()
            m.node.pageState.request = m.createRequest("playlists")

            'bs:disable-next-line 1140
            applyGridLayout("wide")

            m.assertEqual(m.top.findNode("itemsGrid").itemSpacing, [0, -24])
        end function

        @describe("cache identity")

        @it("uses the media item id outside playlist content")
        function _()
            m.node.pageState.request = m.createRequest("playlists")

            'bs:disable-next-line 1140
            key = specializationCacheKey({ Id: "movie-1" })

            m.assertEqual(key, "movie-1")
        end function

        @it("uses PlaylistItemId inside playlist content")
        function _()
            'bs:disable-next-line 1140
            key = specializationCacheKey({ Id: "movie-1", PlaylistItemId: "entry-1" })

            m.assertEqual(key, "playlist:entry-1")
        end function

        @it("uses occurrence index when a playlist entry id is absent")
        function _()
            'bs:disable-next-line 1140
            key = specializationCacheKey({ Id: "movie-1" }, 2)

            m.assertEqual(key, "playlist:movie-1:2")
        end function

        @it("returns an empty cache key when playlist identity is incomplete")
        function _()
            'bs:disable-next-line 1140
            key = specializationCacheKey({ Id: "" })

            m.assertEqual(key, "")
        end function

        @describe("automatic playlist opening")

        @it("schedules the only playlist in a playlist library")
        function _()
            playlist = { Id: "playlist-1", Name: "Playlist", Type: "Playlist" }
            m.node.pageState.request = m.createRequest("playlists")
            m.node.pageState.allItems = [playlist]

            'bs:disable-next-line 1140
            handled = specializationItemsLoaded()

            m.assertTrue(handled)
            m.assertEqual(m.node.playlistState.pendingAutomaticPlaylist, playlist)
            m.assertEqual(m.top.findNode("singlePlaylistOpenTimer").control, "start")
        end function

        @it("commits deferred chrome before automatically opening the only playlist")
        function _()
            request = m.createRequest("playlists")
            m.node.pageState.request = request
            m.node.pageState.paging.nextStartIndex = 0
            m.node.pageState.paging.queryId = 31
            m.node.chromeLayout.deferProgressSync = true
            AsyncLifecycle.Begin(m.node.pageState.lifecycle, request.libraryId)
            m.node.videoLibraryTask.response = {
                ok: true
                action: "videoLibrary"
                libraryId: request.libraryId
                queryId: 31
                startIndex: 0
                payload: { Items: [{ Id: "playlist-1", Name: "Playlist", Type: "Playlist" }] }
                nextStartIndex: 1
                totalRecordCount: 1
                hasMore: false
            }

            'bs:disable-next-line 1140
            onVideoLibraryResponse()

            m.assertFalse(m.node.chromeLayout.deferProgressSync)
            m.assertEqual(m.top.findNode("singlePlaylistOpenTimer").control, "start")
        end function

        @it("does not schedule automatic opening for multiple playlists")
        function _()
            m.node.pageState.request = m.createRequest("playlists")
            m.node.pageState.allItems = [
                { Id: "playlist-1", Type: "Playlist" }
                { Id: "playlist-2", Type: "Playlist" }
            ]

            'bs:disable-next-line 1140
            handled = specializationItemsLoaded()

            m.assertFalse(handled)
            m.assertInvalid(m.node.playlistState.pendingAutomaticPlaylist)
        end function

        @describe("playback controls")

        @it("shows playback controls when playlist content is playable")
        function _()
            m.node.pageState.items = [m.createMovie("movie-1", false, 0)]

            'bs:disable-next-line 1140
            specializationSyncState()

            m.assertTrue(m.top.findNode("playlistPlaybackButtons").visible)
            m.assertTrue(m.top.findNode("playlistPlayButton").visible)
            m.assertTrue(m.top.findNode("playlistRandomButton").visible)
        end function

        @it("shows Resume when an item is not played")
        function _()
            m.node.pageState.items = [m.createMovie("movie-1", false, 0)]

            'bs:disable-next-line 1140
            specializationSyncState()

            m.assertTrue(m.top.findNode("playlistResumeButton").visible)
        end function

        @it("hides Resume when every item is played without progress")
        function _()
            m.node.pageState.items = [m.createMovie("movie-1", true, 0)]

            'bs:disable-next-line 1140
            specializationSyncState()

            m.assertFalse(m.top.findNode("playlistResumeButton").visible)
        end function

        @it("hides playback controls without playable content")
        function _()
            m.node.pageState.items = [{ Id: "folder-1", Type: "Folder" }]

            'bs:disable-next-line 1140
            specializationSyncState()

            m.assertFalse(m.top.findNode("playlistPlaybackButtons").visible)
        end function

        @it("Play starts the first playable item from the beginning")
        function _()
            m.node.pageState.items = [m.createMovie("movie-1", false, 900)]
            'bs:disable-next-line 1140
            specializationSyncState()

            m.top.findNode("playlistPlayButton").buttonSelected = true

            m.assertEqual(m.top.playbackSelected.itemId, "movie-1")
            m.assertEqual(m.top.playbackSelected.startPositionTicks, 0)
            m.assertEqual(m.top.playbackSelected.playbackQueueScope, "playlist")
        end function

        @it("Resume starts at the first unfinished item position")
        function _()
            m.node.pageState.items = [
                m.createMovie("played", true, 0)
                m.createMovie("resume", false, 900)
            ]
            'bs:disable-next-line 1140
            specializationSyncState()

            m.top.findNode("playlistResumeButton").buttonSelected = true

            m.assertEqual(m.top.playbackSelected.itemId, "resume")
            m.assertEqual(m.top.playbackSelected.startPositionTicks, 900)
            m.assertEqual(m.top.playbackSelected.playbackQueueIndex, 1)
        end function

        @it("selecting playlist content emits its queue position")
        function _()
            first = m.createMovie("first", false, 0)
            second = m.createMovie("second", false, 500)
            m.node.pageState.items = [first, second]

            'bs:disable-next-line 1140
            handled = specializationHandleItemSelected(1, second)

            m.assertTrue(handled)
            m.assertEqual(m.top.playbackSelected.itemId, "second")
            m.assertEqual(m.top.playbackSelected.playbackQueueIndex, 1)
            m.assertEqual(m.node.playlistState.restoreItemIndex, 1)
        end function

        @it("ignores a selected item without an id")
        function _()
            'bs:disable-next-line 1140
            handled = specializationHandleItemSelected(0, { Type: "Movie" })

            m.assertTrue(handled)
            m.assertInvalid(m.top.playbackSelected)
        end function

        @describe("focus and lifecycle")

        @it("routes Up from playlist cards to the app header")
        function _()
            m.node.pageState.request = m.createRequest("playlists")
            m.top.focusExitUp = false
            m.top.findNode("itemsGrid").itemFocused = 0

            'bs:disable-next-line 1140
            handled = specializationHandleKey("up")

            m.assertTrue(handled)
            m.assertTrue(m.top.focusExitUp)
            m.assertFalse(m.top.findNode("browseByButton").isInFocusChain())
        end function

        @it("routes Up from playlist items to playback actions")
        function _()
            m.node.pageState.items = [m.createMovie("movie-1", false, 0)]
            m.top.findNode("itemsGrid").itemFocused = 0
            'bs:disable-next-line 1140
            specializationSyncState()

            'bs:disable-next-line 1140
            handled = specializationHandleKey("up")

            m.assertTrue(handled)
            m.assertTrue(m.top.findNode("playlistResumeButton").isInFocusChain())
            m.assertFalse(m.top.findNode("browseByButton").isInFocusChain())
        end function

        @it("focuses Resume by default when it is available")
        function _()
            m.node.pageState.items = [m.createMovie("movie-1", false, 0)]
            'bs:disable-next-line 1140
            specializationSyncState()

            'bs:disable-next-line 1140
            handled = specializationActivate()

            m.assertTrue(handled)
            m.assertTrue(m.top.findNode("playlistResumeButton").isInFocusChain())
        end function

        @it("focuses Play by default when Resume is unavailable")
        function _()
            m.node.pageState.items = [m.createMovie("movie-1", true, 0)]
            'bs:disable-next-line 1140
            specializationSyncState()

            'bs:disable-next-line 1140
            handled = specializationActivate()

            m.assertTrue(handled)
            m.assertTrue(m.top.findNode("playlistPlayButton").isInFocusChain())
        end function

        @it("moves right from Play to Random")
        function _()
            m.node.pageState.items = [m.createMovie("movie-1", true, 0)]
            'bs:disable-next-line 1140
            specializationSyncState()
            'bs:disable-next-line 1140
            focusPlaylistPlaybackButton(m.top.findNode("playlistPlayButton"))

            'bs:disable-next-line 1140
            handled = specializationHandleKey("right")

            m.assertTrue(handled)
            m.assertTrue(m.top.findNode("playlistRandomButton").isInFocusChain())
        end function

        @it("stops automatic opening when deactivated")
        function _()
            m.node.playlistState.pendingAutomaticPlaylist = { Id: "playlist-1" }
            m.top.findNode("singlePlaylistOpenTimer").control = "start"

            'bs:disable-next-line 1140
            specializationDeactivate()

            m.assertInvalid(m.node.playlistState.pendingAutomaticPlaylist)
            m.assertEqual(m.top.findNode("singlePlaylistOpenTimer").control, "stop")
        end function

        function createRequest(collectionType as string) as object
            return {
                server: "http://server"
                token: "token"
                userId: "user"
                libraryId: "library"
                collectionType: collectionType
            }
        end function

        function createMovie(id as string, played as boolean, positionTicks as integer) as object
            return {
                Id: id
                Type: "Movie"
                MediaType: "Video"
                UserData: { Played: played, PlaybackPositionTicks: positionTicks }
                ImageTags: {}
                BackdropImageTags: []
            }
        end function

    end class

end namespace
