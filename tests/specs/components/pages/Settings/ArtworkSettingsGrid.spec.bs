namespace tests

    @SGNode("ArtworkSettingsGrid")
    @suite("ArtworkSettingsGrid component")
    class ArtworkSettingsGridTests extends rooibos.BaseTestSuite

        @describe("matrix setup")

        @it("builds eight aligned library rows")
        function _()
            expectedTitles = ["TV", "Movie", "Collection Cards", "Collection Items", "Playlist Cards", "Playlist Items", "Music Videos", "Home Videos"]

            m.assertEqual(m.node.libraryLabels.content.getChildCount(), expectedTitles.Count())
            for i = 0 to expectedTitles.Count() - 1
                m.assertEqual(m.node.libraryLabels.content.getChild(i).title, expectedTitles[i])
            end for
            for each options in m.node.optionLists
                m.assertEqual(options.content.getChildCount(), expectedTitles.Count())
            end for
        end function

        @it("checks exactly one artwork column for each loaded row")
        function _()
            selections = SettingsStore.Defaults()
            selections[SettingsStore.Key.TvLibraryDisplay] = "poster"
            selections[SettingsStore.Key.MovieLibraryDisplay] = "thumbnail"
            selections[SettingsStore.Key.CollectionCardsImageType] = "jumbo"
            selections[SettingsStore.Key.CollectionItemsImageType] = "detailed"
            m.top.selections = selections

            m.assertTrue(m.node.optionLists[0].checkedState[0])
            m.assertTrue(m.node.optionLists[1].checkedState[1])
            m.assertTrue(m.node.optionLists[2].checkedState[2])
            m.assertTrue(m.node.optionLists[3].checkedState[3])
            for rowIndex = 0 to m.node.rows.Count() - 1
                checkedCount = 0
                for columnIndex = 0 to m.node.optionLists.Count() - 1
                    if m.node.optionLists[columnIndex].checkedState[rowIndex] then checkedCount++
                end for
                m.assertEqual(checkedCount, 1)
            end for
        end function

        @describe("selection")

        @it("selects one column without changing other rows")
        function _()
            m.top.selections = SettingsStore.Defaults()
            movieValue = m.top.selections[SettingsStore.Key.MovieLibraryDisplay]
            m.node.optionLists[3].itemSelected = 2

            m.assertEqual(m.top.selectionChanged.settingKey, SettingsStore.Key.CollectionCardsImageType)
            m.assertEqual(m.top.selectionChanged.value, "detailed")
            m.assertEqual(m.top.selections[SettingsStore.Key.CollectionCardsImageType], "detailed")
            m.assertEqual(m.top.selections[SettingsStore.Key.MovieLibraryDisplay], movieValue)
            for columnIndex = 0 to m.node.optionLists.Count() - 1
                m.assertEqual(m.node.optionLists[columnIndex].checkedState[2], columnIndex = 3)
            end for
        end function

        @it("keeps a row checked when its selected cell is selected again")
        function _()
            m.top.selections = SettingsStore.Defaults()
            m.node.optionLists[0].itemSelected = 0

            checkedCount = 0
            for each options in m.node.optionLists
                if options.checkedState[0] then checkedCount++
            end for
            m.assertEqual(checkedCount, 1)
            m.assertTrue(m.node.optionLists[0].checkedState[0])
        end function

        @describe("focus navigation")

        @it("moves horizontally while preserving the focused row")
        function _()
            m.node.optionLists[0].jumpToItem = 4
            m.node.optionLists[0].setFocus(true)

            'bs:disable-next-line 1140
            handled = onKeyEvent("right", true)

            m.assertTrue(handled)
            m.assertTrue(m.node.optionLists[1].isInFocusChain())
            m.assertEqual(m.node.optionLists[1].itemFocused, 4)
        end function

        @it("emits a focus exit from the poster column")
        function _()
            m.node.optionLists[0].setFocus(true)
            m.top.focusExitLeft = false

            'bs:disable-next-line 1140
            handled = onKeyEvent("left", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.focusExitLeft)
        end function

    end class

end namespace
