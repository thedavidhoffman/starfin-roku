namespace tests

    @SGNode("SettingsContent")
    @suite("SettingsContent component")
    class SettingsContentTests extends rooibos.BaseTestSuite

        @describe("category and panel setup")

        @it("uses one font size for settings descriptions")
        function _()
            expectedSize = m.node.videoStreamingModeDescription.font.size

            m.assertEqual(m.node.subtitleBurnInDescription.font.size, expectedSize)
            m.assertEqual(m.top.findNode("tmdbApiKeyDescription").font.size, expectedSize)
            m.assertEqual(m.top.findNode("resetStarfinDescription").font.size, expectedSize)
        end function

        @it("initializes every settings category and matching panel")
        function _()
            deviceTitles = ["General", "Video", "Subtitles", "Advanced"]
            userTitles = ["Libraries", "Media Shell", "TV", "Screensaver"]

            m.assertEqual(m.node.categoryPanels.Count(), deviceTitles.Count() + userTitles.Count())
            m.assertEqual(m.node.categoryControls.Count(), deviceTitles.Count() + userTitles.Count())
            m.assertEqual(m.node.deviceCategoryList.content.getChildCount(), deviceTitles.Count())
            m.assertEqual(m.node.userCategoryList.content.getChildCount(), userTitles.Count())
            for i = 0 to deviceTitles.Count() - 1
                m.assertEqual(m.node.deviceCategoryList.content.getChild(i).title, deviceTitles[i])
            end for
            for i = 0 to userTitles.Count() - 1
                m.assertEqual(m.node.userCategoryList.content.getChild(i).title, userTitles[i])
            end for
        end function

        @it("builds subtitle burn-in options in display order")
        function _()
            options = m.node.settingsControls.subtitleBurnInOptions.content
            m.assertEqual(options.getChildCount(), 3)
            m.assertEqual(options.getChild(0).title, "During Transcoding")
            m.assertEqual(options.getChild(1).title, "Prefer External Subtitles")
            m.assertEqual(options.getChild(2).title, "Always Burn In")
        end function

        @it("stores artwork grid changes in settings state")
        function _()
            m.node.settingsControls.librarySettingsGrid.selectionChanged = {
                settingKey: SettingsStore.Key.CollectionCardsLayout
                value: "detailed;2"
            }

            m.assertEqual(m.node.settingsState.values[SettingsStore.Key.CollectionCardsLayout], "detailed;2")
            m.assertEqual(m.node.settingsState.values[SettingsStore.Key.CollectionItemsLayout], "poster;6")
        end function

        @it("loads all artwork values into the grid")
        function _()
            m.node.settingsState.values = SettingsStore.Defaults()
            m.node.settingsState.values[SettingsStore.Key.MusicVideosLayout] = "thumbnail;3"

            'bs:disable-next-line 1140
            selections = getLibrarySettingsValues()

            m.assertEqual(selections.Count(), 8)
            m.assertEqual(selections[SettingsStore.Key.MusicVideosLayout], "thumbnail;3")
            m.assertEqual(selections[SettingsStore.Key.HomeVideosLayout], "poster;6")
        end function

        @it("maps and stores subtitle burn-in modes")
        function _()
            'bs:disable-next-line 1140
            setSubtitleBurnInOption(SubtitleBurnIn.Mode.Always)
            m.assertEqual(m.node.settingsControls.subtitleBurnInOptions.checkedItem, 2)

            m.node.settingsControls.subtitleBurnInOptions.itemSelected = 1
            'bs:disable-next-line 1140
            onSubtitleBurnInSelected()
            m.assertEqual(m.node.settingsState.values[SettingsStore.Key.SubtitleBurnInMode], SubtitleBurnIn.Mode.PreferExternal)
        end function

        @it("updates the subtitle description for the focused option")
        function _()
            m.node.settingsControls.subtitleBurnInOptions.itemFocused = 2
            'bs:disable-next-line 1140
            onSubtitleBurnInFocused()
            m.assertTrue(Instr(1, m.node.subtitleBurnInDescription.text, "most reliable synchronization") > 0)
        end function

        @it("shows only the selected category panel")
        function _()
            'bs:disable-next-line 1140
            showCategory(7)

            m.assertEqual(m.node.focusState.categoryIndex, 7)
            for i = 0 to m.node.categoryPanels.Count() - 1
                m.assertEqual(m.node.categoryPanels[i].visible, i = 7)
            end for
        end function

        @it("updates the panel explicitly when crossing category-list boundaries")
        function _()
            m.node.userCategoryList.jumpToItem = 3
            m.node.userCategoryList.setFocus(true)
            'bs:disable-next-line 1140
            handled = onKeyEvent("down", true)
            m.assertTrue(handled)
            m.assertEqual(m.node.focusState.categoryIndex, 4)
            m.assertTrue(m.node.categoryPanels[4].visible)

            m.node.deviceCategoryList.jumpToItem = 0
            m.node.deviceCategoryList.setFocus(true)
            'bs:disable-next-line 1140
            handled = onKeyEvent("up", true)
            m.assertTrue(handled)
            m.assertEqual(m.node.focusState.categoryIndex, 3)
            m.assertTrue(m.node.categoryPanels[3].visible)
        end function

        @describe("screensaver settings")

        @it("builds screensaver type and delay options in display order")
        function _()
            typeOptions = m.node.settingsControls.screensaverTypeOptions.content
            delayOptions = m.node.settingsControls.screensaverDelayOptions.content

            m.assertEqual(typeOptions.getChildCount(), 3)
            m.assertEqual(typeOptions.getChild(0).title, "None")
            m.assertEqual(typeOptions.getChild(1).title, "Bouncing artwork")
            m.assertEqual(typeOptions.getChild(2).title, "Starfield")
            m.assertEqual(delayOptions.getChildCount(), 4)
            m.assertEqual(delayOptions.getChild(0).title, "1 minute")
            m.assertEqual(delayOptions.getChild(1).title, "5 minutes")
            m.assertEqual(delayOptions.getChild(2).title, "15 minutes")
            m.assertEqual(delayOptions.getChild(3).title, "30 minutes")
        end function

        @it("maps stored screensaver types to their checked options")
        function _()
            'bs:disable-next-line 1140
            setScreensaverTypeOption("roku")
            m.assertEqual(m.node.settingsControls.screensaverTypeOptions.checkedItem, 0)

            'bs:disable-next-line 1140
            setScreensaverTypeOption("bounce")
            m.assertEqual(m.node.settingsControls.screensaverTypeOptions.checkedItem, 1)

            'bs:disable-next-line 1140
            setScreensaverTypeOption("starfield")
            m.assertEqual(m.node.settingsControls.screensaverTypeOptions.checkedItem, 2)

            'bs:disable-next-line 1140
            setScreensaverTypeOption("unknown")
            m.assertEqual(m.node.settingsControls.screensaverTypeOptions.checkedItem, 0)
        end function

        @it("maps stored delays to their checked options with a one-minute fallback")
        function _()
            values = ["1", "5", "15", "30"]
            for i = 0 to values.Count() - 1
                'bs:disable-next-line 1140
                setScreensaverDelayOption(values[i])
                m.assertEqual(m.node.settingsControls.screensaverDelayOptions.checkedItem, i)
            end for

            'bs:disable-next-line 1140
            setScreensaverDelayOption("unsupported")
            m.assertEqual(m.node.settingsControls.screensaverDelayOptions.checkedItem, 0)
        end function

        @it("stores selected screensaver type and delay values")
        function _()
            m.node.settingsControls.screensaverTypeOptions.itemSelected = 1
            'bs:disable-next-line 1140
            onScreensaverTypeSelected()
            m.assertEqual(m.node.settingsState.values[SettingsStore.Key.ScreensaverType], "bounce")

            m.node.settingsControls.screensaverTypeOptions.itemSelected = 2
            'bs:disable-next-line 1140
            onScreensaverTypeSelected()
            m.assertEqual(m.node.settingsState.values[SettingsStore.Key.ScreensaverType], "starfield")

            m.node.settingsControls.screensaverTypeOptions.itemSelected = 0
            'bs:disable-next-line 1140
            onScreensaverTypeSelected()
            m.assertEqual(m.node.settingsState.values[SettingsStore.Key.ScreensaverType], "none")

            m.node.settingsControls.screensaverDelayOptions.itemSelected = 3
            'bs:disable-next-line 1140
            onScreensaverDelaySelected()
            m.assertEqual(m.node.settingsState.values[SettingsStore.Key.ScreensaverDelay], "30")
        end function

        @it("includes screensaver values in settings output")
        function _()
            m.node.settingsState.values = SettingsStore.Defaults()
            m.node.settingsState.values[SettingsStore.Key.ScreensaverType] = "starfield"
            m.node.settingsState.values[SettingsStore.Key.ScreensaverDelay] = "15"

            'bs:disable-next-line 1140
            settings = getSettingsValues()

            m.assertEqual(settings[SettingsStore.Key.ScreensaverType], "starfield")
            m.assertEqual(settings[SettingsStore.Key.ScreensaverDelay], "15")
            m.assertEqual(settings[SettingsStore.Key.TvLibraryLayout], "poster;6")
            m.assertEqual(settings[SettingsStore.Key.VideoStreamingMode], PlaybackMode.Mode.Automatic)
            m.assertEqual(settings[SettingsStore.Key.SubtitleBurnInMode], SubtitleBurnIn.Mode.DuringTranscoding)
        end function

        @describe("reset confirmation")

        @it("switches between reset confirmation and normal reset controls")
        function _()
            m.node.focusState.categoryIndex = 7

            'bs:disable-next-line 1140
            onResetStarfinSelected()
            m.assertTrue(m.node.resetStarfinState.confirmationVisible)
            m.assertFalse(m.node.settingsControls.resetStarfinButton.visible)
            m.assertTrue(m.node.resetStarfinState.confirmationGroup.visible)
            m.assertEqual(m.node.categoryControls[7].Count(), 2)

            'bs:disable-next-line 1140
            onAbortResetSelected()
            m.assertFalse(m.node.resetStarfinState.confirmationVisible)
            m.assertTrue(m.node.settingsControls.resetStarfinButton.visible)
            m.assertFalse(m.node.resetStarfinState.confirmationGroup.visible)
            m.assertEqual(m.node.categoryControls[7].Count(), 1)

            ' The Abort selection event can continue bubbling after focus returns
            ' to the non-list Reset Starfin button.
            'bs:disable-next-line 1140
            m.assertFalse(onKeyEvent("OK", true))
        end function

    end class

end namespace
