namespace tests

    @SGNode("SystemInformationContent")
    @suite("SystemInformationContent component")
    class SystemInformationContentTests extends rooibos.BaseTestSuite

        @describe("declarative component contract")

        @it("declares the propertyViewport node")
        function _()
            m.assertNotInvalid(m.top.findNode("propertyViewport"))
        end function

        @it("declares the propertySheet node")
        function _()
            m.assertNotInvalid(m.top.findNode("propertySheet"))
        end function

        @it("declares the scrollTrack node")
        function _()
            m.assertNotInvalid(m.top.findNode("scrollTrack"))
        end function

        @it("declares the scrollThumb node")
        function _()
            m.assertNotInvalid(m.top.findNode("scrollThumb"))
        end function

        @it("declares the scrollHoldDelayTimer node")
        function _()
            m.assertNotInvalid(m.top.findNode("scrollHoldDelayTimer"))
        end function

        @it("declares the scrollRepeatTimer node")
        function _()
            m.assertNotInvalid(m.top.findNode("scrollRepeatTimer"))
        end function

        @describe("information rendering")

        @it("renders application information")
        function _()
            content = m.createRenderedContent()

            m.assertTrue(m.hasLabel(content, "APPLICATION INFORMATION"))
        end function

        @it("renders Roku device information")
        function _()
            content = m.createRenderedContent()

            m.assertTrue(m.hasLabel(content, "ROKU DEVICE INFORMATION"))
        end function

        @it("renders global registry information")
        function _()
            content = m.createRenderedContent()

            m.assertTrue(m.hasLabel(content, "GLOBAL APPLICATION REGISTRY"))
        end function

        @it("reports the playlist card setting in account information")
        function _()
            'bs:disable-next-line 1140
            section = getAccountRegistrySection(m.createAccount())
            found = false
            for each entry in section.entries
                if entry.key = SettingsStore.Key.PlaylistCardsImageType then found = true
            end for

            m.assertTrue(found)
        end function

        @it("reports the playlist item setting in account information")
        function _()
            'bs:disable-next-line 1140
            section = getAccountRegistrySection(m.createAccount())
            found = false
            for each entry in section.entries
                if entry.key = SettingsStore.Key.PlaylistItemsImageType then found = true
            end for

            m.assertTrue(found)
        end function

        @it("reports the music video setting in account information")
        function _()
            'bs:disable-next-line 1140
            section = getAccountRegistrySection(m.createAccount())
            found = false
            for each entry in section.entries
                if entry.key = SettingsStore.Key.MusicVideosImageType then found = true
            end for

            m.assertTrue(found)
        end function

        @it("reports the home video setting in account information")
        function _()
            'bs:disable-next-line 1140
            section = getAccountRegistrySection(m.createAccount())
            found = false
            for each entry in section.entries
                if entry.key = SettingsStore.Key.HomeVideosImageType then found = true
            end for

            m.assertTrue(found)
        end function

        @it("shows the scrollbar for rendered system information")
        function _()
            content = m.createRenderedContent()

            m.assertTrue(content.findNode("scrollTrack").visible)
            m.assertTrue(content.findNode("scrollThumb").visible)
        end function

        @it("replaces previously rendered system information")
        function _()
            content = m.createRenderedContent()
            initialCount = content.findNode("propertySheet").getChildCount()

            content.callFunc("updateSystemInformation")

            m.assertEqual(content.findNode("propertySheet").getChildCount(), initialCount)
        end function
        @it("focuses system information")
        function _()
            m.top.callFunc("focusSystemInformation")

            m.assertTrue(m.top.hasFocus())
        end function

        @describe("scroll controls")

        @it("starts the hold timer for pressed Down")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("down", true)

            m.assertTrue(handled)
            m.assertEqual(m.top.findNode("scrollHoldDelayTimer").control, "start")
        end function

        @it("stops timers when held Down is released")
        function _()
            'bs:disable-next-line 1140
            onKeyEvent("down", true)

            'bs:disable-next-line 1140
            handled = onKeyEvent("down", false)

            m.assertTrue(handled)
            m.assertEqual(m.top.findNode("scrollHoldDelayTimer").control, "stop")
            m.assertEqual(m.top.findNode("scrollRepeatTimer").control, "stop")
        end function

        @it("consumes released Up without a held key")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("up", false)

            m.assertTrue(handled)
        end function

        @it("ignores unrelated pressed keys")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("back", true)

            m.assertFalse(handled)
        end function

        function createRenderedContent() as object
            content = CreateObject("roSGNode", "SystemInformationContent")
            content.callFunc("updateSystemInformation")
            return content
        end function

        function hasLabel(content as object, expectedText as string) as boolean
            sheet = content.findNode("propertySheet")
            for i = 0 to sheet.getChildCount() - 1
                child = sheet.getChild(i)
                if child.subtype() = "Label" and child.text = expectedText then return true
            end for
            return false
        end function

        function createAccount() as object
            return {
                accountKey: ""
                server: "server"
                username: "user"
                userId: "user-id"
                primaryImageTag: "tag"
                token: "token"
                isActive: true
            }
        end function

    end class

end namespace
