namespace tests

    @SGNode("Collections")
    @suite("Collections component")
    class CollectionsTests extends rooibos.BaseTestSuite

        @describe("declarative component contract")

        @it("declares the titleLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("titleLabel"))
        end function

        @it("declares the collectionsGrid node")
        function _()
            m.assertNotInvalid(m.top.findNode("collectionsGrid"))
        end function

        @it("declares the collectionsTask node")
        function _()
            m.assertNotInvalid(m.top.findNode("collectionsTask"))
        end function

    end class

end namespace
