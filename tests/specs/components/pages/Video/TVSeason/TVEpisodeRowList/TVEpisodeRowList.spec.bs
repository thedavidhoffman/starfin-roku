namespace tests

    @SGNode("TVEpisodeRowList")
    @suite("TVEpisodeRowList component")
    class TVEpisodeRowListTests extends rooibos.BaseTestSuite

        @describe("declarative component contract")

        @it("initializes the component")
        function _()
            m.assertNotInvalid(m.top)
        end function

        @describe("keyboard handling")

        @it("ignores released keys")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("down", false)

            m.assertFalse(handled)
        end function

        @it("ignores an empty pressed key")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("", true)

            m.assertFalse(handled)
        end function

        @it("allows the base row list to handle non-empty pressed keys")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("down", true)

            m.assertFalse(handled)
        end function
    end class

end namespace
