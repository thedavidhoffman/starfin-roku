import "pkg:/source/Number.bs"

namespace tests

    @SGNode("VideoJumboCard")
    @suite("VideoJumboCard component")
    class VideoJumboCardTests extends rooibos.BaseTestSuite

        @describe("jumbo presentation")

        @it("renders jumbo artwork and a supplied logo")
        function _()
            content = m.createContent({ Type: "Movie", Name: "Movie", UserData: {} })
            content.logoUrl = "http://server/logo.png"

            m.top.itemContent = content

            m.assertEqual(Number.ToInteger(m.top.findNode("poster").width, -1), 882)
            m.assertEqual(Number.ToInteger(m.top.findNode("poster").height, -1), 496)
            m.assertEqual(m.top.findNode("titleLogo").uri, "http://server/logo.png")
            m.assertTrue(m.top.findNode("titleLogo").visible)
        end function

        function createContent(raw as object) as object
            content = CreateObject("roSGNode", "ContentNode")
            content.addFields({ raw: raw, showMetadata: true, logoUrl: "", fitArtwork: false, showArtworkBackground: false, tracksPlaybackProgress: true })
            return content
        end function

    end class

end namespace
