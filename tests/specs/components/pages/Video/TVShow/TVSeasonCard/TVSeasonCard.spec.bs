namespace tests
    @SGNode("TVSeasonCard")
    @suite("TVSeasonCard component")
    class TVSeasonCardTests extends rooibos.BaseTestSuite
        @describe("declarative component contract")
        @it("declares the seasonPosterMask node")
        function _()
            m.assertNotInvalid(m.top.findNode("seasonPosterMask"))
        end function
        @it("declares the placeholder node")
        function _()
            m.assertNotInvalid(m.top.findNode("placeholder"))
        end function
        @it("declares the poster node")
        function _()
            m.assertNotInvalid(m.top.findNode("poster"))
        end function
        @it("declares the watchedIndicator node")
        function _()
            m.assertNotInvalid(m.top.findNode("watchedIndicator"))
        end function
        @it("declares the title node")
        function _()
            m.assertNotInvalid(m.top.findNode("title"))
        end function
        @it("declares the year node")
        function _()
            m.assertNotInvalid(m.top.findNode("year"))
        end function
    end class
end namespace
