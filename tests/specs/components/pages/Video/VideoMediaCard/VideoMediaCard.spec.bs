namespace tests

    @SGNode("VideoMediaCard")
    @suite("VideoMediaCard component")
    class VideoMediaCardTests extends rooibos.BaseTestSuite

        @describe("declarative component contract")

        @it("declares the contentGroup node")
        function _()
            m.assertNotInvalid(m.top.findNode("contentGroup"))
        end function

        @it("declares the posterMask node")
        function _()
            m.assertNotInvalid(m.top.findNode("posterMask"))
        end function

        @it("declares the poster node")
        function _()
            m.assertNotInvalid(m.top.findNode("poster"))
        end function

        @it("declares the progressBar node")
        function _()
            m.assertNotInvalid(m.top.findNode("progressBar"))
        end function

        @it("declares the titleLogo node")
        function _()
            m.assertNotInvalid(m.top.findNode("titleLogo"))
        end function

        @it("declares the watchedIndicator node")
        function _()
            m.assertNotInvalid(m.top.findNode("watchedIndicator"))
        end function

        @it("declares the title node")
        function _()
            m.assertNotInvalid(m.top.findNode("title"))
        end function

        @it("declares the metadataLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("metadataLabel"))
        end function

    end class

end namespace
