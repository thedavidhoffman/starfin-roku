namespace tests

    @SGNode("PlaybackInfoContent")
    @suite("PlaybackInfoContent component")
    class PlaybackInfoContentTests extends rooibos.BaseTestSuite

        @describe("declarative component contract")

        @it("declares the propertySheet node")
        function _()
            m.assertNotInvalid(m.top.findNode("propertySheet"))
        end function

        @describe("information rendering")

        @it("renders all three section headings")
        function _()
            m.top.playbackInfo = {}

            m.assertTrue(m.hasLabel("TRANSCODING INFORMATION"))
            m.assertTrue(m.hasLabel("STREAM INFORMATION"))
            m.assertTrue(m.hasLabel("SESSION IDENTITY"))
        end function

        @it("renders a direct play method")
        function _()
            m.top.playbackInfo = { playMethod: "DirectPlay" }

            m.assertTrue(m.hasLabel("Direct Play"))
        end function

        @it("renders a direct stream method")
        function _()
            m.top.playbackInfo = { playMethod: "DirectStream" }

            m.assertTrue(m.hasLabel("Direct Stream"))
        end function

        @it("renders a transcode method")
        function _()
            m.top.playbackInfo = { playMethod: "Transcode" }

            m.assertTrue(m.hasLabel("Transcode"))
        end function

        @it("renders stream container in uppercase")
        function _()
            m.top.playbackInfo = { container: "mkv" }

            m.assertTrue(m.hasLabel("MKV"))
        end function

        @it("renders session identifiers")
        function _()
            m.top.playbackInfo = { itemId: "item-1", playSessionId: "session-1", mediaSourceId: "source-1" }

            m.assertTrue(m.hasLabel("item-1"))
            m.assertTrue(m.hasLabel("session-1"))
            m.assertTrue(m.hasLabel("source-1"))
        end function

        @it("renders a live stream identifier when present")
        function _()
            m.top.playbackInfo = { liveStreamId: "live-1" }

            m.assertTrue(m.hasLabel("LIVE STREAM ID"))
            m.assertTrue(m.hasLabel("live-1"))
        end function



        @it("replaces previously rendered information")
        function _()
            m.top.playbackInfo = { liveStreamId: "old-live-stream" }
            initialCount = m.top.findNode("propertySheet").getChildCount()

            m.top.playbackInfo = { itemId: "new-item" }

            m.assertTrue(m.top.findNode("propertySheet").getChildCount() < initialCount)
            m.assertFalse(m.hasLabel("old-live-stream"))
            m.assertTrue(m.hasLabel("new-item"))
        end function
        @it("focuses the content")
        function _()
            m.top.callFunc("focusInformation")

            m.assertTrue(m.top.hasFocus())
        end function

        function hasLabel(expectedText as string) as boolean
            sheet = m.top.findNode("propertySheet")
            for i = 0 to sheet.getChildCount() - 1
                child = sheet.getChild(i)
                if child.subtype() = "Label" and child.text = expectedText then return true
            end for
            return false
        end function

    end class

end namespace
