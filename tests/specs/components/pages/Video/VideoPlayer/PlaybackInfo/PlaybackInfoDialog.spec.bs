namespace tests

    @SGNode("PlaybackInfoDialog")
    @suite("PlaybackInfoDialog component")
    class PlaybackInfoDialogTests extends rooibos.BaseTestSuite

        @describe("dialog behavior")

        @it("configures playback information content")
        function _()
            m.top.callFunc("openPlaybackInfo")

            m.assertEqual(m.top.title, "Playback Information")
            m.assertTrue(m.top.dialogWidth = 1152)
            m.assertTrue(m.top.dialogHeight = 1000)
            m.assertEqual(m.top.contentComponentName, "PlaybackInfoContent")
        end function

        @it("passes playback information to the content")
        function _()
            info = { playMethod: "DirectPlay" }
            m.top.playbackInfo = info

            m.top.callFunc("openPlaybackInfo")
            content = m.top.callFunc("getContentComponent")

            m.assertEqual(content.playbackInfo, info)
        end function

        @it("opens the dialog")
        function _()
            m.top.callFunc("openPlaybackInfo")

            m.assertTrue(m.top.findNode("dialog").visible)
        end function

        @it("focuses playback information content")
        function _()
            m.top.callFunc("openPlaybackInfo")
            content = m.top.callFunc("getContentComponent")

            m.assertTrue(content.isInFocusChain())
        end function

    end class

end namespace
