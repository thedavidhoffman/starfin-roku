namespace tests

    @suite("Playback information formatting")
    class PlaybackInfoFormatTests extends rooibos.BaseTestSuite

        @describe("playback information labels")

        @it("formats every playback mode (case 1)")
        function _()
            m.assertEqual(PlaybackInfoFormat_ModeText(PlaybackMode.Mode.Automatic), "Automatic")
        end function

        @it("formats every playback mode (case 2)")
        function _()
            m.assertEqual(PlaybackInfoFormat_ModeText(PlaybackMode.Mode.AutomaticNoRemux), "Automatic â€” Remux Disabled")
        end function

        @it("formats every playback mode (case 3)")
        function _()
            m.assertEqual(PlaybackInfoFormat_ModeText(PlaybackMode.Mode.TranscodeAllowRemux), "Force Transcode â€” Remux Allowed")
        end function

        @it("formats every playback mode (case 4)")
        function _()
            m.assertEqual(PlaybackInfoFormat_ModeText(PlaybackMode.Mode.TranscodeNoRemux), "Force Transcode â€” Remux Disabled")
        end function

        @it("formats every playback mode (case 5)")
        function _()
            m.assertEqual(PlaybackInfoFormat_ModeText("unknown"), "Not available")
        end function

        @it("formats missing and present values (case 1)")
        function _()
            m.assertEqual(PlaybackInfoFormat_DisplayValue(invalid), "Not available")
        end function

        @it("formats missing and present values (case 2)")
        function _()
            m.assertEqual(PlaybackInfoFormat_DisplayValue(""), "Not available")
        end function

        @it("formats missing and present values (case 3)")
        function _()
            m.assertEqual(PlaybackInfoFormat_DisplayValue("value"), "value")
        end function

        @it("formats valid resolutions (case 1)")
        function _()
            m.assertEqual(PlaybackInfoFormat_ResolutionText({ width: 1920, height: 1080 }), "1920 Ã— 1080")
        end function

        @it("formats valid resolutions (case 2)")
        function _()
            m.assertEqual(PlaybackInfoFormat_ResolutionText({ width: 0, height: 1080 }), "Not available")
        end function

        @it("formats valid resolutions (case 3)")
        function _()
            m.assertEqual(PlaybackInfoFormat_ResolutionText({}), "Not available")
        end function

        @it("formats bitrate boundaries (case 1)")
        function _()
            m.assertEqual(PlaybackInfoFormat_BitrateText(0), "")
        end function

        @it("formats bitrate boundaries (case 2)")
        function _()
            m.assertEqual(PlaybackInfoFormat_BitrateText(999999), "999 Kbps")
        end function

        @it("formats bitrate boundaries (case 3)")
        function _()
            m.assertEqual(PlaybackInfoFormat_BitrateText(1000000), "1 Mbps")
        end function

        @it("formats bitrate boundaries (case 4)")
        function _()
            m.assertEqual(PlaybackInfoFormat_BitrateText(5500000), "5 Mbps")
        end function

        @it("formats codec and audio details (case 1)")
        function _()
            m.assertEqual(PlaybackInfoFormat_StreamText("h264", 5000000), "H264  â€¢  5 Mbps")
        end function

        @it("formats codec and audio details (case 2)")
        function _()
            m.assertEqual(PlaybackInfoFormat_AudioText({ audioCodec: "aac", audioBitrate: 192000, audioChannels: 6 }), "AAC  â€¢  192 Kbps  â€¢  6 channels")
        end function

        @it("formats stream indices with fallback (case 1)")
        function _()
            m.assertEqual(PlaybackInfoFormat_IndexText(0, "Default"), "0")
        end function

        @it("formats stream indices with fallback (case 2)")
        function _()
            m.assertEqual(PlaybackInfoFormat_IndexText(-1, "Off"), "Off")
        end function

        @it("formats stream indices with fallback (case 3)")
        function _()
            m.assertEqual(PlaybackInfoFormat_IndexText(invalid, "Default"), "Default")
        end function

        @it("prefers stream titles over indices (case 1)")
        function _()
            m.assertEqual(PlaybackInfoFormat_StreamTitleText("English", 2, "Default"), "English")
        end function

        @it("prefers stream titles over indices (case 2)")
        function _()
            m.assertEqual(PlaybackInfoFormat_StreamTitleText("", 2, "Default"), "2")
        end function

        @it("prefers stream titles over indices (case 3)")
        function _()
            m.assertEqual(PlaybackInfoFormat_StreamTitleText(invalid, invalid, "Default"), "Default")
        end function

    end class

end namespace
