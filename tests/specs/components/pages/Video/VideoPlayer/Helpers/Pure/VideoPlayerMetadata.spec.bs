namespace tests

    @suite("VideoPlayer metadata")
    class VideoPlayerMetadataTests extends rooibos.BaseTestSuite

        @describe("classification and display metadata")

        @it("classifies episodes, movies, and videos (case 1)")
        function _()
            m.assertTrue(VideoPlayerMetadata_IsEpisode({}, { Type: "Episode" }))
        end function

        @it("classifies episodes, movies, and videos (case 2)")
        function _()
            m.assertTrue(VideoPlayerMetadata_IsEpisode({ series: { Name: "Series" } }, { Type: "Movie" }))
        end function

        @it("classifies episodes, movies, and videos (case 3)")
        function _()
            m.assertTrue(VideoPlayerMetadata_IsMovie({}, { Type: "Movie" }))
        end function

        @it("classifies episodes, movies, and videos (case 4)")
        function _()
            m.assertTrue(VideoPlayerMetadata_IsMovie({}, { Type: "Video" }))
        end function

        @it("classifies episodes, movies, and videos (case 5)")
        function _()
            m.assertTrue(VideoPlayerMetadata_IsMovie({}, { Type: "MusicVideo" }))
        end function

        @it("classifies episodes, movies, and videos (case 6)")
        function _()
            m.assertFalse(VideoPlayerMetadata_IsMovie({}, { Type: "Episode" }))
        end function

        @it("classifies episodes, movies, and videos (case 7)")
        function _()
            m.assertFalse(VideoPlayerMetadata_IsEpisode({}, invalid))
        end function

        @it("classifies music videos explicitly")
        function _()
            m.assertTrue(VideoPlayerMetadata_IsMusicVideo({ Type: "MusicVideo" }))
            m.assertFalse(VideoPlayerMetadata_IsMusicVideo({ Type: "Video" }))
        end function

        @it("formats populated music-video artists")
        function _()
            m.assertEqual(VideoPlayerMetadata_GetMusicVideoArtists({ Artists: ["Artist One", "Artist Two"] }), "Artist One, Artist Two")
        end function

        @it("omits missing and empty music-video artists")
        function _()
            m.assertEqual(VideoPlayerMetadata_GetMusicVideoArtists({}), "")
            m.assertEqual(VideoPlayerMetadata_GetMusicVideoArtists({ Artists: ["", invalid] }), "")
        end function

        @it("offers random music-video skip before five seconds")
        function _()
            m.assertTrue(VideoPlayerMetadata_ShouldShowRandomMusicVideoSkip({ Type: "MusicVideo" }, "random", "random", true, 4.99, false))
        end function

        @it("hides random music-video skip at five seconds")
        function _()
            m.assertFalse(VideoPlayerMetadata_ShouldShowRandomMusicVideoSkip({ Type: "MusicVideo" }, "random", "random", true, 5, false))
        end function

        @it("requires random queue identity and a next item for skip")
        function _()
            item = { Type: "MusicVideo" }
            m.assertFalse(VideoPlayerMetadata_ShouldShowRandomMusicVideoSkip(item, "sequential", "random", true, 1, false))
            m.assertFalse(VideoPlayerMetadata_ShouldShowRandomMusicVideoSkip(item, "random", "library", true, 1, false))
            m.assertFalse(VideoPlayerMetadata_ShouldShowRandomMusicVideoSkip(item, "random", "random", false, 1, false))
        end function

        @it("honors random music-video skip dismissal")
        function _()
            m.assertFalse(VideoPlayerMetadata_ShouldShowRandomMusicVideoSkip({ Type: "MusicVideo" }, "random", "random", true, 1, true))
        end function

        @it("uses request series title before item fallbacks")
        function _()
            request = { server: "server.local", series: { Id: "s1", Name: "Request Series" } }
            item = { Name: "Episode", SeriesName: "Item Series" }
            m.assertEqual(VideoPlayerMetadata_GetSeriesTitle(request, item), "Request Series")
            m.assertEqual(VideoPlayerMetadata_GetSeriesTitle({}, item), "Item Series")
            m.assertEqual(VideoPlayerMetadata_GetItemTitle(invalid), "Video")
        end function

        @it("formats movie year with premiere-date fallback (case 1)")
        function _()
            m.assertEqual(VideoPlayerMetadata_GetMovieText({ ProductionYear: 2025, PremiereDate: "2024-01-01" }), "2025")
        end function

        @it("formats movie year with premiere-date fallback (case 2)")
        function _()
            m.assertEqual(VideoPlayerMetadata_GetMovieText({ PremiereDate: "2024-01-01" }), "2024")
        end function

        @it("formats movie year with premiere-date fallback (case 3)")
        function _()
            m.assertEqual(VideoPlayerMetadata_GetMovieText(invalid), "")
        end function

        @it("formats complete episode metadata")
        function _()
            item = { ParentIndexNumber: 2, IndexNumber: 3, Name: "An Episode", PremiereDate: "2026-08-19T00:00:00Z", RunTimeTicks: 18000000000& }
            separator = MediaMetadata.BulletSeparator()
            expected = "S2" + separator + "E3" + separator + "An Episode" + separator + "Aug 19, 2026" + separator + "30m"
            m.assertEqual(VideoPlayerMetadata_GetEpisodeText(item), expected)
        end function

        @it("uses alternate episode-number fields and partial numbers (case 1)")
        function _()
            m.assertEqual(VideoPlayerMetadata_GetEpisodeNumberText({ SeasonNumber: 4, EpisodeNumber: 5 }), "S4" + MediaMetadata.BulletSeparator() + "E5")
        end function

        @it("uses alternate episode-number fields and partial numbers (case 2)")
        function _()
            m.assertEqual(VideoPlayerMetadata_GetEpisodeNumberText({ SeasonNumber: 4 }), "S4")
        end function

        @it("uses alternate episode-number fields and partial numbers (case 3)")
        function _()
            m.assertEqual(VideoPlayerMetadata_GetEpisodeNumberText({ EpisodeNumber: 5 }), "E5")
        end function

        @it("uses alternate episode-number fields and partial numbers (case 4)")
        function _()
            m.assertEqual(VideoPlayerMetadata_GetEpisodeNumberText({}), "")
        end function

        @it("selects and truncates aired-date fallbacks (case 1)")
        function _()
            m.assertEqual(VideoPlayerMetadata_GetAiredDateText({ PremiereDate: "2026-08-19T12:00:00Z", AirDate: "2025-01-01" }), "2026-08-19")
        end function

        @it("selects and truncates aired-date fallbacks (case 2)")
        function _()
            m.assertEqual(VideoPlayerMetadata_GetAiredDateText({ AirDate: "2025-01-01" }), "2025-01-01")
        end function

        @it("selects and truncates aired-date fallbacks (case 3)")
        function _()
            m.assertEqual(VideoPlayerMetadata_GetAiredDateText({ DateCreated: "short" }), "short")
        end function

        @it("joins only non-empty metadata values")
        function _()
            separator = MediaMetadata.BulletSeparator()
            m.assertEqual(VideoPlayerMetadata_Join(["one", "", invalid, "two"]), "one" + separator + "two")
            m.assertEqual(VideoPlayerMetadata_Join(invalid), "")
        end function

        @it("converts runtime and clamps seconds (case 1)")
        function _()
            m.assertTrue(VideoPlayerMetadata_GetRuntimeSeconds({ RunTimeTicks: 900000000& }) = 90)
        end function

        @it("converts runtime and clamps seconds (case 2)")
        function _()
            m.assertTrue(VideoPlayerMetadata_GetRuntimeSeconds({}) = 0)
        end function

        @it("converts runtime and clamps seconds (case 3)")
        function _()
            m.assertTrue(VideoPlayerMetadata_ClampSeconds(-1, 0, 100) = 0)
        end function

        @it("converts runtime and clamps seconds (case 4)")
        function _()
            m.assertTrue(VideoPlayerMetadata_ClampSeconds(50, 0, 100) = 50)
        end function

        @it("converts runtime and clamps seconds (case 5)")
        function _()
            m.assertTrue(VideoPlayerMetadata_ClampSeconds(101, 0, 100) = 100)
        end function

    end class

end namespace
