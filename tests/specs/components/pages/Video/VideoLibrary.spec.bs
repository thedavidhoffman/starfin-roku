        @describe("filter sorting")

        @it("debounces rapid decade movement and requests only the final value")
        function _()
            m.configurePaging(12, 12, 0)
            'bs:disable-next-line 1140
            commitVideoLibraryBrowseState(LibraryBrowse.CreateSortSelection("Decade", "SortName", "Decade"))
            m.node.pageState.filterSelection.decade = 1990

            'bs:disable-next-line 1140
            scheduleVideoFilterRefresh()
            firstQueryId = m.node.pageState.paging.queryId
            m.node.pageState.filterSelection.decade = 2020
            'bs:disable-next-line 1140
            scheduleVideoFilterRefresh()

            m.assertEqual(m.node.pageState.filterRefresh.phase, "debouncing")
            m.assertEqual(m.node.pageState.filterSelection.decade, 2020)
            m.assertEqual(m.node.pageState.paging.queryId, firstQueryId + 1)
            m.assertEqual(m.node.pageState.allItems.Count(), 12)

            'bs:disable-next-line 1140
            onVideoFilterRefreshTimerFired()

            m.assertEqual(m.node.videoLibraryTask.request.years[0], "2020")
            m.assertEqual(m.node.videoLibraryTask.request.years[9], "2029")
            m.assertEqual(m.node.pageState.filterRefresh.phase, "loading")
        end function

