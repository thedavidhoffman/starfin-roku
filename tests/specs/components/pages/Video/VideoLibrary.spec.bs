        @it("uses primary poster artwork for detailed cards")
        function _()
            m.node.pageState.request = { server: "http://server" }
            item = {
                Id: "movie-1"
                ImageTags: { Primary: "poster-tag", Thumb: "thumb-tag" }
                BackdropImageTags: ["backdrop-tag"]
            }

            'bs:disable-next-line 1140
