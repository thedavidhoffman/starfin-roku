            m.assertEqual(m.node.pageState.letterFilter.selected, "ALL")
            m.assertEqual(m.node.videoLibraryTask.request.startsWith, "ALL")
        end function

        @it("retains starts-with when the active browse option is reselected")
        function _()
            m.configurePaging(12, 12, 0)
            'bs:disable-next-line 1140
            commitVideoLibraryBrowseState(LibraryBrowse.CreateSortSelection("SortName", "SortName", "Title"))
            m.node.pageState.letterFilter.selected = "M"

            'bs:disable-next-line 1140
            applySortSelection({ optionKey: "SortName", sortKey: "SortName", sortOrder: "Ascending", label: "Title" })

            m.assertEqual(m.node.pageState.letterFilter.selected, "M")
        end function

        @it("retains starts-with when only the sort direction changes")
        function _()
            m.configurePaging(12, 12, 0)
            'bs:disable-next-line 1140
            commitVideoLibraryBrowseState(LibraryBrowse.CreateSortSelection("SortName", "SortName", "Title"))
