namespace tests
    @SGNode("CastItem")
    @suite("CastItem component")
    class CastItemTests extends rooibos.BaseTestSuite
        @describe("declarative component contract")
        @it("declares the posterMask node")
        function _()
            m.assertNotInvalid(m.top.findNode("posterMask"))
        end function
        @it("declares the poster node")
        function _()
            m.assertNotInvalid(m.top.findNode("poster"))
        end function
        @it("declares the nameLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("nameLabel"))
        end function
        @it("declares the detailsLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("detailsLabel"))
        end function
    end class
end namespace
