namespace tests

    @SGNode("PersonOverviewDialog")
    @suite("PersonOverviewDialog component")
    class PersonOverviewDialogTests extends rooibos.BaseTestSuite

        @describe("dialog behavior")

        @it("uses the person name as the title")
        function _()
            m.top.personName = "Ada Lovelace"

            'bs:disable-next-line 1140
            openOverview()

            m.assertEqual(m.top.title, "Ada Lovelace")
        end function

        @it("uses the fallback title when the person name is empty")
        function _()
            m.top.personName = ""

            'bs:disable-next-line 1140
            openOverview()

            m.assertEqual(m.top.title, "Overview")
        end function

        @it("configures the overview dialog")
        function _()
            'bs:disable-next-line 1140
            openOverview()

            m.assertTrue(m.top.dialogWidth = 1536)
            m.assertTrue(m.top.dialogHeight = 864)
            m.assertEqual(m.top.contentComponentName, "PersonOverviewComponent")
        end function

        @it("passes overview text to the content")
        function _()
            m.top.overviewText = "Biography"

            'bs:disable-next-line 1140
            openOverview()
            content = m.top.callFunc("getContentComponent")

            m.assertEqual(content.overviewText, "Biography")
        end function

        @it("updates content when overview text changes")
        function _()
            'bs:disable-next-line 1140
            openOverview()
            content = m.top.callFunc("getContentComponent")

            m.top.overviewText = "Updated biography"
            'bs:disable-next-line 1140
            onOverviewTextChanged()

            m.assertEqual(content.overviewText, "Updated biography")
        end function

        @it("opens and focuses overview content")
        function _()
            'bs:disable-next-line 1140
            openOverview()
            content = m.top.callFunc("getContentComponent")

            m.assertTrue(m.top.findNode("dialog").visible)
            m.assertTrue(content.isInFocusChain())
        end function

        @it("hides the dialog on close request")
        function _()
            'bs:disable-next-line 1140
            openOverview()

            'bs:disable-next-line 1140
            onCloseRequested()

            m.assertFalse(m.top.visible)
        end function

    end class

end namespace
