namespace tests

    @SGNode("PersonOverviewComponent")
    @suite("PersonOverviewComponent component")
    class PersonOverviewComponentTests extends rooibos.BaseTestSuite

        @describe("declarative component contract")

        @it("declares the overview node")
        function _()
            m.assertNotInvalid(m.top.findNode("overview"))
        end function

        @describe("overview behavior")

        @it("renders overview text")
        function _()
            m.top.overviewText = "Biography"

            m.assertEqual(m.top.findNode("overview").text, "Biography")
        end function

        @it("focuses the scrollable overview")
        function _()
            m.top.callFunc("focusOverview")

            m.assertTrue(m.top.findNode("overview").isInFocusChain())
        end function

        @it("handles a pressed OK key")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("OK", true)

            m.assertTrue(handled)
        end function

        @it("ignores a released OK key")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("OK", false)

            m.assertFalse(handled)
        end function

        @it("ignores unrelated pressed keys")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("left", true)

            m.assertFalse(handled)
        end function
    end class

end namespace
