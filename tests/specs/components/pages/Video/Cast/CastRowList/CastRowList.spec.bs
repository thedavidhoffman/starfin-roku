namespace tests

    @SGNode("CastRowList")
    @suite("CastRowList component")
    class CastRowListTests extends rooibos.BaseTestSuite

        @describe("declarative component contract")

        @it("initializes the component")
        function _()
            m.assertNotInvalid(m.top)
        end function

        @describe("keyboard navigation")

        @it("emits focus exit up for a pressed Up key")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("up", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.focusExitUp)
        end function

        @it("emits focus exit down for a pressed Down key")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("down", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.focusExitDown)
        end function

        @it("marks unrelated pressed keys as user interaction")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("left", true)

            m.assertFalse(handled)
            m.assertTrue(m.top.userInteraction)
        end function

        @it("ignores released keys without marking user interaction")
        function _()
            m.top.userInteraction = false

            'bs:disable-next-line 1140
            handled = onKeyEvent("up", false)

            m.assertFalse(handled)
            m.assertFalse(m.top.userInteraction)
        end function
    end class

end namespace
