namespace tests
    @SGNode("FilmographyCard")
    @suite("FilmographyCard component")
    class FilmographyCardTests extends rooibos.BaseTestSuite
        @describe("declarative component contract")
        @it("declares the dateLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("dateLabel"))
        end function
        @it("declares the titleLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("titleLabel"))
        end function
        @it("declares the characterLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("characterLabel"))
        end function
    end class
end namespace
