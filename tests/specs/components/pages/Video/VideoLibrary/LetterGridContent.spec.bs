namespace tests

    @SGNode("LetterGridContent")
    @suite("LetterGridContent component")
    class LetterGridContentTests extends rooibos.BaseTestSuite

        @describe("letter navigation")

        @it("renders ALL, hash, and A through Z in order")
        function _()
            m.assertEqual(m.node.letterItems.Count(), 28)
            m.assertEqual(m.node.letterItems[0].itemContent.title, "ALL")
            m.assertEqual(m.node.letterItems[1].itemContent.title, "#")
            m.assertEqual(m.node.letterItems[2].itemContent.title, "A")
            m.assertEqual(m.node.letterItems[27].itemContent.title, "Z")
            m.assertEqual(m.node.letterItems[0].itemWidth, 140)
            m.assertEqual(m.node.letterItems[1].translation[0], 152.0)
            m.assertEqual(m.node.letterItems[1].translation[1], 0.0)
        end function

        @it("focuses and highlights the active selection when reopened")
        function _()
            m.node.top.activeLetter = "M"
            'bs:disable-next-line 1140
            focusLetters()

            m.assertEqual(m.node.letterItems[m.node.focusState.focusedIndex].itemContent.title, "M")
            m.assertTrue(m.node.letterItems[m.node.focusState.focusedIndex].isSelected)
        end function

        @it("moves up from both columns beneath ALL and down to its first column")
        function _()
            m.node.focusState.focusedIndex = 5
            'bs:disable-next-line 1140
            moveFocus(0 - m.node.focusState.columnCount)
            m.assertEqual(m.node.letterItems[m.node.focusState.focusedIndex].itemContent.title, "ALL")

            m.node.focusState.focusedIndex = 6
            'bs:disable-next-line 1140
            moveFocus(0 - m.node.focusState.columnCount)
            m.assertEqual(m.node.letterItems[m.node.focusState.focusedIndex].itemContent.title, "ALL")

            'bs:disable-next-line 1140
            moveFocus(m.node.focusState.columnCount)
            m.assertEqual(m.node.letterItems[m.node.focusState.focusedIndex].itemContent.title, "D")
        end function

        @it("keeps every letter selectable and bounds horizontal movement")
        function _()
            m.node.focusState.focusedIndex = 0
            'bs:disable-next-line 1140
            moveFocus(-1)
            m.assertEqual(m.node.focusState.focusedIndex, 0)

            m.node.focusState.focusedIndex = 27
            'bs:disable-next-line 1140
            moveFocus(1)
            m.assertEqual(m.node.focusState.focusedIndex, 27)

            m.node.focusState.focusedIndex = 1
            'bs:disable-next-line 1140
            selected = selectFocusedLetter()
            m.assertTrue(selected)
            m.assertEqual(m.node.top.selectedLetter, "#")
        end function

    end class

end namespace
