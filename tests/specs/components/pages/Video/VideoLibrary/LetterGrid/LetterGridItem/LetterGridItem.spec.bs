namespace tests

    @SGNode("LetterGridItem")
    @suite("LetterGridItem component")
    class LetterGridItemTests extends rooibos.BaseTestSuite

        @describe("declarative component contract")

        @it("declares the background node")
        function _()
            m.assertNotInvalid(m.top.findNode("background"))
        end function

        @it("declares the selectedBackground node")
        function _()
            m.assertNotInvalid(m.top.findNode("selectedBackground"))
        end function

        @it("declares the focusBackground node")
        function _()
            m.assertNotInvalid(m.top.findNode("focusBackground"))
        end function

        @it("declares the letterLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("letterLabel"))
        end function

    end class

end namespace
