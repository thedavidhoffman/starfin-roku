namespace tests

    @SGNode("LetterGridDialog")
    @suite("LetterGridDialog component")
    class LetterGridDialogTests extends rooibos.BaseTestSuite

        @describe("declarative component contract")

        @it("initializes the component")
        function _()
            m.assertNotInvalid(m.top)
        end function

        @describe("dialog behavior")

        @it("configures the letter grid dialog")
        function _()
            dialog = m.createOpenDialog("ALL", "Choose a letter")

            m.assertEqual(dialog.title, "Starts with...")
            m.assertTrue(dialog.dialogWidth = 540)
            m.assertTrue(dialog.dialogHeight = 581)
            m.assertEqual(dialog.contentComponentName, "LetterGridContent")
        end function

        @it("uses default panel coordinates")
        function _()
            dialog = m.createOpenDialog("ALL", "")

            m.assertTrue(dialog.panelX = 72)
            m.assertTrue(dialog.panelY = 208)
        end function

        @it("passes the active letter to content")
        function _()
            dialog = m.createOpenDialog("M", "")
            content = dialog.callFunc("getContentComponent")

            m.assertEqual(content.activeLetter, "M")
        end function

        @it("passes status text to content")
        function _()
            dialog = m.createOpenDialog("ALL", "No matches")
            content = dialog.callFunc("getContentComponent")

            m.assertEqual(content.statusText, "No matches")
        end function

        @it("opens and focuses letter content")
        function _()
            dialog = m.createOpenDialog("ALL", "")
            content = dialog.callFunc("getContentComponent")

            m.assertTrue(dialog.findNode("dialog").visible)
            m.assertTrue(content.isInFocusChain())
        end function

        @it("resynchronizes the same content when reopened")
        function _()
            dialog = m.createOpenDialog("A", "Initial")
            content = dialog.callFunc("getContentComponent")
            dialog.activeLetter = "Z"
            dialog.statusText = "Updated"

            dialog.callFunc("openGrid")

            m.assertEqual(content.activeLetter, "Z")
            m.assertEqual(content.statusText, "Updated")
        end function
        @it("propagates letter selection")
        function _()
            dialog = m.createOpenDialog("ALL", "")
            content = dialog.callFunc("getContentComponent")

            content.letterSelected = "G"

            m.assertEqual(dialog.selectedLetter, "G")
            m.assertEqual(dialog.letterSelected, "G")
        end function

        @it("closes the letter grid")
        function _()
            dialog = m.createOpenDialog("ALL", "")

            dialog.callFunc("closeGrid")

            m.assertFalse(dialog.visible)
            m.assertFalse(dialog.findNode("dialog").visible)
        end function

        function createOpenDialog(activeLetter as string, statusText as string) as object
            dialog = CreateObject("roSGNode", "LetterGridDialog")
            dialog.activeLetter = activeLetter
            dialog.statusText = statusText
            dialog.callFunc("openGrid")
            return dialog
        end function

    end class

end namespace
