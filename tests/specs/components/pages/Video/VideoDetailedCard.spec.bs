namespace tests

    @SGNode("VideoDetailedCard")
    @suite("VideoDetailedCard component")
    class VideoDetailedCardTests extends rooibos.BaseTestSuite

        @describe("mask geometry")

        @it("uses a dedicated full-card mask")
        function _()
            cardMask = m.top.findNode("cardMask")

            m.assertNotInvalid(cardMask)
            m.assertTrue(Instr(1, cardMask.maskUri, "detailed-card-mask.png") > 0)
        end function

        @it("uses a dedicated poster mask")
        function _()
            posterMask = m.top.findNode("posterMask")

            m.assertNotInvalid(posterMask)
            m.assertTrue(Instr(1, posterMask.maskUri, "detailed-poster-mask.png") > 0)
        end function

        @it("declares the masked artwork background")
        function _()
            m.assertNotInvalid(m.top.findNode("artworkBackground"))
        end function

        @describe("detailed rendering")

        @it("renders poster title compact metadata and overview")
        function _()
            item = m.createItem({
                Name: "Detailed Movie"
                ProductionYear: 2025
                RunTimeTicks: 75000000000&
                OfficialRating: "PG-13"
                Overview: "A detailed description."
                UserData: {}
            })
            item.HDPosterUrl = "http://server/poster.jpg"

            m.top.itemContent = item

            m.assertEqual(m.top.findNode("poster").uri, "http://server/poster.jpg")
            m.assertEqual(m.top.findNode("title").text, "Detailed Movie")
            m.assertTrue(Instr(1, m.top.findNode("metadataLabel").text, "2025") > 0)
            m.assertTrue(Instr(1, m.top.findNode("metadataLabel").text, "2h 5m") > 0)
            m.assertTrue(Instr(1, m.top.findNode("metadataLabel").text, "PG-13") > 0)
            m.assertEqual(m.top.findNode("overviewLabel").text, "A detailed description.")
        end function

        @it("uses fallbacks when artwork and overview are missing")
        function _()
            m.top.itemContent = m.createItem({ Name: "Movie", UserData: {} })

            m.assertEqual(m.top.findNode("poster").uri, "pkg:/images/media-card/poster-placeholder-252x378.png")
            m.assertEqual(m.top.findNode("overviewLabel").text, "No description available.")
        end function

        @it("renders explicit Home Media metadata including an intentional blank")
        function _()
            photo = m.createItem({ Name: "Photo", Type: "Photo", UserData: {} })
            photo.AddFields({ metadataText: "Aug 14, 2022 at 11:30 AM" })
            m.top.itemContent = photo

            m.assertEqual(m.top.findNode("metadataLabel").text, "Aug 14, 2022 at 11:30 AM")

            folder = m.createItem({ Name: "Folder", Type: "Folder", UserData: {} })
            folder.AddFields({ metadataText: "" })
            m.top.itemContent = folder

            m.assertEqual(m.top.findNode("metadataLabel").text, "")
        end function

        @it("preserves photo artwork aspect ratio when requested")
        function _()
            item = m.createItem({ Name: "Photo", Type: "Photo", UserData: {} })
            item.fitArtwork = true

            m.top.itemContent = item

            m.assertEqual(LCase(m.top.findNode("poster").loadDisplayMode), "scaletofit")
        end function

        @it("shows and clears the artwork background from explicit content state")
        function _()
            photo = m.createItem({ Name: "Photo", Type: "Photo", UserData: {} })
            photo.showArtworkBackground = true
            m.top.itemContent = photo

            m.assertTrue(m.top.findNode("artworkBackground").visible)
            m.assertEqual(m.top.findNode("artworkBackground").uri, "pkg:/images/media-card/photo-artwork-background.png")

            video = m.createItem({ Name: "Video", Type: "Video", UserData: {} })
            m.top.itemContent = video

            m.assertFalse(m.top.findNode("artworkBackground").visible)
        end function

        @it("omits runtime for TV series")
        function _()
            m.top.itemContent = m.createItem({
                Type: "Series"
                Name: "Series"
                ProductionYear: 2024
                RunTimeTicks: 75000000000&
                OfficialRating: "TV-14"
                UserData: {}
            })

            metadata = m.top.findNode("metadataLabel").text
            m.assertTrue(Instr(1, metadata, "2024") > 0)
            m.assertTrue(Instr(1, metadata, "TV-14") > 0)
            m.assertEqual(Instr(1, metadata, "2h 5m"), 0)
        end function

        @it("renders watched and progress state")
        function _()
            m.top.itemContent = m.createItem({ Name: "Movie", RunTimeTicks: 1000, UserData: { Played: false, PlayedPercentage: 50 } })

            m.assertTrue(m.top.findNode("progressBar").visible)
            m.assertEqual(Number.ToInteger(m.top.findNode("progressBar").progressWidth, -1), 135)

            m.top.itemContent = m.createItem({ Name: "Movie", UserData: { Played: true } })

            m.assertTrue(m.top.findNode("watchedIndicator").visible)
            m.assertFalse(m.top.findNode("progressBar").visible)
        end function

        @it("hides watched state for music videos")
        function _()
            m.top.itemContent = m.createItem({ Type: "MusicVideo", Name: "Song", UserData: { Played: true } })

            m.assertFalse(m.top.findNode("watchedIndicator").visible)
        end function

        @it("hides playback progress for music videos")
        function _()
            m.top.itemContent = m.createItem({ Type: "MusicVideo", Name: "Song", UserData: { Played: false, PlayedPercentage: 50 } })

            m.assertFalse(m.top.findNode("progressBar").visible)
            m.assertEqual(Number.ToInteger(m.top.findNode("progressBar").progressWidth, -1), 0)
        end function

        @it("hides progress state for Home Media videos")
        function _()
            item = m.createItem({ Type: "Video", Name: "Home Video", UserData: { Played: false, PlayedPercentage: 50 } })
            item.AddFields({ tracksPlaybackProgress: false })

            m.top.itemContent = item

            m.assertFalse(m.top.findNode("progressBar").visible)
            m.assertEqual(Number.ToInteger(m.top.findNode("progressBar").progressWidth, -1), 0)
        end function

        @it("hides watched state for Home Media folders")
        function _()
            item = m.createItem({ Type: "Folder", Name: "Folder", UserData: { Played: true } })
            item.AddFields({ tracksPlaybackProgress: false })

            m.top.itemContent = item

            m.assertFalse(m.top.findNode("watchedIndicator").visible)
        end function

        @it("restores progress when a Home Media card is recycled for an ordinary video")
        function _()
            homeVideo = m.createItem({ Type: "Video", Name: "Home Video", UserData: { PlayedPercentage: 50 } })
            homeVideo.AddFields({ tracksPlaybackProgress: false })
            m.top.itemContent = homeVideo

            m.top.itemContent = m.createItem({ Type: "Video", Name: "Video", UserData: { PlayedPercentage: 50 } })

            m.assertTrue(m.top.findNode("progressBar").visible)
        end function

        @it("restores watched rendering when a music-video card is recycled")
        function _()
            m.top.itemContent = m.createItem({ Type: "MusicVideo", Name: "Song", UserData: { Played: true } })

            m.top.itemContent = m.createItem({ Type: "Movie", Name: "Movie", UserData: { Played: true } })

            m.assertTrue(m.top.findNode("watchedIndicator").visible)
            m.assertFalse(m.top.findNode("progressBar").visible)
        end function

        @it("restores progress rendering for an episode after recycling")
        function _()
            m.top.itemContent = m.createItem({ Type: "MusicVideo", Name: "Song", UserData: { PlayedPercentage: 50 } })

            m.top.itemContent = m.createItem({ Type: "Episode", Name: "Episode", UserData: { Played: false, PlayedPercentage: 50 } })

            m.assertTrue(m.top.findNode("progressBar").visible)
        end function

        @it("restores watched rendering for an ordinary video after recycling")
        function _()
            m.top.itemContent = m.createItem({ Type: "MusicVideo", Name: "Song", UserData: { Played: true } })

            m.top.itemContent = m.createItem({ Type: "Video", Name: "Video", UserData: { Played: true } })

            m.assertTrue(m.top.findNode("watchedIndicator").visible)
        end function

        function createItem(raw as object) as object
            item = CreateObject("roSGNode", "ContentNode")
            item.AddFields({ raw: raw, fitArtwork: false, showArtworkBackground: false })
            return item
        end function

    end class

end namespace
