namespace tests
    @SGNode("VideoMediaInfoCard")
    @suite("VideoMediaInfoCard component")
    class VideoMediaInfoCardTests extends rooibos.BaseTestSuite
        @describe("declarative component contract")
        @it("declares the cardBackground node")
        function _()
            m.assertNotInvalid(m.top.findNode("cardBackground"))
        end function
        @it("declares the accentBar node")
        function _()
            m.assertNotInvalid(m.top.findNode("accentBar"))
        end function
        @it("declares the titleLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("titleLabel"))
        end function
        @it("declares the summaryLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("summaryLabel"))
        end function
        @it("declares the detailsLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("detailsLabel"))
        end function
    end class
end namespace
