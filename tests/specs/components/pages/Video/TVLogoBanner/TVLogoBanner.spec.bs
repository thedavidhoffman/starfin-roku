namespace tests
    @SGNode("TVLogoBanner")
    @suite("TVLogoBanner component")
    class TVLogoBannerTests extends rooibos.BaseTestSuite
        @describe("declarative component contract")
        @it("declares the showLogo node")
        function _()
            m.assertNotInvalid(m.top.findNode("showLogo"))
        end function
        @it("declares the seriesLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("seriesLabel"))
        end function
    end class
end namespace
