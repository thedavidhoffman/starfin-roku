namespace tests

    @SGNode("TVLogoBanner")
    @suite("TVLogoBanner component")
    class TVLogoBannerTests extends rooibos.BaseTestSuite

        @describe("declarative component contract")

        @it("declares the showLogo node")
        function _()
            m.assertNotInvalid(m.top.findNode("showLogo"))
        end function

        @it("declares the seriesLabel node")
        function _()
            m.assertNotInvalid(m.top.findNode("seriesLabel"))
        end function

        @describe("banner rendering")

        @it("shows a supplied series logo")
        function _()
            m.top.logoUrl = "http://server/logo.png"

            m.assertTrue(m.top.findNode("showLogo").visible)
            m.assertEqual(m.top.findNode("showLogo").uri, "http://server/logo.png")
        end function

        @it("hides the title when a series logo is supplied")
        function _()
            m.top.title = "Series"
            m.top.logoUrl = "http://server/logo.png"

            m.assertFalse(m.top.findNode("seriesLabel").visible)
        end function

        @it("shows the title when the series logo is empty")
        function _()
            m.top.title = "Series"
            m.top.logoUrl = ""

            m.assertFalse(m.top.findNode("showLogo").visible)
            m.assertTrue(m.top.findNode("seriesLabel").visible)
            m.assertEqual(m.top.findNode("seriesLabel").text, "Series")
        end function
    end class

end namespace
