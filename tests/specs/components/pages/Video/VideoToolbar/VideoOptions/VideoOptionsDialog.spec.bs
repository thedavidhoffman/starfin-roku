namespace tests

    @SGNode("VideoOptionsDialog")
    @suite("VideoOptionsDialog component")
    class VideoOptionsDialogTests extends rooibos.BaseTestSuite

        @describe("dialog behavior")

        @it("configures video options content")
        function _()
            m.top.callFunc("openVideoOptions")

            m.assertEqual(m.top.title, "Video")
            m.assertTrue(m.top.dialogWidth = 1480)
            m.assertTrue(m.top.dialogHeight = 590)
            m.assertEqual(m.top.contentComponentName, "VideoOptionsContent")
        end function

        @it("passes the selected video mode to content")
        function _()
            m.top.selectedKey = "transcode-no-remux"

            m.top.callFunc("openVideoOptions")
            content = m.top.callFunc("getContentComponent")

            m.assertEqual(content.selectedKey, "transcode-no-remux")
        end function

        @it("preserves an empty selected video mode")
        function _()
            m.top.selectedKey = ""

            m.top.callFunc("openVideoOptions")
            content = m.top.callFunc("getContentComponent")

            m.assertEqual(content.selectedKey, "")
        end function

        @it("opens and focuses video options content")
        function _()
            m.top.callFunc("openVideoOptions")
            content = m.top.callFunc("getContentComponent")

            m.assertTrue(m.top.findNode("dialog").visible)
            m.assertTrue(content.isInFocusChain())
        end function

        @it("propagates a selected video option")
        function _()
            m.top.callFunc("openVideoOptions")
            content = m.top.callFunc("getContentComponent")
            selection = { optionKey: "automatic-no-remux" }
            content.optionSelected = selection

            'bs:disable-next-line 1140
            onContentOptionSelected()

            m.assertEqual(m.top.selectedOption, selection)
        end function

    end class

end namespace
