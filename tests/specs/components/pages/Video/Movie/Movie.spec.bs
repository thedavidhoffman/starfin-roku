namespace tests
    @SGNode("Movie")
    @suite("Movie component")
    class MovieTests extends rooibos.BaseTestSuite
        @describe("declarative component contract")
        @it("declares the mediaShell node")
        function _()
            m.assertNotInvalid(m.top.findNode("mediaShell"))
        end function
        @it("declares the contentGroup node")
        function _()
            m.assertNotInvalid(m.top.findNode("contentGroup"))
        end function
        @it("declares the mediaToolbar node")
        function _()
            m.assertNotInvalid(m.top.findNode("mediaToolbar"))
        end function
        @it("declares the previousNextButton node")
        function _()
            m.assertNotInvalid(m.top.findNode("previousNextButton"))
        end function
        @it("declares the cast node")
        function _()
            m.assertNotInvalid(m.top.findNode("cast"))
        end function
        @it("declares the chevronFooter node")
        function _()
            m.assertNotInvalid(m.top.findNode("chevronFooter"))
        end function
        @it("declares the streamOptions node")
        function _()
            m.assertNotInvalid(m.top.findNode("streamOptions"))
        end function
        @it("declares the movieTask node")
        function _()
            m.assertNotInvalid(m.top.findNode("movieTask"))
        end function
        @it("declares the themeSongsTask node")
        function _()
            m.assertNotInvalid(m.top.findNode("themeSongsTask"))
        end function
        @it("declares the watchedTask node")
        function _()
            m.assertNotInvalid(m.top.findNode("watchedTask"))
        end function
    end class
end namespace
