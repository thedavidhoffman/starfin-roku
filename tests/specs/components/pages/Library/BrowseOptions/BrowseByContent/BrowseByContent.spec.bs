namespace tests

    @SGNode("BrowseByContent")
    @suite("BrowseByContent component")
    class BrowseByContentTests extends rooibos.BaseTestSuite

        @describe("declarative component contract")

        @it("declares the sortList node")
        function _()
            m.assertNotInvalid(m.top.findNode("sortList"))
        end function

        @describe("option rendering")

        @it("renders every supplied option")
        function _()
            m.top.sortOptions = m.createOptions()

            m.assertEqual(m.top.findNode("sortList").content.getChildCount(), 2)
        end function

        @it("renders option labels")
        function _()
            m.top.sortOptions = m.createOptions()

            m.assertEqual(m.top.findNode("sortList").content.getChild(1).title, "Date Added")
        end function

        @it("checks the selected option")
        function _()
            m.top.sortOptions = m.createOptions()

            m.top.selectedSortKey = "DateCreated"

            m.assertEqual(m.top.findNode("sortList").checkedItem, 1)
        end function

        @it("checks the first option for an unknown key")
        function _()
            m.top.sortOptions = m.createOptions()

            m.top.selectedSortKey = "Unknown"

            m.assertEqual(m.top.findNode("sortList").checkedItem, 0)
        end function

        @describe("selection")

        @it("emits the selected sort payload")
        function _()
            m.top.sortOptions = m.createOptions()

            m.top.findNode("sortList").itemSelected = 1

            m.assertEqual(m.top.sortSelected.optionKey, "DateCreated")
            m.assertEqual(m.top.sortSelected.sortOrder, "Descending")
        end function

        @it("ignores a negative selection")
        function _()
            m.top.sortOptions = m.createOptions()
            m.top.sortSelected = invalid

            'bs:disable-next-line 1140
            selectSortListIndex(-1)

            m.assertInvalid(m.top.sortSelected)
        end function

        @it("ignores an out of range selection")
        function _()
            m.top.sortOptions = m.createOptions()
            m.top.sortSelected = invalid

            'bs:disable-next-line 1140
            selectSortListIndex(2)

            m.assertInvalid(m.top.sortSelected)
        end function

        @it("focuses the option list")
        function _()
            m.top.callFunc("focusOptions")

            m.assertTrue(m.top.findNode("sortList").hasFocus())
        end function

        function createOptions() as object
            return [
                { optionKey: "SortName", sortKey: "SortName", sortOrder: "Ascending", label: "Title" }
                { optionKey: "DateCreated", sortKey: "DateCreated", sortOrder: "Descending", label: "Date Added" }
            ]
        end function

    end class

end namespace
