namespace tests
    @SGNode("FilterButtonRow")
    @suite("FilterButtonRow component")
    class FilterButtonRowTests extends rooibos.BaseTestSuite
        @describe("declarative component contract")
        @it("declares the viewport node")
        function _()
            m.assertNotInvalid(m.top.findNode("viewport"))
        end function
        @it("declares the buttonTrack node")
        function _()
            m.assertNotInvalid(m.top.findNode("buttonTrack"))
        end function
        @it("declares the leftChevron node")
        function _()
            m.assertNotInvalid(m.top.findNode("leftChevron"))
        end function
        @it("declares the rightChevron node")
        function _()
            m.assertNotInvalid(m.top.findNode("rightChevron"))
        end function
    end class
end namespace
