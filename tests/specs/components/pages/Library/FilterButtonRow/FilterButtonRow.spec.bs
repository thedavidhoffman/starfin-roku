import "pkg:/source/Number.bs"

namespace tests

    @SGNode("FilterButtonRow")
    @suite("FilterButtonRow component")
    class FilterButtonRowTests extends rooibos.BaseTestSuite

        @describe("declarative component contract")

        @it("declares the viewport node")
        function _()
            m.assertNotInvalid(m.top.findNode("viewport"))
        end function

        @it("declares the buttonTrack node")
        function _()
            m.assertNotInvalid(m.top.findNode("buttonTrack"))
        end function

        @it("declares the leftChevron node")
        function _()
            m.assertNotInvalid(m.top.findNode("leftChevron"))
        end function

        @it("declares the rightChevron node")
        function _()
            m.assertNotInvalid(m.top.findNode("rightChevron"))
        end function

        @describe("button rendering")

        @it("renders one button for each item")
        function _()
            m.top.items = m.createItems()

            m.assertEqual(m.top.findNode("buttonTrack").getChildCount(), 3)
        end function

        @it("renders item labels")
        function _()
            m.top.items = m.createItems()

            m.assertEqual(m.top.findNode("buttonTrack").getChild(1).text, "1990s")
        end function

        @it("uses the item value when its label is absent")
        function _()
            m.top.items = [{ value: "2000" }]

            m.assertEqual(m.top.findNode("buttonTrack").getChild(0).text, "2000")
        end function

        @it("uses the minimum button width for short labels")
        function _()
            m.top.items = [{ value: "A", label: "A" }]

            m.assertEqual(Number.ToInteger(m.top.findNode("buttonTrack").getChild(0).buttonWidth, -1), 160)
        end function

        @it("uses the maximum button width for long labels")
        function _()
            m.top.items = [{ value: "long", label: "This is a deliberately very long filter label that exceeds the maximum width" }]

            m.assertEqual(Number.ToInteger(m.top.findNode("buttonTrack").getChild(0).buttonWidth, -1), 520)
        end function

        @it("hides both chevrons when content fits")
        function _()
            m.top.items = m.createItems()

            m.assertEqual(m.top.findNode("leftChevron").opacity, 0.0)
            m.assertEqual(m.top.findNode("rightChevron").opacity, 0.0)
        end function

        @describe("selection and focus")

        @it("focuses the selected value")
        function _()
            m.top.items = m.createItems()
            m.top.selectedValue = "1990"

            m.top.callFunc("focusFirstButton")

            m.assertTrue(m.top.hasFocus())
            m.assertTrue(m.top.findNode("buttonTrack").getChild(1).hasActiveVisual)
        end function

        @it("moves right and emits the newly focused filter")
        function _()
            m.top.items = m.createItems()
            m.top.selectedValue = "1980"
            m.top.callFunc("focusFirstButton")

            'bs:disable-next-line 1140
            handled = onKeyEvent("Right", true)

            m.assertTrue(handled)
            m.assertEqual(m.top.filterSelected.value, "1990")
            m.assertEqual(m.top.filterSelected.type, "Decade")
        end function

        @it("moves left and emits the newly focused filter")
        function _()
            m.top.items = m.createItems()
            m.top.selectedValue = "2000"
            m.top.callFunc("focusFirstButton")

            'bs:disable-next-line 1140
            handled = onKeyEvent("Left", true)

            m.assertTrue(handled)
            m.assertEqual(m.top.filterSelected.value, "1990")
        end function

        @it("clamps left movement at the first filter")
        function _()
            m.top.items = m.createItems()
            m.top.selectedValue = "1980"
            m.top.filterSelected = invalid
            m.top.callFunc("focusFirstButton")

            'bs:disable-next-line 1140
            handled = onKeyEvent("Left", true)

            m.assertTrue(handled)
            m.assertInvalid(m.top.filterSelected)
        end function

        @describe("focus exit keys")

        @it("emits focus exit for pressed Up")
        function _()
            m.top.focusExitUp = false

            'bs:disable-next-line 1140
            handled = onKeyEvent("Up", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.focusExitUp)
        end function

        @it("emits focus exit for pressed Down")
        function _()
            m.top.focusExitDown = false

            'bs:disable-next-line 1140
            handled = onKeyEvent("Down", true)

            m.assertTrue(handled)
            m.assertTrue(m.top.focusExitDown)
        end function

        @it("consumes pressed OK")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("OK", true)

            m.assertTrue(handled)
        end function

        @it("ignores released keys")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("Right", false)

            m.assertFalse(handled)
        end function

        @it("ignores unrelated pressed keys")
        function _()
            'bs:disable-next-line 1140
            handled = onKeyEvent("Back", true)

            m.assertFalse(handled)
        end function

        function createItems() as object
            return [
                { value: "1980", label: "1980s" }
                { value: "1990", label: "1990s" }
                { value: "2000", label: "2000s" }
            ]
        end function

    end class

end namespace
