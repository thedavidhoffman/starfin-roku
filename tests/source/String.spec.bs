namespace tests

    @suite("String helpers")
    class StringTests extends rooibos.BaseTestSuite

        @describe("String_Trim")

        @it("removes surrounding spaces while preserving inner spaces")
        function _()
            m.assertEqual(String_Trim("  Starfin Roku  "), "Starfin Roku")
        end function

        @it("returns an empty string for invalid and space-only values")
        function _()
            m.assertEqual(String_Trim(invalid), "")
            m.assertEqual(String_Trim("   "), "")
        end function

        @describe("String_Replace")

        @it("replaces every occurrence")
        function _()
            m.assertEqual(String_Replace("one fish two fish", "fish", "movie"), "one movie two movie")
        end function

        @it("returns the original string when no match exists")
        function _()
            m.assertEqual(String_Replace("Starfin", "Roku", "TV"), "Starfin")
        end function

        @describe("String_CollapseWhitespace")

        @it("collapses spaces, tabs, and line breaks")
        function _()
            value = "  one" + Chr(9) + Chr(9) + "two" + Chr(13) + Chr(10) + "three  "
            m.assertEqual(String_CollapseWhitespace(value), "one two three")
        end function

        @it("returns an empty string for invalid")
        function _()
            m.assertEqual(String_CollapseWhitespace(invalid), "")
        end function

        @describe("String_NaturalCompare")

        @it("sorts digit runs by numeric value")
        function _()
            m.assertEqual(String_NaturalCompare("Book 2", "Book 10"), -1)
            m.assertEqual(String_NaturalCompare("Book 10", "Book 2"), 1)
        end function

        @it("compares text case-insensitively")
        function _()
            m.assertEqual(String_NaturalCompare("STARFIN", "starfin"), 0)
        end function

        @it("uses digit-run length to order equal numeric values")
        function _()
            m.assertEqual(String_NaturalCompare("Episode 2", "Episode 02"), -1)
        end function

        @it("handles invalid values as empty strings")
        function _()
            m.assertEqual(String_NaturalCompare(invalid, "Title"), -1)
            m.assertEqual(String_NaturalCompare(invalid, invalid), 0)
        end function

        @describe("String_IsDigit")

        @it("recognizes only single digit characters")
        function _()
            m.assertTrue(String_IsDigit("0"))
            m.assertTrue(String_IsDigit("9"))
            m.assertFalse(String_IsDigit("a"))
        end function

        @describe("String_StripHtmlMarkup")

        @it("removes tags and preserves paragraph separation")
        function _()
            m.assertEqual(String_StripHtmlMarkup("<p>First</p><p>Second</p>"), "First Second")
        end function

        @it("decodes supported HTML entities")
        function _()
            value = "A&nbsp;&amp;&nbsp;B &quot;C&quot; &#39;D&#39; &lt;E&gt;"
            m.assertEqual(String_StripHtmlMarkup(value), "A & B " + Chr(34) + "C" + Chr(34) + " 'D' <E>")
        end function

        @describe("String_GetJoinedText")

        @it("joins non-empty trimmed array values")
        function _()
            m.assertEqual(String_GetJoinedText([" First ", "", "Second"]), "First, Second")
        end function

        @it("handles invalid and scalar values")
        function _()
            m.assertEqual(String_GetJoinedText(invalid), "")
            m.assertEqual(String_GetJoinedText("  Single  "), "Single")
        end function

    end class

end namespace
