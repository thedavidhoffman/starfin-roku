namespace tests

    @suite("Formatting helpers")
    class FormatTests extends rooibos.BaseTestSuite

        @describe("SafeString")

        @it("converts values to strings and uses the fallback for invalid")
        function _()
            m.assertEqual(SafeString(42, "fallback"), "42")
            m.assertEqual(SafeString(false, "fallback"), "false")
            m.assertEqual(SafeString(invalid, "fallback"), "fallback")
        end function

        @describe("FirstNonEmpty")

        @it("returns the first trimmed non-empty value")
        function _()
            m.assertEqual(FirstNonEmpty([invalid, "  ", " first ", "second"], "fallback"), "first")
        end function

        @it("returns the fallback when no value is usable")
        function _()
            m.assertEqual(FirstNonEmpty([invalid, "  "], "fallback"), "fallback")
        end function

        @describe("FormatWithCommas")

        @it("formats positive values with thousands separators")
        function _()
            m.assertEqual(FormatWithCommas(999), "999")
            m.assertEqual(FormatWithCommas(1234567), "1,234,567")
        end function

        @it("returns an empty string for invalid")
        function _()
            m.assertEqual(FormatWithCommas(invalid), "")
        end function

    end class

end namespace
