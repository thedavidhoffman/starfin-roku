namespace tests

    @suite("Media metadata helpers")
    class MediaMetadataTests extends rooibos.BaseTestSuite

        @describe("MediaMetadata_FormatRating")

        @it("rounds positive ratings to one decimal place")
        function _()
            m.assertEqual(MediaMetadata_FormatRating(8.24), "8.2")
            m.assertEqual(MediaMetadata_FormatRating(8.25), "8.3")
            m.assertEqual(MediaMetadata_FormatRating("7.5"), "7.5")
        end function

        @it("omits invalid and non-positive ratings")
        function _()
            m.assertEqual(MediaMetadata_FormatRating(invalid), "")
            m.assertEqual(MediaMetadata_FormatRating(0), "")
            m.assertEqual(MediaMetadata_FormatRating(-1), "")
        end function

        @describe("MediaMetadata_FormatRuntime")

        @it("formats runtime ticks as minutes and hours")
        function _()
            m.assertEqual(MediaMetadata_FormatRuntime(35999999999&), "59m")
            m.assertEqual(MediaMetadata_FormatRuntime(36000000000&), "1h 0m")
            m.assertEqual(MediaMetadata_FormatRuntime(75000000000&), "2h 5m")
        end function

        @it("omits invalid and sub-minute runtimes")
        function _()
            m.assertEqual(MediaMetadata_FormatRuntime(invalid), "")
            m.assertEqual(MediaMetadata_FormatRuntime(599999999&), "")
            m.assertEqual(MediaMetadata_FormatRuntime(0), "")
        end function

        @it("provides a non-empty bullet separator")
        function _()
            separator = MediaMetadata_BulletSeparator()
            m.assertTrue(Len(separator) > 0)
            m.assertEqual(String_Trim(separator) <> "", true)
        end function

    end class

end namespace
