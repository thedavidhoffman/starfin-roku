namespace tests

    @suite("Number helpers")
    class NumberTests extends rooibos.BaseTestSuite

        @describe("Number_ToFloat")

        @it("converts numeric strings to floats")
        function _()
            m.assertEqual(Number_ToFloat("123.75", 0.0), 123.75)
        end function

        @it("returns the fallback for invalid input")
        function _()
            m.assertEqual(Number_ToFloat(invalid, 4.5), 4.5)
        end function

        @describe("Number_ToInteger")

        @it("rounds decimal values down to integers")
        function _()
            m.assertEqual(Number_ToInteger(12.9, 0), 12)
            m.assertEqual(Number_ToInteger(-12.9, 0), -13)
        end function

        @it("returns the fallback for invalid input")
        function _()
            m.assertEqual(Number_ToInteger(invalid, 42), 42)
        end function

        @describe("Number_FormatWithThousandsSeparator")

        @it("leaves values below one thousand unchanged")
        function _()
            m.assertEqual(Number_FormatWithThousandsSeparator(999), "999")
        end function

        @it("formats a four-digit value")
        function _()
            m.assertEqual(Number_FormatWithThousandsSeparator(1234), "1,234")
        end function

        @it("formats multiple thousands groups")
        function _()
            m.assertEqual(Number_FormatWithThousandsSeparator(123456789), "123,456,789")
        end function

        @it("preserves the sign of negative values")
        function _()
            m.assertEqual(Number_FormatWithThousandsSeparator(-1234567), "-1,234,567")
        end function

        @it("returns an empty string for invalid input")
        function _()
            m.assertEqual(Number_FormatWithThousandsSeparator(invalid), "")
        end function

    end class

end namespace
