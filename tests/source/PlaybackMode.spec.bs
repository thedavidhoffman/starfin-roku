namespace tests

    @suite("Playback mode helpers")
    class PlaybackModeTests extends rooibos.BaseTestSuite

        @describe("playback mode values and normalization")

        @it("provides every supported playback mode")
        function _()
            modes = PlaybackMode_Values()
            m.assertEqual(modes.automatic, "automatic")
            m.assertEqual(modes.automaticNoRemux, "automatic-no-remux")
            m.assertEqual(modes.transcodeAllowRemux, "transcode-allow-remux")
            m.assertEqual(modes.transcodeNoRemux, "transcode-no-remux")
        end function

        @it("preserves supported values")
        function _()
            modes = PlaybackMode_Values()
            m.assertEqual(PlaybackMode_Normalize(modes.automatic), modes.automatic)
            m.assertEqual(PlaybackMode_Normalize(modes.automaticNoRemux), modes.automaticNoRemux)
            m.assertEqual(PlaybackMode_Normalize(modes.transcodeAllowRemux), modes.transcodeAllowRemux)
            m.assertEqual(PlaybackMode_Normalize(modes.transcodeNoRemux), modes.transcodeNoRemux)
        end function

        @it("uses automatic mode for invalid and unknown values")
        function _()
            m.assertEqual(PlaybackMode_Normalize(invalid), "automatic")
            m.assertEqual(PlaybackMode_Normalize("unsupported"), "automatic")
        end function

    end class

end namespace
