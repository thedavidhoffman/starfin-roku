namespace tests

    @suite("Video library sorting")
    class VideoLibrarySortTests extends rooibos.BaseTestSuite

        @describe("ascending release-date sort")

        @it("sorts valid premiere dates chronologically")
        function _()
            items = [
                { Id: "2026", SortName: "Future", PremiereDate: "2026-02-01T00:00:00.0000000Z" }
                { Id: "2024", SortName: "Past", PremiereDate: "2024-08-15T00:00:00.0000000Z" }
                { Id: "2025", SortName: "Present", PremiereDate: "2025-11-03T00:00:00.0000000Z" }
            ]

            result = VideoLibrarySort_ByReleaseDate(items, "Ascending")

            m.assertEqual(__Ids(result), ["2024", "2025", "2026"])
        end function

        @it("falls back to production year when premiere date is absent")
        function _()
            items = [
                { Id: "dated", SortName: "Dated", PremiereDate: "2026-04-01T00:00:00.0000000Z", ProductionYear: 2026 }
                { Id: "fallback", SortName: "Fallback", ProductionYear: 2025 }
                { Id: "older", SortName: "Older", PremiereDate: "2024-01-01T00:00:00.0000000Z", ProductionYear: 2024 }
            ]

            result = VideoLibrarySort_ByReleaseDate(items, "Ascending")

            m.assertEqual(__Ids(result), ["older", "fallback", "dated"])
        end function

        @it("prefers premiere date over production year")
        function _()
            items = [
                { Id: "conflict", SortName: "Conflict", PremiereDate: "2024-01-01T00:00:00.0000000Z", ProductionYear: 2026 }
                { Id: "middle", SortName: "Middle", PremiereDate: "2025-01-01T00:00:00.0000000Z", ProductionYear: 2025 }
            ]

            result = VideoLibrarySort_ByReleaseDate(items, "Ascending")

            m.assertEqual(__Ids(result), ["conflict", "middle"])
        end function

        @it("uses sort name to order equal dates")
        function _()
            items = [
                { Id: "zebra", SortName: "Zebra", PremiereDate: "2026-01-01T00:00:00.0000000Z" }
                { Id: "alpha", SortName: "Alpha", PremiereDate: "2026-01-01T00:00:00.0000000Z" }
            ]

            result = VideoLibrarySort_ByReleaseDate(items, "Ascending")

            m.assertEqual(__Ids(result), ["alpha", "zebra"])
        end function

        @it("places unknown release years first consistently")
        function _()
            items = [
                { Id: "known", SortName: "Known", ProductionYear: 2026 }
                { Id: "unknown-b", SortName: "Bravo" }
                { Id: "unknown-a", SortName: "Alpha", PremiereDate: "not-a-date" }
            ]

            result = VideoLibrarySort_ByReleaseDate(items, "Ascending")

            m.assertEqual(__Ids(result), ["unknown-a", "unknown-b", "known"])
        end function

        @describe("descending release-date sort")

        @it("reverses date order and its title tie-breaker")
        function _()
            items = [
                { Id: "older", SortName: "Older", ProductionYear: 2025 }
                { Id: "alpha", SortName: "Alpha", PremiereDate: "2026-01-01T00:00:00.0000000Z" }
                { Id: "zebra", SortName: "Zebra", PremiereDate: "2026-01-01T00:00:00.0000000Z" }
            ]

            result = VideoLibrarySort_ByReleaseDate(items, "Descending")

            m.assertEqual(__Ids(result), ["zebra", "alpha", "older"])
        end function

        @describe("date-added sort")

        @it("sorts by date created and uses title for equal or missing dates")
        function _()
            items = [
                { Id: "newer", SortName: "Newer", DateCreated: "2026-05-01T12:30:00.0000000Z" }
                { Id: "same-zebra", SortName: "Zebra", DateCreated: "2025-03-10T08:00:00.0000000Z" }
                { Id: "unknown-zebra", SortName: "Zebra" }
                { Id: "same-alpha", SortName: "Alpha", DateCreated: "2025-03-10T08:00:00.0000000Z" }
                { Id: "unknown-alpha", SortName: "Alpha", DateCreated: "not-a-date" }
            ]

            result = VideoLibrarySort_ByDateAdded(items, "Ascending")

            m.assertEqual(__Ids(result), ["unknown-alpha", "unknown-zebra", "same-alpha", "same-zebra", "newer"])
        end function

        @it("sorts date added in descending order")
        function _()
            items = [
                { Id: "older", SortName: "Older", DateCreated: "2024-01-01T00:00:00.0000000Z" }
                { Id: "newer", SortName: "Newer", DateCreated: "2026-01-01T00:00:00.0000000Z" }
                { Id: "middle", SortName: "Middle", DateCreated: "2025-01-01T00:00:00.0000000Z" }
            ]

            result = VideoLibrarySort_ByDateAdded(items, "Descending")

            m.assertEqual(__Ids(result), ["newer", "middle", "older"])
        end function

        @describe("title sort")

        @it("sorts titles in both directions and falls back to name")
        function _()
            items = [
                { Id: "zebra", SortName: "Zebra" }
                { Id: "bravo", Name: "Bravo" }
                { Id: "alpha", SortName: "alpha" }
            ]

            ascending = VideoLibrarySort_ByTitle(items, "Ascending")
            descending = VideoLibrarySort_ByTitle(items, "Descending")

            m.assertEqual(__Ids(ascending), ["alpha", "bravo", "zebra"])
            m.assertEqual(__Ids(descending), ["zebra", "bravo", "alpha"])
        end function

        @describe("random sort")

        @it("uses deterministic random values without losing or duplicating items")
        function _()
            items = [
                { Id: "a" }
                { Id: "b" }
                { Id: "c" }
                { Id: "d" }
            ]

            result = VideoLibrarySort_Shuffle(items, [0.0, 0.0, 0.0])

            m.assertEqual(__Ids(result), ["b", "c", "d", "a"])
            m.assertEqual(__Ids(items), ["a", "b", "c", "d"])
        end function

    end class

    function __Ids(items as object) as object
        ids = []
        for each item in items
            ids.Push(item.Id)
        end for
        return ids
    end function

end namespace
